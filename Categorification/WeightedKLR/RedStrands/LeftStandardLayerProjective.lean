import Categorification.WeightedKLR.RedStrands.LeftStandardModule
import Mathlib.Algebra.Category.ModuleCat.Projective

/-!
# Left loading standards over their layer quotients

Webster's left loading standard becomes a principal projective after
quotienting by the two-sided ideal of strictly higher loading idempotents.
The splitting follows directly from the universal property of the standard.
-/

noncomputable section
set_option maxHeartbeats 180000
set_option synthInstance.maxHeartbeats 50000
namespace Categorification.Stendhal
open KLR KLRAlgebra
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ} {ν : Multiset I}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)
  (s : Seq (stendhalWeight ℓ ν)) (hs : IsRedOrdered s)
local notation "A" => TensorProductAlgebra k Q Λ ν
local notation "S" => leftStandard Q Λ s hs
local notation "E" => seqIdem Q Λ s hs
local notation "g" => leftStandardUnit Q Λ s hs

/-- The two-sided ideal generated by loading idempotents strictly above the chosen cut. -/
def leftStandardHigherLoadingIdeal : TwoSidedIdeal A :=
  TwoSidedIdeal.span {x | ∃ t ht, StendhalLT s t ∧
    x = seqIdem Q Λ t ht}

/-- The diagram algebra with strictly higher loading idempotents killed. -/
abbrev LeftStandardLayerAlgebra := (leftStandardHigherLoadingIdeal Q Λ s).ringCon.Quotient
local notation "B" => LeftStandardLayerAlgebra Q Λ s
local notation "p" => RingCon.mkₐ k (TwoSidedIdeal.ringCon (leftStandardHigherLoadingIdeal Q Λ s))

/-- The quotient kills each strictly higher loading idempotent. -/
theorem leftStandardLayer_quotient_higher (t : Seq (stendhalWeight ℓ ν)) (ht : IsRedOrdered t)
    (hlt : StendhalLT s t) : p (seqIdem Q Λ t ht) = 0 := by
  change (leftStandardHigherLoadingIdeal Q Λ s).ringCon.mk' _ = 0
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk']
  exact TwoSidedIdeal.subset_span ⟨t, ht, hlt, rfl⟩

/-- The ordinary left-standard action factors through the layer algebra. -/
def leftStandardLayerAction : B →ₐ[k] Module.End k S := by
  let a : A →ₐ[k] Module.End k S := Algebra.lsmul k k S
  apply (leftStandardHigherLoadingIdeal Q Λ s).ringCon.liftₐ a
  apply (TwoSidedIdeal.ringCon_le_iff (I := leftStandardHigherLoadingIdeal Q Λ s)
    (J := TwoSidedIdeal.ker a.toRingHom)).mp
  apply TwoSidedIdeal.span_le.mpr
  rintro _ ⟨t, ht, hlt, rfl⟩
  apply (TwoSidedIdeal.mem_ker _).mpr
  exact LinearMap.ext fun z => seqIdem_smul_leftStandard_eq_zero Q Λ hs ht hlt z

instance : Module B S := Module.compHom S (leftStandardLayerAction Q Λ s hs).toRingHom

/-- Restriction of the layer action recovers the original diagram action. -/
theorem leftStandardLayer_smul_mk (a : A) (z : S) : p a • z = a • z := rfl

private instance : Module A B := Module.compHom B (p).toRingHom

/-- Send the standard generator to its loading idempotent in the layer algebra. -/
def leftStandardLayerInclusionAmbient : S →ₗ[A] B :=
  leftStandardLift (Q := Q) (Λ := Λ) s hs (p E)
    (fun t ht b hlt => by
      change p (seqIdem Q Λ t ht * b) * p E = 0
      rw [map_mul, leftStandardLayer_quotient_higher Q Λ s t ht hlt, zero_mul, zero_mul])

private theorem leftStandardLayerInclusionAmbient_generator : leftStandardLayerInclusionAmbient Q Λ s hs g = p E := by
  apply leftStandardLift_unit (Q := Q) (Λ := Λ)
  change p E * p E = p E
  rw [← map_mul, seqIdem_mul_self]

/-- Send the standard generator to its loading idempotent in the layer algebra. -/
def leftStandardLayerInclusion : S →ₗ[B] B where
  toFun := leftStandardLayerInclusionAmbient Q Λ s hs
  map_add' := (leftStandardLayerInclusionAmbient Q Λ s hs).map_add
  map_smul' b z := by
    obtain ⟨a, rfl⟩ := (leftStandardHigherLoadingIdeal Q Λ s).ringCon.mk'_surjective b
    change leftStandardLayerInclusionAmbient Q Λ s hs (p a • z) = p a * leftStandardLayerInclusionAmbient Q Λ s hs z
    rw [leftStandardLayer_smul_mk]
    exact (leftStandardLayerInclusionAmbient Q Λ s hs).map_smul a z

/-- Send a layer element to its action on the standard generator. -/
def leftStandardLayerProjection : B →ₗ[B] S where
  toFun a := a • g
  map_add' a b := add_smul a b g
  map_smul' a b := mul_smul a b g

/-- The principal idempotent inclusion splits along the standard generator. -/
theorem leftStandardLayer_projection_inclusion :
    (leftStandardLayerProjection Q Λ s hs).comp (leftStandardLayerInclusion Q Λ s hs) = LinearMap.id := by
  apply LinearMap.ext
  intro z
  obtain ⟨a, rfl⟩ := leftStandard_exists_smul_unit (Q := Q) (Λ := Λ)
    s hs z
  change (leftStandardLayerInclusionAmbient Q Λ s hs (a • g) • g : S) = a • g
  rw [(leftStandardLayerInclusionAmbient Q Λ s hs).map_smul, leftStandardLayerInclusionAmbient_generator]
  change (p a * p E) • g = a • g
  have hE : E • g = g := (leftStandard_mk_eq_smul_unit s hs
    ⟨E, seqIdem_mul_self Q Λ s hs⟩).symm
  rw [mul_smul, leftStandardLayer_smul_mk Q Λ s hs E, hE, leftStandardLayer_smul_mk Q Λ s hs a]

/-- The left standard is projective as a module over the layer algebra. -/
theorem leftStandardLayer_projective : Module.Projective B S :=
  Module.Projective.of_split (leftStandardLayerInclusion Q Λ s hs) (leftStandardLayerProjection Q Λ s hs)
    (leftStandardLayer_projection_inclusion Q Λ s hs)

/-- The layer splitting maps the standard generator to its loading idempotent. -/
theorem leftStandardLayerInclusion_generator :
    leftStandardLayerInclusion Q Λ s hs g = p E :=
  leftStandardLayerInclusionAmbient_generator Q Λ s hs

end Categorification.Stendhal
