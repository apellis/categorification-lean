import Categorification.WeightedKLR.Rigidity.CupCapProp721AppendIotaSurjCap

/-!
# The appended model is generated by the image of appending a strand, at the top

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.3, proof of
Proposition 7.21, the part for `𝔈_i`, for `j = ℓ`: the multiplication
`T̃^λ_{{i} + ν} e' ⊗ K̃_ν → K̃_{{i} + ν} e'⁺`, `a ⊗ y ↦ a · ι(y)`, is surjective at the level of
the models. Here the window sits at the right of all strands of `λ`, and on a block generator
`γ_g` at `{i} + ν` whose bottom ends in the black strand `i`, the window shuffle is the passage
`s_m ⋯ s_{m+N-1}` of the new strand under the window followed by a permutation fixing the last
strand. Its reduced word through the last coset is `[m, …, m + N - 1]` followed by the chosen
word, so that `γ_g e'⁺ = D · appendBlack(e(midSeq s t) ψ_l)` with `D` the passage under the
window of `CupCap.appendTopIota`.

## Main results

* `CupCap.canWord_wordProd_range'`: the ascending run is the canonical word of its permutation.
* `CupCap.midGenElt_mul_appendBlackPlus_one_top`: the generator identity.
* `CupCap.appendBlackPlusOp_one_smul_mem_span_appendTopIota`: surjectivity at the level of the
  models.
* `CupCap.appendBlackPlusOp_one_smul_mem_closure_capTopIota`: surjectivity on `K^{λ⁺}_λ`.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal.CupCap

open KLR KLRAlgebra TypeA Equiv MulOpposite InductionAlong

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

/-! ### The canonical word of an ascending run -/

/-- The code of the ascending run `[m, …, m + N - 1]`: a run of length one at each position
`m ≤ n < m + N`, and empty runs elsewhere. -/
def passCode (m N : ℕ) : ℕ → List ℕ
  | 0 => []
  | n + 1 => (if m ≤ n ∧ n < m + N then n else n + 1) :: passCode m N n

@[simp] theorem length_passCode (m N n : ℕ) : (passCode m N n).length = n := by
  induction n with
  | zero => rfl
  | succ n ih => simp [passCode, ih]

theorem isCode_passCode (m N n : ℕ) : IsCode (passCode m N n) := by
  induction n with
  | zero => trivial
  | succ n ih =>
    exact ⟨by simp only [length_passCode]; split_ifs <;> omega, ih⟩

theorem codeWord_passCode (m N n : ℕ) :
    codeWord (passCode m N n) = List.range' m (min N (n - m)) := by
  induction n with
  | zero => simp [passCode]
  | succ n ih =>
    rw [passCode, codeWord_cons, ih, length_passCode]
    by_cases h : m ≤ n ∧ n < m + N
    · rw [ite_eq_left h, show n + 1 - n = 1 by omega, descRun_one,
        Nat.min_eq_right (by omega), Nat.min_eq_right (by omega),
        show n + 1 - m = (n - m) + 1 by omega, List.range'_concat,
        show m + 1 * (n - m) = n by omega]
    · rw [ite_eq_right h, show n + 1 - (n + 1) = 0 by omega, descRun_zero, List.append_nil]
      congr 1
      omega

/-- **The ascending run is the canonical word of its permutation.** -/
theorem canWord_wordProd_range' {K m N : ℕ} (hK : m + N + 1 = K) :
    canWord K (wordProd K (List.range' m N)) = List.range' m N := by
  have hc := codeWord_passCode m N (m + N)
  rw [show min N (m + N - m) = N by omega] at hc
  rw [← hc, canWord_wordProd_codeWord (isCode_passCode m N (m + N))
    (by rw [length_passCode]; omega)]

/-- The ascending run `s_q ⋯ s_{q+l-1}` takes `q + l` to `q` and shifts `q, …, q + l - 1` up. -/
theorem val_wordProd_range'_apply {K q l : ℕ} (h : q + l < K) (r : Fin K) :
    (wordProd K (List.range' q l) r : ℕ) =
      if r.val = q + l then q else if q ≤ r.val ∧ r.val < q + l then r.val + 1 else r.val := by
  induction l generalizing r with
  | zero =>
    simp only [List.range'_zero, wordProd, List.map_nil, List.prod_nil, Perm.one_apply]
    split_ifs <;> omega
  | succ l ih =>
    rw [List.range'_concat, wordProd_append, wordProd_singleton, Perm.mul_apply,
      ih (by omega), sadj_val_of_lt (by omega)]
    have := swapNat_cases (q + 1 * l) r
    generalize swapNat (q + 1 * l) r = y at *
    split_ifs <;> omega

/-- The reduced word through the last coset of `s_m ⋯ s_{m+N-1} (v × 1)`. -/
theorem lastCosetWord_range'_mul_extPerm {K K₀ : ℕ} (hm : K₀ + 1 = K) {m N : ℕ}
    (hK : m + N + 1 = K) (ρ : Perm (Fin K₀) → List ℕ) (v : Perm (Fin K₀)) :
    lastCosetWord hm ρ (wordProd K (List.range' m N) * extPerm hm v) =
      List.range' m N ++ ρ v := by
  have hc : StrictMono fun x : Fin K₀ =>
      wordProd K (List.range' m N) (blockEquiv hm (Sum.inl x)) := by
    intro x y hxy
    simp only
    rw [Fin.lt_def, val_wordProd_range'_apply (by omega), val_wordProd_range'_apply (by omega)]
    rw [Fin.lt_def] at hxy
    have hx := x.2
    have hy := y.2
    simp only [blockEquiv_inl_val]
    split_ifs <;> omega
  rw [lastCosetWord, lastCosetSplit_eq hm hc, canWord_wordProd_range' hK]

/-! ### The generator identity -/

variable {I : Type} [DecidableEq I] {k : Type} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {Λc : Fin 2 → I →₀ ℕ}
  {j : ℕ} {hj : j ≤ ℓ} (ν : Multiset I) {ν₀ : Multiset I} (i : I)

local notation "νᵢ" => ((Singleton.singleton i : Multiset I) + ν)
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "N" => Multiset.card (stendhalWeight 2 ν₀)
local notation "M" => Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "M'" => Multiset.card (stendhalWeight (ℓ + 2) (((Singleton.singleton i :
  Multiset I) + ν) + ν₀))
local notation "Ap" => appendPlus Q Λ Λc j hj ν ν₀ i
local notation "aBP" => appendBlackPlus Q Λ Λc j hj ν ν₀ i
local notation "botᵢ" => botMap k Q Λ Λc j hj ((Singleton.singleton i : Multiset I) + ν) ν₀
local notation "D" => topPass (Q := Q) (Λ := Λ) (Λc := Λc) (j := j) (hj := hj) (ν₀ := ν₀) ν i

omit [DecidableEq I] in
/-- The number of strands of `λ⁺` after appending the strand, around the window. -/
theorem card_plus_appendBlack_eq : m + N + 1 = M' := by
  have h1 := card_plus' (I := I) (ℓ := ℓ) (ν := ν) (ν₀ := ν₀)
  have h2 := card_plus_appendBlack (ℓ := ℓ) (ν₀ := ν₀) ν i
  omega

omit [DecidableEq I] in
/-- The loading of an appended loading with the window at `m`, for `j = ℓ`. -/
theorem midSeq_append_eq_insertSeq (h : ¬ j < ℓ) (s : Seq (stendhalWeight ℓ ν))
    (t : Seq (stendhalWeight 2 ν₀)) :
    Seq.cast (plusAddBlack ν ν₀ i) ((midSeq j hj s t).append
        (default : Seq (Singleton.singleton (Sum.inl i) : Multiset (I ⊕ Fin (ℓ + 2))))) =
      insertSeq (j := j) (hj := hj) (ν₀ := ν₀) (appendBlackLoading i ν s) m
        (le_card_appendBlackWeight ν i) (Seq.map (cupColour j hj) t) := by
  rw [← insertSeq_appendBlackLoading s m le_rfl]
  congr 3
  rw [midSeq]
  congr 1
  exact midPos_of_not_lt j s h

omit [DecidableEq I] in
/-- The loading at the window of an appended loading, for `j = ℓ`. -/
theorem midSeq_appendBlackLoading_eq_insertSeq (h : ¬ j < ℓ) (s : Seq (stendhalWeight ℓ ν))
    (t : Seq (stendhalWeight 2 ν₀)) :
    midSeq j hj (appendBlackLoading i ν s) t =
      insertSeq (j := j) (hj := hj) (ν₀ := ν₀) (appendBlackLoading i ν s) (m + 1)
        (succ_le_card_appendBlackWeight ν i) (Seq.map (cupColour j hj) t) := by
  rw [midSeq]
  congr 1
  rw [midPos_of_not_lt j _ h, card_appendBlackWeight]

/-- **The generator identity at the top** (arXiv:1309.3796v3, §7.3, proof of Proposition 7.21),
for `j = ℓ`: for a generator `g` without dots at `{i} + ν` whose loading of `λ` is the appended
loading `s i` and whose window shuffle is given by the word `[m, …, m + N - 1] ++ l`,
`γ_g e'⁺ = D · appendBlack(σ(1) e(midSeq s t) ψ_l) e'⁺`. -/
theorem midGenElt_mul_appendBlackPlus_one_top (h : ¬ j < ℓ) {ρ' : Perm (Fin M') → List ℕ}
    (g : MidGen j hj νᵢ ν₀) (hd : g.d = 0) {s : Seq (stendhalWeight ℓ ν)}
    (hs : g.s = appendBlackLoading i ν s) {l : List ℕ} (hl : ValidWord M l)
    (hρ : ρ' g.u = List.range' m N ++ l) (hw : wordProd M' (List.range' m N ++ l) = g.u) :
    midGenElt Q Λ Λc ρ' g * aBP 1 =
      botᵢ D * aBP (midStendhal j hj Q Λ Λc ν ν₀ 1 *
        botMap k Q Λ Λc j hj ν ν₀ (KLRAlgebra.e (midSeq j hj s g.t) * ψw l)) * aBP 1 := by
  have hDe : D * KLRAlgebra.e (insertSeq (j := j) (hj := hj) (ν₀ := ν₀)
      (appendBlackLoading i ν s) m (le_card_appendBlackWeight ν i)
        (Seq.map (cupColour j hj) g.t)) =
      KLRAlgebra.e (midSeq j hj (appendBlackLoading i ν s) g.t) * underRight N m := by
    rw [topPass, mul_assoc,
      ← eSum_mul_e_insertSeq Q Λ Λc (appendBlackLoading i ν s) (le_card_appendBlackWeight ν i),
      ← mul_assoc (topPassIdem ν i), topPassIdem_mul_eSum, eSum_mul_e_insertSeq,
      underRight_mul_e_insertSeq, midSeq_appendBlackLoading_eq_insertSeq ν i h]
  rw [map_mul (appendBlackPlus Q Λ Λc j hj ν ν₀ i), midStendhal_one_eq_botMap,
    appendBlackPlus_botMap, appendBlackPlus_botMap, appendBlackPlus_one,
    appendPlus_sum_midIdem ν i h, ← map_mul, ← map_mul, ← map_mul, ← mul_assoc D,
    topPass_mul_topPassIdem, mul_assoc D, ← map_mul, mul_one, appendPlus_e_mul_ψw ν i hl,
    midSeq_append_eq_insertSeq ν i h, ← mul_assoc, ← mul_assoc, hDe, midGenElt, ← map_mul,
    midGenKLR_of_d_eq_zero g hd (by rw [hρ]; exact hw), hρ, hs, underRight, ψw_append]
  simp only [mul_assoc]

/-! ### Generators whose bottom ends in the strand `i` -/

omit [DecidableEq I] in
/-- **A block generator whose bottom ends in the black strand `i`** (arXiv:1309.3796v3, §7.3,
proof of Proposition 7.21), for `j = ℓ` and a cap-good loading at the maximum: its loading of `λ`
is an appended loading and its window shuffle takes the last strand to the position `m` of the
appended strand. -/
theorem MidGen.exists_appendBlackLoading_of_bot_top (h : ¬ j < ℓ) (g : MidGen j hj νᵢ ν₀)
    (hperm : g.perm = 1) (ht : IsCapGood ν₀ g.t) (c : Fin M') (hc : c.val + 1 = M')
    (hb : g.bot.lbl c = .inl i) :
    ∃ s : Seq (stendhalWeight ℓ ν), g.s = appendBlackLoading i ν s ∧ (g.u c).val = m := by
  have hlbl : g.bot.lbl c = (midSeq j hj g.s g.t).lbl (g.u c) := rfl
  have hM := card_plus' (I := I) (ℓ := ℓ) (ν := νᵢ) (ν₀ := ν₀)
  have hm := card_appendBlackWeight (ℓ := ℓ) (ν := ν) (i := i)
  rcases hz : g.shuffle.symm c with b | q
  · have hcb : g.shuffle (.inl b) = c := by rw [← hz, Equiv.apply_symm_apply]
    have hu : g.u c = outPos j ν₀ g.s b := by
      rw [← hcb, MidGen.u_shuffle_inl, hperm]
      rfl
    rw [hlbl, hu, midSeq_lbl_outPos] at hb
    have hsb : g.s.lbl b = .inl i := by
      cases hx : g.s.lbl b with
      | inl x =>
        rw [hx] at hb
        simp only [oldColour, Sum.map_inl, id, Sum.inl.injEq] at hb
        rw [hb]
      | inr r =>
        rw [hx] at hb
        simp [oldColour] at hb
    have hbl : b.val + 1 = Multiset.card (stendhalWeight ℓ νᵢ) := by
      by_contra hne
      have hb2 := b.2
      have hlt : b < ⟨Multiset.card (stendhalWeight ℓ νᵢ) - 1, by omega⟩ := by
        rw [Fin.lt_def]; simp only; omega
      have h1 := g.botOrd.lt_iff_lt.2 hlt
      rw [← MidGen.shuffle_inl, hcb, Fin.lt_def] at h1
      have h2 := (g.botOrd ⟨Multiset.card (stendhalWeight ℓ νᵢ) - 1, by omega⟩).isLt
      omega
    obtain ⟨s, hs⟩ := exists_appendBlackLoading_eq ν i g.s b hbl hsb
    refine ⟨s, hs.symm, ?_⟩
    have hmid := midPos_of_not_lt j g.s h
    rw [hu, outPos_val]
    split_ifs <;> omega
  · exfalso
    have hcq : g.shuffle (.inr q) = c := by rw [← hz, Equiv.apply_symm_apply]
    have hu : g.u c = winPos (midPos_add_N_le j ν₀ g.s) q := by
      rw [← hcq, MidGen.u_shuffle_inr]
    have hq2 := q.2
    have hq : q.val + 1 = Multiset.card (stendhalWeight 2 ν₀) := by
      by_contra hne
      have hlt : q < ⟨Multiset.card (stendhalWeight 2 ν₀) - 1, by omega⟩ := by
        rw [Fin.lt_def]; simp only; omega
      have h1 := g.hu hlt
      simp only at h1
      rw [← MidGen.shuffle_inr, hcq, Fin.lt_def] at h1
      have h2 := (g.u⁻¹ (winPos (midPos_add_N_le j ν₀ g.s)
        ⟨Multiset.card (stendhalWeight 2 ν₀) - 1, by omega⟩)).isLt
      omega
    rw [hlbl, hu, midSeq_lbl_winPos] at hb
    have hlast : g.t.lbl q = .inr 1 := by
      have := ht.2
      convert this using 2
      exact Fin.ext (by simp only; omega)
    rw [hlast] at hb
    simp [cupColour] at hb

omit [DecidableEq I] in
/-- A window shuffle taking the last strand to `m` is the passage `s_m ⋯ s_{m+N-1}` followed by
a permutation fixing the last strand, and its word through the last coset is
`[m, …, m + N - 1] ++ canWord v`. -/
theorem exists_appendWords_eq (u : Perm (Fin M'))
    (hu : (u (lastPos (card_plus_appendBlack (ℓ := ℓ) (ν₀ := ν₀) ν i))).val = m) :
    ∃ v : Perm (Fin M), appendWords ν i u = List.range' m N ++ canWord M v ∧
      wordProd M' (List.range' m N ++ canWord M v) = u := by
  have hm := card_plus_appendBlack (ℓ := ℓ) (ν₀ := ν₀) ν i
  have hK := card_plus_appendBlack_eq (ℓ := ℓ) (ν₀ := ν₀) ν i
  set c := wordProd M' (List.range' m N) with hcdef
  have hcl : c (lastPos hm) = u (lastPos hm) := by
    apply Fin.ext
    rw [hu, hcdef, show lastPos hm = (⟨m + N, by omega⟩ : Fin M') from Fin.ext (by
      simp only [lastPos_val]; have := card_plus' (I := I) (ℓ := ℓ) (ν := ν) (ν₀ := ν₀); omega),
      wordProd_range'_apply]
  obtain ⟨v, hv⟩ := exists_extPerm_eq hm (w := c⁻¹ * u) (by
    rw [Perm.mul_apply, ← hcl, Perm.inv_def, Equiv.symm_apply_apply])
  have hu' : u = c * extPerm hm v := by rw [hv, mul_inv_cancel_left]
  refine ⟨v, ?_, ?_⟩
  · rw [hu']
    exact lastCosetWord_range'_mul_extPerm hm hK _ v
  · rw [wordProd_append, wordProd_canWord_ext hm, hu']

/-! ### Surjectivity at the level of the models -/

section Model

variable {L : Type} [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  (hP : PullOff k Q Λc ν₀ L) (hPL : PullOffLeft k Q Λc ν₀ L)
  (hL : ∀ (w : Seq (stendhalWeight 2 ν₀)) (v : L), ¬ IsCapGood ν₀ w →
    op (cupMap k Q Λc ν₀ (KLRAlgebra.e w)) • v = 0)
  (hκ : ∀ i', IsUnit (cupScalar Q ν₀ i'))

/-- **On a generator whose loading of `λ` is appended**, for `j = ℓ`: `(v γ_g) e'⁺` is `ι` of
the appended generator `v (e(midSeq s t) ψ_l)` at `ν`. -/
theorem appendBlackPlusOp_one_smul_tmul_midGenCorner_top (h : ¬ j < ℓ)
    {ρ' : Perm (Fin M') → List ℕ} (g : MidGen j hj νᵢ ν₀) (hd : g.d = 0)
    {s : Seq (stendhalWeight ℓ ν)} (hs : g.s = appendBlackLoading i ν s) {l : List ℕ}
    (hl : ValidWord M l) (hρ : ρ' g.u = List.range' m N ++ l)
    (hw : wordProd M' (List.range' m N ++ l) = g.u) (v : L) :
    appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
        (Ind.tmul (midGenCorner Q Λ Λc ρ' g) v : MidModel j hj Q Λ Λc νᵢ ν₀ L) =
      appendTopIota ν i hP hPL hL hκ h (Ind.tmul (midGen j hj Q Λ Λc ν ν₀
        (botMap k Q Λ Λc j hj ν ν₀ (KLRAlgebra.e (midSeq j hj s g.t) * ψw l))) v) := by
  rw [Ind.smul_tmul, appendTopIota_tmul]
  congr 1
  apply Subtype.ext
  apply MulOpposite.unop_injective
  change midGenElt Q Λ Λc ρ' g * aBP 1 = _
  change _ = botᵢ D * (aBP (midStendhal j hj Q Λ Λc ν ν₀ 1 *
      botMap k Q Λ Λc j hj ν ν₀ (KLRAlgebra.e (midSeq j hj s g.t) * ψw l)) * aBP 1)
  rw [midGenElt_mul_appendBlackPlus_one_top ν i h g hd hs hl hρ hw, mul_assoc]

theorem appendTopIota_zero (h : ¬ j < ℓ) :
    appendTopIota ν i hP hPL hL hκ h (0 : MidModel j hj Q Λ Λc ν ν₀ L) = 0 := by
  rw [appendTopIota, Ind.tmul_zero, map_zero]
  rfl

variable [Module k L] [IsScalarTower k (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]

/-- **On a block generator**, for `j = ℓ`: `(v γ_g) e'⁺` lies in the image of `ι`, for the
reduced words through the last coset. -/
theorem exists_appendBlackPlusOp_one_smul_tmul_eq_top (h : ¬ j < ℓ)
    (g : MidBlockShuffle j hj νᵢ ν₀)
    (v : BalancedTensor.idemPart k L (midGenIdem (k := k) Q Λc g.1.1)) :
    ∃ x : MidModel j hj Q Λ Λc ν ν₀ L, appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
        (Ind.tmul (midGenCorner Q Λ Λc (appendWords ν i) g.1.1) (v : L) :
          MidModel j hj Q Λ Λc νᵢ ν₀ L) = appendTopIota ν i hP hPL hL hκ h x := by
  have hm := card_plus_appendBlack (ℓ := ℓ) (ν₀ := ν₀) ν i
  by_cases htc : IsCapGood ν₀ g.1.1.t
  · by_cases hb : g.1.1.bot.lbl (lastPos hm) = .inl i
    · obtain ⟨s, hs, hu⟩ := MidGen.exists_appendBlackLoading_of_bot_top ν i h g.1.1 g.2 htc _
        (by simp only [lastPos_val]; exact hm) hb
      obtain ⟨u₀, hρ, hw⟩ := exists_appendWords_eq ν i g.1.1.u hu
      exact ⟨_, appendBlackPlusOp_one_smul_tmul_midGenCorner_top ν i hP hPL hL hκ h g.1.1 g.1.2
        hs (validWord_canWord M u₀) hρ hw (v : L)⟩
    · refine ⟨0, ?_⟩
      rw [appendTopIota_zero, Ind.smul_tmul]
      have h0 : appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
          midGenCorner Q Λ Λc (appendWords ν i) g.1.1 = 0 := by
        apply Subtype.ext
        apply MulOpposite.unop_injective
        change midGenElt Q Λ Λc (appendWords ν i) g.1.1 * aBP 1 = 0
        exact midGenElt_mul_appendBlackPlus_one_of_lbl ν i g.1.1 _
          (by simp only [lastPos_val]; exact hm) hb
      rw [h0, Ind.zero_tmul]
  · have hv : (v : L) = 0 := by
      have hbot := idemPart_eq_bot_of_not_isCapGood L hL g.1.1.t g.1.1.ht htc
      have hx : (v : L) ∈ (⊥ : Submodule k L) := hbot ▸ v.2
      exact (Submodule.mem_bot k).1 hx
    refine ⟨0, ?_⟩
    rw [appendTopIota_zero, hv, Ind.tmul_zero, smul_zero]

/-- **Surjectivity of `T̃^λ_{{i} + ν} e' ⊗ K̃_ν → K̃_{{i} + ν} e'⁺` at the level of the models**
(Webster, arXiv:1309.3796v3, §7.3, proof of Proposition 7.21, the part for `𝔈_i`), for `j = ℓ`:
for every `y` in the model at `{i} + ν`, `y e'⁺` lies in the left `T̃^λ_{{i} + ν}`-span of the
image of `ι`, when the cup scalars are units and `L` satisfies the pull-off identities. -/
theorem appendBlackPlusOp_one_smul_mem_span_appendTopIota (h : ¬ j < ℓ)
    (hR' : MidKLRRel j hj Q Λ Λc νᵢ ν₀ L hL) (y : MidModel j hj Q Λ Λc νᵢ ν₀ L) :
    toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 • y) ∈
      Submodule.span (StendhalAlgebra k Q Λ νᵢ)
        (Set.range fun x : MidModel j hj Q Λ Λc ν ν₀ L =>
          toMidLeftModel ν i hR' (appendTopIota ν i hP hPL hL hκ h x)) := by
  classical
  obtain ⟨X, hXy⟩ := midThetaBlock_surjective hR' (appendWords ν i) (appendWords_spec ν i) hP hκ
    (toMidLeftModel ν i hR' y)
  change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
    (toMidLeftModel ν i hR' y : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ _
  rw [← hXy]
  clear hXy
  induction X using DirectSum.induction_on with
  | zero =>
    rw [map_zero]
    change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
      (0 : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ _
    rw [smul_zero]
    exact zero_mem _
  | of g w =>
    induction w using TensorProduct.inductionOn with
    | tmul a v =>
      rw [← DirectSum.lof_eq_of (StendhalAlgebra k Q Λ νᵢ), midThetaBlock_lof, midTheta_of_tmul]
      change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
        midLeftAlg L hL hR' (a : StendhalAlgebra k Q Λ νᵢ)
          (Ind.tmul (midGenCorner Q Λ Λc (appendWords ν i) g.1.1) (v : L))) ∈ _
      rw [← midLeftAlg_smul]
      obtain ⟨x, hx⟩ := exists_appendBlackPlusOp_one_smul_tmul_eq_top ν i hP hPL hL hκ h g v
      rw [hx]
      exact Submodule.smul_mem _ (a : StendhalAlgebra k Q Λ νᵢ)
        (Submodule.subset_span ⟨x, rfl⟩)
    | add w w' hw hw' =>
      rw [map_add, map_add]
      change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
        (_ + _ : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ _
      rw [smul_add]
      exact add_mem hw hw'
  | add X X' hX hX' =>
    rw [map_add]
    change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
      (_ + _ : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ _
    rw [smul_add]
    exact add_mem hX hX'

end Model

section Cap

variable {L : Type} [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  [Module k L] [IsScalarTower k (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  {hL : ∀ (w : Seq (stendhalWeight 2 ν₀)) (v : L), ¬ IsCapGood ν₀ w →
    op (cupMap k Q Λc ν₀ (KLRAlgebra.e w)) • v = 0}
  (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL)
  (hR' : MidKLRRel j hj Q Λ Λc ((Singleton.singleton i : Multiset I) + ν) ν₀ L hL)
  (hP : PullOff k Q Λc ν₀ L) (hPL : PullOffLeft k Q Λc ν₀ L)
  (hκ : ∀ i', IsUnit (cupScalar Q ν₀ i')) (h : ¬ j < ℓ)

/-- **Surjectivity of `T̃^λ_{{i} + ν} e' ⊗ K_ν → K_{{i} + ν} e'⁺`** (Webster,
arXiv:1309.3796v3, §7.3, proof of Proposition 7.21, the part for `𝔈_i`), for `j = ℓ`: every
`c e'⁺` is a sum of elements `a · ι(c')`, when the cup scalars are units and `L` satisfies the
pull-off identities. -/
theorem appendBlackPlusOp_one_smul_mem_closure_capTopIota
    (c : CapBimodule k Q Λ Λc j hj νᵢ ν₀ L) :
    appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 • c ∈
      AddSubmonoid.closure (Set.range fun p : StendhalAlgebra k Q Λ νᵢ ×
          CapBimodule k Q Λ Λc j hj ν ν₀ L =>
        capLeftLin L p.1 (capTopIota ν i hR hR' hP hPL hκ h p.2)) := by
  set S := AddSubmonoid.closure (Set.range fun p : StendhalAlgebra k Q Λ νᵢ ×
      CapBimodule k Q Λ Λc j hj ν ν₀ L =>
    capLeftLin L p.1 (capTopIota ν i hR hR' hP hPL hκ h p.2)) with hS
  have hlin : ∀ (a : StendhalAlgebra k Q Λ νᵢ) (c : CapBimodule k Q Λ Λc j hj νᵢ ν₀ L),
      c ∈ S → capLeftLin L a c ∈ S := by
    intro a c hc
    induction hc using AddSubmonoid.closure_induction with
    | mem x hx =>
      obtain ⟨⟨b, x⟩, rfl⟩ := hx
      rw [capLeftLin_mul hR' hP hPL hκ]
      exact AddSubmonoid.subset_closure ⟨(a * b, x), rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  have hπ : ∀ z ∈ Submodule.span (StendhalAlgebra k Q Λ νᵢ)
      (Set.range fun x : MidModel j hj Q Λ Λc ν ν₀ L =>
        toMidLeftModel ν i hR' (appendTopIota ν i hP hPL hL hκ h x)),
      (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (z : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ S := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨x, rfl⟩ := hz
      have hc : (capModelRightEquiv hR' hP hPL hκ).symm
          (Submodule.Quotient.mk (appendTopIota ν i hP hPL hL hκ h x)) =
          capTopIota ν i hR hR' hP hPL hκ h ((capModelRightEquiv hR hP hPL hκ).symm
            (Submodule.Quotient.mk x)) := by
        apply (capModelRightEquiv hR' hP hPL hκ).injective
        rw [LinearEquiv.apply_symm_apply,
          capModelRightEquiv_capTopIota ν i hR hR' hP hPL hκ h _ x
            (LinearEquiv.apply_symm_apply _ _)]
      change (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (appendTopIota ν i hP hPL hL hκ h x)) ∈ S
      rw [hc, ← capLeftLin_one hR' hP hPL hκ (capTopIota ν i hR hR' hP hPL hκ h _)]
      exact AddSubmonoid.subset_closure ⟨(1, _), rfl⟩
    | zero =>
      change (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (0 : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ S
      rw [Submodule.Quotient.mk_zero, map_zero]
      exact zero_mem _
    | add x y _ _ hx hy =>
      convert add_mem hx hy using 1
      rw [← map_add]
      rfl
    | smul a z _ hz =>
      have hc : (capModelRightEquiv hR' hP hPL hκ).symm
          (Submodule.Quotient.mk (midLeftAlg L hL hR' a z)) =
          capLeftLin L a ((capModelRightEquiv hR' hP hPL hκ).symm
            (Submodule.Quotient.mk (z : MidModel j hj Q Λ Λc νᵢ ν₀ L))) := by
        apply (capModelRightEquiv hR' hP hPL hκ).injective
        rw [LinearEquiv.apply_symm_apply,
          capModelRightEquiv_capLeftLin hR' hP hPL hκ a _ z (LinearEquiv.apply_symm_apply _ _)]
      change (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (midLeftAlg L hL hR' a z)) ∈ S
      rw [hc]
      exact hlin a _ hz
  obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (capModelRightEquiv hR' hP hPL hκ c)
  have hc : appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 • c =
      (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 • y)) := by
    apply (capModelRightEquiv hR' hP hPL hκ).injective
    rw [LinearEquiv.apply_symm_apply, LinearEquiv.map_smul, ← hy, Submodule.Quotient.mk_smul]
  rw [hc]
  exact hπ _ (appendBlackPlusOp_one_smul_mem_span_appendTopIota ν i hP hPL hL hκ h hR' y)

end Cap

end Categorification.Stendhal.CupCap
