import Categorification.KLR.Basic
import Categorification.WeightedKLR.KLR.SpacedComparison

/-!
# Stendhal diagrams: the algebras `T̃^λ` and `T^λ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2,
Definitions 4.1–4.7. These are the algebras of Theorems 3.5 and 3.6 of B. Webster,
*Weighted Khovanov–Lauda–Rouquier algebras*, arXiv:1209.2463v4.

Fix a type `I` of vertices with KLR polynomials `Q i j`, a list `λ_1, …, λ_ℓ` of dominant
weights, recorded by `Λ j i = α_i^∨(λ_j)`, and a weight `ν ∈ ℕ[I]` for the black strands.

## Encoding

A Stendhal diagram is a braid-like diagram of black strands labelled by `I`, carrying dots, and
`ℓ` red strands which carry no dots and never cross each other (Definition 4.1). We give the
red strand labelled `λ_j` the colour `Sum.inr j` and a black `i`-strand the colour `Sum.inl i`,
so that sequences of termini are KLR sequences (`KLR.Seq`) of the weight
`stendhalWeight ν ℓ = ν + {1, …, ℓ}` over `I ⊕ Fin ℓ`. The local relations of Definition 4.5 are
then the KLR relations for the polynomials `stendhalQ Q Λ`:

* between black strands, `Q i j`;
* between a black `i`-strand on the left and the red strand `λ_j` on the right, `u ^ α_i^∨(λ_j)`,
  and in the other order `v ^ α_i^∨(λ_j)`: this is the bigon relation (4.2), the cost
  `α_i^∨(λ_j)` dots on the black strand;
* the KLR braid relation with correction `Q̄` for the polynomial `u ^ α_i^∨(λ_j)` at a triple
  point `i, λ_j, i` is (4.1a), and there is no correction at the other triple points
  ((4.1b), (4.1c));
* the KLR relations moving dots through crossings of strands of distinct colours say that
  dots pass through red strands;

together with two further relations: a dot on a red strand is zero (red strands carry no dots),
and a crossing of two red strands is zero (red strands never cross). Since red strands of
distinct labels have distinct colours, the KLR relations impose nothing else on red strands:
for two reds, `ψ² = 0`, and the dot relations involve only dots on red strands.

This gives the algebra `StendhalAlgebraAllOrders` of Stendhal diagrams with red strands
`λ_1, …, λ_ℓ` in every order. Every generator preserves the relative order of the red strands
or vanishes, so `T̃^λ` (Definition 4.7: red strands labelled `λ_1, …, λ_ℓ` from left to right)
is its corner `StendhalAlgebra` at the sum of the idempotents `e(i)` whose red strands appear in
the order `λ_1, …, λ_ℓ` (`IsRedOrdered`).

`T^λ` (Definitions 4.6, 4.7) is the quotient of `T̃^λ` by the ideal generated by violated
diagrams (a black strand is leftmost at some horizontal slice, Definition 4.3). Cutting a
violated diagram at such a slice factors it through an idempotent `e(i)` whose leftmost
terminus is black, and these idempotents are violated diagrams; so the ideal is generated by
them (`StendhalAlgebra.violatedIdeal`).

## Main definitions

* `Stendhal.stendhalQ`, `Stendhal.stendhalWeight`: the KLR data of Stendhal diagrams.
* `Stendhal.StendhalAlgebraAllOrders`: Stendhal diagrams with red strands in any order.
* `Stendhal.StendhalAlgebraAllOrders.redOrderedIdem`: the sum of the idempotents whose red
  strands read `λ_1, …, λ_ℓ`.
* `Stendhal.StendhalAlgebra`: Webster's `T̃^λ` (weight `ν` of the black strands).
* `Stendhal.StendhalAlgebra.violatedIdeal`: the ideal generated by violated diagrams.
* `Stendhal.TensorProductAlgebra`: Webster's `T^λ`.

## Main results

* `StendhalAlgebraAllOrders.x_mul_e_of_red`, `ψ_mul_e_of_red`: red strands carry no dots and do
  not cross.
* `StendhalAlgebraAllOrders.ψ_sq_black_red`, `ψ_sq_red_black`: the bigon relation (4.2).
* `StendhalAlgebraAllOrders.braid_black_red_black`: the relation (4.1a).
-/

namespace Categorification.Stendhal

open MvPolynomial KLR TypeA

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}

/-! ### The KLR data of Stendhal diagrams -/

variable (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)

/-- The KLR polynomials of Stendhal diagrams (arXiv:1309.3796v2, Definition 4.5): `Q i j`
between black strands, `u ^ α_i^∨(λ_j)` for a black `i`-strand left of the red strand `λ_j`,
`v ^ α_i^∨(λ_j)` in the other order, and `0` between red strands. -/
noncomputable def stendhalQ : I ⊕ Fin ℓ → I ⊕ Fin ℓ → MvPolynomial (Fin 2) k
  | .inl i, .inl j => Q i j
  | .inl i, .inr r => X 0 ^ Λ r i
  | .inr r, .inl i => X 1 ^ Λ r i
  | .inr _, .inr _ => 0

omit [DecidableEq I] in
@[simp] theorem stendhalQ_inl_inl (i j : I) : stendhalQ Q Λ (.inl i) (.inl j) = Q i j := rfl
omit [DecidableEq I] in
@[simp] theorem stendhalQ_inl_inr (i : I) (r : Fin ℓ) :
    stendhalQ Q Λ (.inl i) (.inr r) = X 0 ^ Λ r i := rfl
omit [DecidableEq I] in
@[simp] theorem stendhalQ_inr_inl (r : Fin ℓ) (i : I) :
    stendhalQ Q Λ (.inr r) (.inl i) = X 1 ^ Λ r i := rfl

variable (ℓ) in
/-- The colours of the strands of a Stendhal diagram with black strands of weight `ν` and red
strands `λ_1, …, λ_ℓ`: `ν` (black, `Sum.inl`) and each red label once (`Sum.inr`). -/
def stendhalWeight (ν : Multiset I) : Multiset (I ⊕ Fin ℓ) :=
  ν.map Sum.inl + Finset.univ.val.map Sum.inr

/-- The red strands of a sequence appear in the order `λ_1, …, λ_ℓ` from left to right. -/
def IsRedOrdered {μ : Multiset (I ⊕ Fin ℓ)} (i : Seq μ) : Prop :=
  ∀ a b (r r' : Fin ℓ), a < b → i.lbl a = .inr r → i.lbl b = .inr r' → r < r'

/-- The leftmost terminus is black: `e(i)` is a violated diagram
(arXiv:1309.3796v2, Definition 4.3). -/
def IsViolated {μ : Multiset (I ⊕ Fin ℓ)} (i : Seq μ) : Prop :=
  ∃ h : 0 < Multiset.card μ, (i.lbl ⟨0, h⟩).isLeft

omit [DecidableEq I] in
/-- Every red label `λ_r` occurs in a sequence of Stendhal weight. -/
theorem exists_lbl_eq_inr {ν : Multiset I} (s : Seq (stendhalWeight ℓ ν)) (r : Fin ℓ) :
    ∃ a, s.lbl a = .inr r := by
  have : (Sum.inr r : I ⊕ Fin ℓ) ∈ Finset.univ.val.map s.1 := by
    rw [s.2]
    simp [stendhalWeight]
  obtain ⟨a, -, ha⟩ := Multiset.mem_map.1 this
  exact ⟨a, ha⟩

/-! ### The algebra of Stendhal diagrams -/

section Rel

variable (k) (ν : Multiset I)

local notation "μ" => stendhalWeight ℓ ν
local notation "Fr" => FreeAlgebra k (Gen μ)

/-- The relations of Stendhal diagrams (arXiv:1309.3796v2, Definition 4.5): the KLR relations
for `stendhalQ Q Λ`, dots on red strands vanish, and crossings of red strands vanish. -/
inductive Rel : Fr → Fr → Prop
  /-- The KLR relations, including (4.1a)–(4.1c) and (4.2). -/
  | klr {a b : Fr} (h : KLR.Rel k (stendhalQ Q Λ) μ a b) : Rel a b
  /-- Red strands carry no dots. -/
  | red_dot (a : Fin (Multiset.card μ)) (i : Seq μ) (h : (i.lbl a).isRight) :
      Rel (fx k μ a * fe k μ i) 0
  /-- Red strands do not cross. -/
  | red_cross (j : ℕ) (h : j + 1 < Multiset.card μ) (i : Seq μ)
      (h₁ : (i.lbl ⟨j, by omega⟩).isRight) (h₂ : (i.lbl ⟨j + 1, h⟩).isRight) :
      Rel (fψ k μ j * fe k μ i) 0

end Rel

variable (k) in
/-- The algebra of Stendhal diagrams with black strands of weight `ν` and red strands
`λ_1, …, λ_ℓ` in any order (arXiv:1309.3796v2, Definition 4.5, for all orders of `λ`). -/
def StendhalAlgebraAllOrders (ν : Multiset I) : Type _ :=
  RingQuot (Rel k Q Λ ν)

namespace StendhalAlgebraAllOrders

variable {Q Λ} {ν : Multiset I}

noncomputable instance : Ring (StendhalAlgebraAllOrders k Q Λ ν) :=
  inferInstanceAs (Ring (RingQuot _))
noncomputable instance : Algebra k (StendhalAlgebraAllOrders k Q Λ ν) :=
  inferInstanceAs (Algebra k (RingQuot _))

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

variable (k Q Λ ν) in
/-- The map from the KLR algebra of `stendhalQ Q Λ`. -/
noncomputable def ofKLR : KLRAlgebra k (stendhalQ Q Λ) μ →ₐ[k] StendhalAlgebraAllOrders k Q Λ ν :=
  RingQuot.liftAlgHom k ⟨RingQuot.mkAlgHom k (Rel k Q Λ ν),
    fun _ _ h => RingQuot.mkAlgHom_rel k (Rel.klr h)⟩

theorem ofKLR_mk (a : FreeAlgebra k (Gen μ)) :
    ofKLR k Q Λ ν (KLRAlgebra.mk k _ _ a) = RingQuot.mkAlgHom k (Rel k Q Λ ν) a :=
  RingQuot.liftAlgHom_mkAlgHom_apply _ _ _ _

/-- The idempotent `e(i)`. -/
noncomputable def e (i : Seq μ) : StendhalAlgebraAllOrders k Q Λ ν :=
  ofKLR k Q Λ ν (KLRAlgebra.e i)
/-- The dot on the strand at position `a`. -/
noncomputable def x (a : Fin m) : StendhalAlgebraAllOrders k Q Λ ν :=
  ofKLR k Q Λ ν (KLRAlgebra.x a)
/-- The crossing of the strands at positions `j`, `j + 1`. -/
noncomputable def ψ (j : ℕ) : StendhalAlgebraAllOrders k Q Λ ν :=
  ofKLR k Q Λ ν (KLRAlgebra.ψ j)

theorem ofKLR_surjective : Function.Surjective (ofKLR k Q Λ ν) := by
  intro y
  obtain ⟨a, rfl⟩ := RingQuot.mkAlgHom_surjective k (Rel k Q Λ ν) y
  exact ⟨_, ofKLR_mk a⟩

/-- Red strands carry no dots. -/
theorem x_mul_e_of_red (a : Fin m) (i : Seq μ) (h : (i.lbl a).isRight) :
    (x a * e i : StendhalAlgebraAllOrders k Q Λ ν) = 0 := by
  rw [x, e, KLRAlgebra.x, KLRAlgebra.e, ← map_mul, ← map_mul, ofKLR_mk,
    RingQuot.mkAlgHom_rel k (Rel.red_dot (Q := Q) (Λ := Λ) a i h), map_zero]
  rfl

/-- Red strands do not cross. -/
theorem ψ_mul_e_of_red (j : ℕ) (h : j + 1 < m) (i : Seq μ)
    (h₁ : (i.lbl ⟨j, by omega⟩).isRight) (h₂ : (i.lbl ⟨j + 1, h⟩).isRight) :
    (ψ j * e i : StendhalAlgebraAllOrders k Q Λ ν) = 0 := by
  rw [ψ, e, KLRAlgebra.ψ, KLRAlgebra.e, ← map_mul, ← map_mul, ofKLR_mk,
    RingQuot.mkAlgHom_rel k (Rel.red_cross (Q := Q) (Λ := Λ) j h i h₁ h₂), map_zero]
  rfl

omit [DecidableEq I] in
theorem qbar_X_zero_pow (n : ℕ) :
    qbar (X 0 ^ n : MvPolynomial (Fin 2) k) =
      ∑ t ∈ Finset.range n, X 0 ^ t * X 2 ^ (n - 1 - t) := by
  rw [X_pow_eq_monomial, qbar_monomial]
  simp

/-- **The bigon relation (4.2)** of arXiv:1309.3796v2, black strand left of red: undoing a
bigon between a black `i`-strand and the red strand `λ_r` costs `α_i^∨(λ_r)` dots on the black
strand. -/
theorem ψ_sq_black_red (j : ℕ) (h : j + 1 < m) (s : Seq μ) (i : I) (r : Fin ℓ)
    (hi : s.lbl ⟨j, by omega⟩ = .inl i) (hr : s.lbl ⟨j + 1, h⟩ = .inr r) :
    (ψ j * ψ j * e s : StendhalAlgebraAllOrders k Q Λ ν) =
      x ⟨j, by omega⟩ ^ Λ r i * e s := by
  have key := KLRAlgebra.ψ_sq (Q := stendhalQ Q Λ) j h s
  have hv : (![KLRAlgebra.x ⟨j, by omega⟩, KLRAlgebra.x ⟨j + 1, h⟩] :
      Fin 2 → KLRAlgebra k (stendhalQ Q Λ) μ) =
      fun a => KLRAlgebra.x (![⟨j, by omega⟩, ⟨j + 1, h⟩] a) := by
    funext a; fin_cases a <;> rfl
  rw [hi, hr] at key
  simp only [reduceCtorEq, ↓reduceIte] at key
  rw [stendhalQ_inl_inr, hv, KLRAlgebra.ncEval_eq_pol] at key
  simp only [map_pow, rename_X, KLRAlgebra.pol_X] at key
  have := congrArg (ofKLR k Q Λ ν) key
  simp only [map_mul, map_pow] at this
  simpa [ψ, e, x] using this

/-- **The bigon relation (4.2)** of arXiv:1309.3796v2, red strand left of black. -/
theorem ψ_sq_red_black (j : ℕ) (h : j + 1 < m) (s : Seq μ) (i : I) (r : Fin ℓ)
    (hr : s.lbl ⟨j, by omega⟩ = .inr r) (hi : s.lbl ⟨j + 1, h⟩ = .inl i) :
    (ψ j * ψ j * e s : StendhalAlgebraAllOrders k Q Λ ν) =
      x ⟨j + 1, h⟩ ^ Λ r i * e s := by
  have key := KLRAlgebra.ψ_sq (Q := stendhalQ Q Λ) j h s
  have hv : (![KLRAlgebra.x ⟨j, by omega⟩, KLRAlgebra.x ⟨j + 1, h⟩] :
      Fin 2 → KLRAlgebra k (stendhalQ Q Λ) μ) =
      fun a => KLRAlgebra.x (![⟨j, by omega⟩, ⟨j + 1, h⟩] a) := by
    funext a; fin_cases a <;> rfl
  rw [hi, hr] at key
  simp only [reduceCtorEq, ↓reduceIte] at key
  rw [stendhalQ_inr_inl, hv, KLRAlgebra.ncEval_eq_pol] at key
  simp only [map_pow, rename_X, KLRAlgebra.pol_X] at key
  have := congrArg (ofKLR k Q Λ ν) key
  simp only [map_mul, map_pow] at this
  simpa [ψ, e, x] using this

/-- **The relation (4.1a)** of arXiv:1309.3796v2: at a triple point of two black `i`-strands
and the red strand `λ_r` between them, the two sides of the braid move differ by
`∑_{a + b + 1 = α_i^∨(λ_r)} x_j^a x_{j+2}^b`. -/
theorem braid_black_red_black (j : ℕ) (h : j + 2 < m) (s : Seq μ) (i : I) (r : Fin ℓ)
    (hi : s.lbl ⟨j, by omega⟩ = .inl i) (hr : s.lbl ⟨j + 1, by omega⟩ = .inr r)
    (hi' : s.lbl ⟨j + 2, h⟩ = .inl i) :
    ((ψ j * ψ (j + 1) * ψ j - ψ (j + 1) * ψ j * ψ (j + 1)) * e s :
        StendhalAlgebraAllOrders k Q Λ ν) =
      (∑ t ∈ Finset.range (Λ r i), x ⟨j, by omega⟩ ^ t * x ⟨j + 2, h⟩ ^ (Λ r i - 1 - t)) *
        e s := by
  have key := KLRAlgebra.braid (Q := stendhalQ Q Λ) j h s
  have hv : (![KLRAlgebra.x ⟨j, by omega⟩, KLRAlgebra.x ⟨j + 1, by omega⟩,
      KLRAlgebra.x ⟨j + 2, h⟩] : Fin 3 → KLRAlgebra k (stendhalQ Q Λ) μ) =
      fun a => KLRAlgebra.x (![⟨j, by omega⟩, ⟨j + 1, by omega⟩, ⟨j + 2, h⟩] a) := by
    funext a; fin_cases a <;> rfl
  rw [hi, hr, hi'] at key
  simp only [ne_eq, reduceCtorEq, not_false_eq_true, and_self, ↓reduceIte] at key
  rw [stendhalQ_inl_inr,
    qbar_X_zero_pow, hv, KLRAlgebra.ncEval_eq_pol] at key
  simp only [map_sum, map_mul, map_pow, rename_X, KLRAlgebra.pol_X] at key
  have := congrArg (ofKLR k Q Λ ν) key
  simp only [map_mul, map_sub, map_sum, map_pow] at this
  simpa [ψ, e, x] using this

theorem e_mul_e (i j : Seq μ) :
    (e i * e j : StendhalAlgebraAllOrders k Q Λ ν) = if i = j then e i else 0 := by
  rw [e, e, ← map_mul, KLRAlgebra.e_mul_e]
  split_ifs <;> simp

open Classical in
variable (k Q Λ ν) in
/-- The sum of the idempotents `e(i)` whose red strands read `λ_1, …, λ_ℓ` from left to
right. -/
noncomputable def redOrderedIdem : StendhalAlgebraAllOrders k Q Λ ν :=
  ∑ i ∈ Finset.univ.filter (fun i : Seq μ => IsRedOrdered i), e i

open Classical in
theorem e_mul_redOrderedIdem (i : Seq μ) :
    e i * redOrderedIdem k Q Λ ν = if IsRedOrdered i then e i else 0 := by
  rw [redOrderedIdem, Finset.mul_sum]
  simp_rw [e_mul_e]
  rw [Finset.sum_ite_eq]
  simp

open Classical in
theorem redOrderedIdem_mul_e (i : Seq μ) :
    redOrderedIdem k Q Λ ν * e i = if IsRedOrdered i then e i else 0 := by
  rw [redOrderedIdem, Finset.sum_mul]
  simp_rw [e_mul_e]
  rw [Finset.sum_ite_eq']
  simp

theorem isIdempotentElem_redOrderedIdem :
    IsIdempotentElem (redOrderedIdem k Q Λ ν) := by
  classical
  unfold IsIdempotentElem
  conv_lhs => rw [redOrderedIdem, Finset.sum_mul]
  rw [redOrderedIdem]
  refine Finset.sum_congr rfl fun i hi => ?_
  exact (e_mul_redOrderedIdem (k := k) (Q := Q) (Λ := Λ) i).trans
    (by simp [(Finset.mem_filter.1 hi).2])

end StendhalAlgebraAllOrders

open StendhalAlgebraAllOrders

variable (k) in
/-- **Webster's algebra `T̃^λ`** (arXiv:1309.3796v2, Definitions 4.5 and 4.7), with black strands
of weight `ν`: Stendhal diagrams whose red strands are labelled `λ_1, …, λ_ℓ` from left to
right, the corner of `StendhalAlgebraAllOrders` at the sum `redOrderedIdem` of the idempotents
with this order of red strands. -/
abbrev StendhalAlgebra (ν : Multiset I) : Type _ :=
  (isIdempotentElem_redOrderedIdem (k := k) (Q := Q) (Λ := Λ) (ν := ν)).Corner

namespace StendhalAlgebra

variable {Q Λ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν

/-- The idempotent `e(i)` of `T̃^λ`, for a sequence `i` whose red strands are in the order
`λ_1, …, λ_ℓ`. -/
noncomputable def e (i : Seq μ) (hi : IsRedOrdered i) : StendhalAlgebra k Q Λ ν :=
  ⟨StendhalAlgebraAllOrders.e i, by
    classical
    rw [Subsemigroup.mem_corner_iff isIdempotentElem_redOrderedIdem,
      e_mul_redOrderedIdem, redOrderedIdem_mul_e]
    simp only [hi, ↓reduceIte]
    exact ⟨trivial, trivial⟩⟩

variable (k Q Λ ν) in
/-- **The violating ideal** `K` of arXiv:1309.3796v2, Definition 4.6, in `T̃^λ`: the two-sided
ideal generated by the idempotents `e(i)` whose leftmost strand is black. Every violated diagram
(Definition 4.3) factors through such an idempotent, cutting it at a slice where a black strand
is leftmost, and these idempotents are violated diagrams. -/
noncomputable def violatedIdeal : TwoSidedIdeal (StendhalAlgebra k Q Λ ν) :=
  TwoSidedIdeal.span {y | ∃ (i : Seq μ) (hi : IsRedOrdered i), IsViolated i ∧ y = e i hi}

end StendhalAlgebra

variable (k) in
/-- **Webster's tensor product algebra `T^λ`** (arXiv:1309.3796v2, Definitions 4.6 and 4.7),
with black strands of weight `ν`: the quotient of `T̃^λ` by the ideal generated by violated
diagrams. -/
abbrev TensorProductAlgebra (ν : Multiset I) : Type _ :=
  (StendhalAlgebra.violatedIdeal k Q Λ ν).ringCon.Quotient

/-- The quotient map `T̃^λ → T^λ`. -/
noncomputable def TensorProductAlgebra.mk (ν : Multiset I) :
    StendhalAlgebra k Q Λ ν →ₐ[k] TensorProductAlgebra k Q Λ ν :=
  (StendhalAlgebra.violatedIdeal k Q Λ ν).ringCon.mkₐ k


end Categorification.Stendhal
