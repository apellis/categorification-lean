import Categorification.TwoRep.GeneratedEquivariant
import Mathlib.Algebra.BigOperators.GroupWithZero.Action

/-!
# Morphisms of strongly equivariant functors out of a module category generated by one object

Let `ℵ₁, ℵ₂` be 2-representations of `B` and `P₀ ∈ ℵ₁(a)` an object whose images are dense in
every `ℵ₁(c)` and at which evaluation of 2-morphisms is full. For strongly equivariant functors
`β, β' : ℵ₁ ⟶ ℵ₂`, every morphism `c₀ : β(P₀) ⟶ β'(P₀)` is the component at `P₀` of a unique
modification `β ⟶ β'` (`modificationOfHom`, `modificationOfHom_app`, with uniqueness
`modification_ext`). No compatibility of `c₀` with the endomorphisms of `P₀` is needed: by
fullness these are evaluations of 2-morphisms, and `ℵ₂` sends 2-morphisms to natural
transformations, which commute with `c₀`.

In particular `End(β(P₀))` acts on `β` by modifications (`homAt_comp`, `homAt_id`), additively
and `k`-linearly (`homAt_add`, `homAt_smul`). This is the action of `End(C)` on the
strongly equivariant functor `φ_C` behind the base change functor `φ'_C` of B. Webster,
*Knot invariants and higher representation theory*, arXiv:1309.3796v2, Corollary 3.27 (2).
-/

namespace Categorification.TwoRep.Generated

open CategoryTheory Bicategory Limits Pseudofunctor.StrongTrans

universe w v u w₁ v₁ u₁

variable {k : Type w} [CommRing k] {B : Type u₁} [Bicategory.{w₁, v₁} B]
  {ℵ₁ ℵ₂ : Pseudofunctor B (LinearCat.{w, v, u} k)} {a : B} {P₀ : ℵ₁.obj a}

section Hom

variable {β β' : ℵ₁ ⟶ ℵ₂} (c₀ : (β.app a).obj.obj P₀ ⟶ (β'.app a).obj.obj P₀)

/-- The component at `ℵ₁(f) P₀` of the modification `β ⟶ β'` extending `c₀`. -/
def homComponent {c : B} (f : a ⟶ c) :
    (β.app c).obj.obj (family P₀ c f) ⟶ (β'.app c).obj.obj (family P₀ c f) :=
  (natApp β f P₀).hom ≫ (ℵ₂.map f).obj.map c₀ ≫ (natApp β' f P₀).inv

variable (hF : Full ℵ₁ P₀)

include hF in
theorem homComponent_natural {c : B} {f f' : a ⟶ c} (g : family P₀ c f ⟶ family P₀ c f') :
    (β.app c).obj.map g ≫ homComponent c₀ f' = homComponent c₀ f ≫ (β'.app c).obj.map g := by
  obtain ⟨φ, rfl⟩ := hF f f' g
  have w : (β.app c).obj.map ((ℵ₁.map₂ φ).hom.app P₀) ≫ (natApp β f' P₀).hom =
      (natApp β f P₀).hom ≫ (ℵ₂.map₂ φ).hom.app ((β.app a).obj.obj P₀) :=
    congrArg (fun θ => θ.hom.app P₀) (β.naturality_naturality φ)
  have w' : (β'.app c).obj.map ((ℵ₁.map₂ φ).hom.app P₀) ≫ (natApp β' f' P₀).hom =
      (natApp β' f P₀).hom ≫ (ℵ₂.map₂ φ).hom.app ((β'.app a).obj.obj P₀) :=
    congrArg (fun θ => θ.hom.app P₀) (β'.naturality_naturality φ)
  have m := (ℵ₂.map₂ φ).hom.naturality c₀
  have w'' : (natApp β' f P₀).inv ≫ (β'.app c).obj.map ((ℵ₁.map₂ φ).hom.app P₀) =
      (ℵ₂.map₂ φ).hom.app ((β'.app a).obj.obj P₀) ≫ (natApp β' f' P₀).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← w', Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  simp only [homComponent]
  rw [← Category.assoc, w, Category.assoc, Category.assoc, Category.assoc, w'']
  congr 1
  rw [← Category.assoc, ← Category.assoc]
  congr 1
  exact m.symm

variable (hD : ∀ c : B, IsDenseFamily (family P₀ c))

/-- The components at `c` of the modification `β ⟶ β'` extending `c₀`. -/
noncomputable def homAt (c : B) : β.app c ⟶ β'.app c :=
  ObjectProperty.homMk ((hD c).extendNatTrans (F := (β.app c).obj) (G := (β'.app c).obj)
    (fun f => homComponent c₀ f) (fun g => homComponent_natural c₀ hF g))

theorem homAt_hom_app {c : B} (f : a ⟶ c) :
    (homAt c₀ hF hD c).hom.app (family P₀ c f) = homComponent c₀ f :=
  IsDenseFamily.extendNatTrans_app (hD c) _ (fun g => homComponent_natural c₀ hF g) f

theorem homAt_naturality {c d : B} (h : c ⟶ d) :
    ℵ₁.map h ◁ homAt c₀ hF hD d ≫ (β'.naturality h).hom =
      (β.naturality h).hom ≫ homAt c₀ hF hD c ▷ ℵ₂.map h := by
  apply ObjectProperty.hom_ext
  refine IsDenseFamily.natTrans_ext (hD c) (fun f => ?_)
  have nat := (homAt c₀ hF hD d).hom.naturality (mapCompApp ℵ₁ f h P₀).hom
  have Nβ : (natApp β (f ≫ h) P₀).hom ≫ (mapCompApp ℵ₂ f h ((β.app a).obj.obj P₀)).hom =
      (β.app d).obj.map (mapCompApp ℵ₁ f h P₀).hom ≫ 𝟙 _ ≫
        (natApp β h ((ℵ₁.map f).obj.obj P₀)).hom ≫ 𝟙 _ ≫
          (ℵ₂.map h).obj.map (natApp β f P₀).hom ≫ 𝟙 _ :=
    congrArg (fun θ => θ.hom.app P₀) (β.naturality_comp f h)
  have Nβ' : (natApp β' (f ≫ h) P₀).hom ≫ (mapCompApp ℵ₂ f h ((β'.app a).obj.obj P₀)).hom =
      (β'.app d).obj.map (mapCompApp ℵ₁ f h P₀).hom ≫ 𝟙 _ ≫
        (natApp β' h ((ℵ₁.map f).obj.obj P₀)).hom ≫ 𝟙 _ ≫
          (ℵ₂.map h).obj.map (natApp β' f P₀).hom ≫ 𝟙 _ :=
    congrArg (fun θ => θ.hom.app P₀) (β'.naturality_comp f h)
  have hq : (ℵ₂.map (f ≫ h)).obj.map c₀ ≫ (mapCompApp ℵ₂ f h ((β'.app a).obj.obj P₀)).hom =
      (mapCompApp ℵ₂ f h ((β.app a).obj.obj P₀)).hom ≫
        (ℵ₂.map h).obj.map ((ℵ₂.map f).obj.map c₀) :=
    (ℵ₂.mapComp f h).hom.hom.naturality c₀
  change (homAt c₀ hF hD d).hom.app ((ℵ₁.map h).obj.obj ((ℵ₁.map f).obj.obj P₀)) ≫
      (natApp β' h ((ℵ₁.map f).obj.obj P₀)).hom =
    (natApp β h ((ℵ₁.map f).obj.obj P₀)).hom ≫
      (ℵ₂.map h).obj.map ((homAt c₀ hF hD c).hom.app (family P₀ c f))
  rw [homAt_hom_app]
  exact isoAt_naturality_aux (β.app d).obj (β'.app d).obj (ℵ₂.map h).obj (mapCompApp ℵ₁ f h P₀) _ _
    nat (natApp β (f ≫ h) P₀) _ (natApp β' (f ≫ h) P₀) (homAt_hom_app c₀ hF hD (f ≫ h))
    _ _ _ hq _ _ _ _ Nβ Nβ'

/-- **Morphisms of strongly equivariant functors from their component at `P₀`**: when the
images of `P₀` are dense and full, every morphism `β(P₀) ⟶ β'(P₀)` extends to a modification
`β ⟶ β'`. -/
noncomputable def modificationOfHom : Modification β β' where
  app := homAt c₀ hF hD
  naturality h := homAt_naturality c₀ hF hD h

theorem homAt_app :
    (homAt c₀ hF hD a).hom.app P₀ = c₀ := by
  have nat := (homAt c₀ hF hD a).hom.naturality (idApp ℵ₁ a P₀).hom
  have Nβ : (natApp β (𝟙 a) P₀).hom ≫ (idApp ℵ₂ a ((β.app a).obj.obj P₀)).hom =
      (β.app a).obj.map (idApp ℵ₁ a P₀).hom ≫ 𝟙 _ ≫ 𝟙 _ :=
    congrArg (fun θ => θ.hom.app P₀) (β.naturality_id a)
  have Nβ' : (natApp β' (𝟙 a) P₀).hom ≫ (idApp ℵ₂ a ((β'.app a).obj.obj P₀)).hom =
      (β'.app a).obj.map (idApp ℵ₁ a P₀).hom ≫ 𝟙 _ ≫ 𝟙 _ :=
    congrArg (fun θ => θ.hom.app P₀) (β'.naturality_id a)
  have hq : (ℵ₂.map (𝟙 a)).obj.map c₀ ≫ (idApp ℵ₂ a ((β'.app a).obj.obj P₀)).hom =
      (idApp ℵ₂ a ((β.app a).obj.obj P₀)).hom ≫ c₀ :=
    (ℵ₂.mapId a).hom.hom.naturality c₀
  exact strongTransIso_aux (β.app a).obj (β'.app a).obj (idApp ℵ₁ a P₀) _ _ nat
    (natApp β (𝟙 a) P₀) _ (natApp β' (𝟙 a) P₀) (homAt_hom_app c₀ hF hD (𝟙 a)) _ _ _ hq Nβ Nβ'

/-- The modification extending `c₀` has component `c₀` at `P₀`. -/
theorem modificationOfHom_app :
    ((modificationOfHom c₀ hF hD).app a).hom.app P₀ = c₀ :=
  homAt_app c₀ hF hD

end Hom

section Algebra

variable (hF : Full ℵ₁ P₀) (hD : ∀ c : B, IsDenseFamily (family P₀ c))

/-- The component of a modification at any object, expanded along a decomposition into images
of `P₀`, in terms of its component at `P₀`. -/
theorem modification_app_eq_sum {β β' : ℵ₁ ⟶ ℵ₂} (Γ : Modification β β') {c : B}
    {X : ℵ₁.obj c} (d : RetractDecomposition (family P₀ c) X) :
    (Γ.app c).hom.app X = ∑ i, (β.app c).obj.map (d.q i) ≫
      homComponent ((Γ.app a).hom.app P₀) (d.t i) ≫ (β'.app c).obj.map (d.p i) := by
  rw [IsDenseFamily.app_eq_sum d (Γ.app c).hom]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [modification_app_family]
  rfl

theorem homAt_app_eq_sum {β β' : ℵ₁ ⟶ ℵ₂} (c₂ : (β.app a).obj.obj P₀ ⟶ (β'.app a).obj.obj P₀)
    {c : B} (X : ℵ₁.obj c) :
    (homAt c₂ hF hD c).hom.app X = ∑ i, (β.app c).obj.map (((hD c).decomp X).q i) ≫
      homComponent c₂ (((hD c).decomp X).t i) ≫ (β'.app c).obj.map (((hD c).decomp X).p i) := by
  have e := modification_app_eq_sum (modificationOfHom c₂ hF hD) ((hD c).decomp X)
  rw [modificationOfHom_app] at e
  exact e

theorem homAt_add {β β' : ℵ₁ ⟶ ℵ₂} (c₀ c₁ : (β.app a).obj.obj P₀ ⟶ (β'.app a).obj.obj P₀)
    {c : B} (X : ℵ₁.obj c) :
    (homAt (c₀ + c₁) hF hD c).hom.app X =
      (homAt c₀ hF hD c).hom.app X + (homAt c₁ hF hD c).hom.app X := by
  rw [homAt_app_eq_sum, homAt_app_eq_sum, homAt_app_eq_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [homComponent, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add]

theorem homAt_smul {β β' : ℵ₁ ⟶ ℵ₂} (r : k) (c₀ : (β.app a).obj.obj P₀ ⟶ (β'.app a).obj.obj P₀)
    {c : B} (X : ℵ₁.obj c) :
    (homAt (r • c₀) hF hD c).hom.app X = r • (homAt c₀ hF hD c).hom.app X := by
  rw [homAt_app_eq_sum, homAt_app_eq_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [homComponent, Functor.map_smul, Linear.smul_comp, Linear.comp_smul]

theorem homAt_comp {β β' β'' : ℵ₁ ⟶ ℵ₂} (c₀ : (β.app a).obj.obj P₀ ⟶ (β'.app a).obj.obj P₀)
    (c₁ : (β'.app a).obj.obj P₀ ⟶ (β''.app a).obj.obj P₀) {c : B} (X : ℵ₁.obj c) :
    (homAt (c₀ ≫ c₁) hF hD c).hom.app X =
      (homAt c₀ hF hD c).hom.app X ≫ (homAt c₁ hF hD c).hom.app X := by
  let Γ : Modification β β'' :=
    { app := fun c => homAt c₀ hF hD c ≫ homAt c₁ hF hD c
      naturality := fun {c d} h => by
        rw [whiskerLeft_comp, Category.assoc, homAt_naturality, ← Category.assoc,
          homAt_naturality, Category.assoc, comp_whiskerRight] }
  have := modification_ext hD (Γ := modificationOfHom (c₀ ≫ c₁) hF hD) (Γ' := Γ) (by
    rw [modificationOfHom_app]
    change _ = (homAt c₀ hF hD a).hom.app P₀ ≫ (homAt c₁ hF hD a).hom.app P₀
    rw [homAt_app, homAt_app])
  exact congrArg (fun Θ => (Θ.app c).hom.app X) this

theorem homAt_id (β : ℵ₁ ⟶ ℵ₂) {c : B} (X : ℵ₁.obj c) :
    (homAt (𝟙 ((β.app a).obj.obj P₀)) hF hD c).hom.app X = 𝟙 _ := by
  let Γ : Modification β β :=
    { app := fun c => 𝟙 _
      naturality := fun {c d} h => by simp }
  have := modification_ext hD (Γ := modificationOfHom (𝟙 _) hF hD) (Γ' := Γ) (by
    rw [modificationOfHom_app]; rfl)
  exact congrArg (fun Θ => (Θ.app c).hom.app X) this

end Algebra

end Categorification.TwoRep.Generated
