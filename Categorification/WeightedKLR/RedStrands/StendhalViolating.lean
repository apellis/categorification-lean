import Categorification.WeightedKLR.RedStrands.StendhalSurjective

/-!
# Webster's Theorem 3.6: the tensor product algebra as a reduced weighted KLR algebra

B. Webster, *Weighted Khovanov–Lauda–Rouquier algebras*, arXiv:1209.2463v4, Theorem 3.6:
the tensor product algebra `T^λ` is isomorphic to the reduced weighted KLR algebra of the
Crawley-Boevey graph cut down to the Stendhal chambers, modulo the idempotents of the chambers
whose leftmost strand is black.

## Main results

* `stTildeEquiv_e`: the isomorphism of Theorem 3.5 sends `e(i)` to the idempotent of the
  chamber `stFull i`.
* `comap_stViolatingIdeal`: it maps the violating ideal onto `stViolatingIdeal`, the ideal
  generated by the idempotents of the Stendhal chambers whose leftmost strand is black.
* `stTensorEquiv`: the ring isomorphism of Theorem 3.6.

## Route hypotheses

As for `stTildeEquiv`, the hypotheses `hE` and `hl` are used only by the construction of the
homomorphism through the polynomial representation; they are not hypotheses of Webster's
Theorem 3.6.
-/

namespace TwoSidedIdeal

variable {R S : Type*} [Ring R] [Ring S]

/-- The preimage under a ring isomorphism of the ideal generated by the image of a set is the
ideal generated by the set. -/
theorem comap_span_image (f : R ≃+* S) (s : Set R) :
    comap f (span (f '' s)) = span s := by
  refine le_antisymm (fun x hx => ?_) (span_le.2 fun x hx => ?_)
  · have h : span (f '' s) ≤ comap f.symm (span s) :=
      span_le.2 fun _ ⟨y, hy, hyx⟩ => by
        rw [SetLike.mem_coe, mem_comap, ← hyx, RingEquiv.symm_apply_apply]
        exact subset_span hy
    have := h ((mem_comap _).1 hx)
    rwa [mem_comap, RingEquiv.symm_apply_apply] at this
  · rw [SetLike.mem_coe, mem_comap]
    exact subset_span ⟨x, hx, rfl⟩

end TwoSidedIdeal

namespace Categorification.Stendhal

open Categorification.WeightedKLR GalleryAlgebra StendhalAlgebraAllOrders

variable {I : Type} [DecidableEq I] {ℓ : ℕ} (ν : Multiset I)
  {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] (k : Type*) [CommRing k]
  (Γ : WeightedGraph I 𝕜 k) (Λ : Fin ℓ → I →₀ ℕ) {ϖ : Fin ℓ → 𝕜}

variable {Γ} in
/-- **The violating ideal of the reduced algebra** (arXiv:1209.2463v4, Theorem 3.6): in the
chamber algebra of the Stendhal chambers modulo the dot on the `0`-strand, the two-sided ideal
generated by the idempotents `e(stFull i)` of the sequences `i` whose leftmost strand is
black. -/
noncomputable def stViolatingIdeal (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) :
    TwoSidedIdeal (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.Quotient :=
  TwoSidedIdeal.span {y | ∃ j : OrdSeq ℓ ν, IsViolated j.1 ∧
    y = (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k
      (chamberLin (stFull Λ hϖ hw0) j j (e (stFull Λ hϖ hw0 j)))}

variable {ν k Γ Λ}

/-- The isomorphism of Theorem 3.5 sends the idempotent `e(i)` of `T̃^λ` to the idempotent of
the chamber `stFull i`. -/
theorem stTildeEquiv_e (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (hS : Γ.Standing) (i : KLR.Seq (stendhalWeight ℓ ν)) (hi : IsRedOrdered i) :
    stTildeEquiv ν k Γ Λ hD hE hl hϖ hw0 hS (StendhalAlgebra.e i hi) =
      (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k
        (chamberLin (stFull Λ hϖ hw0) ⟨i, hi⟩ ⟨i, hi⟩ (e (stFull Λ hϖ hw0 ⟨i, hi⟩))) := by
  rw [stTildeEquiv_apply, stTildeHom_apply]
  refine (stStendhalHom_e hD hE hl hϖ hw0 hS i).trans ?_
  rw [KLR.fe, stFreeHom_ι, ← chamberElt_stGenMat_idem (k := k) (Λ := Λ) hϖ hw0 ⟨i, hi⟩]

/-- **The violating ideals correspond** (arXiv:1209.2463v4, proof of Theorem 3.6): the
isomorphism of Theorem 3.5 maps the violating ideal of `T̃^λ` onto the ideal generated by the
idempotents of the Stendhal chambers whose leftmost strand is black. -/
theorem comap_stViolatingIdeal (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (hS : Γ.Standing) :
    TwoSidedIdeal.comap (stTildeEquiv ν k Γ Λ hD hE hl hϖ hw0 hS)
        (stViolatingIdeal ν k Λ hϖ hw0) =
      StendhalAlgebra.violatedIdeal k Γ.klrQ Λ ν := by
  rw [StendhalAlgebra.violatedIdeal,
    ← TwoSidedIdeal.comap_span_image (stTildeEquiv ν k Γ Λ hD hE hl hϖ hw0 hS), stViolatingIdeal]
  congr 2
  ext y
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨_, ⟨j.1, j.2, hj, rfl⟩, stTildeEquiv_e hD hE hl hϖ hw0 hS j.1 j.2⟩
  · rintro ⟨_, ⟨i, hi, hv, rfl⟩, rfl⟩
    exact ⟨⟨i, hi⟩, hv, stTildeEquiv_e hD hE hl hϖ hw0 hS i hi⟩

variable (ν k Γ Λ) in
/-- **Webster's Theorem 3.6** (arXiv:1209.2463v4): the tensor product algebra `T^λ`
(`TensorProductAlgebra k Γ.klrQ Λ ν`, the quotient of `T̃^λ` by the violating ideal) is
isomorphic to the reduced weighted KLR algebra of the Crawley-Boevey graph cut down to the
Stendhal chambers (the target of `stTildeEquiv`), modulo the ideal `stViolatingIdeal`
generated by the idempotents of the chambers whose leftmost strand is black.

The hypotheses `hE` and `hl` say that `Γ` has no loops, as for `stTildeEquiv`. -/
noncomputable def stTensorEquiv (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (hS : Γ.Standing) :
    TensorProductAlgebra k Γ.klrQ Λ ν ≃+* (stViolatingIdeal ν k Λ hϖ hw0).ringCon.Quotient :=
  RingCon.congr (stTildeEquiv ν k Γ Λ hD hE hl hϖ hw0 hS)
    (congrArg TwoSidedIdeal.ringCon (comap_stViolatingIdeal hD hE hl hϖ hw0 hS).symm)

theorem stTensorEquiv_mk (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (hS : Γ.Standing) (x : StendhalAlgebra k Γ.klrQ Λ ν) :
    stTensorEquiv ν k Γ Λ hD hE hl hϖ hw0 hS
        (TensorProductAlgebra.mk (k := k) (Q := Γ.klrQ) (Λ := Λ) ν x) =
      (stViolatingIdeal ν k Λ hϖ hw0).ringCon.mkₐ k
        (stTildeEquiv ν k Γ Λ hD hE hl hϖ hw0 hS x) :=
  rfl

end Categorification.Stendhal
