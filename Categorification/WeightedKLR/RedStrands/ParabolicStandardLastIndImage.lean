import Categorification.WeightedKLR.RedStrands.ParabolicStandardLastIndLeft

/-!
# The image of `S(₁F_i N)` in `F_i(S N)`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, proof of
Proposition 5.5, `F`-part. The map `δ₁ : S(₁F_i N) → F_i(S N)` lands in the submodule `O`
generated by the ideal of diagrams whose last red strand ends strictly right of its position in
`θ + (i + β)`, the kernel of `F_i(S N) → S(₂F_i N)` (`ker_lastIndQuotientMap`): its generators
`G [1 ⊗ (1 ⊗ n)]` start with the idempotent `1_{α + i, β'}`, whose last red strand ends after
position `|α|`.

## Main results

* `tensorOfKLR_e_mem_smallerSuffixIdeal`: an idempotent whose last red strand ends after `p`
  lies in the ideal of smaller suffixes at `p`.
* `range_firstIndDeltaT_le`: the image of `δ₁` lies in `O`.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra InductionAlong MulOpposite
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

/-- An idempotent whose last red strand ends strictly right of `p` lies in the ideal of
smaller suffixes at `p` (it is zero in `T(ν)` unless red-ordered). -/
theorem tensorOfKLR_e_mem_smallerSuffixIdeal {I : Type} [DecidableEq I] {k : Type*} [CommRing k]
    {ℓ : ℕ} {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin (ℓ + 1) → I →₀ ℕ} (ν : Multiset I)
    (s : Seq (stendhalWeight (ℓ+1) ν)) (p a : Fin (Multiset.card (stendhalWeight (ℓ+1) ν)))
    (hpa : p < a) (hred : s.lbl a = .inr (Fin.last ℓ)) :
    tensorOfKLR Q Λ ν (KLRAlgebra.e s) ∈ smallerSuffixIdeal Q Λ p := by
  by_cases hs : IsRedOrdered s
  · rw [tensorOfKLR_e_of_ordered ν s hs]
    exact TwoSidedIdeal.subset_span ⟨s, hs, a, hpa, hred, rfl⟩
  · have h0 : orderProjection Q Λ ν (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (KLRAlgebra.e s)) =
        0 := Subtype.ext ((StendhalAlgebraAllOrders.e_mul_redOrderedIdem s).trans (by simp [hs]))
    rw [tensorOfKLR, h0, map_zero]
    exact zero_mem _

variable {I : Type} {k : Type*} [DecidableEq I] [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ) (i : I) (θ β : Multiset I)

local notation "Si" j => (Singleton.singleton j : Multiset I)
local notation "T′" => TensorProductAlgebra k Q Λ ((Si i) + (θ + β))
local notation "Aₚ" => Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ)
local notation "S" => stendhalQ Q Λ
local notation "Aₗ" => Multiset.map (Sum.map (id : I → I) (fun _ : Fin 1 => Fin.last ℓ))
  (stendhalWeight 1 β)
local notation "cst" => castTensorProductAlgebra Q Λ (lastInd_blackWeight i θ β)
local notation "cst₁" => castTensorProductAlgebra Q Λ (firstInd_blackWeight i θ β)
local notation "affT" => firstIndAffine Q Λ i θ β
local notation "p′" => LastRedWeightSplit.position (θ + ((Si i) + β)) (lastIndSplit i θ β) ℓ
local notation "I′" => smallerSuffixIdeal Q Λ p′
local notation "p₁" => LastRedWeightSplit.position (((Si i) + θ) + β) (firstIndSplit i θ β) ℓ
local notation "I₁" => smallerSuffixIdeal Q Λ p₁

omit [Field k] in
/-- In the block set of `(α + i, β')`, the last red strand ends after position `|α|`. -/
theorem exists_lastRed_of_mem_botSet (s : Seq (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}))
    (hs : s ∈ botSet (firstQuad_h Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1)))) :
    ∃ a : Fin (Multiset.card (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))})),
      (Aₚ).card < a.val ∧ s.lbl a = .inr (Fin.last ℓ) := by
  obtain ⟨s₃, s₄, rfl⟩ := (mem_botSet_iff _).1 hs
  obtain ⟨c, -, hc⟩ := Multiset.mem_map.1
    (show (Sum.inr (Fin.last ℓ) : I ⊕ Fin (ℓ + 1)) ∈ Finset.univ.val.map s₄.1 from
      s₄.2.symm ▸ lastRed_mem_lastWeight (ℓ := ℓ) β)
  have hcA : Multiset.card (Aₚ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}) = (Aₚ).card + 1 := by simp
  have hcT : Multiset.card (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}) =
      (Aₚ).card + (Aₗ).card + 1 := by simp
  have hc4 := c.2
  have hP : (Aₚ).card + 1 + c.val < Multiset.card (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}) :=
    by omega
  refine ⟨⟨(Aₚ).card + 1 + c.val, hP⟩, by simp only; omega, ?_⟩
  change (seqCast _ (s₃.append s₄)).1 _ = _
  rw [seqCast_append_apply_ge _ _ _ _ (by simp only [hcA]; omega)]
  exact (Seq.apply_congr s₄ (b := c) (by simp only [hcA]; omega)).trans hc

/-- The idempotents of the block set of `(α + i, β')` lie in the ideal of smaller suffixes. -/
theorem cst_firstIndAffine_e_mem (s : Seq (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}))
    (hs : s ∈ botSet (firstQuad_h Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1)))) :
    cst (affT (KLRAlgebra.e s)) ∈ I′ := by
  obtain ⟨a, ha, hred⟩ := exists_lastRed_of_mem_botSet i θ β s hs
  rw [firstIndAffine_apply, castTensorProductAlgebra_mk, castKLR_e, castKLR_e]
  refine tensorOfKLR_e_mem_smallerSuffixIdeal _ _ _ (Fin.cast (by simp [stendhalWeight]; omega) a)
    ?_ hred
  change (p′).val < a.val
  rw [lastIndPosition_val]
  exact ha

/-- `G = 1_{α + i, β'} ψ_d^* 1_{α + β', i}` lies in the ideal of smaller suffixes. -/
theorem cst_firstIndAffine_firstG_mem :
    cst (affT (firstG S Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1)))) ∈ I′ := by
  rw [firstG, mul_assoc, map_mul, map_mul]
  refine TwoSidedIdeal.mul_mem_right _ _ _ ?_
  rw [botOne, eSum, map_sum, map_sum]
  exact sum_mem fun s hs => cst_firstIndAffine_e_mem Q Λ i θ β s hs

variable (N : Type*) [AddCommGroup N] [Module k N] [Module (parabolicFactorAlgebra Q Λ θ β) N]
  [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N] (hQ : KLRSymm Q)

local notation "O" => lastIndKernel Q Λ i θ β N hQ
local notation "ρ₁" => firstIndLayerAction Q Λ i θ β N hQ
local notation "κ₁" => firstIndKLRAction Q Λ i θ β N hQ

/-- The generators `G [1 ⊗ (1 ⊗ n)]` lie in `O`. -/
theorem firstIndGen_mem (n : N) :
    (show LastIndF Q Λ i θ β N hQ from firstIndGen Q Λ i θ β N hQ n) ∈ O := by
  refine Submodule.subset_span ⟨_, cst_firstIndAffine_firstG_mem Q Λ i θ β,
    show LastIndF Q Λ i θ β N hQ from firstIndUnitGen Q Λ i θ β N hQ n, ?_⟩
  rw [AlgEquiv.symm_apply_apply]
  rfl

theorem firstIndAction_mem (a : TensorProductAlgebra k Q Λ (((Si i) + θ) + β))
    (m : FirstIndF Q Λ i θ β N hQ) (hm : (show LastIndF Q Λ i θ β N hQ from m) ∈ O) :
    (show LastIndF Q Λ i θ β N hQ from firstIndAction Q Λ i θ β N hQ a m) ∈ O :=
  Submodule.smul_mem O ((cst₁).symm a) hm

theorem firstIndLayerAction_mem (c : (I₁).ringCon.Quotient)
    (m : FirstIndF Q Λ i θ β N hQ) (hm : (show LastIndF Q Λ i θ β N hQ from m) ∈ O) :
    (show LastIndF Q Λ i θ β N hQ from ρ₁ c m) ∈ O := by
  obtain ⟨a, rfl⟩ := RingCon.mk'_surjective (I₁).ringCon c
  exact firstIndAction_mem Q Λ i θ β N hQ a m hm

theorem firstIndLeftMap_mem (y : Ind N (leftAppendHom Q Λ i θ β)) :
    (show LastIndF Q Λ i θ β N hQ from firstIndLeftMap Q Λ i θ β N hQ y) ∈ O := by
  induction y using Ind.induction_on with
  | zero => rw [map_zero]; exact zero_mem _
  | tmul z n =>
    rw [firstIndLeftMap_tmul]
    exact firstIndLayerAction_mem Q Λ i θ β N hQ _ _ (firstIndGen_mem Q Λ i θ β N hQ n)
  | add s t hs ht => rw [map_add]; exact add_mem hs ht

theorem firstIndShuffle_mem
    (x : ParabolicShuffle Q Λ ((Si i) + θ) β (FirstIndLeft Q Λ i θ β N)) :
    (show LastIndF Q Λ i θ β N hQ from firstIndShuffle Q Λ i θ β N hQ x) ∈ O := by
  induction x using BalancedTensor.induction_on with
  | zero => rw [map_zero]; exact zero_mem _
  | tmul r y =>
    rw [firstIndShuffle_tmul]
    exact firstIndAction_mem Q Λ i θ β N hQ _ _ (firstIndLeftMap_mem Q Λ i θ β N hQ y)
  | add x y hx hy => rw [map_add]; exact add_mem hx hy

/-- **The image of `δ₁ : S(₁F_i N) → F_i(S N)` lies in `O`**, the kernel of
`F_i(S N) → S(₂F_i N)` (Webster, arXiv:1309.3796v3, proof of Prop. 5.5). -/
theorem firstIndDelta_mem (m : FirstIndStandardT Q Λ i θ β N hQ) :
    (show LastIndF Q Λ i θ β N hQ from firstIndDeltaT Q Λ i θ β N hQ m) ∈ O := by
  obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective (excludedSpace
    (parabolicShuffleAction Q Λ ((Si i) + θ) β (FirstIndLeft Q Λ i θ β N))
    (parabolicOrderedLoadings (ℓ := ℓ) ((Si i) + θ) β)) m
  exact firstIndShuffle_mem Q Λ i θ β N hQ x

end Categorification.Stendhal
