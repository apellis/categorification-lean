import Categorification.WeightedKLR.RedStrands.CyclotomicCoverRedDotAction
import Categorification.WeightedKLR.RedStrands.DoubleBoundary
import Categorification.KLR.Prop320

/-!
# Support of signed cyclotomic words in the order of their red strands

Webster, arXiv:1309.3796v2, §4.1, Definition 4.5, and arXiv:1309.3796v3,
§4.6, proof of Lemma 4.29. The ordinary tensor-product quotient kills
idempotents at unordered red loadings. A black restriction preserves the
span determined by the red subword, by the cyclotomic word-deletion
formula of Hu–Shi, arXiv:2108.05508v5, §3, Proposition 3.3. This proves
the corresponding vanishing on modules obtained from signed block paths.
The cited injectivity argument is the one revised in version 3; arXiv:1309.3796v2,
§4.5, Lemma 4.28, argues via Lemma 4.26 instead.
-/

noncomputable section

namespace Categorification.Stendhal

open CategoryTheory KLR KLRAlgebra CyclotomicAction InductionAlong
universe u v w

section Modules

variable {A B : Type u} [Ring A] [Ring B] (φ : A →ₙ+* B)
  (I : TwoSidedIdeal A) (J : TwoSidedIdeal B)

/-- Induction transports modules generated by the lower ideal to modules
generated by an upper ideal containing its image. -/
theorem ind_idealActionSpan (h : ∀ a ∈ I, φ a ∈ J) (M : ModuleCat.{max u w} A)
    (hM : ∀ m : M, m ∈ idealActionSpan I) (z : Ind M φ) : z ∈ idealActionSpan J := by
  induction z using Ind.induction_on with
  | zero => exact Submodule.zero_mem _
  | add _ _ ih₁ ih₂ => exact Submodule.add_mem _ ih₁ ih₂
  | tmul x m =>
    suffices H : ∀ y : Corner φ, Ind.tmul y m ∈ idealActionSpan J from H x
    induction hM m using Submodule.span_induction with
    | mem _ hm =>
      obtain ⟨a, ha, n, rfl⟩ := hm
      intro y
      rw [← Ind.op_smul_tmul]
      have he : (y.val * φ a) • unitGen φ = MulOpposite.op a • y :=
        Subtype.ext (mul_mem_corner φ y.val a)
      exact Submodule.subset_span ⟨y.val * φ a, J.mul_mem_left _ _ (h a ha), Ind.tmul (unitGen φ) n,
        by rw [Ind.smul_tmul, he]⟩
    | zero => intro y; rw [Ind.tmul_zero]; exact Submodule.zero_mem _
    | add m n _ _ hm hn => intro y; rw [Ind.tmul_add]; exact Submodule.add_mem _ (hm y) (hn y)
    | smul a m _ hm => intro y; rw [← Ind.op_smul_tmul]; exact hm _

/-- Project a module element to the corner defining its restriction. -/
def resCut (M : Type*) [AddCommGroup M] [Module B M] (m : M) : InductionAlong.Res φ M :=
  InductionAlong.Res.mk (φ 1 • m) (by rw [smul_smul, ← map_mul, one_mul])

private def resEval {M : Type*} [AddCommGroup M] [Module B M] (m : M) :
    InductionAlong.Res φ B →ₗ[A] InductionAlong.Res φ M where
  toFun z := InductionAlong.Res.mk (z.val • m) (by rw [smul_smul]; exact congrArg (· • m) z.prop)
  map_add' x y := InductionAlong.Res.ext (add_smul x.val y.val m)
  map_smul' a x := InductionAlong.Res.ext (mul_smul (φ a) x.val m)

/-- Restriction transports ideal generation once it does so on the left
corner of the regular bimodule. -/
theorem res_idealActionSpan
    (h : ∀ b ∈ J, resCut φ B b ∈ idealActionSpan I)
    (M : ModuleCat.{max u w} B) (hM : ∀ m : M, m ∈ idealActionSpan J)
    (z : InductionAlong.Res φ M) : z ∈ idealActionSpan I := by
  suffices H : ∀ (m : M) (b : B), resCut φ M (b • m) ∈ idealActionSpan I by
    have hz : resCut φ M ((1 : B) • z.val) = z := InductionAlong.Res.ext (by simpa [resCut] using z.prop)
    exact hz ▸ H z.val 1
  intro m
  induction hM m using Submodule.span_induction with
  | mem _ hx =>
    obtain ⟨a, ha, n, rfl⟩ := hx
    intro b
    have hm := mapsTo_idealActionSpan I (resEval φ n) (h (b * a) (J.mul_mem_left b a ha))
    have he : resEval φ n (resCut φ B (b * a)) = resCut φ M (b • a • n) :=
      InductionAlong.Res.ext (by change (φ 1 * (b * a)) • n = φ 1 • b • a • n; rw [mul_smul, mul_smul])
    exact he ▸ hm
  | zero =>
    intro b
    have hz : resCut φ M (b • 0) = 0 := InductionAlong.Res.ext (by simp [resCut])
    rw [hz]; exact Submodule.zero_mem _
  | add m n _ _ hm hn =>
    intro b
    have he : resCut φ M (b • (m+n)) = resCut φ M (b • m) + resCut φ M (b • n) :=
      InductionAlong.Res.ext (by simp [resCut, smul_add])
    exact he ▸ Submodule.add_mem _ (hm b) (hn b)
  | smul a m _ hm => intro b; rw [smul_smul]; exact hm _

end Modules

section Orders

variable {I : Type u} [DecidableEq I] {k : Type v} [Field k] {ℓ : ℕ}
  (S : I ⊕ Fin ℓ → I ⊕ Fin ℓ → MvPolynomial (Fin 2) k)
  (exponents : I ⊕ Fin ℓ → ℕ)
  {C : QuantumGroup.CartanDatum (I ⊕ Fin ℓ)} (hS : IsRouquierQ C S)
local notation "D" => I ⊕ Fin ℓ
local notation "p" => fun j => (Polynomial.X : Polynomial k) ^ exponents j
local notation "A" => CycKLR k S p

/-- The two-sided ideal generated by sequence idempotents with the stated red subword. -/
def redListIdeal (a : D → Polynomial k) (β : Multiset D) (rs : List (Fin ℓ)) : TwoSidedIdeal (CycKLR k S a β) :=
  TwoSidedIdeal.span {z | ∃ s : Seq β, (List.ofFn s.lbl).filterMap Sum.getRight? = rs ∧
    z = CycKLR.mk k S a β (e s)}

omit [DecidableEq I] in
private theorem append_word (i : D) {β : Multiset D} (s : Seq β) :
    List.ofFn (Seq.cast (add_comm β ({i} : Multiset D)) (s.append default)).lbl =
      List.ofFn s.lbl ++ [i] := by
  have hcast {a b : Multiset D} (h : a = b) (z : Seq a) :
      List.ofFn (Seq.cast h z).lbl = List.ofFn z.lbl := by subst b; rfl
  have ht : (default : Seq ({i} : Multiset D)).lbl = fun _ => i :=
    funext fun j => Multiset.mem_singleton.mp ((default : Seq ({i} : Multiset D)).mem j)
  rw [hcast]
  change List.ofFn (s.append (default : Seq ({i} : Multiset D))).1 = _
  rw [KLR.ofFn_append]
  change _ ++ List.ofFn (default : Seq ({i} : Multiset D)).lbl = _
  rw [ht]
  simp

/-- Appending a strand appends precisely its red subword to the support ideal. -/
theorem lastEmb_mem_redListIdeal (j : D) {β : Multiset D} {rs : List (Fin ℓ)}
    (z : A β) (hz : z ∈ redListIdeal S p β rs) :
    lastEmb S p j rfl z ∈ redListIdeal S p ({j} + β) (rs ++ [j].filterMap Sum.getRight?) := by
  let J := redListIdeal S p ({j} + β) (rs ++ [j].filterMap Sum.getRight?)
  induction hz using TwoSidedIdeal.span_induction with
  | mem z hz =>
    obtain ⟨s,hs,rfl⟩ := hz
    rw [lastEmb_mk, lastIncl_apply, cL_e, castKLR_rfl]
    exact TwoSidedIdeal.subset_span ⟨_, by rw [append_word, List.filterMap_append, hs], rfl⟩
  | zero => rw [map_zero]; exact J.zero_mem
  | add a b _ _ ha hb => rw [map_add]; exact J.add_mem ha hb
  | neg a _ ha => rw [map_neg]; exact J.neg_mem ha
  | left_absorb a b _ hb => rw [map_mul]; exact J.mul_mem_left _ _ hb
  | right_absorb a b _ ha => rw [map_mul]; exact J.mul_mem_right _ _ ha


include hS in
private theorem cut_redList_generator {β : Multiset D} {i : I} {rs : List (Fin ℓ)}
    (s : Seq ({Sum.inl i} + β)) (hs : (List.ofFn s.lbl).filterMap Sum.getRight? = rs)
    (b : A ({Sum.inl i} + β)) :
    resCut (lastEmb S p (.inl i) (β := β) rfl) _ (b * CycKLR.mk k S p _ (e s)) ∈
      idealActionSpan (redListIdeal S p β rs) := by
  let j : D := .inl i
  let φ := lastEmb S p j (β := β) rfl
  let ε := φ 1
  let eₛ := CycKLR.mk k S p _ (e s)
  have he : IsIdempotentElem eₛ := (show IsIdempotentElem (e (Q := S) s) from e_mul_self s).map _
  let P := CycKLR.gradedResProj hS.gradingDatum exponents j β hS.klrSymm hS.polyInY_leading
    (CycKLR.sequenceProjective hS exponents s)
  let z : P.carrier := ⟨⟨ε * (b * eₛ), by change ε * (b * eₛ) * eₛ = _; rw [mul_assoc, mul_assoc, he.eq]⟩,
    Subtype.ext (by change ε * (ε * (b * eₛ)) = _; rw [← mul_assoc, InductionAlong.unit_mul_unit])⟩
  let f : P.carrier →ₗ[A β] InductionAlong.Res φ (A ({j} + β)) :=
    { toFun := fun x => InductionAlong.Res.mk x.1.1 (congrArg Subtype.val x.2)
      map_add' := fun _ _ => InductionAlong.Res.ext rfl
      map_smul' := fun _ _ => InductionAlong.Res.ext rfl }
  have hword := restricted_word_mem_span_of_deletions hS exponents i (List.ofFn s.1) (Seq.coe_ofFn s)
    (redListIdeal S p β rs)
  have hdel (t : CycKLR.WordDeletion (.inl i) (List.ofFn s.1)) :
      (t.1.1 ++ t.1.2).filterMap Sum.getRight? = rs := by
    rw [← hs]
    have hw := t.property
    change List.ofFn s.1 = _ at hw
    change _ = (List.ofFn s.1).filterMap Sum.getRight?
    exact (show (t.1.1 ++ t.1.2).filterMap Sum.getRight? =
      (t.1.1 ++ Sum.inl i :: t.1.2).filterMap Sum.getRight? by simp [List.filterMap_cons]).trans
      (congrArg (List.filterMap Sum.getRight?) hw.symm)
  have hx := hword (fun t => TwoSidedIdeal.subset_span ⟨_, by
    change (List.ofFn (Seq.ofList _ _).1).filterMap _ = _
    rw [Seq.ofFn_ofList]; exact hdel t, rfl⟩)
  rw [Seq.ofList_ofFn] at hx
  exact mapsTo_idealActionSpan _ f (hx z)

include hS in
/-- Restricting a module generated by a fixed red list preserves that list. -/
theorem res_mem_redListIdeal {β : Multiset D} (i : I) (rs : List (Fin ℓ))
    (M : ModuleCat.{max (max u v) w} (A ({Sum.inl i} + β)))
    (hM : ∀ m : M, m ∈ idealActionSpan (redListIdeal S p ({Sum.inl i} + β) rs))
    (z : (CyclotomicAction.res S p (.inl i) (β := β) rfl).obj M) :
    z ∈ idealActionSpan (redListIdeal S p β rs) := by
  let φ := lastEmb S p (.inl i) (β := β) rfl
  let B := A ({Sum.inl i} + β)
  let cut : B →+ InductionAlong.Res φ B :=
    ⟨⟨resCut φ B, InductionAlong.Res.ext (mul_zero _)⟩,
      fun a b => InductionAlong.Res.ext (mul_add _ a b)⟩
  let rmul (b : B) : InductionAlong.Res φ B →ₗ[A β] InductionAlong.Res φ B :=
    InductionAlong.Res.map
      (show B →ₗ[B] B from { toFun := (· * b), map_add' := fun x y => add_mul x y b,
                              map_smul' := fun x y => mul_assoc x y b })
  apply res_idealActionSpan φ _ _ _ M hM z
  intro x hx
  apply cut_span_mem_idealActionSpan _ _ cut rmul
    (fun x b => InductionAlong.Res.ext (mul_assoc (φ 1) x b).symm) _ hx
  rintro _ ⟨s,hs,rfl⟩ b
  exact cut_redList_generator S exponents hS s hs b

/-- Realizable signed block paths starting at cyclotomic content zero. A
physical downward letter induces and an upward black letter restricts. -/
inductive SignedCoverWord (I : Type u) (ℓ : ℕ) :
    Multiset (I ⊕ Fin ℓ) → List (DoubleStrand I ℓ) → Type u where
  | nil : SignedCoverWord I ℓ 0 []
  | ind {β xs} (t : SignedCoverWord I ℓ β xs) (j : I ⊕ Fin ℓ) :
      SignedCoverWord I ℓ ({j} + β) (xs ++ [DoubleStrand.down j])
  | res {β xs} (i : I) (t : SignedCoverWord I ℓ ({Sum.inl i} + β) xs) :
      SignedCoverWord I ℓ β (xs ++ [Sum.inl (true, i)])

namespace SignedCoverWord

/-- The value of the signed word on a vacuum module. -/
def eval (a : D → Polynomial k) (M : ModuleCat.{max (max u v) w} (CycKLR k S a 0)) :
    {β : Multiset D} → {xs : List (DoubleStrand I ℓ)} → SignedCoverWord I ℓ β xs →
    ModuleCat.{max (max u v) w} (CycKLR k S a β)
  | _, _, .nil => M
  | _, _, .ind t j => (CyclotomicAction.ind S a j rfl).obj (eval a M t)
  | _, _, .res i t => (CyclotomicAction.res S a (.inl i) rfl).obj (eval a M t)

include hS in
/-- Every signed word module is generated by ordinary sequence idempotents
whose ordered list of red labels agrees exactly with its physical boundary. -/
theorem eval_mem_redListIdeal (M : ModuleCat.{max (max u v) w} (A 0))
    {β : Multiset D} {xs : List (DoubleStrand I ℓ)}
    (t : SignedCoverWord I ℓ β xs) (z : t.eval S p M) :
    z ∈ idealActionSpan (redListIdeal S p β (xs.filterMap DoubleStrand.redLabel)) := by
  induction t with
  | nil =>
    have h : (1 : A 0) ∈ redListIdeal S p 0 [] := by
      rw [← map_one (CycKLR.mk k S p 0), ← sum_e (Q := S) (ν := 0), map_sum]
      apply sum_mem
      intro s _
      have hn : List.ofFn s.lbl = [] := List.length_eq_zero_iff.mp (by rw [List.length_ofFn, Multiset.card_zero])
      exact TwoSidedIdeal.subset_span ⟨s, by rw [hn]; rfl, rfl⟩
    exact Submodule.subset_span ⟨1,h,z,(one_smul _ z).symm⟩
  | @ind β xs t j ih =>
    rw [List.filterMap_append]
    have he : [DoubleStrand.down j].filterMap DoubleStrand.redLabel = [j].filterMap Sum.getRight? := by
      cases j <;> rfl
    rw [he]
    exact ind_idealActionSpan _ _ _ (lastEmb_mem_redListIdeal S exponents j) (t.eval S p M) ih z
  | @res β xs i t ih =>
    simp only [List.filterMap_append, List.filterMap_cons_none (by rfl : DoubleStrand.redLabel
      (Sum.inl (true, i) : DoubleStrand I ℓ) = none), List.filterMap_nil, List.append_nil]
    exact res_mem_redListIdeal S exponents hS i _ (t.eval S p M) ih z

end SignedCoverWord

end Orders

section Projection

variable {I : Type u} [DecidableEq I] {k : Type v} [Field k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} (Λ : Fin ℓ → I →₀ ℕ) (ν : Multiset I)
  (C : QuantumGroup.CartanDatum I)

local notation "S" => cyclotomicCoverQ C Λ Q
local notation "μ" => stendhalWeight ℓ ν
local notation "p" => cyclotomicCoverPolynomial (I := I) (ℓ := ℓ) (k := k)
local notation "π" => RingHom.toNonUnitalRingHom (AlgHom.toRingHom (cyclotomicCoverToTensor (Q := Q) Λ ν C))

/-- Red orders excluded by the tensor-product quotient have zero projected
signed word module, even with black restrictions between their red strands. -/
theorem cyclotomicCover_project_unorderedSignedWord (hQ : IsRouquierQ C Q)
    {xs : List (DoubleStrand I ℓ)} (t : SignedCoverWord I ℓ μ xs)
    (ho : ¬ (xs.filterMap DoubleStrand.redLabel).Pairwise (· < ·))
    (M : ModuleCat.{max (max u v) w} (CycKLR k S p 0))
    (z : (functor π).obj (t.eval S p M)) : z = 0 := by
  let d : I ⊕ Fin ℓ → ℕ := Sum.elim (fun _ => 0) (fun _ => 1)
  have hp : (fun c : I ⊕ Fin ℓ => (Polynomial.X : Polynomial k)^d c) = p := by
    funext c; cases c <;> simp [d, cyclotomicCoverPolynomial]
  let J := redListIdeal S p μ (xs.filterMap DoubleStrand.redLabel)
  have hM : ∀ m : t.eval S p M, m ∈ idealActionSpan J := by
    have H := t.eval_mem_redListIdeal S d (isRouquierQ_cyclotomicCoverQ C Λ Q hQ)
    rw [hp] at H
    exact H M
  have hJ : J ≤ TwoSidedIdeal.ker (cyclotomicCoverToTensor (Q := Q) Λ ν C).toRingHom := by
    rw [cyclotomicCoverToTensor_ker]
    apply TwoSidedIdeal.span_le.mpr
    rintro _ ⟨s, hs, rfl⟩
    exact TwoSidedIdeal.subset_span (Or.inr ⟨s, fun h => ho (hs ▸ (DoubleBoundary.pairwise_red_iff s).mpr h), rfl⟩)
  have hz := ind_idealActionSpan π J ⊥ (fun b hb => by
    exact (TwoSidedIdeal.mem_bot _).mpr ((TwoSidedIdeal.mem_ker _).mp (hJ hb))) (t.eval S p M) hM z
  let T := TensorProductAlgebra k Q Λ ν
  let N := (functor π).obj (t.eval S p M)
  apply (Submodule.mem_bot T).mp
  apply (Submodule.span_le.mpr ?_ : idealActionSpan (⊥ : TwoSidedIdeal T) ≤ (⊥ : Submodule T N)) hz
  rintro _ ⟨a,ha,m,rfl⟩
  rw [(TwoSidedIdeal.mem_bot _).mp ha, zero_smul]
  exact Submodule.zero_mem _

end Projection

end Categorification.Stendhal
