import Categorification.WeightedKLR.RedStrands.LastRedLayerPrefix
import Categorification.WeightedKLR.RedStrands.AddRed

/-!
# Juxtaposition in a last-red layer

Webster, arXiv:1309.3796v2, §4.7, proofs of Lemma 4.37 and Theorem 4.38.
The corner with specified black prefix and suffix weights is generated by the
shorter tensor product algebra and the last-weight cyclotomic algebra.
-/

noncomputable section
namespace Categorification.Stendhal

open KLR KLRAlgebra
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ+1) → I →₀ ℕ)
  {ν θ β : Multiset I}
variable (p : Fin (stendhalWeight (ℓ+1) ν).card)
  (h : stendhalWeight (ℓ+1) θ + β.map (Sum.inl : I → I ⊕ Fin (ℓ+1)) = stendhalWeight (ℓ+1) ν)
  (ha : (stendhalWeight (ℓ+1) θ).card = p.val+1)
local notation "ι" => (Sum.inl : I → I ⊕ Fin (ℓ+1))
local notation "M" => stendhalWeight (ℓ+1) ν
local notation "PWeight" => stendhalWeight (ℓ+1) θ
local notation "B" => β.map ι
local notation "S" => stendhalQ Q Λ
local notation "τ₀" => TensorProductAlgebra.mk Q Λ θ
local notation "E₀" => TensorProductAlgebra.lastRedIdem Q Λ θ
local notation "F" => suffixConcat Q Λ p h
local notation "C" => RingCon.Quotient (TwoSidedIdeal.ringCon (smallerSuffixIdeal Q Λ p))
local notation "λf" => (fun i : I => (Polynomial.X : Polynomial k) ^ Λ (Fin.last ℓ) i)
local notation "L" => TensorProductAlgebra k Q (Λ ∘ Fin.castSucc) θ
local notation "R" => CycKLR k Q λf β

private def prefixProjection : KLRAlgebra k S PWeight →ₐ[k] TensorProductAlgebra k Q Λ θ :=
  (τ₀).comp ((orderProjection Q Λ θ).comp (StendhalAlgebraAllOrders.ofKLR k Q Λ θ))
local notation "γ" => prefixProjection Q Λ (θ := θ)

private theorem prefixProjection_surjective : Function.Surjective γ :=
  (show Function.Surjective τ₀ from RingCon.mkₐ_surjective _).comp
    ((orderProjection_surjective Q Λ θ).comp StendhalAlgebraAllOrders.ofKLR_surjective)

private theorem prefixProjection_e (a : Seq PWeight) (ho : IsRedOrdered a) :
    γ (e a) = τ₀ (StendhalAlgebra.e a ho) := congrArg τ₀ (Subtype.ext
      ((StendhalAlgebraAllOrders.e_mul_redOrderedIdem a).trans (ite_eq_left ho)))

private theorem prefixProjection_e_unordered (a : Seq PWeight) (ho : ¬ IsRedOrdered a) :
    γ (e a) = 0 := (congrArg τ₀ (Subtype.ext
      ((StendhalAlgebraAllOrders.e_mul_redOrderedIdem a).trans (ite_eq_right ho)))).trans (map_zero τ₀)

private def prefixTerminalIdem : KLRAlgebra k S PWeight :=
  open Classical in eSum S (Finset.univ.filter HasLastRed)
local notation "D" => prefixTerminalIdem Q Λ (θ := θ)

private theorem prefixTerminalIdem_idem : IsIdempotentElem D := eSum_idem _

private theorem prefixProjection_terminal : γ D = E₀ := by
  classical
  have hu : ∑ a : Seq PWeight, γ (e a) = 1 := by rw [← map_sum, sum_e, map_one]
  rw [← mul_one (γ D), ← mul_one E₀, ← hu, Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a _
  rw [← map_mul]
  change γ (eSum S (Finset.univ.filter HasLastRed) * e a) = E₀ * γ (e a)
  rw [eSum_mul_e]
  by_cases ho : IsRedOrdered a
  · have he := StendhalAlgebra.lastRedIdem_mul_e Q Λ θ a ho
    rw [prefixProjection_e Q Λ a ho, TensorProductAlgebra.lastRedIdem, ← map_mul, he]
    by_cases hf : HasLastRed a
    · simpa only [Finset.mem_filter, Finset.mem_univ, true_and, ite_eq_left hf] using prefixProjection_e Q Λ a ho
    · simp [hf]
  · rw [prefixProjection_e_unordered Q Λ a ho, mul_zero]
    split_ifs
    · exact prefixProjection_e_unordered Q Λ a ho
    · exact map_zero _

private theorem suffixBlack_tmul (x : KLRAlgebra k Q β) :
    suffixBlack Q Λ p h ha x = F (D ⊗ₜ blackSuffixReindex Q Λ β x) := by
  classical
  have hp : (⟨p.val, by omega⟩ : Fin (Multiset.card PWeight)) = lastRedPosition ℓ θ := by
    apply Fin.ext
    change p.val = θ.card + ℓ
    simp [stendhalWeight] at ha
    omega
  change F (eSum S (Finset.univ.filter (fun a : Seq PWeight =>
    a.lbl ⟨p.val,by omega⟩ = .inr (Fin.last ℓ))) ⊗ₜ _) = _
  rw [hp, prefixTerminalIdem]
  congr 3
  ext a
  simp [HasLastRed]

/-- The last-red layer idempotent for a specified division of the black weight. -/
def lastRedLayerIdem : C := prefixTensor Q Λ p h E₀

theorem lastRedLayerIdem_idem : IsIdempotentElem (lastRedLayerIdem Q Λ p h) := by
  change prefixTensor Q Λ p h E₀ * prefixTensor Q Λ p h E₀ = prefixTensor Q Λ p h E₀
  rw [← map_mul, (TensorProductAlgebra.isIdempotentElem_lastRedIdem Q Λ θ).eq]

local notation "E" => lastRedLayerIdem Q Λ p h
local notation "Layer" => IsIdempotentElem.Corner (lastRedLayerIdem_idem Q Λ p h)

private theorem lastRedLayerIdem_eq : E = F (D ⊗ₜ 1) := by
  change prefixTensor Q Λ p h E₀ = _
  rw [← prefixProjection_terminal Q Λ]
  exact prefixTensor_projection Q Λ p h D

private theorem suffixCyclotomic_one : suffixCyclotomic Q Λ p h ha 1 = E := by
  rw [← map_one (CycKLR.mk k Q λf β), suffixCyclotomic_mk, suffixBlack_tmul, map_one,
    lastRedLayerIdem_eq]

private def prefixInLayer : L →ₐ[k] Layer where
  toFun x := KLR.Corner.mk (prefixTensor Q Λ p h (appendRed Q Λ θ x).val) (by
    let z := appendRed Q Λ θ x
    change prefixTensor Q Λ p h E₀ * prefixTensor Q Λ p h z.val * prefixTensor Q Λ p h E₀ = _
    rw [← map_mul, ← map_mul, KLR.Corner.E_mul_val, KLR.Corner.val_mul_E])
  map_one' := Subtype.ext (congrArg (prefixTensor Q Λ p h)
    (congrArg (fun z : TensorProductAlgebra.lastRedCorner Q Λ θ => z.val) (map_one (appendRed Q Λ θ))))
  map_zero' := Subtype.ext (by change prefixTensor Q Λ p h (appendRed Q Λ θ 0).val = 0
                               rw [map_zero]; exact map_zero _)
  map_add' x y := Subtype.ext (by
    change prefixTensor Q Λ p h (appendRed Q Λ θ (x+y)).val = _
    rw [map_add]; exact map_add _ _ _)
  map_mul' x y := Subtype.ext (by
    change prefixTensor Q Λ p h (appendRed Q Λ θ (x*y)).val = _
    rw [map_mul]; exact map_mul _ _ _)
  commutes' c := Subtype.ext (by
    change prefixTensor Q Λ p h (appendRed Q Λ θ (algebraMap k L c)).val = c • E
    rw [AlgHom.commutes]
    first
    | exact (prefixTensor Q Λ p h).map_smul c E₀
    | change prefixTensor Q Λ p h (algebraMap k _ c * E₀) = c • prefixTensor Q Λ p h E₀
      rw [← Algebra.smul_def]
      exact (prefixTensor Q Λ p h).map_smul c E₀)

private def suffixInLayer : R →ₐ[k] Layer where
  toFun y := KLR.Corner.mk (suffixCyclotomic Q Λ p h ha y) (by
    rw [← suffixCyclotomic_one Q Λ p h ha, ← map_mul, ← map_mul, one_mul, mul_one])
  map_one' := Subtype.ext (suffixCyclotomic_one Q Λ p h ha)
  map_zero' := Subtype.ext (map_zero _)
  map_add' x y := Subtype.ext (map_add _ x y)
  map_mul' x y := Subtype.ext (map_mul _ x y)
  commutes' c := Subtype.ext (by
    change suffixCyclotomic Q Λ p h ha (algebraMap k R c) = c • E
    rw [← suffixCyclotomic_one Q Λ p h ha, ← map_smul, Algebra.smul_def, mul_one])

private theorem exists_prefix_terminal (x : L) : ∃ u : KLRAlgebra k S PWeight,
    D * u = u ∧ u * D = u ∧ (prefixInLayer Q Λ p h x).val = F (u ⊗ₜ 1) := by
  let z := appendRed Q Λ θ x
  obtain ⟨u,hu⟩ := prefixProjection_surjective Q Λ z.val
  refine ⟨D*u*D, ?_, ?_, ?_⟩
  · rw [← mul_assoc, ← mul_assoc, (prefixTerminalIdem_idem Q Λ).eq]
  · rw [mul_assoc (D*u), (prefixTerminalIdem_idem Q Λ).eq]
  have hz : γ (D*u*D) = z.val := by
    rw [map_mul, map_mul, prefixProjection_terminal, hu, KLR.Corner.E_mul_val, KLR.Corner.val_mul_E]
  change prefixTensor Q Λ p h z.val = _
  rw [← hz]
  exact prefixTensor_projection Q Λ p h _

private theorem prefix_suffix_commute (x : L) (y : R) :
    Commute (prefixInLayer Q Λ p h x) (suffixInLayer Q Λ p h ha y) := by
  obtain ⟨u,hu,hu',hx⟩ := exists_prefix_terminal Q Λ p h x
  obtain ⟨v,rfl⟩ := CycKLR.mk_surjective y
  apply Subtype.ext
  change (prefixInLayer Q Λ p h x).val * suffixCyclotomic Q Λ p h ha _ =
    suffixCyclotomic Q Λ p h ha _ * (prefixInLayer Q Λ p h x).val
  rw [hx, suffixCyclotomic_mk, suffixBlack_tmul, ← suffixConcat_mul, ← suffixConcat_mul,
    Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
    hu, hu', one_mul, mul_one]

local instance : IsScalarTower k k Layer where
  smul_assoc a b z := mul_smul a b z

/-- The shorter tensor product algebra and the last-weight cyclotomic
algebra act by juxtaposition in the specified layer corner. -/
def lastRedLayerTensor : L ⊗[k] R →ₐ[k] Layer :=
  Algebra.TensorProduct.lift (prefixInLayer Q Λ p h) (suffixInLayer Q Λ p h ha)
    (prefix_suffix_commute Q Λ p h ha)


open Classical in
/-- On pure tensors, the layer action is juxtaposition of the shorter
diagram with terminal red and the chosen lift of the cyclotomic diagram. -/
theorem lastRedLayerTensor_tmul_mk (x : L) (y : KLRAlgebra k Q β) :
    (lastRedLayerTensor Q Λ p h ha (x ⊗ₜ CycKLR.mk k Q λf β y)).val =
      prefixTensor Q Λ p h (appendRed Q Λ θ x).val *
        F (eSum S (Finset.univ.filter HasLastRed) ⊗ₜ blackSuffixReindex Q Λ β y) := by
  rw [lastRedLayerTensor, Algebra.TensorProduct.lift_tmul]
  change _ * suffixCyclotomic Q Λ p h ha _ = _
  rw [suffixCyclotomic_mk, suffixBlack_tmul]
  rfl

open Classical in
private theorem layerIdem_sum :
    E = ∑ a ∈ Finset.univ.filter HasLastRed, ∑ b : Seq B, F (e a ⊗ₜ e b) := by
  classical
  rw [lastRedLayerIdem_eq, prefixTerminalIdem, eSum, TensorProduct.sum_tmul, map_sum]
  exact Finset.sum_congr rfl fun a _ => by
    rw [← sum_e (ν := B) (Q := S), TensorProduct.tmul_sum, map_sum]

local notation "q" => RingCon.mk' (TwoSidedIdeal.ringCon (smallerSuffixIdeal Q Λ p))
local notation "τ" => TensorProductAlgebra.mk Q Λ ν
local notation "π" => StendhalAlgebraAllOrders.ofKLR k Q Λ ν

private theorem layer_e_ordered (a : Seq PWeight) (b : Seq B)
    (hs : IsRedOrdered (Seq.cast h (a.append b))) :
    F (e a ⊗ₜ e b) = q (τ (StendhalAlgebra.e (Seq.cast h (a.append b)) hs)) := by
  change q (τ (orderProjection Q Λ ν (π (castKLR S h (concat S PWeight B _))))) = _
  rw [concat_e_tmul_e, castKLR_e]
  exact congrArg q (congrArg τ (Subtype.ext
    ((StendhalAlgebraAllOrders.e_mul_redOrderedIdem _).trans (ite_eq_left hs))))

/-- An ordered loading at the specified cut is a summand of the layer
idempotent for its two block weights. -/
theorem lastRedLayerIdem_mul_boundary (a : Seq PWeight) (b : Seq B) (hr : HasLastRed a)
    (ho : IsRedOrdered (Seq.cast h (a.append b))) :
    E * q (τ (StendhalAlgebra.e (Seq.cast h (a.append b)) ho)) =
      q (τ (StendhalAlgebra.e (Seq.cast h (a.append b)) ho)) := by
  classical
  rw [← layer_e_ordered Q Λ p h a b ho, lastRedLayerIdem_eq, ← suffixConcat_mul,
    Algebra.TensorProduct.tmul_mul_tmul, one_mul, prefixTerminalIdem, eSum_mul_e,
    ite_eq_left (Finset.mem_filter.2 ⟨Finset.mem_univ a,hr⟩)]

private theorem layer_e_unordered (a : Seq PWeight) (b : Seq B)
    (hs : ¬ IsRedOrdered (Seq.cast h (a.append b))) : F (e a ⊗ₜ e b) = 0 := by
  let s := Seq.cast h (a.append b)
  have he : orderProjection Q Λ ν (π (e s)) = 0 :=
    Subtype.ext ((StendhalAlgebraAllOrders.e_mul_redOrderedIdem s).trans (ite_eq_right hs))
  change q (τ (orderProjection Q Λ ν (π (castKLR S h (concat S PWeight B _))))) = _
  rw [concat_e_tmul_e, castKLR_e, he, map_zero, map_zero]

include ha in
omit [DecidableEq I] in
private theorem castAppend_lastRed (a : Seq PWeight) (b : Seq B) (hr : HasLastRed a) :
    (Seq.cast h (a.append b)).lbl p = .inr (Fin.last ℓ) := by
  have hp : Fin.cast (congrArg Multiset.card h) (Seq.posL B (lastRedPosition ℓ θ)) = p := by
    apply Fin.ext
    change θ.card + ℓ = p.val
    simp [stendhalWeight] at ha
    omega
  change (Seq.cast h _).1 p = _
  rw [← hp]
  simpa only [Seq.cast_apply, Fin.cast_cast, Fin.cast_eq_self, Seq.append_posL] using (show a.1 _ = _ from hr)

include ha in
private theorem boundary_sandwich (a a' : Seq PWeight) (b b' : Seq B)
    (h₁ : HasLastRed a) (h₂ : HasLastRed a') (y : TensorProductAlgebra k Q Λ ν) :
    F (e a ⊗ₜ e b) * q y * F (e a' ⊗ₜ e b') ∈ LinearMap.range F := by
  by_cases hs : IsRedOrdered (Seq.cast h (a.append b))
  · by_cases hs' : IsRedOrdered (Seq.cast h (a'.append b'))
    · rw [layer_e_ordered Q Λ p h a b hs, layer_e_ordered Q Λ p h a' b' hs', ← map_mul, ← map_mul]
      exact sandwich_mem_range_suffixConcat Q Λ p h ha a' b' _ _ hs' hs rfl
        (castAppend_lastRed p h ha a' b' h₂) (castAppend_lastRed p h ha a b h₁) y
    · rw [layer_e_unordered Q Λ p h a' b' hs', mul_zero]
      exact Submodule.zero_mem _
  · rw [layer_e_unordered Q Λ p h a b hs, zero_mul, zero_mul]
    exact Submodule.zero_mem _

include ha in
private theorem layer_mem_raw_range (z : Layer) : z.val ∈ LinearMap.range F := by
  classical
  obtain ⟨y,hy⟩ := (smallerSuffixIdeal Q Λ p).ringCon.mk'_surjective z.val
  have hz : E * q y * E = z.val := by rw [hy, KLR.Corner.E_mul_val, KLR.Corner.val_mul_E]
  rw [← hz, layerIdem_sum Q Λ p h]
  simp only [Finset.sum_mul, Finset.mul_sum]
  apply Submodule.sum_mem
  intro a ha'
  apply Submodule.sum_mem
  intro b _
  apply Submodule.sum_mem
  intro a' ha''
  apply Submodule.sum_mem
  intro b' _
  exact boundary_sandwich Q Λ p h ha a' a b' b
    (Finset.mem_filter.mp ha'').2 (Finset.mem_filter.mp ha').2 y

private theorem exists_prefix_of_raw (u : KLRAlgebra k S PWeight) :
    ∃ x : L, (prefixInLayer Q Λ p h x).val = F ((D*u*D) ⊗ₜ 1) := by
  let v := γ (D*u*D)
  have hv : E₀*v*E₀=v := by
    change E₀ * γ (D*u*D) * E₀ = _
    rw [← prefixProjection_terminal Q Λ (θ := θ), ← map_mul, ← map_mul]
    congr 1
    rw [← mul_assoc D (D*u) D, ← mul_assoc D D u, (prefixTerminalIdem_idem Q Λ).eq,
      mul_assoc (D*u) D D, (prefixTerminalIdem_idem Q Λ).eq]
  let z : TensorProductAlgebra.lastRedCorner Q Λ θ := KLR.Corner.mk v hv
  obtain ⟨x,hx⟩ := appendRed_surjective Q Λ θ z
  refine ⟨x,?_⟩
  change prefixTensor Q Λ p h (appendRed Q Λ θ x).val = _
  rw [hx]
  exact prefixTensor_projection Q Λ p h _

private theorem exists_tensor_of_compressed (t : KLRAlgebra k S PWeight ⊗[k] KLRAlgebra k S B) :
    ∃ z, (lastRedLayerTensor Q Λ p h ha z).val = E * F t * E := by
  induction t using TensorProduct.inductionOn with
  | tmul a b =>
    obtain ⟨x,hx⟩ := exists_prefix_of_raw Q Λ p h a
    obtain ⟨v,rfl⟩ := (blackSuffixReindex Q Λ β).surjective b
    refine ⟨x ⊗ₜ CycKLR.mk k Q λf β v, ?_⟩
    rw [lastRedLayerTensor, Algebra.TensorProduct.lift_tmul]
    change (prefixInLayer Q Λ p h x).val * suffixCyclotomic Q Λ p h ha _ = _
    rw [hx, suffixCyclotomic_mk, suffixBlack_tmul, lastRedLayerIdem_eq, ← suffixConcat_mul,
      ← suffixConcat_mul, ← suffixConcat_mul]
    congr 1
    simp only [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, mul_assoc,
      (prefixTerminalIdem_idem Q Λ).eq]
  | add u v hu hv =>
    obtain ⟨x,hx⟩ := hu
    obtain ⟨y,hy⟩ := hv
    refine ⟨x+y, ?_⟩
    rw [map_add]
    change (lastRedLayerTensor Q Λ p h ha x).val + (lastRedLayerTensor Q Λ p h ha y).val = _
    rw [hx,hy,map_add,mul_add,add_mul]

/-- For fixed black weights on either side of the last red, the corner of
the quotient by smaller black suffixes is an algebra quotient of the
shorter tensor product algebra tensored with the final-weight cyclotomic
KLR algebra (Webster, arXiv:1309.3796v2, §4.7, rank argument in Theorem 4.38). -/
theorem lastRedLayerTensor_surjective : Function.Surjective (lastRedLayerTensor Q Λ p h ha) := by
  intro z
  obtain ⟨t,ht⟩ := layer_mem_raw_range Q Λ p h ha z
  obtain ⟨w,hw⟩ := exists_tensor_of_compressed Q Λ p h ha t
  exact ⟨w, Subtype.ext (hw.trans (by rw [ht, KLR.Corner.E_mul_val, KLR.Corner.val_mul_E]))⟩

end Categorification.Stendhal
