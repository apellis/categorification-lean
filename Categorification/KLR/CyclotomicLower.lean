import Categorification.KLR.CyclotomicSource

/-!
# The lower-rank tensors in the cyclotomic comparison diagram

For `β = {i} + γ`, the tensor products in Kang–Kashiwara,
arXiv:1102.4677v4, §5.2 are balanced over the actual algebra `R(γ)`.
The right factor is `e(γ,i) R^Λ(β)`, with the concatenation action of `R(γ)`.
No identification with the larger algebra generated by all colour idempotents
and the first `|β|-1` strands is made.

The parameterization includes `γ = 0` (hence `β = {i}`), but requires an actual
removed colour. `lowerRank_exists_iff` records exactly when such a parameter
exists. In particular `β = 0` and absent-colour blocks are not silently treated
as `R(β - {i})`: extending the source diagram by zero on those blocks is separate.
-/

noncomputable section
namespace Categorification
open MulOpposite

namespace CornerTensor
variable {k A B C : Type*} [CommRing k] [Ring A] [Ring B] [Ring C]
  [Algebra k A] [Algebra k B] [Algebra k C]

/-- The left ideal at the unit image of a nonunital algebra map. -/
def Left (f : A →ₙₐ[k] B) : Type _ := Graded.leftIdeal (f 1)

instance (f : A →ₙₐ[k] B) : AddCommGroup (Left f) :=
  inferInstanceAs (AddCommGroup (Graded.leftIdeal (f 1)))
instance (f : A →ₙₐ[k] B) : Module B (Left f) :=
  inferInstanceAs (Module B (Graded.leftIdeal (f 1)))
instance (f : A →ₙₐ[k] B) : Module k (Left f) :=
  inferInstanceAs (Module k (Graded.leftIdeal (f 1)))
instance (f : A →ₙₐ[k] B) : IsScalarTower k B (Left f) :=
  inferInstanceAs (IsScalarTower k B (Graded.leftIdeal (f 1)))

instance (f : A →ₙₐ[k] B) : CoeOut (Left f) B := ⟨fun x => x.1⟩

variable (f : A →ₙₐ[k] B)

theorem left_mem (x : Left f) : (x : B) * f 1 = x := x.2

instance : Module Aᵐᵒᵖ (Left f) where
  smul r x := ⟨(x : B) * f r.unop, by
    change ((x : B) * f r.unop) * f 1 = (x : B) * f r.unop
    rw [mul_assoc, ← map_mul, mul_one]⟩
  one_smul x := Subtype.ext (left_mem f x)
  mul_smul r s x := Subtype.ext (by
    change (x : B) * f (s.unop * r.unop) = ((x : B) * f s.unop) * f r.unop
    rw [map_mul, mul_assoc])
  smul_zero r := Subtype.ext (zero_mul _)
  smul_add r x y := Subtype.ext (add_mul _ _ _)
  add_smul r s x := Subtype.ext (by
    change (x : B) * f (r.unop + s.unop) = (x : B) * f r.unop + (x : B) * f s.unop
    rw [map_add, mul_add])
  zero_smul x := Subtype.ext (by
    change (x : B) * f 0 = 0
    rw [map_zero, mul_zero])

instance : IsScalarTower k Aᵐᵒᵖ (Left f) where
  smul_assoc c r x := Subtype.ext (by
    change (x : B) * f (c • r.unop) = c • ((x : B) * f r.unop)
    rw [map_smul, mul_smul_comm])

instance : SMulCommClass B Aᵐᵒᵖ (Left f) where
  smul_comm b r x := Subtype.ext (mul_assoc b (x : B) (f r.unop)).symm

/-- The right ideal in a quotient, with the lower algebra acting through `f`. -/
def Right (q : B →ₐ[k] C) : Type _ := Graded.idemSubspace k C (q (f 1))

instance (q : B →ₐ[k] C) : AddCommGroup (Right f q) :=
  inferInstanceAs (AddCommGroup (Graded.idemSubspace k C (q (f 1))))
instance (q : B →ₐ[k] C) : Module k (Right f q) :=
  inferInstanceAs (Module k (Graded.idemSubspace k C (q (f 1))))
instance (q : B →ₐ[k] C) : CoeOut (Right f q) C := ⟨fun y => y.1⟩

variable (q : B →ₐ[k] C)

theorem right_mem (y : Right f q) : q (f 1) * (y : C) = y := y.2

instance : Module A (Right f q) where
  smul r y := ⟨q (f r) * (y : C), by
    change q (f 1) * (q (f r) * (y : C)) = q (f r) * (y : C)
    rw [← mul_assoc, ← map_mul, ← map_mul, one_mul]⟩
  one_smul y := Subtype.ext (right_mem f q y)
  mul_smul r s y := Subtype.ext (by
    change q (f (r * s)) * (y : C) = q (f r) * (q (f s) * (y : C))
    rw [map_mul, map_mul, mul_assoc])
  smul_zero r := Subtype.ext (mul_zero _)
  smul_add r x y := Subtype.ext (mul_add _ _ _)
  add_smul r s y := Subtype.ext (by
    change q (f (r + s)) * (y : C) = q (f r) * (y : C) + q (f s) * (y : C)
    rw [map_add, map_add, add_mul])
  zero_smul y := Subtype.ext (by
    change q (f 0) * (y : C) = 0
    rw [map_zero, map_zero, zero_mul])

instance : IsScalarTower k A (Right f q) where
  smul_assoc c r y := Subtype.ext (by
    change q (f (c • r)) * (y : C) = c • (q (f r) * (y : C))
    rw [map_smul, map_smul, smul_mul_assoc])

/-- The multiplication counit on the genuine noncommutative balanced tensor. -/
def counit : BalancedTensor k B A (Left f) (Right f q) →ₗ[k] C :=
  BalancedTensor.lift
    (LinearMap.mk₂ k (fun x y => q (x : B) * (y : C))
      (fun x x' y => by change q ((x : B) + (x' : B)) * (y : C) = _; rw [map_add, add_mul])
      (fun c x y => by change q (c • (x : B)) * (y : C) = _; rw [map_smul, smul_mul_assoc])
      (fun x y y' => mul_add _ _ _)
      (fun c x y => mul_smul_comm _ _ _))
    (fun x r y => by
      change q ((x : B) * f r) * (y : C) = q (x : B) * (q (f r) * (y : C))
      rw [map_mul, mul_assoc])

/-- The counit has the source's prescribed formula. -/
theorem counit_tmul (x : Left f) (y : Right f q) :
    counit f q (BalancedTensor.tmul x y) = q (x : B) * (y : C) := rfl

end CornerTensor

namespace KLR.KLRAlgebra
open scoped TensorProduct

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k]
  (Q : I → I → MvPolynomial (Fin 2) k) (i : I) (γ : Multiset I)
  (a : I → Polynomial k)

local notation "Si" => (Singleton.singleton i : Multiset I)
local notation "Rg" => KLRAlgebra k Q γ
local notation "Rb" => KLRAlgebra k Q (Si + γ)
local notation "Rl" => CycKLR k Q a (Si + γ)

omit [DecidableEq I] in
/-- A genuine removed-colour rank exists precisely on the blocks containing that colour. -/
theorem lowerRank_exists_iff (δ : Multiset I) : (∃ γ, δ = Si + γ) ↔ i ∈ δ := by
  constructor
  · rintro ⟨γ, rfl⟩
    exact Multiset.mem_add.2 (Or.inl (Multiset.mem_singleton_self i))
  · intro hi
    obtain ⟨γ, hγ⟩ := Multiset.exists_cons_of_mem hi
    exact ⟨γ, by simpa only [Multiset.singleton_add] using hγ⟩

omit [DecidableEq I] in
/-- In rank zero there is no lower-rank parameter for these source tensors. -/
theorem lowerRank_not_zero : ¬ ∃ γ : Multiset I, (0 : Multiset I) = Si + γ := by
  rw [lowerRank_exists_iff]
  exact Multiset.notMem_zero i

/-- Actual inclusion of the lower-rank algebra on the first `|γ|` strands. -/
def lowerLast : Rg →ₙₐ[k] Rb where
  toFun := cL Q i γ
  map_zero' := cL_zero i γ
  map_add' := cL_add i γ
  map_mul' := cL_mul i γ
  map_smul' := cL_smul i γ

/-- Actual inclusion of the lower-rank algebra on the last `|γ|` strands. -/
def lowerFirst : Rg →ₙₐ[k] Rb where
  toFun := cR Q i γ
  map_zero' := by simp only [cR, TensorProduct.tmul_zero, map_zero]
  map_add' := by intro x y; simp only [cR, TensorProduct.tmul_add, map_add]
  map_mul' := cR_mul i γ
  map_smul' := by intro c x; simp only [cR, TensorProduct.tmul_smul, map_smul, MonoidHom.id_apply]

/-- The restriction coefficient `e(γ,i) R^Λ({i}+γ)`. -/
abbrev LowerCoefficient : Type _ :=
  CornerTensor.Right (lowerLast Q i γ) (CycKLR.mk k Q a (Si + γ))

/-- The source's `K₀′`, balanced over `R(γ)`, including the case `γ = 0`. -/
abbrev KZeroPrime : Type _ :=
  BalancedTensor k Rb Rg (CornerTensor.Left (lowerLast Q i γ)) (LowerCoefficient Q i γ a)

/-- The source's `K₁′`, balanced over the same genuine lower-rank algebra. -/
abbrev KOnePrime : Type _ :=
  BalancedTensor k Rb Rg (CornerTensor.Left (lowerFirst Q i γ)) (LowerCoefficient Q i γ a)

/-- The actual multiplication map `E : K₀′ → R^Λ(β)`. -/
def lowerE : KZeroPrime Q i γ a →ₗ[k] Rl :=
  CornerTensor.counit (lowerLast Q i γ) (CycKLR.mk k Q a (Si + γ))

/-- Multiplication, with no change of coordinates or chosen tensor isomorphism. -/
theorem lowerE_tmul (x : CornerTensor.Left (lowerLast Q i γ))
    (y : LowerCoefficient Q i γ a) :
    lowerE Q i γ a (BalancedTensor.tmul x y) = CycKLR.mk k Q a (Si + γ) (x : Rb) * (y : Rl) := rfl

end KLR.KLRAlgebra
end Categorification
