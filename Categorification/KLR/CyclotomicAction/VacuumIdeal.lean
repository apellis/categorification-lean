import Categorification.KLR.CyclotomicAction.ProjectiveModules
import Categorification.KLR.CyclotomicAction.VacuumSupport
import Categorification.TwoRep.FactorVanishing
import Categorification.Diagrams.BicatInterpAdmissibleLinear

/-!
# The vacuum of `Ř^λ-pmod` and the ideal generated by `E_i 1_λ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2, Prop. 3.25
compares `Ř^λ` with the quotient of `End_𝒰(⊕ F_𝐢 λ)` by the ideal of 2-morphisms factoring
through `F_𝐣 E_j 1_λ`. The comparison map evaluates a 2-morphism at the projective module
`P_∅ = Ř^λ(∅)`. This file shows that it is defined on the quotient:

* `isFGProj_emptyBlockObj`: the module concentrated in the empty block is finitely generated
  projective, so it is an object `univVacuum` of `Ř^λ-pmod` (`P_∅`);
* `isZero_univPmod_map_vacuum`: a downward strand (Webster's `E_i`, acting by cyclotomic
  restriction) kills `P_∅`;
* `univVacuum_map₂_eq_zero_of_factor`: every 2-morphism out of the region of `P_∅` that
  factors through a composite starting with such a strand acts on `P_∅` by zero;
* `vacIdeal`, `univVacuum_map₂_eq_zero_of_mem_vacIdeal`: the ideal `I` of Prop. 3.25 (spanned by
  the 2-morphisms factoring through a downward strand at the region of `P_∅`, Webster's
  `F_𝐣 E_j 1_λ`) acts on `P_∅` by zero.
-/

namespace Categorification.KLR.CyclotomicAction

open CategoryTheory CategoryTheory.Limits TwoRep QuantumGroup

universe u v w u₁

noncomputable section

section Generic

variable {I : Type u} [DecidableEq I] {k : Type v} [CommRing k]
  (Q : I → I → MvPolynomial (Fin 2) k) (a : I → Polynomial k)
  {C : CartanDatum I} {X Y : Type u₁} [AddCommGroup X] [AddCommGroup Y]
  (RD : UDot.WeightDatum C X Y) (Λ : X)

/-- **`P_∅` is finitely generated projective**: the module `R^Λ(∅)` concentrated in the empty
block. -/
theorem isFGProj_emptyBlockObj :
    IsFGProj.{u, v, w} Q a RD Λ (blockWeight RD Λ 0) (emptyBlockObj.{u, v, w} Q a RD Λ) := by
  refine ⟨fun β => ?_, ?_⟩
  · by_cases hβ : β.1 = 0
    · have : Unique (PLift (β.1 = 0)) := ⟨⟨⟨hβ⟩⟩, fun _ => rfl⟩
      let e : (emptyBlockObj.{u, v, w} Q a RD Λ β : Type _) ≃ₗ[CycKLR k Q a β.1]
          CycKLR k Q a β.1 :=
        (LinearEquiv.funUnique (PLift (β.1 = 0)) (CycKLR k Q a β.1) _).trans
          ULift.moduleEquiv
      exact ⟨Module.Finite.equiv e.symm, Module.Projective.of_equiv e.symm⟩
    · exact finite_projective_of_isZero (isZero_emptyBlockObj hβ)
  · refine (Set.Subsingleton.finite (s := {β : WeightBlocks RD Λ (blockWeight RD Λ 0) |
      β.1 = 0}) fun β hβ β' hβ' => Subtype.ext (hβ.trans hβ'.symm)).subset fun β hβ => ?_
    exact Classical.byContradiction fun h => hβ (isZero_emptyBlockObj h)

end Generic

/-- An object of a full subcategory is zero if its underlying object is. -/
theorem isZero_fullSubcategory {D : Type*} [Category D] [Preadditive D] {P : ObjectProperty D}
    {Z : P.FullSubcategory} (h : IsZero Z.obj) : IsZero Z := by
  rw [IsZero.iff_id_eq_zero]
  exact ObjectProperty.hom_ext _ (h.eq_of_src _ _)

variable {I : Type u} [DecidableEq I] {k : Type v} [CommRing k] [Nontrivial k] {lam : I → ℕ}
  {C : CartanDatum I} {Q : I → I → MvPolynomial (Fin 2) k} (hQ : IsRouquierQ C Q)
  {X Y : Type u₁} [AddCommGroup X] [AddCommGroup Y] (RD : UDot.WeightDatum C X Y) (Λ : X)
  (hΛ : ∀ i, (lam i : ℤ) = RD.pair (RD.iY i) Λ)

/-- The region `λ` of the vacuum (the weight `-Λ` of the empty block). -/
abbrev vacRegion : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat :=
  ⟨⟨(blockWeight RD Λ 0 : X)⟩⟩

/-- **The projective module `P_∅`** as an object of `Ř^λ-pmod`. -/
def univVacuum : (univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).obj (vacRegion hQ RD Λ) :=
  ⟨emptyBlockObj.{u, max u v, w} (cycQ k lam Q) (univCycPoly k lam) RD Λ,
    isFGProj_emptyBlockObj _ _ RD Λ⟩

/-- **A downward strand kills `P_∅`**: Webster's `E_i` acts on `Ř^λ`-modules by cyclotomic
restriction, and `P_∅` lives in the empty block. -/
theorem isZero_univPmod_map_vacuum
    {b : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat}
    (x : vacRegion hQ RD Λ ⟶ b) (i : I) (r : X)
    (hx : (LinearCat.revHom x).obj.word = [⟨(false, i), r⟩]) :
    IsZero (((univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).map x).obj.obj
      (univVacuum hQ RD Λ hΛ)) := by
  refine isZero_fullSubcategory ?_
  obtain ⟨⟨rb⟩⟩ := b
  obtain ⟨⟨st, w'⟩, h1, h2, h3⟩ := x
  change w' = _ at hx
  subst hx
  exact isZero_globalF_obj i _ fun β hβ => isZero_emptyBlockObj hβ

/-- **The evaluation at `P_∅` kills the ideal generated by `E_i 1_λ`** (the map of Webster,
arXiv:1309.3796v2, Prop. 3.25, is defined on the quotient): a 2-morphism out of the region of
`P_∅` that factors through a composite `e ≫ w` whose first strand `e` is downward acts on
`P_∅` by zero. -/
theorem univVacuum_map₂_eq_zero_of_factor
    {b c : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat}
    {f g : vacRegion hQ RD Λ ⟶ c} (e : vacRegion hQ RD Λ ⟶ b) (i : I) (r : X)
    (he : (LinearCat.revHom e).obj.word = [⟨(false, i), r⟩]) (w' : b ⟶ c)
    (α : f ⟶ e ≫ w') (β : e ≫ w' ⟶ g) :
    ((univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).map₂ (α ≫ β)).hom.app
      (univVacuum hQ RD Λ hΛ) = 0 :=
  map₂_app_eq_zero_of_factor _ α β _ (isZero_univPmod_map_vacuum hQ RD Λ hΛ e i r he)

attribute [local instance] ScalarRestriction.linearCatHom ScalarRestriction.precompLinear
  ScalarRestriction.postcompLinear

/-- The action on `Ř^λ-pmod` is additive on 2-morphisms. -/
theorem univPmod_map₂_add {b : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat}
    {a : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat} {f g : a ⟶ b}
    (φ ψ : f ⟶ g) (M : (univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).obj a) :
    ((univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).map₂ (φ + ψ)).hom.app M =
      ((univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).map₂ φ).hom.app M +
        ((univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).map₂ ψ).hom.app M := by
  apply ObjectProperty.hom_ext
  change ((univCyclotomicPresCLL hQ RD Λ hΛ).map₂ (φ + ψ)).hom.app M.obj =
    ((univCyclotomicPresCLL hQ RD Λ hΛ).map₂ φ).hom.app M.obj +
      ((univCyclotomicPresCLL hQ RD Λ hΛ).map₂ ψ).hom.app M.obj
  erw [Diagrams.BicatInterp.admissiblePseudofunctor_map₂_add]
  rfl

/-- The action on `Ř^λ-pmod` is `k`-linear on 2-morphisms. -/
theorem univPmod_map₂_smul {b : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat}
    {a : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat} {f g : a ⟶ b}
    (r : k) (φ : f ⟶ g) (M : (univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).obj a) :
    ((univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).map₂ (r • φ)).hom.app M =
      r • ((univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).map₂ φ).hom.app M := by
  apply ObjectProperty.hom_ext
  change ((univCyclotomicPresCLL hQ RD Λ hΛ).map₂ (r • φ)).hom.app M.obj = _
  erw [Diagrams.BicatInterp.admissiblePseudofunctor_map₂_smul]
  rfl

/-- **The ideal `I` of Webster, arXiv:1309.3796v2, Prop. 3.25**: the 2-morphisms `f ⟶ g` out of
the region of `P_∅` spanned by those factoring through a composite `e ≫ w` whose first strand
`e` is downward (Webster's `F_𝐣 E_j 1_λ`). -/
def vacIdeal {c : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat}
    (f g : vacRegion hQ RD Λ ⟶ c) : Submodule k (f ⟶ g) :=
  TwoRep.factorIdeal (k := k) (a := vacRegion hQ RD Λ)
    (fun _ e => ∃ (i : I) (r : X), (LinearCat.revHom e).obj.word = [⟨(false, i), r⟩]) f g

/-- **The evaluation at `P_∅` kills the ideal `I`** (Webster, arXiv:1309.3796v2, Prop. 3.25: the
evaluation map is defined on the quotient by `I`). -/
theorem univVacuum_map₂_eq_zero_of_mem_vacIdeal
    {c : RevBicat (KL3.Diagram.CL.presCL RD k (univScalars hQ RD)).Bicat}
    {f g : vacRegion hQ RD Λ ⟶ c} {φ : f ⟶ g} (hφ : φ ∈ vacIdeal hQ RD Λ f g) :
    ((univCyclotomicPresCLPmod.{u, v, w} hQ RD Λ hΛ).map₂ φ).hom.app (univVacuum hQ RD Λ hΛ) = 0 :=
  map₂_app_eq_zero_of_mem_factorIdeal _ _ _
    (fun _ e ⟨i, r, he⟩ => isZero_univPmod_map_vacuum hQ RD Λ hΛ e i r he)
    (fun φ ψ => univPmod_map₂_add hQ RD Λ hΛ φ ψ _)
    (fun r φ => univPmod_map₂_smul hQ RD Λ hΛ r φ _) hφ

end

end Categorification.KLR.CyclotomicAction
