import Categorification.WeightedKLR.RedStrands.ParabolicStandardFullyFaithful
import Categorification.WeightedKLR.RedStrands.TwoPieceStandardizationNatural
import Categorification.WeightedKLR.RedStrands.PartialStandardizationStagedZero

/-!
# The standardization of Definition 5.4 is fully faithful

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3,
Proposition 5.26, full faithfulness of standardization: for blocks `b` with `b_0 = 0` and right
modules `M`, `M'` over the block algebra `B = R^{λ_1}(b_1) ⊗ ⋯ ⊗ R^{λ_ℓ}(b_ℓ)` of
Proposition 5.3, the standardization `S(M) = M ⊗_B S^L_α` of Definition 5.4 gives a bijection
`Hom_B(M, M') ≅ Hom_{T^λ}(S(M), S(M'))`, `g ↦ g ⊗ 1` (`standardizationHomEquiv`).

The proof is by induction on the number of red strands. With no red strands `S(M) = M`
(`leftStandardizationZeroEquiv`), naturally in `M`. For `ℓ + 1` red strands, `S(M)` is the
two-piece standardization of `X_M = M ⊗_{B'} S^L_{α'}`, naturally in `M`
(`splitStandardEquiv_mapRight_hom`), and the two-piece standardization is fully faithful
(`parabolicStandardMapT_bijective`). A map `X_M → X_{M'}` over the factor algebra
`T^{λ'} ⊗ R^{λ_{ℓ+1}}(β)` is, by induction, `g ⊗ 1` for a map `g : M → M'` over `B'`; it
commutes with the last factor exactly when `g` does, by injectivity of `g ↦ g ⊗ 1`, and `B` is
generated by `B'` and the last factor (`blockAlgebra_subalgebra_eq_top`).

## Main definitions

* `initRestrictHom`, `twoPieceHom`: the maps `InitRestrict M → InitRestrict M'` and
  `X_M → X_{M'}` induced by a map `M → M'`.
* `standardizationHomEquiv`: Proposition 5.26, full faithfulness.

## Main results

* `splitStandardEquiv_mapRight_hom`: naturality of `M ⊗_B S^L_α ≅ S(X_M)` in `M`.
* `standardizationHomBijective`: the induction.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra MulOpposite
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

namespace StendhalAlgebra

variable {I : Type} [DecidableEq I] {k : Type} [Field k] (Q : I → I → MvPolynomial (Fin 2) k)

section Zero

variable (Λ : Fin 0 → I →₀ ℕ) (b : Fin 1 → Multiset I) (hb0 : b 0 = 0)
  (hb : blockPrefix b 1 = 0) (hα : RootNonViolated (ν := (0 : Multiset I)) (blockRoot b))
  {M M' : Type*} [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [AddCommGroup M'] [Module k M'] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']

/-- The identification `M ⊗_B S^L_α ≅ M` with no red strands is natural in `M`. -/
theorem leftStandardizationZeroEquiv_mapRight_hom (g : M →ₗ[(BlockAlgebra k Q Λ b)ᵐᵒᵖ] M')
    (y : LeftStandardization Q Λ b hb hα M) :
    leftStandardizationZeroEquiv Q Λ b hb0 hb hα M'
        (BalancedTensor.mapRight (k := k) (B := TensorProductAlgebra k Q Λ 0)
          (M := BlockLeftStandard Q Λ b hb hα) g y) =
      g (leftStandardizationZeroEquiv Q Λ b hb0 hb hα M y) :=
  LinearMap.congr_fun (BalancedTensor.ext (f :=
      (leftStandardizationZeroEquiv Q Λ b hb0 hb hα M').toLinearMap.comp
        ((BalancedTensor.mapRight (k := k) (B := TensorProductAlgebra k Q Λ 0)
          (M := BlockLeftStandard Q Λ b hb hα) g).restrictScalars k))
      (g := (g.restrictScalars k).comp (leftStandardizationZeroEquiv Q Λ b hb0 hb hα M).toLinearMap)
      fun _ m => (g.map_smul_of_tower _ m).symm) y

end Zero

section Natural

variable (hQ : KLRSymm Q) {ℓ : ℕ} (Λ : Fin (ℓ + 1) → I →₀ ℕ) (b : Fin (ℓ + 2) → Multiset I)

local notation "𝔹" => BlockAlgebra k Q Λ b
local notation "B'" => BlockAlgebra k Q (Λ ∘ Fin.castSucc) (initBlocks b)
local notation "Cyc" => CycKLR k Q (fun i : I => (Polynomial.X : Polynomial k) ^ Λ (Fin.last ℓ) i)
  (lastBlock b)
local notation "Told" => TensorProductAlgebra k Q (Λ ∘ Fin.castSucc) (initWeight b)
local notation "D" => parabolicFactorAlgebra Q Λ (initWeight b) (lastBlock b)

variable {M M' : Type*} [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [AddCommGroup M'] [Module k M'] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']

local notation "ofR" => initRestrictOf Q Λ b (M := M)
local notation "ofR'" => initRestrictOf Q Λ b (M := M')

/-- A map `M → M'` as a map over the block algebra of the first `ℓ` red strands. -/
def initRestrictHom (g : M →ₗ[𝔹ᵐᵒᵖ] M') :
    InitRestrict Q Λ b M →ₗ[B'ᵐᵒᵖ] InitRestrict Q Λ b M' where
  toFun m := ofR' (g ((ofR).symm m))
  map_add' m m' := by rw [map_add, map_add, map_add]
  map_smul' a m := by
    obtain ⟨m, rfl⟩ := (ofR).surjective m
    induction a using MulOpposite.rec' with | _ x =>
    rw [op_smul_initRestrictOf, RingHom.id_apply, LinearEquiv.symm_apply_apply,
      LinearEquiv.symm_apply_apply, map_smul, op_smul_initRestrictOf]

omit [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M'] in
theorem initRestrictHom_of (g : M →ₗ[𝔹ᵐᵒᵖ] M') (m : M) :
    initRestrictHom Q Λ b g (ofR m) = ofR' (g m) := rfl

omit [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M'] in
theorem lastFactorEnd_comp_initRestrictHom (g : M →ₗ[𝔹ᵐᵒᵖ] M') (c : Cyc) :
    lastFactorEnd Q Λ b c ∘ₗ initRestrictHom Q Λ b g =
      initRestrictHom Q Λ b g ∘ₗ lastFactorEnd Q Λ b c := by
  refine LinearMap.ext fun m => ?_
  obtain ⟨m, rfl⟩ := (ofR).surjective m
  rw [LinearMap.comp_apply, LinearMap.comp_apply, initRestrictHom_of, lastFactorEnd_of,
    lastFactorEnd_of, initRestrictHom_of]
  exact congrArg ofR' (map_smul g _ m).symm

variable (hα' : RootNonViolated (ν := initWeight b) (blockRoot (initBlocks b)))

local notation "L'" => BlockLeftStandard Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
local notation "XL" => LeftStandardization Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
  (InitRestrict Q Λ b M)
local notation "XL'" => LeftStandardization Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
  (InitRestrict Q Λ b M')
local notation "ofX" => twoPieceInputOf Q Λ b M hα'
local notation "ofX'" => twoPieceInputOf Q Λ b M' hα'
local notation "mR" => BalancedTensor.mapRight (k := k) (B := Told) (M := L')

/-- **The map `X_g : X_M → X_{M'}`** over the factor algebra, for `X_M = M ⊗_{B'} S^L_{α'}`. -/
def twoPieceHom (g : M →ₗ[𝔹ᵐᵒᵖ] M') :
    TwoPieceInput Q Λ b M hα' →ₗ[D] TwoPieceInput Q Λ b M' hα' where
  toFun x := ofX' (mR (initRestrictHom Q Λ b g) ((ofX).symm x))
  map_add' x y := by rw [map_add, map_add, map_add]
  map_smul' d x := by
    obtain ⟨x, rfl⟩ := (ofX).surjective x
    rw [RingHom.id_apply, twoPieceInput_smul_def, twoPieceInput_smul_def,
      LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply]
    congr 1
    induction d using TensorProduct.inductionOn with
    | tmul t c =>
      rw [twoPieceInputAction_tmul, twoPieceInputAction_tmul, map_smul, ← LinearMap.comp_apply,
        ← LinearMap.comp_apply, ← BalancedTensor.mapRight_comp, ← BalancedTensor.mapRight_comp,
        lastFactorEnd_comp_initRestrictHom]
    | add d d' hd hd' => simp only [map_add, LinearMap.add_apply, hd, hd']

theorem twoPieceHom_of (g : M →ₗ[𝔹ᵐᵒᵖ] M') (x : XL) :
    twoPieceHom Q Λ b hα' g (ofX x) = ofX' (mR (initRestrictHom Q Λ b g) x) := rfl

theorem tmul_one_smul_twoPieceInputOf (t : Told) (x : XL) :
    (t ⊗ₜ[k] (1 : Cyc) : D) • ofX x = ofX (t • x) := by
  rw [twoPieceInput_smul_def, twoPieceInputAction_tmul, lastFactorEnd_one,
    BalancedTensor.mapRight_id]
  rfl

theorem one_tmul_smul_twoPieceInputOf (c : Cyc) (x : XL) :
    ((1 : Told) ⊗ₜ[k] c : D) • ofX x = ofX (mR (lastFactorEnd Q Λ b c) x) := by
  rw [twoPieceInput_smul_def, twoPieceInputAction_tmul, one_smul]

variable (hα : RootNonViolated (ν := initWeight b + lastBlock b) (blockRoot b))

local notation "L" => BlockLeftStandard Q Λ b (blockPrefix_last b) hα
local notation "mRT" => BalancedTensor.mapRight (k := k) (B := TensorProductAlgebra k Q Λ
  (initWeight b + lastBlock b)) (M := L)

theorem splitStandardTo_twoPieceHom (g : M →ₗ[𝔹ᵐᵒᵖ] M') :
    (splitStandardTo Q Λ hQ b hα' hα M').comp
        (parabolicStandardMapT Q Λ hQ (twoPieceHom Q Λ b hα' g)) =
      (mRT g).comp (splitStandardTo Q Λ hQ b hα' hα M) := by
  refine parabolicStandardT_ext Q Λ (initWeight b) (lastBlock b) hQ fun n => ?_
  rw [LinearMap.comp_apply, LinearMap.comp_apply, parabolicStandardMapT_unit,
    splitStandardTo_unit, splitStandardTo_unit]
  obtain ⟨x, rfl⟩ := (ofX).surjective n
  rw [twoPieceHom_of]
  induction x using BalancedTensor.induction_on with
  | zero => simp only [map_zero]
  | tmul l m =>
    obtain ⟨m, rfl⟩ := (ofR).surjective m
    rw [BalancedTensor.mapRight_tmul, initRestrictHom_of, splitInputMap_of, splitInputMap_of,
      LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply, BalancedTensor.mapRight_tmul]
  | add x y hx hy => rw [map_add, map_add, map_add, hx, hy, map_add, map_add, map_add]

/-- **Naturality of `M ⊗_B S^L_α ≅ S(X_M)` in `M`.** -/
theorem splitStandardEquiv_mapRight_hom (g : M →ₗ[𝔹ᵐᵒᵖ] M')
    (y : LeftStandardization Q Λ b (blockPrefix_last b) hα M) :
    splitStandardEquiv Q Λ hQ b hα' hα M' (mRT g y) =
      parabolicStandardMapT Q Λ hQ (twoPieceHom Q Λ b hα' g)
        (splitStandardEquiv Q Λ hQ b hα' hα M y) := by
  apply (splitStandardEquiv Q Λ hQ b hα' hα M').symm.injective
  rw [LinearEquiv.symm_apply_apply]
  change _ = splitStandardTo Q Λ hQ b hα' hα M' (parabolicStandardMapT Q Λ hQ
    (twoPieceHom Q Λ b hα' g) (splitStandardEquiv Q Λ hQ b hα' hα M y))
  rw [← LinearMap.comp_apply, splitStandardTo_twoPieceHom, LinearMap.comp_apply]
  change _ = mRT g ((splitStandardEquiv Q Λ hQ b hα' hα M).symm
      (splitStandardEquiv Q Λ hQ b hα' hα M y))
  rw [LinearEquiv.symm_apply_apply]

end Natural

/-- Standardization on maps, `g ↦ g ⊗ 1`. -/
abbrev standardizationHom {n : ℕ} (Λ : Fin n → I →₀ ℕ) {b : Fin (n + 1) → Multiset I}
    {ν : Multiset I} (hb : blockPrefix b (n + 1) = ν) (hα : RootNonViolated (ν := ν) (blockRoot b))
    (M M' : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [AddCommGroup M'] [Module k M'] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M'] :
    (M →ₗ[(BlockAlgebra k Q Λ b)ᵐᵒᵖ] M') →
      (LeftStandardization Q Λ b hb hα M →ₗ[TensorProductAlgebra k Q Λ ν]
        LeftStandardization Q Λ b hb hα M') :=
  BalancedTensor.mapRight (k := k) (B := TensorProductAlgebra k Q Λ ν)
    (M := BlockLeftStandard Q Λ b hb hα)

/-- The statement that standardization with `n` red strands is bijective on maps. -/
def StandardizationHomBijective (n : ℕ) : Prop :=
  ∀ (Λ : Fin n → I →₀ ℕ) (b : Fin (n + 1) → Multiset I) (ν : Multiset I)
    (hb : blockPrefix b (n + 1) = ν) (hα : RootNonViolated (ν := ν) (blockRoot b)), b 0 = 0 →
    ∀ (M M' : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
      [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
      [AddCommGroup M'] [Module k M'] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']
      [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M'],
      Function.Bijective (standardizationHom Q Λ hb hα M M')

omit [DecidableEq I] in
theorem blockPrefix_one_eq_zero {n : ℕ} (b : Fin (n + 1) → Multiset I) (hb0 : b 0 = 0) :
    blockPrefix b 1 = 0 :=
  Finset.sum_eq_zero fun j hj => by
    have hj' : j.val < 1 := (Finset.mem_filter.1 hj).2
    rw [show j = 0 from Fin.ext (by rw [Fin.val_zero]; omega), hb0]

theorem rootNonViolated_of_eq_zero {ν : Multiset I} (hν : ν = 0) (α : Fin 0 → I → ℕ) :
    RootNonViolated (ν := ν) α := by
  subst hν
  rintro s _ ⟨h, _⟩
  simp [stendhalWeight] at h

/-- **With no red strands, standardization is bijective on maps.** -/
theorem standardizationHomBijective_zero : StandardizationHomBijective Q 0 := by
  intro Λ b ν hb hα hb0 M M' _ _ _ _ _ _ _ _
  obtain rfl : ν = 0 := hb.symm.trans (blockPrefix_one_eq_zero b hb0)
  let e := leftStandardizationZeroEquiv Q Λ b hb0 hb hα M
  let e' := leftStandardizationZeroEquiv Q Λ b hb0 hb hα M'
  have he : ∀ (g : M →ₗ[(BlockAlgebra k Q Λ b)ᵐᵒᵖ] M') y,
      e' (standardizationHom Q Λ hb hα M M' g y) = g (e y) :=
    fun g y => leftStandardizationZeroEquiv_mapRight_hom Q Λ b hb0 hb hα g y
  refine ⟨fun g g' h => LinearMap.ext fun m => ?_, fun φ => ?_⟩
  · have := congrArg e' (LinearMap.congr_fun h (e.symm m))
    rwa [he, he, LinearEquiv.apply_symm_apply] at this
  · let g : M →ₗ[(BlockAlgebra k Q Λ b)ᵐᵒᵖ] M' :=
      { toFun := fun m => e' (φ (e.symm m))
        map_add' := fun m m' => by rw [map_add, map_add, map_add]
        map_smul' := fun a m => by
          induction a using MulOpposite.rec' with | _ x =>
          obtain ⟨c, rfl⟩ := blockAlgebraZero_scalar Q Λ b hb0 x
          rw [show (op (algebraMap k (BlockAlgebra k Q Λ b) c) :
              (BlockAlgebra k Q Λ b)ᵐᵒᵖ) = algebraMap k _ c from rfl, algebraMap_smul,
            RingHom.id_apply, algebraMap_smul, map_smul, φ.map_smul_of_tower, map_smul] }
    refine ⟨g, LinearMap.ext fun y => e'.injective ?_⟩
    rw [he]
    change e' (φ (e.symm (e y))) = _
    rw [LinearEquiv.symm_apply_apply]

section Step

variable (hQ : KLRSymm Q) {ℓ : ℕ} (Λ : Fin (ℓ + 1) → I →₀ ℕ) (b : Fin (ℓ + 2) → Multiset I)
  (hα' : RootNonViolated (ν := initWeight b) (blockRoot (initBlocks b)))
  (hα : RootNonViolated (ν := initWeight b + lastBlock b) (blockRoot b))
  (M M' : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [AddCommGroup M'] [Module k M'] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']

local notation "𝔹" => BlockAlgebra k Q Λ b
local notation "Cyc" => CycKLR k Q (fun i : I => (Polynomial.X : Polynomial k) ^ Λ (Fin.last ℓ) i)
  (lastBlock b)
local notation "Told" => TensorProductAlgebra k Q (Λ ∘ Fin.castSucc) (initWeight b)
local notation "D" => parabolicFactorAlgebra Q Λ (initWeight b) (lastBlock b)
local notation "XL" => LeftStandardization Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
  (InitRestrict Q Λ b M)
local notation "XL'" => LeftStandardization Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
  (InitRestrict Q Λ b M')
local notation "X" => TwoPieceInput Q Λ b M hα'
local notation "X'" => TwoPieceInput Q Λ b M' hα'
local notation "ofR" => initRestrictOf Q Λ b (M := M)
local notation "ofR'" => initRestrictOf Q Λ b (M := M')
local notation "ofX" => twoPieceInputOf Q Λ b M hα'
local notation "ofX'" => twoPieceInputOf Q Λ b M' hα'
local notation "mR" => BalancedTensor.mapRight (k := k) (B := Told)
  (M := BlockLeftStandard Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα')

/-- A map `X_M → X_{M'}` over the factor algebra, as a map over `T^{λ'}`. -/
def twoPieceHomRestrict (ψ : X →ₗ[D] X') : XL →ₗ[Told] XL' where
  toFun x := (ofX').symm (ψ (ofX x))
  map_add' x y := by rw [map_add, map_add, map_add]
  map_smul' t x := by
    rw [RingHom.id_apply]
    apply (ofX').injective
    rw [LinearEquiv.apply_symm_apply, ← tmul_one_smul_twoPieceInputOf Q Λ b hα' t x, map_smul,
      ← (ofX').apply_symm_apply (ψ (ofX x)),
      tmul_one_smul_twoPieceInputOf Q Λ b hα' t ((ofX').symm (ψ (ofX x))),
      LinearEquiv.apply_symm_apply]

include hQ in
/-- **The induction step**: if standardization with the first `ℓ` red strands is bijective on
maps `M → M'`, so is standardization with `ℓ + 1` on maps `M → M'`. -/
theorem standardizationHom_bijective_step
    (ih : Function.Bijective (standardizationHom Q (Λ ∘ Fin.castSucc)
      (rfl : blockPrefix (initBlocks b) (ℓ + 1) = initWeight b) hα' (InitRestrict Q Λ b M)
      (InitRestrict Q Λ b M'))) :
    Function.Bijective (standardizationHom Q Λ (blockPrefix_last b) hα M M') := by
  let e := splitStandardEquiv Q Λ hQ b hα' hα M
  let e' := splitStandardEquiv Q Λ hQ b hα' hα M'
  have hnat : ∀ (g : M →ₗ[𝔹ᵐᵒᵖ] M') y,
      e' (standardizationHom Q Λ (blockPrefix_last b) hα M M' g y) =
        parabolicStandardMapT Q Λ hQ (twoPieceHom Q Λ b hα' g) (e y) :=
    fun g y => splitStandardEquiv_mapRight_hom Q hQ Λ b hα' hα g y
  have hFF := parabolicStandardMapT_bijective Q Λ (initWeight b) (lastBlock b) hQ (N := X)
    (N' := X')
  have hIR : ∀ (g : M →ₗ[𝔹ᵐᵒᵖ] M') (x : XL),
      twoPieceHom Q Λ b hα' g (ofX x) = ofX' (mR (initRestrictHom Q Λ b g) x) :=
    fun g x => twoPieceHom_of Q Λ b hα' g x
  constructor
  · intro g₁ g₂ h
    have h1 : twoPieceHom Q Λ b hα' g₁ = twoPieceHom Q Λ b hα' g₂ := by
      apply hFF.1
      refine LinearMap.ext fun z => ?_
      obtain ⟨y, rfl⟩ := e.surjective z
      rw [← hnat, ← hnat, h]
    have h2 : initRestrictHom Q Λ b g₁ = initRestrictHom Q Λ b g₂ := by
      apply ih.1
      refine LinearMap.ext fun x => (ofX').injective ?_
      have := LinearMap.congr_fun h1 (ofX x)
      rw [hIR, hIR] at this
      exact this
    exact LinearMap.ext fun m => (ofR').injective (LinearMap.congr_fun h2 (ofR m))
  · intro φ
    let φ' : ParabolicStandardT Q Λ (initWeight b) (lastBlock b) X hQ →ₗ[TensorProductAlgebra k Q Λ
        (initWeight b + lastBlock b)] ParabolicStandardT Q Λ (initWeight b) (lastBlock b) X' hQ :=
      e'.toLinearMap ∘ₗ φ ∘ₗ e.symm.toLinearMap
    obtain ⟨ψ, hψ⟩ := hFF.2 φ'
    obtain ⟨g', hg'⟩ := ih.2 (twoPieceHomRestrict Q Λ b hα' M M' ψ)
    have hg'x : ∀ x : XL, ofX' (mR g' x) = ψ (ofX x) := fun x => by
      rw [← (ofX').apply_symm_apply (ψ (ofX x))]
      exact congrArg ofX' (LinearMap.congr_fun hg' x)
    have hcomm : ∀ c : Cyc, lastFactorEnd Q Λ b c ∘ₗ g' = g' ∘ₗ lastFactorEnd Q Λ b c := by
      intro c
      apply ih.1
      refine LinearMap.ext fun x => (ofX').injective ?_
      change ofX' (mR (lastFactorEnd Q Λ b c ∘ₗ g') x) =
        ofX' (mR (g' ∘ₗ lastFactorEnd Q Λ b c) x)
      rw [BalancedTensor.mapRight_comp, BalancedTensor.mapRight_comp, LinearMap.comp_apply,
        LinearMap.comp_apply, ← one_tmul_smul_twoPieceInputOf Q Λ b hα' c (mR g' x), hg'x x,
        ← map_smul, one_tmul_smul_twoPieceInputOf, ← hg'x (mR (lastFactorEnd Q Λ b c) x)]
    let g₀ : M →ₗ[k] M' :=
      (ofR').symm.toLinearMap ∘ₗ (g'.restrictScalars k) ∘ₗ (ofR).toLinearMap
    have hg₀ : ∀ m, ofR' (g₀ m) = g' (ofR m) := fun m => (ofR').apply_symm_apply _
    let P : Subalgebra k 𝔹 :=
      { carrier := {x | ∀ m, g₀ ((op x : 𝔹ᵐᵒᵖ) • m) = (op x : 𝔹ᵐᵒᵖ) • g₀ m}
        mul_mem' := fun {x y} hx hy m => by
          have hx' : ∀ m, g₀ ((op x : 𝔹ᵐᵒᵖ) • m) = (op x : 𝔹ᵐᵒᵖ) • g₀ m := hx
          have hy' : ∀ m, g₀ ((op y : 𝔹ᵐᵒᵖ) • m) = (op y : 𝔹ᵐᵒᵖ) • g₀ m := hy
          rw [op_mul, mul_smul, mul_smul, hy', hx']
        add_mem' := fun {x y} hx hy m => by
          have hx' : ∀ m, g₀ ((op x : 𝔹ᵐᵒᵖ) • m) = (op x : 𝔹ᵐᵒᵖ) • g₀ m := hx
          have hy' : ∀ m, g₀ ((op y : 𝔹ᵐᵒᵖ) • m) = (op y : 𝔹ᵐᵒᵖ) • g₀ m := hy
          rw [op_add, add_smul, add_smul, map_add, hx', hy']
        algebraMap_mem' := fun c m => by
          change g₀ ((algebraMap k 𝔹ᵐᵒᵖ c) • m) = (algebraMap k 𝔹ᵐᵒᵖ c) • g₀ m
          rw [algebraMap_smul, algebraMap_smul, map_smul] }
    have hP : P = ⊤ := blockAlgebra_subalgebra_eq_top Q Λ b P
      (fun y m => (ofR').injective (by
        rw [hg₀, ← op_smul_initRestrictOf, map_smul, ← hg₀, op_smul_initRestrictOf]))
      (fun c m => by
        obtain ⟨c', rfl⟩ : ∃ c' : Cyc, CycKLR.flip _ _ c' = c := ⟨CycKLR.flip _ _ c,
          CycKLR.flip_flip _ _ c⟩
        refine (ofR').injective ?_
        rw [hg₀, ← lastFactorEnd_of, ← LinearMap.comp_apply g', ← hcomm, LinearMap.comp_apply,
          ← hg₀, lastFactorEnd_of])
    let g : M →ₗ[𝔹ᵐᵒᵖ] M' :=
      { toFun := g₀
        map_add' := g₀.map_add
        map_smul' := fun a m => by
          induction a using MulOpposite.rec' with | _ x =>
          exact (show x ∈ P from hP ▸ Algebra.mem_top) m }
    have hIRg : initRestrictHom Q Λ b g = g' := LinearMap.ext fun z => by
      obtain ⟨m, rfl⟩ := (ofR).surjective z
      rw [initRestrictHom_of]
      exact hg₀ m
    have htp : twoPieceHom Q Λ b hα' g = ψ := LinearMap.ext fun z => by
      obtain ⟨x, rfl⟩ := (ofX).surjective z
      rw [hIR, hIRg]
      exact hg'x x
    refine ⟨g, LinearMap.ext fun y => e'.injective ?_⟩
    rw [hnat, htp, hψ]
    change e' (φ (e.symm (e y))) = e' (φ y)
    rw [LinearEquiv.symm_apply_apply]

end Step

theorem standardizationHomBijective_succ (hQ : KLRSymm Q) {ℓ : ℕ}
    (ih : StandardizationHomBijective Q ℓ) : StandardizationHomBijective Q (ℓ + 1) := by
  intro Λ b ν hb hα hb0 M M' _ _ _ _ _ _ _ _
  obtain rfl : ν = initWeight b + lastBlock b := hb.symm.trans (blockPrefix_last b)
  have hb0' : initBlocks b 0 = 0 := by
    change b (Fin.castSucc 0) = 0
    simpa using hb0
  have hα' : RootNonViolated (ν := initWeight b) (blockRoot (initBlocks b)) := by
    rcases Nat.eq_zero_or_pos ℓ with rfl | hℓ
    · exact rootNonViolated_of_eq_zero (blockPrefix_one_eq_zero (initBlocks b) hb0') _
    · exact rootNonViolated_blockRoot hℓ hb0'
  have h := ih (Λ ∘ Fin.castSucc) _ _ rfl hα' hb0' (InitRestrict Q Λ b M) (InitRestrict Q Λ b M')
  exact standardizationHom_bijective_step Q hQ Λ b hα' hα M M' h

/-- **Standardization is bijective on maps** for every number of red strands. -/
theorem standardizationHomBijective (hQ : KLRSymm Q) : ∀ n, StandardizationHomBijective Q n
  | 0 => standardizationHomBijective_zero Q
  | n + 1 => standardizationHomBijective_succ Q hQ (standardizationHomBijective hQ n)

/-- **Standardization is fully faithful** (Webster, arXiv:1309.3796v3, Proposition 5.26, for the
standardization of Definition 5.4): for blocks `b` with `b_0 = 0` and right modules `M`, `M'`
over the block algebra `B`, `Hom_B(M, M') ≅ Hom_{T^λ}(M ⊗_B S^L_α, M' ⊗_B S^L_α)` through
`g ↦ g ⊗ 1`. -/
def standardizationHomEquiv (hQ : KLRSymm Q) {n : ℕ} (Λ : Fin n → I →₀ ℕ)
    (b : Fin (n + 1) → Multiset I) (hb0 : b 0 = 0)
    (hα : RootNonViolated (ν := blockPrefix b (n + 1)) (blockRoot b))
    (M M' : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [AddCommGroup M'] [Module k M'] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M'] :
    (M →ₗ[(BlockAlgebra k Q Λ b)ᵐᵒᵖ] M') ≃
      (LeftStandardization Q Λ b rfl hα M →ₗ[TensorProductAlgebra k Q Λ (blockPrefix b (n + 1))]
        LeftStandardization Q Λ b rfl hα M') :=
  Equiv.ofBijective (standardizationHom Q Λ rfl hα M M')
    (standardizationHomBijective Q hQ n Λ b _ rfl hα hb0 M M')

theorem standardizationHomEquiv_apply (hQ : KLRSymm Q) {n : ℕ} (Λ : Fin n → I →₀ ℕ)
    (b : Fin (n + 1) → Multiset I) (hb0 : b 0 = 0)
    (hα : RootNonViolated (ν := blockPrefix b (n + 1)) (blockRoot b))
    (M M' : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [AddCommGroup M'] [Module k M'] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M']
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M'] (g : M →ₗ[(BlockAlgebra k Q Λ b)ᵐᵒᵖ] M') :
    standardizationHomEquiv Q hQ Λ b hb0 hα M M' g =
      BalancedTensor.mapRight (k := k) (B := TensorProductAlgebra k Q Λ (blockPrefix b (n + 1)))
        (M := BlockLeftStandard Q Λ b rfl hα) g :=
  rfl

