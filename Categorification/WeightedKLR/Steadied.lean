import Categorification.WeightedKLR.GalleryBasis.Corner
import Mathlib.Analysis.SpecialFunctions.Complex.Arg

/-!
# Steadied quotients of weighted KLR algebras

B. Webster, *Weighted Khovanov–Lauda–Rouquier algebras*, arXiv:1209.2463v4, §2, subsection
"Steadied quotients": charges, the preorder `>_c`, unsteady loadings, the ideal `I_c` and the
steadied quotient `W^ϑ_ν(c) = W^ϑ_ν / I_c` (the two Definitions of that subsection).

## Charges

A *charge* is a map `c : I → ℂ_+`, where `ℂ_+` is the set of complex numbers with positive
imaginary part or positive real (`ChargeHalfPlane`). It is extended additively to `ℕ[I]`
(`Charge.eval`); `ℂ_+` is closed under addition and positive integer multiples, so `c(d) ∈ ℂ_+`
for `d ≠ 0` (`Charge.eval_mem`), and its argument lies in `[0, π)`. The preorder `>_c` on the
nonzero elements of `ℕ[I]` compares arguments: `d >_c d'` when `arg c(d) > arg c(d')`
(`Charge.Gt`).

## Induction of loadings

Webster's induction places a loading `L₁` of weight `ν₁` and a loading `L₂` of weight `ν₂` next to
each other, `L₁` to the left, with `s` units of separation, `s` large; on idempotents,
`e_{L₁} ⊗ e_{L₂} ↦ e_{L₁ ∘ L₂}`. Strands of a loading of weight `ν = ν₁ + ν₂` are indexed by their
colour and their rank among the strands of that colour, so in `L₁ ∘ L₂` the strands coming from
`L₁` are those of colour `i` and rank `< ν₁ i` (`Strand.IsLeft`). A loading of weight `ν` is of the
form `L₁ ∘ L₂` with separation `s` when every left strand lies more than `s` to the left of every
right strand (`Loading.IsSeparated`); its restrictions to the left and the right strands are then
`L₁` and (a translate of) `L₂`. We take `s` larger than every `|ϑ_e|` (`WeightedGraph.sepBound`);
any such `s` gives the same chambers. A chamber is *induced* at `ν₁` (`Chamber.IsInduced`) if it
contains such a loading. `Chamber.isInduced_iff` characterizes this by signs: every right strand
is to the right of the ghosts of the left strands, and every left strand is to the left of the
ghosts of the right strands.

## Unsteady loadings and the steadied quotient

Webster calls an indecomposable module unsteady if it is a summand of an induction `M₁ ∘ M₂` with
`wt M₁ >_c wt M₂`, and defines `I_c` as the two-sided ideal of the elements factoring through
unsteady projectives; he describes it diagrammatically as spanned by the diagrams having a
horizontal slice whose loading is `L₁ ∘ L₂` with `|L₁| >_c |L₂|`. We formalize this diagrammatic
description: a chamber is *unsteady* (`Chamber.IsUnsteady`) if it is induced at some `ν₁` with
`0 ≠ ν₁ ≠ ν`, `ν₁ ≤ ν` and `ν₁ >_c ν - ν₁`, and `I_c` (`unsteadyIdeal`) is the two-sided ideal of
Webster's algebra `WeightedKLRAlgebra k Γ ν` generated by the idempotents `e_C` of the unsteady
chambers. A diagram with a horizontal slice at the loading `C` is a product `a * e_C * b`, and
`mem_unsteadyIdeal_iff` says that `I_c` consists of the sums of such products. The steadied
quotient is `SteadiedQuotient k Γ ν c`.

The comparison of the diagrammatic ideal with the module-theoretic one (elements factoring
through unsteady indecomposable projectives) uses the induction functor on modules and the
decomposition of projectives into indecomposables, which are not formalized here. The bimodule
`B^{ϑ,ϑ'}(c)` of the same Definition is a quotient of the bimodule of the twisted algebra of
the preceding subsection, which is not formalized either.

## Main definitions and results

* `ChargeHalfPlane`, `Charge`, `Charge.eval`, `Charge.eval_mem`, `Charge.Gt`.
* `Strand.IsLeft`, `WeightedGraph.sepBound`, `Loading.IsSeparated`, `Chamber.IsInduced`,
  `Chamber.isInduced_iff`.
* `Chamber.IsUnsteady`, `chamberIdem`, `unsteadyIdeal`, `mem_unsteadyIdeal_iff`,
  `SteadiedQuotient`, `SteadiedQuotient.mk_eq_zero_iff`, `SteadiedQuotient.mk_chamberIdem`.
-/

namespace Categorification.WeightedKLR

open GalleryAlgebra

/-! ### Charges -/

/-- Webster's `ℂ_+`: complex numbers with positive imaginary part, or positive reals. -/
def ChargeHalfPlane : Set ℂ := {x | 0 < x.im ∨ (x.im = 0 ∧ 0 < x.re)}

theorem add_mem_chargeHalfPlane {x y : ℂ} (hx : x ∈ ChargeHalfPlane) (hy : y ∈ ChargeHalfPlane) :
    x + y ∈ ChargeHalfPlane := by
  simp only [ChargeHalfPlane, Set.mem_ofPred_eq, Complex.add_im, Complex.add_re] at *
  have hx' : 0 ≤ x.im := by rcases hx with h | h; exacts [h.le, h.1.ge]
  have hy' : 0 ≤ y.im := by rcases hy with h | h; exacts [h.le, h.1.ge]
  rcases hx with hx | ⟨hx0, hx1⟩
  · left; linarith
  rcases hy with hy | ⟨hy0, hy1⟩
  · left; linarith
  · right; exact ⟨by linarith, by linarith⟩

theorem nsmul_mem_chargeHalfPlane {x : ℂ} (hx : x ∈ ChargeHalfPlane) {n : ℕ} (hn : n ≠ 0) :
    (n : ℂ) * x ∈ ChargeHalfPlane := by
  have hn' : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
  simp only [ChargeHalfPlane, Set.mem_ofPred_eq, Complex.mul_im, Complex.mul_re,
    Complex.natCast_re, Complex.natCast_im, zero_mul, add_zero, sub_zero] at *
  rcases hx with h | ⟨h0, h1⟩
  · exact Or.inl (mul_pos hn' h)
  · exact Or.inr ⟨by rw [h0, mul_zero], mul_pos hn' h1⟩

/-- The argument of a point of `ℂ_+` lies in `[0, π)`. -/
theorem arg_mem_Ico_of_mem_chargeHalfPlane {x : ℂ} (hx : x ∈ ChargeHalfPlane) :
    Complex.arg x ∈ Set.Ico 0 Real.pi := by
  refine ⟨Complex.arg_nonneg_iff.2 ?_, Complex.arg_lt_pi_iff.2 ?_⟩
  · rcases hx with h | h
    · exact h.le
    · exact h.1.ge
  · rcases hx with h | h
    · exact Or.inr h.ne'
    · exact Or.inl h.2.le

variable (I : Type*)

/-- A charge (Webster, §2, "Steadied quotients"): a map `c : I → ℂ_+`. -/
structure Charge where
  /-- The value of the charge on a vertex. -/
  toFun : I → ℂ
  mem : ∀ i, toFun i ∈ ChargeHalfPlane

variable {I}

namespace Charge

variable (c : Charge I)

/-- The charge extended additively to `ℕ[I]`: `c(d) = ∑_i d_i c(i)`. -/
noncomputable def eval (d : I →₀ ℕ) : ℂ := d.sum fun i n => (n : ℂ) * c.toFun i

theorem eval_add (d d' : I →₀ ℕ) : c.eval (d + d') = c.eval d + c.eval d' := by
  classical
  unfold eval
  rw [Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by push_cast; ring)]

theorem eval_single (i : I) (n : ℕ) : c.eval (Finsupp.single i n) = n * c.toFun i := by
  unfold eval
  rw [Finsupp.sum_single_index (by simp)]

/-- For `d ≠ 0`, `c(d) ∈ ℂ_+`. -/
theorem eval_mem {d : I →₀ ℕ} (hd : d ≠ 0) : c.eval d ∈ ChargeHalfPlane := by
  classical
  induction d using Finsupp.induction with
  | zero => exact absurd rfl hd
  | single_add i n d hi hn ih =>
    rw [eval_add, eval_single]
    by_cases hd0 : d = 0
    · subst hd0
      simpa [eval] using nsmul_mem_chargeHalfPlane (c.mem i) hn
    · exact add_mem_chargeHalfPlane (nsmul_mem_chargeHalfPlane (c.mem i) hn) (ih hd0)

/-- Webster's preorder `>_c`: `d >_c d'` when `arg c(d) > arg c(d')`. It is used for nonzero
`d, d' ∈ ℕ[I]`, where these arguments lie in `[0, π)`. -/
def Gt (d d' : I →₀ ℕ) : Prop := Complex.arg (c.eval d') < Complex.arg (c.eval d)

theorem Gt.trans {c : Charge I} {d d' d'' : I →₀ ℕ} (h : c.Gt d d') (h' : c.Gt d' d'') :
    c.Gt d d'' := lt_trans h' h

theorem Gt.irrefl {c : Charge I} (d : I →₀ ℕ) : ¬ c.Gt d d := lt_irrefl _

end Charge

/-! ### Induction of loadings -/

variable {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  {k : Type*} [CommRing k] {Γ : WeightedGraph I 𝕜 k} {ν : I →₀ ℕ}

/-- In a loading of weight `ν` viewed as `L₁ ∘ L₂` with `|L₁| = ν₁`, the strands coming from `L₁`:
those of colour `i` and rank `< ν₁ i`. -/
def Strand.IsLeft (ν₁ : I →₀ ℕ) (s : Strand ν) : Prop := (s.2 : ℕ) < ν₁ s.1

instance (ν₁ : I →₀ ℕ) (s : Strand ν) : Decidable (s.IsLeft ν₁) := by
  unfold Strand.IsLeft; infer_instance

variable (Γ) in
/-- A separation for the induction of loadings: `∑_e |ϑ_e|`, at least every `|ϑ_e|`. -/
def WeightedGraph.sepBound : 𝕜 := ∑ e, |Γ.weight e|

theorem WeightedGraph.abs_weight_le_sepBound (e : Γ.E) : |Γ.weight e| ≤ Γ.sepBound :=
  Finset.single_le_sum (f := fun e => |Γ.weight e|) (fun _ _ => abs_nonneg _) (Finset.mem_univ e)

theorem WeightedGraph.sepBound_nonneg : 0 ≤ Γ.sepBound :=
  Finset.sum_nonneg fun _ _ => abs_nonneg _

/-- The loading `L` is of the form `L₁ ∘ L₂` with `|L₁| = ν₁` and separation `s`: every strand
from `L₁` lies more than `s` to the left of every strand from `L₂`. -/
def Loading.IsSeparated (ν₁ : I →₀ ℕ) (s : 𝕜) (L : Loading Γ ν) : Prop :=
  ∀ a b : Strand ν, a.IsLeft ν₁ → ¬ b.IsLeft ν₁ → L.pos a + s < L.pos b

/-- The chamber `C` is induced at `ν₁`: it is the chamber of a loading `L₁ ∘ L₂` with `|L₁| = ν₁`,
placed with a separation larger than all the weights. -/
def Chamber.IsInduced (ν₁ : I →₀ ℕ) (C : Chamber Γ ν) : Prop :=
  ∃ L : Loading Γ ν, L.chamber = C ∧ L.IsSeparated ν₁ Γ.sepBound

/-- The sign condition of an induced chamber: every strand from `L₂` is to the right of the
ghosts of the strands from `L₁`, and every strand from `L₁` is to the left of the ghosts of the
strands from `L₂`. -/
def Chamber.InducedSigns (ν₁ : I →₀ ℕ) (C : Chamber Γ ν) : Prop :=
  ∀ w : Wall Γ ν, (w.src.IsLeft ν₁ → ¬ w.tgt.IsLeft ν₁ → C.1 w = true) ∧
    (¬ w.src.IsLeft ν₁ → w.tgt.IsLeft ν₁ → C.1 w = false)

/-- In a loading separated by at least `sepBound`, the walls between the two parts have the
signs of `Chamber.InducedSigns`. -/
theorem Loading.IsSeparated.val_pos {ν₁ : I →₀ ℕ} {s : 𝕜} {L : Loading Γ ν}
    (h : L.IsSeparated ν₁ s) (hs : Γ.sepBound ≤ s) (w : Wall Γ ν) (ha : w.src.IsLeft ν₁)
    (hb : ¬ w.tgt.IsLeft ν₁) : 0 < w.val L.pos := by
  have := h _ _ ha hb
  have h1 := (le_abs_self (Γ.weight w.edge)).trans (Γ.abs_weight_le_sepBound w.edge)
  unfold Wall.val; linarith

theorem Loading.IsSeparated.val_neg {ν₁ : I →₀ ℕ} {s : 𝕜} {L : Loading Γ ν}
    (h : L.IsSeparated ν₁ s) (hs : Γ.sepBound ≤ s) (w : Wall Γ ν) (ha : ¬ w.src.IsLeft ν₁)
    (hb : w.tgt.IsLeft ν₁) : w.val L.pos < 0 := by
  have := h _ _ hb ha
  have h1 := (neg_abs_le (Γ.weight w.edge)).trans' (neg_le_neg
    (Γ.abs_weight_le_sepBound w.edge))
  unfold Wall.val; linarith

/-- **Induced chambers by signs.** A chamber is the chamber of a loading `L₁ ∘ L₂` with
`|L₁| = ν₁` if and only if every strand from `L₂` is to the right of the ghosts of the strands
from `L₁` and every strand from `L₁` is to the left of the ghosts of the strands from `L₂`.
(In particular the chamber does not depend on the separation, once it exceeds the weights.) -/
theorem Chamber.isInduced_iff (ν₁ : I →₀ ℕ) (C : Chamber Γ ν) :
    C.IsInduced ν₁ ↔ C.InducedSigns ν₁ := by
  constructor
  · rintro ⟨L, rfl, hL⟩ w
    refine ⟨fun ha hb => ?_, fun ha hb => ?_⟩
    · simp [Loading.chamber, signs, hL.val_pos le_rfl w ha hb]
    · simp [Loading.chamber, signs, (hL.val_neg le_rfl w ha hb).le]
  · intro hC
    obtain ⟨p, hp, hps⟩ := C.2
    set s : 𝕜 := Γ.sepBound
    set t : 𝕜 := s + 1 + ∑ x : Strand ν, ∑ y : Strand ν, |p x - p y|
    have hs0 : 0 ≤ s := Γ.sepBound_nonneg
    have hdiff : ∀ x y : Strand ν, p x - p y ≤ ∑ x : Strand ν, ∑ y : Strand ν, |p x - p y| :=
      fun x y => (le_abs_self _).trans
        ((Finset.single_le_sum (f := fun y => |p x - p y|) (fun _ _ => abs_nonneg _)
          (Finset.mem_univ y)).trans
          (Finset.single_le_sum (f := fun x => ∑ y : Strand ν, |p x - p y|)
            (fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _) (Finset.mem_univ x)))
    set q : Strand ν → 𝕜 := fun x => if x.IsLeft ν₁ then p x else p x + t
    have hsep : ∀ a b : Strand ν, a.IsLeft ν₁ → ¬ b.IsLeft ν₁ → q a + s < q b := by
      intro a b ha hb
      simp only [q, ha, hb, ite_true, ite_false]
      have := hdiff a b
      linarith
    have hsame : ∀ w : Wall Γ ν, (w.src.IsLeft ν₁ ↔ w.tgt.IsLeft ν₁) → w.val q = w.val p := by
      intro w hw
      unfold Wall.val
      by_cases h : w.src.IsLeft ν₁
      · simp [q, h, hw.1 h]
      · have h' : ¬ w.tgt.IsLeft ν₁ := fun h' => h (hw.2 h')
        simp only [q, h, h', ite_false]; ring
    have hq : IsAdmissible Γ q := by
      refine ⟨fun a b hab => ?_, fun a b hab hlt => ?_, fun w => ?_⟩
      · by_cases ha : a.IsLeft ν₁ <;> by_cases hb : b.IsLeft ν₁
        · simp only [q, ha, hb, ite_true] at hab; exact hp.1 hab
        · have := hsep a b ha hb; rw [hab] at this; linarith
        · have := hsep b a hb ha; rw [hab] at this; linarith
        · simp only [q, ha, hb, ite_false] at hab; exact hp.1 (add_right_cancel hab)
      · by_cases ha : a.IsLeft ν₁ <;> by_cases hb : b.IsLeft ν₁
        · simpa [q, ha, hb] using hp.2.1 a b hab hlt
        · have := hsep a b ha hb; linarith
        · exfalso; apply ha
          unfold Strand.IsLeft at hb ⊢
          have h1 : ν₁ a.1 = ν₁ b.1 := congrArg (fun x : ν.support => ν₁ x) hab
          omega
        · simpa [q, ha, hb] using hp.2.1 a b hab hlt
      · by_cases ha : w.src.IsLeft ν₁ <;> by_cases hb : w.tgt.IsLeft ν₁
        · rw [hsame w (iff_of_true ha hb)]; exact hp.2.2 w
        · have := hsep _ _ ha hb
          have h1 := (le_abs_self (Γ.weight w.edge)).trans (Γ.abs_weight_le_sepBound w.edge)
          unfold Wall.val; intro h0; linarith
        · have := hsep _ _ hb ha
          have h1 := (neg_abs_le (Γ.weight w.edge)).trans' (neg_le_neg
            (Γ.abs_weight_le_sepBound w.edge))
          unfold Wall.val; intro h0; linarith
        · rw [hsame w (iff_of_false ha hb)]; exact hp.2.2 w
    refine ⟨⟨q, hq⟩, ?_, hsep⟩
    apply Subtype.ext
    funext w
    show decide (0 < w.val q) = C.1 w
    by_cases ha : w.src.IsLeft ν₁ <;> by_cases hb : w.tgt.IsLeft ν₁
    · rw [hsame w (iff_of_true ha hb), ← hps]; rfl
    · rw [(hC w).1 ha hb]
      have := hsep _ _ ha hb
      have h1 := (le_abs_self (Γ.weight w.edge)).trans (Γ.abs_weight_le_sepBound w.edge)
      simp only [decide_eq_true_eq]; unfold Wall.val; linarith
    · rw [(hC w).2 ha hb]
      have := hsep _ _ hb ha
      have h1 := (neg_abs_le (Γ.weight w.edge)).trans' (neg_le_neg
        (Γ.abs_weight_le_sepBound w.edge))
      simp only [decide_eq_false_iff_not, not_lt]; unfold Wall.val; linarith
    · rw [hsame w (iff_of_false ha hb), ← hps]; rfl

/-! ### Unsteady chambers and the steadied quotient -/

variable [DecidableEq I]

/-- An unsteady chamber (Webster, §2, "Steadied quotients"): the chamber of a loading
`L₁ ∘ L₂` with `L₁`, `L₂` nonempty and `|L₁| >_c |L₂|`. -/
def Chamber.IsUnsteady (c : Charge I) (C : Chamber Γ ν) : Prop :=
  ∃ ν₁ : I →₀ ℕ, ν₁ ≤ ν ∧ ν₁ ≠ 0 ∧ ν₁ ≠ ν ∧ c.Gt ν₁ (ν - ν₁) ∧ C.IsInduced ν₁

theorem e_toFull_mem_corner (C : Chamber Γ ν) :
    (e C.toFull : GalleryAlgebra k Γ ν) ∈ Subsemigroup.corner (rankIdem k Γ ν) := by
  rw [Subsemigroup.mem_corner_iff isIdempotentElem_rankIdem, rankIdem_mul_e, e_mul_rankIdem]
  simp [C.toFull_isRankOrdered]

variable (k) in
/-- The idempotent `e_C` of Webster's algebra for a chamber (equivalence class of loadings). -/
noncomputable def chamberIdem (C : Chamber Γ ν) : WeightedKLRAlgebra k Γ ν :=
  ⟨e C.toFull, e_toFull_mem_corner C⟩

theorem chamberIdem_val (C : Chamber Γ ν) :
    (chamberIdem k C : WeightedKLRAlgebra k Γ ν).1 = e C.toFull := rfl

variable (k Γ ν) in
/-- The idempotents of the unsteady chambers. -/
def unsteadyIdems (c : Charge I) : Set (WeightedKLRAlgebra k Γ ν) :=
  {x | ∃ C : Chamber Γ ν, C.IsUnsteady c ∧ x = chamberIdem k C}

variable (k Γ ν) in
/-- Webster's ideal `I_c` of the weighted KLR algebra: the two-sided ideal generated by the
idempotents of the unsteady loadings, i.e. spanned by the diagrams having a horizontal slice at
an unsteady loading. -/
noncomputable def unsteadyIdeal (c : Charge I) : TwoSidedIdeal (WeightedKLRAlgebra k Γ ν) :=
  TwoSidedIdeal.span (unsteadyIdems k Γ ν c)

theorem chamberIdem_mem_unsteadyIdeal {c : Charge I} {C : Chamber Γ ν} (hC : C.IsUnsteady c) :
    chamberIdem k C ∈ unsteadyIdeal k Γ ν c :=
  TwoSidedIdeal.subset_span ⟨C, hC, rfl⟩

/-- **The unsteady ideal consists of the diagrams through an unsteady slice**: `I_c` is the set
of finite sums of products `a * e_C * b` with `C` unsteady (a diagram with a horizontal slice at
the loading `C`). -/
theorem mem_unsteadyIdeal_iff {c : Charge I} {x : WeightedKLRAlgebra k Γ ν} :
    x ∈ unsteadyIdeal k Γ ν c ↔ x ∈ AddSubmonoid.closure
      {y | ∃ (a b : WeightedKLRAlgebra k Γ ν) (C : Chamber Γ ν), C.IsUnsteady c ∧
        y = a * chamberIdem k C * b} := by
  set M := AddSubmonoid.closure
      {y | ∃ (a b : WeightedKLRAlgebra k Γ ν) (C : Chamber Γ ν), C.IsUnsteady c ∧
        y = a * chamberIdem k C * b}
  -- `M` is closed under multiplication on both sides
  have hL : ∀ a y, y ∈ M → a * y ∈ M := by
    intro a y hy
    induction hy using AddSubmonoid.closure_induction with
    | mem y hy =>
      obtain ⟨a', b', C, hC, rfl⟩ := hy
      exact AddSubmonoid.subset_closure ⟨a * a', b', C, hC, by rw [mul_assoc, mul_assoc,
        mul_assoc]⟩
    | zero => rw [mul_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
  have hR : ∀ b y, y ∈ M → y * b ∈ M := by
    intro b y hy
    induction hy using AddSubmonoid.closure_induction with
    | mem y hy =>
      obtain ⟨a', b', C, hC, rfl⟩ := hy
      exact AddSubmonoid.subset_closure ⟨a', b' * b, C, hC, by rw [mul_assoc, mul_assoc]⟩
    | zero => rw [zero_mul]; exact zero_mem _
    | add y z _ _ hy hz => rw [add_mul]; exact add_mem hy hz
  constructor
  · intro hx
    induction hx using TwoSidedIdeal.span_induction with
    | mem y hy =>
      obtain ⟨C, hC, rfl⟩ := hy
      exact AddSubmonoid.subset_closure ⟨1, 1, C, hC, by rw [one_mul, mul_one]⟩
    | zero => exact zero_mem _
    | add y z _ _ hy hz => exact add_mem hy hz
    | neg y _ hy =>
      have h : -y = (-1 : WeightedKLRAlgebra k Γ ν) * y := (neg_one_mul y).symm
      rw [h]; exact hL (-1) y hy
    | left_absorb a y _ hy => exact hL a y hy
    | right_absorb b y _ hy => exact hR b y hy
  · intro hx
    induction hx using AddSubmonoid.closure_induction with
    | mem y hy =>
      obtain ⟨a, b, C, hC, rfl⟩ := hy
      exact TwoSidedIdeal.mul_mem_right _ _ _
        (TwoSidedIdeal.mul_mem_left _ _ _ (chamberIdem_mem_unsteadyIdeal hC))
    | zero => exact zero_mem _
    | add y z _ _ hy hz => exact add_mem hy hz

variable (k Γ ν) in
/-- **Webster's steadied quotient** `W^ϑ_ν(c) = W^ϑ_ν / I_c`. -/
abbrev SteadiedQuotient (c : Charge I) : Type _ := (unsteadyIdeal k Γ ν c).ringCon.Quotient

namespace SteadiedQuotient

variable (c : Charge I)

variable (k Γ ν) in
/-- The quotient map `W^ϑ_ν → W^ϑ_ν(c)`. -/
noncomputable def mk : WeightedKLRAlgebra k Γ ν →+* SteadiedQuotient k Γ ν c :=
  (unsteadyIdeal k Γ ν c).ringCon.mk'

theorem mk_surjective : Function.Surjective (mk k Γ ν c) :=
  (unsteadyIdeal k Γ ν c).ringCon.mk'_surjective

theorem mk_eq_zero_iff {x : WeightedKLRAlgebra k Γ ν} :
    mk k Γ ν c x = 0 ↔ x ∈ unsteadyIdeal k Γ ν c := by
  rw [← TwoSidedIdeal.mem_ker, mk, TwoSidedIdeal.ker_ringCon_mk']

/-- The idempotents of unsteady loadings vanish in the steadied quotient. -/
theorem mk_chamberIdem {C : Chamber Γ ν} (hC : C.IsUnsteady c) :
    mk k Γ ν c (chamberIdem k C) = 0 :=
