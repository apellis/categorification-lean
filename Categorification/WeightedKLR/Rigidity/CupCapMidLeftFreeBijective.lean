import Categorification.WeightedKLR.Rigidity.CupCapMidLeftFreeSplitSurj

/-!
# `K̃^{λ⁺}_λ` is free as a left `T̃^λ`-module, for a cap after `λ_j`

Webster, arXiv:1309.3796v3, §7.3, the assertion after Lemma 7.19 that `coe^{λ⁺}_λ` is projective
as a left `T^λ`-module, for a cap after the red strand `λ_j`. The comparison map over the block
shuffles

  `Θ : ⨁_g T̃^λ e(s_g) ⊗_k L e(t_g) → K̃^{λ⁺}_λ`

is bijective (`midThetaBlock_bijective`), so `K̃^{λ⁺}_λ` is free over `T̃^λ` on the block
generators in the sense of this isomorphism.

The argument (Vasconcelos): the polynomial ring `P = k[x_1, …, x_m]` in the dots of `λ` is
commutative and acts on `K̃^{λ⁺}_λ` through `T̃^λ`. When each piece `L e(t)` is finitely
generated over `k`, `K̃^{λ⁺}_λ` is a finitely generated `P`-module: it is generated by the
elements `v γ_g` of the generators without dots, `v` running over generators of `L e(t_g)`. The
composite `Θ ∘ Φ` with the splitting map `Φ` is `P`-linear and surjective, hence injective
(Mathlib's `OrzechProperty` for commutative rings). So `Φ` is injective, hence bijective, and
`Θ` is injective.

Route hypotheses (tracked): the pieces `L e(t)` are finitely generated over `k`; the cup scalars
are units and `L` satisfies the pull-off identity, as for the surjectivity of `Θ`; `Q` is
symmetric, for the basis of the model.

## Main results

* `midLeftModel_finite`: `K̃^{λ⁺}_λ` is a finitely generated `P`-module.
* `midThetaBlock_bijective`: the comparison map over the block shuffles is bijective.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal.CupCap

open KLR KLRAlgebra TypeA Equiv MulOpposite InductionAlong MvPolynomial TensorProduct

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ} {j : ℕ} {hj : j ≤ ℓ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {Λc : Fin 2 → I →₀ ℕ}
  {ν ν₀ : Multiset I}

local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "N" => Multiset.card (stendhalWeight 2 ν₀)
local notation "M" => Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "T" => StendhalAlgebra k Q Λ ν
local notation "P" => MvPolynomial (Fin (Multiset.card (stendhalWeight ℓ ν))) k

variable {L : Type*} [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  [Module k L] [IsScalarTower k (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  {hL : ∀ (w : Seq (stendhalWeight 2 ν₀)) (v : L), ¬ IsCapGood ν₀ w →
      op (cupMap k Q Λc ν₀ (KLRAlgebra.e w)) • v = 0}

omit [DecidableEq I] in
/-- There are finitely many generators without dots. -/
theorem finite_midShuffle : Finite (MidShuffle j hj ν ν₀) := by
  refine Finite.of_injective (fun g : MidShuffle j hj ν ν₀ => (g.1.s, g.1.t, g.1.u)) ?_
  intro g g' h
  simp only [Prod.mk.injEq] at h
  exact Subtype.ext (MidGen.ext' h.1 h.2.1 (g.2.trans g'.2.symm) h.2.2)

/-- The `P`-module structure of the model, through `T̃^λ`. -/
abbrev midLeftModelPolModule (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) :
    Module P (MidLeftModel L hL hR) :=
  Module.compHom _ (polT Q Λ ν).toRingHom

omit [Module k L] [IsScalarTower k (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L] in
theorem midLeftModel_isScalarTower (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) :
    letI := midLeftModelPolModule hR
    IsScalarTower k P (MidLeftModel L hL hR) := by
  let := midLeftModelPolModule hR
  refine ⟨fun c p y => ?_⟩
  change polT Q Λ ν (c • p) • y = c • (polT Q Λ ν p • y)
  rw [map_smul, smul_assoc]

variable {ρ₃ : Perm (Fin (Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀)))) → List ℕ}
  {ρ₂ : Perm (Fin (Multiset.card (stendhalWeight 2 ν₀))) → List ℕ}

/-- **The model is a finitely generated `P`-module** when each piece `L e(t)` is finitely
generated over `k`: it is generated by the `v γ_g` with `g` without dots and `v` running over
generators of the pieces. -/
theorem midLeftModel_finite [DecidableEq (MidGen j hj ν ν₀)] (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL)
    (hQ : KLRSymm Q) (hρ₂ : ∀ b, IsReduced N (ρ₂ b) ∧ wordProd N (ρ₂ b) = b)
    (hρ₃ : ∀ w, IsReduced M (ρ₃ w) ∧ wordProd M (ρ₃ w) = w)
    (hfin : ∀ (t : Seq (stendhalWeight 2 ν₀)) (ht : IsRedOrdered t), Module.Finite k
      (BalancedTensor.idemPart k L (op (StendhalAlgebra.e (k := k) (Q := Q) (Λ := Λc) t ht)))) :
    letI := midLeftModelPolModule hR
    Module.Finite P (MidLeftModel L hL hR) := by
  let := midLeftModelPolModule hR
  have := midLeftModel_isScalarTower hR
  have := finite_midShuffle (j := j) (hj := hj) (ν := ν) (ν₀ := ν₀)
  have hgen : ∀ g : MidShuffle j hj ν ν₀, ∃ S : Set
      (BalancedTensor.idemPart k L (midGenIdem (k := k) Q Λc g.1)), S.Finite ∧
        Submodule.span k S = ⊤ := fun g =>
    Submodule.fg_def.1 (hfin g.1.t g.1.ht).fg_top
  choose S hSf hS using hgen
  let G : Set (MidLeftModel L hL hR) := ⋃ g : MidShuffle j hj ν ν₀,
    (fun x : BalancedTensor.idemPart k L (midGenIdem (k := k) Q Λc g.1) =>
      (Ind.tmul (midGenCorner Q Λ Λc ρ₃ g.1) (x : L) : MidLeftModel L hL hR)) '' S g
  have hGf : G.Finite := Set.finite_iUnion fun g => (hSf g).image _
  refine ⟨Submodule.fg_def.2 ⟨G, hGf, eq_top_iff.2 fun y hy => ?_⟩⟩
  clear hy
  -- the elements `v γ_g` of the generators without dots
  have hund : ∀ (g : MidShuffle j hj ν ν₀)
      (v : BalancedTensor.idemPart k L (midGenIdem (k := k) Q Λc g.1)),
      (Ind.tmul (midGenCorner Q Λ Λc ρ₃ g.1) (v : L) : MidLeftModel L hL hR) ∈
        Submodule.span P G := by
    intro g v
    have hv : v ∈ Submodule.span k (S g) := (hS g).symm ▸ Submodule.mem_top
    have hmap : Submodule.span k (S g) ≤ ((Submodule.span P G).restrictScalars k).comap
        (midLeftGen L hL ρ₃ hR g) := by
      rw [Submodule.span_le]
      intro x hx
      exact Submodule.subset_span (Set.mem_iUnion.2 ⟨g, x, hx, rfl⟩)
    exact hmap hv
  obtain ⟨f, rfl⟩ := (midModelEquivₖ j hj Q Λ Λc ν ν₀ L ρ₃ hQ hρ₂ hρ₃).symm.surjective y
  induction f using DFinsupp.induction with
  | h0 => rw [map_zero]; exact zero_mem _
  | ha g v f _ _ ih =>
    rw [map_add]
    refine add_mem ?_ ih
    have hsymm : (midModelEquivₖ j hj Q Λ Λc ν ν₀ L ρ₃ hQ hρ₂ hρ₃).symm (DFinsupp.single g v) =
        Ind.tmul (midGenCorner Q Λ Λc ρ₃ g) (v : L) :=
      (LinearEquiv.symm_apply_eq _).2 (midModelEquivₖ_tmul hQ hρ₂ hρ₃ g v).symm
    rw [hsymm]
    have h := midLeftAlg_midDotElt_tmul hR g (v : L) (ρ₃ := ρ₃)
    have hdot : midDotElt (k := k) (Q := Q) (Λ := Λ) g =
        polT Q Λ ν (monomial g.d 1) * StendhalAlgebra.e (k := k) (Q := Q) (Λ := Λ) g.s g.hs :=
      rfl
    rw [hdot, map_mul, Module.End.mul_apply] at h
    erw [midLeftAlg_e_tmul_midGenCorner hR (MidGen.undot j hj ν ν₀ g) (v : L)] at h
    change (Ind.tmul (midGenCorner Q Λ Λc ρ₃ g) (v : L) : MidLeftModel L hL hR) ∈ _
    rw [← h]
    exact Submodule.smul_mem _ (monomial g.d 1) (hund (MidGen.toShuffle g) v)

/-- **The comparison map over the block shuffles is bijective** (Webster, arXiv:1309.3796v3,
§7.3, a cap after `λ_j`): `K̃^{λ⁺}_λ ≅ ⨁_g T̃^λ e(s_g) ⊗_k L e(t_g)` as left `T̃^λ`-modules, the
sum over the block shuffles `g`.

Route hypotheses (tracked): each piece `L e(t)` finitely generated over `k`; `hP`, `hκ` as for
`midThetaBlock_surjective`; `Q` symmetric, for the basis of the model. -/
theorem midThetaBlock_bijective [DecidableEq (MidBlockShuffle j hj ν ν₀)]
    (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) (hQ : KLRSymm Q)
    (hρ₃ : ∀ w, IsReduced M (ρ₃ w) ∧ wordProd M (ρ₃ w) = w)
    (hP : PullOff k Q Λc ν₀ L) (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i))
    (hfin : ∀ (t : Seq (stendhalWeight 2 ν₀)) (ht : IsRedOrdered t), Module.Finite k
      (BalancedTensor.idemPart k L (op (StendhalAlgebra.e (k := k) (Q := Q) (Λ := Λc) t ht)))) :
    Function.Bijective (midThetaBlock L hL ρ₃ hR) := by
  classical
  choose ρ₁ hρ₁ using fun w => exists_reduced m w
  choose ρ₂ hρ₂ using fun w => exists_reduced N w
  let := midLeftModelPolModule hR
  have := midLeftModel_finite (ρ₃ := ρ₃) hR hQ hρ₂ hρ₃ hfin
  have hΘ := midThetaBlock_surjective hR ρ₃ hρ₃ hP hκ
  have hΦ := midLeftSplit_surjective (Q := Q) (Λ := Λ) (Λc := Λc) (hj := hj) (L := L) ρ₁ hρ₁ hL
    hQ hρ₂ hρ₃
  let f : MidLeftModel L hL hR →ₗ[P] MidLeftModel L hL hR :=
    { toFun := fun y => midThetaBlock L hL ρ₃ hR
        (midLeftSplit (Q := Q) (Λ := Λ) L ρ₁ hQ hρ₂ hρ₃ y)
      map_add' := fun y y' => by rw [map_add, map_add]
      map_smul' := fun p y => by
        change midThetaBlock L hL ρ₃ hR (midLeftSplit (Q := Q) (Λ := Λ) L ρ₁ hQ hρ₂ hρ₃
          (midLeftAlg L hL hR (polT Q Λ ν p) y)) = polT Q Λ ν p • _
        rw [midLeftSplit_polT_smul ρ₁ (fun w => (hρ₁ w).2) hR, map_smul] }
  have hf : Function.Injective f :=
    OrzechProperty.injective_of_surjective_endomorphism f (hΘ.comp hΦ)
  refine ⟨fun x x' h => ?_, hΘ⟩
  obtain ⟨y, rfl⟩ := hΦ x
  obtain ⟨y', rfl⟩ := hΦ x'
  exact congrArg _ (hf h)

end Categorification.Stendhal.CupCap
