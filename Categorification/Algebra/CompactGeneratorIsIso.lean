import DG.Compact.Generation

/-!
# Natural transformations that are isomorphisms on a compact generator

Let `C` be a triangulated category with coproducts, compactly generated by a family `G`, and let
`η : F ⟶ F'` be a natural transformation, compatible with the shifts, between triangulated
functors to a pretriangulated category which preserve coproducts. If every `η_{G i}` is an
isomorphism, then `η` is an isomorphism (`Categorification.isIso_of_compactlyGenerates`).

The objects `X` with `η_X` invertible are closed under shifts, isomorphisms, coproducts and
cones. Every object `X` is the homotopy colimit of its cellular tower (`DG.CellTower.tower`),
whose stages are built from coproducts of shifted generators by cones; this is the first step of
the proof of `DG.thickClosure_of_isCompact`.

This is used for B. Webster, *Knot invariants and higher representation theory*,
arXiv:1309.3796v3, Lemma 6.12 (`𝔅_w ≅ 𝔅_{w sᵢ} ⊗ 𝔅_i`), to compare derived tensor products on
the derived category of a ring, which is generated by the ring.
-/

universe w v v' u u'

namespace Categorification

open CategoryTheory Limits Pretriangulated ZeroObject DG DG.CellTower

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  {D : Type u'} [Category.{v'} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
  {F F' : C ⥤ D} [F.CommShift ℤ] [F'.CommShift ℤ] (η : F ⟶ F') [NatTrans.CommShift η ℤ]

/-- The morphism of triangles `F(T) ⟶ F'(T)` given by a natural transformation compatible with
the shifts. -/
@[simps]
def natTransMapTriangle (T : Triangle C) : F.mapTriangle.obj T ⟶ F'.mapTriangle.obj T where
  hom₁ := η.app T.obj₁
  hom₂ := η.app T.obj₂
  hom₃ := η.app T.obj₃
  comm₁ := by simp
  comm₂ := by simp
  comm₃ := by
    simp only [Functor.mapTriangle_obj, Triangle.mk_obj₃, Triangle.mk_obj₁, Triangle.mk_mor₃,
      Category.assoc, NatTrans.shift_app_comm η (1 : ℤ) T.obj₁, NatTrans.naturality_assoc]

omit [Preadditive C] [HasZeroObject C] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] [Preadditive D] [HasZeroObject D] [∀ n : ℤ, (shiftFunctor D n).Additive]
  [Pretriangulated D] in
theorem isIso_app_shift {X : C} (hX : IsIso (η.app X)) (n : ℤ) : IsIso (η.app (X⟦n⟧)) := by
  have h := NatTrans.shift_app_comm η n X
  have : IsIso (η.app (X⟦n⟧) ≫ (F'.commShiftIso n).hom.app X) := by
    rw [← h]
    infer_instance
  exact IsIso.of_isIso_comp_right _ ((F'.commShiftIso n).hom.app X)

omit [Preadditive C] [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [F.CommShift ℤ] [F'.CommShift ℤ]
  [NatTrans.CommShift η ℤ] in
theorem isIso_app_of_iso {X Y : C} (e : X ≅ Y) (hX : IsIso (η.app X)) : IsIso (η.app Y) := by
  have h : η.app Y = F.map e.inv ≫ η.app X ≫ F'.map e.hom := by
    rw [← η.naturality, ← Category.assoc, ← F.map_comp, e.inv_hom_id, F.map_id,
      Category.id_comp]
  rw [h]
  infer_instance

variable [F.IsTriangulated] [F'.IsTriangulated] in
theorem isIso_app_obj₃ {T : Triangle C} (hT : T ∈ distTriang C) (h₁ : IsIso (η.app T.obj₁))
    (h₂ : IsIso (η.app T.obj₂)) : IsIso (η.app T.obj₃) :=
  isIso₃_of_isIso₁₂ (natTransMapTriangle η T) (F.map_distinguished T hT)
    (F'.map_distinguished T hT) h₁ h₂

omit [Preadditive C] [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [F.CommShift ℤ] [F'.CommShift ℤ]
  [NatTrans.CommShift η ℤ] in
theorem isIso_app_sigma {J : Type*} (X : J → C) [HasCoproduct X]
    [PreservesColimit (Discrete.functor X) F] [PreservesColimit (Discrete.functor X) F']
    (h : ∀ j, IsIso (η.app (X j))) : IsIso (η.app (∐ X)) := by
  let c := colimit.cocone (Discrete.functor X)
  let hc : IsColimit c := colimit.isColimit _
  let hF := isColimitOfPreserves F hc
  let hF' := isColimitOfPreserves F' hc
  let e : Discrete.functor X ⋙ F ≅ Discrete.functor X ⋙ F' :=
    Discrete.natIso fun j => asIso (η.app (X j.as))
  have : η.app (∐ X) = (IsColimit.coconePointsIsoOfNatIso hF hF' e).hom := by
    refine hF.hom_ext fun j => ?_
    rw [IsColimit.comp_coconePointsIsoOfNatIso_hom]
    obtain ⟨j⟩ := j
    simp [e, c]
  rw [this]
  infer_instance

section Generation

variable [IsTriangulated C] {ι : Type w} {G : ι → C} [HasCoproducts.{max w v} C]

omit [HasZeroObject C] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  [IsTriangulated C] in
/-- Every object of a compactly generated triangulated category is the homotopy colimit of its
cellular tower (first step of the proof of `DG.thickClosure_of_isCompact`). -/
theorem exists_isIso_hocolim_tower [HasZeroObject C] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] [IsTriangulated C] (hG : CompactlyGenerates G) (X : C) :
    haveI : HasCoproducts.{0} C := hasCoproducts_shrink.{0, max w v}
    ∃ h : hocolim (fun n => (tower G X n).left) (towerMap G X) ⟶ X, IsIso h := by
  have : HasCoproducts.{0} C := hasCoproducts_shrink.{0, max w v}
  let P : ℕ → C := fun n => (tower G X n).left
  let H := hocolim P (towerMap G X)
  obtain ⟨h, hh⟩ := hocolim_exists_desc P (towerMap G X) (fun n => (tower G X n).hom)
    (towerMap_comp_hom G)
  have hcpt : ∀ (i : ι) (m : ℤ), IsCompact.{0} ((G i)⟦m⟧) :=
    fun i m => ((hG.isCompact i).shift m).down
  have inj : ∀ (i : ι) (m : ℤ) (a : (G i)⟦m⟧ ⟶ H), a ≫ h = 0 → a = 0 := by
    intro i m a ha
    obtain ⟨k, b, rfl⟩ := hocolim_exists_factor P (towerMap G X) (hcpt i m) a
    have hb : b ≫ (tower G X k).hom = 0 := by rw [← hh k, ← Category.assoc, ha]
    rw [← f_comp_hocolimι, ← Category.assoc, comp_towerMap_eq_zero G b hb, Limits.zero_comp]
  obtain ⟨Z, g₂, g₃, hT⟩ := distinguished_cocone_triangle h
  have hZ : IsZero Z := by
    refine hG.isZero_of_forall_eq_zero Z fun i m φ => ?_
    let adj : shiftFunctor C (-1 : ℤ) ⊣ shiftFunctor C (1 : ℤ) :=
      (shiftEquiv C (1 : ℤ)).symm.toAdjunction
    have h₁ : φ ≫ g₃ = 0 := by
      have h₃₁ : g₃ ≫ h⟦(1 : ℤ)⟧' = 0 := comp_distTriang_mor_zero₃₁ _ hT
      set ψ := (adj.homEquiv _ _).symm (φ ≫ g₃)
      have hψ : ψ ≫ h = 0 := by
        apply (adj.homEquiv _ _).injective
        rw [adj.homEquiv_naturality_right, Equiv.apply_symm_apply, Category.assoc, h₃₁,
          Limits.comp_zero, Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
      let e := (shiftFunctorAdd' C m (-1) (m + -1) rfl).app (G i)
      have : e.hom ≫ ψ = 0 := inj i (m + -1) _ (by rw [Category.assoc, hψ, Limits.comp_zero])
      rw [← Equiv.apply_symm_apply (adj.homEquiv _ _) (φ ≫ g₃)]
      change adj.homEquiv _ _ ψ = 0
      rw [(cancel_epi e.hom).1 (this.trans (Limits.comp_zero).symm), Adjunction.homEquiv_unit,
        Functor.map_zero, Limits.comp_zero]
    obtain ⟨x, rfl⟩ := Triangle.coyoneda_exact₃ _ hT φ h₁
    obtain ⟨y, rfl⟩ := exists_lift_base G x
    have h₁₂ : h ≫ g₂ = 0 := comp_distTriang_mor_zero₁₂ _ hT
    change (y ≫ (tower G X 0).hom) ≫ g₂ = 0
    rw [← hh 0, Category.assoc, Category.assoc, h₁₂, Limits.comp_zero, Limits.comp_zero]
  exact ⟨h, (Triangle.isZero₃_iff_isIso₁ _ hT).1 hZ⟩

variable [F.IsTriangulated] [F'.IsTriangulated]
  [∀ J : Type (max w v), PreservesColimitsOfShape (Discrete J) F]
  [∀ J : Type (max w v), PreservesColimitsOfShape (Discrete J) F']
  [PreservesColimitsOfShape (Discrete ℕ) F] [PreservesColimitsOfShape (Discrete ℕ) F']

/-- **A natural transformation which is invertible on a compact generator is invertible.** Let
`C` be triangulated with coproducts and compactly generated by `G`, and let `η : F ⟶ F'` be a
natural transformation compatible with the shifts between triangulated functors which preserve
coproducts. If every `η_{G i}` is invertible, so is `η`. -/
theorem isIso_of_compactlyGenerates (hG : CompactlyGenerates G) (hη : ∀ i, IsIso (η.app (G i))) :
    IsIso η := by
  have : HasCoproducts.{0} C := hasCoproducts_shrink.{0, max w v}
  suffices h : ∀ X, IsIso (η.app X) from NatIso.isIso_of_isIso_app η
  intro X
  have htower : ∀ n, IsIso (η.app (tower G X n).left) := by
    intro n
    induction n with
    | zero =>
      change IsIso (η.app (∐ fun c : Cells G X => (G c.1)⟦c.2.1⟧))
      exact isIso_app_sigma η _ fun c => isIso_app_shift η (hη c.1) c.2.1
    | succ n ih =>
      have hT := nextTriangle_distinguished G (tower G X n)
      exact isIso_app_obj₃ η hT
        (isIso_app_sigma η _ fun c => isIso_app_shift η (hη c.1) c.2.1) ih
  have hsum : IsIso (η.app (∐ fun n => (tower G X n).left)) :=
    isIso_app_sigma η _ htower
  have hH : IsIso (η.app (hocolim (fun n => (tower G X n).left) (towerMap G X))) :=
    isIso_app_obj₃ η (hocolimTriangle_distinguished _ (towerMap G X)) hsum hsum
  obtain ⟨h, hh⟩ := exists_isIso_hocolim_tower hG X
  exact isIso_app_of_iso η (asIso h) hH

end Generation

end Categorification
