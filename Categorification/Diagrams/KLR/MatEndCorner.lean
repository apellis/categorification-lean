import Categorification.Diagrams.KLR.MatEndMap
import Categorification.Diagrams.KL3.Karoubi
import Categorification.Algebra.HomTensorInd

/-!
# The corner of a matrix map along a functor

Let `F : C ⥤ D` be additive, `X : ι → C` and `Y : κ → D` finite families and `e : ι → κ`
injective with `F (X i) = Y (e i)`, and let `φ = MatEnd.mapEmb` be the matrix map of `F`
along `e`. The left ideal of `MatEnd Y` cut out by `φ(1)` consists of the matrices whose
columns lie in the image of `e`; it is identified with the morphisms from the sum of `Y` to
the image under `F` of the sum of `X` (`cornerEquiv`), compatibly with the two matrix actions.
With `HomTensor.indEquiv` this identifies `Hom(⊕ Y, F M)` with the induction of
`Hom(⊕ X, M)` along `φ` for every object `M` generated by `⊕ X` (`indEquivKaroubi`).

This is the comparison of a functor on a categorical module with induction along its
matrix map, used for the action of `Fᵢ` in Webster, *Knot invariants and higher
representation theory*, arXiv:1309.3796v3, §5.
-/

noncomputable section

namespace Categorification.KLR.Diagram

open CategoryTheory CategoryTheory.Idempotents Preadditive MulOpposite InductionAlong

namespace MatEnd

section Family

variable {D : Type*} [Category D] [Preadditive D] {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- A finite family as an object of the additive envelope. Its indexing type in `Mat_` is
small even if the family is indexed in a larger universe. -/
def familySum (X : ι → D) : Mat_ D :=
  ⟨Fin (Fintype.card ι), fun i => X ((Fintype.equivFin ι).symm i)⟩

/-- Rectangular matrices of morphisms as morphisms between family sums. -/
def toFamilyHom (Y : κ → D) (Z : ι → D) :
    (∀ a b, Y a ⟶ Z b) ≃+ (familySum Y ⟶ familySum Z) :=
  { (Equiv.piCongrLeft' (fun a => ∀ b, Y a ⟶ Z b) (Fintype.equivFin κ)).trans
      (Equiv.piCongrRight fun a =>
        Equiv.piCongrLeft' (fun b => Y ((Fintype.equivFin κ).symm a) ⟶ Z b)
          (Fintype.equivFin ι)) with
    map_add' := fun _ _ => rfl }

theorem toFamilyHom_apply (Y : κ → D) (Z : ι → D) (R : ∀ a b, Y a ⟶ Z b) (a b) :
    toFamilyHom Y Z R a b = R ((Fintype.equivFin κ).symm a) ((Fintype.equivFin ι).symm b) :=
  rfl

theorem toFamilyHom_comp {μ : Type*} [Fintype μ] (Y : κ → D) (Z : ι → D) (W : μ → D)
    (R : ∀ a b, Y a ⟶ Z b) (S : ∀ b c, Z b ⟶ W c) :
    toFamilyHom Y Z R ≫ toFamilyHom Z W S = toFamilyHom Y W (fun a c => ∑ b, R a b ≫ S b c) :=
  funext fun a => funext fun c =>
    Equiv.sum_comp (Fintype.equivFin ι).symm
      (fun b => R ((Fintype.equivFin κ).symm a) b ≫ S b ((Fintype.equivFin μ).symm c))

variable [DecidableEq ι]

/-- The matrix ring of a finite family is the endomorphism ring of its sum. -/
def familyMatrixEquiv (X : ι → D) : MatEnd X ≃+* End (familySum X) :=
  { toFamilyHom X X with
    map_mul' := fun f g => (toFamilyHom_comp X X X g f).symm }

theorem familyMatrixEquiv_apply (X : ι → D) (f : MatEnd X) :
    familyMatrixEquiv X f = toFamilyHom X X f :=
  rfl

/-- Each member of a finite family is a retract of the sum. -/
def summandRetract (X : ι → D) (i : ι) :
    Retract ((Mat_.embedding D).obj (X i)) (familySum X) := by
  let M := familySum X
  let j := Fintype.equivFin ι i
  have h : X i = M.X j := congrArg X ((Fintype.equivFin ι).symm_apply_apply i).symm
  let emb := Mat_.embedding D
  let f := fun j => emb.obj (M.X j)
  let r : Retract (f j) (⨁ f) :=
    ⟨Limits.biproduct.ι f j, Limits.biproduct.π f j, Limits.biproduct.ι_π_self f j⟩
  exact ((Retract.ofIso (eqToIso (congrArg emb.obj h))).trans r).trans
    (Retract.ofIso (Mat_.isoBiproductEmbedding M).symm)

end Family

section Corner

universe w v

variable {C : Type*} [Category.{v} C] [Preadditive C] {D : Type*} [Category.{v} D]
  [Preadditive D] {ι κ : Type w} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
  {X : ι → C} {Y : κ → D} (F : C ⥤ D) [F.Additive] {e : ι → κ}
  (he : Function.Injective e) (h : ∀ i, F.obj (X i) = Y (e i))

/-- The matrix map of `F` along `e`, on opposite rings. -/
def mapEmbOp : (MatEnd X)ᵐᵒᵖ →ₙ+* (MatEnd Y)ᵐᵒᵖ :=
  NonUnitalRingHom.op
    { toFun := mapEmb F h
      map_zero' := mapEmb_zero F h
      map_add' := mapEmb_add F h
      map_mul' := mapEmb_mul F he h }

theorem mapEmbOp_apply (f : (MatEnd X)ᵐᵒᵖ) : (mapEmbOp F he h f).unop = mapEmb F h f.unop :=
  rfl

omit [DecidableEq ι] [F.Additive] in
include he in
theorem sum_emb {M : Type*} [AddCommMonoid M] (f : κ → M)
    (hf : ∀ c, (∀ i, e i ≠ c) → f c = 0) :
    ∑ c, f c = ∑ i, f (e i) := by
  classical
  rw [← Finset.sum_subset (Finset.subset_univ (Finset.univ.image e)) (fun c _ hc => hf c
      (fun i hi => hc (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, hi⟩))),
    Finset.sum_image (fun i _ j _ hij => he hij)]

omit [Preadditive C] [DecidableEq ι] [F.Additive] in
include he in
theorem mapEmb_mul_apply_emb (f : MatEnd X) (g : MatEnd Y) (a : κ) (i : ι) :
    (mapEmb F h f * g) a (e i) = ∑ j, g a (e j) ≫ conjF F h (f j i) := by
  rw [mul_apply]
  refine (sum_emb he (fun c => g a c ≫ mapEmb F h f c (e i)) fun c hc => ?_).trans
    (Finset.sum_congr rfl fun j _ => ?_)
  · change g a c ≫ mapEmb F h f c (e i) = 0
    rw [mapEmb_apply_of_left F h hc, Limits.comp_zero]
  · rw [mapEmb_apply_emb F he h]

omit [F.Additive] in
theorem mapEmb_one_mul_apply_of_right (g : MatEnd Y) {b : κ} (hb : ∀ i, e i ≠ b) (a : κ) :
    (mapEmb F h 1 * g) a b = 0 := by
  rw [mul_apply]
  exact Finset.sum_eq_zero fun c _ => by rw [mapEmb_apply_of_right F h hb, Limits.comp_zero]

include he in
theorem mapEmb_one_mul_apply_emb (g : MatEnd Y) (a : κ) (i : ι) :
    (mapEmb F h 1 * g) a (e i) = g a (e i) := by
  rw [mapEmb_mul_apply_emb F he h, Finset.sum_eq_single i]
  · rw [one_apply_self, conjF_id, Category.comp_id]
  · intro j _ hj
    rw [one_apply_of_ne hj, conjF_zero, Limits.comp_zero]
  · simp

/-- The rectangular matrix of a corner element: its columns in the image of `e`. -/
def cornerRect (z : Corner (mapEmbOp F he h)) (a : κ) (i : ι) : Y a ⟶ F.obj (X i) :=
  z.1.unop a (e i) ≫ eqToHom (h i).symm

/-- The corner element of a rectangular matrix. -/
def rectCorner (R : ∀ a i, Y a ⟶ F.obj (X i)) : MatEnd Y :=
  ∑ a, ∑ i, single a (e i) (R a i ≫ eqToHom (h i))

omit [F.Additive] [Preadditive C] [DecidableEq ι] in
include he in
theorem rectCorner_apply_emb (R : ∀ a i, Y a ⟶ F.obj (X i)) (a : κ) (i : ι) :
    rectCorner F h R a (e i) = R a i ≫ eqToHom (h i) := by
  rw [rectCorner, sum_apply, Finset.sum_eq_single a, sum_apply, Finset.sum_eq_single i,
    single_apply_self]
  · intro j _ hj
    exact single_apply_of_ne _ (fun h' => hj (he h'.2.symm))
  · simp
  · intro a' _ ha'
    rw [sum_apply]
    exact Finset.sum_eq_zero fun j _ => single_apply_of_ne _ (fun h' => ha' h'.1.symm)
  · simp

omit [F.Additive] [Preadditive C] [DecidableEq ι] in
theorem rectCorner_apply_of_right (R : ∀ a i, Y a ⟶ F.obj (X i)) {b : κ}
    (hb : ∀ i, e i ≠ b) (a : κ) : rectCorner F h R a b = 0 := by
  rw [rectCorner, sum_apply]
  exact Finset.sum_eq_zero fun a' _ => by
    rw [sum_apply]
    exact Finset.sum_eq_zero fun j _ => single_apply_of_ne _ (fun h' => hb j h'.2.symm)

theorem rectCorner_mem (R : ∀ a i, Y a ⟶ F.obj (X i)) :
    op (rectCorner F h R) ∈ lIdeal (mapEmbOp F he h 1) := by
  change op (rectCorner F h R) * mapEmbOp F he h 1 = op (rectCorner F h R)
  apply unop_injective
  change mapEmb F h 1 * rectCorner F h R = rectCorner F h R
  funext a b
  by_cases hb : ∃ i, e i = b
  · obtain ⟨i, rfl⟩ := hb
    exact mapEmb_one_mul_apply_emb F he h _ a i
  · push Not at hb
    rw [mapEmb_one_mul_apply_of_right F h _ hb, rectCorner_apply_of_right F h _ hb]

/-- The corner of the matrix map is the rectangular matrices `Y a ⟶ F (X i)`. -/
def cornerEquiv : Corner (mapEmbOp F he h) ≃+ (∀ a i, Y a ⟶ F.obj (X i)) where
  toFun := cornerRect F he h
  invFun R := ⟨op (rectCorner F h R), rectCorner_mem F he h R⟩
  left_inv z := by
    apply Subtype.ext
    apply unop_injective
    have hz : mapEmb F h 1 * z.1.unop = z.1.unop := congrArg unop z.2
    funext a b
    change rectCorner F h (cornerRect F he h z) a b = z.1.unop a b
    by_cases hb : ∃ i, e i = b
    · obtain ⟨i, rfl⟩ := hb
      rw [rectCorner_apply_emb F he h, cornerRect, Category.assoc, eqToHom_trans, eqToHom_refl,
        Category.comp_id]
    · push Not at hb
      rw [rectCorner_apply_of_right F h _ hb, ← hz, mapEmb_one_mul_apply_of_right F h _ hb]
  right_inv R := by
    funext a i
    change (rectCorner F h R a (e i)) ≫ _ = R a i
    rw [rectCorner_apply_emb F he h, Category.assoc, eqToHom_trans, eqToHom_refl,
      Category.comp_id]
  map_add' _ _ := by
    funext a i
    exact Preadditive.add_comp _ _ _ _ _ _

theorem cornerEquiv_apply (z : Corner (mapEmbOp F he h)) (a : κ) (i : ι) :
    cornerEquiv F he h z a i = z.1.unop a (e i) ≫ eqToHom (h i).symm :=
  rfl

/-- The right action of `MatEnd X` on the corner is postcomposition with `F`. -/
theorem cornerEquiv_op_smul (m : (MatEnd X)ᵐᵒᵖ) (z : Corner (mapEmbOp F he h)) (a : κ)
    (i : ι) :
    cornerEquiv F he h (op m • z) a i =
      ∑ j, cornerEquiv F he h z a j ≫ F.map (m.unop j i) := by
  rw [cornerEquiv_apply]
  change (mapEmb F h m.unop * z.1.unop) a (e i) ≫ _ = _
  rw [mapEmb_mul_apply_emb F he h, Preadditive.sum_comp]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [cornerEquiv_apply, conjF, Category.assoc, eqToHom_trans, eqToHom_refl,
    Category.comp_id]

/-- The left action of `MatEnd Y` on the corner is precomposition. -/
theorem cornerEquiv_smul (b : (MatEnd Y)ᵐᵒᵖ) (z : Corner (mapEmbOp F he h)) (a : κ)
    (i : ι) :
    cornerEquiv F he h (b • z) a i = ∑ c, b.unop a c ≫ cornerEquiv F he h z c i := by
  rw [cornerEquiv_apply]
  change (z.1.unop * b.unop) a (e i) ≫ _ = _
  rw [mul_apply, Preadditive.sum_comp]
  simp only [cornerEquiv_apply, Category.assoc]

/-- Endomorphisms of an object and of its image in the idempotent completion. -/
def karoubiEndEquiv (O : D) : End ((toKaroubi D).obj O) ≃+* End O where
  toFun f := f.f
  invFun g := (toKaroubi D).map g
  left_inv _ := Karoubi.hom_ext _ _ rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

/-- Morphisms into the image of an object under the functor induced on idempotent
completions. -/
def karoubiHomEquiv (O' : D) (O : C) :
    ((toKaroubi D).obj O' ⟶ (mapKaroubi F).obj ((toKaroubi C).obj O)) ≃+ (O' ⟶ F.obj O) where
  toFun f := f.f
  invFun g := ⟨g, by
    change 𝟙 _ ≫ g ≫ F.map (𝟙 O) = g
    rw [F.map_id, Category.id_comp, Category.comp_id]⟩
  left_inv _ := Karoubi.hom_ext _ _ rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

variable (X Y) in
/-- The matrix ring of `X` as the opposite endomorphism ring of the completed sum. -/
def karoubiMatrixOp : (MatEnd X)ᵐᵒᵖ ≃+* (End ((toKaroubi _).obj (familySum X)))ᵐᵒᵖ :=
  RingEquiv.op ((familyMatrixEquiv X).trans (karoubiEndEquiv (familySum X)).symm)

variable (Y) in
/-- The matrix ring of `Y` as the opposite endomorphism ring of the completed sum. -/
def karoubiMatrixOpY : (MatEnd Y)ᵐᵒᵖ ≃+* (End ((toKaroubi _).obj (familySum Y)))ᵐᵒᵖ :=
  RingEquiv.op ((familyMatrixEquiv Y).trans (karoubiEndEquiv (familySum Y)).symm)

/-- The corner of the matrix map as morphisms of completed sums. -/
def karoubiCorner : Corner (mapEmbOp F he h) ≃+
    ((toKaroubi _).obj (familySum Y) ⟶
      (mapKaroubi F.mapMat_).obj ((toKaroubi _).obj (familySum X))) :=
  ((cornerEquiv F he h).trans (toFamilyHom Y (fun i => F.obj (X i)))).trans
    (karoubiHomEquiv F.mapMat_ (familySum Y) (familySum X)).symm

theorem karoubiCorner_op_smul (m : (MatEnd X)ᵐᵒᵖ) (z : Corner (mapEmbOp F he h)) :
    karoubiCorner F he h (op m • z) =
      karoubiCorner F he h z ≫ (mapKaroubi F.mapMat_).map (karoubiMatrixOp X m).unop := by
  apply Karoubi.hom_ext
  change toFamilyHom Y _ (cornerEquiv F he h (op m • z)) =
    toFamilyHom Y _ (cornerEquiv F he h z) ≫
      toFamilyHom (fun i => F.obj (X i)) (fun i => F.obj (X i)) (fun i j => F.map (m.unop i j))
  rw [toFamilyHom_comp]
  congr 1
  funext a i
  exact cornerEquiv_op_smul F he h m z a i

theorem karoubiCorner_smul (b : (MatEnd Y)ᵐᵒᵖ) (z : Corner (mapEmbOp F he h)) :
    karoubiCorner F he h (b • z) = (karoubiMatrixOpY Y b).unop ≫ karoubiCorner F he h z := by
  apply Karoubi.hom_ext
  change toFamilyHom Y _ (cornerEquiv F he h (b • z)) =
    toFamilyHom Y Y (fun a c => b.unop a c) ≫ toFamilyHom Y _ (cornerEquiv F he h z)
  rw [toFamilyHom_comp]
  congr 1
  funext a i
  exact cornerEquiv_smul F he h b z a i

variable {M : Karoubi (Mat_ C)} {J : Type*} [Fintype J]
  (π : J → (M ⟶ (toKaroubi _).obj (familySum X)))
  (ι' : J → ((toKaroubi _).obj (familySum X) ⟶ M))
  (hπ : ∑ j, π j ≫ ι' j = 𝟙 M)

/-- **Functors on a generated object as inductions along their matrix maps**: if `M` is
generated by the sum of `X`, then `Hom(⊕ Y, F M)` is the induction of `Hom(⊕ X, M)` along the
matrix map of `F`. -/
def indEquivKaroubi :
    letI := HomTensor.homModule _ (karoubiMatrixOp X) M
    Ind (((toKaroubi _).obj (familySum X)) ⟶ M) (mapEmbOp F he h) ≃+
      ((toKaroubi _).obj (familySum Y) ⟶ (mapKaroubi F.mapMat_).obj M) :=
  HomTensor.indEquiv (karoubiCorner F he h) (karoubiCorner_op_smul F he h) π ι' hπ

theorem indEquivKaroubi_tmul (z : Corner (mapEmbOp F he h))
    (f : (toKaroubi _).obj (familySum X) ⟶ M) :
    letI := HomTensor.homModule _ (karoubiMatrixOp X) M
    indEquivKaroubi F he h π ι' hπ (Ind.tmul z f) =
      karoubiCorner F he h z ≫ (mapKaroubi F.mapMat_).map f :=
  rfl

theorem indEquivKaroubi_smul (b : (MatEnd Y)ᵐᵒᵖ)
    (t : letI := HomTensor.homModule _ (karoubiMatrixOp X) M
      Ind (((toKaroubi _).obj (familySum X)) ⟶ M) (mapEmbOp F he h)) :
    indEquivKaroubi F he h π ι' hπ (b • t) =
      (karoubiMatrixOpY Y b).unop ≫ indEquivKaroubi F he h π ι' hπ t :=
  HomTensor.indEquiv_smul _ _ π ι' hπ _ (karoubiCorner_smul F he h) b t

end Corner

end MatEnd

end Categorification.KLR.Diagram
