abbrev coprodKL : (Gkl).K0R →ₗ[LP] (Gkl).K0R ⊗[LP] (Gkl).K0R :=
  (Gkl).coprod (klQ_eq_klP (Γ := Γ) KL1.stdOrient_spec) (fun a b _ => KL1.klP_ne_zero _ a b)
    KL1.klGradingDatum_degX_pos

/-- **Every class is a `ℤ[q, q⁻¹]`-torsion multiple of an element of `γ('f_{ℤ[q,q⁻¹]})`**: for
`x ∈ K₀(R)` there is `p ≠ 0` with `p x = γ(y)`. (The divided-power classes span `K₀(R)`, KL I
Proposition 3.20, and `[P_î] = î! [P_i]`.) -/
theorem exists_smul_mem_range_gammaZ (x : (Gkl).K0R) :
    ∃ p : LP, p ≠ 0 ∧ ∃ y : PreF LP I, gammaZ k Γ y = p • x := by
  classical
  let S : Submodule LP (Gkl).K0R :=
    { carrier := {x | ∃ p : LP, p ≠ 0 ∧ ∃ y : PreF LP I, gammaZ k Γ y = p • x}
      add_mem' := by
        rintro x x' ⟨p, hp, y, hy⟩ ⟨p', hp', y', hy'⟩
        refine ⟨p * p', mul_ne_zero hp hp', p' • y + p • y', ?_⟩
        rw [map_add, map_smul, map_smul, hy, hy', smul_smul, smul_smul, smul_add, mul_comm p' p]
      zero_mem' := ⟨1, one_ne_zero, 0, by rw [map_zero, smul_zero]⟩
      smul_mem' := by
        rintro c x ⟨p, hp, y, hy⟩
        exact ⟨p, hp, c • y, by rw [map_smul, hy, smul_comm]⟩ }
  have hdiv : ∀ (ν : Multiset I) (d : List (I × ℕ)) (h : (expandDiv d : Multiset I) = ν),
      DirectSum.of (Gkl).K0fam ν (K0.of (projDiv k Γ d h)) ∈ S := by
    intro ν d h
    refine ⟨divQFactLP d, fun h0 => qToV_divQFactLP_ne_zero d (by rw [h0, map_zero]),
      word (FreeMonoid.ofList (expandDiv d)), ?_⟩
    rw [gammaZ_word, FreeMonoid.toList_ofList, clsSeq_expandDiv, clsDiv_eq k Γ d h]
  have hb : ∀ (ν : Multiset I) (b : GProj.IndecClass ((Gkl).grade ν)),
      DirectSum.of (Gkl).K0fam ν (k0B k Γ ν b) ∈ S := by
    intro ν b
    have hle : Submodule.span LP
        {z | ∃ (d : List (I × ℕ)) (h : (expandDiv d : Multiset I) = ν),
          z = K0.of (projDiv k Γ d h)} ≤
        S.comap (DirectSum.lof LP (Multiset I) (Gkl).K0fam ν) := by
      rw [Submodule.span_le]
      rintro _ ⟨d, h, rfl⟩
      show DirectSum.lof LP (Multiset I) (Gkl).K0fam ν _ ∈ S
      rw [DirectSum.lof_eq_of]
      exact hdiv ν d h
    have := hle (k0B_mem_span_projDiv k Γ ν b)
    rwa [Submodule.mem_comap, DirectSum.lof_eq_of] at this
  have htop : S = ⊤ := by
    refine Submodule.eq_top_iff'.2 fun z => ?_
    induction z using DirectSum.induction_on with
    | zero => exact S.zero_mem
    | of ν x =>
      haveI := ((Gkl).finite_and_card_indecClass_le (klQ_eq_klP (Γ := Γ) KL1.stdOrient_spec)
        (fun a b _ => KL1.klP_ne_zero _ a b) KL1.klGradingDatum_degX_pos ν).1
      haveI := Fintype.ofFinite (GProj.IndecClass ((Gkl).grade ν))
      rw [← (k0B k Γ ν).sum_repr x, map_sum]
      refine S.sum_mem fun b _ => ?_
      rw [K0R_of_smul]
      exact S.smul_mem _ (hb ν b)
    | add x y hx hy => exact S.add_mem hx hy
  exact (htop ▸ Submodule.mem_top : x ∈ S)

