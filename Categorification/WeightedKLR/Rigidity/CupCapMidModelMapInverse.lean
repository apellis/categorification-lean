import Categorification.WeightedKLR.Rigidity.CupCapMidModelMapCross

/-!
# The inverse of the map from `K̃^{λ⁺}_λ` to the model of a cap after `λ_j`

Webster, arXiv:1309.3796v3, §7.3, proof of Lemma 7.17, for a cap inserted after the red strand
`λ_j`. The inverse of `CupCap.midCapToModel` sends `Z ⊗ v` to `∑_s cap(s, c, v) · Z`, where
`c = midPos j s` is the position of `λ_{j+1}` in `s`; the normalization of the cap generators in
`CupCap.midCapImage` makes the scalar `c(s, c)` equal to `1`. This file builds the inverse as a
map of bimodules. The left action of `T̃^λ` on the model is generated by the window idempotents,
the dots and the crossings of `λ` placed at the maximum (`CupCap.midIdem`, `CupCap.midDot`,
`CupCap.midCross`); each passes through the cap generators by the relations of Definition 7.15.
A crossing of `λ_{j+1}` with a black strand uses (max2) or (max1) to move the maximum off the
crossed strand; a crossing of `λ_{j+1}` with a red strand vanishes on both sides.

## Main definitions

* `CupCap.midGenCap`: the cap generator with the maximum at `midPos j s`.
* `CupCap.midModelToCap`: the bimodule map `MidModel → K̃^{λ⁺}_λ`,
  `Z ⊗ v ↦ ∑_s cap(s, midPos j s, v) · Z`.

## Main results

* `CupCap.sum_capElt_midIdem`, `CupCap.sum_capElt_midDot`, `CupCap.sum_capElt_midCross`: the
  generators of the left action pass through the cap generators.
* `CupCap.midModelToCapAdd_midLeftAlg`: the inverse commutes with the left action of `T̃^λ`.
-/

noncomputable section

namespace Categorification.Stendhal.CupCap

open KLR KLRAlgebra TypeA MulOpposite InductionAlong

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ} {j : ℕ} {hj : j ≤ ℓ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {Λc : Fin 2 → I →₀ ℕ}
  {ν ν₀ : Multiset I}
  {L : Type*} [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]

local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "N" => Multiset.card (stendhalWeight 2 ν₀)
local notation "Rp" =>
  KLRAlgebra k (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "Rλ" => KLRAlgebra k (stendhalQ Q Λ) (stendhalWeight ℓ ν)
local notation "Rc" => KLRAlgebra k (stendhalQ Q Λc) (stendhalWeight 2 ν₀)
local notation "T" => StendhalAlgebra k Q Λ ν
local notation "Tp" => StendhalAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀)
local notation "ι" => insertMap (j := j) (hj := hj) (ν₀ := ν₀) Q Λ Λc
local notation "E" s:max =>
  KLRAlgebra.eSum (stendhalQ Q (plusLabels Λ Λc j hj))
    (insertSet (j := j) (hj := hj) (ν₀ := ν₀) s (midPos j s) (midPos_le j s))
local notation "bot" => botMap k Q Λ Λc j hj ν ν₀
local notation "σ" => midStendhal j hj Q Λ Λc ν ν₀
local notation "Ev" => Env k Q Λ Λc j hj ν ν₀
local notation "K" => CapTilde k Q Λ Λc j hj ν ν₀ L

/-! ### The cap generators with the maximum at `midPos` -/

omit [DecidableEq I] in
variable (j) in
/-- The position `midPos j s` of the maximum, as a position for a cap generator. -/
abbrev midCPos (s : Seq (stendhalWeight ℓ ν)) : Fin (m + 1) :=
  ⟨midPos j s, Nat.lt_succ_of_le (midPos_le j s)⟩

local notation "cpos" s:max => midCPos j s

variable (j hj Q Λ Λc ν₀) in
/-- The cap generator with the maximum at `midPos j s`, just before the red strand `λ_{j+1}`. -/
def midGenCap (s : Seq (stendhalWeight ℓ ν)) (v : L) : K := capElt 1 s (cpos s) v 1

local notation "gC" => midGenCap j hj Q Λ Λc ν₀

theorem capElt_mid_eSum (a : T) (s : Seq (stendhalWeight ℓ ν)) (v : L) (b : Rp) :
    (capElt a s (cpos s) v b : K) = capElt a s (cpos s) v (E s * b) :=
  capElt_eq_eSum_mul a s _ v b

theorem capElt_fin_congr (a : T) (s : Seq (stendhalWeight ℓ ν)) (n n' : Fin (m + 1)) (v : L)
    (b : Rp) (h : n.val = n'.val) : (capElt a s n v b : K) = capElt a s n' v b := by
  rw [Fin.ext h]

theorem smul_midGenCap (a : T) (b : Rp) (s : Seq (stendhalWeight ℓ ν)) (v : L) :
    (Env.mk a (bot b) : Ev) • gC s v = capElt a s (cpos s) v b := by
  rw [midGenCap, smul_capElt, mul_one, one_mul]

theorem midGenCap_eq (s : Seq (stendhalWeight ℓ ν)) (v : L) :
    gC s v = (Env.mk 1 (bot (E s)) : Ev) • gC s v := by
  rw [smul_midGenCap, midGenCap, capElt_mid_eSum 1 s v 1, mul_one]

theorem smul_midGenCap_eSum (a : T) (Y : Tp) (s : Seq (stendhalWeight ℓ ν)) (v : L) :
    (Env.mk a Y : Ev) • gC s v = (Env.mk a (bot (E s) * Y) : Ev) • gC s v := by
  conv_lhs => rw [midGenCap_eq]
  rw [smul_smul, Env.mk_mul_mk, mul_one]

theorem smul_midGenCap_congr (a : T) {Y Y' : Tp} (s : Seq (stendhalWeight ℓ ν)) (v : L)
    (h : bot (E s) * Y = bot (E s) * Y') :
    (Env.mk a Y : Ev) • gC s v = (Env.mk a Y' : Ev) • gC s v := by
  rw [smul_midGenCap_eSum, h, ← smul_midGenCap_eSum]

theorem midGenCap_add (s : Seq (stendhalWeight ℓ ν)) (v w : L) :
    gC s (v + w) = gC s v + gC s w := by
  unfold midGenCap
  exact capElt_add_mid _ _ _ _ _ _

theorem midGenCap_box (s : Seq (stendhalWeight ℓ ν)) (v : L) (x : Rc) :
    gC s (op (cupMap k Q Λc ν₀ x) • v) =
      (Env.mk 1 (bot (ι s (midPos j s) (midPos_le j s) x)) : Ev) • gC s v := by
  rw [smul_midGenCap, midGenCap, capElt_box, mul_one]

/-! ### Diagrams at the maximum below the cap generators -/

theorem botMap_eSum_mul_midStendhal_one (s : Seq (stendhalWeight ℓ ν)) :
    bot (E s) * σ 1 = bot (E s) := by
  rw [midStendhal_one_eq_bot, ← map_mul, eSum_mul_midMapKLR, botMap_insertMap_redOrderedKLR]

theorem botMap_mul_eSum_mul_midStendhal_one (X : Rp) (s : Seq (stendhalWeight ℓ ν)) :
    bot (X * E s) * σ 1 = bot (X * E s) := by
  rw [map_mul, mul_assoc, botMap_eSum_mul_midStendhal_one]

theorem botMap_eSum_mul_midBot (s : Seq (stendhalWeight ℓ ν)) (x : Rc) :
    bot (E s) * midBot j hj Q Λ Λc ν ν₀ x = bot (ι s (midPos j s) (midPos_le j s) x) := by
  rw [midBot_apply, ← map_mul, eSum_mul_midMapKLR]

/-! ### The inverse on pure tensors -/

variable (j hj Q Λ Λc ν ν₀) in
/-- The inverse map on pure tensors: `Z ⊗ v ↦ ∑_s cap(s, midPos j s, v) · Z`. -/
def midInvFun (Z : Tp) (v : L) : K := ∑ s : Seq (stendhalWeight ℓ ν), (Env.mk 1 Z : Ev) • gC s v

local notation "invF" => midInvFun j hj Q Λ Λc ν ν₀

theorem midInvFun_add_left (Z Z' : Tp) (v : L) : invF (Z + Z') v = invF Z v + invF Z' v := by
  simp only [midInvFun, Env.mk_add_right, add_smul, Finset.sum_add_distrib]

theorem midInvFun_add_right (Z : Tp) (v w : L) : invF Z (v + w) = invF Z v + invF Z w := by
  simp only [midInvFun, midGenCap_add, smul_add, Finset.sum_add_distrib]

theorem midInvFun_balanced (Z : Tp) (x : Rc) (v : L) :
    invF (σ (cupMap k Q Λc ν₀ x) * Z) v = invF Z (op (cupMap k Q Λc ν₀ x) • v) := by
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [midGenCap_box, smul_smul, Env.mk_mul_mk, mul_one]
  refine smul_midGenCap_congr _ s v ?_
  rw [midStendhal_cupMap', ← mul_assoc, ← mul_assoc, botMap_eSum_mul_midStendhal_one,
    botMap_eSum_mul_midBot, ← mul_assoc, ← map_mul, eSum_mul_insertMap]

theorem midInvFun_smul (B Z : Tp) (v : L) :
    invF (Z * B) v = (Env.mk (1 : T) B : Ev) • invF Z v := by
  rw [midInvFun, midInvFun, Finset.smul_sum]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [smul_smul, Env.mk_mul_mk, one_mul]

theorem midInvFun_midStendhal_one (Z : Tp) (v : L) : invF (σ 1 * Z) v = invF Z v :=
  Finset.sum_congr rfl fun s _ => smul_midGenCap_congr _ s v (by
    rw [← mul_assoc, botMap_eSum_mul_midStendhal_one])

/-- A diagram `Y` acting on the left of the inverse map, given that it passes through the cap
generators as `g` does. -/
theorem midInvFun_botMap_mul {Y : Rp} {g : T}
    (hc : ∀ v : L, ∑ s : Seq (stendhalWeight ℓ ν), (capElt 1 s (cpos s) v Y : K) =
      ∑ s : Seq (stendhalWeight ℓ ν), capElt g s (cpos s) v 1) (Z : Tp) (v : L) :
    invF (bot Y * Z) v = (Env.mk g 1 : Ev) • invF Z v := by
  have e1 : ∀ s : Seq (stendhalWeight ℓ ν), (Env.mk 1 (bot Y * Z) : Ev) • gC s v =
      (Env.mk 1 Z : Ev) • capElt 1 s (cpos s) v Y := fun s => by
    rw [← smul_midGenCap, smul_smul, Env.mk_mul_mk, mul_one]
  have e2 : ∀ s : Seq (stendhalWeight ℓ ν), (Env.mk g 1 : Ev) • (Env.mk 1 Z : Ev) • gC s v =
      (Env.mk 1 Z : Ev) • capElt g s (cpos s) v 1 := fun s => by
    rw [← smul_midGenCap, smul_smul, smul_smul, Env.mk_mul_mk, Env.mk_mul_mk, map_one]
    simp only [mul_one, one_mul]
  rw [midInvFun, midInvFun, Finset.smul_sum, Finset.sum_congr rfl fun s _ => e1 s,
    Finset.sum_congr rfl fun s _ => e2 s, ← Finset.smul_sum, ← Finset.smul_sum, hc v]

/-! ### The inverse as an additive map -/

variable (j hj Q Λ Λc ν ν₀ L) in
/-- **The inverse of the map to the model of a cap after `λ_j`**, as an additive map. -/
def midModelToCapAdd : MidModel j hj Q Λ Λc ν ν₀ L →+ K :=
  Ind.liftAdd (fun z v => invF z.1.unop v)
    (fun _ _ v => midInvFun_add_left _ _ v)
    (fun _ v v' => midInvFun_add_right _ v v')
    (fun z a v => by
      obtain ⟨x, hx⟩ := cupMap_surjective (Q := Q) (Λc := Λc) (ν₀ := ν₀) a.unop
      change invF (σ a.unop * z.1.unop) v = _
      rw [← hx, midInvFun_balanced, hx, op_unop])

local notation "F" => midModelToCapAdd j hj Q Λ Λc ν ν₀ L

theorem midModelToCapAdd_tmul (z : Corner (midOp j hj Q Λ Λc ν ν₀)) (v : L) :
    F (Ind.tmul z v) = invF z.1.unop v := rfl

theorem midModelToCapAdd_tmul_midGen (Z : Tp) (v : L) :
    F (Ind.tmul (midGen j hj Q Λ Λc ν ν₀ Z) v) = invF Z v :=
  midInvFun_midStendhal_one Z v

theorem midGen_unop (z : Corner (midOp j hj Q Λ Λc ν ν₀)) :
    midGen j hj Q Λ Λc ν ν₀ z.1.unop = z := by
  apply Subtype.ext
  rw [midGen_val]
  exact (z.2 : op (σ 1 * z.1.unop) = z.1)

theorem midModelToCapAdd_op_smul (b : Tp) (y : MidModel j hj Q Λ Λc ν ν₀ L) :
    F ((op b : Tpᵐᵒᵖ) • y) = (Env.mk 1 b : Ev) • F y := by
  induction y using Ind.induction_on with
  | zero => rw [smul_zero, map_zero, smul_zero]
  | add y y' hy hy' => rw [smul_add, map_add, map_add, hy, hy', smul_add]
  | tmul z v =>
    rw [Ind.smul_tmul, midModelToCapAdd_tmul, midModelToCapAdd_tmul]
    exact midInvFun_smul b z.1.unop v

theorem midModelToCapAdd_algebraMap_smul (c : k) (y : MidModel j hj Q Λ Λc ν ν₀ L) :
    F (c • y) = (Env.mk (algebraMap k T c) 1 : Ev) • F y := by
  rw [midModel_algebraMap_smul, MulOpposite.algebraMap_apply, midModelToCapAdd_op_smul,
    Algebra.algebraMap_eq_smul_one (A := Tp) c, Env.mk_smul_right,
    Algebra.algebraMap_eq_smul_one (A := T) c]

variable {hL : ∀ (w : Seq (stendhalWeight 2 ν₀)) (v : L), ¬ IsCapGood ν₀ w →
    op (cupMap k Q Λc ν₀ (KLRAlgebra.e w)) • v = 0}

/-- A sliding diagram acting on the model passes through the inverse, given that it passes
through the cap generators as `g` does. -/
theorem midModelToCapAdd_midEnd {Y : Rp} (hY : MidSlides j hj Q Λ Λc ν ν₀ Y)
    (hσ : bot Y * σ 1 = bot Y) {g : T}
    (hc : ∀ v : L, ∑ s : Seq (stendhalWeight ℓ ν), (capElt 1 s (cpos s) v Y : K) =
      ∑ s : Seq (stendhalWeight ℓ ν), capElt g s (cpos s) v 1)
    (y : MidModel j hj Q Λ Λc ν ν₀ L) : F (midEnd L hL hY y) = (Env.mk g 1 : Ev) • F y := by
  induction y using Ind.induction_on with
  | zero => rw [map_zero, map_zero, smul_zero]
  | add y y' hy hy' => rw [map_add, map_add, hy, hy', map_add, smul_add]
  | tmul z v =>
    rw [← midGen_unop z, midEnd_tmul, midModelToCapAdd_tmul_midGen, midModelToCapAdd_tmul_midGen,
      hσ]
    exact midInvFun_botMap_mul hc _ v

/-! ### The generators of the left action pass through the cap generators -/

theorem sum_capElt_midIdem (t : Seq (stendhalWeight ℓ ν)) (v : L) :
    ∑ s : Seq (stendhalWeight ℓ ν), (capElt 1 s (cpos s) v (midIdem j hj Q Λ Λc ν ν₀ t) : K) =
      ∑ s : Seq (stendhalWeight ℓ ν), capElt (topMap k Q Λ ν (KLRAlgebra.e t)) s (cpos s) v 1 := by
  rw [Finset.sum_eq_single t (fun s _ hs => ?_) (by simp),
    Finset.sum_eq_single t (fun s _ hs => ?_) (by simp)]
  · have h := capElt_mid_eSum (Λc := Λc) (ν₀ := ν₀) (1 : T) t v (1 : Rp)
    rw [mul_one] at h
    have h2 := capElt_idem (Λc := Λc) (ν₀ := ν₀) (j := j) (hj := hj) (1 : T) t (cpos t) v 1
    rw [one_mul] at h2
    rw [midIdem, ← h, h2]
  · rw [← capElt_idem _ s, ← map_mul, KLRAlgebra.e_mul_e]
    simp [Ne.symm hs, capElt_zero_left]
  · rw [capElt_mid_eSum, midIdem, eSum_mid_mul_eSum_mid]
    simp [hs, capElt_zero_right]

theorem sum_capElt_midDot (a : Fin m) (v : L) :
    ∑ s : Seq (stendhalWeight ℓ ν), (capElt 1 s (cpos s) v (midDot j hj Q Λ Λc ν ν₀ a) : K) =
      ∑ s : Seq (stendhalWeight ℓ ν), capElt (topMap k Q Λ ν (KLRAlgebra.x a)) s (cpos s) v 1 := by
  refine Finset.sum_congr rfl fun s _ => ?_
  have h := capElt_dot (Λc := Λc) (ν₀ := ν₀) (j := j) (hj := hj) (1 : T) s (cpos s) v a 1
  rw [one_mul, mul_one] at h
  rw [h, capElt_mid_eSum 1 s v (midDot j hj Q Λ Λc ν ν₀ a), eSum_mul_midDot,
    (commute_x_eSum _ _).eq, ← capElt_mid_eSum]

theorem eSum_mul_midCross (s : Seq (stendhalWeight ℓ ν)) (p : ℕ) :
    E s * midCross j hj Q Λ Λc ν ν₀ p = midCrossAt j hj Q Λ Λc ν ν₀ (sadj m p • s) p := by
  rw [midCross, Finset.mul_sum, Finset.sum_eq_single (sadj m p • s) (fun t _ ht => ?_)
    (by simp)]
  · have h := eSum_mul_midCrossAt (j := j) (hj := hj) (Q := Q) (Λ := Λ) (Λc := Λc) (ν₀ := ν₀)
      (sadj m p • s) p
    rw [sadj_smul_sadj_smul] at h
    exact h
  · rw [← eSum_mul_midCrossAt t p, ← mul_assoc, eSum_mid_mul_eSum_mid]
    have : s ≠ sadj m p • t := fun h => ht (by rw [h, sadj_smul_sadj_smul])
    simp [this]

/-- Two red strands do not cross on the top of a cap generator. -/
theorem capElt_topMap_ψ_of_red (t : Seq (stendhalWeight ℓ ν)) {p : ℕ} (hp : p + 1 < m)
    (n : Fin (m + 1)) (v : L) (b : Rp) (h₁ : (t.lbl ⟨p, by omega⟩).isRight)
    (h₂ : (t.lbl ⟨p + 1, hp⟩).isRight) :
    (capElt (topMap k Q Λ ν (KLRAlgebra.ψ p)) t n v b : K) = 0 := by
  rw [← capElt_idem, ← map_mul, topMap, AlgHom.comp_apply, ofKLR_ψ_mul_e_of_red p hp t h₁ h₂,
    map_zero, capElt_zero_left]

omit [DecidableEq I] in
theorem lbl_midPos_isRight (t : Seq (stendhalWeight ℓ ν)) (h : midPos j t < m) :
    (t.lbl ⟨midPos j t, h⟩).isRight := by
  obtain ⟨a, ha, hla⟩ := midPos_of_lt j t (lt_of_midPos_lt j h le_rfl)
  have : (⟨midPos j t, h⟩ : Fin m) = a := Fin.ext ha.symm
  rw [this, hla]
  rfl

/-- (max1) at `q + 1`, with the position written as a successor. -/
theorem capElt_over_succ (a : T) (s : Seq (stendhalWeight ℓ ν)) (q : ℕ) (hq : q + 1 ≤ m)
    (v : L) (i : I) (hi : s.lbl ⟨q, by omega⟩ = .inl i) (b : Rp) :
    (capElt a s ⟨q + 1, by omega⟩ v (underRight N q * b) : K) =
      capElt (a * algebraMap k _ (cupScalar Q ν₀ i)) s ⟨q, by omega⟩ v b :=
  capElt_over a s ⟨q + 1, by omega⟩ v i (Nat.succ_pos q) hi b

/-- **A crossing of `λ` at the loading `t` passes through the cap generators**: the crossing
placed at the maximum below the generator at `s_p t` is the crossing on the top of the
generator at `t`. -/
theorem capElt_midCrossAt (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i)) (t : Seq (stendhalWeight ℓ ν))
    {p : ℕ} (hp : p + 1 < m) (v : L) :
    (capElt 1 (sadj m p • t) (cpos (sadj m p • t)) v (midCrossAt j hj Q Λ Λc ν ν₀ t p) : K) =
      capElt (topMap k Q Λ ν (KLRAlgebra.ψ p)) t (cpos t) v 1 := by
  have hR : (capElt (topMap k Q Λ ν (KLRAlgebra.ψ p)) t (cpos t) v 1 : K) =
      capElt (topMap k Q Λ ν (KLRAlgebra.ψ p)) t (cpos t) v (E t) := by
    have h := capElt_mid_eSum (topMap k Q Λ ν (KLRAlgebra.ψ p)) t v (1 : Rp)
    rwa [mul_one] at h
  have hX : ∀ (n : Fin (m + 1)) (_ : p + 1 < n.val ∨ n.val ≤ p) (b : Rp),
      (capElt (topMap k Q Λ ν (KLRAlgebra.ψ p)) t n v b : K) =
        capElt 1 (sadj m p • t) n v (KLRAlgebra.ψ (crossPos n N p) * b) := fun n hn b => by
    have h := capElt_cross (1 : T) t n v p hn b
    rwa [one_mul] at h
  have hXp : ∀ b : Rp, (capElt (topMap k Q Λ ν (KLRAlgebra.ψ p)) t ⟨p, by omega⟩ v b : K) =
      capElt 1 (sadj m p • t) ⟨p, by omega⟩ v (KLRAlgebra.ψ (p + N) * b) := fun b =>
    (hX ⟨p, by omega⟩ (Or.inr le_rfl) b).trans (by rw [Fin.val_mk, crossPos_self])
  by_cases hfar : p + 1 < midPos j t ∨ midPos j t + 1 ≤ p
  · rw [midCrossAt_far t hp (by omega) (by omega), hR, hX (cpos t) (by simp only; omega)]
    exact capElt_fin_congr _ _ _ _ v _ (midPos_sadj_of_far j t hp hfar)
  rcases (by omega : p + 1 = midPos j t ∨ p = midPos j t) with hc | hc
  · cases hl : t.lbl ⟨p, by omega⟩ with
    | inl i =>
      have h1 := capElt_under (topMap k Q Λ ν (KLRAlgebra.ψ p)) t ⟨p, by omega⟩ v i
        (by simp only; omega) hl (E t)
      have h2 := hXp (underLeft N p * E t)
      rw [midCrossAt_left t hp hc hl, hR,
        capElt_fin_congr _ t (cpos t) ⟨p + 1, by omega⟩ v _ hc.symm, ← h1, h2,
        capElt_fin_congr _ _ (cpos (sadj m p • t)) ⟨p, by omega⟩ v _
          (midPos_sadj_left j t hp hc), mul_assoc]
    | inr r =>
      rw [midCrossAt_left_red t hp hc hl, capElt_zero_right]
      have h2 := lbl_midPos_isRight (j := j) t (by omega)
      rw [show (⟨midPos j t, by omega⟩ : Fin m) = ⟨p + 1, hp⟩ from Fin.ext hc.symm] at h2
      exact (capElt_topMap_ψ_of_red t hp _ v 1 (by rw [hl]; rfl) h2).symm
  · cases hl : t.lbl ⟨p + 1, hp⟩ with
    | inl i =>
      have hi' : (sadj m p • t).lbl ⟨p, by omega⟩ = .inl i := by
        rw [lbl_sadj_of_swapNat t hp _ ⟨p + 1, hp⟩ (by unfold swapNat; simp), hl]
      have h1 := capElt_over_succ (Ring.inverse (cupScalar Q ν₀ i) • (1 : T)) (sadj m p • t) p
        hp.le v i hi' (KLRAlgebra.ψ (p + N) * E t)
      have h2 := hXp (E t)
      have hs : Ring.inverse (cupScalar Q ν₀ i) • (1 : T) *
          algebraMap k T (cupScalar Q ν₀ i) = 1 := by
        rw [smul_mul_assoc, one_mul, Algebra.smul_def, ← map_mul,
          Ring.inverse_mul_cancel _ (hκ i), map_one]
      rw [midCrossAt_right t hp hc hl, capElt_smul_right, hR,
        capElt_fin_congr _ t (cpos t) ⟨p, by omega⟩ v _ hc.symm, h2,
        capElt_fin_congr _ _ (cpos (sadj m p • t)) ⟨p + 1, by omega⟩ v _
          (midPos_sadj_right j t hp hc), mul_assoc, h1, hs]
    | inr r =>
      rw [midCrossAt_right_red t hp hc hl, capElt_zero_right]
      have h1 := lbl_midPos_isRight (j := j) t (by omega)
      rw [show (⟨midPos j t, by omega⟩ : Fin m) = ⟨p, by omega⟩ from Fin.ext hc.symm] at h1
      exact (capElt_topMap_ψ_of_red t hp _ v 1 h1 (by rw [hl]; rfl)).symm

theorem sum_capElt_midCross (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i)) (p : ℕ) (v : L) :
    ∑ s : Seq (stendhalWeight ℓ ν), (capElt 1 s (cpos s) v (midCross j hj Q Λ Λc ν ν₀ p) : K) =
      ∑ s : Seq (stendhalWeight ℓ ν),
        capElt (topMap k Q Λ ν (KLRAlgebra.ψ p)) s (cpos s) v 1 := by
  by_cases hp : p + 1 < m
  · have h1 : ∀ s : Seq (stendhalWeight ℓ ν),
        (capElt 1 s (cpos s) v (midCross j hj Q Λ Λc ν ν₀ p) : K) =
          capElt 1 s (cpos s) v (midCrossAt j hj Q Λ Λc ν ν₀ (sadj m p • s) p) := fun s => by
      rw [capElt_mid_eSum, eSum_mul_midCross]
    rw [Finset.sum_congr rfl fun s _ => h1 s]
    refine (Equiv.sum_comp (MulAction.toPerm (sadj m p)) (fun s =>
      (capElt 1 s (cpos s) v (midCrossAt j hj Q Λ Λc ν ν₀ (sadj m p • s) p) : K))).symm.trans
      (Finset.sum_congr rfl fun t _ => ?_)
    rw [MulAction.toPerm_apply, sadj_smul_sadj_smul]
    exact capElt_midCrossAt hκ t hp v
  · have h0 : midCross j hj Q Λ Λc ν ν₀ p = 0 :=
      Finset.sum_eq_zero fun s _ => by simp [midCrossAt, hp]
    have h0' : (KLRAlgebra.ψ p : Rλ) = 0 := KLRAlgebra.ψ_eq_zero p (by omega)
    simp only [h0, h0', map_zero, capElt_zero_right, capElt_zero_left]

/-! ### The left action -/

theorem botMap_midIdem_mul (t : Seq (stendhalWeight ℓ ν)) :
    bot (midIdem j hj Q Λ Λc ν ν₀ t) * σ 1 = bot (midIdem j hj Q Λ Λc ν ν₀ t) :=
  botMap_eSum_mul_midStendhal_one t

theorem botMap_midDot_mul (a : Fin m) :
    bot (midDot j hj Q Λ Λc ν ν₀ a) * σ 1 = bot (midDot j hj Q Λ Λc ν ν₀ a) := by
  rw [midDot, map_sum, Finset.sum_mul]
  exact Finset.sum_congr rfl fun s _ => botMap_mul_eSum_mul_midStendhal_one _ s

theorem botMap_midCross_mul (p : ℕ) :
    bot (midCross j hj Q Λ Λc ν ν₀ p) * σ 1 = bot (midCross j hj Q Λ Λc ν ν₀ p) := by
  rw [midCross, map_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [midCrossAt_eq_mul_eSum t p]
  exact botMap_mul_eSum_mul_midStendhal_one _ t

theorem midModelToCapAdd_midKLRAct (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i))
    (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) (w : Rλ) :
    ∀ y, F (midKLRAct hR w y) = (Env.mk (topMap k Q Λ ν w) 1 : Ev) • F y := by
  induction w using KLRAlgebra.klr_induction with
  | hadd u u' hu hu' =>
    intro y
    rw [map_add (midKLRAct hR) u u', LinearMap.add_apply, map_add, hu, hu',
      map_add (topMap k Q Λ ν) u u', Env.mk_add_left, add_smul]
  | hmul u u' hu hu' =>
    intro y
    rw [map_mul (midKLRAct hR) u u', Module.End.mul_apply, hu, hu', smul_smul, Env.mk_mul_mk,
      mul_one, map_mul (topMap k Q Λ ν) u u']
  | hr c =>
    intro y
    rw [(midKLRAct hR).commutes c, Module.algebraMap_end_apply, (topMap k Q Λ ν).commutes c,
      midModelToCapAdd_algebraMap_smul]
  | he t =>
    intro y
    rw [midKLRAct_e]
    exact midModelToCapAdd_midEnd _ (botMap_midIdem_mul t) (sum_capElt_midIdem t) y
  | hx a =>
    intro y
    rw [midKLRAct_x]
    exact midModelToCapAdd_midEnd _ (botMap_midDot_mul a) (sum_capElt_midDot a) y
  | hψ p =>
    intro y
    rw [midKLRAct_ψ]
    exact midModelToCapAdd_midEnd _ (botMap_midCross_mul p) (sum_capElt_midCross hκ p) y

/-- **The inverse commutes with the left action of `T̃^λ`.** -/
theorem midModelToCapAdd_midLeftAlg (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i))
    (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) (a : T) (y : MidModel j hj Q Λ Λc ν ν₀ L) :
    F (midLeftAlg L hL hR a y) = (Env.mk a 1 : Ev) • F y := by
  obtain ⟨w, rfl⟩ := topMap_surjective' Q Λ a
  rw [midLeftAlg_topMap]
  exact midModelToCapAdd_midKLRAct hκ hR w y

theorem midModelToCapAdd_envMk (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i))
    (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) (a : T) (b : Tp) (y : MidModel j hj Q Λ Λc ν ν₀ L) :
    F (midEnvAlg L hL hR (Env.mk a b) y) = (Env.mk a b : Ev) • F y := by
  rw [midEnvAlg_mk, midModelToCapAdd_midLeftAlg hκ hR, midModelToCapAdd_op_smul, smul_smul,
    Env.mk_mul_mk, mul_one, mul_one]

theorem midModelToCapAdd_smul (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i))
    (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) (r : Ev) (y : MidBimod L hL hR) :
    F (ofMidBimod L hL hR (r • y)) = r • F (ofMidBimod L hL hR y) := by
  induction r using TensorProduct.inductionOn with
  | tmul a b => exact midModelToCapAdd_envMk hκ hR a b.unop y
  | add r r' hr hr' =>
    have h := add_smul (show Ev from r) (show Ev from r') y
    have h' := add_smul (show Ev from r) (show Ev from r') (F (ofMidBimod L hL hR y))
    exact (congrArg (fun z => F (ofMidBimod L hL hR z)) h).trans ((map_add F _ _).trans
      ((congrArg₂ (· + ·) hr hr').trans h'.symm))

variable (L hL) in
/-- **The inverse of the map to the model of a cap after `λ_j`** (Webster, arXiv:1309.3796v3,
proof of Lemma 7.17), as a map of bimodules: `Z ⊗ v ↦ ∑_s cap(s, midPos j s, v) · Z`. -/
def midModelToCap (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i)) (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) :
    MidBimod L hL hR →ₗ[Ev] K where
  toFun y := F (ofMidBimod L hL hR y)
  map_add' _ _ := map_add F _ _
  map_smul' r y := midModelToCapAdd_smul hκ hR r y

theorem midModelToCap_apply (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i))
    (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) (y : MidBimod L hL hR) :
    midModelToCap L hL hκ hR y = F (ofMidBimod L hL hR y) := rfl

end Categorification.Stendhal.CupCap
