import Categorification.WeightedKLR.RedStrands.FirstPairOneAfterSpectator

/-!
# Two equal black strands beyond the final spectator

Webster, arXiv:1309.3796v2, Lemma 6.8 at (6.21).
-/

noncomputable section

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR KLRAlgebra TypeA Equiv

local notation "ν" => ({()} + {()} : Multiset Unit)
local notation "μ" => stendhalWeight 3 ν
local notation "N" => Multiset.card μ

/-- The surviving loading with both black strands beyond the final spectator. -/
def firstPairTwoAfterSpectator : Seq μ :=
  Seq.ofList [.inr 0, .inr 1, .inr 2, .inl (), .inl ()] (by decide)

local notation "bottom" => firstPairTwoAfterSpectator
local notation "above" => firstPairOneAfterSpectator true

variable {k : Type} [CommRing k]
  (Q : Unit → Unit → MvPolynomial (Fin 2) k) (Λ : Fin 3 → Unit →₀ ℕ)

local notation "A" => KLRAlgebra k (stendhalQ Q Λ) μ
local notation "V" => ViolQuotient k Q Λ ν
local notation "F" => AlgHom.comp (violMk k Q Λ ν) (ofKLR k Q Λ ν)
local notation "proj" => fun s : Seq μ => F (e s)
local notation "leg" => fun i => F (hflip (ψw (rightPairWord 2 i) * e bottom : A))
local notation "J" => blockUpperIdeal k Q Λ ν 0 1 (adjacentBlockRoot 0 1 bottom) (redWord bottom)

private theorem firstPairTwoAfter_hasBlackBefore (s : Seq μ)
    (order : redWord s = redWord bottom)
    (higher : adjacentBlockRoot 0 1 bottom < adjacentBlockRoot 0 1 s)
    (survives : ¬ IsViolated s) :
    ∃ l r, l < r ∧ (s.lbl l).isLeft ∧ s.lbl r = .inr 2 := by
  have count : 0 < adjacentBlockRoot 0 1 s 2 () := by
    apply lt_of_not_ge
    intro tooLow
    apply higher.not_ge
    intro r i
    cases i
    have word : redWord s = List.finRange 3 := order.trans (by decide)
    fin_cases r
    · change adjacentBlockRoot 0 1 s 0 () ≤ adjacentBlockRoot 0 1 bottom 0 ()
      rw [firstPair_merged_root_eq_zero s word survives 0 (Or.inl rfl)]
      exact Nat.zero_le _
    · change adjacentBlockRoot 0 1 s 1 () ≤ adjacentBlockRoot 0 1 bottom 1 ()
      rw [firstPair_merged_root_eq_zero s word survives 1 (Or.inr rfl)]
      exact Nat.zero_le _
    · change adjacentBlockRoot 0 1 s 2 () ≤ adjacentBlockRoot 0 1 bottom 2 ()
      simpa only [show adjacentBlockRoot 0 1 bottom 2 () = 0 by decide] using tooLow
  obtain ⟨r,hr⟩ := exists_lbl_eq_inr s (2 : Fin 3)
  have c : 0 < blockBlackCount s {2} () := by
    simpa only [adjacentBlockRoot, show ¬ ((2 : Fin 3) = 0 ∨ (2 : Fin 3) = 1) by decide,
      ↓reduceIte] using count
  unfold blockBlackCount at c
  obtain ⟨l,hl⟩ := Finset.card_pos.mp c
  obtain ⟨_,hl,support⟩ := Finset.mem_filter.mp hl
  exact ⟨l,r,support r 2 (by simp) hr,by simp [hl],hr⟩

private theorem firstPairTwoAfter_leg_right (i : Bool) : leg i * proj above = leg i := by
  have step : wordProd N (rightPairWord 2 i) • bottom = above := by cases i <;> decide +kernel
  rw [← map_mul F]
  apply congrArg F
  have cut : (e above : A) * (ψw (rightPairWord 2 i) * e bottom) =
      ψw (rightPairWord 2 i) * e bottom := by
    rw [← mul_assoc, ← step, e_mul_ψw, inv_smul_smul, mul_assoc, e_mul_self]
  simpa only [hflip_mul, hflip_e] using congrArg hflip cut

private theorem firstPairTwoAfter_higherGenerator (hQ : KLRSymm Q) (s : Seq μ)
    (order : redWord s = redWord bottom)
    (higher : adjacentBlockRoot 0 1 bottom < adjacentBlockRoot 0 1 s) (a : V) :
    ∃ y : Bool → V, (∀ i, proj above * y i = y i) ∧
      (∑ i, leg i * y i) = proj bottom * a * proj s := by
  classical
  by_cases hv : IsViolated s
  · exact ⟨fun _ => 0, fun _ => mul_zero _, by
      simp only [mul_zero, Finset.sum_const_zero, show proj s = 0 from violMk_e hv]⟩
  obtain ⟨x,hx⟩ := (violMk_surjective (Q := Q) (Λ := Λ)).comp
    (ofKLR_surjective (Q := Q) (Λ := Λ)) a
  obtain ⟨c,hc⟩ := exists_rightPairColumn_coefficients_of_black_before Q Λ (AlgHom.id k A)
    (fun y => ⟨y, rfl⟩) hQ bottom s 2 (by decide) 2 (by decide)
    (by decide +kernel) (firstPairTwoAfter_hasBlackBefore s order higher hv) (hflip x)
  have h : (e bottom : A) * x * e s =
      ∑ i : Bool, hflip (ψw (rightPairWord 2 i) * e bottom) * hflip (c i) := by
    simpa only [AlgHom.id_apply, hflip_sum, hflip_mul, hflip_e, hflip_hflip, mul_assoc]
      using congrArg hflip hc
  refine ⟨fun i => proj above * F (hflip (c i)), fun i => ?_, ?_⟩
  · rw [← mul_assoc, ← map_mul F, e_mul_self]
  · calc
      _ = ∑ i : Bool, leg i * F (hflip (c i)) := by
        apply Finset.sum_congr rfl
        intro i _
        rw [← mul_assoc, firstPairTwoAfter_leg_right Q Λ i]
      _ = _ := by
        simpa only [map_mul F, map_sum F, show F x = a from hx] using congrArg F h.symm

/-- The higher kernel at the rightmost loading is generated by the two
crossings from the same one-after-spectator loading. -/
theorem firstPairTwoAfter_blockKernel_twoFactors (hQ : KLRSymm Q)
    (x : V) (hx : x ∈ J) (left : proj bottom * x = x) :
    ∃ y : Bool → V, (∀ i, proj above * y i = y i) ∧ (∑ i, leg i * y i) = x := by
  classical
  unfold blockUpperIdeal at hx
  have cut : ∀ a b : V, ∃ y : Bool → V, (∀ i, proj above * y i = y i) ∧
      (∑ i, leg i * y i) = proj bottom * a * x * b := by
    refine TwoSidedIdeal.span_induction
      (p := fun z _ => ∀ a b : V, ∃ y : Bool → V, (∀ i, proj above * y i = y i) ∧
        (∑ i, leg i * y i) = proj bottom * a * z * b) ?_ ?_ ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨s, hs, hh, rfl⟩ a b
      obtain ⟨y, hy, hval⟩ := firstPairTwoAfter_higherGenerator Q Λ hQ s hs hh a
      exact ⟨fun i => y i * b, fun i => by rw [← mul_assoc, hy],
        by simp only [← mul_assoc, ← Finset.sum_mul, hval]⟩
    · intro a b
      exact ⟨fun _ => 0, fun _ => mul_zero _, by simp only [mul_zero, zero_mul, Finset.sum_const_zero]⟩
    · intro u v _ _ hu hv a b
      obtain ⟨y,hy,ey⟩ := hu a b
      obtain ⟨z,hz,ez⟩ := hv a b
      exact ⟨fun i => y i + z i, fun i => by rw [mul_add,hy,hz],
        by simp only [mul_add, Finset.sum_add_distrib, ey, ez, add_mul]⟩
    · intro u _ hu a b
      obtain ⟨y,hy,ey⟩ := hu a b
      exact ⟨fun i => -y i, fun i => by rw [mul_neg,hy],
        by simp only [mul_neg, Finset.sum_neg_distrib, ey, neg_mul]⟩
    · intro a u _ hu b d
      simpa only [mul_assoc] using hu (b*a) d
    · intro b u _ hu a d
      simpa only [mul_assoc] using hu a (b*d)
  obtain ⟨y,hy,h⟩ := cut 1 1
  exact ⟨y,hy,by simpa only [mul_one,left] using h⟩

private theorem firstPairTwoAfter_leg_mem (i : Bool) : leg i ∈ J := by
  have hProj : proj above ∈ J := by
    apply TwoSidedIdeal.subset_span
    refine ⟨above, by decide, ?_, rfl⟩
    apply lt_of_le_not_ge
    · intro r j
      fin_cases r <;> cases j <;> decide
    · intro h
      have impossible : ¬ adjacentBlockRoot 0 1 above 2 () ≤
          adjacentBlockRoot 0 1 bottom 2 () := by decide
      exact impossible (h 2 ())
  rw [← firstPairTwoAfter_leg_right Q Λ i]
  exact TwoSidedIdeal.mul_mem_left _ _ _ hProj

/-- The two coefficients can be taken in the original full red-order corner.
Their images characterize the actual higher ideal on that loading. -/
theorem firstPairTwoAfter_blockKernel_mem_iff_twoFactors (hQ : KLRSymm Q)
    (z : V) (left : proj bottom * z = z)
    (right : z * F (redIdem k Q Λ (redWord bottom)) = z) :
    z ∈ J ↔ ∃ y : Bool → V, (∀ i, proj above * y i = y i) ∧
      (∀ i, y i * F (redIdem k Q Λ (redWord bottom)) = y i) ∧
      (∑ i, leg i * y i) = z := by
  let E := F (redIdem k Q Λ (redWord bottom))
  have hE : E * E = E := by
    rw [← map_mul F, redIdem_mul_redIdem]
  constructor
  · intro hz
    obtain ⟨y,hy,he⟩ := firstPairTwoAfter_blockKernel_twoFactors Q Λ hQ z hz left
    refine ⟨fun i => y i * E, fun i => ?_, fun i => ?_, ?_⟩
    · rw [← mul_assoc,hy]
    · rw [mul_assoc,hE]
    · simp only [← mul_assoc, ← Finset.sum_mul, he, show z * E = z from right]
  · rintro ⟨y,_,_,he⟩
    rw [← he]
    exact sum_mem fun i _ => TwoSidedIdeal.mul_mem_right J (leg i) (y i)
      (firstPairTwoAfter_leg_mem Q Λ i)

end Categorification.Stendhal.BraidedStendhalAlgebra
