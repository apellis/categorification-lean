/-! ### `γ ⊗ γ` and Proposition 3.2 on the image of `γ` -/

section Gamma

/-- `γ ⊗ γ` on the twisted tensor square `'f ⊗ 'f` (twisted by `degΨ`, `v = q`):
`x ⊗ y ↦ γ(x) ⊗ γ(y)` on words. -/
def gammaTT : TwSq LP I G.degΨ qUnitLP →ₗ[LP] G.K0R ⊗[LP] G.K0R :=
  TwistedMonoidAlgebra.lift fun p => G.gammaG (word p.1) ⊗ₜ G.gammaG (word p.2)

theorem gammaTT_single (u w : FreeMonoid I) (c : LP) :
    G.gammaTT (TwistedMonoidAlgebra.single (u, w) c) =
      c • (G.gammaG (word u) ⊗ₜ G.gammaG (word w)) :=
  TwistedMonoidAlgebra.lift_single _ _ _

theorem gammaG_word_eq_of (w : FreeMonoid I) :
    G.gammaG (word w) = DirectSum.of G.K0fam (wt w)
      (K0.of (G.projP (KLRAlgebra.Seq.ofList (FreeMonoid.toList w) rfl))) := by
  rw [gammaG_word, clsW]
  rfl

/-- The components of `(γ ⊗ γ)(Z)` are the realisations of `Z` (`GradingDatum.realize`). -/
theorem compTT_gammaTT (ν ν' : Multiset I) (Z : TwSq LP I G.degΨ qUnitLP) :
    G.k0TensorEquiv hPQ hP hG ν ν' (G.compTT ν ν' (G.gammaTT Z)) = G.realize ν ν' Z := by
  induction Z using TwistedMonoidAlgebra.induction_linear with
  | zero => simp
  | add Z Z' hZ hZ' => rw [map_add, map_add, map_add, hZ, hZ', map_add]
  | single p c =>
    obtain ⟨u, w⟩ := p
    rw [gammaTT_single, map_smul, map_smul, compTT_tmul, k0TensorEquiv_tmul,
      TwistedMonoidAlgebra.single_eq_smul, map_smul, ← tw_word (dot := G.degΨ) (v := qUnitLP),
      realize_tw]

/-- **`Δ ∘ γ = (γ ⊗ γ) ∘ r`** (KL I, Proposition 3.2 and its proof; Lusztig's `r` for the pairing
`degΨ` and `v = q`). -/
theorem coprod_gammaG (x : PreF LP I) :
    G.coprod hPQ hP hG (G.gammaG x) = G.gammaTT (r G.degΨ qUnitLP x) :=
  G.ext_compTT fun ν ν' => (G.k0TensorEquiv hPQ hP hG ν ν').injective (by
    rw [coprod_spec, compTT_gammaTT, resComp_gammaG])

/-- `γ ⊗ γ` is multiplicative for the twisted products of `'f ⊗ 'f` and of `K₀(R) ⊗ K₀(R)`. -/
theorem gammaTT_mul (Z Z' : TwSq LP I G.degΨ qUnitLP) :
    G.gammaTT (Z * Z') = G.twMul (G.gammaTT Z) (G.gammaTT Z') := by
  induction Z using TwistedMonoidAlgebra.induction_linear with
  | zero => simp
  | add Z₁ Z₂ h₁ h₂ => rw [add_mul, map_add, h₁, h₂, map_add, map_add, LinearMap.add_apply]
  | single p c =>
    induction Z' using TwistedMonoidAlgebra.induction_linear with
    | zero => simp
    | add Z₁ Z₂ h₁ h₂ => rw [mul_add, map_add, h₁, h₂, map_add, map_add]
    | single p' c' =>
      obtain ⟨u, w⟩ := p
      obtain ⟨u', w'⟩ := p'
      rw [twSq_single_mul_single, gammaTT_single, gammaTT_single, gammaTT_single, map_smul,
        map_smul, LinearMap.smul_apply, gammaG_word_eq_of G w, gammaG_word_eq_of G u',
        twMul_tmul, ← gammaG_word_eq_of G w, ← gammaG_word_eq_of G u', ← map_mul, ← map_mul,
        Prod.fst_mul, Prod.snd_mul, word_mul, word_mul, val_qUnitLP_zpow, smul_smul, smul_smul]
      congr 1
      ring

/-- **KL I, Proposition 3.2 on the image of `γ`**: `Δ(γ(x) γ(y)) = Δ(γ x) Δ(γ y)` for the
twisted multiplication (3.1). -/
theorem coprod_mul_gammaG (x y : PreF LP I) :
    G.coprod hPQ hP hG (G.gammaG x * G.gammaG y) =
      G.twMul (G.coprod hPQ hP hG (G.gammaG x)) (G.coprod hPQ hP hG (G.gammaG y)) := by
  rw [← map_mul, coprod_gammaG, coprod_gammaG, coprod_gammaG, map_mul, gammaTT_mul]

/-- `Δ(1) = 1 ⊗ 1`. -/
theorem coprod_one : G.coprod hPQ hP hG 1 = 1 ⊗ₜ 1 := by
  rw [← map_one G.gammaG, coprod_gammaG, map_one, TwistedMonoidAlgebra.one_def, gammaTT_single,
    one_smul]
  change G.gammaG (word 1) ⊗ₜ G.gammaG (word 1) = _
  rw [show (word 1 : PreF LP I) = 1 from rfl, map_one]

end Gamma

