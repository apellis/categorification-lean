import Categorification.WeightedKLR.RedStrands.PrependRedBlockHom

/-!
# Adding a red strand and the kernel of the standard quotient

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §5.1, for
the comparison of `T̃^λ` with `T^{(λ₀, λ)}` used in the proof of Proposition 5.26. Let `U_α` be
the right ideal of `T̃^λ` spanned by the `e_α a e(t)` with `α < t`, so that `S_α = e_α T̃^λ / U_α`.
Adding a red strand `λ₀` on the left maps `U_α` into `U_{(0, α)}`
(`prependRedStendhal_mem_rootUpper`), and in `T^{(λ₀, λ)}`, where only loadings beginning with
`λ₀` survive, the image of `U_{(0, α)}` is the image of `U_α` (`exists_prependRed_eq_of_mem`).
Since `U_α` is homogeneous (`isHomogeneousSubspace_rootUpper`) and adding the red strand is
injective in a fixed degree for large `λ₀`, an element of that degree whose image lies in
`U_{(0, α)}` lies in `U_α` (`mem_rootUpper_of_prependRedStendhal_mem`).

## Main results

* `Graded.isHomogeneousSubspace_span_op`: a right ideal spanned by elements whose homogeneous
  components lie in it is homogeneous.
* `mem_rootUpper_of_prependRedStendhal_mem`.
-/

noncomputable section

namespace Categorification.Graded

open DirectSum MulOpposite

variable {k : Type*} [Field k] {A : Type*} [Ring A] [Algebra k A] (𝒜 : ℤ → Submodule k A)
  [GradedAlgebra 𝒜]

/-- A right ideal generated by elements whose homogeneous components lie in it is
homogeneous. -/
theorem isHomogeneousSubspace_span_op {S : Set A}
    (hS : ∀ z ∈ S, ∀ n, (decompose 𝒜 z n : A) ∈ Submodule.span Aᵐᵒᵖ S) :
    IsHomogeneousSubspace 𝒜 ((Submodule.span Aᵐᵒᵖ S).restrictScalars k) := by
  classical
  suffices h : ∀ x ∈ Submodule.span Aᵐᵒᵖ S, ∀ n, (decompose 𝒜 x n : A) ∈ Submodule.span Aᵐᵒᵖ S
    from fun n x hx => h x hx n
  intro x hx
  induction hx using Submodule.span_induction with
  | mem z hz => exact hS z hz
  | zero => intro n; simp
  | add x y _ _ hx hy =>
    intro n
    rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact add_mem (hx n) (hy n)
  | smul b x _ hx =>
    intro n
    induction b using MulOpposite.rec' with | _ b =>
    rw [op_smul_eq_mul, ← sum_support_decompose 𝒜 b, Finset.mul_sum, decompose_sum,
      DFinsupp.finsetSum_apply, Submodule.coe_sum]
    refine Submodule.sum_mem _ fun j _ => ?_
    have hμ : ∀ m, ∀ y ∈ 𝒜 m, LinearMap.mulRight k (decompose 𝒜 b j : A) y ∈ 𝒜 (m + j) :=
      fun m y hy => SetLike.GradedMul.mul_mem hy (decompose 𝒜 b j).2
    have h := decompose_map_of_shift hμ x n
    rw [LinearMap.mulRight_apply, LinearMap.mulRight_apply] at h
    rw [h, ← op_smul_eq_mul]
    exact Submodule.smul_mem _ _ (hx (n - j))

end Categorification.Graded

namespace Categorification.Stendhal

open KLR StendhalAlgebra MulOpposite DirectSum Categorification.Graded

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

section Order

variable {I : Type*} {ℓ : ℕ}

theorem cons_zero_lt_cons_zero_iff (α β : Fin ℓ → I → ℕ) :
    (Fin.cons (0 : I → ℕ) α : Fin (ℓ + 1) → I → ℕ) < Fin.cons 0 β ↔ α < β := by
  rw [lt_iff_le_not_ge, lt_iff_le_not_ge, Fin.cons_le_cons, Fin.cons_le_cons]
  simp

end Order

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ) (ν : Multiset I)

local notation "μ" => stendhalWeight ℓ ν
local notation "T̃" => StendhalAlgebra k Q (Λ ∘ Fin.succ) ν

/-- Adding the red strand maps `U_α` into `U_{(0, α)}`. -/
theorem prependRedStendhal_mem_rootUpper (α : Fin ℓ → I → ℕ) {y : T̃}
    (hy : y ∈ rootUpper Q (Λ ∘ Fin.succ) α) :
    prependRedStendhal Q Λ ν y ∈ rootUpper Q Λ (Fin.cons (0 : I → ℕ) α) := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨t, ht, a, hlt, rfl⟩ := hz
    rw [map_mul, map_mul, prependRedStendhal_rootIdem, prependRedStendhal_e]
    refine Submodule.subset_span ⟨_, _, _, ?_, rfl⟩
    rw [blackCount_prependRedLoading, cons_zero_lt_cons_zero_iff]
    exact hlt
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul b x _ hx =>
    induction b using MulOpposite.rec' with | _ b =>
    rw [op_smul_eq_mul, map_mul, ← op_smul_eq_mul]
    exact Submodule.smul_mem _ _ hx

/-- `prependRed` is adding the red strand followed by the quotient map to `T^{(λ₀, λ)}`. -/
theorem prependRed_eq_mk (z : T̃) :
    prependRed Q Λ ν z = TensorProductAlgebra.mk Q Λ ν (prependRedStendhal Q Λ ν z) := by
  rw [prependRed_apply, orderedQuotient, AlgHom.comp_apply]
  congr 1
  apply Subtype.ext
  change (prependRedAllOrders Q Λ ν z.val).val * StendhalAlgebraAllOrders.redOrderedIdem k Q Λ ν =
    (prependRedStendhal Q Λ ν z).val
  exact ((Subsemigroup.mem_corner_iff StendhalAlgebraAllOrders.isIdempotentElem_redOrderedIdem).1
    (prependRedStendhal Q Λ ν z).2).2

/-- In `T^{(λ₀, λ)}` the image of `U_{(0, α)}` is contained in the image of `U_α`. -/
theorem exists_prependRed_eq_of_mem (α : Fin ℓ → I → ℕ) {z : StendhalAlgebra k Q Λ ν}
    (hz : z ∈ rootUpper Q Λ (Fin.cons (0 : I → ℕ) α)) :
    ∃ u ∈ rootUpper Q (Λ ∘ Fin.succ) α,
      TensorProductAlgebra.mk Q Λ ν z = prependRed Q Λ ν u := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨t', ht', a, hlt, rfl⟩ := hz
    by_cases hpre : ∃ t, prependRedLoading t = t'
    · obtain ⟨t, rfl⟩ := hpre
      have ht := (prependRedLoading_ordered_iff t).1 ht'
      obtain ⟨b, hb⟩ := prependRed_surjective Q Λ ν (TensorProductAlgebra.mk Q Λ ν a)
      refine ⟨rootIdem Q (Λ ∘ Fin.succ) α * b * StendhalAlgebra.e t ht,
        Submodule.subset_span ⟨t, ht, b, ?_, rfl⟩, ?_⟩
      · rw [blackCount_prependRedLoading, cons_zero_lt_cons_zero_iff] at hlt
        exact hlt
      · rw [map_mul, map_mul, map_mul, map_mul, hb, prependRed_e, prependRed_eq_mk,
          prependRedStendhal_rootIdem]
    · push Not at hpre
      refine ⟨0, zero_mem _, ?_⟩
      rw [map_mul, show TensorProductAlgebra.mk Q Λ ν (StendhalAlgebra.e t' ht') = 0 from
        seqIdem_eq_zero_of_not_prepend Q Λ ν t' ht' hpre, mul_zero, map_zero]
  | zero => exact ⟨0, zero_mem _, by rw [map_zero, map_zero]⟩
  | add x y _ _ hx hy =>
    obtain ⟨u, hu, hxu⟩ := hx
    obtain ⟨v, hv, hyv⟩ := hy
    exact ⟨u + v, add_mem hu hv, by rw [map_add, map_add, hxu, hyv]⟩
  | smul b x _ hx =>
    obtain ⟨u, hu, hxu⟩ := hx
    induction b using MulOpposite.rec' with | _ b =>
    obtain ⟨c, hc⟩ := prependRed_surjective Q Λ ν (TensorProductAlgebra.mk Q Λ ν b)
    refine ⟨u * c, by rw [← op_smul_eq_mul]; exact Submodule.smul_mem _ _ hu, ?_⟩
    rw [op_smul_eq_mul, map_mul, map_mul, hxu, hc]

variable (G : KLR.GradingDatum (stendhalQ Q Λ))

local notation "G₀" => restrictFirstRedGrading Q Λ G

/-- `U_α` is homogeneous. -/
theorem isHomogeneousSubspace_rootUpper {ℓ' : ℕ} {Λ' : Fin ℓ' → I →₀ ℕ}
    (G' : KLR.GradingDatum (stendhalQ Q Λ')) (α : Fin ℓ' → I → ℕ) :
    IsHomogeneousSubspace (stendhalGrade G' ν) ((rootUpper (ν := ν) Q Λ' α).restrictScalars k) := by
  refine isHomogeneousSubspace_span_op (stendhalGrade G' ν) ?_
  rintro _ ⟨t, ht, a, hlt, rfl⟩ n
  have hE : (rootIdem Q Λ' α : StendhalAlgebra k Q Λ' ν) ∈ stendhalGrade G' ν 0 :=
    show (∑ s ∈ rootSet ν α, StendhalAlgebraAllOrders.e s) ∈ allOrdersGrade G' ν 0 from
      Submodule.sum_mem _ fun s _ => Graded.mem_map_of_mem _
        (StendhalAlgebraAllOrders.ofKLR k Q Λ' ν).toLinearMap (G'.e_mem_grade s)
  rw [decompose_mul_of_mem_zero_right _ (e_mem_stendhalGrade G' ν t ht),
    decompose_mul_of_mem_zero_left _ hE]
  exact Submodule.subset_span ⟨t, ht, _, hlt, rfl⟩

/-- **Adding the red strand detects `U_α` in a fixed degree** (Webster, arXiv:1309.3796v3,
for the proof of Proposition 5.26). If the grading of all red orders of `T̃^λ` vanishes below
`-c` and `⟨α_i^∨, λ₀⟩ · deg x_i > n + 2c` for every black label `i`, an element of degree `n` of
`T̃^λ` whose image lies in `U_{(0, α)}` lies in `U_α`. -/
theorem mem_rootUpper_of_prependRedStendhal_mem {c n : ℤ}
    (hc : ∀ m < -c, allOrdersGrade G₀ ν m = ⊥) (hΛ : ∀ i ∈ ν, n + 2 * c < Λ 0 i * G.degX (.inl i))
    (α : Fin ℓ → I → ℕ) {y : T̃} (hyn : y ∈ stendhalGrade G₀ ν n)
    (hy : prependRedStendhal Q Λ ν y ∈ rootUpper Q Λ (Fin.cons (0 : I → ℕ) α)) :
    y ∈ rootUpper Q (Λ ∘ Fin.succ) α := by
  classical
  obtain ⟨u, hu, hyu⟩ := exists_prependRed_eq_of_mem Q Λ ν α hy
  rw [← prependRed_eq_mk] at hyu
  have hgr : PreservesGrading (stendhalGrade G₀ ν) (tensorProductGrade G ν)
      ((prependRed Q Λ ν).toLinearMap.restrictScalars k) :=
    fun _ _ hx => prependRed_mem_grade Q Λ ν G hx
  have hun : (decompose (stendhalGrade G₀ ν) u n : T̃) ∈ rootUpper Q (Λ ∘ Fin.succ) α :=
    isHomogeneousSubspace_rootUpper Q ν G₀ α n u hu
  have hmap : prependRed Q Λ ν y = prependRed Q Λ ν (decompose (stendhalGrade G₀ ν) u n) := by
    have h1 := decompose_map hgr u n
    have h2 : (decompose (tensorProductGrade G ν) (prependRed Q Λ ν y) n :
        TensorProductAlgebra k Q Λ ν) = prependRed Q Λ ν y :=
      decompose_of_mem_same _ (prependRed_mem_grade Q Λ ν G hyn)
    rw [← h2, hyu]
    exact h1
  rw [prependRed_injOn_degree Q Λ ν G₀ hc hΛ hyn (Submodule.coe_mem _) hmap]
  exact hun

end Categorification.Stendhal
