import Categorification.WeightedKLR.RedStrands.BraidedViolatedIdentity

set_option backward.isDefEq.respectTransparency false

/-!
# Injectivity of the braiding generator on a standard module

Let `e(t)` be an idempotent whose leftmost strand is the red strand `λ_r` and let `g` carry
this strand to the right edge, giving `g • t = s`. Multiplication by the braiding diagram
`ψ_{ρ(g)} e(t)` sends `e(t) x e_κ` to `e(s) ψ_{ρ(g)} x e_κ`. We show that if the image lies in
the ideal generated by violated idempotents, then `e(t) x e_κ` lies in the ideal `U_r`
generated by the violated idempotents and by the idempotents whose leftmost strand is `λ_r`
followed by a black strand.

The proof constructs a linear map `Θ` (`throughMap`), a left inverse of multiplication by the
braiding diagram modulo diagrams with violated bottom, and shows that `Θ` sends the part of the
violated ideal lying in `e(s) A e_κ` into `U_r`: a violated diagram with top `s` either has a
violated bottom, or factors through the diagram moving `λ_r` to the left edge, whose bottom
lies in `U_r`.

This is the injectivity step of B. Webster, *Knot invariants and higher representation
theory*, arXiv:1309.3796v2, Proposition 6.9, for two red strands.

## Main results

* `BraidedStendhalAlgebra.mem_edgeIdeal_of_mem_violIdeal` : the injectivity step.
-/

namespace Categorification.Stendhal

open KLR TypeA Equiv MvPolynomial

variable {I : Type} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "R" => KLR.KLRAlgebra k (stendhalQ Q Λ) (stendhalWeight ℓ ν)

namespace BraidedStendhalAlgebra

omit [DecidableEq I] in
/-- **The inversions of moving a strand to the left edge.** Let `c` be increasing away from
`q` and send `q` to its minimum, and let `τ` send `0` to `q`. Then every inversion of `c τ` is
an inversion of `τ`. -/
theorem invSet_mul_subset_of_front {c τ : Perm (Fin m)} {q : Fin m} (h0 : 0 < m)
    (hc : ∀ x y : Fin m, x ≠ q → y ≠ q → x < y → c x < c y) (hcq : ∀ x, c q ≤ c x)
    (hτ : τ ⟨0, h0⟩ = q) : invSet m (c * τ) ⊆ invSet m τ := by
  rintro ⟨a, b⟩ hab
  rw [mem_invSet_pair] at hab ⊢
  rw [Perm.mul_apply, Perm.mul_apply] at hab
  refine ⟨hab.1, ?_⟩
  have hb : τ b ≠ q := by
    intro h
    rw [← hτ] at h
    have := τ.injective h
    subst this
    exact absurd hab.1 (by simp [Fin.lt_def])
  by_cases ha : τ a = q
  · exact absurd hab.2 (not_lt.2 (by rw [ha]; exact hcq _))
  · rcases lt_trichotomy (τ a) (τ b) with h | h | h
    · exact absurd hab.2 (not_lt.2 (hc _ _ ha hb h).le)
    · exact absurd hab.1 (by rw [τ.injective h]; exact lt_irrefl _)
    · exact h

theorem coe_cycleRange_apply {n : ℕ} (q x : Fin n) :
    (Fin.cycleRange q x : ℕ) = if x < q then (x : ℕ) + 1 else if x = q then 0 else x := by
  split_ifs with h h'
  · exact Fin.coe_cycleRange_of_lt h
  · rw [Fin.coe_cycleRange_of_le h'.le, ite_eq_left h']
  · rw [Fin.cycleRange_of_gt (lt_of_le_of_ne (not_lt.1 h) (Ne.symm h'))]

omit [DecidableEq I] in
/-- The cycle `cycleRange q`, which moves the strand at position `q` to the left edge, satisfies
the hypotheses of `invSet_mul_subset_of_front`. -/
theorem invSet_cycleRange_mul_subset {τ : Perm (Fin m)} {q : Fin m} (h0 : 0 < m)
    (hτ : τ ⟨0, h0⟩ = q) : invSet m (Fin.cycleRange q * τ) ⊆ invSet m τ := by
  refine invSet_mul_subset_of_front h0 (fun x y hx hy hxy => ?_) (fun x => ?_) hτ
  · rw [Fin.lt_def, coe_cycleRange_apply, coe_cycleRange_apply]
    rw [Fin.lt_def] at hxy
    have hx' : (x : ℕ) ≠ q := fun h => hx (Fin.ext h)
    have hy' : (y : ℕ) ≠ q := fun h => hy (Fin.ext h)
    split_ifs <;> simp_all [Fin.ext_iff] <;> omega
  · rw [Fin.le_def, coe_cycleRange_apply]
    simp

omit [DecidableEq I] in
/-- If the leftmost strand of `i` is `λ_r`, the red strands of `i` read `r :: L`. -/
theorem exists_redWord_eq_cons {i : Seq μ} {r : Fin ℓ} (h0 : 0 < m)
    (hr : i.lbl ⟨0, h0⟩ = .inr r) : ∃ L, redWord i = r :: L := by
  have hmem := mem_redWord i r
  obtain ⟨r', L, hL⟩ := List.exists_cons_of_ne_nil (List.ne_nil_of_mem hmem)
  refine ⟨L, ?_⟩
  rw [hL]
  by_contra hne
  have hne' : r' ≠ r := fun h => hne (by rw [h])
  have hrL : r ∈ L := by
    rw [hL, List.mem_cons] at hmem
    exact hmem.resolve_left (Ne.symm hne')
  have hpw := redWord_pairwise_one i
  rw [hL, List.pairwise_cons] at hpw
  obtain ⟨a, ha⟩ := exists_lbl_eq_inr i r'
  exact absurd (hpw.1 r hrL a _ ha hr) (by simp [Fin.lt_def])

variable {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : IsReducedChoice ρ) (hQ : KLRSymm Q)

include hρ hQ in
/-- Seen from the red order `κ`, the violated ideal is spanned by products through violated
idempotents of red order `κ`. -/
theorem redProj_mul_mem_violSpan (κ : List (Fin ℓ)) {z : BraidedStendhalAlgebra k Q Λ ν}
    (hz : z ∈ violIdeal k Q Λ ν) : redProj k Q Λ ν κ * z ∈ violSpan k Q Λ ν κ := by
  rw [violIdeal, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hz
  induction hz using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨_, ⟨a, -, g, ⟨i, hi, rfl⟩, rfl⟩, b, -, rfl⟩ := hz
    have hmem := redProj_mul_e_mem_violSpan hρ hQ (κ₂ := κ) _ _ rfl i hi rfl a
    rw [← mul_assoc, ← mul_assoc]
    exact violSpan_mul_mem hmem b
  | zero => rw [mul_zero]; exact zero_mem _
  | add z w _ _ hz hw => rw [mul_add]; exact add_mem hz hw
  | neg z _ hz => rw [mul_neg]; exact neg_mem hz

variable (k Q Λ ν) in
/-- The ideal generated by the violated idempotents and by the idempotents whose leftmost strand
is `λ_r`, followed by a black strand. -/
noncomputable def edgeIdeal (r : Fin ℓ) : TwoSidedIdeal (BraidedStendhalAlgebra k Q Λ ν) :=
  TwoSidedIdeal.span {y | ∃ i : Seq μ, (IsViolated i ∨ ∃ h1 : 1 < m,
    i.lbl ⟨0, by omega⟩ = .inr r ∧ (i.lbl ⟨1, h1⟩).isLeft) ∧
      y = ofKLR k Q Λ ν (KLRAlgebra.e i)}

theorem mem_edgeIdeal_of_mem_violBottom (r : Fin ℓ) {y : BraidedStendhalAlgebra k Q Λ ν}
    (hy : y ∈ violBottom k Q Λ ν) : y ∈ edgeIdeal k Q Λ ν r := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, j, hj, rfl⟩ := hy
    exact TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span ⟨j, Or.inl hj, rfl⟩)
  | zero => exact zero_mem _
  | add y y' _ _ hy hy' => exact add_mem hy hy'
  | smul c y _ hy =>
    rw [Algebra.smul_def]; exact TwoSidedIdeal.mul_mem_left _ _ _ hy

/-! ### Basis diagrams against idempotents -/

theorem basis_mul_e (ρ' : Perm (Fin m) → List ℕ) (hρ' : IsReducedChoice ρ')
    (b : BlackIdx (ℓ := ℓ) ν) (j : Seq μ) :
    basis hQ ρ' hρ' b * ofKLR k Q Λ ν (KLRAlgebra.e j) =
      if b.1.1 = j then basis hQ ρ' hρ' b else 0 := by
  rw [basis_apply, ← map_mul, mul_assoc _ (KLRAlgebra.e _), KLRAlgebra.e_mul_e]
  split_ifs <;> simp

theorem basis_mul_redProj (ρ' : Perm (Fin m) → List ℕ) (hρ' : IsReducedChoice ρ')
    (b : BlackIdx (ℓ := ℓ) ν) (κ : List (Fin ℓ)) :
    basis hQ ρ' hρ' b * redProj k Q Λ ν κ =
      if redWord b.1.1 = κ then basis hQ ρ' hρ' b else 0 := by
  rw [basis_apply, redProj, ← map_mul, mul_assoc _ (KLRAlgebra.e _), e_mul_redIdem]
  split_ifs <;> simp

theorem e_mul_basis (ρ' : Perm (Fin m) → List ℕ) (hρ' : IsReducedChoice ρ')
    (b : BlackIdx (ℓ := ℓ) ν) (s : Seq μ) :
    ofKLR k Q Λ ν (KLRAlgebra.e s) * basis hQ ρ' hρ' b =
      if b.1.2.1 • b.1.1 = s then basis hQ ρ' hρ' b else 0 := by
  have hy := e_mul_std (Q := Q) (Λ := Λ) (ρ' b.1.2.1) (monomial b.1.2.2 1) b.1.1
  rw [(hρ' b.1.2.1).2] at hy
  rw [basis_apply]
  conv_lhs => rw [← hy, map_mul, ← mul_assoc, ← map_mul, KLRAlgebra.e_mul_e]
  by_cases h : b.1.2.1 • b.1.1 = s
  · simp only [h, ↓reduceIte]; rw [← h, ← map_mul, hy]
  · simp only [Ne.symm h, h, ↓reduceIte, map_zero, zero_mul]

/-! ### The left inverse `Θ` -/

omit [DecidableEq I] in
include hρ in
theorem isReducedChoice_through (g : Perm (Fin m)) :
    IsReducedChoice (fun τ => ρ (τ * (throughFrame g τ)⁻¹) ++ ρ (throughFrame g τ)) :=
  isReducedChoice_frame hρ _ (throughFrame_le g)

variable (k Q Λ ρ) in
open Classical in
/-- The value of `Θ` on a basis diagram `ψ x^u e(j)` adapted to `g`: the diagram with `g`
removed from the top, if its top is `s`, its bottom `j` is non-violated of red order `κ`, and it
factors through `g`; zero otherwise. -/
noncomputable def throughValue (g : Perm (Fin m)) (s : Seq μ) (κ : List (Fin ℓ))
    (b : BlackIdx (ℓ := ℓ) ν) : BraidedStendhalAlgebra k Q Λ ν :=
  if b.1.2.1 • b.1.1 = s ∧ redWord b.1.1 = κ ∧ ¬ IsViolated b.1.1 ∧
      invSet m (g⁻¹ * b.1.2.1) ⊆ invSet m b.1.2.1 then
    ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (g⁻¹ * b.1.2.1)) * KLRAlgebra.pol (monomial b.1.2.2 1) *
      KLRAlgebra.e b.1.1)
  else 0

variable (k Q Λ) in
/-- **The left inverse `Θ` of the braiding diagram.** On the basis adapted to `g`, it removes
`g` from the top of the diagrams from a non-violated idempotent of red order `κ` to `s`, and
kills the other basis diagrams. -/
noncomputable def throughMap (g : Perm (Fin m)) (s : Seq μ) (κ : List (Fin ℓ)) :
    BraidedStendhalAlgebra k Q Λ ν →ₗ[k] BraidedStendhalAlgebra k Q Λ ν :=
  (basis hQ _ (isReducedChoice_through hρ g)).constr k (throughValue k Q Λ ρ g s κ)

theorem throughMap_basis (g : Perm (Fin m)) (s : Seq μ) (κ : List (Fin ℓ))
    (b : BlackIdx (ℓ := ℓ) ν) :
    throughMap k Q Λ hρ hQ g s κ (basis hQ _ (isReducedChoice_through hρ g) b) =
      throughValue k Q Λ ρ g s κ b := by
  rw [throughMap, Module.Basis.constr_basis]

/-- `Θ` kills diagrams whose bottom is violated or not of red order `κ`. -/
theorem throughMap_mul_e_eq_zero (g : Perm (Fin m)) (s : Seq μ) (κ : List (Fin ℓ))
    (y : BraidedStendhalAlgebra k Q Λ ν) {j : Seq μ} (hj : IsViolated j ∨ redWord j ≠ κ) :
    throughMap k Q Λ hρ hQ g s κ (y * ofKLR k Q Λ ν (KLRAlgebra.e j)) = 0 := by
  induction (basis hQ _ (isReducedChoice_through hρ g)).mem_span y using
    Submodule.span_induction with
  | zero => rw [zero_mul, map_zero]
  | add x y _ _ hx hy => rw [add_mul, map_add, hx, hy, add_zero]
  | smul c x _ hx => rw [smul_mul_assoc, map_smul, hx, smul_zero]
  | mem x hx =>
    obtain ⟨b, rfl⟩ := hx
    rw [basis_mul_e]
    split_ifs with hb
    · rw [throughMap_basis, throughValue]
      split_ifs with hc
      · obtain ⟨-, hκ, hv, -⟩ := hc
        rw [hb] at hκ hv
        exact hj.elim (fun h => absurd h hv) (fun h => absurd hκ h)
      · rfl
    · rw [map_zero]

theorem throughMap_eq_zero_of_mem_violBottom (g : Perm (Fin m)) (s : Seq μ)
    (κ : List (Fin ℓ)) {y : BraidedStendhalAlgebra k Q Λ ν} (hy : y ∈ violBottom k Q Λ ν) :
    throughMap k Q Λ hρ hQ g s κ y = 0 := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, j, hj, rfl⟩ := hy
    exact throughMap_mul_e_eq_zero hρ hQ g s κ w (Or.inl hj)
  | zero => rw [map_zero]
  | add y y' _ _ hy hy' => rw [map_add, hy, hy', add_zero]
  | smul c y _ hy => rw [map_smul, hy, smul_zero]

/-- **`Θ` is a left inverse of the braiding diagram** modulo diagrams with violated bottom:
`Θ(ψ_{ρ(g)} e(t) x e_κ) ≡ e(t) x e_κ`, provided every diagram `σ` from a non-violated
idempotent of red order `κ` to `t` composes with `g` with lengths adding. -/
theorem throughMap_braid_sub_mem {s t : Seq μ} {κ : List (Fin ℓ)} (g : Perm (Fin m))
    (hgt : g • t = s)
    (hg : ∀ (j : Seq μ) (σ : Perm (Fin m)), σ • j = t → redWord j = κ → ¬ IsViolated j →
      invSet m σ ⊆ invSet m (g * σ))
    (x : BraidedStendhalAlgebra k Q Λ ν) :
    throughMap k Q Λ hρ hQ g s κ
        (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * x * redProj k Q Λ ν κ) -
      ofKLR k Q Λ ν (KLRAlgebra.e t) * x * redProj k Q Λ ν κ ∈ violBottom k Q Λ ν := by
  induction (basis hQ ρ hρ).mem_span x using Submodule.span_induction with
  | zero => simp only [mul_zero, zero_mul, map_zero, sub_zero]; exact zero_mem _
  | add x y _ _ hx hy =>
    convert add_mem hx hy using 1
    simp only [mul_add, add_mul, map_add]
    abel
  | smul c x _ hx =>
    convert Submodule.smul_mem _ c hx using 1
    simp only [mul_smul_comm, smul_mul_assoc, map_smul, smul_sub]
  | mem x hx =>
    obtain ⟨⟨⟨j, σ, u⟩, hu⟩, rfl⟩ := hx
    rw [show ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) =
        ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g)) * ofKLR k Q Λ ν (KLRAlgebra.e t) from map_mul _ _ _,
      mul_assoc (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g))), e_mul_basis]
    dsimp only
    split_ifs with h1
    swap
    · simp only [mul_zero, zero_mul, map_zero, sub_zero]; exact zero_mem _
    rw [mul_assoc (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g))), basis_mul_redProj]
    dsimp only
    split_ifs with h2
    swap
    · simp only [mul_zero, map_zero, sub_zero]; exact zero_mem _
    by_cases hv : IsViolated j
    · have hB : basis hQ ρ hρ ⟨⟨j, σ, u⟩, hu⟩ ∈ violBottom k Q Λ ν := by
        rw [basis_apply, map_mul]; exact mul_e_mem_violBottom _ hv
      rw [throughMap_eq_zero_of_mem_violBottom hρ hQ g s κ (mul_mem_violBottom _ hB),
        zero_sub]
      exact neg_mem hB
    have hle := hg j σ h1 h2 hv
    have hle' : invSet m (g⁻¹ * (g * σ)) ⊆ invSet m (g * σ) := by
      rwa [inv_mul_cancel_left]
    have hf : throughFrame g (g * σ) = σ := by
      simp [throughFrame, hle]
    have hA : ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g)) * basis hQ ρ hρ ⟨⟨j, σ, u⟩, hu⟩ =
        basis hQ _ (isReducedChoice_through hρ g) ⟨⟨j, g * σ, u⟩, hu⟩ := by
      rw [basis_apply, basis_apply, ← map_mul]
      dsimp only
      rw [hf, mul_inv_cancel_right, KLRAlgebra.ψw_append]
      simp only [mul_assoc]
    have hc : (g * σ) • j = s ∧ redWord j = κ ∧ ¬ IsViolated j ∧
        invSet m (g⁻¹ * (g * σ)) ⊆ invSet m (g * σ) :=
      ⟨by rw [mul_smul, h1, hgt], h2, hv, hle'⟩
    rw [hA, throughMap_basis, throughValue]
    dsimp only
    rw [ite_eq_left_of_eq_true _ _ (eq_true hc), inv_mul_cancel_left, basis_apply, sub_self]
    exact zero_mem _

theorem mul_redProj_mem_violBottom (κ : List (Fin ℓ)) {y : BraidedStendhalAlgebra k Q Λ ν}
    (hy : y ∈ violBottom k Q Λ ν) : y * redProj k Q Λ ν κ ∈ violBottom k Q Λ ν := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, j, hj, rfl⟩ := hy
    rw [mul_assoc, redProj, ← map_mul, e_mul_redIdem]
    split_ifs
    · exact mul_e_mem_violBottom _ hj
    · rw [map_zero, mul_zero]; exact zero_mem _
  | zero => rw [zero_mul]; exact zero_mem _
  | add y y' _ _ hy hy' => rw [add_mul]; exact add_mem hy hy'
  | smul c y _ hy => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c hy

omit [DecidableEq I] in
theorem not_isViolated_of_lbl_zero {i : Seq μ} {r : Fin ℓ} (h0 : 0 < m)
    (hi : i.lbl ⟨0, h0⟩ = .inr r) : ¬ IsViolated i := by
  rintro ⟨h, hl⟩
  rw [hi] at hl
  simp at hl

/-! ### The braiding move at the left edge -/

/-- The data of the braiding diagram of Proposition 6.9: the last strand of `s` is `λ_r`, and
`g` carries the leftmost strand of `t` to it, shifting the other strands one step left. -/
structure EdgeBraid (h0 : 0 < m) (r : Fin ℓ) (g : Perm (Fin m)) (s t : Seq μ) : Prop where
  smul_eq : g • t = s
  last : s.lbl ⟨m - 1, by omega⟩ = .inr r
  shift : ∀ x : Fin m, (x : ℕ) ≠ m - 1 → (g⁻¹ x : ℕ) = x + 1

omit [DecidableEq I] in
/-- Every diagram from a non-violated idempotent of red order `r :: L` into `t` composes with
the braiding diagram with lengths adding. -/
theorem EdgeBraid.invSet_subset {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) {L : List (Fin ℓ)} (j : Seq μ) (σ : Perm (Fin m))
    (hσ : σ • j = t) (hκ : redWord j = r :: L) (hv : ¬ IsViolated j) :
    invSet m σ ⊆ invSet m (g * σ) := by
  have hj0 := lbl_zero_of_not_isViolated h0 hv hκ
  have hτ0 : (g * σ) ⟨0, h0⟩ = ⟨m - 1, by omega⟩ := by
    refine lbl_inj_of_inr s r ?_ hb.last
    rw [← hb.smul_eq, ← hσ, ← mul_smul, lbl_smul]
    simpa using hj0
  have := invSet_mul_subset_of_last h0 hb.shift hτ0
  rwa [inv_mul_cancel_left] at this

include hρ in
theorem e_mul_psi_e {g : Perm (Fin m)} {s t : Seq μ} (hgt : g • t = s) :
    ofKLR k Q Λ ν (KLRAlgebra.e s) * ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) =
      ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) := by
  have hy := e_mul_std (Q := Q) (Λ := Λ) (ρ g) 1 t
  rw [(hρ g).2, hgt, map_one, mul_one] at hy
  rw [← map_mul, hy]

/-- **`Θ` maps the violated part into the edge ideal.** For `z` in the violated ideal,
`Θ(e(s) z e_{r :: L})` lies in the ideal generated by the violated idempotents and the
idempotents starting with `λ_r` followed by a black strand. -/
theorem throughMap_mem_edgeIdeal {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (L : List (Fin ℓ)) {z : BraidedStendhalAlgebra k Q Λ ν}
    (hz : z ∈ violIdeal k Q Λ ν) :
    throughMap k Q Λ hρ hQ g s (r :: L)
      (ofKLR k Q Λ ν (KLRAlgebra.e s) * z * redProj k Q Λ ν (r :: L)) ∈ edgeIdeal k Q Λ ν r := by
  rw [violIdeal, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hz
  induction hz using AddSubgroup.closure_induction with
  | zero => simp only [mul_zero, zero_mul, map_zero]; exact zero_mem _
  | add z w _ _ hz hw => simp only [mul_add, add_mul, map_add]; exact add_mem hz hw
  | neg z _ hz => simp only [mul_neg, neg_mul, map_neg]; exact neg_mem hz
  | mem z hz =>
    obtain ⟨_, ⟨a, -, _, ⟨j, hj, rfl⟩, rfl⟩, x', -, rfl⟩ := hz
    -- the red strand `λ_r` of `j` sits at a position `q ≠ 0`
    have : NeZero m := ⟨by omega⟩
    obtain ⟨q, hq⟩ := exists_lbl_eq_inr j r
    have hq0 : q ≠ ⟨0, h0⟩ := by
      rintro rfl
      obtain ⟨_, hl⟩ := hj
      rw [hq] at hl
      simp at hl
    have h1 : 1 < m := by
      have : (q : ℕ) ≠ 0 := fun h => hq0 (Fin.ext h)
      have := q.isLt
      omega
    set tj : Seq μ := Fin.cycleRange q • j with htj
    have htj0 : tj.lbl ⟨0, h0⟩ = .inr r := by
      rw [htj, lbl_smul]
      convert hq
      rw [Perm.inv_eq_iff_eq, Fin.cycleRange_self]
      rfl
    have htj1 : tj.lbl ⟨1, h1⟩ = j.lbl ⟨0, h0⟩ := by
      rw [htj, lbl_smul]
      congr 1
      rw [Perm.inv_eq_iff_eq]
      refine Fin.ext ?_
      rw [coe_cycleRange_apply]
      have hq0' : (q : ℕ) ≠ 0 := fun h => hq0 (Fin.ext h)
      split_ifs with h h'
      · rfl
      · exact absurd h' (by intro h''; exact hq0 h''.symm)
      · exact absurd (Fin.lt_def.2 (Nat.pos_of_ne_zero hq0')) h
    have htv : ¬ IsViolated tj := not_isViolated_of_lbl_zero h0 htj0
    -- `e(j) x' e_κ` factors through the braiding of `λ_r` to the left edge
    obtain ⟨x'', hx''⟩ := exists_e_mul_mul_redProj_sub_mem hρ hQ (s := j) (t := tj)
      (κ := r :: L) (Fin.cycleRange q)⁻¹ (by rw [htj, inv_smul_smul]) (fun j' τ hτ hκ hv => by
        rw [inv_inv]
        refine invSet_cycleRange_mul_subset h0 ?_
        refine lbl_inj_of_inr j r ?_ hq
        rw [← hτ, lbl_smul, ← Perm.mul_apply, inv_mul_cancel, Perm.one_apply]
        exact lbl_zero_of_not_isViolated h0 hv hκ) x'
    obtain ⟨L'', hL''⟩ := exists_redWord_eq_cons h0 htj0
    obtain ⟨c, hc⟩ := exists_e_mul_mul_redProj_sub_mem_of_last hρ hQ (L := L'') h0 g
      hb.smul_eq hb.last hb.shift (a * ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (Fin.cycleRange q)⁻¹)))
    have hEt : redProj k Q Λ ν (r :: L'') * ofKLR k Q Λ ν (KLRAlgebra.e tj) =
        ofKLR k Q Λ ν (KLRAlgebra.e tj) := by
      rw [redProj, ← map_mul, redIdem_mul_e, ite_eq_left_iff.2 (fun h => absurd hL'' h)]
    have hP : redProj k Q Λ ν (r :: L) * redProj k Q Λ ν (r :: L) =
        redProj k Q Λ ν (r :: L) := by
      rw [redProj, ← map_mul, redIdem_mul_redIdem]
    have hsplit : ofKLR k Q Λ ν (KLRAlgebra.e s) * (a * ofKLR k Q Λ ν (KLRAlgebra.e j) * x') *
        redProj k Q Λ ν (r :: L) =
        ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) *
            (c * ofKLR k Q Λ ν (KLRAlgebra.e tj) * x'') * redProj k Q Λ ν (r :: L) +
          ofKLR k Q Λ ν (KLRAlgebra.e s) * a *
            ((ofKLR k Q Λ ν (KLRAlgebra.e j) * x' * redProj k Q Λ ν (r :: L) -
              ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (Fin.cycleRange q)⁻¹) * KLRAlgebra.e tj) * x'') *
              redProj k Q Λ ν (r :: L)) +
          (ofKLR k Q Λ ν (KLRAlgebra.e s) *
              (a * ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (Fin.cycleRange q)⁻¹))) *
              redProj k Q Λ ν (r :: L'') -
            ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * c) *
            (ofKLR k Q Λ ν (KLRAlgebra.e tj) * x'' * redProj k Q Λ ν (r :: L)) := by
      have hψe : ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (Fin.cycleRange q)⁻¹) * KLRAlgebra.e tj) =
          ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (Fin.cycleRange q)⁻¹)) *
            ofKLR k Q Λ ν (KLRAlgebra.e tj) := map_mul _ _ _
      rw [hψe]
      simp only [sub_mul, mul_sub, ← mul_assoc]
      rw [mul_assoc _ (redProj k Q Λ ν (r :: L'')), hEt, mul_assoc _ (redProj k Q Λ ν (r :: L)),
        hP]
      noncomm_ring
    beta_reduce
    rw [hsplit, map_add, map_add]
    have hy₂e := mul_e_eq_zero_of_mem_violBottom hc htv
    rw [show ∀ y : BraidedStendhalAlgebra k Q Λ ν, y * (ofKLR k Q Λ ν (KLRAlgebra.e tj) * x'' *
        redProj k Q Λ ν (r :: L)) = y * ofKLR k Q Λ ν (KLRAlgebra.e tj) * x'' *
          redProj k Q Λ ν (r :: L) from fun y => by noncomm_ring, hy₂e, zero_mul, zero_mul,
      map_zero, add_zero]
    rw [throughMap_eq_zero_of_mem_violBottom hρ hQ g s (r :: L)
      (mul_mem_violBottom _ (mul_redProj_mem_violBottom _ hx'')), add_zero]
    have hθ := throughMap_braid_sub_mem hρ hQ (κ := r :: L) g hb.smul_eq
      (fun j σ hσ hκ hv => hb.invSet_subset j σ hσ hκ hv)
      (c * ofKLR k Q Λ ν (KLRAlgebra.e tj) * x'')
    have hgen : ofKLR k Q Λ ν (KLRAlgebra.e tj) ∈ edgeIdeal k Q Λ ν r :=
      TwoSidedIdeal.subset_span ⟨tj, Or.inr ⟨h1, htj0, by rw [htj1]; exact hj.2⟩, rfl⟩
    have hmain : ofKLR k Q Λ ν (KLRAlgebra.e t) * (c * ofKLR k Q Λ ν (KLRAlgebra.e tj) * x'') *
        redProj k Q Λ ν (r :: L) ∈ edgeIdeal k Q Λ ν r := by
      exact TwoSidedIdeal.mul_mem_right _ _ _ (TwoSidedIdeal.mul_mem_left _ _ _
        (TwoSidedIdeal.mul_mem_right _ _ _ (TwoSidedIdeal.mul_mem_left _ _ _ hgen)))
    simpa using add_mem (mem_edgeIdeal_of_mem_violBottom r hθ) hmain

include hρ hQ in
/-- **Injectivity step of Proposition 6.9** (arXiv:1309.3796v2, two red strands). Let the
leftmost strand of `t` be `λ_r`, carried by `g` to the last strand of `s` with the other strands
shifted one step left. If `ψ_{ρ(g)} e(t) x e_{r :: L}` lies in the ideal generated by violated
idempotents, then `e(t) x e_{r :: L}` lies in the ideal `U_r` generated by the violated
idempotents and by the idempotents starting with `λ_r` followed by a black strand. -/
theorem mem_edgeIdeal_of_mem_violIdeal {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)}
    {s t : Seq μ} (hb : EdgeBraid h0 r g s t) (L : List (Fin ℓ))
    (x : BraidedStendhalAlgebra k Q Λ ν)
    (hx : ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * x * redProj k Q Λ ν (r :: L) ∈
      violIdeal k Q Λ ν) :
    ofKLR k Q Λ ν (KLRAlgebra.e t) * x * redProj k Q Λ ν (r :: L) ∈ edgeIdeal k Q Λ ν r := by
  have hP : redProj k Q Λ ν (r :: L) * redProj k Q Λ ν (r :: L) =
      redProj k Q Λ ν (r :: L) := by
    rw [redProj, ← map_mul, redIdem_mul_redIdem]
  have hz : ofKLR k Q Λ ν (KLRAlgebra.e s) *
      (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * x * redProj k Q Λ ν (r :: L)) *
        redProj k Q Λ ν (r :: L) =
      ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * x * redProj k Q Λ ν (r :: L) := by
    simp only [mul_assoc, hP]
    rw [← mul_assoc, e_mul_psi_e hρ hb.smul_eq]
  have h2 := throughMap_mem_edgeIdeal hρ hQ hb L hx
  rw [hz] at h2
  have h1 := throughMap_braid_sub_mem hρ hQ (κ := r :: L) g hb.smul_eq
    (fun j σ hσ hκ hv => hb.invSet_subset j σ hσ hκ hv) x
  simpa using sub_mem h2 (mem_edgeIdeal_of_mem_violBottom r h1)

end BraidedStendhalAlgebra

end Categorification.Stendhal
