import Categorification.KLR.CyclotomicAction.Universal

/-!
# Traces of powers modulo the universal cyclotomic polynomial

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2, proof of
**Proposition 3.25**. At the vacuum of `Ř^λ`, a counterclockwise bubble of colour `j` with
`λ^j + n` dots acts by the coefficient of `y^{λ^j - 1}` in `y^{λ^j + n}` modulo the universal
cyclotomic polynomial `a_j(y)`; this is the complete symmetric function `h_{n+1}(p_j)`. Webster
uses that these elements generate `Ř^λ_λ` (they are the bubbles that identify `End_𝒰(λ)` with
`Ř^λ_λ` modulo the maps factoring through `E_j`).

* `vacTrace j m`: the coefficient of `y^{λ^j - 1}` in `y^m mod a_j(y)`;
* `vacTrace_recurrence`: `vacTrace j (a + λ^j) = ∑_n (-1)^n e_{n+1}(p_j) vacTrace j (a + λ^j - 1 - n)`;
* `vacTrace_sub_mem`: `vacTrace j (λ^j + n) - (-1)^n e_{n+1}(p_j)` lies in the subalgebra
  generated by `e_1(p_j), …, e_n(p_j)`;
* `adjoin_vacTrace_eq_top`: the elements `vacTrace j (λ^j + n)`, `n < λ^j`, generate `Ř^λ_λ`.
-/

namespace Categorification.KLR.CyclotomicAction

open Polynomial

universe u v

noncomputable section

variable {I : Type u} (k : Type v) [CommRing k] (lam : I → ℕ)

/-- The coefficient of `y^{λ^j - 1}` in `y^m` modulo `univCycPoly k lam j`. -/
def vacTrace (j : I) (m : ℕ) : UnivCycRing k lam :=
  ((X ^ m : (UnivCycRing k lam)[X]) %ₘ univCycPoly k lam j).coeff (lam j - 1)

/-- The variable `e_{n+1}(p_j)` of `Ř^λ_λ`. -/
abbrev elemSym (j : I) (n : Fin (lam j)) : UnivCycRing k lam :=
  MvPolynomial.X (⟨j, n⟩ : Σ j : I, Fin (lam j))

/-- `vacTrace` as the value of a linear map on `X ^ m`. -/
private theorem vacTrace_eq_lin (j : I) (m : ℕ) :
    vacTrace k lam j m = (lcoeff _ (lam j - 1)).comp (modByMonicHom (univCycPoly k lam j))
      (X ^ m) := rfl

variable [Nontrivial k]

theorem vacTrace_of_lt (j : I) {m : ℕ} (hm : m < lam j) :
    vacTrace k lam j m = if m = lam j - 1 then 1 else 0 := by
  unfold vacTrace
  rw [(modByMonic_eq_self_iff (univCycPoly_monic k lam j)).2, coeff_X_pow]
  · by_cases h : m = lam j - 1
    · simp [h]
    · simp [h, Ne.symm h]
  · rw [degree_X_pow, degree_eq_natDegree (univCycPoly_monic k lam j).ne_zero,
      univCycPoly_natDegree]
    exact_mod_cast hm

omit [Nontrivial k] in
/-- **The recurrence for `vacTrace`**, from `y^a a_j(y) ≡ 0`. -/
theorem vacTrace_recurrence (j : I) (a : ℕ) :
    vacTrace k lam j (a + lam j) = ∑ n : Fin (lam j),
      (-1) ^ n.val * elemSym k lam j n * vacTrace k lam j (a + (lam j - (n.val + 1))) := by
  set L := (lcoeff (UnivCycRing k lam) (lam j - 1)).comp
    (modByMonicHom (univCycPoly k lam j))
  have h0 : L (X ^ a * univCycPoly k lam j) = 0 := by
    change ((X ^ a * univCycPoly k lam j) %ₘ univCycPoly k lam j).coeff _ = 0
    rw [(modByMonic_eq_zero_iff_dvd (univCycPoly_monic k lam j)).2 (dvd_mul_left _ _),
      coeff_zero]
  have hexp : X ^ a * univCycPoly k lam j = X ^ (a + lam j) + ∑ n : Fin (lam j),
      ((-1) ^ (n.val + 1) * elemSym k lam j n) • (X ^ (a + (lam j - (n.val + 1))) :
        (UnivCycRing k lam)[X]) := by
    rw [univCycPoly, mul_add, ← pow_add, univCycTail, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [smul_eq_C_mul, mul_left_comm, ← pow_add]
  rw [hexp, map_add, map_sum] at h0
  simp only [map_smul, smul_eq_mul] at h0
  rw [vacTrace_eq_lin, ← sub_eq_zero, sub_eq_add_neg, ← Finset.sum_neg_distrib]
  convert h0 using 2
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [vacTrace_eq_lin, pow_succ]
  ring

/-- The subalgebra generated by `e_1(p_j), …, e_n(p_j)`. -/
def elemSymAdjoin (j : I) (n : ℕ) : Subalgebra k (UnivCycRing k lam) :=
  Algebra.adjoin k {x | ∃ r : Fin (lam j), r.val < n ∧ x = elemSym k lam j r}

omit [Nontrivial k] in
theorem elemSymAdjoin_mono (j : I) {m n : ℕ} (h : m ≤ n) :
    elemSymAdjoin k lam j m ≤ elemSymAdjoin k lam j n :=
  Algebra.adjoin_mono fun _ ⟨r, hr, e⟩ => ⟨r, hr.trans_le h, e⟩

omit [Nontrivial k] in
theorem elemSym_mem_elemSymAdjoin (j : I) (r : Fin (lam j)) {n : ℕ} (h : r.val < n) :
    elemSym k lam j r ∈ elemSymAdjoin k lam j n :=
  Algebra.subset_adjoin ⟨r, h, rfl⟩

/-- **Triangularity**: `vacTrace j (λ^j + n) ≡ (-1)^n e_{n+1}(p_j)` modulo the subalgebra
generated by `e_1(p_j), …, e_n(p_j)`. -/
theorem vacTrace_sub_mem (j : I) (n : ℕ) (hn : n < lam j) :
    vacTrace k lam j (lam j + n) - (-1) ^ n * elemSym k lam j ⟨n, hn⟩ ∈
      elemSymAdjoin k lam j n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  have h1 : vacTrace k lam j (n + (lam j - (n + 1))) = 1 := by
    rw [vacTrace_of_lt k lam j (by omega)]
    simp only [ite_eq_left_iff]
    omega
  rw [add_comm, vacTrace_recurrence,
    ← Finset.add_sum_erase _ _ (Finset.mem_univ (⟨n, hn⟩ : Fin (lam j))), Fin.val_mk, h1,
    mul_one, add_sub_cancel_left]
  refine Subalgebra.sum_mem _ fun r hr => ?_
  have hr' : r ≠ ⟨n, hn⟩ := Finset.ne_of_mem_erase hr
  rcases lt_or_gt_of_ne (fun h => hr' (Fin.ext h) : r.val ≠ n) with h | h
  · refine Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _
      (Subalgebra.neg_mem _ (Subalgebra.one_mem _)) _) (elemSym_mem_elemSymAdjoin k lam j r h)) ?_
    have hm : n - r.val - 1 < n := by omega
    have := elemSymAdjoin_mono k lam j (by omega : n - r.val - 1 ≤ n)
      (ih _ hm (by omega))
    have he := elemSym_mem_elemSymAdjoin k lam j (⟨n - r.val - 1, by omega⟩ : Fin (lam j)) hm
    have hsum := Subalgebra.add_mem _ this (Subalgebra.mul_mem _ (Subalgebra.pow_mem _
      (Subalgebra.neg_mem _ (Subalgebra.one_mem _)) (n - r.val - 1)) he)
    rw [sub_add_cancel] at hsum
    convert hsum using 2
    omega
  · have h0 : vacTrace k lam j (n + (lam j - (r.val + 1))) = 0 := by
      rw [vacTrace_of_lt k lam j (by omega)]
      simp only [ite_eq_right_iff]
      omega
    rw [h0, mul_zero]
    exact Subalgebra.zero_mem _

/-- **The traces generate `Ř^λ_λ`**: the elements `vacTrace j (λ^j + n)`, `j ∈ I`, `n < λ^j`,
generate `Ř^λ_λ` as a `k`-algebra. -/
theorem adjoin_vacTrace_eq_top :
    Algebra.adjoin k (Set.range fun x : Σ j : I, Fin (lam j) =>
      vacTrace k lam x.1 (lam x.1 + x.2.val)) = ⊤ := by
  set T := Algebra.adjoin k (Set.range fun x : Σ j : I, Fin (lam j) =>
      vacTrace k lam x.1 (lam x.1 + x.2.val))
  have key : ∀ j (n : ℕ) (hn : n < lam j), elemSym k lam j ⟨n, hn⟩ ∈ T := by
    intro j n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro hn
    have hS : elemSymAdjoin k lam j n ≤ T :=
      Algebra.adjoin_le fun _ ⟨r, hr, e⟩ => e ▸ ih r.val hr r.isLt
    have ht : vacTrace k lam j (lam j + n) ∈ T :=
      Algebra.subset_adjoin ⟨⟨j, ⟨n, hn⟩⟩, rfl⟩
    have h := Subalgebra.sub_mem _ ht (hS (vacTrace_sub_mem k lam j n hn))
    rw [sub_sub_cancel] at h
    have h2 := Subalgebra.mul_mem _ (Subalgebra.pow_mem _
      (Subalgebra.neg_mem _ (Subalgebra.one_mem T)) n) h
    rwa [← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul] at h2
  rw [eq_top_iff, ← MvPolynomial.adjoin_range_X]
  exact Algebra.adjoin_le fun _ ⟨x, e⟩ => e ▸ key x.1 x.2.val x.2.isLt

end

end Categorification.KLR.CyclotomicAction
