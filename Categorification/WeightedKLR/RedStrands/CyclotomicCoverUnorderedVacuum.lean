import Categorification.WeightedKLR.RedStrands.DoubleCLVacuumFunctor
import Categorification.KLR.CyclotomicAction.VacuumCyclic
import Categorification.TwoRep.RouqUpWords

/-!
# Upward words with unordered reds vanish on the projected vacuum

Webster, arXiv:1309.3796v3, §4.6, proof of Lemma 4.29. The upward word of a sequence `t` of the
extended datum applied to the cyclotomic vacuum is generated by one vector, fixed by the
idempotent of the reversed sequence (`exists_eq_mul_e_smul_vgen`). If the red strands of the
reversed sequence are not in the order `λ_1, …, λ_ℓ`, that idempotent lies in the kernel of the
projection to the tensor-product algebra (`cyclotomicCoverToTensor_e_unordered`), so the word
module vanishes after extension of scalars (`isZero_vacuumWord_unordered`).
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal

open CategoryTheory CategoryTheory.Limits QuantumGroup QuantumGroup.UDot StringDiagrams KLR
  TwoRep CyclotomicAction KL3.Diagram Diagrams.BicatInterp InductionAlong KLRAlgebra

universe u v w

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type u} [DecidableEq I] {k : Type v} [Field k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} (Λ : Fin ℓ → I →₀ ℕ) (ν : Multiset I)
  (C : CartanDatum I)

/-- **Unordered red idempotents project to zero** in the tensor-product algebra. -/
theorem cyclotomicCoverToTensor_e_unordered (s : Seq (stendhalWeight ℓ ν))
    (hs : ¬ IsRedOrdered s) :
    cyclotomicCoverToTensor (Q := Q) Λ ν C
      (CycKLR.mk k (cyclotomicCoverQ C Λ Q) cyclotomicCoverPolynomial _ (e s)) = 0 := by
  have h : CycKLR.mk k (cyclotomicCoverQ C Λ Q) cyclotomicCoverPolynomial _ (e s) ∈
      TwoSidedIdeal.ker (cyclotomicCoverToTensor (Q := Q) Λ ν C).toRingHom := by
    rw [cyclotomicCoverToTensor_ker]
    exact TwoSidedIdeal.subset_span (Or.inr ⟨s, hs, rfl⟩)
  exact (TwoSidedIdeal.mem_ker _).mp h

variable (hQ : IsRouquierQ C Q)

local notation "Wgt" => cyclotomicCoverWeightDatum Λ C
local notation "L" => cyclotomicCoverHighest (I := I) (ℓ := ℓ)
local notation "S" => cyclotomicCoverQ C Λ Q
local notation "hS" => isRouquierQ_cyclotomicCoverQ C Λ Q hQ
local notation "sym" => IsRouquierQ.klrSymm hS
local notation "lead" => IsRouquierQ.polyInY_leading hS
local notation "deg" => IsRouquierQ.polyInY_degree_pair hS Wgt
local notation "p" => cyclotomicCoverPolynomial (I := I) (ℓ := ℓ) (k := k)
local notation "monic" => cyclotomicCoverPolynomial_monic (k := k)
local notation "topDeg" => cyclotomicCoverPolynomial_natDegree (k := k) Λ C
local notation "wt₀" => (blockWeight Wgt L 0 : I ⊕ Fin ℓ → ℤ)
local notation "π" => cyclotomicCoverToTensor (Q := Q) Λ ν C
set_option quotPrecheck false in
set_option hygiene false in
local notation "Fam" => cyclotomicFamily.{u, v, w} sym lead monic Wgt L topDeg deg
set_option quotPrecheck false in
set_option hygiene false in
local notation "V" => emptyBlockObj.{u,v,w} S p Wgt L

/-- The cyclotomic vacuum is generated by the unit of `R^Λ(∅)`. -/
theorem emptyBlockObj_cyclic (x : V ⟨0, rfl⟩) :
    ∃ z : CycKLR k S p 0, x = z • (fun _ => ULift.up 1 : V ⟨0, rfl⟩) := by
  refine ⟨(x ⟨rfl⟩).down, ?_⟩
  funext q
  obtain rfl : q = ⟨rfl⟩ := rfl
  apply ULift.ext
  change (x ⟨rfl⟩).down = (x ⟨rfl⟩).down * 1
  rw [mul_one]

/-- **The vacuum word of a sequence with unordered reversed reds vanishes after projection.** -/
theorem isZero_wordCell_unordered (t : Seq (stendhalWeight ℓ ν))
    (ht : ¬ IsRedOrdered t.rev) :
    IsZero ((functor (RingHom.toNonUnitalRingHom (AlgHom.toRingHom π))).obj
      (((RouqData.wordCell (Fam).toRouqData wt₀ t).obj.obj
        (familyObj sym lead monic topDeg deg V))
        (topBlk (RD := Wgt) (Λ := L) (μ := wt₀) rfl))) := by
  have he : RingHom.toNonUnitalRingHom (AlgHom.toRingHom π)
      (CycKLR.mk k S p _
        (e (wseq (wordL Wgt wt₀ t) (topBlk_eq (RD := Wgt) (Λ := L) (μ := wt₀) rfl t)))) = 0 := by
    rw [wseq_wordL (RD := Wgt) (Λ := L) (μ := wt₀) rfl t]
    exact cyclotomicCoverToTensor_e_unordered Λ ν C t.rev ht
  have : Subsingleton (Ind ((RouqData.wcell (Fam).toRouqData wt₀ (wordL Wgt wt₀ t) _
      (wValid_wordL wt₀ t)).obj.obj V (topBlk (RD := Wgt) (Λ := L) (μ := wt₀) rfl) : Type _)
      (RingHom.toNonUnitalRingHom (AlgHom.toRingHom π))) :=
    ⟨fun a b => (ind_word_eq_zero sym lead monic topDeg deg V rfl _ (emptyBlockObj_cyclic Λ C)
      _ _ _ _ _ _ he a).trans (ind_word_eq_zero sym lead monic topDeg deg V rfl _
        (emptyBlockObj_cyclic Λ C) _ _ _ _ _ _ he b).symm⟩
  exact @ModuleCat.isZero_of_subsingleton _ _ _ this

/-- **Upward words with unordered reversed reds vanish on the projected vacuum.** The image of
the upward word `E_t 1` under the interpretation, applied to the cyclotomic vacuum, has zero
component at the Stendhal block after extension of scalars to the tensor-product algebra. -/
theorem isZero_vacuumWord_unordered (t : Seq (stendhalWeight ℓ ν)) (ht : ¬ IsRedOrdered t.rev)
    {s : I ⊕ Fin ℓ → ℤ} (hν : blockWeight Wgt L (stendhalWeight ℓ ν) = s)
    {w : List (Col (I ⊕ Fin ℓ) (I ⊕ Fin ℓ → ℤ))} (h : (psig Wgt).ok s w)
    (he : (psig Wgt).endR s w = wt₀)
    (hw : w = (ob Wgt wt₀ (ups (KLR.Diagram.word t))).word) :
    IsZero ((functor (RingHom.toNonUnitalRingHom (AlgHom.toRingHom π))).obj
      ((((Fam).model.word s w wt₀ h he).obj.obj (coverVacuum.{u, v, w} Λ C hQ))
        ⟨stendhalWeight ℓ ν, hν⟩)) := by
  subst hw
  obtain rfl : s = wtop Wgt wt₀ (stendhalWeight ℓ ν) :=
    hν.symm.trans (blockWeight_wtop (RD := Wgt) (Λ := L) (μ := wt₀) rfl)
  let i := (Fam).upIso wt₀ t (RouqFamily.cond_word (RD := Wgt) wt₀ t)
  let W := coverVacuum.{u, v, w} Λ C hQ
  let δ : WeightBlocks Wgt L (wtop Wgt wt₀ (stendhalWeight ℓ ν)) := ⟨stendhalWeight ℓ ν, hν⟩
  let j : ((((Fam).model.word _ _ wt₀ h he).obj.obj W) δ : ModuleCat _) ≅
      (((RouqData.wordCell (Fam).toRouqData wt₀ t).obj.obj W) δ) :=
    { hom := i.hom.hom.app W δ
      inv := i.inv.hom.app W δ
      hom_inv_id := congrArg (fun f => f.hom.app W δ) i.hom_inv_id
      inv_hom_id := congrArg (fun f => f.hom.app W δ) i.inv_hom_id }
  exact (isZero_wordCell_unordered Λ ν C hQ t ht).of_iso
    ((functor (RingHom.toNonUnitalRingHom (AlgHom.toRingHom π))).mapIso j)
