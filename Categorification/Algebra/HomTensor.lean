import Categorification.Algebra.BalancedTensor

/-!
# Additive functors on objects generated by one object

Let `F : C ⥤ D` be a `k`-linear functor of `k`-linear categories, `O` an object of `C` and `O'`
an object of `D`. Write `A = End O` and `A' = End O'`. Morphisms `O ⟶ X` form a right
`A`-module, and `O' ⟶ F O` is an `(A, A')`-bimodule: `A` acts through `F` by postcomposition and
`A'` by precomposition. Composition gives a natural `A'`-linear map

`(O ⟶ X) ⊗_A (O' ⟶ F O) → (O' ⟶ F X)`,   `φ ⊗ β ↦ β ≫ F φ`,

which is an isomorphism whenever the identity of `X` factors through finitely many copies of `O`
(`homTensorEquiv`). This is the form of the Eilenberg–Watts theorem used to pass from a
categorical action on a category generated by one object `O` to bimodules over `End O`.

Right modules are written as left modules over the opposite ring, so the tensor product is the
balanced tensor product `(O' ⟶ F O) ⊗_{Aᵐᵒᵖ} (O ⟶ X)` of `BalancedTensor`.

## Main definitions

* `HomTensor.bimodule`: the right `Aᵐᵒᵖ`-action on `O' ⟶ F O` through `F`.
* `HomTensor.map`: the composition map, natural in `X` (`HomTensor.map_naturality`).
* `HomTensor.equiv`: it is an isomorphism when `𝟙 X = ∑ⱼ πⱼ ≫ ιⱼ` with `πⱼ : X ⟶ O`,
  `ιⱼ : O ⟶ X`.
-/

namespace Categorification.HomTensor

open CategoryTheory MulOpposite

noncomputable section

variable (k : Type*) [CommRing k] {C : Type*} [Category C] [Preadditive C] [Linear k C]
  {D : Type*} [Category D] [Preadditive D] [Linear k D]
  (F : C ⥤ D) [F.Additive] [F.Linear k] (O : C) (O' : D)

/-- `End O` acts on `O' ⟶ F O` through `F` by postcomposition; as a right action of
`(End O)ᵐᵒᵖ` this is a module over `(End O)ᵐᵒᵖᵐᵒᵖ`. -/
@[reducible] def bimodule : Module (End O)ᵐᵒᵖᵐᵒᵖ (O' ⟶ F.obj O) where
  smul a β := β ≫ F.map a.unop.unop
  one_smul β := by
    change β ≫ F.map (𝟙 O) = β
    rw [F.map_id, Category.comp_id]
  mul_smul a b β := by
    change β ≫ F.map ((a * b).unop.unop) = (β ≫ F.map b.unop.unop) ≫ F.map a.unop.unop
    rw [Category.assoc, ← F.map_comp]
    rfl
  smul_zero a := Limits.zero_comp
  smul_add a β β' := Preadditive.add_comp _ _ _ _ _ _
  add_smul a b β := by
    change β ≫ F.map ((a + b).unop.unop) = β ≫ F.map a.unop.unop + β ≫ F.map b.unop.unop
    rw [← Preadditive.comp_add, ← F.map_add]
    rfl
  zero_smul β := by
    change β ≫ F.map (0 : O ⟶ O) = 0
    rw [F.map_zero, Limits.comp_zero]

attribute [local instance] bimodule

theorem op_smul_def (a : (End O)ᵐᵒᵖ) (β : O' ⟶ F.obj O) :
    op a • β = β ≫ F.map a.unop := rfl

instance : IsScalarTower k (End O')ᵐᵒᵖ (O' ⟶ F.obj O) where
  smul_assoc c a β := by
    change (c • a).unop ≫ β = c • (a.unop ≫ β)
    rw [show (c • a).unop = c • a.unop from rfl, Linear.smul_comp]

instance : SMulCommClass (End O')ᵐᵒᵖ (End O)ᵐᵒᵖᵐᵒᵖ (O' ⟶ F.obj O) where
  smul_comm b a β := by
    change b.unop ≫ β ≫ F.map a.unop.unop = (b.unop ≫ β) ≫ F.map a.unop.unop
    rw [Category.assoc]

variable {O} in
instance (X : C) : IsScalarTower k (End O)ᵐᵒᵖ (O ⟶ X) where
  smul_assoc c a f := by
    change (c • a).unop ≫ f = c • (a.unop ≫ f)
    rw [show (c • a).unop = c • a.unop from rfl, Linear.smul_comp]

variable {O} in
/-- Postcomposition with `g : X ⟶ Y`, as a map of right `End O`-modules. -/
def postcomp {X Y : C} (g : X ⟶ Y) : (O ⟶ X) →ₗ[(End O)ᵐᵒᵖ] (O ⟶ Y) where
  toFun f := f ≫ g
  map_add' _ _ := Preadditive.add_comp _ _ _ _ _ _
  map_smul' _ _ := Category.assoc _ _ _

variable (X : C)

/-- The composition bilinear map `β, φ ↦ β ≫ F φ`. -/
def bil : (O' ⟶ F.obj O) →ₗ[k] (O ⟶ X) →ₗ[k] (O' ⟶ F.obj X) :=
  LinearMap.mk₂ k (fun β φ => β ≫ F.map φ)
    (fun β β' φ => Preadditive.add_comp _ _ _ _ _ _)
    (fun c β φ => Linear.smul_comp _ _ _ _ _ _)
    (fun β φ φ' => by rw [F.map_add, Preadditive.comp_add])
    (fun c β φ => by rw [Functor.map_smul, Linear.comp_smul])

/-- **The composition map** `(O' ⟶ F O) ⊗_{(End O)ᵐᵒᵖ} (O ⟶ X) → (O' ⟶ F X)`,
`β ⊗ φ ↦ β ≫ F φ`. It is linear for the right action of `End O'`. -/
def map : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ F.obj O) (O ⟶ X) →ₗ[(End O')ᵐᵒᵖ]
    (O' ⟶ F.obj X) :=
  BalancedTensor.liftB (bil k F O O' X)
    (fun β a φ => by
      change (β ≫ F.map a.unop) ≫ F.map φ = β ≫ F.map (a.unop ≫ φ)
      rw [F.map_comp, Category.assoc])
    (fun b β φ => by
      change (b.unop ≫ β) ≫ F.map φ = b.unop ≫ β ≫ F.map φ
      rw [Category.assoc])

@[simp] theorem map_tmul (β : O' ⟶ F.obj O) (φ : O ⟶ X) :
    map k F O O' X (BalancedTensor.tmul β φ) = β ≫ F.map φ := rfl

/-- The composition map is natural in `X`. -/
theorem map_naturality {X Y : C} (g : X ⟶ Y)
    (t : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ F.obj O) (O ⟶ X)) :
    map k F O O' Y (BalancedTensor.mapRight (postcomp g) t) = map k F O O' X t ≫ F.map g := by
  induction t using BalancedTensor.induction_on with
  | zero => rw [map_zero, map_zero, map_zero, Limits.zero_comp]
  | tmul β φ =>
    change β ≫ F.map (φ ≫ g) = (β ≫ F.map φ) ≫ F.map g
    rw [F.map_comp, Category.assoc]
  | add x y hx hy =>
    rw [map_add, map_add, map_add, hx, hy, Preadditive.add_comp]

variable {X} {J : Type*} [Fintype J] (π : J → (X ⟶ O)) (ι : J → (O ⟶ X))

/-- The inverse of the composition map, for `𝟙 X = ∑ⱼ πⱼ ≫ ιⱼ`. -/
def inv : (O' ⟶ F.obj X) →ₗ[k]
    BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ F.obj O) (O ⟶ X) where
  toFun ψ := ∑ j, BalancedTensor.tmul (ψ ≫ F.map (π j)) (ι j)
  map_add' ψ ψ' := by
    simp only [Preadditive.add_comp, BalancedTensor.add_tmul, Finset.sum_add_distrib]
  map_smul' c ψ := by
    simp only [Linear.smul_comp, BalancedTensor.smul_tmul, Finset.smul_sum, RingHom.id_apply]

variable (h : ∑ j, π j ≫ ι j = 𝟙 X)
include h

theorem map_inv (ψ : O' ⟶ F.obj X) : map k F O O' X (inv k F O O' π ι ψ) = ψ := by
  change map k F O O' X (∑ j, BalancedTensor.tmul (ψ ≫ F.map (π j)) (ι j)) = ψ
  rw [map_sum]
  simp only [map_tmul, Category.assoc, ← F.map_comp]
  rw [← Preadditive.comp_sum, ← Functor.map_sum, h, F.map_id, Category.comp_id]

theorem inv_map (t : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ F.obj O) (O ⟶ X)) :
    inv k F O O' π ι (map k F O O' X t) = t := by
  induction t using BalancedTensor.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul β φ =>
    change ∑ j, BalancedTensor.tmul ((β ≫ F.map φ) ≫ F.map (π j)) (ι j) =
      BalancedTensor.tmul β φ
    have hj : ∀ j, BalancedTensor.tmul (k := k) (B := (End O')ᵐᵒᵖ) (A := (End O)ᵐᵒᵖ)
        ((β ≫ F.map φ) ≫ F.map (π j)) (ι j) = BalancedTensor.tmul β (φ ≫ π j ≫ ι j) := by
      intro j
      rw [Category.assoc, ← F.map_comp]
      exact BalancedTensor.op_smul_tmul (k := k) (B := (End O')ᵐᵒᵖ)
        (A := (End O)ᵐᵒᵖ) β (op (show End O from φ ≫ π j)) (ι j)
        |>.trans (by rw [← Category.assoc]; rfl)
    simp only [hj]
    rw [← BalancedTensor.tmul_sum, ← Preadditive.comp_sum, h, Category.comp_id]
  | add x y hx hy => rw [map_add, map_add, hx, hy]

/-- **The composition map is an isomorphism** when the identity of `X` factors through
finitely many copies of `O`: `(O' ⟶ F O) ⊗_{(End O)ᵐᵒᵖ} (O ⟶ X) ≃ (O' ⟶ F X)`, linearly for
the right action of `End O'`. -/
def equiv : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ F.obj O) (O ⟶ X) ≃ₗ[(End O')ᵐᵒᵖ]
    (O' ⟶ F.obj X) :=
  { map k F O O' X with
    invFun := inv k F O O' π ι
    left_inv := inv_map k F O O' π ι h
    right_inv := map_inv k F O O' π ι h }

@[simp] theorem equiv_tmul (β : O' ⟶ F.obj O) (φ : O ⟶ X) :
    equiv k F O O' π ι h (BalancedTensor.tmul β φ) = β ≫ F.map φ := rfl

end

end Categorification.HomTensor
