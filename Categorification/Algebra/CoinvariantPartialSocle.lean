import Categorification.Algebra.NilHeckeSimple

/-!
# A partial socle of the coinvariant module of `NH_N`

Let `L_N = k[x_0, …, x_{N-1}] / (Sym⁺)` be the irreducible representation of the nilHecke ring
`NH_N` (`Categorification.Coinv`). For `i ≤ N` let `e_{i} = x^{δ_i} ∂_{w_0^{(i)}}` be the
idempotent of the parabolic nilHecke ring `NH_i ⊆ NH_N` on the first `i` strands
(`NilHecke.idemNHAt`).

This file proves: **if `e_i v = v` and `x_a v = 0` for every `a ≥ i`, then `x_a v = 0` for every
`a`**, so `v` lies on the line `k x^{δ_N}` (`NilHecke.mem_coinvSocle_of_idemNHAt`).

This is the input from the nilHecke ring used in the proof of Chuang–Rouquier,
arXiv:math/0407205v2, Proposition 5.20 (b) (the analogue for the nilHecke ring of the statement
about the socle of the restriction of the simple module of the affine Hecke algebra, Lemma 3.6
there). Proof: write `v = x^{δ_i} w` with `w = ∂_{w_0^{(i)}} v`; `w` is again killed by the
`x_a`, `a ≥ i`. For `a < i`, `x_a x^{δ_i}` has degree `i(i-1)/2 + 1` in the first `i`
variables, so it lies in the ideal generated by the elementary symmetric polynomials
`e_r(x_0, …, x_{i-1})`, `r ≥ 1`; and `e_r(x_0, …, x_{i-1}) ≡ e_r(x_0, …, x_{N-1})` modulo
the `x_a`, `a ≥ i`, while `e_r(x_0, …, x_{N-1})` acts by `0` on `L_N`.
-/

namespace Categorification.NilHecke

open MvPolynomial

variable {k : Type*} [Field k] {N : ℕ}

/-! ### Operators of `NH_i` commute with the outer variables -/

theorem mulX_mul_ddw_of_forall {ρ : List ℕ} {b : Fin N} (hb : ∀ j ∈ ρ, j + 1 < b) :
    mulX k N b * ddw ρ = ddw ρ * mulX k N b := by
  induction ρ with
  | nil => simp
  | cons j ρ ih =>
    rw [ddw_cons, ← mul_assoc, ← dd_mul_mulX j b (by have := hb j (by simp); omega)
      (by have := hb j (by simp); omega), mul_assoc, ih fun l hl => hb l (by simp [hl]),
      mul_assoc]

theorem mulX_mul_ddw_w0Word {i : ℕ} {b : Fin N} (hb : i ≤ b) :
    mulX k N b * ddw (w0Word i) = ddw (w0Word i) * mulX k N b :=
  mulX_mul_ddw_of_forall fun j hj => by have := lt_of_mem_w0Word hj; omega

variable (k N) in
/-- The idempotent `e_i = x^{δ_i} ∂_{w_0^{(i)}}` of `NH_N` on the first `i` strands. -/
noncomputable def idemNHAt (i : ℕ) : nilHecke k N :=
  ⟨mulPoly k N (xDelta i) * ddw (w0Word i), mul_mem (mulPoly_mem _) (ddw_mem _)⟩

/-! ### Truncating the elementary symmetric polynomials -/

variable (k N) in
/-- The ideal generated by the variables `x_a`, `a ≥ i`. -/
noncomputable def outerIdeal (i : ℕ) : Ideal (MvPolynomial (Fin N) k) :=
  Ideal.span {p | ∃ b : Fin N, i ≤ b ∧ p = X b}

theorem prod_X_mem_outerIdeal {i : ℕ} {t : Finset (Fin N)} {b : Fin N} (hb : b ∈ t)
    (hbi : i ≤ b) : ∏ a ∈ t, (X a : MvPolynomial (Fin N) k) ∈ outerIdeal k N i := by
  rw [← Finset.mul_prod_erase _ _ hb]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨b, hbi, rfl⟩)

/-- `e_r(x_0, …, x_{i-1}) ≡ e_r(x_0, …, x_{N-1})` modulo the `x_a`, `a ≥ i`. -/
theorem esymm_sub_rename_esymm_mem {i : ℕ} (h : i ≤ N) (r : ℕ) :
    esymm (Fin N) k r - rename (Fin.castLE h) (esymm (Fin i) k r) ∈ outerIdeal k N i := by
  classical
  set e : Finset (Fin i) ↪ Finset (Fin N) := (Finset.mapEmbedding (Fin.castLEEmb h)).toEmbedding
  have hren : rename (Fin.castLE h) (esymm (Fin i) k r) =
      ∑ t ∈ (Finset.powersetCard r Finset.univ).map e, ∏ a ∈ t, X a := by
    rw [esymm, map_sum, Finset.sum_map]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [map_prod]
    simp only [rename_X, e, RelEmbedding.coe_toEmbedding, Finset.mapEmbedding_apply,
      Finset.prod_map, Fin.castLEEmb_apply]
  have hsub : (Finset.powersetCard r Finset.univ).map e ⊆
      Finset.powersetCard r (Finset.univ : Finset (Fin N)) := by
    intro t ht
    obtain ⟨u, hu, rfl⟩ := Finset.mem_map.1 ht
    rw [Finset.mem_powersetCard] at hu ⊢
    refine ⟨Finset.subset_univ _, ?_⟩
    simp [e, hu.2]
  rw [hren, esymm, ← Finset.sum_sdiff hsub, add_sub_cancel_right]
  refine Ideal.sum_mem _ fun t ht => ?_
  rw [Finset.mem_sdiff] at ht
  by_contra hne
  apply ht.2
  have hall : ∀ b ∈ t, (b : ℕ) < i := by
    intro b hb
    by_contra hbi
    exact hne (prod_X_mem_outerIdeal hb (by omega))
  have hts : t ⊆ (Finset.univ : Finset (Fin i)).map (Fin.castLEEmb h) := by
    intro b hb
    refine Finset.mem_map.2 ⟨⟨b, hall b hb⟩, Finset.mem_univ _, ?_⟩
    ext; simp
  obtain ⟨u, -, rfl⟩ := Finset.subset_map_iff.1 hts
  refine Finset.mem_map.2 ⟨u, ?_, rfl⟩
  have := (Finset.mem_powersetCard.1 ht.1).2
  rw [Finset.card_map] at this
  exact Finset.mem_powersetCard.2 ⟨Finset.subset_univ _, this⟩

/-! ### The partial socle -/

theorem coinvMul_add (p q : MvPolynomial (Fin N) k) :
    coinvMul k (p + q) = coinvMul k p + coinvMul k q := by
  refine LinearMap.ext fun v => ?_
  obtain ⟨f, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  simp [coinvMul_mk, add_mul]

theorem coinvMul_sub (p q : MvPolynomial (Fin N) k) :
    coinvMul k (p - q) = coinvMul k p - coinvMul k q := by
  refine LinearMap.ext fun v => ?_
  obtain ⟨f, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  simp [coinvMul_mk, sub_mul]

theorem coinvMul_eq_zero_of_mem_outerIdeal {i : ℕ} {w : Coinv k N}
    (hw : ∀ b : Fin N, i ≤ b → coinvMul k (X b) w = 0) {p : MvPolynomial (Fin N) k}
    (hp : p ∈ outerIdeal k N i) : coinvMul k p w = 0 := by
  induction hp using Submodule.span_induction with
  | mem x hx => obtain ⟨b, hb, rfl⟩ := hx; exact hw b hb
  | zero => simp [coinvMul]
  | add x y _ _ hx hy =>
    rw [coinvMul_add, LinearMap.add_apply, hx, hy, add_zero]
  | smul c x _ hx => rw [smul_eq_mul, coinvMul_mul, Module.End.mul_apply, hx, map_zero]

theorem coinvMul_rename_eq_zero {i : ℕ} (h : i ≤ N) {w : Coinv k N}
    (hw : ∀ b : Fin N, i ≤ b → coinvMul k (X b) w = 0) {p : MvPolynomial (Fin i) k}
    (hp : p ∈ coinvIdeal k i) : coinvMul k (rename (Fin.castLE h) p) w = 0 := by
  rw [coinvIdeal_eq_span_esymm] at hp
  induction hp using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨r, rfl⟩ := hx
    have h1 := coinvMul_eq_zero_of_mem_outerIdeal hw
      (esymm_sub_rename_esymm_mem h ((r : ℕ) + 1))
    have h2 : coinvMul k (esymm (Fin N) k ((r : ℕ) + 1)) = 0 :=
      coinvMul_eq_zero (esymm_succ_mem_coinvIdeal N r)
    rw [coinvMul_sub, h2, zero_sub, LinearMap.neg_apply, neg_eq_zero] at h1
    exact h1
  | zero => simp [coinvMul]
  | add x y _ _ hx hy =>
    rw [map_add, coinvMul_add, LinearMap.add_apply, hx, hy, add_zero]
  | smul c x _ hx =>
    rw [smul_eq_mul, map_mul, coinvMul_mul, Module.End.mul_apply, hx, map_zero]

/-- `x^{δ_i} = x_0^{i-1} ⋯ x_{i-2}` lives in the first `i` variables. -/
theorem xDelta_eq_rename {i : ℕ} (h : i ≤ N) :
    (xDelta i : MvPolynomial (Fin N) k) =
      rename (Fin.castLE h) (∏ a : Fin i, X a ^ (i - 1 - a)) := by
  classical
  rw [xDelta, map_prod]
  simp only [map_pow, rename_X]
  have := Finset.prod_map Finset.univ (Fin.castLEEmb h) 
    (fun a : Fin N => (X a : MvPolynomial (Fin N) k) ^ (i - 1 - a))
  simp only [Fin.castLEEmb_apply, Fin.val_castLE] at this
  rw [← this]
  · symm
    refine Finset.prod_subset (Finset.subset_univ _) fun a _ ha => ?_
    have hai : i ≤ a := by
      by_contra hai
      exact ha (Finset.mem_map.2 ⟨⟨a, by omega⟩, Finset.mem_univ _, by ext; simp⟩)
    rw [show i - 1 - (a : ℕ) = 0 by omega, pow_zero]

/-- `x_a x^{δ_i}`, `a < i`, lies in the ideal generated by `Sym⁺(x_0, …, x_{i-1})`. -/
theorem X_mul_xDelta_mem {i : ℕ} (a : Fin i) :
    X a * (∏ b : Fin i, X b ^ (i - 1 - b) : MvPolynomial (Fin i) k) ∈ coinvIdeal k i := by
  refine mem_coinvIdeal_of_isHomogeneous (d := 1 + ∑ b : Fin i, (i - 1 - (b : ℕ)))
    ((isHomogeneous_X k a).mul (isHomogeneous_stair i _)) ?_
  rw [sum_sub_one_sub]
  omega

/-- **Partial socle of `L_N`**: if `v ∈ L_N` is fixed by the idempotent `e_i` of the first `i`
strands and killed by the `x_a`, `a ≥ i`, then it is killed by all `x_a`. -/
theorem mem_coinvSocle_of_idemNHAt {i : ℕ} (h : i ≤ N) {v : Coinv k N}
    (hv : nhAct k N (idemNHAt k N i) v = v)
    (hout : ∀ b : Fin N, i ≤ b → coinvMul k (X b) v = 0) :
    v ∈ coinvSocle k N := by
  set w := nhAct k N ⟨ddw (w0Word i), ddw_mem _⟩ v
  have hvw : v = coinvMul k (xDelta i) w := by
    conv_lhs => rw [← hv]
    rw [← nhAct_mulPoly, ← Module.End.mul_apply, ← map_mul]
    rfl
  have hw : ∀ b : Fin N, i ≤ b → coinvMul k (X b) w = 0 := by
    intro b hb
    rw [← nhAct_mulX, ← Module.End.mul_apply, ← map_mul]
    have : (⟨mulX k N b, mulX_mem b⟩ * ⟨ddw (w0Word i), ddw_mem _⟩ : nilHecke k N) =
        ⟨ddw (w0Word i), ddw_mem _⟩ * ⟨mulX k N b, mulX_mem b⟩ :=
      Subtype.ext (mulX_mul_ddw_w0Word hb)
    rw [this, map_mul, Module.End.mul_apply, nhAct_mulX, hout b hb, map_zero]
  rw [mem_coinvSocle]
  intro a
  by_cases ha : i ≤ (a : ℕ)
  · exact hout a ha
  · rw [hvw, ← Module.End.mul_apply, ← coinvMul_mul, xDelta_eq_rename h,
      show (X a : MvPolynomial (Fin N) k) = rename (Fin.castLE h) (X ⟨a, by omega⟩) by simp,
      ← map_mul]
    exact coinvMul_rename_eq_zero h hw (X_mul_xDelta_mem _)

end Categorification.NilHecke
