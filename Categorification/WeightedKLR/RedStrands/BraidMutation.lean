section Labels

variable {I : Type} [DecidableEq I] {ℓ : ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν

omit [DecidableEq I] in
theorem braidBlockPermutation_one (n : Fin ℓ → ℕ) {m : ℕ} (hn : (∑ r, (n r + 1)) = m) :
    braidBlockPermutation n hn 1 = 1 := by
  refine Equiv.ext fun x => ?_
  obtain ⟨⟨r, a⟩, rfl⟩ := (braidBlockPositions n hn).surjective x
  exact braidBlockPermutation_apply n hn 1 r a

/-- The block transport along the identity fixes every nonviolated red-ordered loading. -/
theorem blockTransport_one {s : Seq μ} (hs : IsRedOrdered s) (hv : ¬ IsViolated s) :
    blockTransport 1 s = s := by
  obtain ⟨n, hn, h⟩ := exists_braidBlockPositions s hs hv
  rw [blockTransport_eq 1 n hn h, braidBlockPermutation_one, one_smul]

end Labels

