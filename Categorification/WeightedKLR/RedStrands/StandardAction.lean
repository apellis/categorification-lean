import Categorification.WeightedKLR.RedStrands.StandardModule

/-!
# The corner action on the standard module `S_α`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §5.1, the
standard module `S_α` before Proposition 5.3 and the first two steps of the proof of
Proposition 5.3.

A root function `α` records, for each red strand `λ_r` and each label `i`, the number of black
`i`-strands left of `λ_r` (`blackCount`). The idempotent `e_α` is the sum of the `e(s)` over the
sequences `s` with red strands in order and root function `α`. The standard module `S_α` is the
quotient of `e_α T̃^λ` by the right ideal `U_α` generated by the elements `e_α a e(t)` with the
root function of `t` strictly above `α`.

Left multiplication by an element of the corner `e_α T̃^λ e_α` preserves `U_α`, so it acts on
`S_α` by right `T̃^λ`-module endomorphisms (`StendhalAlgebra.rootAction`); this is the first
step of the proof of Proposition 5.3, for the image of `℘_α`. The second step is that the
cyclotomic generators act by zero: if `λ_r` is immediately followed by a black `i`-strand then
`y^{α_i^∨(λ_r)} e(s)` lies in `U_α` (`StendhalAlgebra.sandwich_dotPow_mem_rootUpper`).

## Main definitions

* `Stendhal.StendhalAlgebra.rootIdem`: the idempotent `e_α`.
* `Stendhal.StendhalAlgebra.rootUpper`, `rootStandard`: `U_α` and `S_α`.
* `Stendhal.StendhalAlgebra.rootAction`: the action of `e_α T̃^λ e_α` on `S_α`.

## Main results

* `Stendhal.StendhalAlgebra.upperSubmodule_le_rootUpper`: `U_s ⊆ U_α` for `s` of root
  function `α`.
* `Stendhal.StendhalAlgebra.rootAction_eq_zero_of_mul_mem`: an element `z` of the corner
  acts by zero on `S_α` as soon as `z e_α ∈ U_α`.
-/

namespace Categorification.Stendhal

open KLR MulOpposite

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}

/-! ### Corner actions on subquotients of a right ideal -/

section Generic

variable {A : Type*} [Ring A] [Algebra k A] {E : A} (hE : IsIdempotentElem E)
  (U : Submodule Aᵐᵒᵖ A)

/-- The image of the right ideal `E A` in `A / U`. -/
noncomputable def cornerQuotient : Submodule Aᵐᵒᵖ (A ⧸ U) :=
  (Submodule.span Aᵐᵒᵖ {E}).map U.mkQ

theorem mem_span_singleton_iff_mul (hE : IsIdempotentElem E) (z : A) :
    z ∈ Submodule.span Aᵐᵒᵖ {E} ↔ E * z = z := by
  rw [Submodule.mem_span_singleton]
  constructor
  · rintro ⟨a, rfl⟩
    rw [smul_eq_mul_unop, ← mul_assoc, hE.eq]
  · intro h
    exact ⟨op z, by rw [op_smul_eq_mul, h]⟩

variable {U}

/-- Left multiplication by `c`, a right `A`-module endomorphism of `A`. -/
noncomputable def lmulOp (c : A) : A →ₗ[Aᵐᵒᵖ] A where
  toFun x := c * x
  map_add' := mul_add c
  map_smul' a x := by simp only [smul_eq_mul_unop, RingHom.id_apply, mul_assoc]

@[simp] theorem lmulOp_apply (c x : A) : lmulOp c x = c * x := rfl

/-- Left multiplication by an element `c` of the corner `E A E` preserving `U`, as an
endomorphism of the image of `E A` in `A / U`. -/
noncomputable def cornerQuotientLmul (hU : ∀ c : hE.Corner, ∀ z ∈ U, c.1 * z ∈ U)
    (c : hE.Corner) : Module.End Aᵐᵒᵖ (cornerQuotient (E := E) U) :=
  (U.mapQ U (lmulOp c.1) fun z hz => hU c z hz).restrict fun q hq => by
    obtain ⟨z, hz, rfl⟩ := Submodule.mem_map.1 hq
    refine Submodule.mem_map.2 ⟨c.1 * z, (mem_span_singleton_iff_mul hE _).2 ?_, rfl⟩
    rw [← mul_assoc, ((Subsemigroup.mem_corner_iff hE).1 c.2).1]

theorem cornerQuotientLmul_apply (hU : ∀ c : hE.Corner, ∀ z ∈ U, c.1 * z ∈ U)
    (c : hE.Corner) (z : A) (hz : U.mkQ z ∈ cornerQuotient (E := E) U) :
    (cornerQuotientLmul hE hU c ⟨U.mkQ z, hz⟩).1 = U.mkQ (c.1 * z) := rfl

/-- **The corner action**: if left multiplication by the corner `E A E` preserves `U`, the
corner acts on the image of `E A` in `A / U` by right `A`-module endomorphisms. -/
noncomputable def cornerQuotientAction (hU : ∀ c : hE.Corner, ∀ z ∈ U, c.1 * z ∈ U) :
    hE.Corner →ₐ[k] Module.End Aᵐᵒᵖ (cornerQuotient (E := E) U) where
  toFun := cornerQuotientLmul hE hU
  map_one' := by
    ext ⟨q, hq⟩
    obtain ⟨z, hz, rfl⟩ := Submodule.mem_map.1 hq
    change U.mkQ (E * z) = U.mkQ z
    rw [(mem_span_singleton_iff_mul hE z).1 hz]
  map_mul' c d := by
    ext ⟨q, hq⟩
    obtain ⟨z, -, rfl⟩ := Submodule.mem_map.1 hq
    change U.mkQ (c.1 * d.1 * z) = U.mkQ (c.1 * (d.1 * z))
    rw [mul_assoc]
  map_zero' := by
    ext ⟨q, hq⟩
    obtain ⟨z, -, rfl⟩ := Submodule.mem_map.1 hq
    change U.mkQ (0 * z) = 0
    rw [zero_mul, map_zero]
  map_add' c d := by
    ext ⟨q, hq⟩
    obtain ⟨z, -, rfl⟩ := Submodule.mem_map.1 hq
    change U.mkQ ((c.1 + d.1) * z) = U.mkQ (c.1 * z) + U.mkQ (d.1 * z)
    rw [add_mul, map_add]
  commutes' r := by
    ext ⟨q, hq⟩
    obtain ⟨z, hz, rfl⟩ := Submodule.mem_map.1 hq
    change U.mkQ ((r • E) * z) = r • U.mkQ z
    rw [smul_mul_assoc, (mem_span_singleton_iff_mul hE z).1 hz, LinearMap.map_smul_of_tower]

/-- An element `c` of the corner with `c E ∈ U` acts by zero. -/
theorem cornerQuotientAction_eq_zero (hU : ∀ c : hE.Corner, ∀ z ∈ U, c.1 * z ∈ U)
    (c : hE.Corner) (hc : c.1 * E ∈ U) : cornerQuotientAction (k := k) hE hU c = 0 := by
  ext ⟨q, hq⟩
  obtain ⟨z, hz, rfl⟩ := Submodule.mem_map.1 hq
  change U.mkQ (c.1 * z) = 0
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    ← (mem_span_singleton_iff_mul hE z).1 hz, ← mul_assoc, ← op_smul_eq_mul]
  exact U.smul_mem _ hc

end Generic


/-! ### The standard module `S_α` -/

namespace StendhalAlgebra

open StendhalAlgebraAllOrders (redOrderedIdem e_mul_redOrderedIdem redOrderedIdem_mul_e)

variable {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "A" => StendhalAlgebra k Q Λ ν

theorem stendhalLE_iff (s t : Seq μ) : StendhalLE s t ↔ blackCount s ≤ blackCount t :=
  Iff.rfl

theorem stendhalLT_iff (s t : Seq μ) : StendhalLT s t ↔ blackCount s < blackCount t :=
  Iff.rfl

open Classical in
variable (ν) in
/-- The sequences with red strands in order and root function `α`. -/
noncomputable def rootSet (α : Fin ℓ → I → ℕ) : Finset (Seq μ) :=
  Finset.univ.filter fun s => IsRedOrdered s ∧ blackCount s = α

theorem mem_rootSet {α : Fin ℓ → I → ℕ} {s : Seq μ} :
    s ∈ rootSet ν α ↔ IsRedOrdered s ∧ blackCount s = α := by
  classical
  simp [rootSet]

theorem e_mul_e (s t : Seq μ) (hs : IsRedOrdered s) (ht : IsRedOrdered t) :
    (e s hs : A) * e t ht = if s = t then e s hs else 0 := by
  apply Subtype.ext
  change (StendhalAlgebraAllOrders.e s : StendhalAlgebraAllOrders k Q Λ ν) *
    StendhalAlgebraAllOrders.e t = (if s = t then e s hs else 0 : A).1
  rw [StendhalAlgebraAllOrders.e_mul_e]
  split_ifs <;> rfl

variable (Q Λ) in
/-- **The idempotent `e_α`** of arXiv:1309.3796v3, §5.1: the sum of the idempotents `e(s)` of
the sequences with red strands in order and root function `α`. -/
noncomputable def rootIdem (α : Fin ℓ → I → ℕ) : A :=
  ⟨∑ s ∈ rootSet ν α, StendhalAlgebraAllOrders.e s, by
    rw [Subsemigroup.mem_corner_iff StendhalAlgebraAllOrders.isIdempotentElem_redOrderedIdem,
      Finset.mul_sum,
      Finset.sum_mul]
    constructor
    · exact Finset.sum_congr rfl fun s hs => by
        rw [StendhalAlgebraAllOrders.redOrderedIdem_mul_e]
        simp [(mem_rootSet.1 hs).1]
    · exact Finset.sum_congr rfl fun s hs => by
        rw [StendhalAlgebraAllOrders.e_mul_redOrderedIdem]
        simp [(mem_rootSet.1 hs).1]⟩

theorem coe_rootIdem (α : Fin ℓ → I → ℕ) :
    (rootIdem Q Λ α : A).1 = ∑ s ∈ rootSet ν α, StendhalAlgebraAllOrders.e s := rfl

open Classical in
theorem rootIdem_mul_e (α : Fin ℓ → I → ℕ) (s : Seq μ) (hs : IsRedOrdered s) :
    rootIdem Q Λ α * (e s hs : A) = if blackCount s = α then e s hs else 0 := by
  classical
  apply Subtype.ext
  change (∑ t ∈ rootSet ν α, StendhalAlgebraAllOrders.e t) * StendhalAlgebraAllOrders.e s =
    (if blackCount s = α then e s hs else 0 : A).1
  rw [Finset.sum_mul]
  simp_rw [StendhalAlgebraAllOrders.e_mul_e]
  rw [Finset.sum_ite_eq']
  split_ifs with h1 h2 h2
  · rfl
  · exact absurd (mem_rootSet.1 h1).2 h2
  · exact absurd (mem_rootSet.2 ⟨hs, h2⟩) h1
  · rfl

open Classical in
theorem e_mul_rootIdem (α : Fin ℓ → I → ℕ) (s : Seq μ) (hs : IsRedOrdered s) :
    (e s hs : A) * rootIdem Q Λ α = if blackCount s = α then e s hs else 0 := by
  classical
  apply Subtype.ext
  change StendhalAlgebraAllOrders.e s * (∑ t ∈ rootSet ν α, StendhalAlgebraAllOrders.e t) =
    (if blackCount s = α then e s hs else 0 : A).1
  rw [Finset.mul_sum]
  simp_rw [StendhalAlgebraAllOrders.e_mul_e]
  rw [Finset.sum_ite_eq]
  split_ifs with h1 h2 h2
  · rfl
  · exact absurd (mem_rootSet.1 h1).2 h2
  · exact absurd (mem_rootSet.2 ⟨hs, h2⟩) h1
  · rfl

theorem isIdempotentElem_rootIdem (α : Fin ℓ → I → ℕ) :
    IsIdempotentElem (rootIdem Q Λ α : A) := by
  classical
  apply Subtype.ext
  change (∑ t ∈ rootSet ν α, StendhalAlgebraAllOrders.e t) *
    (∑ t ∈ rootSet ν α, StendhalAlgebraAllOrders.e t) = ∑ t ∈ rootSet ν α, StendhalAlgebraAllOrders.e t
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun s hs => ?_
  rw [Finset.mul_sum]
  simp_rw [StendhalAlgebraAllOrders.e_mul_e]
  rw [Finset.sum_ite_eq]
  simp only [hs, ↓reduceIte]

variable (Q Λ) in
/-- The right ideal `U_α` of arXiv:1309.3796v3, §5.1: generated by the images of the maps
`P̃_t → e_α T̃^λ` with the root function of `t` strictly above `α`, i.e. by the elements
`e_α a e(t)`. -/
noncomputable def rootUpper (α : Fin ℓ → I → ℕ) : Submodule Aᵐᵒᵖ A :=
  Submodule.span Aᵐᵒᵖ
    {z | ∃ (t : Seq μ) (ht : IsRedOrdered t) (a : A), α < blackCount t ∧
      z = rootIdem Q Λ α * a * e t ht}

variable (Q Λ) in
/-- **The standard module `S_α`** of arXiv:1309.3796v3, §5.1: the quotient of `e_α T̃^λ` by
`U_α`, realized as the image of `e_α T̃^λ` in `T̃^λ / U_α`. -/
noncomputable def rootStandard (α : Fin ℓ → I → ℕ) : Submodule Aᵐᵒᵖ (A ⧸ rootUpper Q Λ α) :=
  cornerQuotient (E := rootIdem Q Λ α) (rootUpper Q Λ α)

/-- Left multiplication by the corner `e_α T̃^λ e_α` preserves `U_α` (arXiv:1309.3796v3, proof
of Proposition 5.3). -/
theorem corner_mul_mem_rootUpper (α : Fin ℓ → I → ℕ)
    (c : (isIdempotentElem_rootIdem (Q := Q) (Λ := Λ) (ν := ν) α).Corner) (z : A)
    (hz : z ∈ rootUpper Q Λ α) : c.1 * z ∈ rootUpper Q Λ α := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨t, ht, a, hlt, rfl⟩ := hz
    refine Submodule.subset_span ⟨t, ht, c.1 * a, hlt, ?_⟩
    rw [← mul_assoc, ← mul_assoc, ← mul_assoc, ((Subsemigroup.mem_corner_iff (isIdempotentElem_rootIdem α)).1 c.2).2,
      ((Subsemigroup.mem_corner_iff (isIdempotentElem_rootIdem α)).1 c.2).1]
  | zero => rw [mul_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [mul_add]; exact Submodule.add_mem _ hx hy
  | smul a x _ hx =>
    rw [smul_eq_mul_unop, ← mul_assoc, ← smul_eq_mul_unop]
    exact Submodule.smul_mem _ _ hx

variable (Q Λ) in
/-- **The corner action on `S_α`** (arXiv:1309.3796v3, proof of Proposition 5.3): left
multiplication by `e_α T̃^λ e_α` acts on `S_α` by right `T̃^λ`-module endomorphisms. -/
noncomputable def rootAction (α : Fin ℓ → I → ℕ) :
    (isIdempotentElem_rootIdem (Q := Q) (Λ := Λ) (ν := ν) α).Corner →ₐ[k]
      Module.End Aᵐᵒᵖ (rootStandard (ν := ν) Q Λ α) :=
  cornerQuotientAction (k := k) _ (corner_mul_mem_rootUpper α)

/-- An element `c` of `e_α T̃^λ e_α` with `c e_α ∈ U_α` acts by zero on `S_α`. -/
theorem rootAction_eq_zero_of_mul_mem (α : Fin ℓ → I → ℕ)
    (c : (isIdempotentElem_rootIdem (Q := Q) (Λ := Λ) (ν := ν) α).Corner)
    (hc : c.1 * rootIdem Q Λ α ∈ rootUpper Q Λ α) : rootAction Q Λ α c = 0 :=
  cornerQuotientAction_eq_zero _ _ c hc

/-- `U_s ⊆ U_α` for a sequence `s` of root function `α`. -/
theorem upperSubmodule_le_rootUpper (s : Seq μ) (hs : IsRedOrdered s) :
    upperSubmodule Q Λ s hs ≤ rootUpper Q Λ (blackCount s) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨t, ht, a, hlt, rfl⟩
  refine Submodule.subset_span ⟨t, ht, e s hs * a, hlt, ?_⟩
  rw [← mul_assoc, rootIdem_mul_e]
  simp

/-- **The cyclotomic step of Proposition 5.3** for `S_α` (arXiv:1309.3796v3, §5.1): if the red
strand `λ_r` is immediately followed by a black `i`-strand in `s`, then `y^{α_i^∨(λ_r)} e(s)`
lies in `U_α`, for `α` the root function of `s`. -/
theorem sandwich_dotPow_mem_rootUpper {j : ℕ} (h : j + 1 < Multiset.card μ) (s : Seq μ)
    (hs : IsRedOrdered s) (i : I) (r : Fin ℓ) (hr : s.lbl ⟨j, by omega⟩ = .inr r)
    (hi : s.lbl ⟨j + 1, h⟩ = .inl i) :
    sandwich s hs s hs (StendhalAlgebraAllOrders.x ⟨j + 1, h⟩ ^ Λ r i) ∈
      rootUpper Q Λ (blackCount s) :=
  upperSubmodule_le_rootUpper s hs (dotPow_mem_upperSubmodule h s hs i r hr hi)

end StendhalAlgebra

end Categorification.Stendhal
