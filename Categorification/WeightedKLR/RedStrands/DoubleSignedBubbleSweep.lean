import Categorification.WeightedKLR.RedStrands.DoubleBlackBubbleSlide
import Categorification.WeightedKLR.RedStrands.DoubleSignedCapBlock

/-!
# Moving bubbles to the left boundary of a signed word

Webster, arXiv:1309.3796v3, §4.6, proof of Lemma 4.29. Iteration of the black
slide and a red bubble transport moves a bubble algebra element to the far
left. Any projection under which the far-left bubble is scalar then
expresses the original bubble as a sum of dot diagrams.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal.DoubleDiagram

open CategoryTheory QuantumGroup QuantumGroup.UDot KL3.Diagram StringDiagrams

universe u v w
variable {I : Type u} {C : CartanDatum I} {X Y : Type v} [AddCommGroup X] [AddCommGroup Y]
  (RD : WeightDatum C X Y) {ℓ : ℕ} (Λ : Fin ℓ → X) {k : Type w} [CommRing k]
  (P : Presentation.{w, max u v} (signature RD Λ) k)
  (hP : ∀ r : (pres RD k).Rel, P.lin (blackMirrorLinear RD Λ ((pres RD k).rel r)) = 0)
  (μ : X) (w : List (DoubleStrand I ℓ))

local notation "K" => pres RD k
local notation "T" => P.obj (obj RD Λ μ w)
local notation "cutWeight" => endWeight RD Λ μ
local notation "atCut" => blackCutHom RD Λ P hP μ
local notation "ev" => signedDg RD Λ P μ w w

/-- A signed layer that puts one dot on a black strand. -/
def IsBlackDotLayer (x : SignedLayer I ℓ) : Prop :=
  ∃ L l R, x = (L, .black (.dot l), R)

/-- The span generated by arbitrary dot diagrams followed by one element of
the bubble algebra in the physical far-left region. -/
def signedDotLeftBubbleSpan : Submodule k (End T) :=
  Submodule.span k {f | ∃ A, signedChain w A w ∧ (∀ x ∈ A, IsBlackDotLayer x) ∧
    ∃ β : End ((K).obj (ob RD (cutWeight []) [])), IsBub RD k (cutWeight []) β ∧
      f = ev A ≫ atCut [] w w rfl β}

private theorem signedDotLeftBubbleSpan_comp {A : List (SignedLayer I ℓ)}
    (hA : signedChain w A w) (hdots : ∀ x ∈ A, IsBlackDotLayer x)
    {f : End T} (hf : f ∈ signedDotLeftBubbleSpan RD Λ P hP μ w) :
    ev A ≫ f ∈ signedDotLeftBubbleSpan RD Λ P hP μ w := by
  let M := signedDotLeftBubbleSpan RD Λ P hP μ w
  have h : M ≤ M.comap (Linear.leftComp k T (ev A)) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨B, hB, hBd, β, hβ, rfl⟩
    change ev A ≫ (ev B ≫ atCut [] w w rfl β) ∈ M
    rw [← Category.assoc, signedDg_comp RD Λ P μ hA hB]
    apply Submodule.subset_span
    refine ⟨A ++ B, hA.append hB, ?_, β, hβ, rfl⟩
    intro x hx
    rcases List.mem_append.mp hx with hx | hx
    · exact hdots x hx
    · exact hBd x hx
  exact h hf

private theorem signedChain_replicate_dot (L R : List (DoubleStrand I ℓ)) (l : Letter I)
    (hw : L ++ [.inl l] ++ R = w) (n : ℕ) :
    signedChain w (List.replicate n (L, .black (.dot l), R)) w := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.replicate_succ]
    have hs : L ++ (Move.black (ℓ := ℓ) (.dot l)).top ++ R = w := hw
    exact ⟨hw.symm, hs ▸ ih⟩

/-- The one-red-strand input for the leftward sweep. Both bubble insertions
are endomorphisms of the same signed boundary. -/
def RedBubbleSlidesLeft : Prop :=
  ∀ (L R : List (DoubleStrand I ℓ)) (r : Fin ℓ) (hw : L ++ [.inr r] ++ R = w),
    let η := cutWeight (L ++ [Sum.inr (α := Letter I) r])
    ∀ (β : End ((K).obj (ob RD η []))), IsBub RD k η β →
    ∃ γ : End ((K).obj (ob RD (cutWeight L) [])), IsBub RD k (cutWeight L) γ ∧
      atCut (L ++ [.inr r]) R w hw β =
        atCut L ([.inr r] ++ R) w ((List.append_assoc L [.inr r] R).symm.trans hw) γ

/-- Iterate the physical right-to-left bubble slide across any signed prefix
using the red slide at each red letter. The only strands modified by the
sweep are the black boundary strands, which may acquire dots. -/
theorem blackCutHom_mem_signedDotLeftBubbleSpan
    (hred : RedBubbleSlidesLeft RD Λ P hP μ w)
    (L R : List (DoubleStrand I ℓ)) (hw : L ++ R = w)
    (β : End ((K).obj (ob RD (cutWeight L) []))) (hβ : IsBub RD k (cutWeight L) β) :
    atCut L R w hw β ∈ signedDotLeftBubbleSpan RD Λ P hP μ w := by
  suffices sweep : ∀ (L R : List (DoubleStrand I ℓ)) (hw : L ++ R = w)
      (β : End ((K).obj (ob RD (cutWeight L) []))), IsBub RD k (cutWeight L) β →
      atCut L R w hw β ∈ signedDotLeftBubbleSpan RD Λ P hP μ w by
    exact sweep L R hw β hβ
  clear L R hw β hβ
  intro L
  induction L using List.reverseRecOn with
  | nil =>
    intro R hw β hβ
    subst w
    apply Submodule.subset_span
    refine ⟨[], rfl, by simp, β, hβ, ?_⟩
    simp only [signedDg_nil, Category.id_comp, List.nil_append]
  | append_singleton L x ih =>
    intro R hw β hβ
    have hw' : L ++ ([x] ++ R) = w := (List.append_assoc _ _ _).symm.trans hw
    have hnext (γ : End ((K).obj (ob RD (cutWeight L) []))) (hγ : IsBub RD k (cutWeight L) γ) :
        atCut L ([x] ++ R) w hw' γ ∈ signedDotLeftBubbleSpan RD Λ P hP μ w :=
      ih ([x] ++ R) hw' γ hγ
    cases x with
    | inl l =>
      have hs := blackCutBubble_mem_leftSpan RD Λ P hP μ L R l hw β hβ
      apply (show _ ≤ signedDotLeftBubbleSpan RD Λ P hP μ w from ?_) hs
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨n, γ, hγ, rfl⟩
      let A : List (SignedLayer I ℓ) := List.replicate n (L, .black (.dot l), R)
      have hA : signedChain w A w := signedChain_replicate_dot w L R l hw n
      have hdots : ∀ x ∈ A, IsBlackDotLayer x := by
        intro x hx
        have he := List.eq_of_mem_replicate hx
        exact ⟨L, l, R, he⟩
      exact signedDotLeftBubbleSpan_comp RD Λ P hP μ w hA hdots (hnext γ hγ)
    | inr r =>
      obtain ⟨γ, hγ, hg⟩ := hred L R r hw β hβ
      rw [hg]
      exact hnext γ hγ

/-- If the far-left bubble acts by scalars under the chosen projection, the
projected insertion at any cut is in the span of dot diagrams. This allows
pre- and post-composition to be built into the projection. -/
theorem blackCutHom_project_mem_signedDotSpan {M : Type*} [AddCommGroup M] [Module k M]
    (π : End T →ₗ[k] M) (hred : RedBubbleSlidesLeft RD Λ P hP μ w)
    (hleft : ∀ (γ : End ((K).obj (ob RD (cutWeight []) []))), IsBub RD k (cutWeight []) γ →
      ∃ c : k, ∀ f : End T, π (f ≫ atCut [] w w rfl γ) = c • π f)
    (L R : List (DoubleStrand I ℓ)) (hw : L ++ R = w)
    (β : End ((K).obj (ob RD (cutWeight L) []))) (hβ : IsBub RD k (cutWeight L) β) :
    π (atCut L R w hw β) ∈ Submodule.span k
      {g | ∃ A, signedChain w A w ∧ (∀ x ∈ A, IsBlackDotLayer x) ∧ g = π (ev A)} := by
  let S := Submodule.span k
    {g | ∃ A, signedChain w A w ∧ (∀ x ∈ A, IsBlackDotLayer x) ∧ g = π (ev A)}
  have h : signedDotLeftBubbleSpan RD Λ P hP μ w ≤ S.comap π := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨A, hA, hAd, γ, hγ, rfl⟩
    obtain ⟨c, hc⟩ := hleft γ hγ
    change π (ev A ≫ atCut [] w w rfl γ) ∈ S
    rw [hc]
    exact S.smul_mem _ (Submodule.subset_span ⟨A, hA, hAd, rfl⟩)
  exact h (blackCutHom_mem_signedDotLeftBubbleSpan RD Λ P hP μ w hred L R hw β hβ)

/-- A diagram with only dot layers uses no crossings. -/
theorem crossingNumber_of_blackDots {a b : Obj (signature RD Λ)} (g : a ⟶ b)
    (A : List (SignedLayer I ℓ)) (hg : Diagram.layers g = signedLayers RD Λ μ A)
    (hdots : ∀ x ∈ A, IsBlackDotLayer x) : crossingNumber g = 0 := by
  rw [crossingNumber_of_signedLayers RD Λ μ g A hg]
  clear hg
  induction A with
  | nil => rfl
  | cons x A ih =>
    obtain ⟨L, l, R, rfl⟩ := hdots x (by simp)
    exact ih (fun x hx => hdots x (List.mem_cons_of_mem _ hx))

/-- Append a dot diagram to a forward path without introducing a cap. -/
theorem ForwardPath.postcompose_blackDots {a b c : Obj (signature RD Λ)} {p : a ⟶ b}
    (hp : ForwardPath a p) (g : b ⟶ c) (A : List (SignedLayer I ℓ))
    (hg : Diagram.layers g = signedLayers RD Λ μ A)
    (hdots : ∀ x ∈ A, IsBlackDotLayer x) : ForwardPath a (p ≫ g) := by
  induction A generalizing b with
  | nil =>
    have h : Diagram.layers g = [] := hg
    have he := Diagram.chain g
    rw [h] at he
    have he' : b = c := he
    subst b
    have he : g = 𝟙 c := Diagram.ext h
    simpa [he] using hp
  | cons x A ih =>
    obtain ⟨L, l, R, rfl⟩ := hdots x (by simp)
    let m := layer RD Λ μ L (.black (.dot l)) R
    have h : Diagram.layers g = m :: signedLayers RD Λ μ A := hg
    have hc := Diagram.chain g
    rw [h] at hc
    obtain ⟨hv, hs, ht⟩ := hc
    let d : b ⟶ m.cod := Diagram.mk [m] ⟨hv, hs, rfl⟩
    let e : m.cod ⟶ c := Diagram.mk _ ht
    have he : g = d ≫ e := Diagram.ext h
    have ha : ForwardPath a (p ≫ d) := .single hp d m rfl (by simp [m, layer, Move.IsCap])
    rw [he, ← Category.assoc]
    exact ih ha e rfl (fun x hx => hdots x (List.mem_cons_of_mem _ hx))

end Categorification.Stendhal.DoubleDiagram
