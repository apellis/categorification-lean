import Categorification.WeightedKLR.RedStrands.GradedLeftStandard
import Categorification.Algebra.Graded.CyclicGenerator
import Categorification.Algebra.Graded.G0

/-!
# The graded left standard module

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2,
Definition 5.1, with the grading of Definition 4.4. The left standard `S_s = T e(s) / U_s` is
generated by the degree-zero vector `[e(s)]` in the image grading
(`gradedLeftStandard_exists_smul_unit`), so a `T`-linear isomorphism out of it sending `[e(s)]`
into degree zero is graded (`leftStandardGradedEquiv`). With `T` finite-dimensional it is a
finite-dimensional graded module (`leftStandardGFin`).
-/

noncomputable section

namespace Categorification.Stendhal

open KLR DirectSum Categorification.Graded

variable {I k : Type} [DecidableEq I] [Field k] {ℓ : ℕ} {ν : Multiset I}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ}
  (G : KLR.GradingDatum (stendhalQ Q Λ)) (s : Seq (stendhalWeight ℓ ν)) (hs : IsRedOrdered s)

local notation "R" => TensorProductAlgebra k Q Λ ν
local notation "Γ" => tensorProductGrade G ν

/-- The generator `[e(s)]` has degree zero. -/
theorem leftStandardUnit_mem_zero : leftStandardUnit Q Λ s hs ∈ gradedLeftStandard G s hs 0 :=
  gradedLeftStandard_mkQ_mem G s hs ⟨seqIdem Q Λ s hs, seqIdem_mul_self Q Λ s hs⟩
    (mk_e_mem_tensorProductGrade G ν s hs)

/-- Every element of degree `d` of the left standard is `a [e(s)]` with `a` of degree `d`. -/
theorem gradedLeftStandard_exists_smul_unit ⦃d : ℤ⦄ ⦃x : leftStandard Q Λ s hs⦄
    (hx : x ∈ gradedLeftStandard G s hs d) : ∃ a ∈ Γ d, a • leftStandardUnit Q Λ s hs = x := by
  obtain ⟨y, hy, rfl⟩ := hx
  exact ⟨y, hy, (leftStandard_mk_eq_smul_unit s hs y).symm⟩

/-- A `T`-linear isomorphism out of the left standard sending `[e(s)]` into degree zero is a
graded isomorphism. -/
def leftStandardGradedEquiv {N : Type*} [AddCommGroup N] [Module k N] [Module R N]
    {𝒩 : ℤ → Submodule k N} [Decomposition 𝒩] [SetLike.GradedSMul Γ 𝒩]
    (e : leftStandard Q Λ s hs ≃ₗ[R] N) (h0 : e (leftStandardUnit Q Λ s hs) ∈ 𝒩 0) :
    gradedLeftStandard G s hs ≃ᵍ[R] 𝒩 :=
  let := gradedLeftStandardDecomposition G s hs
  GradedEquiv.ofGenerator (𝒜 := Γ) (leftStandardUnit Q Λ s hs)
    (gradedLeftStandard_exists_smul_unit G s hs) e h0

instance gradedLeftStandard_gradedSMul : SetLike.GradedSMul Γ (gradedLeftStandard G s hs) :=
  ⟨fun _ _ _ _ ha hx => gradedLeftStandard_smul_mem G s hs ha hx⟩

variable [Module.Finite k (TensorProductAlgebra k Q Λ ν)]

omit G in
theorem finite_leftStandard : Module.Finite k (leftStandard Q Λ s hs) := by
  have : Module.Finite k (lIdeal (seqIdem Q Λ s hs)) :=
    Module.Finite.of_injective ((lIdeal (seqIdem Q Λ s hs)).subtype.restrictScalars k)
      Subtype.val_injective
  exact Module.Finite.quotient k _

/-- **The graded left standard module** (Webster, arXiv:1309.3796v2, Definition 5.1, with the
grading of Definition 4.4) as a finite-dimensional graded `T^λ`-module. -/
def leftStandardGFin : GFin Γ :=
  let := gradedLeftStandardDecomposition G s hs
  { carrier := leftStandard Q Λ s hs
    grading := gradedLeftStandard G s hs
    finiteDimensional := finite_leftStandard s hs }

end Categorification.Stendhal
