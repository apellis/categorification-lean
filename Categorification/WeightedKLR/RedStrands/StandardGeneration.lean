import Categorification.WeightedKLR.RedStrands.StandardStratificationStd
import Categorification.WeightedKLR.RedStrands.PhiStandardLayers
import Categorification.Algebra.ThickFiltration

set_option backward.isDefEq.respectTransparency false

/-!
# The standard modules generate the perfect complexes

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3,
Proposition 5.26, generation part of the semi-orthogonal decomposition: the subcategories
generated by the standard modules exhaust the category. For Rouquier parameters over a field,
in the ungraded derived category `D(T^λ)` of the tensor product algebra:

* every standard module `S_s` (in degree `0`) is compact, i.e. a perfect complex
  (`isCompact_stdModule`);
* the thick subcategory generated by the standard modules is exactly the subcategory of compact
  objects (`thickClosure_stdModule_eq_isCompact`).

Webster works in the graded category `Ṽ^λ` (Definition 4.8) of bounded above complexes of
graded modules with finite-dimensional graded pieces, where "generated" allows the infinite
graded sums such complexes contain. In the ungraded unbounded derived category used here
(as for Lemma 6.13), the corresponding statement is about the thick closure, and its natural
target is the subcategory of perfect complexes; all modules here are ungraded.

The proof is Webster's. Each standard is compact by descending induction in Webster's order,
using the short exact sequence `0 → U_s → T^λ e(s) → S_s → 0` and the filtration of `U_s` by
higher standards (Corollary 5.22; this is the argument of Corollary 5.24). Conversely, every
`T^λ e(s)` has a standard filtration (Proposition 5.21), and the regular module is a retract
of `⨁_s T^λ e(s)` because the idempotents `e(s)` of the red-ordered loadings sum to `1`; the
compact objects are the thick closure of the regular module.

The `Ext`-vanishing half of the decomposition is `subsingleton_ext_stdModule_of_not_stendhalLE`
and `subsingleton_ext_succ_stdModule`.
-/

noncomputable section

namespace Categorification.Stendhal

open CategoryTheory CategoryTheory.Limits DG DG.DerivedCategory KLR ModuleFiltration
open scoped DG.DegreeZero

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

open scoped Classical

variable {I : Type} {C : QuantumGroup.CartanDatum I} {k : Type} [Field k]
  {Q : I → I → MvPolynomial (Fin 2) k} (hR : IsRouquierQ C Q) (hQs : KLRSymm Q)
  {n : ℕ} (Λ : Fin n → I →₀ ℕ) (ν : Multiset I)

theorem isIdempotentElem_seqIdem (s : Seq (stendhalWeight n ν)) (hs : IsRedOrdered s) :
    IsIdempotentElem (seqIdem Q Λ s hs) :=
  seqIdem_mul_self Q Λ s hs

variable [HasDerivedCategory.{0, 0} (TensorProductAlgebra k Q Λ ν)]

/-- The projective `T^λ e(s)`, in degree `0`, is compact. -/
theorem isCompact_lIdeal_seqIdem (s : Seq (stendhalWeight n ν)) (hs : IsRedOrdered s) :
    DG.IsCompact.{0} (moduleObj (ModuleCat.of (TensorProductAlgebra k Q Λ ν)
      (lIdeal (seqIdem Q Λ s hs)))) := by
  have he := isIdempotentElem_seqIdem (Q := Q) Λ ν s hs
  have : Module.Finite (TensorProductAlgebra k Q Λ ν) (lIdeal (seqIdem Q Λ s hs)) :=
    Module.Finite.of_surjective
      ({ toFun := fun b => ⟨b * seqIdem Q Λ s hs, by rw [mem_lIdeal, mul_assoc, he.eq]⟩
         map_add' := fun a b => Subtype.ext (add_mul a b _)
         map_smul' := fun a b => Subtype.ext (mul_assoc a b _) } :
        TensorProductAlgebra k Q Λ ν →ₗ[TensorProductAlgebra k Q Λ ν] lIdeal (seqIdem Q Λ s hs))
      (fun z => ⟨z.1, Subtype.ext z.2⟩)
  have : Module.Projective (TensorProductAlgebra k Q Λ ν) (lIdeal (seqIdem Q Λ s hs)) :=
    (IsProjective.iff_projective _).2 (projective_lIdeal_seqIdem Q Λ s hs)
  exact isCompact_of_projective _

include hR hQs

/-- **Standard modules are perfect complexes** (Webster, arXiv:1309.3796v3, Proposition 5.26,
by the argument of Corollary 5.24): for Rouquier parameters, every standard module `S_s`, in
degree `0`, is compact in `D(T^λ)`. -/
theorem isCompact_stdModule (s : {t : Seq (stendhalWeight n ν) // IsRedOrdered t}) :
    DG.IsCompact.{0} (moduleObj (stdModule Q Λ ν s)) := by
  let r : {t : Seq (stendhalWeight n ν) // IsRedOrdered t} →
      {t : Seq (stendhalWeight n ν) // IsRedOrdered t} → Prop :=
    fun a b => StendhalLT b.1 a.1
  have : IsTrans _ r := ⟨fun a b c hab hbc => ⟨stendhalLE_trans hbc.1 hab.1,
    fun hac => hab.2 (stendhalLE_trans hac hbc.1)⟩⟩
  have : Std.Irrefl r := ⟨fun a ha => ha.2 ha.1⟩
  induction s using (Finite.wellFounded_of_trans_of_irrefl r).induction with
  | _ s ih =>
  obtain ⟨m, hm, hU⟩ := exists_hasFiltration_leftUpper_of_rouquier hR hQs Λ ν s.1 s.2
  have hUc := hU.moduleObj_mem (isThick_isCompact _) fun c hc => ih c (show r c s from hm c hc)
  exact isCompact_of_shortExact _ (shortExact_of_linearMaps
    (X := ModuleCat.of _ ((leftUpper Q Λ s.1 s.2).comap (lIdeal (seqIdem Q Λ s.1 s.2)).subtype))
    (Y := ModuleCat.of _ (lIdeal (seqIdem Q Λ s.1 s.2))) (Z := stdModule Q Λ ν s)
    _ _ (Submodule.injective_subtype _)
    (LinearMap.exact_subtype_mkQ _) (Submodule.mkQ_surjective _)) (by exact hUc)
    (by exact isCompact_lIdeal_seqIdem (Q := Q) Λ ν s.1 s.2)

/-- **The standard modules generate the perfect complexes** (Webster, arXiv:1309.3796v3,
Proposition 5.26, generation part of the semi-orthogonal decomposition, ungraded reading): for
Rouquier parameters, the thick subcategory of `D(T^λ)` generated by the standard modules (in
degree `0`) is the subcategory of compact objects. -/
theorem thickClosure_stdModule_eq_isCompact :
    ThickClosure (fun Y : DerivedCategory.{0} (TensorProductAlgebra k Q Λ ν) =>
      ∃ s, moduleObj (stdModule Q Λ ν s) = Y) = DG.IsCompact.{0} := by
  refine le_antisymm (thickClosure_le (isThick_isCompact _) ?_) ?_
  · rintro _ ⟨s, rfl⟩
    exact isCompact_stdModule hR hQs Λ ν s
  · rw [← thickClosure_self_eq_isCompact]
    refine thickClosure_le (isThick_thickClosure _) ?_
    rintro _ ⟨-, rfl⟩
    refine (isThick_thickClosure _).of_iso (regularModuleObjIso _) ?_
    refine moduleObj_regular_mem_of_sum_eq_one (isThick_thickClosure _)
      (fun s : {s : Seq (stendhalWeight n ν) // IsRedOrdered s} => seqIdem Q Λ s.1 s.2)
      (fun s => isIdempotentElem_seqIdem (Q := Q) Λ ν s.1 s.2) (sum_seqIdem_eq_one n ν Q Λ) fun s => ?_
    obtain ⟨m, hm⟩ := hasStandardFiltrations_of_rouquier hR hQs Λ ν s.1 s.2
    exact hm.moduleObj_mem (isThick_thickClosure _) fun c _ => .of_mem ⟨c, rfl⟩

end Categorification.Stendhal
