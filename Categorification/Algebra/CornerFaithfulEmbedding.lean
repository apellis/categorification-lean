import Categorification.Algebra.SelfDualInjective
import Categorification.Algebra.FittingSummand

set_option backward.isDefEq.respectTransparency false

/-!
# Modules cogenerated by a self-dual projective

Background for B. Webster, *Knot invariants and higher representation theory*,
arXiv:1309.3796v3, Theorem 5.30 (v2: Theorem 5.27), implication (1) ⇒ (3).

Let `A` be a finite-dimensional `k`-algebra, `e ∈ A` an idempotent and `τ : A → k` a functional
pairing `e A` and `A e` perfectly (the hypotheses of `Module.Baer.lIdeal_of_pairing`). Then `A e`
is self-dual, `A e ≅ (e A)^*`, so a map `M → A e` is the same as a functional on `e M`.

* `exists_injective_pi_lIdeal`: a finite-dimensional module `M` with no nonzero element `m`
  such that `e a m = 0` for every `a` embeds into a finite sum of copies of `A e`.
* `IsIndecomposableModule.exists_retraction_of_retraction_pi`: an indecomposable module of
  finite length which is a summand of a finite sum `X^ι` is a summand of `X` (the exchange step
  of Krull–Schmidt, from Fitting's lemma).
* `exists_retraction_lIdeal_of_injective`: hence an indecomposable injective module of that
  kind is a summand of `A e`.
-/

noncomputable section

namespace Categorification

open _root_.Module

section Exchange

variable {R : Type*} [Ring R] {M : Type*} [AddCommGroup M] [Module R M]
  [IsArtinian R M] [IsNoetherian R M]

namespace IsIndecomposableModule

/-- In the endomorphism ring of an indecomposable module of finite length, a sum of two
non-bijective endomorphisms is not bijective (the ring is local). -/
theorem not_bijective_add (hM : IsIndecomposableModule R M) {f g : Module.End R M}
    (hf : ¬ Function.Bijective f) (hg : ¬ Function.Bijective g) :
    ¬ Function.Bijective (f + g) := by
  intro hb
  have hu : IsUnit (f + g) := (Module.End.isUnit_iff _).2 hb
  obtain ⟨u, hu'⟩ := hu
  have hf' : ¬ Function.Bijective (↑u⁻¹ * f : Module.End R M) := by
    intro h
    apply hf
    have : f = (u : Module.End R M) * (↑u⁻¹ * f) := by rw [← mul_assoc, u.mul_inv, one_mul]
    rw [this]
    exact ((Module.End.isUnit_iff _).1 u.isUnit).comp h
  have hn := (hM.isNilpotent_or_bijective _).resolve_right hf'
  have h1 : (1 : Module.End R M) - ↑u⁻¹ * f = ↑u⁻¹ * g := by
    have : (↑u⁻¹ : Module.End R M) * (f + g) = 1 := by rw [← hu', u.inv_mul]
    rw [mul_add] at this
    rw [← this]
    abel
  have := hn.isUnit_one_sub
  rw [h1] at this
  apply hg
  have hg' : g = (u : Module.End R M) * (↑u⁻¹ * g) := by rw [← mul_assoc, u.mul_inv, one_mul]
  rw [hg']
  exact ((Module.End.isUnit_iff _).1 u.isUnit).comp ((Module.End.isUnit_iff _).1 this)

/-- A finite sum of non-bijective endomorphisms of an indecomposable module of finite length is
not bijective. -/
theorem not_bijective_sum (hM : IsIndecomposableModule R M) {ι : Type*} (s : Finset ι)
    (g : ι → Module.End R M) (hg : ∀ j ∈ s, ¬ Function.Bijective (g j)) :
    ¬ Function.Bijective ((∑ j ∈ s, g j : Module.End R M) : M → M) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty]
    intro h
    have := hM.1
    obtain ⟨x, hx⟩ := exists_ne (0 : M)
    exact hx (h.1 (by rw [LinearMap.zero_apply, LinearMap.zero_apply]))
  | insert j s hj ih =>
    rw [Finset.sum_insert hj]
    exact hM.not_bijective_add (hg j (Finset.mem_insert_self j s))
      (ih fun j' hj' => hg j' (Finset.mem_insert_of_mem hj'))

/-- **Exchange**: an indecomposable module of finite length which is a summand of a finite
product `ι → X` is a summand of `X`. -/
theorem exists_retraction_of_retraction_pi (hM : IsIndecomposableModule R M) {ι : Type*}
    [Fintype ι] [DecidableEq ι] {X : Type*} [AddCommGroup X] [Module R X]
    (i : M →ₗ[R] ι → X) (r : (ι → X) →ₗ[R] M) (h : r ∘ₗ i = LinearMap.id) :
    ∃ (i' : M →ₗ[R] X) (r' : X →ₗ[R] M), r' ∘ₗ i' = LinearMap.id := by
  let g : ι → Module.End R M := fun j => (r ∘ₗ LinearMap.single R (fun _ => X) j) ∘ₗ
    (LinearMap.proj j ∘ₗ i)
  have hsum : ∑ j, g j = LinearMap.id := by
    rw [← h]
    refine LinearMap.ext fun x => ?_
    simp only [g, LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.coe_proj,
      Function.eval, LinearMap.coe_single]
    rw [← map_sum, Finset.univ_sum_single]
  have hb : Function.Bijective ((∑ j, g j : Module.End R M) : M → M) := by
    rw [hsum]
    exact Function.bijective_id
  by_contra hne
  apply hM.not_bijective_sum Finset.univ g _ hb
  intro j _ hj
  apply hne
  let φ := LinearEquiv.ofBijective (g j) hj
  refine ⟨LinearMap.proj j ∘ₗ i, φ.symm.toLinearMap ∘ₗ (r ∘ₗ LinearMap.single R (fun _ => X) j),
    LinearMap.ext fun x => ?_⟩
  exact φ.symm_apply_apply x

end IsIndecomposableModule

end Exchange

section Retraction

/-- `M` is a direct summand of `N`: there are maps `i : M → N` and `r : N → M` with
`r ∘ i = id`. -/
def IsModuleSummand (R : Type*) [Semiring R] (M N : Type*) [AddCommMonoid M] [Module R M]
    [AddCommMonoid N] [Module R N] : Prop :=
  ∃ (i : M →ₗ[R] N) (r : N →ₗ[R] M), ∀ x, r (i x) = x

variable {R : Type*} [Ring R] {M J : Type*} [AddCommGroup M] [Module R M] [AddCommGroup J]
  [Module R J]

/-- An injective map out of a Baer module splits. -/
theorem exists_retraction_of_baer (hM : Module.Baer R M) (f : M →ₗ[R] J)
    (hf : Function.Injective f) : ∃ r : J →ₗ[R] M, r ∘ₗ f = LinearMap.id := by
  obtain ⟨r, hr⟩ := hM.extension_property f hf LinearMap.id
  exact ⟨r, hr⟩

end Retraction

section Embedding

variable {k A : Type*} [Field k] [Ring A] [Algebra k A] [FiniteDimensional k A]
  {τ : A →ₗ[k] k} {e : A}

/-- The self-duality `A e ≅ (e A)^*` of the perfect pairing. -/
def cornerDualEquiv (hnd : ∀ a, e * a = a → a ≠ 0 → ∃ b, b * e = b ∧ τ (a * b) ≠ 0)
    (hdim : finrank k (leftCorner (k := k) e) = finrank k (rightCorner (k := k) e)) :
    rightCorner (k := k) e ≃ₗ[k] Dual k (leftCorner (k := k) e) :=
  LinearEquiv.ofBijective _ (bijective_cornerPairing_dual hnd hdim)

theorem cornerDualEquiv_apply (hnd : ∀ a, e * a = a → a ≠ 0 → ∃ b, b * e = b ∧ τ (a * b) ≠ 0)
    (hdim : finrank k (leftCorner (k := k) e) = finrank k (rightCorner (k := k) e))
    (b : rightCorner (k := k) e) (a : leftCorner (k := k) e) :
    cornerDualEquiv hnd hdim b a = τ (a.1 * b.1) := rfl

variable {M : Type*} [AddCommGroup M] [Module A M] [Module k M] [IsScalarTower k A M]

/-- The functional `a ↦ φ(a m)` on `e A`. -/
def cornerFunctional (φ : Dual k M) (m : M) : Dual k (leftCorner (k := k) e) where
  toFun a := φ (a.1 • m)
  map_add' a a' := by rw [Submodule.coe_add, add_smul, map_add]
  map_smul' c a := by
    rw [SetLike.val_smul, smul_assoc, map_smul, RingHom.id_apply]

omit [FiniteDimensional k A] in
theorem cornerFunctional_add (φ : Dual k M) (m m' : M) :
    cornerFunctional (e := e) φ (m + m') = cornerFunctional φ m + cornerFunctional φ m' := by
  ext a
  change φ (a.1 • (m + m')) = φ (a.1 • m) + φ (a.1 • m')
  rw [smul_add, map_add]

/-- The map `M → A e` attached to a functional `φ` on `M`: `m` goes to the element `b` of `A e`
with `τ(a b) = φ(a m)` for `a ∈ e A`. -/
def cornerMap (hnd : ∀ a, e * a = a → a ≠ 0 → ∃ b, b * e = b ∧ τ (a * b) ≠ 0)
    (hdim : finrank k (leftCorner (k := k) e) = finrank k (rightCorner (k := k) e))
    (φ : Dual k M) : M →ₗ[A] lIdeal e where
  toFun m := ⟨((cornerDualEquiv hnd hdim).symm (cornerFunctional φ m)).1,
    ((cornerDualEquiv hnd hdim).symm (cornerFunctional φ m)).2⟩
  map_add' m m' := by
    apply Subtype.ext
    change (((cornerDualEquiv hnd hdim).symm (cornerFunctional φ (m + m'))) : A) =
      ((cornerDualEquiv hnd hdim).symm (cornerFunctional φ m) : A) +
        ((cornerDualEquiv hnd hdim).symm (cornerFunctional φ m') : A)
    rw [cornerFunctional_add, map_add, Submodule.coe_add]
  map_smul' x m := by
    apply Subtype.ext
    set Ψ := cornerDualEquiv hnd hdim
    set b := Ψ.symm (cornerFunctional φ m)
    have hxb : x * b.1 * e = x * b.1 := by rw [mul_assoc, b.2]
    have key : Ψ.symm (cornerFunctional φ (x • m)) = ⟨x * b.1, hxb⟩ := by
      apply Ψ.injective
      rw [Ψ.apply_symm_apply]
      ext a
      change φ (a.1 • x • m) = τ (a.1 * (x * b.1))
      have ha : e * (a.1 * x) = a.1 * x := by rw [← mul_assoc, a.2]
      have h1 := LinearMap.congr_fun (Ψ.apply_symm_apply (cornerFunctional φ m)) ⟨a.1 * x, ha⟩
      change τ ((a.1 * x) * b.1) = φ ((a.1 * x) • m) at h1
      rw [← mul_assoc, h1, mul_smul]
    change ((Ψ.symm (cornerFunctional φ (x • m)) : rightCorner (k := k) e) : A) = x * b.1
    rw [key]

omit [FiniteDimensional k A] in
theorem cornerFunctional_eq_zero_iff {φ : Dual k M} {m : M} :
    cornerFunctional (e := e) φ m = 0 ↔ ∀ a, e * a = a → φ (a • m) = 0 :=
  ⟨fun h a ha => LinearMap.congr_fun h ⟨a, ha⟩, fun h => LinearMap.ext fun a => h a.1 a.2⟩

/-- **A module with no nonzero element killed by `e A` embeds into a finite sum of copies of
`A e`**, when `A e` is self-dual through a perfect pairing. -/
theorem exists_injective_pi_lIdeal (he : IsIdempotentElem e)
    (hnd : ∀ a, e * a = a → a ≠ 0 → ∃ b, b * e = b ∧ τ (a * b) ≠ 0)
    (hdim : finrank k (leftCorner (k := k) e) = finrank k (rightCorner (k := k) e))
    [FiniteDimensional k M] (hM : ∀ m : M, (∀ a : A, (e * a) • m = 0) → m = 0) :
    ∃ f : M →ₗ[A] (Free.ChooseBasisIndex k M → lIdeal e), Function.Injective f := by
  let bM := Free.chooseBasis k M
  refine ⟨LinearMap.pi fun j => cornerMap hnd hdim (bM.coord j), fun m m' hmm => ?_⟩
  rw [← sub_eq_zero]
  apply hM
  intro a
  have hea : e * (e * a) = e * a := by rw [← mul_assoc, he.eq]
  apply bM.ext_elem
  intro j
  have hj := congrFun hmm j
  change cornerMap hnd hdim (bM.coord j) m = cornerMap hnd hdim (bM.coord j) m' at hj
  rw [← sub_eq_zero, ← map_sub] at hj
  have hz : (cornerDualEquiv hnd hdim).symm (cornerFunctional (bM.coord j) (m - m')) = 0 :=
    Subtype.ext (congrArg Subtype.val hj)
  rw [LinearEquiv.map_eq_zero_iff, cornerFunctional_eq_zero_iff] at hz
  rw [map_zero, Finsupp.zero_apply, ← Basis.coord_apply, hz _ hea]

/-- **An indecomposable injective module with no nonzero element killed by `e A` is a summand of
`A e`** (Webster, arXiv:1309.3796v3, proof of Theorem 5.30, (1) ⇒ (3), in the setting of a
self-dual projective `A e`). -/
theorem exists_retraction_lIdeal_of_injective (he : IsIdempotentElem e)
    (hnd : ∀ a, e * a = a → a ≠ 0 → ∃ b, b * e = b ∧ τ (a * b) ≠ 0)
    (hdim : finrank k (leftCorner (k := k) e) = finrank k (rightCorner (k := k) e))
    [FiniteDimensional k M] (hP : IsIndecomposableModule A M) (hB : Module.Baer A M)
    (hM : ∀ m : M, (∀ a : A, (e * a) • m = 0) → m = 0) :
    IsModuleSummand A M (lIdeal e) := by
  classical
  have : IsNoetherian A M := isNoetherian_of_tower k inferInstance
  have : IsArtinian A M := isArtinian_of_tower k inferInstance
  obtain ⟨f, hf⟩ := exists_injective_pi_lIdeal he hnd hdim hM
  obtain ⟨r, hr⟩ := exists_retraction_of_baer hB f hf
  obtain ⟨i', r', h⟩ := hP.exists_retraction_of_retraction_pi f r hr
  exact ⟨i', r', fun x => LinearMap.congr_fun h x⟩

end Embedding

end Categorification
