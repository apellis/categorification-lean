import Categorification.WeightedKLR.RedStrands.ParabolicStandardTensorBase

/-!
# Projective factors of the standard layers (Webster, arXiv:1309.3796v3, Prop. 5.21)

In the proof of Prop. 5.21 the layers of the filtration of a projective `T^λ e` are standard
modules `S(X ⊠ Y)` attached to a pair of projectives: `X` over the algebra `T^{λ'}` of the first
`ℓ` red strands and `Y` over the cyclotomic quotient `R^{λ_ℓ}` of the last one. The recursion of
`ParabolicStandardTensorBase` produces these factors through the classes `OldGen` and `CycGen`
(generated by the base cases under the induction functors `Fᵢ`). This file identifies them:

* `OldGen.exists_equiv`: every module of `OldGen` is isomorphic to some `T^{λ'} e(t)`;
* `CycGen.exists_equiv`: every module of `CycGen` is isomorphic to some `R^{λ_ℓ} e(u)`.

The induction steps are `Fᵢ (A e) ≅ A' e'` (`oldProjIndEquiv`, `cycProjIndEquiv`), from
`indLIdealEquiv`.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal

open CategoryTheory KLR KLRAlgebra InductionAlong MulOpposite ModuleFiltration
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

theorem castTensorProductAlgebra_castTensorProductAlgebra {I k : Type*} [DecidableEq I]
    [CommRing k] {m : ℕ} {Q : I → I → MvPolynomial (Fin 2) k} {Λ' : Fin m → I →₀ ℕ}
    {ν ν' : Multiset I} (h : ν = ν') (h' : ν' = ν) (t : TensorProductAlgebra k Q Λ' ν) :
    castTensorProductAlgebra Q Λ' h' (castTensorProductAlgebra Q Λ' h t) = t := by
  subst h; rfl

theorem exists_castTensorProductAlgebra_e {I k : Type*} [DecidableEq I]
    [CommRing k] {m : ℕ} {Q : I → I → MvPolynomial (Fin 2) k} {Λ' : Fin m → I →₀ ℕ}
    {ν ν' : Multiset I} (h : ν = ν') (s : Seq (stendhalWeight m ν)) (hs : IsRedOrdered s) :
    ∃ (t : Seq (stendhalWeight m ν')) (ht : IsRedOrdered t),
      castTensorProductAlgebra Q Λ' h (TensorProductAlgebra.mk Q Λ' ν (StendhalAlgebra.e s hs)) =
        TensorProductAlgebra.mk Q Λ' ν' (StendhalAlgebra.e t ht) := by
  subst h; exact ⟨s, hs, rfl⟩

variable {I : Type} {k : Type} [DecidableEq I] [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ)

local notation "Si" j => (Singleton.singleton j : Multiset I)
local notation "old" => Λ ∘ Fin.castSucc
local notation "aΛ" => fun j => (Polynomial.X : Polynomial k) ^ Λ (Fin.last ℓ) j
local notation "Told" => TensorProductAlgebra k Q (old)
local notation "Cyc" => CycKLR k Q (aΛ)

/-- The projective `T^{λ'} e(t)` over the algebra of the first `ℓ` red strands. -/
abbrev oldProj (θ : Multiset I) (t : Seq (stendhalWeight ℓ θ)) (ht : IsRedOrdered t) :
    ModuleCat.{0} (Told θ) :=
  ModuleCat.of _ (lIdeal (TensorProductAlgebra.mk Q (old) θ (StendhalAlgebra.e t ht)))

/-- The projective `R^{λ_ℓ} e(u)` over the cyclotomic quotient. -/
abbrev cycProj (β : Multiset I) (u : Seq β) : ModuleCat.{0} (Cyc β) :=
  ModuleCat.of _ (lIdeal (CycKLR.mk k Q (aΛ) β (e u)))

/-- The base of `OldGen` is `T^{λ'} e(t)`. -/
theorem nonempty_zeroRestrict_redFactorModule_equiv (θ : Multiset I)
    (s : Seq (stendhalWeight ℓ (θ + 0))) (hs : IsRedOrdered s) :
    ∃ (t : Seq (stendhalWeight ℓ θ)) (ht : IsRedOrdered t),
      Nonempty (zeroRestrict Q Λ (redFactorModule Q Λ θ s hs) ≃ₗ[Told θ] oldProj Q Λ θ t ht) := by
  obtain ⟨t, ht, he⟩ := exists_castTensorProductAlgebra_e (Q := Q) (Λ' := old) (add_zero θ) s hs
  refine ⟨t, ht, ⟨?_⟩⟩
  exact
  { toFun := fun x => ⟨castTensorProductAlgebra Q (old) (add_zero θ)
        (x : lIdeal (oldIdem Q Λ θ s hs)).1, by
      have hx := (x : lIdeal (oldIdem Q Λ θ s hs)).2
      change _ * _ = _
      rw [← he, ← map_mul]
      exact congrArg _ hx⟩
    invFun := fun y => (⟨castTensorProductAlgebra Q (old) (add_zero θ).symm y.1, by
      have hy := y.2
      change _ * _ = _
      rw [← castTensorProductAlgebra_castTensorProductAlgebra (add_zero θ) (add_zero θ).symm
        (oldIdem Q Λ θ s hs), he, ← map_mul]
      exact congrArg _ hy⟩ : lIdeal (oldIdem Q Λ θ s hs))
    map_add' := fun x y => Subtype.ext (map_add _ _ _)
    map_smul' := fun a x => by
      apply Subtype.ext
      change castTensorProductAlgebra Q (old) (add_zero θ)
          (emptyFactorToOld Q Λ θ ((emptyFactorEquiv Q Λ θ).symm a) *
            (x : lIdeal (oldIdem Q Λ θ s hs)).1) = a * _
      rw [map_mul]
      congr 1
      change castTensorProductAlgebra Q (old) (add_zero θ)
        (castTensorProductAlgebra Q (old) (add_zero θ).symm
          (emptyFactorEquiv Q Λ θ ((emptyFactorEquiv Q Λ θ).symm a))) = a
      rw [castTensorProductAlgebra_castTensorProductAlgebra, AlgEquiv.apply_symm_apply]
    left_inv := fun x => Subtype.ext (castTensorProductAlgebra_castTensorProductAlgebra _ _ _)
    right_inv := fun y => Subtype.ext (castTensorProductAlgebra_castTensorProductAlgebra _ _ _) }

variable (i : I)

/-- `Fᵢ T^{λ'} e(t) ≅ T^{λ'} e(t, i)`. -/
def oldProjIndEquiv (θ : Multiset I) (t : Seq (stendhalWeight ℓ θ)) (ht : IsRedOrdered t) :
    oldIndModule Q Λ i (oldProj Q Λ θ t ht) ≃ₗ[Told ((Si i) + θ)]
      oldProj Q Λ ((Si i) + θ) (appendBlackLoading i θ t) (appendBlackLoading_ordered i θ t ht) :=
  (indLIdealEquiv (appendBlackNU (Q := Q) (Λ := old) i θ) (isIdempotentElem_mk_e t ht)).trans
    (LinearEquiv.ofEq _ _ (congrArg lIdeal (appendBlack_mk_e Q (old) i θ t ht)))

theorem cyclotomicLast_mk_e (β : Multiset I) (u : Seq β) :
    AbsentColour.cyclotomicLast Q i (aΛ) β (CycKLR.mk k Q (aΛ) β (e u)) =
      CycKLR.mk k Q (aΛ) ((Si i) + β) (e (Seq.cast (add_comm β (Si i)) (u.append default))) := by
  rw [AbsentColour.cyclotomicLast_mk, cL_e]

theorem isIdempotentElem_cyc_e (β : Multiset I) (u : Seq β) :
    IsIdempotentElem (CycKLR.mk k Q (aΛ) β (e u)) :=
by
  apply IsIdempotentElem.map
  exact e_mul_self u

/-- `Fᵢ R^{λ_ℓ} e(u) ≅ R^{λ_ℓ} e(u, i)`. -/
def cycProjIndEquiv (β : Multiset I) (u : Seq β) :
    cycIndModule Q Λ i (cycProj Q Λ β u) ≃ₗ[Cyc ((Si i) + β)]
      cycProj Q Λ ((Si i) + β) (Seq.cast (add_comm β (Si i)) (u.append default)) :=
  (indLIdealEquiv (NonUnitalRingHomClass.toNonUnitalRingHom
      (AbsentColour.cyclotomicLast Q i (aΛ) β))
      (isIdempotentElem_cyc_e Q Λ β u)).trans
    (LinearEquiv.ofEq _ _ (congrArg lIdeal (cyclotomicLast_mk_e Q Λ i β u)))

omit [DecidableEq I] in
theorem seq_zero_subsingleton : Subsingleton (Seq (0 : Multiset I)) :=
  ⟨fun s t => Subtype.ext (funext fun a => absurd a.2 (by simp))⟩

/-- `R^{λ_ℓ}_0 = R^{λ_ℓ}_0 e(∅)`. -/
def cycProjZeroEquiv (u : Seq (0 : Multiset I)) :
    ModuleCat.of (Cyc 0) (Cyc 0) ≃ₗ[Cyc 0] cycProj Q Λ 0 u :=
  (Submodule.topEquiv (R := Cyc 0) (M := Cyc 0)).symm.trans (LinearEquiv.ofEq _ _ (by
    have : (e u : KLRAlgebra k Q (0 : Multiset I)) = 1 := by
      have := seq_zero_subsingleton (I := I)
      rw [← sum_e, Fintype.sum_subsingleton _ u]
    rw [this, map_one]
    ext x
    simp [lIdeal]))

/-- The modules of `OldGen` are the projectives `T^{λ'} e(t)`. -/
theorem OldGen.exists_equiv {θ : Multiset I} {X : ModuleCat.{0} (Told θ)}
    (hX : OldGen Q Λ θ X) :
    ∃ (t : Seq (stendhalWeight ℓ θ)) (ht : IsRedOrdered t),
      Nonempty (X ≃ₗ[Told θ] oldProj Q Λ θ t ht) := by
  induction hX with
  | base s hs => exact nonempty_zeroRestrict_redFactorModule_equiv Q Λ _ s hs
  | ind j X _ ih =>
    obtain ⟨t, ht, ⟨g⟩⟩ := ih
    exact ⟨_, _, ⟨(Ind.congr g).trans (oldProjIndEquiv Q Λ j _ t ht)⟩⟩

/-- The modules of `CycGen` are the projectives `R^{λ_ℓ} e(u)`. -/
theorem CycGen.exists_equiv {β : Multiset I} {Y : ModuleCat.{0} (Cyc β)}
    (hY : CycGen Q Λ β Y) :
    ∃ u : Seq β, Nonempty (Y ≃ₗ[Cyc β] cycProj Q Λ β u) := by
  induction hY with
  | base => exact ⟨Seq.ofList [] (by simp), ⟨cycProjZeroEquiv Q Λ _⟩⟩
  | ind j Y _ ih =>
    obtain ⟨u, ⟨g⟩⟩ := ih
    exact ⟨_, ⟨(Ind.congr g).trans (cycProjIndEquiv Q Λ j _ u)⟩⟩

end Categorification.Stendhal
