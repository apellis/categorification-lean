section Cover

variable {I : Type} {k : Type} [DecidableEq I] [Field k] {C : CartanDatum I}
  {Q : I → I → MvPolynomial (Fin 2) k} {ℓ : ℕ} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "CS" => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) (List.finRange ℓ)

/-- **Ordered covers of right loading standards at the red order `(1, …, ℓ)`** (Webster,
arXiv:1309.3796v3, Corollary 5.22, right form): for Rouquier parameters and a red-ordered `t`,
there is a short exact sequence `0 → K → e(t) e_λ V e_λ → S_t → 0` with `K` filtered by the
loading standards strictly above `t`. -/
theorem exists_cover_violLoadingStandard_finRange (hQ : IsRouquierQ C Q)
    (hall : ∀ (n : ℕ) (Λ' : Fin (n + 1) → I →₀ ℕ), AllFiniteDeltaInjective Q Λ' hQ.klrSymm)
    {t : Seq μ} (ht : IsRedOrdered t) :
    ∃ (K : ModuleCat.{0} CSᵐᵒᵖ)
      (i : K →ₗ[CSᵐᵒᵖ] rIdeal (violLoadingIdem (k := k) (Q := Q) (Λ := Λ)
        ((redWord_eq_finRange_iff t).2 ht)))
      (q : rIdeal (violLoadingIdem (k := k) (Q := Q) (Λ := Λ) ((redWord_eq_finRange_iff t).2 ht))
        →ₗ[CSᵐᵒᵖ] ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t (List.finRange ℓ)),
      Function.Injective i ∧ Function.Surjective q ∧ Function.Exact i q ∧
      ∃ l : List {c : Seq μ // IsRedOrdered c}, (∀ c ∈ l, StendhalLT t c.1) ∧
        HasFiltration (fun c => ModuleCat.of CSᵐᵒᵖ
          (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) c.1 (List.finRange ℓ))) l K := by
  let D := orderedStandardCovers Q (Λ ∘ ⇑(1 : Perm (Fin ℓ)))
    (fun s => exists_hasFiltration_leftUpper Q hQ.klrSymm hQ hall
      (Λ ∘ ⇑(1 : Perm (Fin ℓ))) ν s.1 s.2)
  suffices key : ∀ κ' : List (Fin ℓ), (List.finRange ℓ).map ⇑(1 : Perm (Fin ℓ)) = κ' →
      ∀ (s : Seq μ) (hs : redWord s = κ'), IsRedOrdered s →
      ∃ (K : ModuleCat.{0} (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ')ᵐᵒᵖ)
        (i : K →ₗ[(ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ')ᵐᵒᵖ]
          rIdeal (violLoadingIdem (k := k) (Q := Q) (Λ := Λ) hs))
        (q : rIdeal (violLoadingIdem (k := k) (Q := Q) (Λ := Λ) hs)
          →ₗ[(ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ')ᵐᵒᵖ]
            ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) s κ'),
        Function.Injective i ∧ Function.Surjective q ∧ Function.Exact i q ∧
        ∃ l : List {c : Seq μ // IsRedOrdered c}, (∀ c ∈ l, StendhalLT s c.1) ∧
          HasFiltration (fun c => ModuleCat.of
            (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ')ᵐᵒᵖ
            (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) c.1 κ')) l K from
    key _ (by simp) t _ ht
  rintro _ rfl s hs hso
  obtain ⟨t, ht, rfl⟩ : ∃ t, IsRedOrdered t ∧ Seq.redPerm 1 t = s :=
    ⟨s, hso, Seq.redPerm_one s⟩
  obtain ⟨K, i, q, hi, hq, hiq, l, hl, hf⟩ :=
    exists_cover_violLoadingStandard (isReducedChoice_canChoice ν) hQ.klrSymm 1 D ht
  refine ⟨K, i, q, hi, hq, hiq, l, fun c hc => ?_, ?_⟩
  · rw [Seq.redPerm_one]
    exact hl c hc
  · have hlm : l.map (fun c => Seq.redPerm 1 c.1) = l.map (fun c => c.1) :=
      List.map_congr_left fun c _ => Seq.redPerm_one _
    exact HasFiltration.relabel_of_map_eq (fun s => ModuleCat.of (ViolOrderCorner (k := k)
      (Q := Q) (Λ := Λ) (ν := ν) ((List.finRange ℓ).map ⇑(1 : Perm (Fin ℓ))))ᵐᵒᵖ
      (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) s
        ((List.finRange ℓ).map ⇑(1 : Perm (Fin ℓ))))) hf hlm

end Cover

local notation "𝕂" => RatFunc ℚ

variable {I : Type} {k : Type} {Y : Type*} [DecidableEq I] [Field k] [AddCommGroup Y] [Finite I]
    {Q : I → I → MvPolynomial (Fin 2) k} (C : CartanDatum I) (hQ : IsRouquierQ C Q)
    {R : C.toLusztig.RootDatum Y} (hR : R.IsXRegular) {ℓ : ℕ}
  [∀ (Ω : Fin ℓ → I →₀ ℕ) (ν : Multiset I), Module.Finite k (TensorProductAlgebra k Q Ω ν)]
  [∀ (Ω : Fin ℓ → I →₀ ℕ) (ν : Multiset I) (κ : List (Fin ℓ)),
    DG.HasDerivedCategory.{0, 0} (ViolOrderCorner (k := k) (Q := Q) (Λ := Ω) (ν := ν) κ)]
  [∀ (Ω : Fin ℓ → I →₀ ℕ) (ν : Multiset I) (κ : List (Fin ℓ)),
    DG.HasDerivedCategory.{0, 0} (ViolOrderCorner (k := k) (Q := Q) (Λ := Ω) (ν := ν) κ)ᵐᵒᵖ]
  [DG.HasDerivedCategory.{0, 0} ℤ]


include hR in
/-- **Mutation of the standard stratification** (Webster, arXiv:1309.3796v3, Proposition 6.20):
for every upper set `U` of red-ordered loadings, the thick subcategory generated by the images
`𝔅_w(S_s)` of the standards with `s ∈ U` equals the thick subcategory generated by the standards
`S'_{w s}` of the red order `w(1, …, ℓ)` with `s ∈ U`, where `w s = blockTransport w s` permutes
the blocks of `s` by `w`. Violated loadings, whose standards vanish, are left out of both
generating sets. Route hypotheses: those of Lemma 6.11 (`AllFiniteDeltaInjective` and
`RowFigureFiveHypotheses`). -/
theorem thickClosure_braidingFunctor_violLoadingStandard
    (hall : ∀ (n : ℕ) (Λ' : Fin (n + 1) → I →₀ ℕ), AllFiniteDeltaInjective Q Λ' hQ.klrSymm)
    (H : ∀ (n m : ℕ), n + 2 + m = ℓ → ∀ (Ω : Fin (n + 2 + m) → I →₀ ℕ)
      (u : Fin (n + 2 + m) → List I) (hu : u (rightPos n m) = []),
      RowFigureFiveHypotheses C hQ Ω u hu)
    (Λ : Fin ℓ → I →₀ ℕ) (wt : Fin ℓ → Dom R) (hwt : ∀ r i, (Λ r i : ℤ) = (wt r).1 (R.coroot i))
    (ν : Multiset I) (w : Perm (Fin ℓ)) (U : Set (Seq (stendhalWeight ℓ ν)))
    (hU : ∀ s t, s ∈ U → IsRedOrdered t → StendhalLE s t → t ∈ U) :
    ThickClosure (fun X => ∃ s, s ∈ U ∧ IsRedOrdered s ∧ ¬ IsViolated s ∧
      (braidingFunctor.{0} k Q Λ ν (List.finRange ℓ) ((List.finRange ℓ).map w)).obj
        (moduleObj (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) (List.finRange ℓ))ᵐᵒᵖ
          (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) s (List.finRange ℓ)))) = X) =
    ThickClosure (fun X => ∃ s, s ∈ U ∧ IsRedOrdered s ∧ ¬ IsViolated s ∧
      moduleObj (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) ((List.finRange ℓ).map w))ᵐᵒᵖ
        (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (blockTransport w s)
          ((List.finRange ℓ).map w))) = X) := by
  by_cases hw : w = 1
  · subst hw
    have h1 : (List.finRange ℓ).map ⇑(1 : Perm (Fin ℓ)) = List.finRange ℓ := by simp
    generalize (List.finRange ℓ).map ⇑(1 : Perm (Fin ℓ)) = κ' at h1 ⊢
    subst h1
    apply le_antisymm
    · refine thickClosure_le (isThick_thickClosure _) ?_
      rintro _ ⟨s, hsU, hs, hv, rfl⟩
      refine (isThick_thickClosure _).of_iso ((braidingFunctorSelfIso _).app _)
        (.of_mem ⟨s, hsU, hs, hv, ?_⟩)
      rw [blockTransport_one hs hv]
      rfl
    · refine thickClosure_le (isThick_thickClosure _) ?_
      rintro _ ⟨s, hsU, hs, hv, rfl⟩
      rw [blockTransport_one hs hv]
      exact (isThick_thickClosure _).of_iso ((braidingFunctorSelfIso _).app _).symm
        (.of_mem ⟨s, hsU, hs, hv, rfl⟩)
  obtain ⟨f, hf, hcls⟩ := hasCongruentBraidClass.{0} C hQ hR hall H w hw Λ wt hwt
  have hLt := isThick_thickClosure (fun X => ∃ s, s ∈ U ∧ IsRedOrdered s ∧ ¬ IsViolated s ∧
      (braidingFunctor.{0} k Q Λ ν (List.finRange ℓ) ((List.finRange ℓ).map w)).obj
        (moduleObj (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) (List.finRange ℓ))ᵐᵒᵖ
          (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) s (List.finRange ℓ)))) = X)
  have hRt := isThick_thickClosure (fun X => ∃ s, s ∈ U ∧ IsRedOrdered s ∧ ¬ IsViolated s ∧
      moduleObj (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) ((List.finRange ℓ).map w))ᵐᵒᵖ
        (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (blockTransport w s)
          ((List.finRange ℓ).map w))) = X)
  have hLB := hLt.comap (braidingFunctor.{0} k Q Λ ν (List.finRange ℓ) ((List.finRange ℓ).map w))
  have hRB := hRt.comap (braidingFunctor.{0} k Q Λ ν (List.finRange ℓ) ((List.finRange ℓ).map w))
  let r : {c : Seq (stendhalWeight ℓ ν) // IsRedOrdered c} → {c : Seq (stendhalWeight ℓ ν) // IsRedOrdered c} → Prop :=
    fun a b => StendhalLT b.1 a.1
  have : IsTrans _ r := ⟨fun a b c hab hbc => ⟨stendhalLE_trans hbc.1 hab.1,
    fun hac => hab.2 (stendhalLE_trans hac hbc.1)⟩⟩
  have : Std.Irrefl r := ⟨fun a ha => ha.2 ha.1⟩
  -- the cut `e(c) V e_{wλ}` is filtered by target standards at block-transported loadings
  have hcut : ∀ (c : Seq (stendhalWeight ℓ ν)) (hc : IsRedOrdered c) (hv : ¬ IsViolated c),
      ∃ W₀ ∈ braidColumnIndexList c w, W₀⁻¹ • c = blockTransport w c ∧
      (∀ W ∈ braidColumnIndexList c w, ∃ b : Seq (stendhalWeight ℓ ν), IsRedOrdered b ∧ ¬ IsViolated b ∧
        StendhalLE c b ∧ W⁻¹ • c = blockTransport w b ∧ (W ≠ W₀ → ¬ StendhalLE b c)) ∧
      HasFiltration (fun W : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) => ModuleCat.of
          (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) ((List.finRange ℓ).map w))ᵐᵒᵖ (ViolLoadingStandard (k := k) (Q := Q)
            (Λ := Λ) (W⁻¹ • c) ((List.finRange ℓ).map w))) (braidColumnIndexList c w).reverse
        (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) ((List.finRange ℓ).map w))ᵐᵒᵖ
          (violCorner k Q Λ ν c ((List.finRange ℓ).map w))) := fun c hc hv => by
    obtain ⟨W₀, hW₀, hlab₀, hlab⟩ := exists_braidColumnIndex_labels w hc hv
    obtain ⟨l', hl'v, hl'⟩ := exists_hasFiltration_violCorner_braidColumn C hQ hR Λ wt hwt w f hf
      hcls c hc
    exact ⟨W₀, hW₀, hlab₀, hlab, hl'.relabel_of_map_eq (fun s : Seq (stendhalWeight ℓ ν) => ModuleCat.of
      (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) ((List.finRange ℓ).map w))ᵐᵒᵖ (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) s
        ((List.finRange ℓ).map w))) (v := Subtype.val) (g := fun W => W⁻¹ • c) hl'v⟩
  -- (A) the images of source standards lie in the target thick closure
  have hA : ∀ c : {c : Seq (stendhalWeight ℓ ν) // IsRedOrdered c}, c.1 ∈ U →
      ThickClosure (fun X => ∃ s, s ∈ U ∧ IsRedOrdered s ∧ ¬ IsViolated s ∧
        moduleObj (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) ((List.finRange ℓ).map w))ᵐᵒᵖ
          (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (blockTransport w s)
            ((List.finRange ℓ).map w))) = X)
      ((braidingFunctor.{0} k Q Λ ν (List.finRange ℓ) ((List.finRange ℓ).map w)).obj
        (moduleObj (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) (List.finRange ℓ))ᵐᵒᵖ
          (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) c.1 (List.finRange ℓ))))) := by
    intro c
    induction c using (Finite.wellFounded_of_trans_of_irrefl r).induction with
    | _ c ih =>
    intro hcU
    by_cases hv : IsViolated c.1
    · exact moduleObj_mem_of_subsingleton hRB
        (subsingleton_loadingStandard_of_isViolated hv (List.finRange ℓ))
    obtain ⟨K, i, q, hi, hq, hiq, l, hl, hfK⟩ :=
      exists_cover_violLoadingStandard_finRange (Λ := Λ) hQ hall c.2
    have hK := hfK.moduleObj_mem hRB fun d hd =>
      ih d (hl d hd) (hU _ _ hcU d.2 (hl d hd).1)
    obtain ⟨W₀, -, -, hlab, hfil⟩ := hcut c.1 c.2 hv
    have hY := hfil.moduleObj_mem hRt fun W hW => by
      obtain ⟨b, hb, hbv, hcb, hWb, -⟩ := hlab W (List.mem_reverse.1 hW)
      exact .of_mem ⟨b, hU _ _ hcU hb hcb, hb, hbv, by rw [hWb]⟩
    have hP := hRt.of_iso (braidingFunctorObjLoadingProjectiveIso
      ((redWord_eq_finRange_iff c.1).2 c.2)) hY
    exact moduleObj_mem_of_exact₃ hRB
      (X := ModuleCat.of _ (rIdeal (violLoadingIdem (k := k) (Q := Q) (Λ := Λ)
        ((redWord_eq_finRange_iff c.1).2 c.2))))
      (Z := ModuleCat.of _ (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) c.1
        (List.finRange ℓ)))
      i q hi hq hiq hK hP
  -- (B) the target standards lie in the thick closure of the images
  have hB : ∀ c : {c : Seq (stendhalWeight ℓ ν) // IsRedOrdered c}, c.1 ∈ U → ¬ IsViolated c.1 →
      ThickClosure (fun X => ∃ s, s ∈ U ∧ IsRedOrdered s ∧ ¬ IsViolated s ∧
        (braidingFunctor.{0} k Q Λ ν (List.finRange ℓ) ((List.finRange ℓ).map w)).obj
          (moduleObj (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) (List.finRange ℓ))ᵐᵒᵖ
            (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) s (List.finRange ℓ)))) = X)
      (moduleObj (ModuleCat.of (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) ((List.finRange ℓ).map w))ᵐᵒᵖ
        (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (blockTransport w c.1)
          ((List.finRange ℓ).map w)))) := by
    intro c
    induction c using (Finite.wellFounded_of_trans_of_irrefl r).induction with
    | _ c ih =>
    intro hcU hv
    obtain ⟨K, i, q, hi, hq, hiq, l, hl, hfK⟩ :=
      exists_cover_violLoadingStandard_finRange (Λ := Λ) hQ hall c.2
    have hK := hfK.moduleObj_mem hLB fun d hd => by
      by_cases hdv : IsViolated d.1
      · exact moduleObj_mem_of_subsingleton hLB
          (subsingleton_loadingStandard_of_isViolated hdv (List.finRange ℓ))
      · exact .of_mem ⟨d.1, hU _ _ hcU d.2 (hl d hd).1, d.2, hdv, rfl⟩
    have hP := moduleObj_mem_of_exact₂ hLB
      (X := ModuleCat.of _ (rIdeal (violLoadingIdem (k := k) (Q := Q) (Λ := Λ)
        ((redWord_eq_finRange_iff c.1).2 c.2))))
      (Z := ModuleCat.of _ (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) c.1
        (List.finRange ℓ)))
      i q hi hq hiq hK (.of_mem ⟨c.1, hcU, c.2, hv, rfl⟩)
    have hY := hLt.of_iso (braidingFunctorObjLoadingProjectiveIso
      ((redWord_eq_finRange_iff c.1).2 c.2)).symm hP
    obtain ⟨W₀, hW₀, hlab₀, hlab, hfil⟩ := hcut c.1 c.2 hv
    obtain ⟨m₁, m₂, hm⟩ := List.append_of_mem (List.mem_reverse.2 hW₀)
    have hnd : (m₁ ++ W₀ :: m₂).Nodup :=
      hm ▸ List.nodup_reverse.2 (nodup_braidColumnIndexList c.1 w)
    rw [hm] at hfil
    have hmid := hfil.moduleObj_mem_of_mem_except hLt hY fun W hW => by
      have hWm : W ∈ braidColumnIndexList c.1 w := by
        rw [← List.mem_reverse, hm]
        exact List.mem_append.2 ((List.mem_append.1 hW).imp id (List.mem_cons_of_mem _))
      have hne : W ≠ W₀ := fun h => (List.nodup_cons.1 (List.nodup_middle.1 hnd)).1 (h ▸ hW)
      obtain ⟨b, hb, hbv, hcb, hWb, hstrict⟩ := hlab W hWm
      have := ih ⟨b, hb⟩ ⟨hcb, hstrict hne⟩ (hU _ _ hcU hb hcb) hbv
      rw [← hWb] at this
      exact this
    rw [hlab₀] at hmid
    exact hmid
  apply le_antisymm
  · refine thickClosure_le hRt ?_
    rintro _ ⟨s, hsU, hs, -, rfl⟩
    exact hA ⟨s, hs⟩ hsU
  · refine thickClosure_le hLt ?_
    rintro _ ⟨s, hsU, hs, hv, rfl⟩
    exact hB ⟨s, hs⟩ hsU hv

end FirstWeight

end Categorification.Stendhal
