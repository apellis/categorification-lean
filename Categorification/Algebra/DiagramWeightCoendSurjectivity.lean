import Categorification.Algebra.DiagramWeightCoend

/-!
# Surjectivity of graded coend multiplication

If ordinary products generate the target coefficient, the products of a
fixed total degree generate that homogeneous piece. Each such product
comes from a pure tensor over the corresponding intermediate weight.
-/

noncomputable section

namespace Categorification.Graded

open DirectSum

variable {M N P : Type*} [AddCommGroup M] [AddCommGroup N] [AddCommGroup P]
  (G : ℤ → AddSubgroup M) (H : ℤ → AddSubgroup N) (L : ℤ → AddSubgroup P)
  [Decomposition G] [Decomposition H] [Decomposition L]
  (β : M →+ N →+ P)

/-- The additive subgroup generated by pure products whose degrees sum to the given degree. -/
def homogeneousProductSpan (d : ℤ) : AddSubgroup P :=
  AddSubgroup.closure {z | ∃ (i j : ℤ) (x : G i) (y : H j), i + j = d ∧ β x.val y.val = z}

private def degreeProjection (d : ℤ) : P →+ P where
  toFun x := (decompose L x d).val
  map_zero' := by rw [decompose_zero, DirectSum.zero_apply]; rfl
  map_add' x y := by rw [decompose_add, DirectSum.add_apply]; rfl

/-- Projecting an arbitrary pure product to a degree gives a sum of products
of homogeneous inputs of that total degree. -/
theorem degreeProjection_product_mem
    (hw : ∀ {i j : ℤ} {x : M} {y : N}, x ∈ G i → y ∈ H j → β x y ∈ L (i + j))
    (x : M) (y : N) (d : ℤ) :
    degreeProjection L d (β x y) ∈ homogeneousProductSpan G H β d := by
  classical
  let F : M →+ P := (degreeProjection L d).comp ((AddMonoidHom.eval y).comp β)
  change F x ∈ _
  rw [← sum_support_decompose G x, map_sum]
  apply AddSubgroup.sum_mem
  intro i hi
  let K : N →+ P := (degreeProjection L d).comp (β (decompose G x i).val)
  change K y ∈ _
  rw [← sum_support_decompose H y, map_sum]
  apply AddSubgroup.sum_mem
  intro j hj
  let z := β (decompose G x i).val (decompose H y j).val
  have hz : z ∈ L (i + j) := hw (decompose G x i).property (decompose H y j).property
  change (decompose L z d).val ∈ _
  rw [DirectSum.decompose_of_mem _ hz]
  by_cases hij : i + j = d
  · subst d
    rw [DirectSum.of_eq_same]
    exact AddSubgroup.subset_closure ⟨i, j, _, _, rfl, rfl⟩
  · rw [DirectSum.of_eq_of_ne _ _ _ (Ne.symm hij)]
    exact zero_mem _

/-- If unrestricted pure products span the coefficient, then the pure
products of total degree `d` span its `d`-piece. -/
theorem homogeneousProductSpan_eq
    (hw : ∀ {i j : ℤ} {x : M} {y : N}, x ∈ G i → y ∈ H j → β x y ∈ L (i + j))
    (hspan : AddSubgroup.closure (Set.range fun z : M × N => β z.1 z.2) = ⊤)
    (d : ℤ) : homogeneousProductSpan G H β d = L d := by
  apply le_antisymm
  · apply (AddSubgroup.closure_le _).mpr
    rintro _ ⟨i, j, x, y, hdeg, rfl⟩
    rw [← hdeg]
    exact hw x.property y.property
  · intro z hz
    have hsub : AddSubgroup.closure (Set.range fun z : M × N => β z.1 z.2) ≤
        (homogeneousProductSpan G H β d).comap (degreeProjection L d) := by
      apply (AddSubgroup.closure_le _).mpr
      rintro _ ⟨⟨x, y⟩, rfl⟩
      exact degreeProjection_product_mem G H L β hw x y d
    have h : degreeProjection L d z ∈ homogeneousProductSpan G H β d :=
      hsub (show z ∈ AddSubgroup.closure
      (Set.range fun z : M × N => β z.1 z.2) by rw [hspan]; trivial)
    change (decompose L z d).val ∈ _ at h
    rwa [DirectSum.decompose_of_mem _ hz, DirectSum.of_eq_same] at h

end Categorification.Graded

namespace Categorification

open CategoryTheory DG MulOpposite
open scoped DG.DegreeZero

universe u

variable {A B C M N P : Type u} [Ring A] [Ring B] [Ring C]
  [InternalGrading A] [InternalGrading B] [InternalGrading C]
  [BigradedDGRing A] [BigradedDGRing B] [BigradedDGRing C]
  [AddCommGroup M] [AddCommGroup N] [AddCommGroup P]
  [Module A M] [Module Bᵐᵒᵖ M] [SMulCommClass A Bᵐᵒᵖ M]
  [Module B N] [Module Cᵐᵒᵖ N] [SMulCommClass B Cᵐᵒᵖ N]
  (G : ℤ → AddSubgroup M) (H : ℤ → AddSubgroup N) (L : ℤ → AddSubgroup P)
  (hgL : ∀ {i j : ℤ} {a : A} {x : M}, a ∈ wgrading i → x ∈ G j → a • x ∈ G (i + j))
  (hgR : ∀ {i j : ℤ} {b : B} {x : M}, b ∈ wgrading i → x ∈ G j → op b • x ∈ G (j + i))
  (hhL : ∀ {i j : ℤ} {b : B} {y : N}, b ∈ wgrading i → y ∈ H j → b • y ∈ H (i + j))
  (hhR : ∀ {i j : ℤ} {c : C} {y : N}, c ∈ wgrading i → y ∈ H j → op c • y ∈ H (j + i))
  (β : M →+ N →+ P)
  (hw : ∀ {i j : ℤ} {x : M} {y : N}, x ∈ G i → y ∈ H j → β x y ∈ L (i + j))
  (hb : ∀ (b : B) (x : M) (y : N), β (op b • x) y = β x (b • y))
  (X : WeightCategory A) (Z : WeightCategory C)

local notation "D₁" => diagramWeightBimodule G hgL hgR
local notation "D₂" => diagramWeightBimodule H hhL hhR
local notation "Out" => InDegreeZero (L (WeightCategory.as X - WeightCategory.as Z))

variable [DirectSum.Decomposition G] [DirectSum.Decomposition H] [DirectSum.Decomposition L]

/-- If the unrestricted coefficient products span the target, their coend
multiplication is onto at every pair of endpoint weights. -/
theorem diagramWeightCoendProduct_surjective
    (hspan : AddSubgroup.closure (Set.range fun z : M × N => β z.1 z.2) = ⊤) :
    Function.Surjective (diagramWeightCoendProduct G H L hgL hgR hhL hhR β hw hb X Z) := by
  let f := diagramWeightCoendProduct G H L hgL hgR hhL hhR β hw hb X Z
  let toValue : Out →+ P :=
    { toFun := fun x => x.val
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hle : Graded.homogeneousProductSpan G H β (X.as - Z.as) ≤ (toValue.comp f).range := by
    apply (AddSubgroup.closure_le _).mpr
    rintro _ ⟨i, j, a, b, hij, rfl⟩
    let Y : WeightCategory B := ⟨X.as - i⟩
    let x : (D₁).obj X Y := ⟨a.val, by
      change a.val ∈ G (X.as - (X.as - i))
      rw [show X.as - (X.as - i) = i by omega]
      exact a.property⟩
    let y : (D₂).obj Y Z := ⟨b.val, by
      change b.val ∈ H (X.as - i - Z.as)
      rw [show X.as - i - Z.as = j by omega]
      exact b.property⟩
    exact ⟨CatTensorProduct.tmul Y x y,
      diagramWeightCoendProduct_tmul G H L hgL hgR hhL hhR β hw hb X Z Y x y⟩
  intro z
  have hz : z.val ∈ Graded.homogeneousProductSpan G H β (X.as - Z.as) := by
    rw [Graded.homogeneousProductSpan_eq G H L β hw hspan]
    exact z.property
  obtain ⟨t, ht⟩ := hle hz
  exact ⟨t, Subtype.ext ht⟩

end Categorification
