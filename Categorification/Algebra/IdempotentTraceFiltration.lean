import Categorification.Algebra.ModuleFiltration

/-!
# A filtration of the trace of higher idempotents

Webster, arXiv:1309.3796v2, §6.1, proof of Lemma 6.8 at (6.21).
If an ordered filtration separates the layers killed by the higher idempotents from
the layers generated by them, its higher tail is a filtration of their trace.
-/

namespace Categorification.ModuleFiltration

universe u v w

variable {A : Type u} [Ring A] {ι : Type w}

/-- The submodule generated by the images of the selected idempotents. -/
def idempotentTrace (S : Set A) (X : ModuleCat.{v} A) : Submodule A X :=
  Submodule.span A {z | ∃ e ∈ S, ∃ x : X, z = e • x}

variable (S : Set A)

private theorem idempotentTrace_map_le {X Y : ModuleCat.{v} A} (f : X →ₗ[A] Y) :
    (idempotentTrace S X).map f ≤ idempotentTrace S Y := by
  rw [idempotentTrace, Submodule.map_span]
  refine Submodule.span_le.2 ?_
  rintro _ ⟨_, ⟨e, he, x, rfl⟩, rfl⟩
  exact Submodule.subset_span ⟨e, he, f x, map_smul f e x⟩

private theorem idempotentTrace_map_eq {X Y : ModuleCat.{v} A} (f : X →ₗ[A] Y)
    (hf : Function.Surjective f) : (idempotentTrace S X).map f = idempotentTrace S Y := by
  refine le_antisymm (idempotentTrace_map_le S f) ?_
  refine Submodule.span_le.2 ?_
  rintro _ ⟨e, he, y, rfl⟩
  obtain ⟨x, rfl⟩ := hf y
  exact ⟨e • x, Submodule.subset_span ⟨e, he, x, rfl⟩, map_smul f e x⟩

private theorem idempotentTrace_eq_map_of_killed {X Y Z : ModuleCat.{v} A}
    (f : X →ₗ[A] Y) (g : Y →ₗ[A] Z) (hfg : Function.Exact f g)
    (hS : ∀ e ∈ S, IsIdempotentElem e) (hZ : ∀ e ∈ S, ∀ z : Z, e • z = 0) :
    idempotentTrace S Y = (idempotentTrace S X).map f := by
  refine le_antisymm ?_ (idempotentTrace_map_le S f)
  refine Submodule.span_le.2 ?_
  rintro _ ⟨e, he, y, rfl⟩
  have hz : g (e • y) = 0 := by rw [map_smul, hZ e he]
  obtain ⟨x, hx⟩ := (hfg _).1 hz
  refine ⟨e • x, Submodule.subset_span ⟨e, he, x, rfl⟩, ?_⟩
  rw [map_smul, hx, smul_smul, (hS e he).eq]

variable {L : ι → ModuleCat.{v} A}

private theorem HasFiltration.idempotentTrace_eq_top {m : List ι} {Y : ModuleCat.{v} A}
    (h : HasFiltration L m Y) (hL : ∀ c ∈ m, idempotentTrace S (L c) = ⊤) :
    idempotentTrace S Y = ⊤ := by
  induction h with
  | zero hs => exact le_antisymm le_top fun y _ => (Subsingleton.elim y 0) ▸ Submodule.zero_mem _
  | @cons X Y Z f g m c hf hfg hg hX hZ ih =>
    obtain ⟨e⟩ := hZ
    have hXT := ih fun d hd => hL d (List.mem_cons_of_mem _ hd)
    have hZT : idempotentTrace S Z = ⊤ := by
      have h := idempotentTrace_map_eq S e.symm.toLinearMap e.symm.surjective
      rwa [hL c List.mem_cons_self, Submodule.map_top, LinearMap.range_eq_top.2 e.symm.surjective, eq_comm] at h
    refine le_antisymm le_top fun y _ => ?_
    have hy : g y ∈ (idempotentTrace S Y).map g := by
      rw [idempotentTrace_map_eq S g hg, hZT]
      exact Submodule.mem_top
    obtain ⟨v, hv, hv'⟩ := hy
    obtain ⟨x, hx⟩ := (hfg (y-v)).1 (by rw [map_sub, hv', sub_self])
    have hfx : f x ∈ idempotentTrace S Y :=
      idempotentTrace_map_le S f ⟨x, by rw [hXT]; exact Submodule.mem_top, rfl⟩
    rw [hx] at hfx
    simpa only [sub_add_cancel] using (idempotentTrace S Y).add_mem hfx hv

/-- The trace inherits the higher tail of a filtration, provided its top prefix
is killed by the selected idempotents and the tail layers are generated by them.
This isolates the cut-order condition needed for Webster's higher-standard kernel. -/
theorem HasFiltration.idempotentTrace {m n : List ι} {Y : ModuleCat.{v} A}
    (h : HasFiltration L (m ++ n) Y) (hS : ∀ e ∈ S, IsIdempotentElem e)
    (hkill : ∀ c ∈ m, ∀ e ∈ S, ∀ x : L c, e • x = 0)
    (hgen : ∀ c ∈ n, idempotentTrace S (L c) = ⊤) :
    HasFiltration L n (ModuleCat.of A (idempotentTrace S Y)) := by
  induction m generalizing Y with
  | nil =>
    have hT := HasFiltration.idempotentTrace_eq_top S h hgen
    exact h.of_equiv ((Submodule.topEquiv (R := A) (M := Y)).symm.trans
      (LinearEquiv.ofEq _ _ hT.symm))
  | cons c m ih =>
    cases h with
    | @cons X Y Z f g l d hf hfg hg hX hZ =>
      obtain ⟨e⟩ := hZ
      have hkill' : ∀ a ∈ S, ∀ z : Z, a • z = 0 := by
        intro a ha z
        apply e.injective
        rw [map_smul, map_zero]
        exact hkill c List.mem_cons_self a ha (e z)
      have htrace := idempotentTrace_eq_map_of_killed S f g hfg hS hkill'
      exact (ih hX (fun c hc => hkill c (List.mem_cons_of_mem _ hc))).of_equiv
        ((Submodule.equivMapOfInjective f hf _).trans (LinearEquiv.ofEq _ _ htrace.symm))

end Categorification.ModuleFiltration
