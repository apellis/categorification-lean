import Categorification.WeightedKLR.RedStrands.BraidedAppendDerived
import Categorification.WeightedKLR.RedStrands.BraidedBimoduleFlip

set_option backward.isDefEq.respectTransparency false

/-!
# The braiding functors commute with `𝔉_i`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2,
Proposition 6.7, for the functor `𝔉_i`. At a red order `κ`, `𝔉_i` is the derived tensor product
with the bimodule `F_κ = φ(e_κ) V e_κ`, the corner of the induction along appending a black strand
over the opposite algebras; here `φ` appends a black strand and `V` is the quotient by violated
idempotents for `i + ν`. The braiding functor `𝔅(κ', κ)` is the derived tensor product with
`B(κ', κ) = e_{κ'} V e_κ` (`BraidingFunctor`, Definition 6.6).

Webster's proof, as for `𝔈_i` (`BraidedAppendDerived`): both composites are tensor products with
bimodules projective where needed, and both bimodules are the corner `φ(e_{κ'}) V e_κ`.

* The composite `F_{κ'} ⊗ B(κ', κ)` is the corner by multiplication (`secondEquivF`), since
  `F_{κ'}` is generated by `φ(e_{κ'})`.
* The composite `B(κ', κ) ⊗ F_κ` is the corner by multiplication (`firstEquivF`). The top–bottom
  flip of diagrams (`violFlip`) carries it to the second composite of the proof for `𝔈_i`
  (`flipTensor`, `secondMult_flipTensor`), which is the corner by `secondEquiv`.
* `F_κ` is projective as a left module over the corner for `ν` (`appendCornerOp_projective_left`),
  by the flip from the projectivity of `E_κ` as a right module (`appendCorner_projective_right`,
  Theorem 4.31), and `F_{κ'}` is projective as a right module over the corner for `i + ν`.

## Main definitions and results

* `BraidedStendhalAlgebra.appendFunctorOp κ`: the functor `𝔉_i` at the red order `κ`.
* `BraidedStendhalAlgebra.compDGEquivF`: the two composite bimodules are isomorphic.
* `BraidedStendhalAlgebra.braidingFunctorCompAppendFunctorOpIso`: **Proposition 6.7** for `𝔉_i`,
  `𝔉_i ∘ 𝔅(κ', κ) ≅ 𝔅(κ', κ) ∘ 𝔉_i`, for symmetric Rouquier `Q` and `κ` an ordering of the red
  labels.

The functors live on the unbounded derived categories of ungraded right modules (rings in degree
`0`); Webster works with bounded above derived categories of graded modules.
-/

namespace Categorification.Stendhal

open KLR TypeA Equiv InductionAlong MulOpposite DG DG.DegreeZero

attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

namespace BraidedStendhalAlgebra

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ) (i : I) (ν : Multiset I)

set_option quotPrecheck false in
local notation "Rc" κ:max =>
  (isIdempotentElem_violMk_redProj k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ).Corner
set_option quotPrecheck false in
local notation "Sc" κ:max => (isIdempotentElem_violMk_redProj k Q Λ ν κ).Corner
set_option quotPrecheck false in
local notation "Ec" κ:max => InductionAlong.Corner (appendCornerHom Q Λ i ν κ)
set_option quotPrecheck false in
local notation "BR" κ':max κ:max =>
  ↥(braidingBimodule k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ' κ)
set_option quotPrecheck false in
local notation "BS" κ':max κ:max => ↥(braidingBimodule k Q Λ ν κ' κ)
set_option quotPrecheck false in
local notation "Vi" => ViolQuotient k Q Λ ((Singleton.singleton i : Multiset I) + ν)
set_option quotPrecheck false in
local notation "eR" κ:max => violMk k Q Λ ((Singleton.singleton i : Multiset I) + ν)
  (redProj k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ)
set_option quotPrecheck false in
local notation "eS" κ:max => violMk k Q Λ ν (redProj k Q Λ ν κ)
set_option quotPrecheck false in
local notation "φ" => appendViol Q Λ i ν

section Hom

variable (κ : List (Fin ℓ))

/-- Appending a black strand, as a map of the opposite corners. -/
noncomputable def appendCornerOpHom : (Sc κ)ᵐᵒᵖ →ₙ+* (Rc κ)ᵐᵒᵖ where
  toFun a := op (appendCornerHom Q Λ i ν κ a.unop)
  map_mul' a b := congrArg op (map_mul (appendCornerHom Q Λ i ν κ) b.unop a.unop)
  map_zero' := congrArg op (map_zero (appendCornerHom Q Λ i ν κ))
  map_add' a b := congrArg op (map_add (appendCornerHom Q Λ i ν κ) a.unop b.unop)

end Hom

set_option quotPrecheck false in
local notation "Fc" κ:max => InductionAlong.Corner (appendCornerOpHom Q Λ i ν κ)

section Facts

variable {Q Λ i ν}

theorem phi_mul_fval {κ : List (Fin ℓ)} (f : Fc κ) : φ (eS κ) * f.1.unop.1 = f.1.unop.1 :=
  congrArg (fun z : (Rc κ)ᵐᵒᵖ => z.unop.1) f.2

theorem fval_mul_idemR {κ : List (Fin ℓ)} (f : Fc κ) : f.1.unop.1 * eR κ = f.1.unop.1 :=
  corner_right f.1.unop

theorem idemR_mul_phi (κ : List (Fin ℓ)) : eR κ * φ (eS κ) = φ (eS κ) :=
  corner_left (appendCornerHom Q Λ i ν κ 1)

end Facts

section Projective

variable {Q Λ i ν}

/-- The flip intertwines appending a black strand on the corners and on their opposites. -/
theorem cornerFlipEquiv_appendCornerOpHom (κ : List (Fin ℓ)) (a : (Sc κ)ᵐᵒᵖ) :
    cornerFlipEquiv ((Singleton.singleton i : Multiset I) + ν) κ (appendCornerOpHom Q Λ i ν κ a) =
      appendCornerHom Q Λ i ν κ (cornerFlipEquiv ν κ a) :=
  Subtype.ext (violFlip_appendViol Q Λ i ν a.unop.1)

/-- **The bimodule of `𝔉_i` is a projective left module** over the corner for `ν`, at every
ordering `κ` of the red labels (arXiv:1309.3796v2, Theorem 4.31 through §6.1), for symmetric
Rouquier `Q`: the flip carries it to the bimodule of `𝔈_i` as a right module. -/
theorem appendCornerOp_projective_left
    {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
    {ρ' : Perm (Fin (Multiset.card (stendhalWeight ℓ ({i} + ν)))) → List ℕ}
    (hρ : IsReducedChoice ρ) (hρ' : IsReducedChoice ρ') (hQ : KLRSymm Q)
    (C : QuantumGroup.CartanDatum I) (hR : IsRouquierQ C Q)
    {κ : List (Fin ℓ)} (hκ : κ.Perm (List.finRange ℓ)) :
    Module.Projective (Sc κ)ᵐᵒᵖᵐᵒᵖ (Fc κ) := by
  have := appendCorner_projective_right (Λ := Λ) (i := i) hρ hρ' hQ C hR hκ
  exact projective_corner_of_ringEquiv (φ' := appendCornerHom Q Λ i ν κ)
    (cornerFlipEquiv ν κ) (cornerFlipEquiv ((Singleton.singleton i : Multiset I) + ν) κ)
    (cornerFlipEquiv_appendCornerOpHom κ)

end Projective

section First

variable (κ' κ : List (Fin ℓ))

/-- The tensor product `B(κ', κ) ⊗_{S_κ} F_κ` of the first composite. -/
abbrev firstTensorF : Type :=
  TensorProductOver (Sc κ)ᵐᵒᵖ (InDegreeZero (Fc κ)) (InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)))

/-- Multiplication `b ⊗ f ↦ φ(b) f` on the first composite. -/
noncomputable def firstMultF : firstTensorF (k := k) Q Λ i ν κ' κ →+ Vi :=
  TensorProductOver.lift
    (AddMonoidHom.mk' (fun f : InDegreeZero (Fc κ) =>
      AddMonoidHom.mk' (fun b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)) =>
        φ (show BS κ' κ from b).1 * (show Fc κ from f).1.unop.1)
        (fun b b' => (congrArg (· * _) (map_add φ _ _)).trans (add_mul _ _ _)))
      (fun f f' => by ext b; exact mul_add _ _ _))
    (fun a f b => by
      change φ _ * (φ _ * _) = φ (_ * _) * _
      rw [map_mul, mul_assoc]; rfl)

theorem firstMultF_tmul (f : InDegreeZero (Fc κ))
    (b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ))) :
    firstMultF Q Λ i ν κ' κ (TensorProductOver.tmul _ f b) =
      φ (show BS κ' κ from b).1 * (show Fc κ from f).1.unop.1 := rfl

variable {Q Λ i ν κ' κ} in
theorem firstMultF_mem (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    firstMultF Q Λ i ν κ' κ t ∈ cornerBimodule (φ (eS κ')) (eR κ) := by
  induction t using TensorProductOver.induction_on with
  | zero => exact zero_mem _
  | tmul f b =>
    rw [firstMultF_tmul, mem_cornerBimodule]
    refine ⟨by rw [← mul_assoc, ← map_mul, (show BS κ' κ from b).2.1], ?_⟩
    rw [mul_assoc, fval_mul_idemR]
  | add s t hs ht => rw [map_add]; exact add_mem hs ht

/-- The flip `B(κ', κ) → B(κ, κ')`. -/
noncomputable def flipB (b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ))) :
    InDegreeZero (OpBimodule (Sc κ) (BS κ κ')) :=
  (braidingBimoduleFlip (Q := Q) (Λ := Λ) (ν := ν) κ' κ
    (show BS κ' κ from b) : BS κ κ')

theorem flipB_val (b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ))) :
    (show BS κ κ' from flipB Q Λ ν κ' κ b).1 = violFlip (show BS κ' κ from b).1 := rfl

theorem flipB_flipB (b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ))) :
    flipB Q Λ ν κ κ' (flipB Q Λ ν κ' κ b) = b :=
  Subtype.ext (violFlip_violFlip _)

theorem flipB_add (b b' : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ))) :
    flipB Q Λ ν κ' κ (b + b') = flipB Q Λ ν κ' κ b + flipB Q Λ ν κ' κ b' :=
  Subtype.ext (violFlip_add' _ _)

variable {κ} in
/-- The flip `F_κ → E_κ`. -/
noncomputable def flipFE (f : InDegreeZero (Fc κ)) : InDegreeZero (OpBimodule (Rc κ) (Ec κ)) :=
  (⟨cornerFlip (show Fc κ from f).1.unop, Subtype.ext (by
      change violFlip _ * φ (eS κ) = violFlip _
      have h := congrArg violFlip (phi_mul_fval (show Fc κ from f))
      rwa [violFlip_mul', violFlip_appendViol, violFlip_idem] at h)⟩ : Ec κ)

variable {κ} in
/-- The flip `E_κ → F_κ`. -/
noncomputable def flipEF (x : InDegreeZero (OpBimodule (Rc κ) (Ec κ))) : InDegreeZero (Fc κ) :=
  (⟨op (cornerFlip (show Ec κ from x).1), congrArg op (Subtype.ext (by
      change φ (eS κ) * violFlip _ = violFlip _
      have h := congrArg violFlip (congrArg Subtype.val (show Ec κ from x).2)
      change violFlip ((show Ec κ from x).1.1 * φ (eS κ)) = _ at h
      rwa [violFlip_mul', violFlip_appendViol, violFlip_idem] at h))⟩ : Fc κ)

theorem flipFE_val (f : InDegreeZero (Fc κ)) :
    (show Ec κ from flipFE Q Λ i ν f).1.1 = violFlip (show Fc κ from f).1.unop.1 := rfl

theorem flipEF_val (x : InDegreeZero (OpBimodule (Rc κ) (Ec κ))) :
    (show Fc κ from flipEF Q Λ i ν x).1.unop.1 = violFlip (show Ec κ from x).1.1 := rfl

theorem flipEF_flipFE (f : InDegreeZero (Fc κ)) : flipEF Q Λ i ν (flipFE Q Λ i ν f) = f :=
  Subtype.ext (MulOpposite.unop_injective (Subtype.ext (violFlip_violFlip _)))

theorem flipFE_add (f f' : InDegreeZero (Fc κ)) :
    flipFE Q Λ i ν (f + f') = flipFE Q Λ i ν f + flipFE Q Λ i ν f' :=
  Subtype.ext (Subtype.ext (violFlip_add' _ _))

theorem flipEF_add (x x' : InDegreeZero (OpBimodule (Rc κ) (Ec κ))) :
    flipEF Q Λ i ν (x + x') = flipEF Q Λ i ν x + flipEF Q Λ i ν x' :=
  Subtype.ext (MulOpposite.unop_injective (Subtype.ext (violFlip_add' _ _)))

/-- The flip from the first composite for `𝔉_i` to the second composite for `𝔈_i`. -/
noncomputable def flipTensor :
    firstTensorF (k := k) Q Λ i ν κ' κ →+ secondTensor (k := k) Q Λ i ν κ κ' :=
  TensorProductOver.lift
    (AddMonoidHom.mk' (fun f : InDegreeZero (Fc κ) =>
      AddMonoidHom.mk' (fun b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)) =>
        TensorProductOver.tmul _ (flipB Q Λ ν κ' κ b) (flipFE Q Λ i ν f))
        (fun b b' => by rw [flipB_add, TensorProductOver.add_tmul]))
      (fun f f' => by
        ext b
        exact (congrArg _ (flipFE_add Q Λ i ν κ f f')).trans (TensorProductOver.tmul_add _ _ _)))
    (fun a f b => by
      have hE : flipFE Q Λ i ν ((op a : (Sc κ)ᵐᵒᵖᵐᵒᵖ) • f) =
          (op (cornerFlip a.unop) : (Sc κ)ᵐᵒᵖ) • flipFE Q Λ i ν f :=
        Subtype.ext (Subtype.ext (by
          change violFlip (φ a.unop.1 * _) = violFlip _ * φ (violFlip a.unop.1)
          rw [violFlip_mul', violFlip_appendViol]))
      have hB : flipB Q Λ ν κ' κ (a • b) =
          (op (op (cornerFlip a.unop)) : (Sc κ)ᵐᵒᵖᵐᵒᵖ) • flipB Q Λ ν κ' κ b :=
        Subtype.ext (violFlip_mul' _ _)
      change TensorProductOver.tmul _ (flipB Q Λ ν κ' κ b) (flipFE Q Λ i ν (op a • f)) =
        TensorProductOver.tmul _ (flipB Q Λ ν κ' κ (a • b)) (flipFE Q Λ i ν f)
      rw [hE, hB, TensorProductOver.op_smul_tmul])

theorem flipTensor_tmul (f : InDegreeZero (Fc κ))
    (b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ))) :
    flipTensor Q Λ i ν κ' κ (TensorProductOver.tmul _ f b) =
      TensorProductOver.tmul _ (flipB Q Λ ν κ' κ b) (flipFE Q Λ i ν f) := rfl

/-- The flip back, from the second composite for `𝔈_i` to the first composite for `𝔉_i`. -/
noncomputable def unflipTensor :
    secondTensor (k := k) Q Λ i ν κ κ' →+ firstTensorF (k := k) Q Λ i ν κ' κ :=
  TensorProductOver.lift
    (AddMonoidHom.mk' (fun b : InDegreeZero (OpBimodule (Sc κ) (BS κ κ')) =>
      AddMonoidHom.mk' (fun x : InDegreeZero (OpBimodule (Rc κ) (Ec κ)) =>
        TensorProductOver.tmul _ (flipEF Q Λ i ν x) (flipB Q Λ ν κ κ' b))
        (fun x x' => by rw [flipEF_add, TensorProductOver.add_tmul]))
      (fun b b' => by
        ext x
        exact (congrArg _ (flipB_add Q Λ ν κ κ' b b')).trans (TensorProductOver.tmul_add _ _ _)))
    (fun a b x => by
      have hE : flipEF Q Λ i ν (a • x) =
          (op (op (cornerFlip a.unop)) : (Sc κ)ᵐᵒᵖᵐᵒᵖ) • flipEF Q Λ i ν x :=
        Subtype.ext (MulOpposite.unop_injective (Subtype.ext (by
          change violFlip (_ * φ a.unop.1) = φ (violFlip a.unop.1) * violFlip _
          rw [violFlip_mul', violFlip_appendViol])))
      have hB : flipB Q Λ ν κ κ' ((op a : (Sc κ)ᵐᵒᵖᵐᵒᵖ) • b) =
          (op (cornerFlip a.unop) : (Sc κ)ᵐᵒᵖ) • flipB Q Λ ν κ κ' b :=
        Subtype.ext (violFlip_mul' _ _)
      change TensorProductOver.tmul _ (flipEF Q Λ i ν x) (flipB Q Λ ν κ κ' (op a • b)) =
        TensorProductOver.tmul _ (flipEF Q Λ i ν (a • x)) (flipB Q Λ ν κ κ' b)
      rw [hE, hB, TensorProductOver.op_smul_tmul])

theorem unflipTensor_tmul (b : InDegreeZero (OpBimodule (Sc κ) (BS κ κ')))
    (x : InDegreeZero (OpBimodule (Rc κ) (Ec κ))) :
    unflipTensor Q Λ i ν κ' κ (TensorProductOver.tmul _ b x) =
      TensorProductOver.tmul _ (flipEF Q Λ i ν x) (flipB Q Λ ν κ κ' b) := rfl

theorem unflipTensor_flipTensor (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    unflipTensor Q Λ i ν κ' κ (flipTensor Q Λ i ν κ' κ t) = t := by
  induction t using TensorProductOver.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul f b => rw [flipTensor_tmul, unflipTensor_tmul, flipEF_flipFE, flipB_flipB]
  | add s t hs ht => rw [map_add, map_add, hs, ht]

theorem secondMult_flipTensor (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    secondMult Q Λ i ν κ κ' (flipTensor Q Λ i ν κ' κ t) = violFlip (firstMultF Q Λ i ν κ' κ t) := by
  induction t using TensorProductOver.induction_on with
  | zero => rw [map_zero, map_zero, map_zero, violFlip_zero']
  | tmul f b =>
    rw [flipTensor_tmul, secondMult_tmul, firstMultF_tmul, flipFE_val, flipB_val, violFlip_mul',
      violFlip_appendViol]
  | add s t hs ht => rw [map_add, map_add, hs, ht, map_add, violFlip_add']

theorem firstMultF_unflipTensor (t : secondTensor (k := k) Q Λ i ν κ κ') :
    firstMultF Q Λ i ν κ' κ (unflipTensor Q Λ i ν κ' κ t) =
      violFlip (secondMult Q Λ i ν κ κ' t) := by
  induction t using TensorProductOver.induction_on with
  | zero => rw [map_zero, map_zero, map_zero, violFlip_zero']
  | tmul b x =>
    rw [unflipTensor_tmul, secondMult_tmul, firstMultF_tmul, flipEF_val, flipB_val, violFlip_mul',
      violFlip_appendViol]
  | add s t hs ht => rw [map_add, map_add, hs, ht, map_add, violFlip_add']

section Bijective

variable {Q Λ i ν} (hQ : KLRSymm Q)
  {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ} (hρ : IsReducedChoice ρ)

include hQ hρ in
theorem firstMultF_injective : Function.Injective (firstMultF Q Λ i ν κ' κ) := fun s t h => by
  rw [← unflipTensor_flipTensor Q Λ i ν κ' κ s, ← unflipTensor_flipTensor Q Λ i ν κ' κ t]
  congr 1
  apply secondMult_injective κ κ' hQ hρ
  rw [secondMult_flipTensor, secondMult_flipTensor, h]

include hQ hρ in
theorem firstMultF_surjective {z : Vi} (hz : z ∈ cornerBimodule (φ (eS κ')) (eR κ)) :
    ∃ t, firstMultF Q Λ i ν κ' κ t = z := by
  have hz' : violFlip z ∈ cornerBimodule (eR κ) (φ (eS κ')) := by
    refine ⟨?_, ?_⟩
    · have h := congrArg violFlip hz.2
      rwa [violFlip_mul', violFlip_idem] at h
    · have h := congrArg violFlip hz.1
      rwa [violFlip_mul', violFlip_appendViol, violFlip_idem] at h
  obtain ⟨t, ht⟩ := secondMult_surjective κ κ' hQ hρ hz'
  exact ⟨unflipTensor Q Λ i ν κ' κ t, by rw [firstMultF_unflipTensor, ht, violFlip_violFlip]⟩

/-- Multiplication identifies `B(κ', κ) ⊗_{S_κ} F_κ` with `φ(e_{κ'}) V e_κ`. -/
noncomputable def firstEquivF :
    firstTensorF (k := k) Q Λ i ν κ' κ ≃+ cornerBimodule (φ (eS κ')) (eR κ) :=
  AddEquiv.ofBijective ((firstMultF Q Λ i ν κ' κ).codRestrict _ firstMultF_mem)
    ⟨fun _ _ h => firstMultF_injective κ' κ hQ hρ (congrArg Subtype.val h),
      fun z => (firstMultF_surjective κ' κ hQ hρ z.2).imp fun _ h => Subtype.ext h⟩

theorem firstEquivF_val (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    (firstEquivF κ' κ hQ hρ t).1 = firstMultF Q Λ i ν κ' κ t := rfl

end Bijective

end First

section Second

variable (κ' κ : List (Fin ℓ))

/-- The tensor product `F_{κ'} ⊗_{R_{κ'}} B(κ', κ)` of the second composite. -/
abbrev secondTensorF : Type :=
  TensorProductOver (Rc κ')ᵐᵒᵖ (InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)))
    (InDegreeZero (Fc κ'))

/-- Multiplication `f ⊗ b ↦ f b` on the second composite. -/
noncomputable def secondMultF : secondTensorF (k := k) Q Λ i ν κ' κ →+ Vi :=
  TensorProductOver.lift
    (AddMonoidHom.mk' (fun b : InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)) =>
      AddMonoidHom.mk' (fun f : InDegreeZero (Fc κ') =>
        (show Fc κ' from f).1.unop.1 * (show BR κ' κ from b).1)
        (fun f f' => add_mul _ _ _))
      (fun b b' => by ext f; exact mul_add _ _ _))
    (fun a b f => (mul_assoc _ _ _).symm)

theorem secondMultF_tmul (b : InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)))
    (f : InDegreeZero (Fc κ')) :
    secondMultF Q Λ i ν κ' κ (TensorProductOver.tmul _ b f) =
      (show Fc κ' from f).1.unop.1 * (show BR κ' κ from b).1 := rfl

variable {Q Λ i ν κ' κ} in
theorem secondMultF_mem (t : secondTensorF (k := k) Q Λ i ν κ' κ) :
    secondMultF Q Λ i ν κ' κ t ∈ cornerBimodule (φ (eS κ')) (eR κ) := by
  induction t using TensorProductOver.induction_on with
  | zero => exact zero_mem _
  | tmul b f =>
    rw [secondMultF_tmul, mem_cornerBimodule]
    refine ⟨by rw [← mul_assoc, phi_mul_fval], ?_⟩
    rw [mul_assoc, (show BR κ' κ from b).2.2]
  | add s t hs ht => rw [map_add]; exact add_mem hs ht

theorem mem_braidingBimodule_of_mem_phi {z : Vi} (hz : z ∈ cornerBimodule (φ (eS κ')) (eR κ)) :
    z ∈ braidingBimodule k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ' κ := by
  refine ⟨?_, hz.2⟩
  rw [← hz.1, ← mul_assoc, idemR_mul_phi]

variable {Q Λ i ν κ' κ} in
theorem eq_tmul_unitGenF (t : secondTensorF (k := k) Q Λ i ν κ' κ) :
    t = TensorProductOver.tmul _
      (show InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)) from
        ⟨secondMultF Q Λ i ν κ' κ t,
          mem_braidingBimodule_of_mem_phi Q Λ i ν κ' κ (secondMultF_mem t)⟩)
      (show InDegreeZero (Fc κ') from unitGen (appendCornerOpHom Q Λ i ν κ')) := by
  induction t using TensorProductOver.induction_on with
  | zero =>
    symm
    convert TensorProductOver.zero_tmul _ using 2
    exact Subtype.ext (map_zero _)
  | tmul b f =>
    have hf : f = ((show Fc κ' from f).1 : (Rc κ')ᵐᵒᵖ) •
        (show InDegreeZero (Fc κ') from unitGen (appendCornerOpHom Q Λ i ν κ')) :=
      Subtype.ext (show Fc κ' from f).2.symm
    conv_lhs => rw [hf, ← TensorProductOver.op_smul_tmul]
    rfl
  | add s t hs ht =>
    conv_lhs => rw [hs, ht, ← TensorProductOver.add_tmul]
    congr 1
    exact Subtype.ext (map_add _ _ _).symm

theorem secondMultF_injective : Function.Injective (secondMultF Q Λ i ν κ' κ) := fun s t h => by
  rw [eq_tmul_unitGenF s, eq_tmul_unitGenF t]
  congr 2
  exact Subtype.ext h

theorem secondMultF_surjective {z : Vi} (hz : z ∈ cornerBimodule (φ (eS κ')) (eR κ)) :
    ∃ t, secondMultF Q Λ i ν κ' κ t = z :=
  ⟨TensorProductOver.tmul _
    (show InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)) from
      ⟨z, mem_braidingBimodule_of_mem_phi Q Λ i ν κ' κ hz⟩)
    (show InDegreeZero (Fc κ') from unitGen (appendCornerOpHom Q Λ i ν κ')), hz.1⟩

/-- Multiplication identifies `F_{κ'} ⊗_{R_{κ'}} B(κ', κ)` with `φ(e_{κ'}) V e_κ`. -/
noncomputable def secondEquivF :
    secondTensorF (k := k) Q Λ i ν κ' κ ≃+ cornerBimodule (φ (eS κ')) (eR κ) :=
  AddEquiv.ofBijective ((secondMultF Q Λ i ν κ' κ).codRestrict _ secondMultF_mem)
    ⟨fun _ _ h => secondMultF_injective Q Λ i ν κ' κ (congrArg Subtype.val h),
      fun z => (secondMultF_surjective Q Λ i ν κ' κ z.2).imp fun _ h => Subtype.ext h⟩

theorem secondEquivF_val (t : secondTensorF (k := k) Q Λ i ν κ' κ) :
    (secondEquivF Q Λ i ν κ' κ t).1 = secondMultF Q Λ i ν κ' κ t := rfl

end Second

/-! Shortcut instances for the actions on the two composites. The corners for `ν` and for
`i + ν` differ only in the multiset, and instance search otherwise spends its budget comparing
them. -/

noncomputable local instance (priority := high) firstTensorF.instModuleLeft
    (κ' κ : List (Fin ℓ)) :
    Module (Rc κ)ᵐᵒᵖ (firstTensorF (k := k) Q Λ i ν κ' κ) := inferInstance

noncomputable local instance (priority := high) firstTensorF.instSMulLeft
    (κ' κ : List (Fin ℓ)) :
    SMul (Rc κ)ᵐᵒᵖ (firstTensorF (k := k) Q Λ i ν κ' κ) := inferInstance

noncomputable local instance (priority := high) secondTensorF.instModuleLeft
    (κ' κ : List (Fin ℓ)) :
    Module (Rc κ)ᵐᵒᵖ (secondTensorF (k := k) Q Λ i ν κ' κ) := inferInstance

noncomputable local instance (priority := high) secondTensorF.instSMulLeft
    (κ' κ : List (Fin ℓ)) :
    SMul (Rc κ)ᵐᵒᵖ (secondTensorF (k := k) Q Λ i ν κ' κ) := inferInstance

