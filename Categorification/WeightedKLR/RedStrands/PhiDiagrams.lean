import Categorification.WeightedKLR.RedStrands.BlockAssignment
import Categorification.WeightedKLR.RedStrands.LeftStandardModule
import Categorification.KLR.SpanCornerDotsTop
import Categorification.TypeA.WeakOrder

/-!
# Webster's diagrams `x_φ` and the straightening of `e(t) T^λ e(s)`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §5.4,
before Lemma 5.19 and in the proof of Proposition 5.21. For a red-ordered loading `s` and a
block assignment `g` of `s` (`assignments`), the permutation `φ = phiPerm s g` of Webster's set
`Φ̃` moves every black strand of `s` to the end of its new block; its bottom is the loading
`φ • s` (`phiBottom`), which is red-ordered (`isRedOrdered_phiBottom`). For a choice `ρ` of
reduced words, `x_φ = ψ_{ρ φ} e(s)` (`phiElt`).

The step of the proof of Proposition 5.21 that `a ↦ a x_φ` sends `U_{s_φ}` into `P_{>φ}` rests
on the straightening lemma `seqIdem_mul_mul_seqIdem_mem_span_phiElt`: every element of
`e(t) T^λ e(s)` lies in the left ideal generated by the `x_φ` whose bottom `φ • s` is at least
`t` in Webster's order. For a diagram with bottom `s`, top `t = τ • s` and permutation `τ`, the
black strand at `p` is given the smaller of its block in `s` and the block of `τ p` in `t`
(`diagAssign`). The resulting `φ` lies below `τ` in the weak order (`invSet_phiPerm_diagAssign`),
so `ψ_τ` factors as `ψ_{τ φ⁻¹} ψ_φ` for suitable reduced words, and `t ≤ φ • s`
(`stendhalLE_phiBottom_diagAssign`). With the dots on top (`mem_span_corner_dotsTop`), each
spanning diagram of `e(t) T^λ e(s)` is a multiple of an `x_φ`.

## Main definitions

* `phiPerm`, `phiBottom`, `phiElt`, `diagAssign`.

## Main results

* `redIndexed_of_isRedOrdered`: in a red-ordered loading, `λ_r` has `r` red strands before it.
* `isRedOrdered_phiBottom`, `ofFn_phiBottom`.
* `seqIdem_mul_mul_seqIdem_mem_span_phiElt`: the straightening lemma.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal

open KLR TypeA Equiv MvPolynomial

section Combinatorics

variable {I : Type*} {n ℓ : ℕ}

/-- A sequence is red-ordered iff its red labels increase from left to right. -/
theorem isRedOrdered_iff_ofFn {μ : Multiset (I ⊕ Fin n)} (s : Seq μ) :
    IsRedOrdered s ↔ ((List.ofFn s.lbl).filterMap Sum.getRight?).Pairwise (· < ·) := by
  rw [List.ofFn_eq_map, List.filterMap_map, List.pairwise_filterMap]
  constructor
  · intro h
    refine (List.pairwise_lt_finRange _).imp fun {a b} hab r hr r' hr' => ?_
    exact h a b r r' hab (Sum.getRight?_eq_some_iff.1 hr) (Sum.getRight?_eq_some_iff.1 hr')
  · intro h a b r r' hab ha hb
    rw [List.pairwise_iff_getElem] at h
    have := h a b (by simp) (by simp) hab
    simp only [List.getElem_finRange, Fin.cast_mk, Fin.eta, Function.comp_apply] at this
    exact this r (by simp [ha]) r' (by simp [hb])

theorem redCount_eq_length_filterMap (L : List (I ⊕ Fin ℓ)) :
    redCount L = (L.filterMap Sum.getRight?).length := by
  induction L with
  | nil => rfl
  | cons y L ih =>
    rcases y with i | r
    · simpa [redCount, List.filterMap_cons] using ih
    · simp only [redCount, List.countP_cons, Sum.isRight_inr, ite_true, List.filterMap_cons,
        Sum.getRight?_inr, List.length_cons] at ih ⊢
      omega

variable {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

/-- The red letters of a loading of Stendhal weight are `λ_0, …, λ_{ℓ-1}`, once each. -/
theorem filterMap_ofFn_lbl_perm (s : Seq μ) :
    ((List.ofFn s.lbl).filterMap Sum.getRight?).Perm (List.finRange ℓ) := by
  have h : ((List.ofFn s.lbl : List (I ⊕ Fin ℓ)) : Multiset (I ⊕ Fin ℓ)) = μ := by
    rw [← Fin.univ_val_map]
    exact s.2
  rw [← Multiset.coe_eq_coe, ← Multiset.filterMap_coe, h, stendhalWeight,
    Multiset.filterMap_add, Multiset.filterMap_map, Multiset.filterMap_map]
  have h₁ : ∀ ν' : Multiset I,
      ν'.filterMap (Sum.getRight? ∘ Sum.inl : I → Option (Fin ℓ)) = 0 := fun ν' => by
    induction ν' using Multiset.induction_on <;> simp_all
  have h₂ : ((Finset.univ : Finset (Fin ℓ)).val.filterMap
      (Sum.getRight? ∘ (Sum.inr : Fin ℓ → I ⊕ Fin ℓ))) = ↑(List.finRange ℓ) := by
    rw [show (Sum.getRight? ∘ (Sum.inr : Fin ℓ → I ⊕ Fin ℓ)) = some from rfl,
      Multiset.filterMap_some, ← Multiset.map_id (Finset.univ : Finset (Fin ℓ)).val,
      Fin.univ_val_map, List.ofFn_id]
  rw [h₁ ν, h₂, zero_add]

/-- **Red strands are indexed by their position**: the red strand `λ_r` of a red-ordered
loading has exactly `r` red strands to its left. -/
theorem redIndexed_of_isRedOrdered {s : Seq μ} (hs : IsRedOrdered s) : RedIndexed s.lbl := by
  intro p r hp
  have hF : (List.ofFn s.lbl).filterMap Sum.getRight? = List.finRange ℓ :=
    List.Perm.eq_of_pairwise (fun a b _ _ hab hba => absurd (hab.trans hba) (lt_irrefl _))
      ((isRedOrdered_iff_ofFn s).1 hs) (List.pairwise_lt_finRange ℓ) (filterMap_ofFn_lbl_perm s)
  have htake : (List.ofFn s.lbl).take (p + 1) = (List.ofFn s.lbl).take p ++ [.inr r] := by
    rw [List.take_add_one, List.getElem?_ofFn]
    simp [hp]
  have hpre : (((List.ofFn s.lbl).take (p + 1)).filterMap Sum.getRight?) <+:
      List.finRange ℓ := hF ▸ (List.take_prefix _ _).filterMap _
  rw [htake, List.filterMap_append] at hpre
  simp only [List.filterMap_cons, Sum.getRight?_inr, List.filterMap_nil] at hpre
  set X := ((List.ofFn s.lbl).take p).filterMap Sum.getRight?
  have hX : X.length = redsBefore s.lbl p := by
    rw [redsBefore, redCount_eq_length_filterMap]
  obtain ⟨Y, hY⟩ := hpre
  have hlen : X.length < ℓ := by
    have := congrArg List.length hY
    simp only [List.length_append, List.length_singleton, List.length_finRange] at this
    omega
  have h1 : (List.finRange ℓ)[X.length]? = some r := by
    rw [← hY]
    simp
  rw [List.getElem?_eq_getElem (by simpa using hlen), List.getElem_finRange] at h1
  have h2 := congrArg Fin.val (Option.some_injective _ h1)
  simp only [Fin.val_cast] at h2
  omega

variable {m' : ℕ}

/-- A red letter at `p < q` raises the number of red letters before `q`. -/
theorem redsBefore_add_le (lbl : Fin m' → I ⊕ Fin ℓ) {p q : Fin m'} (h : p < q) :
    redsBefore lbl p + (if (lbl p).isRight then 1 else 0) ≤ redsBefore lbl q := by
  unfold redsBefore redCount
  have hsub : ((List.ofFn lbl).take (p + 1)).Sublist ((List.ofFn lbl).take q) :=
    (List.take_prefix_take_left (Fin.lt_def.1 h)).sublist
  have hc := hsub.countP_le (p := fun y => y.isRight)
  rw [List.take_add_one, List.getElem?_ofFn, List.countP_append] at hc
  simp only [Fin.is_lt, dite_true, Fin.eta, Option.toList_some] at hc
  split_ifs with hr <;> simp_all

/-- The base key `2 b(p) + [p red]` is monotone along a word. -/
theorem baseKey_le (lbl : Fin m' → I ⊕ Fin ℓ) {p q : Fin m'} (h : p ≤ q) :
    assignKey lbl (redsBefore lbl) p ≤ assignKey lbl (redsBefore lbl) q := by
  rcases h.lt_or_eq with h | rfl
  · have := redsBefore_add_le lbl h
    unfold assignKey
    split_ifs at this ⊢ <;> omega
  · exact le_rfl

theorem assignKey_red {lbl : Fin m' → I ⊕ Fin ℓ} {g : Fin m' → ℕ} (hg : g ∈ assignments lbl)
    {p : Fin m'} (hp : (lbl p).isRight) : assignKey lbl g p = 2 * redsBefore lbl p + 1 := by
  have := mem_assignList.1 hg p
  simp only [assignChoices, hp, ite_true, List.mem_singleton] at this
  simp [assignKey, hp, this]

theorem assignKey_black {lbl : Fin m' → I ⊕ Fin ℓ} (g : Fin m' → ℕ) {p : Fin m'}
    (hp : (lbl p).isRight = false) : assignKey lbl g p = 2 * g p := by
  simp [assignKey, hp]

/-- **Webster's `φ ∈ Φ̃`** of a block assignment `g` of `s`. -/
abbrev phiPerm (s : Seq μ) (g : Fin m → ℕ) : Perm (Fin m) :=
  keyPerm (assignKey s.lbl g)

/-- The bottom `φ • s` of `x_φ`. -/
abbrev phiBottom (s : Seq μ) (g : Fin m → ℕ) : Seq μ :=
  phiPerm s g • s

theorem ofFn_phiBottom {s : Seq μ} {g : Fin m → ℕ} (hg : g ∈ assignments s.lbl) :
    List.ofFn (phiBottom s g).lbl = assignWord s.lbl g :=
  ofFn_comp_assignPerm_symm hg

theorem isRedOrdered_phiBottom {s : Seq μ} (hs : IsRedOrdered s) {g : Fin m → ℕ}
    (hg : g ∈ assignments s.lbl) : IsRedOrdered (phiBottom s g) := by
  intro a b r r' hab ha hb
  change s.lbl ((phiPerm s g).symm a) = .inr r at ha
  change s.lbl ((phiPerm s g).symm b) = .inr r' at hb
  set p := (phiPerm s g).symm a
  set q := (phiPerm s g).symm b
  have hpq : phiPerm s g p < phiPerm s g q := by simpa [p, q] using hab
  have hkp := assignKey_red hg (p := p) (by simp [ha])
  have hkq := assignKey_red hg (p := q) (by simp [hb])
  have hrp := redIndexed_of_isRedOrdered hs p r ha
  have hrq := redIndexed_of_isRedOrdered hs q r' hb
  rcases (keyPerm_lt_iff _).1 hpq with h | ⟨h, h'⟩
  · exact Fin.lt_def.2 (by omega)
  · have := redsBefore_add_le s.lbl h'
    simp only [ha, Sum.isRight_inr, ite_true] at this
    exact Fin.lt_def.2 (by omega)

/-- The block assignment of a diagram with bottom `s`, top `τ • s` and permutation `τ`: each
black strand goes to the smaller of its block in `s` and the block of its end in `τ • s`. -/
def diagAssign (s : Seq μ) (τ : Perm (Fin m)) (p : Fin m) : ℕ :=
  if (s.lbl p).isRight then redsBefore s.lbl p
  else min (redsBefore s.lbl p) (redsBefore (τ • s).lbl (τ p))

theorem lbl_smul_apply (s : Seq μ) (τ : Perm (Fin m)) (p : Fin m) :
    (τ • s).lbl (τ p) = s.lbl p := by
  change s.1 (τ.symm (τ p)) = s.1 p
  rw [Equiv.symm_apply_apply]

theorem diagAssign_mem (s : Seq μ) (τ : Perm (Fin m)) : diagAssign s τ ∈ assignments s.lbl := by
  refine mem_assignList.2 fun p => ?_
  unfold diagAssign assignChoices
  split_ifs with h
  · exact List.mem_singleton_self _
  · exact List.mem_range.2 (Nat.lt_succ_of_le (min_le_left _ _))

theorem assignKey_diagAssign {s : Seq μ} (hs : IsRedOrdered s) {τ : Perm (Fin m)}
    (ht : IsRedOrdered (τ • s)) (p : Fin m) :
    assignKey s.lbl (diagAssign s τ) p = min (assignKey s.lbl (redsBefore s.lbl) p)
      (assignKey (τ • s).lbl (redsBefore (τ • s).lbl) (τ p)) := by
  have hl := lbl_smul_apply s τ p
  unfold assignKey diagAssign
  rw [hl]
  rcases hp : s.lbl p with i | r
  · simp only [Sum.isRight_inl, Bool.false_eq_true, ite_false, add_zero]
    omega
  · have h₁ := redIndexed_of_isRedOrdered hs p r hp
    have h₂ := redIndexed_of_isRedOrdered ht (τ p) r (hl.trans hp)
    simp only [Sum.isRight_inr, ite_true]
    omega

/-- The `φ` of a diagram lies below its permutation in the weak order. -/
theorem invSet_phiPerm_diagAssign {s : Seq μ} (hs : IsRedOrdered s) {τ : Perm (Fin m)}
    (ht : IsRedOrdered (τ • s)) : invSet m (phiPerm s (diagAssign s τ)) ⊆ invSet m τ := by
  rintro ⟨p, q⟩ hpq
  rw [mem_invSet] at hpq ⊢
  dsimp only at hpq ⊢
  obtain ⟨hlt, hφ⟩ := hpq
  refine ⟨hlt, ?_⟩
  have hk : assignKey s.lbl (diagAssign s τ) q < assignKey s.lbl (diagAssign s τ) p := by
    rcases (keyPerm_lt_iff _).1 hφ with h | ⟨-, h⟩
    · exact h
    · exact absurd (h.trans hlt) (lt_irrefl _)
  have hs' := baseKey_le s.lbl hlt.le
  rw [assignKey_diagAssign hs ht, assignKey_diagAssign hs ht] at hk
  by_contra hτ
  have ht' := baseKey_le (τ • s).lbl (not_lt.1 hτ)
  omega

/-- Black counts of a permuted loading, by positions in the original loading. -/
theorem blackCount_smul [DecidableEq I] (s : Seq μ) (w : Perm (Fin m)) (r : Fin ℓ) (i : I) :
    blackCount (w • s) r i = (Finset.univ.filter fun p =>
      s.lbl p = .inl i ∧ ∀ q, s.lbl q = .inr r → w p < w q).card := by
  classical
  refine (Finset.card_bij (fun p _ => w p) ?_ ?_ ?_).symm
  · intro p hp
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hp ⊢
    refine ⟨(lbl_smul_apply s w p).trans hp.1, fun b hb => ?_⟩
    have := hp.2 (w.symm b) (by rw [← lbl_smul_apply s w, Equiv.apply_symm_apply]; exact hb)
    rwa [Equiv.apply_symm_apply] at this
  · intro p _ q _ h
    exact w.injective h
  · intro a ha
    refine ⟨w.symm a, ?_, Equiv.apply_symm_apply w a⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha ⊢
    refine ⟨by rw [← lbl_smul_apply s w, Equiv.apply_symm_apply]; exact ha.1, fun q hq => ?_⟩
    rw [Equiv.apply_symm_apply]
    exact ha.2 (w q) ((lbl_smul_apply s w q).trans hq)

/-- The bottom of the `φ` of a diagram is at least its top. -/
theorem stendhalLE_phiBottom_diagAssign [DecidableEq I] {s : Seq μ} (hs : IsRedOrdered s) {τ : Perm (Fin m)}
    (ht : IsRedOrdered (τ • s)) : StendhalLE (τ • s) (phiBottom s (diagAssign s τ)) := by
  classical
  intro r i
  rw [blackCount_smul, blackCount_smul]
  refine Finset.card_le_card fun p hp => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hp ⊢
  refine ⟨hp.1, fun q hq => ?_⟩
  have hτ := hp.2 q hq
  refine (keyPerm_lt_iff _).2 (.inl ?_)
  rw [assignKey_diagAssign hs ht, assignKey_diagAssign hs ht]
  have hmono := baseKey_le (τ • s).lbl hτ.le
  have hpb : ((τ • s).lbl (τ p)).isRight = false := by rw [lbl_smul_apply, hp.1]; rfl
  have hqr : (τ • s).lbl (τ q) = .inr r := (lbl_smul_apply s τ q).trans hq
  have hkq := redIndexed_of_isRedOrdered ht (τ q) r hqr
  have hkq' := redIndexed_of_isRedOrdered hs q r hq
  have e₁ : assignKey (τ • s).lbl (redsBefore (τ • s).lbl) (τ p) =
      2 * redsBefore (τ • s).lbl (τ p) := assignKey_black _ hpb
  have e₂ : assignKey (τ • s).lbl (redsBefore (τ • s).lbl) (τ q) = 2 * r.val + 1 := by
    simp [assignKey, hqr, hkq]
  have e₃ : assignKey s.lbl (redsBefore s.lbl) q = 2 * r.val + 1 := by
    simp [assignKey, hq, hkq']
  omega

end Combinatorics

/-! ### The elements `x_φ` and straightening -/

section Algebra

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ} {ν : Multiset I}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "A" => TensorProductAlgebra k Q Λ ν
local notation "R" => KLRAlgebra k (stendhalQ Q Λ) (stendhalWeight ℓ ν)
local notation "E" => StendhalAlgebraAllOrders.e (k := k) (Q := Q) (Λ := Λ) (ν := ν)

/-- `e(t) y e(s)` as an element of `T̃^λ`. -/
def phiCut (t s : Seq μ) (ht : IsRedOrdered t) (hs : IsRedOrdered s)
    (y : StendhalAlgebraAllOrders k Q Λ ν) : StendhalAlgebra k Q Λ ν :=
  ⟨E t * y * E s, by
    classical
    rw [Subsemigroup.mem_corner_iff StendhalAlgebraAllOrders.isIdempotentElem_redOrderedIdem]
    constructor
    · rw [← mul_assoc, ← mul_assoc, StendhalAlgebraAllOrders.redOrderedIdem_mul_e,
        ite_eq_left_of_eq_true _ _ (eq_true ht)]
    · rw [mul_assoc, StendhalAlgebraAllOrders.e_mul_redOrderedIdem,
        ite_eq_left_of_eq_true _ _ (eq_true hs)]⟩

variable {Q Λ}

theorem phiCut_val {t s : Seq μ} (ht : IsRedOrdered t) (hs : IsRedOrdered s)
    (y : StendhalAlgebraAllOrders k Q Λ ν) : (phiCut Q Λ t s ht hs y).1 = E t * y * E s :=
  rfl

theorem phiCut_add {t s : Seq μ} (ht : IsRedOrdered t) (hs : IsRedOrdered s)
    (y y' : StendhalAlgebraAllOrders k Q Λ ν) :
    phiCut Q Λ t s ht hs (y + y') = phiCut Q Λ t s ht hs y + phiCut Q Λ t s ht hs y' :=
  Subtype.ext (by
    change E t * (y + y') * E s = E t * y * E s + E t * y' * E s
    rw [mul_add, add_mul])

theorem phiCut_zero {t s : Seq μ} (ht : IsRedOrdered t) (hs : IsRedOrdered s) :
    phiCut Q Λ t s ht hs 0 = 0 :=
  Subtype.ext (by
    change E t * 0 * E s = 0
    rw [mul_zero, zero_mul])

theorem phiCut_mul_phiCut {t b s : Seq μ} (ht : IsRedOrdered t) (hb : IsRedOrdered b)
    (hs : IsRedOrdered s) (y y' : StendhalAlgebraAllOrders k Q Λ ν) :
    phiCut Q Λ t b ht hb y * phiCut Q Λ b s hb hs y' =
      phiCut Q Λ t s ht hs (y * E b * y') :=
  Subtype.ext (by
    change E t * y * E b * (E b * y' * E s) = E t * (y * E b * y') * E s
    have hbb : E b * E b = E b := by
      simp [StendhalAlgebraAllOrders.e_mul_e]
    calc E t * y * E b * (E b * y' * E s) = E t * y * (E b * E b) * y' * E s := by
          simp only [mul_assoc]
      _ = _ := by rw [hbb]; simp only [mul_assoc])

theorem seqIdem_mul_mk_mul_seqIdem {t s : Seq μ} (ht : IsRedOrdered t) (hs : IsRedOrdered s)
    (c : StendhalAlgebra k Q Λ ν) :
    seqIdem Q Λ t ht * TensorProductAlgebra.mk Q Λ ν c * seqIdem Q Λ s hs =
      TensorProductAlgebra.mk Q Λ ν (phiCut Q Λ t s ht hs c.1) := by
  rw [seqIdem, seqIdem, ← map_mul, ← map_mul]
  congr 1

variable (Q Λ) in
/-- **Webster's diagram `x_φ = ψ_{ρ φ} e(s)`** for the block assignment `g` of `s` and the
choice `ρ` of reduced words, in `e(φ • s) T^λ e(s)`. -/
def phiElt (ρ : Perm (Fin m) → List ℕ) {s : Seq μ} (hs : IsRedOrdered s) {g : Fin m → ℕ}
    (hg : g ∈ assignments s.lbl) : A :=
  TensorProductAlgebra.mk Q Λ ν (phiCut Q Λ (phiBottom s g) s (isRedOrdered_phiBottom hs hg) hs
    (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (phiPerm s g)))))

omit [DecidableEq I] in
private theorem reduced_frame {ρ : Perm (Fin m) → List ℕ}
    (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w)
    (v : Perm (Fin m) → Perm (Fin m)) (hv : ∀ τ, invSet m (v τ) ⊆ invSet m τ) (τ : Perm (Fin m)) :
    IsReduced m (ρ (τ * (v τ)⁻¹) ++ ρ (v τ)) ∧ wordProd m (ρ (τ * (v τ)⁻¹) ++ ρ (v τ)) = τ := by
  have hl := length_add_of_invSet_subset (hv τ)
  refine ⟨⟨validWord_append.2 ⟨(hρ _).1.1, (hρ _).1.1⟩, ?_⟩, ?_⟩
  · rw [List.length_append, wordProd_append, (hρ _).2, (hρ _).2, inv_mul_cancel_right,
      (hρ _).1.2, (hρ _).1.2, (hρ _).2, (hρ _).2, hl]
  · rw [wordProd_append, (hρ _).2, (hρ _).2, inv_mul_cancel_right]

variable (Q Λ) in
/-- The left ideal generated by the `x_φ` with bottom at least `t`. -/
def phiSpan (ρ : Perm (Fin m) → List ℕ) {s : Seq μ} (hs : IsRedOrdered s) (t : Seq μ) :
    Submodule A A :=
  Submodule.span A {z | ∃ (g : Fin m → ℕ) (hg : g ∈ assignments s.lbl),
    StendhalLE t (phiBottom s g) ∧ z = phiElt Q Λ ρ hs hg}

/-- **The straightening lemma** (Webster, arXiv:1309.3796v3, proof of Proposition 5.21): for
any choice `ρ` of reduced words, every element of `e(t) T^λ e(s)` lies in the left ideal
generated by the `x_φ`, `φ ∈ Φ̃`, whose bottom `φ • s` is at least `t`. -/
theorem seqIdem_mul_mul_seqIdem_mem_span_phiElt (ρ : Perm (Fin m) → List ℕ)
    (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w) {s t : Seq μ} (hs : IsRedOrdered s)
    (ht : IsRedOrdered t) (a : A) :
    seqIdem Q Λ t ht * a * seqIdem Q Λ s hs ∈ phiSpan Q Λ ρ hs t := by
  classical
  obtain ⟨c, rfl⟩ := (RingCon.mkₐ_surjective (α := k) _) a
  obtain ⟨z, hz⟩ := StendhalAlgebraAllOrders.ofKLR_surjective (k := k) (Q := Q) (Λ := Λ)
    (ν := ν) c.1
  change seqIdem Q Λ t ht * TensorProductAlgebra.mk Q Λ ν c * seqIdem Q Λ s hs ∈ _
  rw [seqIdem_mul_mk_mul_seqIdem, ← hz]
  -- the cut element
  set r : R := KLRAlgebra.e t * z * KLRAlgebra.e s with hr_def
  have hcut : phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν z) =
      phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν r) := by
    apply Subtype.ext
    change E t * _ * E s = E t * _ * E s
    have htt : E t * E t = E t := by simp [StendhalAlgebraAllOrders.e_mul_e]
    have hss : E s * E s = E s := by simp [StendhalAlgebraAllOrders.e_mul_e]
    rw [hr_def, map_mul, map_mul]
    change _ = E t * (E t * _ * E s) * E s
    calc E t * StendhalAlgebraAllOrders.ofKLR k Q Λ ν z * E s
        = (E t * E t) * StendhalAlgebraAllOrders.ofKLR k Q Λ ν z * (E s * E s) := by
          rw [htt, hss]
      _ = _ := by simp only [mul_assoc]
  rw [hcut]
  have hr : KLRAlgebra.e t * r * KLRAlgebra.e s = r := by
    rw [hr_def, ← mul_assoc, ← mul_assoc, KLRAlgebra.e_mul_self, mul_assoc,
      KLRAlgebra.e_mul_self]
  -- the reduced words through `φ`
  let v : Perm (Fin m) → Perm (Fin m) := fun τ =>
    if τ • s = t then phiPerm s (diagAssign s τ) else 1
  have hv : ∀ τ, invSet m (v τ) ⊆ invSet m τ := fun τ => by
    dsimp only [v]
    split_ifs with h
    · exact invSet_phiPerm_diagAssign hs (h ▸ ht)
    · intro x hx
      simp [invSet] at hx
      exact absurd hx.2 (lt_asymm hx.1)
  let ρ' : Perm (Fin m) → List ℕ := fun τ => ρ (τ * (v τ)⁻¹) ++ ρ (v τ)
  have hρ' := reduced_frame hρ v hv
  have hmem := KLRAlgebra.mem_span_corner_dotsTop ρ' hρ' s t hr
  -- the map to `T^λ`
  let F : R → A := fun x =>
    TensorProductAlgebra.mk Q Λ ν (phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν x))
  change F r ∈ _
  suffices key : ∀ x ∈ Submodule.span k {b : R | ∃ (w : Perm (Fin m)) (u : Fin m →₀ ℕ),
      w • s = t ∧ KLRAlgebra.pol (monomial u 1) * KLRAlgebra.ψw (ρ' w) * KLRAlgebra.e s = b},
      F x ∈ phiSpan Q Λ ρ hs t from key r hmem
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨τ, u, hτ, rfl⟩ := hx
    have hvτ : v τ = phiPerm s (diagAssign s τ) := by simp [v, hτ]
    have hg := diagAssign_mem s τ
    have hb := isRedOrdered_phiBottom hs hg
    have hle : StendhalLE t (phiBottom s (diagAssign s τ)) :=
      hτ ▸ stendhalLE_phiBottom_diagAssign hs (hτ ▸ ht)
    have hfac : F (KLRAlgebra.pol (monomial u 1) * KLRAlgebra.ψw (ρ' τ) * KLRAlgebra.e s) =
        TensorProductAlgebra.mk Q Λ ν (phiCut Q Λ t (phiBottom s (diagAssign s τ)) ht hb
          (StendhalAlgebraAllOrders.ofKLR k Q Λ ν
            (KLRAlgebra.pol (monomial u 1) *
              KLRAlgebra.ψw (ρ (τ * (phiPerm s (diagAssign s τ))⁻¹))))) *
        phiElt Q Λ ρ hs hg := by
      have hb' : E (phiBottom s (diagAssign s τ)) *
          StendhalAlgebraAllOrders.ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (phiPerm s (diagAssign s τ)))) =
          StendhalAlgebraAllOrders.ofKLR k Q Λ ν
            (KLRAlgebra.ψw (ρ (phiPerm s (diagAssign s τ))) * KLRAlgebra.e s) := by
        change StendhalAlgebraAllOrders.ofKLR k Q Λ ν
          (KLRAlgebra.e (phiPerm s (diagAssign s τ) • s)) * _ = _
        rw [← map_mul, KLRAlgebra.e_mul_ψw, (hρ _).2, inv_smul_smul]
      rw [phiElt, ← map_mul, phiCut_mul_phiCut]
      simp only [F]
      congr 2
      rw [mul_assoc (StendhalAlgebraAllOrders.ofKLR k Q Λ ν _), hb', ← map_mul]
      congr 1
      rw [show ρ' τ = ρ (τ * (phiPerm s (diagAssign s τ))⁻¹) ++ ρ (phiPerm s (diagAssign s τ)) by
        simp only [ρ', hvτ], KLRAlgebra.ψw_append]
      simp only [mul_assoc]
    rw [hfac]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, hg, hle, rfl⟩)
  | zero =>
    change TensorProductAlgebra.mk Q Λ ν (phiCut Q Λ t s ht hs
      (StendhalAlgebraAllOrders.ofKLR k Q Λ ν 0)) ∈ _
    rw [map_zero, phiCut_zero, map_zero]
    exact zero_mem _
  | add x y _ _ hx hy =>
    change TensorProductAlgebra.mk Q Λ ν (phiCut Q Λ t s ht hs
      (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (x + y))) ∈ _
    rw [map_add, phiCut_add, map_add]
    exact add_mem hx hy
  | smul c x _ hx =>
    have hsm : phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (c • x)) =
        phiCut Q Λ t t ht ht (algebraMap k _ c) *
          phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν x) := by
      rw [phiCut_mul_phiCut]
      apply Subtype.ext
      change E t * _ * E s = E t * _ * E s
      have htt : E t * E t = E t := by simp [StendhalAlgebraAllOrders.e_mul_e]
      rw [map_smul, ← Algebra.smul_def]
      simp only [smul_mul_assoc, mul_smul_comm]
      congr 1
      rw [← mul_assoc (E t) (E t), htt]
    change TensorProductAlgebra.mk Q Λ ν (phiCut Q Λ t s ht hs
      (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (c • x))) ∈ _
    rw [hsm, map_mul]
    exact Submodule.smul_mem _ _ hx

end Algebra

end Categorification.Stendhal
