section Linear

open TensorProductOver.RightAction

variable {Q Λ i ν} {κ' κ : List (Fin ℓ)}

theorem firstMultF_smul (a : (Rc κ)ᵐᵒᵖ) (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    firstMultF Q Λ i ν κ' κ (a • t) = firstMultF Q Λ i ν κ' κ t * a.unop.1 :=
  DFunLike.congr_fun (TensorProductOver.addHom_ext
    (f := (firstMultF Q Λ i ν κ' κ).comp (DistribSMul.toAddMonoidHom _ a))
    (g := (AddMonoidHom.mulRight a.unop.1).comp (firstMultF Q Λ i ν κ' κ))
    fun _ _ => (mul_assoc _ _ _).symm) t

theorem secondMultF_smul (a : (Rc κ)ᵐᵒᵖ) (t : secondTensorF (k := k) Q Λ i ν κ' κ) :
    secondMultF Q Λ i ν κ' κ (a • t) = secondMultF Q Λ i ν κ' κ t * a.unop.1 :=
  DFunLike.congr_fun (TensorProductOver.addHom_ext
    (f := (secondMultF Q Λ i ν κ' κ).comp (DistribSMul.toAddMonoidHom _ a))
    (g := (AddMonoidHom.mulRight a.unop.1).comp (secondMultF Q Λ i ν κ' κ))
    fun _ _ => (mul_assoc _ _ _).symm) t

theorem firstMultF_op_smul (c : (Sc κ')ᵐᵒᵖᵐᵒᵖ) (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    firstMultF Q Λ i ν κ' κ (c • t) = φ c.unop.unop.1 * firstMultF Q Λ i ν κ' κ t :=
  DFunLike.congr_fun (TensorProductOver.addHom_ext
    (f := (firstMultF Q Λ i ν κ' κ).comp (DistribSMul.toAddMonoidHom _ c))
    (g := (AddMonoidHom.mulLeft (φ c.unop.unop.1)).comp (firstMultF Q Λ i ν κ' κ))
    fun _ _ => by
      change φ (_ * _) * _ = _ * (_ * _)
      rw [map_mul, mul_assoc]; rfl) t

theorem secondMultF_op_smul (c : (Sc κ')ᵐᵒᵖᵐᵒᵖ) (t : secondTensorF (k := k) Q Λ i ν κ' κ) :
    secondMultF Q Λ i ν κ' κ (c • t) = φ c.unop.unop.1 * secondMultF Q Λ i ν κ' κ t :=
  DFunLike.congr_fun (TensorProductOver.addHom_ext
    (f := (secondMultF Q Λ i ν κ' κ).comp (DistribSMul.toAddMonoidHom _ c))
    (g := (AddMonoidHom.mulLeft (φ c.unop.unop.1)).comp (secondMultF Q Λ i ν κ' κ))
    fun _ _ => mul_assoc _ _ _) t

end Linear

section Comparison

open TensorProductOver.RightAction

variable {Q Λ i ν} (κ' κ : List (Fin ℓ)) (hQ : KLRSymm Q)
  {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ} (hρ : IsReducedChoice ρ)

/-- The two composite bimodules for `𝔉_i` agree, both being the corner `φ(e_{κ'}) V e_κ`. -/
noncomputable def compAddEquivF :
    firstTensorF (k := k) Q Λ i ν κ' κ ≃+ secondTensorF (k := k) Q Λ i ν κ' κ :=
  (firstEquivF κ' κ hQ hρ).trans (secondEquivF Q Λ i ν κ' κ).symm

theorem secondMultF_compAddEquivF (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    secondMultF Q Λ i ν κ' κ (compAddEquivF κ' κ hQ hρ t) = firstMultF Q Λ i ν κ' κ t :=
  congrArg Subtype.val ((secondEquivF Q Λ i ν κ' κ).apply_symm_apply (firstEquivF κ' κ hQ hρ t))

theorem compAddEquivF_smul (a : (Rc κ)ᵐᵒᵖ) (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    compAddEquivF κ' κ hQ hρ (a • t) = a • compAddEquivF κ' κ hQ hρ t :=
  secondMultF_injective Q Λ i ν κ' κ <|
    (secondMultF_compAddEquivF κ' κ hQ hρ (a • t)).trans <| (firstMultF_smul a t).trans <|
      (congrArg (· * a.unop.1) (secondMultF_compAddEquivF κ' κ hQ hρ t).symm).trans
        (secondMultF_smul a _).symm

theorem compAddEquivF_op_smul (c : (Sc κ')ᵐᵒᵖᵐᵒᵖ) (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    compAddEquivF κ' κ hQ hρ (c • t) = c • compAddEquivF κ' κ hQ hρ t :=
  secondMultF_injective Q Λ i ν κ' κ <|
    (secondMultF_compAddEquivF κ' κ hQ hρ (c • t)).trans <| (firstMultF_op_smul c t).trans <|
      (congrArg (φ c.unop.unop.1 * ·) (secondMultF_compAddEquivF κ' κ hQ hρ t).symm).trans
        (secondMultF_op_smul c _).symm

/-- The comparison as a linear isomorphism of left `(Rc κ)ᵐᵒᵖ`-modules. -/
noncomputable def compLinearEquivF :
    firstTensorF (k := k) Q Λ i ν κ' κ ≃ₗ[(Rc κ)ᵐᵒᵖ] secondTensorF (k := k) Q Λ i ν κ' κ where
  __ := compAddEquivF κ' κ hQ hρ
  map_smul' := compAddEquivF_smul κ' κ hQ hρ

/-- The comparison as an isomorphism of dg modules concentrated in degree `0`. -/
noncomputable def compDGEquivF :
    firstTensorF (k := k) Q Λ i ν κ' κ ≃ᵈᵍ[(Rc κ)ᵐᵒᵖ] secondTensorF (k := k) Q Λ i ν κ' κ :=
  DGModuleEquiv.ofDegreeZero (compLinearEquivF κ' κ hQ hρ)
    (fun hx hn => TensorProductOver.eq_zero_of_mem_grading_inDegreeZero hn hx)
    TensorProductOver.d_inDegreeZero TensorProductOver.mem_grading_zero_inDegreeZero
    TensorProductOver.d_inDegreeZero

theorem compDGEquivF_op_smul (b : (Sc κ')ᵐᵒᵖ) (t : firstTensorF (k := k) Q Λ i ν κ' κ) :
    compDGEquivF (Λ := Λ) (i := i) κ' κ hQ hρ (MulOpposite.op b • t) =
      MulOpposite.op b • compDGEquivF (Λ := Λ) (i := i) κ' κ hQ hρ t :=
  compAddEquivF_op_smul κ' κ hQ hρ _ t

end Comparison

section Derived

open CategoryTheory TensorProductOver.RightAction

universe w

variable (κ : List (Fin ℓ))

/-- **The functor `𝔉_i` at the red order `κ`** (arXiv:1309.3796v2, §6.1): the derived tensor
product `- ⊗ᴸ F_κ` with `F_κ = φ(e_κ) V e_κ`, from right modules over the corner at `κ` for `ν`
to right modules over the corner at `κ` for `i + ν`. -/
noncomputable def appendFunctorOp [HasDerivedCategory.{w} (Sc κ)ᵐᵒᵖ]
    [HasDerivedCategory.{w} (Rc κ)ᵐᵒᵖ] :
    DG.DerivedCategory.{w} (Sc κ)ᵐᵒᵖ ⥤ DG.DerivedCategory.{w} (Rc κ)ᵐᵒᵖ :=
  derivedTensor.{w} (Rc κ)ᵐᵒᵖ (Sc κ)ᵐᵒᵖ (Fc κ)

variable {Q Λ i ν} {κ' κ : List (Fin ℓ)}

/-- **Webster, Proposition 6.7** for `𝔉_i`: the braiding functors commute with `𝔉_i`,
`𝔉_i ∘ 𝔅(κ', κ) ≅ 𝔅(κ', κ) ∘ 𝔉_i`, for symmetric Rouquier polynomials `Q` and a red order
`κ` that is a permutation of `1, …, ℓ`. -/
noncomputable def braidingFunctorCompAppendFunctorOpIso (hQ : KLRSymm Q)
    {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
    {ρ' : Perm (Fin (Multiset.card (stendhalWeight ℓ ({i} + ν)))) → List ℕ}
    (hρ : IsReducedChoice ρ) (hρ' : IsReducedChoice ρ') (C : QuantumGroup.CartanDatum I)
    (hR : IsRouquierQ C Q) (hκ : κ.Perm (List.finRange ℓ))
    [HasDerivedCategory.{w} (Rc κ')ᵐᵒᵖ] [HasDerivedCategory.{w} (Rc κ)ᵐᵒᵖ]
    [HasDerivedCategory.{w} (Sc κ')ᵐᵒᵖ] [HasDerivedCategory.{w} (Sc κ)ᵐᵒᵖ] :
    braidingFunctor.{w} k Q Λ ν κ' κ ⋙ appendFunctorOp.{w} Q Λ i ν κ ≅
      appendFunctorOp.{w} Q Λ i ν κ' ⋙ braidingFunctor.{w} k Q Λ ({i} + ν) κ' κ :=
  have : Module.Projective (Sc κ)ᵐᵒᵖᵐᵒᵖ (Fc κ) :=
    appendCornerOp_projective_left hρ hρ' hQ C hR hκ
  have : Module.Projective (Rc κ')ᵐᵒᵖ (Fc κ') := projective_corner_left _
  derivedTensorCompIsoOfProjective.{w} _ _ ≪≫
    dgDerivedTensorIsoOfEquiv (compDGEquivF κ' κ hQ hρ)
      (fun b t => compDGEquivF_op_smul (Λ := Λ) (i := i) κ' κ hQ hρ b t) ≪≫
    (dgDerivedTensorCompIso.{w} (InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)))
      (InDegreeZero.isKProjective :
        IsKProjective (Rc κ')ᵐᵒᵖ (InDegreeZero (Fc κ')))).symm

end Derived

end BraidedStendhalAlgebra

