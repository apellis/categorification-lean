import Categorification.WeightedKLR.RedStrands.OrderProjection
import Categorification.KLR.Concat
import Categorification.KLR.Reindex
import Categorification.KLR.Symmetries

/-!
# Stendhal diagrams with a red cap: the bimodule `K̃^{λ⁺}_λ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.3,
Definitions 7.14 and 7.15.

Fix red labels `λ = (λ_1, …, λ_ℓ)`, a position `j ≤ ℓ`, and two labels `μ, μ*` (in Webster's
setting `μ` is dominant and `μ* = -w₀μ`). Then
`λ⁺ = (λ_1, …, λ_j, μ, μ*, λ_{j+1}, …, λ_ℓ)` (zero-indexed: the two new red strands are the
strands `j` and `j + 1` of `λ⁺`). A `(λ, λ⁺)`-Stendhal diagram (Definition 7.14) is a Stendhal
diagram with `λ` at the top and `λ⁺` at the bottom in which the two new red strands are joined
by a cap. An element `v` of a coefficient module `L` sits at the maximum of the cap, and the
black strands of the loading of `v` leave it downwards between the two legs. In Webster's
definition `L = L_μ` is the simple quotient of Lemma 7.3, a right module over the algebra
`T̃^{(μ,μ*)}`; we allow any right module `L` over `T̃^{(μ,μ*)}` (with black weight `ν₀`).

## Encoding

Cutting a `(λ, λ⁺)`-diagram just above the maximum of the cap writes it as a Stendhal diagram
for `λ` on top, a *cap generator* in the middle, and a Stendhal diagram for `λ⁺` below. A cap
generator `cap s n v` is given by a loading `s` of `λ`, the number `n` of strands of `s` left of
the maximum, and `v ∈ L`: the cap is inserted into `s` after its first `n` strands, and its
bottom loading is `s` with the loading of `v` (the box) inserted at position `n`
(`insertSeq`). Generators whose top loading is not red-ordered, or whose cap does not sit
between the red strands `λ_j` and `λ_{j+1}`, vanish by the relations.

`K̃^{λ⁺}_λ` (Definition 7.15) is then the `T̃^λ`–`T̃^{λ⁺}` bimodule generated by the cap generators
modulo the following relations (`CupCap.IsRel`), which are the local relations of `T̃` including
planar isotopy, the action of the diagrams on the strands at the maximum, and the relations
(max1), (max2):

* `e(s) · cap s n v = cap s n v`;
* `cap s n (v · x) = cap s n v · ι_{s,n}(x)` for `x` in the KLR algebra of the strands meeting
  the maximum, `ι_{s,n}` placing `x` on the window `[n, n + N)` (`insertMap`): diagrams on the
  strands at the maximum act on `L`;
* a dot on a strand of the top, or a crossing of two neighbouring strands of the top on the same
  side of the maximum, may be pushed below the cap (isotopy);
* (max1): if the strand left of the maximum is black of colour `i`, pulling it under the cap to
  the right (crossing both legs and all strands at the maximum, `underRight`) gives `κ_i` times
  the diagram in which it passes over the maximum, i.e. `cap s (n - 1) v`;
* (max2): if the strand right of the maximum is black, pulling it under the cap to the left
  (`underLeft`) gives the diagram in which it passes over the maximum, i.e. `cap s (n + 1) v`.

Here `κ_i = (-1)^{g_i} ∏_{i' ≠ i} t_{i'i}^{g_{i'}}` (`cupScalar`), `g_{i'}` the number of black
strands of colour `i'` at the maximum (the multiplicity of `i'` in `ν₀`; for `L = L_μ` these are
Webster's `g_{i'}`, defined by `μ - w₀μ = ∑ g_{i'} α_{i'}`), and `t_{i'i} = Q_{i'i}(1, 0)`.
A strand crossing the top over the maximum is expressed through these relations, and the
local relations among the diagrams above and below the cap hold in `T̃^λ` and `T̃^{λ⁺}`.

`K^{λ⁺}_λ` is the quotient of `K̃^{λ⁺}_λ` by the violated diagrams (§7.3, after Lemma 7.17):
the sub-bimodule generated by the actions of the violating ideals of `T̃^λ` and `T̃^{λ⁺}`.

## Main definitions

* `CupCap.insertPos`: positions of `m` old and `N` new strands, the new ones on `[n, n + N)`.
* `CupCap.plusLabels`: the red labels `λ⁺`.
* `CupCap.insertSeq`: the bottom loading of a cap generator.
* `CupCap.insertMap`: the diagrams on the strands at the maximum, placed in `T̃^{λ⁺}`.
* `CupCap.cupScalar`: the scalar of (max1).
* `CupCap.CapTilde`: Webster's `K̃^{λ⁺}_λ` (Definition 7.15).
* `CupCap.Cap`: Webster's `K^{λ⁺}_λ`.

The grading is not formalized here.
-/

noncomputable section

namespace Categorification.Stendhal.CupCap

open KLR MvPolynomial TypeA MulOpposite
open scoped TensorProduct


/-! ### Positions -/

section Positions

variable (m N n : ℕ) (hn : n ≤ m)

/-- The positions of `m` old strands and `N` new strands, the new ones occupying the window
`[n, n + N)`: old strand `a` goes to `a` if `a < n` and to `a + N` otherwise. -/
def insertPos : Fin m ⊕ Fin N ≃ Fin (m + N) where
  toFun
    | .inl a => if a.val < n then ⟨a, by omega⟩ else ⟨a + N, by omega⟩
    | .inr b => ⟨n + b, by omega⟩
  invFun c :=
    if h : c.val < n then .inl ⟨c, by omega⟩
    else if h' : c.val < n + N then .inr ⟨c - n, by omega⟩ else .inl ⟨c - N, by omega⟩
  left_inv := by
    rintro (a | b)
    · by_cases ha : a.val < n
      · simp [ha]
      · have h1 : ¬ (a.val + N < n) := by omega
        have h2 : ¬ (a.val + N < n + N) := by omega
        simp [ha, h1, h2]
    · have h1 : ¬ (n + b.val < n) := by omega
      have h2 : n + b.val < n + N := by omega
      simp [h1, h2]
  right_inv := by
    intro c
    by_cases h : c.val < n
    · simp [h]
    · by_cases h' : c.val < n + N
      · have h1 : n + (c.val - n) = c.val := by omega
        simp [h, h', h1]
      · have h1 : ¬ (c.val - N < n) := by omega
        have h2 : c.val - N + N = c.val := by omega
        simp [h, h', h1, h2]

variable {m N n}

@[simp] theorem insertPos_inl_val (a : Fin m) :
    (insertPos m N n hn (.inl a)).val = if a.val < n then a.val else a.val + N := by
  simp only [insertPos, Equiv.coe_fn_mk]
  split_ifs <;> rfl

@[simp] theorem insertPos_inr_val (b : Fin N) : (insertPos m N n hn (.inr b)).val = n + b := rfl

end Positions

/-! ### Red labels -/

section Labels

variable {I : Type*} {ℓ : ℕ} (Λ : Fin ℓ → I →₀ ℕ) (Λc : Fin 2 → I →₀ ℕ) (j : ℕ) (hj : j ≤ ℓ)

/-- The old red strand `λ_r` is the red strand `oldRed r` of `λ⁺`. -/
def oldRed (r : Fin ℓ) : Fin (ℓ + 2) := insertPos ℓ 2 j hj (.inl r)

/-- The legs of the cap, labelled `μ = Λc 0` and `μ* = Λc 1`, are the red strands `j` and
`j + 1` of `λ⁺`. -/
def cupRed (r : Fin 2) : Fin (ℓ + 2) := insertPos ℓ 2 j hj (.inr r)

/-- **The red labels `λ⁺`** of Webster, arXiv:1309.3796v3, §7.3: `λ` with `μ, μ*` inserted
after its first `j` labels. -/
def plusLabels : Fin (ℓ + 2) → I →₀ ℕ := fun r => Sum.elim Λ Λc ((insertPos ℓ 2 j hj).symm r)

@[simp] theorem plusLabels_oldRed (r : Fin ℓ) : plusLabels Λ Λc j hj (oldRed j hj r) = Λ r := by
  simp [plusLabels, oldRed]

@[simp] theorem plusLabels_cupRed (r : Fin 2) :
    plusLabels Λ Λc j hj (cupRed j hj r) = Λc r := by
  simp [plusLabels, cupRed]

theorem oldRed_injective : Function.Injective (oldRed (ℓ := ℓ) j hj) :=
  fun _ _ h => Sum.inl_injective ((insertPos ℓ 2 j hj).injective h)

theorem cupRed_injective : Function.Injective (cupRed (ℓ := ℓ) j hj) :=
  fun _ _ h => Sum.inr_injective ((insertPos ℓ 2 j hj).injective h)

/-- The colours of the old strands as colours of `λ⁺`. -/
abbrev oldColour : I ⊕ Fin ℓ → I ⊕ Fin (ℓ + 2) := Sum.map id (oldRed j hj)

/-- The colours of the strands at the maximum as colours of `λ⁺`. -/
abbrev cupColour : I ⊕ Fin 2 → I ⊕ Fin (ℓ + 2) := Sum.map id (cupRed j hj)

theorem oldColour_injective : Function.Injective (oldColour (I := I) j hj) :=
  Sum.map_injective.2 ⟨Function.injective_id, oldRed_injective j hj⟩

theorem cupColour_injective : Function.Injective (cupColour (I := I) (ℓ := ℓ) j hj) :=
  Sum.map_injective.2 ⟨Function.injective_id, cupRed_injective j hj⟩

variable {k : Type*} [CommRing k] (Q : I → I → MvPolynomial (Fin 2) k)

theorem stendhalQ_oldColour (a b : I ⊕ Fin ℓ) :
    stendhalQ Q (plusLabels Λ Λc j hj) (oldColour j hj a) (oldColour j hj b) =
      stendhalQ Q Λ a b := by
  rcases a with a | a <;> rcases b with b | b <;> simp [stendhalQ]

theorem stendhalQ_cupColour (a b : I ⊕ Fin 2) :
    stendhalQ Q (plusLabels Λ Λc j hj) (cupColour j hj a) (cupColour j hj b) =
      stendhalQ Q Λc a b := by
  rcases a with a | a <;> rcases b with b | b <;> simp [stendhalQ]

/-- The red strands of `λ⁺`: the old ones and the two legs of the cap. -/
theorem univ_map_inr_plus :
    (Finset.univ.val.map (Sum.inr : Fin (ℓ + 2) → I ⊕ Fin (ℓ + 2))) =
      (Finset.univ.val.map (Sum.inr : Fin ℓ → I ⊕ Fin ℓ)).map (oldColour j hj) +
        (Finset.univ.val.map (Sum.inr : Fin 2 → I ⊕ Fin 2)).map (cupColour j hj) := by
  have h : Finset.univ.val.map (insertPos ℓ 2 j hj) = Finset.univ.val :=
    Multiset.map_univ_val_equiv _
  conv_lhs => rw [← h]
  rw [← Finset.univ_disjSum_univ, Finset.val_disjSum, Multiset.disjSum, Multiset.map_add,
    Multiset.map_add, Multiset.map_map, Multiset.map_map, Multiset.map_map, Multiset.map_map,
    Multiset.map_map, Multiset.map_map]
  rfl

end Labels

/-! ### The bottom loading of a cap generator -/

section Insert

variable {I : Type*} {ℓ : ℕ} (j : ℕ) (hj : j ≤ ℓ) (ν ν₀ : Multiset I)

theorem weight_plus :
    (stendhalWeight ℓ ν).map (oldColour j hj) + (stendhalWeight 2 ν₀).map (cupColour j hj) =
      stendhalWeight (ℓ + 2) (ν + ν₀) := by
  have e1 : (oldColour (I := I) j hj) ∘ Sum.inl = Sum.inl := funext fun _ => rfl
  have e2 : (cupColour (I := I) (ℓ := ℓ) j hj) ∘ Sum.inl = Sum.inl := funext fun _ => rfl
  simp only [stendhalWeight, Multiset.map_add, Multiset.map_map, e1, univ_map_inr_plus j hj, e2]
  abel

theorem card_plus :
    Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀)) =
      Multiset.card (stendhalWeight ℓ ν) +
        Multiset.card ((stendhalWeight 2 ν₀).map (cupColour (I := I) j hj)) := by
  rw [← weight_plus j hj ν ν₀, Multiset.card_add, Multiset.card_map]

variable {j hj ν ν₀}

/-- **The bottom loading of a cap generator**: the loading `s` of `λ` with the loading `t` of the
strands at the maximum inserted after its first `n` strands. -/
def insertSeq (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn : n ≤ Multiset.card (stendhalWeight ℓ ν))
    (t : Seq ((stendhalWeight 2 ν₀).map (cupColour j hj))) :
    Seq (stendhalWeight (ℓ + 2) (ν + ν₀)) :=
  ⟨Sum.elim (oldColour j hj ∘ s.1) t.1 ∘ (insertPos _ _ n hn).symm ∘
      Fin.cast (card_plus j hj ν ν₀), by
    have hc : (Finset.univ.val.map (Fin.cast (card_plus j hj ν ν₀))) = Finset.univ.val :=
      Multiset.map_univ_val_equiv (finCongr (card_plus j hj ν ν₀))
    have he : Finset.univ.val.map (insertPos (Multiset.card (stendhalWeight ℓ ν))
        (Multiset.card ((stendhalWeight 2 ν₀).map (cupColour j hj))) n hn).symm =
          Finset.univ.val :=
      Multiset.map_univ_val_equiv _
    rw [← Multiset.map_map, ← Multiset.map_map, hc, he,
      ← Finset.univ_disjSum_univ, Finset.val_disjSum, Multiset.disjSum, Multiset.map_add,
      Multiset.map_map, Multiset.map_map]
    simp only [Function.comp_def, Sum.elim_inl, Sum.elim_inr]
    rw [← weight_plus j hj ν ν₀]
    have h1 := s.2
    have h2 := t.2
    conv_rhs => rw [← h1, ← h2, Multiset.map_map]
    rfl⟩

theorem insertSeq_lbl_old (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn) (t) (a : Fin _) :
    (insertSeq (j := j) (hj := hj) (ν₀ := ν₀) s n hn t).lbl
        (Fin.cast (card_plus j hj ν ν₀).symm (insertPos _ _ n hn (.inl a))) =
      oldColour j hj (s.lbl a) := by
  simp [insertSeq, Seq.lbl]

theorem insertSeq_lbl_new (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn) (t) (b : Fin _) :
    (insertSeq (j := j) (hj := hj) (ν₀ := ν₀) s n hn t).lbl
        (Fin.cast (card_plus j hj ν ν₀).symm (insertPos _ _ n hn (.inr b))) = t.lbl b := by
  simp [insertSeq, Seq.lbl]

end Insert

/-! #### Adjacent transpositions and inserted positions -/

section Sadj

variable {m N n : ℕ} (hn : n ≤ m)

/-- The position of an old crossing `ψ_p` below the cap. -/
def crossPos (n N p : ℕ) : ℕ := if p < n then p else p + N

theorem sadj_insertPos_inr_new {q : ℕ} (hq : q + 1 < N) (b : Fin N) :
    sadj (m + N) (n + q) (insertPos m N n hn (.inr b)) =
      insertPos m N n hn (.inr (sadj N q b)) := by
  have := b.2
  ext
  simp only [sadj_val, insertPos_inr_val, swapNat]
  by_cases h1 : b.val = q <;> by_cases h2 : b.val = q + 1 <;>
    simp [h1, h2, hq, show n + q + 1 = n + (q + 1) by omega] <;> omega

theorem sadj_insertPos_inl_new {q : ℕ} (hq : q + 1 < N) (a : Fin m) :
    sadj (m + N) (n + q) (insertPos m N n hn (.inl a)) = insertPos m N n hn (.inl a) := by
  have := a.2
  apply sadj_apply_of_ne <;> rw [insertPos_inl_val] <;> split_ifs <;> omega

theorem sadj_insertPos_inl_old {p : ℕ} (hp : p + 1 < n ∨ n ≤ p) (a : Fin m) :
    sadj (m + N) (crossPos n N p) (insertPos m N n hn (.inl a)) =
      insertPos m N n hn (.inl (sadj m p a)) := by
  have := a.2
  ext
  simp only [sadj_val, insertPos_inl_val, crossPos, swapNat]
  split_ifs <;> omega

theorem sadj_insertPos_inr_old {p : ℕ} (hp : p + 1 < n ∨ n ≤ p) (b : Fin N) :
    sadj (m + N) (crossPos n N p) (insertPos m N n hn (.inr b)) = insertPos m N n hn (.inr b) := by
  apply sadj_apply_of_ne <;> rw [insertPos_inr_val, crossPos] <;> split_ifs <;> omega

end Sadj

section InsertSadj

variable {I : Type*} {ℓ : ℕ} {j : ℕ} {hj : j ≤ ℓ} {ν ν₀ : Multiset I}

local notation "M" => Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

/-- Every position of the bottom loading is an old or a new position. -/
theorem exists_insertPos {n : ℕ} (hn : n ≤ m) (c : Fin M) :
    ∃ x, c = Fin.cast (card_plus j hj ν ν₀).symm (insertPos _ _ n hn x) :=
  ⟨(insertPos _ _ n hn).symm (Fin.cast (card_plus j hj ν ν₀) c), by simp⟩

theorem cast_sadj {a b : ℕ} (h : a = b) (q : ℕ) (c : Fin a) :
    Fin.cast h (sadj a q c) = sadj b q (Fin.cast h c) := by
  subst h; rfl

theorem smul_insertSeq_new (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m)
    (t : Seq ((stendhalWeight 2 ν₀).map (cupColour j hj))) {q : ℕ}
    (hq : q + 1 < Multiset.card ((stendhalWeight 2 ν₀).map (cupColour j hj))) :
    sadj M (n + q) • insertSeq s n hn t =
      insertSeq s n hn
        (sadj (Multiset.card ((stendhalWeight 2 ν₀).map (cupColour j hj))) q • t) := by
  apply Subtype.ext
  funext c
  obtain ⟨x, rfl⟩ := exists_insertPos (j := j) (hj := hj) hn c
  change (insertSeq s n hn t).1 ((sadj M (n + q))⁻¹ _) = (insertSeq s n hn _).1 _
  rw [sadj_inv, ← cast_sadj]
  rcases x with a | b
  · rw [sadj_insertPos_inl_new hn hq]
    exact (insertSeq_lbl_old s n hn t a).trans (insertSeq_lbl_old s n hn _ a).symm
  · rw [sadj_insertPos_inr_new hn hq]
    refine (insertSeq_lbl_new s n hn t _).trans ?_
    refine Eq.trans ?_ (insertSeq_lbl_new s n hn _ b).symm
    change t.1 _ = t.1 ((sadj _ q)⁻¹ b)
    rw [sadj_inv]

theorem smul_insertSeq_old (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m)
    (t : Seq ((stendhalWeight 2 ν₀).map (cupColour j hj))) {p : ℕ} (hp : p + 1 < n ∨ n ≤ p) :
    sadj M (crossPos n (Multiset.card ((stendhalWeight 2 ν₀).map (cupColour j hj))) p) •
        insertSeq s n hn t = insertSeq (sadj m p • s) n hn t := by
  apply Subtype.ext
  funext c
  obtain ⟨x, rfl⟩ := exists_insertPos (j := j) (hj := hj) hn c
  change (insertSeq s n hn t).1 ((sadj M _)⁻¹ _) = (insertSeq _ n hn _).1 _
  rw [sadj_inv, ← cast_sadj]
  rcases x with a | b
  · rw [sadj_insertPos_inl_old hn hp]
    refine (insertSeq_lbl_old s n hn t _).trans ?_
    refine Eq.trans ?_ (insertSeq_lbl_old _ n hn t a).symm
    change oldColour j hj (s.1 _) = oldColour j hj (s.1 ((sadj m p)⁻¹ a))
    rw [sadj_inv]
  · rw [sadj_insertPos_inr_old hn hp]
    exact (insertSeq_lbl_new s n hn t b).trans (insertSeq_lbl_new _ n hn t b).symm

theorem insertSeq_injective (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) :
    Function.Injective (insertSeq (j := j) (hj := hj) (ν₀ := ν₀) s n hn) := by
  intro t t' h
  apply Subtype.ext
  funext b
  have := congrArg (fun u : Seq (stendhalWeight (ℓ + 2) (ν + ν₀)) =>
    u.lbl (Fin.cast (card_plus j hj ν ν₀).symm (insertPos _ _ n hn (.inr b)))) h
  simpa only [insertSeq_lbl_new] using this

end InsertSadj

/-! ### Diagrams at the maximum, placed below the cap -/

section Embedding

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ} {j : ℕ} {hj : j ≤ ℓ}
  {ν ν₀ : Multiset I}

local notation "M" => Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

/-- The bottom loadings of the cap generators at `s` and `n`. -/
def insertSet (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn : n ≤ m) :
    Finset (Seq (stendhalWeight (ℓ + 2) (ν + ν₀))) :=
  Finset.univ.image (insertSeq (j := j) (hj := hj) (ν₀ := ν₀) s n hn)

/-- The window `[n, n + N)` of the bottom loading of the cap generators at `s` and `n` holds
the strands at the maximum. -/
def insertEmb (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn : n ≤ m) :
    KLRAlgebra.BlockEmb ((stendhalWeight 2 ν₀).map (cupColour j hj))
      (stendhalWeight (ℓ + 2) (ν + ν₀))
      (insertSet (j := j) (hj := hj) (ν₀ := ν₀) s n hn) where
  o := n
  pos b := Fin.cast (card_plus j hj ν ν₀).symm (insertPos _ _ n hn (.inr b))
  pos_val _ := rfl
  F t := {insertSeq s n hn t}
  disj t t' h := by
    rw [Finset.disjoint_singleton]
    exact fun h' => h (insertSeq_injective s hn h')
  mem_T u := by simp [insertSet, eq_comm]
  lbl t u hu a := by
    rw [Finset.mem_singleton.1 hu]
    exact insertSeq_lbl_new s n hn t a
  sadj_mem q hq t u := by
    simp only [Finset.mem_singleton]
    rw [← smul_insertSeq_new s hn t hq]
    constructor
    · rintro rfl
      exact KLRAlgebra.sadj_smul_smul _ _
    · intro h
      rw [← h, KLRAlgebra.sadj_smul_smul]

variable (k) (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ) (Λc : Fin 2 → I →₀ ℕ) in
/-- The KLR algebra of the strands at the maximum, with the colours of `λ⁺`. -/
def cupRelabel :
    SeqRelabel k (stendhalQ Q Λc) (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight 2 ν₀)
      ((stendhalWeight 2 ν₀).map (cupColour j hj)) where
  card_eq := (SeqRelabel.ofInjective (cupColour_injective j hj)
    (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight 2 ν₀)).card_eq
  equiv := Seq.mapEquiv (cupColour_injective j hj) _
  equiv_smul := (SeqRelabel.ofInjective (cupColour_injective j hj)
    (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight 2 ν₀)).equiv_smul
  lbl_eq_iff := (SeqRelabel.ofInjective (cupColour_injective j hj)
    (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight 2 ν₀)).lbl_eq_iff
  Q_eq i a b _ := by
    simp only [Seq.mapEquiv_apply, Seq.map_lbl, Fin.cast_cast, Fin.cast_eq_self]
    exact stendhalQ_cupColour Λ Λc j hj Q _ _

variable (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ) (Λc : Fin 2 → I →₀ ℕ)

/-- **Diagrams on the strands at the maximum**, placed on the window `[n, n + N)` below the cap
generators at `s` and `n`: a unital map into the corner at their bottom loadings. -/
def insertHom (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn : n ≤ m) :
    KLRAlgebra k (stendhalQ Q Λc) (stendhalWeight 2 ν₀) →ₐ[k]
      (KLRAlgebra.eSum_idem (Q := stendhalQ Q (plusLabels Λ Λc j hj))
        (insertSet (j := j) (hj := hj) (ν₀ := ν₀) s n hn)).Corner :=
  ((insertEmb s n hn).hom (stendhalQ Q (plusLabels Λ Λc j hj))).comp
    (KLRAlgebra.relabelHom (cupRelabel (j := j) (hj := hj) (ν₀ := ν₀) k Q Λ Λc))

/-- The diagram `ι_{s,n}(x)` of the KLR algebra of `λ⁺`. -/
def insertMap (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn : n ≤ m)
    (x : KLRAlgebra k (stendhalQ Q Λc) (stendhalWeight 2 ν₀)) :
    KLRAlgebra k (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight (ℓ + 2) (ν + ν₀)) :=
  (insertHom Q Λ Λc s n hn x).val

theorem insertMap_mul (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn : n ≤ m)
    (x y : KLRAlgebra k (stendhalQ Q Λc) (stendhalWeight 2 ν₀)) :
    insertMap (j := j) (hj := hj) Q Λ Λc s n hn (x * y) =
      insertMap Q Λ Λc s n hn x * insertMap Q Λ Λc s n hn y := by
  simp only [insertMap, map_mul, KLR.Corner.val_mul]

end Embedding

/-! ### Crossing the cap -/

section Crossing

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {Q : I → I → MvPolynomial (Fin 2) k}
  {ν : Multiset I}

/-- A strand at position `q` pulled under a block of `N` strands to its right: the diagram
`ψ_q ψ_{q+1} ⋯ ψ_{q+N-1}`, whose top has the strand at `q`. -/
def underRight (N q : ℕ) : KLRAlgebra k Q ν := KLRAlgebra.ψw (List.range' q N)

/-- A strand at position `q` pulled under a block of `N` strands to its left... read from the
bottom: the diagram `ψ_{q+N-1} ⋯ ψ_q` takes a strand at the bottom position `q` to the top
position `q + N`. -/
def underLeft (N q : ℕ) : KLRAlgebra k Q ν := KLRAlgebra.ψw (List.range' q N).reverse

variable (Q) in
/-- **The scalar of the relation (max1)** of arXiv:1309.3796v3, Definition 7.15:
`(-1)^{g_i} ∏_{i' ≠ i} t_{i'i}^{g_{i'}}` for a black strand of colour `i` pulled under the cap,
where `g_{i'}` is the multiplicity of `i'` among the black strands at the maximum and
`t_{i'i} = Q_{i'i}(1, 0)` is the leading coefficient of `Q_{i'i}` in its first variable. -/
def cupScalar (ν₀ : Multiset I) (i : I) : k :=
  (-1) ^ ν₀.count i *
    ∏ i' ∈ ν₀.toFinset.erase i, MvPolynomial.eval ![1, 0] (Q i' i) ^ ν₀.count i'

end Crossing

/-! ### The bimodule `K̃^{λ⁺}_λ` -/

section Bimodule

variable {I : Type*} [DecidableEq I] (k : Type*) [CommRing k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ) (Λc : Fin 2 → I →₀ ℕ)
  (j : ℕ) (hj : j ≤ ℓ) (ν ν₀ : Multiset I)

local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "N" => Multiset.card (stendhalWeight 2 ν₀)
set_option hygiene false in
/-- The free bimodule on the cap generators, in this section. -/
local notation "𝔽" => FreeCap k Q Λ Λc j hj ν ν₀ L

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

/-- The quotient map of the KLR algebra of `λ` onto `T̃^λ`. -/
abbrev topMap : KLRAlgebra k (stendhalQ Q Λ) (stendhalWeight ℓ ν) →ₐ[k] StendhalAlgebra k Q Λ ν :=
  (orderProjection Q Λ ν).comp (StendhalAlgebraAllOrders.ofKLR k Q Λ ν)

/-- The quotient map of the KLR algebra of `λ⁺` onto `T̃^{λ⁺}`. -/
abbrev botMap :
    KLRAlgebra k (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight (ℓ + 2) (ν + ν₀)) →ₐ[k]
      StendhalAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀) :=
  (orderProjection Q (plusLabels Λ Λc j hj) (ν + ν₀)).comp
    (StendhalAlgebraAllOrders.ofKLR k Q (plusLabels Λ Λc j hj) (ν + ν₀))

/-- The quotient map of the KLR algebra of the strands at the maximum onto `T̃^{(μ, μ*)}`. -/
abbrev cupMap :
    KLRAlgebra k (stendhalQ Q Λc) (stendhalWeight 2 ν₀) →ₐ[k] StendhalAlgebra k Q Λc ν₀ :=
  (orderProjection Q Λc ν₀).comp (StendhalAlgebraAllOrders.ofKLR k Q Λc ν₀)

/-- The algebra `T̃^λ ⊗ (T̃^{λ⁺})ᵐᵒᵖ` whose modules are `T̃^λ`–`T̃^{λ⁺}` bimodules. It is a
`def` with its ring structure given once, so that every module over it uses the same semiring
structure. -/
def Env : Type _ :=
  StendhalAlgebra k Q Λ ν ⊗[k] (StendhalAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))ᵐᵒᵖ

noncomputable instance : Ring (Env k Q Λ Λc j hj ν ν₀) := Algebra.TensorProduct.instRing


variable {k Q Λ Λc j hj ν ν₀} in
/-- The element `a ⊗ bᵒᵖ` of `T̃^λ ⊗ (T̃^{λ⁺})ᵐᵒᵖ`, acting by `z ↦ a z b`. -/
def Env.mk (a : StendhalAlgebra k Q Λ ν) (b : StendhalAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀)) :
    Env k Q Λ Λc j hj ν ν₀ :=
  (a ⊗ₜ[k] op b :
    StendhalAlgebra k Q Λ ν ⊗[k] (StendhalAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))ᵐᵒᵖ)

variable (ℓ) in
/-- The cap generators: a loading of `λ` and the number of its strands left of the maximum. -/
abbrev CapIdx := Seq (stendhalWeight ℓ ν) × Fin (Multiset.card (stendhalWeight ℓ ν) + 1)

variable (L : Type*) [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]

/-- The free `T̃^λ ⊗ (T̃^{λ⁺})ᵐᵒᵖ`-module on the pairs of a cap generator index and an element
of `L`; additivity in `L` is imposed by the relations. -/
abbrev FreeCap := (CapIdx ℓ ν × L) →₀ Env k Q Λ Λc j hj ν ν₀

variable {k Q Λ Λc j hj ν ν₀ L}

/-- The cap generator `cap s n v`. -/
def gen (σ : CapIdx ℓ ν) (v : L) : FreeCap k Q Λ Λc j hj ν ν₀ L := Finsupp.single (σ, v) 1

/-- `a · z · b`. -/
def act (a : StendhalAlgebra k Q Λ ν) (b : StendhalAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))
    (z : FreeCap k Q Λ Λc j hj ν ν₀ L) : FreeCap k Q Λ Λc j hj ν ν₀ L :=
  Env.mk a b • z

/-- The position below the cap of the old strand `a`. -/
def dotPos (n : Fin (m + 1)) (a : Fin m) :
    Fin (Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀))) :=
  Fin.cast (card_plus j hj ν ν₀).symm (insertPos _ _ n (Nat.lt_succ_iff.1 n.2) (.inl a))

variable (k Q Λ Λc j hj ν ν₀ L) in
/-- **The relations of `K̃^{λ⁺}_λ`** (arXiv:1309.3796v3, Definition 7.15), see the module
docstring. -/
inductive IsRel : FreeCap k Q Λ Λc j hj ν ν₀ L → Prop
  /-- `cap s n v` is additive in `v`. -/
  | add (σ : CapIdx ℓ ν) (v w : L) :
      IsRel ((gen σ (v + w) : 𝔽) - gen σ v - gen σ w)
  /-- The top of `cap s n v` is `s`. -/
  | idem (s : Seq (stendhalWeight ℓ ν)) (n : Fin (m + 1)) (v : L) :
      IsRel (act (topMap k Q Λ ν (KLRAlgebra.e s)) 1 (gen (s, n) v : 𝔽) - (gen (s, n) v : 𝔽))
  /-- Diagrams on the strands at the maximum act on `L`. -/
  | box (s : Seq (stendhalWeight ℓ ν)) (n : Fin (m + 1)) (v : L)
      (x : KLRAlgebra k (stendhalQ Q Λc) (stendhalWeight 2 ν₀)) :
      IsRel ((gen (s, n) (op (cupMap k Q Λc ν₀ x) • v) : 𝔽) -
        act 1 (botMap k Q Λ Λc j hj ν ν₀ (insertMap Q Λ Λc s n (Nat.lt_succ_iff.1 n.2) x))
          (gen (s, n) v : 𝔽))
  /-- A dot on the top passes below the cap. -/
  | dot (s : Seq (stendhalWeight ℓ ν)) (n : Fin (m + 1)) (v : L) (a : Fin m) :
      IsRel (act (topMap k Q Λ ν (KLRAlgebra.x a)) 1 (gen (s, n) v : 𝔽) -
        act 1 (botMap k Q Λ Λc j hj ν ν₀ (KLRAlgebra.x (dotPos (j := j) (hj := hj) (ν₀ := ν₀) n a)))
          (gen (s, n) v : 𝔽))
  /-- A crossing of the top on one side of the maximum passes below the cap. -/
  | cross (s : Seq (stendhalWeight ℓ ν)) (n : Fin (m + 1)) (v : L) (p : ℕ)
      (hp : p + 1 < n.val ∨ n.val ≤ p) :
      IsRel (act (topMap k Q Λ ν (KLRAlgebra.ψ p)) 1 (gen (s, n) v : 𝔽) -
        act 1 (botMap k Q Λ Λc j hj ν ν₀ (KLRAlgebra.ψ (crossPos n N p)))
          (gen (sadj m p • s, n) v : 𝔽))
  /-- (max1): the black strand left of the maximum, pulled under the cap to the right. -/
  | over (s : Seq (stendhalWeight ℓ ν)) (n : Fin (m + 1)) (v : L) (i : I) (hn : 0 < n.val)
      (hi : s.lbl ⟨n - 1, by omega⟩ = .inl i) :
      IsRel (act 1 (botMap k Q Λ Λc j hj ν ν₀ (underRight N (n - 1))) (gen (s, n) v : 𝔽) -
        act (algebraMap k _ (cupScalar Q ν₀ i)) 1 (gen (s, ⟨n - 1, by omega⟩) v : 𝔽))
  /-- (max2): the black strand right of the maximum, pulled under the cap to the left. -/
  | under (s : Seq (stendhalWeight ℓ ν)) (n : Fin (m + 1)) (v : L) (i : I) (hn : n.val < m)
      (hi : s.lbl ⟨n, hn⟩ = .inl i) :
      IsRel (act 1 (botMap k Q Λ Λc j hj ν ν₀ (underLeft N n)) (gen (s, n) v : 𝔽) -
        (gen (s, ⟨n + 1, by omega⟩) v : 𝔽))

variable (k Q Λ Λc j hj ν ν₀ L) in
/-- The relations of `K̃^{λ⁺}_λ`, as a sub-bimodule. -/
def relations : Submodule (Env k Q Λ Λc j hj ν ν₀) (FreeCap k Q Λ Λc j hj ν ν₀ L) :=
  Submodule.span _ {z | IsRel k Q Λ Λc j hj ν ν₀ L z}

variable (k Q Λ Λc j hj ν ν₀ L) in
/-- **Webster's bimodule `K̃^{λ⁺}_λ`** (arXiv:1309.3796v3, Definitions 7.14 and 7.15): the span of
the `(λ, λ⁺)`-Stendhal diagrams with coefficients in `L` at the maximum of the cap, modulo the
local relations of `T̃` (including planar isotopy), the action of the diagrams at the maximum
on `L`, and the relations (max1) and (max2). It is a module over `T̃^λ ⊗ (T̃^{λ⁺})ᵐᵒᵖ`, i.e. a
`T̃^λ`–`T̃^{λ⁺}` bimodule. -/
abbrev CapTilde := FreeCap k Q Λ Λc j hj ν ν₀ L ⧸ relations k Q Λ Λc j hj ν ν₀ L

variable (k Q Λ Λc j hj ν ν₀ L) in
/-- The violated diagrams of `K̃^{λ⁺}_λ`: those factoring through a violated diagram of `T̃^λ`
above the cap or of `T̃^{λ⁺}` below it. -/
def violated : Submodule (Env k Q Λ Λc j hj ν ν₀) (CapTilde k Q Λ Λc j hj ν ν₀ L) :=
  Submodule.span _ ({z | ∃ a ∈ StendhalAlgebra.violatedIdeal k Q Λ ν,
      ∃ y : CapTilde k Q Λ Λc j hj ν ν₀ L,
      z = (Env.mk a 1 : Env k Q Λ Λc j hj ν ν₀) • y} ∪
    {z | ∃ b ∈ StendhalAlgebra.violatedIdeal k Q (plusLabels Λ Λc j hj) (ν + ν₀),
      ∃ y : CapTilde k Q Λ Λc j hj ν ν₀ L, z = (Env.mk 1 b : Env k Q Λ Λc j hj ν ν₀) • y})

variable (k Q Λ Λc j hj ν ν₀ L) in
/-- **Webster's bimodule `K^{λ⁺}_λ`** (arXiv:1309.3796v3, §7.3, before Definition 7.18): the
quotient of `K̃^{λ⁺}_λ` by the violated diagrams. -/
abbrev Cap := CapTilde k Q Λ Λc j hj ν ν₀ L ⧸ violated k Q Λ Λc j hj ν ν₀ L

end Bimodule

end Categorification.Stendhal.CupCap
