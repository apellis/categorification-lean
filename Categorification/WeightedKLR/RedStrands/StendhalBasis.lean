import Categorification.WeightedKLR.RedStrands.StendhalViolating
import Categorification.WeightedKLR.RedStrands.StendhalInjective

/-!
# A basis of `T̃^λ` and a spanning set of the violating ideal

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2.

* Proposition 4.16 gives a basis of `T̃^λ`. Here it is the family of Stendhal terms
  `ψ_{ρ w} x^u e(i)` (`stendhalBasis`), over every commutative ring. The bottom `i` and the top
  `w • i` have their red strands in the order `λ_1, …, λ_ℓ`, `u` puts no dot on a red strand, and
  the reduced word `ρ w` crosses no two red strands. Webster builds his basis from loadings. The
  family used here is the image of the KLR basis (KL I, Theorem 2.5). Spanning is
  `exists_eq_sum_stendhalTerm`. Independence (`eq_zero_of_sum_stendhalTerm_eq_zero`) comes from
  the polynomial representation of the weighted KLR algebra, through the homomorphism of
  arXiv:1209.2463v4, Theorem 3.5.
* The violating ideal `K` of Definition 4.6, and its image `stViolatingIdeal` in the reduced
  weighted KLR algebra (arXiv:1209.2463v4, Theorem 3.6), are spanned over `k` by the products
  `b · b'` of two basis elements such that the bottom `i` of `b` is the top of `b'` and has a
  black leftmost strand (`mem_violatedIdeal_iff`, `mem_stViolatingIdeal_iff`). These are exactly
  the basis diagrams cut at a violated slice, `ψ_w x^u e(i) ψ_{w'} x^{u'} e(i')`.

The products cannot be replaced by the basis elements that factor through a violated sequence.
For `ℓ = 1`, `ν = {i}` and `⟨α_i^∨, λ_1⟩ = 1`, the element `x e(λ_1, i)` lies in `K`: it is the
bigon through `e(i, λ_1)` (relation (4.2), `ψ_sq_black_red`). But the only basis elements in
`e(λ_1, i) T̃^λ e(λ_1, i)` are the `x^n e(λ_1, i)`, and none of them has a violated bottom or
top.

## Main results

* `TwoSidedIdeal.mem_span_image_iff`: in an algebra spanned by a family `v` with
  `v b · E j = δ_{bot b, j} v b` and `E j · v b = δ_{top b, j} v b`, the ideal generated by the
  idempotents `E j`, `j ∈ V`, is the span of the products `v b · v b'` with `bot b = top b' ∈ V`.
* `Stendhal.stendhalTerm`, `Stendhal.stendhalBasis`: the basis of `T̃^λ`.
* `Stendhal.mem_violatedIdeal_iff`, `Stendhal.mem_stViolatingIdeal_iff`: spanning sets of the
  violating ideals.

## Hypotheses

`stendhalBasis` assumes the hypotheses `hD`, `hE`, `hl`, `hw0` and `hS` of `stTildeEquiv`,
which come from the proof of independence through the weighted KLR algebra: `Γ` has no loops,
`Q = Γ.klrQ` comes from a weighted graph with edge weights `0`, a dagger structure and standing
polynomials. Proposition 4.16 needs none of them. The weighting of the red strands of
`stTildeEquiv` is chosen here as `r ↦ r`. `mem_violatedIdeal_iff` uses only spanning by the
Stendhal terms, so it holds for every `Q` and every commutative ring, with no further hypothesis.
`mem_stViolatingIdeal_iff` keeps the hypotheses of `stTildeEquiv`.
-/

namespace TwoSidedIdeal

variable {k A : Type*} [CommRing k] [Ring A] [Algebra k A] {ι J : Type*} [DecidableEq J]

/-- The ideal generated by idempotents `E j`, `j ∈ V`, of an algebra spanned by a family `v` that
the `E j` cut on the right according to `bot` and on the left according to `top`, is the
`k`-span of the products `v b · v b'` with `bot b = top b' ∈ V`. -/
theorem mem_span_image_iff (v : ι → A) (hv : ⊤ ≤ Submodule.span k (Set.range v))
    (E : J → A) (bot top : ι → J)
    (hbot : ∀ b j, v b * E j = if bot b = j then v b else 0)
    (htop : ∀ b j, E j * v b = if top b = j then v b else 0)
    (hE : ∀ j, E j * E j = E j) (V : Set J) (x : A) :
    x ∈ span (E '' V) ↔
      x ∈ Submodule.span k {y | ∃ b b', bot b ∈ V ∧ bot b = top b' ∧ y = v b * v b'} := by
  set M := Submodule.span k {y | ∃ b b', bot b ∈ V ∧ bot b = top b' ∧ y = v b * v b'}
  -- An element cut on the right by `E j` is a combination of the `v b` with `bot b = j`.
  have hR : ∀ y j, y * E j = y → y ∈ Submodule.span k (v '' {b | bot b = j}) := by
    intro y j hy
    obtain ⟨c, rfl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.1 (hv (Submodule.mem_top (x := y)))
    rw [← hy, Finsupp.sum, Finset.sum_mul]
    refine Submodule.sum_mem _ fun b _ => ?_
    rw [smul_mul_assoc, hbot]
    split_ifs with h
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, h, rfl⟩)
    · rw [smul_zero]; exact Submodule.zero_mem _
  have hL : ∀ y j, E j * y = y → y ∈ Submodule.span k (v '' {b | top b = j}) := by
    intro y j hy
    obtain ⟨c, rfl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.1 (hv (Submodule.mem_top (x := y)))
    rw [← hy, Finsupp.sum, Finset.mul_sum]
    refine Submodule.sum_mem _ fun b _ => ?_
    rw [mul_smul_comm, htop]
    split_ifs with h
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, h, rfl⟩)
    · rw [smul_zero]; exact Submodule.zero_mem _
  -- Products of such combinations lie in `M`.
  have hprod : ∀ j ∈ V, ∀ y ∈ Submodule.span k (v '' {b | bot b = j}),
      ∀ z ∈ Submodule.span k (v '' {b | top b = j}), y * z ∈ M := by
    intro j hj y hy z hz
    have h := Submodule.mul_mem_mul hy hz
    rw [Submodule.span_mul_span] at h
    refine (Submodule.span_le.2 ?_) h
    rintro _ ⟨_, ⟨b, hb, rfl⟩, _, ⟨b', hb', rfl⟩, rfl⟩
    exact Submodule.subset_span ⟨b, b', hb.symm ▸ hj, hb.trans hb'.symm, rfl⟩
  have hvb : ∀ b, v b * E (bot b) = v b := fun b => by simp [hbot]
  have hvt : ∀ b, E (top b) * v b = v b := fun b => by simp [htop]
  have hleft : ∀ a, ∀ y ∈ M, a * y ∈ M := by
    intro a y hy
    refine (Submodule.span_le (p := M.comap (LinearMap.mulLeft k a)) |>.2 ?_) hy
    rintro _ ⟨b, b', hb, hbb', rfl⟩
    change a * (v b * v b') ∈ M
    rw [← mul_assoc]
    exact hprod _ hb _ (hR _ _ (by rw [mul_assoc, hvb]))
      _ (Submodule.subset_span ⟨b', hbb'.symm, rfl⟩)
  have hright : ∀ a, ∀ y ∈ M, y * a ∈ M := by
    intro a y hy
    refine (Submodule.span_le (p := M.comap (LinearMap.mulRight k a)) |>.2 ?_) hy
    rintro _ ⟨b, b', hb, hbb', rfl⟩
    change v b * v b' * a ∈ M
    rw [mul_assoc]
    exact hprod _ hb _ (Submodule.subset_span ⟨b, rfl, rfl⟩) _
      (hL _ _ (by rw [← mul_assoc, hbb', hvt]))
  let T : TwoSidedIdeal A := TwoSidedIdeal.mk' M M.zero_mem M.add_mem M.neg_mem
    (fun hy => hleft _ _ hy) (fun hy => hright _ _ hy)
  have hT : ∀ y, y ∈ T ↔ y ∈ M := fun y => TwoSidedIdeal.mem_mk' _ _ _ _ _ _ _
  constructor
  · intro hx
    refine (hT x).1 ((span_le.2 ?_) hx)
    rintro _ ⟨j, hj, rfl⟩
    rw [SetLike.mem_coe, hT, ← hE j]
    exact hprod j hj _ (hR _ _ (hE j)) _ (hL _ _ (hE j))
  · intro hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨b, b', hb, -, rfl⟩ := hy
      rw [← hvb b, mul_assoc]
      exact mul_mem_left _ _ _ (mul_mem_right _ _ _ (subset_span (s := E '' V) ⟨_, hb, rfl⟩))
    | zero => exact zero_mem _
    | add y z _ _ hy hz => exact add_mem _ hy hz
    | smul c y _ hy => rw [Algebra.smul_def]; exact mul_mem_left _ _ _ hy

end TwoSidedIdeal

namespace Categorification.Stendhal

open Categorification.WeightedKLR Equiv MvPolynomial FullChamber GalleryAlgebra

/-! ### The Stendhal terms in `T̃^λ` -/

section Terms

open KLR TypeA StendhalAlgebraAllOrders

variable {I : Type} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

variable {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}

/-- The inclusion of `T̃^λ` into the algebra of Stendhal diagrams with all orders of red strands,
as a `k`-linear map. -/
noncomputable def stendhalValₗ :
    StendhalAlgebra k Q Λ ν →ₗ[k] StendhalAlgebraAllOrders k Q Λ ν where
  toFun x := x.1
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem stendhalValₗ_injective :
    Function.Injective (stendhalValₗ (k := k) (Q := Q) (Λ := Λ) (ν := ν)) :=
  fun _ _ h => Subtype.ext h

variable (Q Λ) in
/-- The Stendhal term `ψ_{ρ w} x^u e(i)` (`IsStendhalTerm`) as an element of `T̃^λ`
(arXiv:1309.3796v2, Definition 4.5). -/
noncomputable def stendhalTerm (hρ : ∀ w, wordProd m (ρ w) = w) (b : {b // IsStendhalTerm ρ b}) :
    StendhalAlgebra k Q Λ ν :=
  ⟨ofKLR k Q Λ ν (KLRAlgebra.stdElt ρ b.1), _,
    (redOrderedIdem_mul_ofKLR_stdElt_mul hρ b.1).trans (ite_eq_left_of_eq_true _ _ (eq_true b.2))⟩

theorem stendhalTerm_val (hρ : ∀ w, wordProd m (ρ w) = w) (b : {b // IsStendhalTerm ρ b}) :
    (stendhalTerm Q Λ hρ b).1 = ofKLR k Q Λ ν (KLRAlgebra.stdElt ρ b.1) :=
  rfl

/-- The idempotent `e(j)` cuts a Stendhal term on the right according to its bottom `b.1`. -/
theorem stendhalTerm_mul_e (hρ : ∀ w, wordProd m (ρ w) = w) (b : {b // IsStendhalTerm ρ b})
    (j : KLR.Seq μ) (hj : IsRedOrdered j) :
    stendhalTerm Q Λ hρ b * StendhalAlgebra.e j hj =
      if b.1.1 = j then stendhalTerm Q Λ hρ b else 0 := by
  apply stendhalValₗ_injective
  change ofKLR k Q Λ ν (KLRAlgebra.stdElt ρ b.1) * StendhalAlgebraAllOrders.e j =
    stendhalValₗ (if b.1.1 = j then stendhalTerm Q Λ hρ b else 0)
  have hy : ofKLR k Q Λ ν (KLRAlgebra.stdElt ρ b.1) =
      ofKLR k Q Λ ν (KLRAlgebra.stdElt ρ b.1) * StendhalAlgebraAllOrders.e b.1.1 := by
    rw [StendhalAlgebraAllOrders.e, ← map_mul, stdElt_mul_e]
  conv_lhs => rw [hy, mul_assoc, StendhalAlgebraAllOrders.e_mul_e]
  by_cases hb : b.1.1 = j
  · subst hb
    rw [ite_eq_left_of_eq_true _ _ (eq_self _), ite_eq_left_of_eq_true _ _ (eq_self _), ← hy]
    rfl
  · rw [ite_eq_right_of_eq_false _ _ (eq_false hb), ite_eq_right_of_eq_false _ _ (eq_false hb),
      mul_zero,
      map_zero]

/-- The idempotent `e(j)` cuts a Stendhal term on the left according to its top `w • i`. -/
theorem e_mul_stendhalTerm (hρ : ∀ w, wordProd m (ρ w) = w) (b : {b // IsStendhalTerm ρ b})
    (j : KLR.Seq μ) (hj : IsRedOrdered j) :
    StendhalAlgebra.e j hj * stendhalTerm Q Λ hρ b =
      if b.1.2.1 • b.1.1 = j then stendhalTerm Q Λ hρ b else 0 := by
  apply stendhalValₗ_injective
  change StendhalAlgebraAllOrders.e j * ofKLR k Q Λ ν (KLRAlgebra.stdElt ρ b.1) =
    stendhalValₗ (if b.1.2.1 • b.1.1 = j then stendhalTerm Q Λ hρ b else 0)
  have hy : ofKLR k Q Λ ν (KLRAlgebra.stdElt ρ b.1) =
      StendhalAlgebraAllOrders.e (b.1.2.1 • b.1.1) * ofKLR k Q Λ ν (KLRAlgebra.stdElt ρ b.1) := by
    rw [StendhalAlgebraAllOrders.e, ← map_mul, e_mul_stdElt hρ]
  conv_lhs => rw [hy, ← mul_assoc, StendhalAlgebraAllOrders.e_mul_e]
  by_cases hb : b.1.2.1 • b.1.1 = j
  · subst hb
    rw [ite_eq_left_of_eq_true _ _ (eq_self _), ite_eq_left_of_eq_true _ _ (eq_self _), ← hy]
    rfl
  · rw [ite_eq_right_of_eq_false _ _ (eq_false (Ne.symm hb)),
      ite_eq_right_of_eq_false _ _ (eq_false hb),
      zero_mul, map_zero]

/-- **The Stendhal terms span `T̃^λ`** (arXiv:1309.3796v2, Proposition 4.16, spanning), as a
statement in `T̃^λ`; from `exists_eq_sum_stendhalTerm`. -/
theorem span_stendhalTerm (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w) :
    ⊤ ≤ Submodule.span k (Set.range (stendhalTerm Q Λ (fun w => (hρ w).2))) := by
  classical
  intro x _
  obtain ⟨c, hc⟩ := exists_eq_sum_stendhalTerm (Q := Q) (Λ := Λ) hρ x
  have hx : x = ∑ b ∈ c.support,
      if h : IsStendhalTerm ρ b then c b • stendhalTerm Q Λ (fun w => (hρ w).2) ⟨b, h⟩ else 0 := by
    apply stendhalValₗ_injective
    rw [map_sum]
    refine hc.trans (Finset.sum_congr rfl fun b _ => ?_)
    split_ifs with h
    · rw [map_smul]; rfl
    · rw [zero_smul, map_zero]
  rw [hx]
  refine Submodule.sum_mem _ fun b _ => ?_
  split_ifs with h
  · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)
  · exact Submodule.zero_mem _

/-! ### The violating ideal -/

/-- **A spanning set of the violating ideal** (arXiv:1309.3796v2, Definition 4.6): an element
of `T̃^λ` lies in the violating ideal `K` exactly when it is a `k`-combination of products
`b · b'` of two Stendhal terms whose common middle sequence, the bottom `b.1` of `b` and the top
`w' • i'` of `b' = ψ_{ρ w'} x^{u'} e(i')`, has a black leftmost strand. Such a product is
`ψ_{ρ w} x^u e(i) ψ_{ρ w'} x^{u'} e(i')`, a diagram cut at a violated slice.

Only spanning by the Stendhal terms is used, so `Q` is arbitrary. -/
theorem mem_violatedIdeal_iff (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w)
    (x : StendhalAlgebra k Q Λ ν) :
    x ∈ StendhalAlgebra.violatedIdeal k Q Λ ν ↔
      x ∈ Submodule.span k {y | ∃ b b' : {b // IsStendhalTerm ρ b},
        IsViolated b.1.1 ∧ b.1.1 = b'.1.2.1 • b'.1.1 ∧
          y = stendhalTerm Q Λ (fun w => (hρ w).2) b *
            stendhalTerm Q Λ (fun w => (hρ w).2) b'} := by
  classical
  have hρ' : ∀ w, wordProd m (ρ w) = w := fun w => (hρ w).2
  let E : {j : KLR.Seq μ // IsRedOrdered j} → StendhalAlgebra k Q Λ ν :=
    fun j => StendhalAlgebra.e j.1 j.2
  let bot : {b // IsStendhalTerm ρ b} → {j : KLR.Seq μ // IsRedOrdered j} :=
    fun b => ⟨b.1.1, b.2.1⟩
  let top : {b // IsStendhalTerm ρ b} → {j : KLR.Seq μ // IsRedOrdered j} :=
    fun b => ⟨b.1.2.1 • b.1.1, b.2.2.1⟩
  have hset : {y | ∃ (i : KLR.Seq μ) (hi : IsRedOrdered i), IsViolated i ∧
      y = StendhalAlgebra.e (k := k) (Q := Q) (Λ := Λ) i hi} =
      E '' {j | IsViolated j.1} := by
    ext y
    constructor
    · rintro ⟨i, hi, hv, rfl⟩; exact ⟨⟨i, hi⟩, hv, rfl⟩
    · rintro ⟨j, hv, rfl⟩; exact ⟨j.1, j.2, hv, rfl⟩
  have key := TwoSidedIdeal.mem_span_image_iff (k := k)
    (stendhalTerm Q Λ hρ') (span_stendhalTerm hρ) E bot top
    (fun b j => by
      rw [stendhalTerm_mul_e]
      simp only [bot, Subtype.ext_iff])
    (fun b j => by
      rw [e_mul_stendhalTerm]
      simp only [top, Subtype.ext_iff])
    (fun j => by
      apply stendhalValₗ_injective
      change StendhalAlgebraAllOrders.e j.1 * StendhalAlgebraAllOrders.e j.1 = _
      rw [StendhalAlgebraAllOrders.e_mul_e]; simp; rfl)
    {j | IsViolated j.1} x
  rw [StendhalAlgebra.violatedIdeal, hset, key]
  have hP : {y | ∃ b b', bot b ∈ {j | IsViolated j.1} ∧ bot b = top b' ∧
      y = stendhalTerm Q Λ hρ' b * stendhalTerm Q Λ hρ' b'} =
      {y | ∃ b b' : {b // IsStendhalTerm ρ b},
        IsViolated b.1.1 ∧ b.1.1 = b'.1.2.1 • b'.1.1 ∧
          y = stendhalTerm Q Λ hρ' b * stendhalTerm Q Λ hρ' b'} := by
    ext y
    simp only [Set.mem_ofPred_eq, bot, top, Subtype.ext_iff]
  rw [hP]

end Terms

/-! ### Independence and the basis -/

section Basis

open KLR TypeA StendhalAlgebraAllOrders

variable {I : Type} [DecidableEq I] {ℓ : ℕ} {ν : Multiset I}
  {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k]
  {Γ : WeightedGraph I 𝕜 k} {Λ : Fin ℓ → I →₀ ℕ} {ϖ : Fin ℓ → 𝕜}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

/-- **Independence of the Stendhal terms** (arXiv:1309.3796v2, Proposition 4.16, independence):
a combination of Stendhal terms that vanishes in the algebra of Stendhal diagrams has zero
coefficients. The proof is that of injectivity in arXiv:1209.2463v4, Theorem 3.5
(`stTildeHom_injective`), through the polynomial representation of the weighted KLR algebra.
The hypotheses `hD`, `hE`, `hl`, `hϖ`, `hw0` and `hS` are those of `stTildeHom`. -/
theorem eq_zero_of_sum_stendhalTerm_eq_zero (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (hS : Γ.Standing) {ρ : Perm (Fin m) → List ℕ}
    (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w)
    (s : Finset (KLR.Seq μ × Perm (Fin m) × (Fin m →₀ ℕ)))
    (c : KLR.Seq μ × Perm (Fin m) × (Fin m →₀ ℕ) → k)
    (hc : ∀ b, c b ≠ 0 → IsStendhalTerm ρ b)
    (h : ∑ b ∈ s, c b • ofKLR k Γ.klrQ Λ ν (KLRAlgebra.stdElt ρ b) = 0) :
    ∀ b ∈ s, c b = 0 := by
  classical
  have hρ' : ∀ w, TypeA.wordProd m (ρ w) = w := fun w => (hρ w).2
  set F := ∑ b ∈ s, c b • fStd (k := k) ρ b
  have hxF : (RingQuot.mkAlgHom k (Rel k Γ.klrQ Λ ν) F : StendhalAlgebraAllOrders k Γ.klrQ Λ ν) =
      0 := by
    rw [map_sum]
    refine (Finset.sum_congr rfl fun b _ => ?_).trans h
    rw [map_smul, ← ofKLR_mk, mk_fStd]
    rfl
  have hF : stFreeHom ν k Λ hϖ hw0 F ∈ stZeroDotIdeal ν k Λ hϖ hw0 := by
    have h0 : stStendhalHom ν k Γ Λ hD hE hl hϖ hw0 hS
        (RingQuot.mkAlgHom k (Rel k Γ.klrQ Λ ν) F) = 0 :=
      (congrArg _ hxF).trans (map_zero _)
    rw [stStendhalHom_mk, ← map_zero
      ((stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k)] at h0
    have := (TwoSidedIdeal.rel_iff _ _ _).1 ((RingCon.eq _).1 h0)
    rwa [sub_zero] at this
  refine eq_zero_of_blockSum_eq_zero (stBlackP Γ Λ) s c
    (fun a b _ f hf => isRegular_rename_stBlackP hS a b hf) hρ fun i t h hh => ?_
  by_cases hit : IsRedOrdered i ∧ IsRedOrdered t
  · rw [← blackEval_blockSum hρ' s c
      (fun b hb => ⟨(hc b hb).2.2.1, (hc b hb).2.2.2⟩) i t hh,
      ← freeRep_sum_fStd (stP Γ Λ) hρ']
    obtain ⟨G, hG⟩ := exists_chamberRep_eq_mulXOp hϖ hw0
      (WeightedGraph.crawleyBoeveyIn_psymm (psymm_of_loop hl)) hF
      (stRenOp ℓ ν k (Pi.single i h))
    have hR := congrArg (fun φ => φ (Pi.single i h) ⟨t, hit.2⟩)
      (chamberRep_stFreeHom (Λ := Λ) hD hE hl hϖ hw0 F)
    simp only [LinearMap.comp_apply, hG, mulXOp_apply, stRenOp_apply] at hR
    exact blackEval_eq_zero_of_stRen_eq hR.symm
  · rw [blockSum, LinearMap.sum_apply]
    refine Finset.sum_eq_zero fun b hb => ?_
    obtain ⟨-, rfl, rfl⟩ := Finset.mem_filter.1 hb
    have : c b = 0 := by
      by_contra hcb
      exact hit ⟨(hc b hcb).1, (hc b hcb).2.1⟩
    rw [LinearMap.smul_apply, this, zero_smul]

/-- The Stendhal terms are linearly independent in `T̃^λ`. -/
theorem linearIndependent_stendhalTerm (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hw0 : ∀ e, Γ.weight e = 0) (hS : Γ.Standing)
    {ρ : Perm (Fin m) → List ℕ} (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w) :
    LinearIndependent k (stendhalTerm Γ.klrQ Λ (ν := ν) (fun w => (hρ w).2)) := by
  classical
  rw [linearIndependent_iff']
  intro s g hg i hi
  have hϖ : StrictMono fun r : Fin ℓ => ((r : ℕ) : 𝕜) := fun _ _ h => Nat.cast_lt.mpr h
  set c : KLR.Seq μ × Perm (Fin m) × (Fin m →₀ ℕ) → k :=
    fun b => if h : IsStendhalTerm ρ b then g ⟨b, h⟩ else 0 with hcdef
  have hc : ∀ b, c b ≠ 0 → IsStendhalTerm ρ b := fun b hb => by
    by_contra h; exact hb (by simp [hcdef, h])
  have h0 := eq_zero_of_sum_stendhalTerm_eq_zero hD hE hl hϖ hw0 hS hρ
    (s.map (Function.Embedding.subtype _)) c hc (by
      rw [Finset.sum_map]
      have := congrArg stendhalValₗ hg
      rw [map_sum, map_zero] at this
      refine (Finset.sum_congr rfl fun b _ => ?_).trans this
      simp only [Function.Embedding.subtype_apply, hcdef, b.2, map_smul]
      rfl) i.1 (Finset.mem_map_of_mem _ hi)
  simpa [hcdef, i.2] using h0

variable (Γ Λ) in
/-- **A basis of `T̃^λ`** (arXiv:1309.3796v2, Proposition 4.16), over every commutative ring:
the Stendhal terms `ψ_{ρ w} x^u e(i)`, for a choice `ρ` of reduced words. Here `i` and `w • i`
have their red strands in the order `λ_1, …, λ_ℓ`, `u` puts no dot on a red strand and `ρ w`
crosses no two red strands (`IsStendhalTerm`).

The hypotheses `hD`, `hE`, `hl`, `hw0` and `hS` are route hypotheses of the independence proof,
through the isomorphism of arXiv:1209.2463v4, Theorem 3.5; they are not hypotheses of
Proposition 4.16. Webster's basis is indexed by loadings; this one is the image of the KLR basis
(KL I, Theorem 2.5). -/
noncomputable def stendhalBasis (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hw0 : ∀ e, Γ.weight e = 0) (hS : Γ.Standing)
    (ρ : Perm (Fin m) → List ℕ) (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w) :
    Module.Basis {b // IsStendhalTerm ρ b} k (StendhalAlgebra k Γ.klrQ Λ ν) :=
  Module.Basis.mk (linearIndependent_stendhalTerm hD hE hl hw0 hS hρ) (span_stendhalTerm hρ)

theorem stendhalBasis_apply (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hw0 : ∀ e, Γ.weight e = 0) (hS : Γ.Standing)
    (ρ : Perm (Fin m) → List ℕ) (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w)
    (b : {b // IsStendhalTerm ρ b}) :
    (stendhalBasis Γ Λ hD hE hl hw0 hS ρ hρ b).1 =
      ofKLR k Γ.klrQ Λ ν (KLRAlgebra.stdElt ρ b.1) := by
  rw [stendhalBasis, Module.Basis.mk_apply]
  rfl

/-- **A spanning set of the violating ideal of the reduced weighted KLR algebra**
(arXiv:1209.2463v4, Theorem 3.6): `stViolatingIdeal` is the `k`-span of the images under the
isomorphism of Theorem 3.5 of the products `b · b'` of `mem_violatedIdeal_iff`. -/
theorem mem_stViolatingIdeal_iff (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e)
    (hl : ∀ c, Γ.loop c = none) (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (hS : Γ.Standing) {ρ : Perm (Fin m) → List ℕ}
    (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w)
    (x : (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.Quotient) :
    x ∈ stViolatingIdeal ν k Λ hϖ hw0 ↔
      x ∈ Submodule.span k {y | ∃ b b' : {b // IsStendhalTerm ρ b},
        IsViolated b.1.1 ∧ b.1.1 = b'.1.2.1 • b'.1.1 ∧
          y = stTildeEquiv ν k Γ Λ hD hE hl hϖ hw0 hS
            (stendhalTerm Γ.klrQ Λ (fun w => (hρ w).2) b *
              stendhalTerm Γ.klrQ Λ (fun w => (hρ w).2) b')} := by
  set φ := stTildeEquiv ν k Γ Λ hD hE hl hϖ hw0 hS
  obtain ⟨x, rfl⟩ := φ.surjective x
  have h1 : φ x ∈ stViolatingIdeal ν k Λ hϖ hw0 ↔
      x ∈ StendhalAlgebra.violatedIdeal k Γ.klrQ Λ ν := by
    rw [← comap_stViolatingIdeal hD hE hl hϖ hw0 hS, TwoSidedIdeal.mem_comap]
  rw [h1, mem_violatedIdeal_iff hρ]
  let φₗ : StendhalAlgebra k Γ.klrQ Λ ν →ₗ[k] (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.Quotient :=
    { toFun := φ
      map_add' := map_add φ
      map_smul' := fun c y => map_smul (stStendhalHom ν k Γ Λ hD hE hl hϖ hw0 hS) c y.1 }
  have hφ : Function.Injective φₗ := φ.injective
  set S := {y | ∃ b b' : {b // IsStendhalTerm ρ b},
        IsViolated b.1.1 ∧ b.1.1 = b'.1.2.1 • b'.1.1 ∧
          y = stendhalTerm Γ.klrQ Λ (fun w => (hρ w).2) b *
            stendhalTerm Γ.klrQ Λ (fun w => (hρ w).2) b'}
  have hS' : {y | ∃ b b' : {b // IsStendhalTerm ρ b},
        IsViolated b.1.1 ∧ b.1.1 = b'.1.2.1 • b'.1.1 ∧
          y = φ (stendhalTerm Γ.klrQ Λ (fun w => (hρ w).2) b *
              stendhalTerm Γ.klrQ Λ (fun w => (hρ w).2) b')} = φₗ '' S := by
    ext y
    constructor
    · rintro ⟨b, b', hv, hbb', rfl⟩; exact ⟨_, ⟨b, b', hv, hbb', rfl⟩, rfl⟩
    · rintro ⟨_, ⟨b, b', hv, hbb', rfl⟩, rfl⟩; exact ⟨b, b', hv, hbb', rfl⟩
  rw [hS', Submodule.span_image]
  constructor
  · intro hx; exact Submodule.mem_map_of_mem hx
  · rintro ⟨y, hy, hyx⟩; rwa [← hφ hyx]

end Basis

end Categorification.Stendhal
