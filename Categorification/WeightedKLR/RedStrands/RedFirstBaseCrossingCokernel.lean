import Categorification.WeightedKLR.RedStrands.ParabolicStandardProjectiveFiltration
import Categorification.Algebra.CornerCopresentationCriteria

set_option backward.isDefEq.respectTransparency false

/-!
# The cokernel of the base crossing

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, proof of
Proposition 5.5 and Corollary 5.32 (v2: Corollary 5.29). Let `N = T^{λ'} e(s)` and let
`c = e(s, i, λ_ℓ) G` be the base crossing of Lemma 5.25 (v2: Lemma 5.23), from `(s, i, λ_ℓ)` to
`(s, λ_ℓ, i)`. Through `Fᵢ S(N) ≅ T^λ e(s, λ_ℓ, i)` (`baseCrossProj`, sending the unit generator
to `e(s, λ_ℓ, i)`), the image of `δ₁ : S(₁Fᵢ N) → Fᵢ S(N)` is `T^λ c`: the module `S(₁Fᵢ N)` is
cyclic on its unit generator (`exists_eq_smul_firstIndStdGen`), which `δ₁` sends to `G` times the
unit generator. Hence the cokernel of `z ↦ z c` on `T^λ e(s, λ_ℓ, i)` is `S(₂Fᵢ N)`, and if
`S(₂Fᵢ N)` has no nonzero element killed by `e⁰ T^λ`, neither has `T^λ / T^λ c`
(`isCornerFaithfulQuot_baseCrossing`).

## Main results

* `exists_eq_smul_firstIndStdGen`: `S(₁Fᵢ N)` is generated by `[1 ⊗ (1 ⊗ e(s))]`.
* `baseCrossProj`, `baseCrossProj_unitGen`: `Fᵢ S(N) → T^λ`, unit generator `↦ e(s, λ_ℓ, i)`.
* `isCornerFaithfulQuot_baseCrossing`: the cokernel of the base crossing has no nonzero
  submodule killed by `e⁰`, given the same for `S(₂Fᵢ N)`.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra InductionAlong MulOpposite
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} {k : Type} [DecidableEq I] [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ) (i : I) (θ : Multiset I)
  (s : Seq (stendhalWeight ℓ (θ + 0))) (hs : IsRedOrdered s) (hQ : KLRSymm Q)

local notation "Si" j => (Singleton.singleton j : Multiset I)
local notation "S" => stendhalQ Q Λ
local notation "θᵢ" => (Si i) + θ
local notation "T′" => TensorProductAlgebra k Q Λ ((Si i) + (θ + 0))
local notation "T₀" => TensorProductAlgebra k Q Λ (θ + 0)
local notation "N" => FactorModule.carrier (redFactorModule Q Λ θ s hs)
local notation "Fl" => FirstIndLeft Q Λ i θ 0 N
local notation "cst₁" => castTensorProductAlgebra Q Λ (firstInd_blackWeight i θ 0)
local notation "Aₚ₁" => Multiset.map (addRedColor ℓ) (stendhalWeight ℓ ((Si i) + θ))
local notation "Aₗ" => Multiset.map (Sum.map (id : I → I) (fun _ : Fin 1 => Fin.last ℓ))
  (stendhalWeight 1 (0 : Multiset I))

section Cyclic

/-- The submodule generated by the unit generator. -/
abbrev unitSpan : Submodule T′ (FirstIndStandardT Q Λ i θ 0 N hQ) :=
  Submodule.span T′ {firstIndStdGen Q Λ i θ 0 N hQ (redUnit Q Λ θ s hs)}

theorem firstIndMk_tmul_smul_mem (b : parabolicFactorAlgebra Q Λ θᵢ 0)
    (y : ParabolicInput Q Λ θᵢ 0 Fl)
    (hy : firstIndMk Q Λ i θ 0 N hQ (BalancedTensor.tmul (oneBimod S Aₚ₁ Aₗ) y) ∈
      unitSpan Q Λ i θ s hs hQ) :
    firstIndMk Q Λ i θ 0 N hQ
        (BalancedTensor.tmul (oneBimod S Aₚ₁ Aₗ) (show ParabolicInput Q Λ θᵢ 0 Fl from b • y)) ∈
      unitSpan Q Λ i θ s hs hQ := by
  obtain ⟨t, rfl⟩ := parabolicInputMap_surjective Q Λ θᵢ 0 b
  have h : (show ParabolicInput Q Λ θᵢ 0 Fl from parabolicInputMap Q Λ θᵢ 0 t • y) = t • y := rfl
  rw [h, ← concat_smul_tmul_oneBimod, ← firstIndMk_smul_affine]
  exact Submodule.smul_mem _ _ hy

theorem firstIndStdGen_mem_unitSpan (n : N) :
    firstIndStdGen Q Λ i θ 0 N hQ n ∈ unitSpan Q Λ i θ s hs hQ := by
  let d := (emptyFactorToOld Q Λ θ).symm (show lIdeal (oldIdem Q Λ θ s hs) from n).1
  have hn : n = d • redUnit Q Λ θ s hs := by
    apply Subtype.ext
    change (show lIdeal (oldIdem Q Λ θ s hs) from n).1 =
      emptyFactorToOld Q Λ θ d * oldIdem Q Λ θ s hs
    rw [AlgEquiv.apply_symm_apply]
    exact (show lIdeal (oldIdem Q Λ θ s hs) from n).2.symm
  have hz : (Ind.tmul (unitGen (leftAppendHom Q Λ i θ 0)) (d • redUnit Q Λ θ s hs) : Fl) =
      leftAppendHom Q Λ i θ 0 d • Ind.tmul (unitGen (leftAppendHom Q Λ i θ 0))
        (redUnit Q Λ θ s hs) := by
    rw [← Ind.op_smul_tmul, Ind.smul_tmul]
    congr 1
    apply Subtype.ext
    change leftAppendHom Q Λ i θ 0 1 * leftAppendHom Q Λ i θ 0 d =
      leftAppendHom Q Λ i θ 0 d * leftAppendHom Q Λ i θ 0 1
    rw [← map_mul, ← map_mul, one_mul, mul_one]
  rw [hn]
  change firstIndMk Q Λ i θ 0 N hQ (BalancedTensor.tmul (oneBimod S Aₚ₁ Aₗ)
    (show ParabolicInput Q Λ θᵢ 0 Fl from
      Ind.tmul (unitGen (leftAppendHom Q Λ i θ 0)) (d • redUnit Q Λ θ s hs))) ∈ _
  rw [hz]
  exact firstIndMk_tmul_smul_mem Q Λ i θ s hs hQ _ _
    (Submodule.subset_span (Set.mem_singleton _))

theorem firstIndMk_tmul_one_mem (y : ParabolicInput Q Λ θᵢ 0 Fl) :
    firstIndMk Q Λ i θ 0 N hQ (BalancedTensor.tmul (oneBimod S Aₚ₁ Aₗ) y) ∈
      unitSpan Q Λ i θ s hs hQ := by
  induction (show Fl from y) using Ind.induction_on with
  | zero =>
    change firstIndMk Q Λ i θ 0 N hQ (BalancedTensor.tmul _ (0 : ParabolicInput Q Λ θᵢ 0 Fl)) ∈ _
    rw [BalancedTensor.tmul_zero, map_zero]
    exact Submodule.zero_mem _
  | add y y' hy hy' =>
    change firstIndMk Q Λ i θ 0 N hQ (BalancedTensor.tmul _
      ((show ParabolicInput Q Λ θᵢ 0 Fl from y) + (show ParabolicInput Q Λ θᵢ 0 Fl from y'))) ∈ _
    rw [BalancedTensor.tmul_add, map_add]
    exact Submodule.add_mem _ hy hy'
  | tmul z n =>
    have hz : (Ind.tmul z n : Fl) = z.1 • Ind.tmul (unitGen (leftAppendHom Q Λ i θ 0)) n := by
      rw [Ind.smul_tmul]
      congr 1
      exact Subtype.ext z.2.symm
    change firstIndMk Q Λ i θ 0 N hQ (BalancedTensor.tmul _
      (show ParabolicInput Q Λ θᵢ 0 Fl from (Ind.tmul z n : Fl))) ∈ _
    rw [hz]
    exact firstIndMk_tmul_smul_mem Q Λ i θ s hs hQ _ _
      (firstIndStdGen_mem_unitSpan Q Λ i θ s hs hQ n)

/-- **`S(₁Fᵢ N)` is cyclic** on the unit generator `[1 ⊗ (1 ⊗ e(s))]`. -/
theorem exists_eq_smul_firstIndStdGen (m : FirstIndStandardT Q Λ i θ 0 N hQ) :
    ∃ t : T′, m = t • firstIndStdGen Q Λ i θ 0 N hQ (redUnit Q Λ θ s hs) := by
  suffices h : m ∈ unitSpan Q Λ i θ s hs hQ by
    obtain ⟨t, ht⟩ := Submodule.mem_span_singleton.1 h
    exact ⟨t, ht.symm⟩
  obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ m
  induction x using BalancedTensor.induction_on with
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | tmul r y =>
    rw [← val_smul_oneBimod r, ← BalancedTensor.smul_tmul']
    change firstIndMk Q Λ i θ 0 N hQ (r.1 • _) ∈ _
    rw [← firstIndMk_smul_affine]
    exact Submodule.smul_mem _ _ (firstIndMk_tmul_one_mem Q Λ i θ s hs hQ y)

end Cyclic

section Proj

/-- `S(N) → T^λ_θ` through `S(N) ≅ T^λ e(s, λ_ℓ)` (`loadingProjRedEquiv`). -/
def baseStdProj : ParabolicStandardT Q Λ θ 0 N hQ →ₗ[T₀] lIdeal (1 : T₀) :=
  LinearMap.codRestrict (lIdeal (1 : T₀))
    ((lIdeal (emptyRedHom Q Λ θ (oldIdem Q Λ θ s hs))).subtype ∘ₗ
      ((emptyRedStandardEquiv Q Λ θ N hQ).trans
        ((Ind.mapEquiv (φ := emptyRedHom Q Λ θ) (redInputEquiv Q Λ θ s hs)).trans
          (indLIdealEquiv (emptyRedHom Q Λ θ) (f := oldIdem Q Λ θ s hs)
            (isIdempotentElem_mk_e s hs)))).toLinearMap)
    fun _ => mul_one _

theorem baseStdProj_unit :
    (baseStdProj Q Λ θ s hs hQ (emptyStdMk Q Λ θ N hQ
      (BalancedTensor.tmul (oneBimod S (Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ)) Aₗ)
        (show ParabolicInput Q Λ θ 0 N from redUnit Q Λ θ s hs)))).1 =
      redLoadingIdem Q Λ (θ + 0) (appendRedLoading s) ((appendRedLoading_ordered_iff s).2 hs) := by
  change ((indLIdealEquiv (emptyRedHom Q Λ θ) (f := oldIdem Q Λ θ s hs)
    (isIdempotentElem_mk_e s hs)) ((Ind.mapEquiv (φ := emptyRedHom Q Λ θ)
      (redInputEquiv Q Λ θ s hs)) (emptyRedStandard Q Λ θ N hQ (emptyStdMk Q Λ θ N hQ _)))).1 = _
  rw [emptyRedStandard_mk_one, emptyRedGen_apply]
  change emptyRedHom Q Λ θ 1 * emptyRedHom Q Λ θ (oldIdem Q Λ θ s hs) = _
  rw [← map_mul, one_mul, emptyRedHom_apply, appendRed_mk_e]

/-- **`Fᵢ S(N) → T^λ`**, through `Fᵢ S(N) ≅ Fᵢ T^λ e(s, λ_ℓ) ≅ T^λ e(s, λ_ℓ, i)`. -/
def baseCrossProj : LastIndF Q Λ i θ 0 N hQ →ₗ[T′] T′ :=
  (lIdeal (appendBlackHom Q Λ i θ 0 1)).subtype ∘ₗ
    (indLIdealEquiv (appendBlackHom Q Λ i θ 0) IsIdempotentElem.one).toLinearMap ∘ₗ
      Ind.map (baseStdProj Q Λ θ s hs hQ)

theorem baseCrossProj_tmul (z : Corner (appendBlackHom Q Λ i θ 0))
    (m : ParabolicStandardT Q Λ θ 0 N hQ) :
    baseCrossProj Q Λ i θ s hs hQ (Ind.tmul z m) =
      z.1 * appendBlackHom Q Λ i θ 0 (baseStdProj Q Λ θ s hs hQ m).1 := rfl

/-- `Fᵢ S(N) → T^λ` sends the unit generator to `e(s, λ_ℓ, i)`. -/
theorem baseCrossProj_unitGen :
    baseCrossProj Q Λ i θ s hs hQ (firstIndUnitGen Q Λ i θ 0 N hQ (redUnit Q Λ θ s hs)) =
      redLoadingIdem Q Λ ((Si i) + (θ + 0)) (appendBlackLoading i (θ + 0) (appendRedLoading s))
        (appendBlackLoading_ordered i (θ + 0) _ ((appendRedLoading_ordered_iff s).2 hs)) := by
  have h := baseCrossProj_tmul Q Λ i θ s hs hQ (unitGen (appendBlackHom Q Λ i θ 0))
    (emptyStdMk Q Λ θ N hQ
      (BalancedTensor.tmul (oneBimod S (Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ)) Aₗ)
        (show ParabolicInput Q Λ θ 0 N from redUnit Q Λ θ s hs)))
  refine h.trans ?_
  rw [baseStdProj_unit]
  change appendBlackHom Q Λ i θ 0 1 * _ = _
  rw [← map_mul, one_mul]
  exact appendBlack_mk_e Q Λ i (θ + 0) _ _

end Proj

section Cokernel

local notation "G" => firstG S (Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ)) Aₗ
  (Sum.inl i : I ⊕ Fin (ℓ + 1))
local notation "e⁰" => redFirstIdem Q Λ ((Si i) + (θ + 0))

theorem redLoadingIdem_mul_firstG (hsrc : IsRedOrdered
      (appendRedLoading (appendBlackLoading i (θ + 0) s)))
    (htgt : IsRedOrdered (appendBlackLoading i (θ + 0) (appendRedLoading s))) :
    redLoadingIdem Q Λ _ _ hsrc * firstIndAffine Q Λ i θ 0 G =
      firstIndAffine Q Λ i θ 0 G * redLoadingIdem Q Λ _ _ htgt := by
  have hdw := congrArg (Seq.cast (firstInd_klrWeight i θ 0).symm)
    (cast_quadPerm_smul_base i θ s)
  rw [Seq.cast_symm_cast] at hdw
  rw [← firstIndAffine_e_cast Q Λ i θ 0 _ hsrc, ← map_mul, e_mul_firstG, hdw, map_mul,
    firstIndAffine_e_cast Q Λ i θ 0 _ htgt]

/-- **The cokernel of the base crossing** (Webster, arXiv:1309.3796v3, proof of Proposition 5.5
and Corollary 5.32): if `δ₁` is injective, `T^λ` acts faithfully on `e⁰ T^λ` and `S(₂Fᵢ N)` has
no nonzero element killed by `e⁰ T^λ`, then `T^λ / T^λ c` has no nonzero submodule killed by
`e⁰`, where `c = e(s, i, λ_ℓ) G` is the base crossing. -/
theorem isCornerFaithfulQuot_baseCrossing (hδ : FirstIndDeltaInjective Q Λ i θ 0 N hQ)
    (hfaith : ∀ y : T′, (∀ a, e⁰ * a * y = 0) → y = 0)
    (hNK : ∀ m : LastIndStandardT Q Λ i θ 0 N hQ, (∀ a, (e⁰ * a) • m = 0) → m = 0)
    (hsrc : IsRedOrdered (appendRedLoading (appendBlackLoading i (θ + 0) s))) :
    IsCornerFaithfulQuot e⁰ (redLoadingIdem Q Λ _ _ hsrc * firstIndAffine Q Λ i θ 0 G) := by
  have htgt : IsRedOrdered (appendBlackLoading i (θ + 0) (appendRedLoading s)) :=
    appendBlackLoading_ordered i (θ + 0) _ ((appendRedLoading_ordered_iff s).2 hs)
  set c := redLoadingIdem Q Λ _ _ hsrc * firstIndAffine Q Λ i θ 0 G with hc
  set et := redLoadingIdem Q Λ _ _ htgt with het
  have hGe : firstIndAffine Q Λ i θ 0 G * et = c :=
    (redLoadingIdem_mul_firstG Q Λ i θ s hsrc htgt).symm
  have hcet : c * et = c := by
    rw [← hGe, mul_assoc, (isIdempotentElem_redLoadingIdem Q Λ _ _ htgt).eq]
  have hexact := (firstIndDeltaT_shortExact Q Λ i θ 0 N hQ hδ).2.1
  set X := firstIndUnitGen Q Λ i θ 0 N hQ (redUnit Q Λ θ s hs) with hX
  have hδu : firstIndDeltaT Q Λ i θ 0 N hQ (firstIndStdGen Q Λ i θ 0 N hQ (redUnit Q Λ θ s hs)) =
      firstIndAffine Q Λ i θ 0 G • X :=
    firstIndDelta_unitGen Q Λ i θ 0 N hQ _
  have hcX : c • X = firstIndDeltaT Q Λ i θ 0 N hQ
      (redLoadingIdem Q Λ _ _ hsrc • firstIndStdGen Q Λ i θ 0 N hQ (redUnit Q Λ θ s hs)) := by
    rw [map_smul, hδu, hc, mul_smul]
  intro w hw
  have hwt : w * et = w := by
    have h : w * (1 - et) = 0 := hfaith _ fun a => by
      obtain ⟨z, hz⟩ := hw a
      rw [← mul_assoc, hz, mul_assoc, mul_sub, mul_one, hcet, sub_self, mul_zero]
    rw [mul_sub, mul_one, sub_eq_zero] at h
    exact h.symm
  have hq : lastIndQuotientMap Q Λ i θ 0 N hQ (w • X) = 0 := by
    refine hNK _ fun a => ?_
    obtain ⟨z, hz⟩ := hw a
    rw [← map_smul, smul_smul, hz, mul_smul, hcX, map_smul]
    rw [(hexact _).2 ⟨_, rfl⟩, smul_zero]
  obtain ⟨m, hm⟩ := (hexact _).1 hq
  obtain ⟨t, rfl⟩ := exists_eq_smul_firstIndStdGen Q Λ i θ s hs hQ m
  rw [map_smul, hδu, smul_smul] at hm
  refine ⟨t, ?_⟩
  have h1 := congrArg (baseCrossProj Q Λ i θ s hs hQ) hm
  rw [map_smul, map_smul, baseCrossProj_unitGen, smul_eq_mul, smul_eq_mul, ← het, hwt,
    mul_assoc, hGe] at h1
  exact h1.symm

end Cokernel

end Categorification.Stendhal
