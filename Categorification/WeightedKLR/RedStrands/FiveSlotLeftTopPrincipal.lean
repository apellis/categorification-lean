import Categorification.WeightedKLR.RedStrands.FiveSlotLeftTopIdeal
import Categorification.WeightedKLR.RedStrands.BraidedAppendFlip


/-!
# The principal higher corner at the nearby left loading

At the top loading `[0,i,1,i,2]`, every higher coefficient factors through
the same black–red crossing from `[0,i,i,1,2]`. The proof uses a common
descent and then takes the supported part of the principal two-sided ideal.
-/

noncomputable section
namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR KLRAlgebra TypeA Equiv

/-- If the corner from `f` to `e` has one right generator, then the
`e`-cut of the ideal generated by `f` has the same left factor. -/
theorem exists_factor_of_mem_principal_idempotent_ideal {R : Type*} [Ring R]
    {e f c : R} (he : e*e=e) (hf : f*f=f)
    (cyclic : ∀ z : R, e*z*f=z → ∃ y : R, f*y*f=y ∧ c*y=z)
    (x : R) (hx : x ∈ TwoSidedIdeal.span {f}) (left : e*x=x) :
    ∃ y : R, f*y=y ∧ c*y=x := by
  have cut (z : R) (hz : z ∈ TwoSidedIdeal.span {f}) :
      ∀ a b : R, ∃ y : R, f*y=y ∧ c*y=e*a*z*b := by
    refine TwoSidedIdeal.span_induction
      (p := fun z _ => ∀ a b : R, ∃ y : R, f*y=y ∧ c*y=e*a*z*b) ?_ ?_ ?_ ?_ ?_ ?_ hz
    · intro w hw a b
      have hw' : w=f := hw
      subst w
      have pad : e*(e*a*f)*f=e*a*f := by
        calc
          _ = (e*e)*a*(f*f) := by simp only [mul_assoc]
          _ = _ := by rw [he,hf]
      obtain ⟨y,hy,hcy⟩ := cyclic (e*a*f) pad
      have hyl : f*y=y := by
        calc
          f*y = f*(f*y*f) := congrArg (f*·) hy.symm
          _ = f*y*f := by simp only [← mul_assoc,hf]
          _ = y := hy
      exact ⟨y*b,by rw [← mul_assoc,hyl],by rw [← mul_assoc,hcy]⟩
    · intro a b
      exact ⟨0,by rw [mul_zero],by rw [mul_zero,mul_zero,zero_mul]⟩
    · intro u v _ _ hu hv a b
      obtain ⟨y,hy,ey⟩ := hu a b
      obtain ⟨z,hz,ez⟩ := hv a b
      exact ⟨y+z,by rw [mul_add,hy,hz],by rw [mul_add,ey,ez,mul_add,add_mul]⟩
    · intro u _ hu a b
      obtain ⟨y,hy,ey⟩ := hu a b
      exact ⟨-y,by rw [mul_neg,hy],by rw [mul_neg,ey,mul_neg,neg_mul]⟩
    · intro a u _ hu b d
      simpa only [mul_assoc] using hu (b*a) d
    · intro b u _ hu a d
      simpa only [mul_assoc] using hu a (b*d)
  obtain ⟨y,hy,h⟩ := cut x hx 1 1
  exact ⟨y,hy,by simpa only [mul_one,left] using h⟩

variable {I : Type} {k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ} {ν : Multiset I}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)
local notation "μ" => stendhalWeight ℓ ν
local notation "n" => Multiset.card μ
local notation "A" => BraidedStendhalAlgebra k Q Λ ν
local notation "V" => ViolQuotient k Q Λ ν
local notation "F" => ofKLR k Q Λ ν
local notation "π" => violMk k Q Λ ν
local notation "E" => fun v : Seq μ => F (e v)
local notation "P" => fun v : Seq μ => π (F (e v))

private theorem cut_sq (s : Seq μ) : E s*E s=E s := by rw [← map_mul,e_mul_self]

/-- The reflected common-descent factorization extracts a single crossing on
the left. It passes through the globally violated quotient by lifting both
supported endpoints. -/
theorem exists_viol_leftFactor_of_descent (hQ : KLRSymm Q) (t s : Seq μ)
    (j : ℕ) (hj : j+1<n)
    (desc : ∀ w : Perm (Fin n), w • t=s → w ⟨j+1,hj⟩ < w ⟨j,by omega⟩)
    (x : V) (hx : P t*x*P s=x) :
    ∃ y : V, P (sadj n j • t)*y*P s=y ∧
      π (F (ψ j*e (sadj n j • t)))*y=x := by
  obtain ⟨d,hd⟩ := violMk_surjective (Q := Q) (Λ := Λ) x
  let z : A := E t*d*E s
  have hz : E t*z*E s=z := by
    change E t*(E t*d*E s)*E s=E t*d*E s
    calc
      _ = (E t*E t)*d*(E s*E s) := by simp only [mul_assoc]
      _ = _ := by rw [cut_sq,cut_sq]
  have hπ : π z=x := by
    change π (E t*d*E s)=x
    rw [map_mul,map_mul,hd]
    exact hx
  have reflected : E s*flip z*E t=flip z := by
    simpa only [flip_mul,flip_e,mul_assoc] using congrArg flip hz
  obtain ⟨y,hy,hyz⟩ := exists_supported_descent_factor Q Λ hQ t s j hj desc (flip z) reflected
  have crossed : flip (F (ψ j*e t)) = F (ψ j*e (sadj n j • t)) := by
    rw [flip_ofKLR,hflip_mul,hflip_e,hflip_ψ,e_mul_ψ]
  refine ⟨π (flip y),?_,?_⟩
  · have cut : E (sadj n j • t)*flip y*E s=flip y := by
      simpa only [flip_mul,flip_e,mul_assoc] using congrArg flip hy
    simpa only [map_mul] using congrArg π cut
  · have eq : F (ψ j*e (sadj n j • t))*flip y=z := by
      simpa only [flip_mul,crossed,flip_flip] using congrArg flip hyz
    simpa only [map_mul,hπ] using congrArg π eq

section FiveSlot

variable {K : Type} [CommRing K]
  (Q₀ : Unit → Unit → MvPolynomial (Fin 2) K) (Λ₀ : Fin 3 → Unit →₀ ℕ)
local notation "ν₀" => ({()} + {()} : Multiset Unit)
local notation "μ₀" => stendhalWeight 3 ν₀
local notation "n₀" => Multiset.card μ₀
local notation "v₀" => fixedTopFourExitCut 0
local notation "jA" => sadj n₀ 2 • v₀
local notation "V₀" => ViolQuotient K Q₀ Λ₀ ν₀
local notation "map₀" => AlgHom.comp (violMk K Q₀ Λ₀ ν₀) (ofKLR K Q₀ Λ₀ ν₀)
local notation "p₀" => map₀ (e v₀)
local notation "pA" => map₀ (e jA)
local notation "c" => map₀ (ψ 2*e v₀)
local notation "J" => blockUpperIdeal K Q₀ Λ₀ ν₀ 1 2 (adjacentBlockRoot 1 2 jA) (redWord jA)

private theorem jA_to_v₀_desc (w : Perm (Fin n₀)) (hw : w • jA=v₀) :
    w ⟨3,by decide⟩ < w ⟨2,by decide⟩ := by
  have all : ∀ w : Perm (Fin n₀), w • jA=v₀ → w ⟨3,by decide⟩ < w ⟨2,by decide⟩ := by
    decide +kernel
  exact all w hw

private theorem middle_corner_cyclic (hQ : KLRSymm Q₀) (x : V₀) (hx : pA*x*p₀=x) :
    ∃ y : V₀, p₀*y*p₀=y ∧ c*y=x := by
  have hj : sadj n₀ 2 • jA=v₀ := sadj_smul_smul ..
  have h := exists_viol_leftFactor_of_descent Q₀ Λ₀ hQ jA v₀ 2 (by decide)
    jA_to_v₀_desc x hx
  simpa only [hj,AlgHom.comp_apply] using h

/-- At the five-slot top `[0,i,1,i,2]`, every higher-ideal coefficient with
that left cut has the same single crossing from the left-extreme cut. -/
theorem fiveSlot_jA_higher_exists_leftFactor (hQ : KLRSymm Q₀) (x : V₀)
    (hx : x ∈ J) (cut : pA*x=x) :
    ∃ y : V₀, p₀*y=y ∧ c*y=x := by
  have hJ : J=TwoSidedIdeal.span {p₀} :=
    fiveSlot_oneBlackBeforePair_blockUpperIdeal Q₀ Λ₀ jA (.inr rfl)
  rw [hJ] at hx
  have hA : pA*pA=pA := by rw [← map_mul,e_mul_self]
  have h0 : p₀*p₀=p₀ := by rw [← map_mul,e_mul_self]
  exact exists_factor_of_mem_principal_idempotent_ideal hA h0
    (middle_corner_cyclic Q₀ Λ₀ hQ) x hx cut

end FiveSlot

end Categorification.Stendhal.BraidedStendhalAlgebra
