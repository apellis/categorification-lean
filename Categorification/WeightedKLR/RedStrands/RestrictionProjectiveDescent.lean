import Mathlib.Algebra.Module.Projective
import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Projectivity after taking the quotient of a restriction bimodule

For the restriction in Webster, arXiv:1309.3796v2, Theorem 4.31, a
surjection from a projective cyclotomic cut descends projectivity if its
kernel is generated by the action of the lower algebra's kernel.
-/

namespace Categorification.Stendhal

open Module LinearMap

/-- Projectivity descends across a surjective change of rings if all
relations of the module quotient come from the ring quotient. -/
theorem projective_of_quotient_kernel
    {R S P Q : Type*} [Ring R] [Ring S] [AddCommGroup P] [AddCommGroup Q]
    [Module R P] [Module S Q] [Projective R P]
    (σ : R →+* S) (hσ : Function.Surjective σ) (f : P →ₛₗ[σ] Q)
    (hf : Function.Surjective f)
    (hk : LinearMap.ker f ≤ Submodule.span R {z | ∃ r : R, σ r = 0 ∧ ∃ p : P, z = r • p}) :
    Projective S Q := by
  let : Module R Q := Module.compHom Q σ
  let : Module R (Q →₀ S) := Module.compHom (Q →₀ S) σ
  let g : P →ₗ[R] Q := { f with map_smul' := f.map_smulₛₗ }
  let ε := Finsupp.linearCombination S (_root_.id : Q → Q)
  let π : (Q →₀ S) →ₗ[R] Q :=
    { ε with map_smul' := fun r x => ε.map_smul (σ r) x }
  have hπ : Function.Surjective π := fun q => ⟨Finsupp.single q 1, by simp [π, ε]⟩
  obtain ⟨s, hs⟩ := projective_lifting_property π g hπ
  have hker : ker g ≤ ker s := hk.trans <| Submodule.span_le.mpr (by
    rintro _ ⟨r, hr, p, rfl⟩
    change s (r • p) = 0
    rw [map_smul]
    change σ r • s p = 0
    rw [hr, zero_smul])
  let t := ((ker g).liftQ s hker).comp (g.quotKerEquivOfSurjective hf).symm.toLinearMap
  have ht (p : P) : t (g p) = s p := by simp [t, quotKerEquivOfSurjective_symm_apply]
  let u : Q →ₗ[S] Q →₀ S :=
    { t with
      map_smul' := fun a q => by
        obtain ⟨r, rfl⟩ := hσ a
        exact t.map_smul r q }
  refine ⟨u, fun q => ?_⟩
  obtain ⟨p, rfl⟩ := hf q
  change π (t (g p)) = g p
  rw [ht]
  exact LinearMap.congr_fun hs p

end Categorification.Stendhal
