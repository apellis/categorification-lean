import Categorification.WeightedKLR.RedStrands.BraidedViolatedPush
import Categorification.Algebra.CornerTensorQuotient

set_option backward.isDefEq.respectTransparency false

/-!
# The quotient bimodules `B_w` and Webster's Lemma 6.5 for them

Webster (arXiv:1309.3796v2, §6, before Lemma 6.5) defines `B_w` as the quotient of `B̃_w` by
the sub-bimodule spanned by violated diagrams, those with a black strand leftmost at some
height. Every violated diagram factors through an idempotent `e(i)` whose leftmost strand is
black, so we model the quotients through the two-sided ideal `J` of the braided Stendhal
algebra generated by these idempotents (of every red order): `B(κ', κ)` is the corner
`e_{κ'} (A / J) e_κ`, and the tensor product over the middle corner is the corner tensor
product over `A / J`.

Lemma 6.5 asserts that multiplication `B_w ⊗ B_{w'} → B_{ww'}` is an isomorphism when
`ℓ(ww') = ℓ(w) + ℓ(w')`. We deduce it from the same statement for `B̃_w`
(`tensorMult_bijective_of_inversions`) with `CornerTensor.mult_injective_of_ker`: an element
`e₂ z e₀` with `z ∈ J` is a sum of products `e₂ j e₁ x e₀` and `e₂ x e₁ j e₀` with `j ∈ J`.
For a generator `a e(i) b`, either the red order `κ` of `i` still crosses every pair crossed
from `κ₀` to `κ₁`, and the factorization through `κ` applies, or `κ` can be moved one crossing
towards `κ₂`, pushing `e(i)` to a violated idempotent of the new order
(`redProj_mul_mul_e_mem`).

## Main results

* `BraidedStendhalAlgebra.violIdeal`, `violMk` : the ideal of violated idempotents and the
  quotient map.
* `BraidedStendhalAlgebra.violMk_mult_injective`, `violMk_mult_surjective` : **Webster,
  Lemma 6.5** for the quotients `B_w`, with the length condition in inversion-set form.
-/

namespace Categorification.Stendhal

open KLR TypeA Equiv MvPolynomial RedWord
open scoped List

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

namespace BraidedStendhalAlgebra

variable {κ₂ κ₁ κ₀ : List (Fin ℓ)}

variable (k Q Λ ν) in
/-- The two-sided ideal generated by the idempotents `e(i)` whose leftmost strand is black. -/
noncomputable def violIdeal : TwoSidedIdeal (BraidedStendhalAlgebra k Q Λ ν) :=
  TwoSidedIdeal.span {y | ∃ i : Seq μ, IsViolated i ∧ y = ofKLR k Q Λ ν (KLRAlgebra.e i)}

variable (k Q Λ ν) in
/-- The quotient of the braided Stendhal algebra by violated idempotents. -/
abbrev ViolQuotient : Type _ := (violIdeal k Q Λ ν).ringCon.Quotient

variable (k Q Λ ν) in
/-- The quotient map. -/
noncomputable def violMk : BraidedStendhalAlgebra k Q Λ ν →ₐ[k] ViolQuotient k Q Λ ν :=
  (violIdeal k Q Λ ν).ringCon.mkₐ k

theorem violMk_eq_zero_iff (x : BraidedStendhalAlgebra k Q Λ ν) :
    violMk k Q Λ ν x = 0 ↔ x ∈ violIdeal k Q Λ ν := by
  change (violIdeal k Q Λ ν).ringCon.mk' x = 0 ↔ _
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk']

theorem violMk_surjective : Function.Surjective (violMk k Q Λ ν) :=
  RingCon.mkₐ_surjective _

theorem redProj_mul_e (κ : List (Fin ℓ)) (j : Seq μ) :
    redProj k Q Λ ν κ * ofKLR k Q Λ ν (KLRAlgebra.e j) =
      if redWord j = κ then ofKLR k Q Λ ν (KLRAlgebra.e j) else 0 := by
  rw [redProj, ← map_mul, redIdem_mul_e]
  split_ifs <;> simp

theorem e_mul_redProj (κ : List (Fin ℓ)) (j : Seq μ) :
    ofKLR k Q Λ ν (KLRAlgebra.e j) * redProj k Q Λ ν κ =
      if redWord j = κ then ofKLR k Q Λ ν (KLRAlgebra.e j) else 0 := by
  rw [redProj, ← map_mul, e_mul_redIdem]
  split_ifs <;> simp

omit [DecidableEq I] in
theorem redWord_perm (i j : Seq μ) : (redWord i).Perm (redWord j) :=
  (List.perm_ext_iff_of_nodup (redWord_nodup _) (redWord_nodup _)).2 fun r => by
    simp [mem_redWord]

theorem redProj_eq_zero {κ : List (Fin ℓ)} (h : ∀ j : Seq μ, redWord j ≠ κ) :
    redProj k Q Λ ν κ = 0 := by
  rw [redProj, redIdem, Finset.filter_false_of_mem fun j _ => h j, Finset.sum_empty, map_zero]

omit [DecidableEq I] in
/-- Exchanging an adjacent pair `c, d` that `κ₂` reads as `d, c` removes one inversion. -/
theorem card_inversions_swap_lt {L M : List (Fin ℓ)} {c d : Fin ℓ}
    (h0 : (L ++ c :: d :: M).Nodup) (h2 : κ₂.Nodup) (hdc : [d, c] <+ κ₂) :
    (inversions (L ++ d :: c :: M) κ₂).card < (inversions (L ++ c :: d :: M) κ₂).card := by
  have hcd : c ≠ d := by
    have := (List.nodup_append.1 h0).2.1
    exact fun h => (List.nodup_cons.1 this).1 (by simp [h])
  have hp' : (L ++ d :: c :: M).Perm (L ++ c :: d :: M) :=
    List.Perm.append_left L (List.Perm.swap c d M)
  have h0' := h0.perm hp'.symm
  have hnot : ∀ x y, [y, x] <+ κ₂ → ¬(x = d ∧ y = c) := by
    rintro x y hyx ⟨rfl, rfl⟩
    exact hcd (eq_of_pair_sublist_of_pair_sublist h2 hyx hdc)
  have hcd0 : [c, d] <+ L ++ c :: d :: M := by simp
  apply Finset.card_lt_card
  rw [Finset.ssubset_iff_of_subset]
  · refine ⟨(c, d), ?_, ?_⟩
    · simp [inversions, hcd0, hdc]
    · simp only [inversions, Finset.mem_filter, Finset.mem_univ, true_and, not_and]
      intro h
      have : [d, c] <+ L ++ d :: c :: M := by simp
      exact fun _ => hcd (eq_of_pair_sublist_of_pair_sublist h0' h this)
  · intro p hp
    simp only [inversions, Finset.mem_filter, Finset.mem_univ, true_and] at hp ⊢
    exact ⟨pair_sublist_of_swap hp.1 (hnot _ _ hp.2), hp.2⟩

variable (k Q Λ ν κ₂ κ₁ κ₀) in
/-- The products `e₂ j e₁ x e₀` and `e₂ x e₁ j e₀` with `j` violated. -/
noncomputable def violPairSpan : Submodule k (BraidedStendhalAlgebra k Q Λ ν) :=
  Submodule.span k {y | ∃ j x, violMk k Q Λ ν j = 0 ∧
    (y = redProj k Q Λ ν κ₂ * j * redProj k Q Λ ν κ₁ * x * redProj k Q Λ ν κ₀ ∨
      y = redProj k Q Λ ν κ₂ * x * redProj k Q Λ ν κ₁ * j * redProj k Q Λ ν κ₀)}

theorem violMk_e {i : Seq μ} (hi : IsViolated i) :
    violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.e i)) = 0 :=
  (violMk_eq_zero_iff _).2 (TwoSidedIdeal.subset_span ⟨i, hi, rfl⟩)

variable {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : IsReducedChoice ρ) (hQ : KLRSymm Q)

include hρ hQ in
/-- A generator `e₂ a e(i) b e₀` of the violated part of `B̃(κ₂, κ₀)` is a sum of products
through `B̃(κ₂, κ₁) ⊗ B̃(κ₁, κ₀)` with a violated factor, by induction on the number of pairs
that the red order of `i` reads in the opposite order to `κ₂`. -/
theorem redProj_mul_e_mul_mem (h0 : κ₀.Nodup) (hp : κ₀.Perm κ₁)
    (H : ∀ x y, [x, y] <+ κ₀ → [y, x] <+ κ₁ → [y, x] <+ κ₂) (n : ℕ) :
    ∀ κ : List (Fin ℓ), (inversions κ κ₂).card = n → ∀ i : Seq μ, IsViolated i →
      redWord i = κ → ∀ a b : BraidedStendhalAlgebra k Q Λ ν,
        redProj k Q Λ ν κ₂ * a * ofKLR k Q Λ ν (KLRAlgebra.e i) * b * redProj k Q Λ ν κ₀ ∈
          violPairSpan k Q Λ ν κ₂ κ₁ κ₀ := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro κ hn i hv hi a b
  set E := ofKLR k Q Λ ν (KLRAlgebra.e i)
  have hEP : E * redProj k Q Λ ν κ = E := by
    rw [e_mul_redProj]; simp only [hi, ite_true, E]
  have hPE : redProj k Q Λ ν κ * E = E := by
    rw [redProj_mul_e]; simp only [hi, ite_true, E]
  by_cases hA : ∀ x y, [x, y] <+ κ₀ → [y, x] <+ κ₁ → [y, x] <+ κ
  · -- the factorization through `κ` applies
    obtain ⟨t, ht⟩ := (tensorMult_surjective_iff.1
      (tensorMult_bijective_of_inversions (Λ := Λ) hρ hQ h0 hp hA).2) b
    have he : redProj k Q Λ ν κ₂ * a * E * b * redProj k Q Λ ν κ₀ =
        redProj k Q Λ ν κ₂ * (a * E) *
          (redProj k Q Λ ν κ * b * redProj k Q Λ ν κ₀) := by
      conv_lhs => rw [← hEP]
      simp only [mul_assoc]
    rw [he, ← ht]
    clear ht
    induction t using CornerTensor.induction_on with
    | tmul x y =>
      rw [CornerTensor.mult_tmul]
      refine Submodule.subset_span ⟨a * E * redProj k Q Λ ν κ * x, y, ?_, Or.inl ?_⟩
      · rw [map_mul, map_mul, map_mul, violMk_e hv, mul_zero, zero_mul, zero_mul]
      · simp only [mul_assoc]
    | add s t hs ht => rw [map_add, mul_add]; exact add_mem hs ht
  · -- move `κ` one crossing towards `κ₂`
    push Not at hA
    obtain ⟨x, y, hxy0, hyx1, hnot⟩ := hA
    have hne : κ ≠ κ₂ := by rintro rfl; exact hnot (H x y hxy0 hyx1)
    by_cases h2 : ∃ j : Seq μ, redWord j = κ₂
    swap
    · push Not at h2
      rw [redProj_eq_zero h2, zero_mul, zero_mul, zero_mul, zero_mul]
      exact zero_mem _
    obtain ⟨j₂, hj₂⟩ := h2
    have hperm : κ.Perm κ₂ := hi ▸ hj₂ ▸ redWord_perm i j₂
    obtain ⟨L, c, d, M, hκ, hdc⟩ :=
      exists_adjacent_inversion (hi ▸ redWord_nodup i) hperm hne
    have hlt : (inversions (L ++ d :: c :: M) κ₂).card < n := by
      rw [← hn, hκ]
      exact card_inversions_swap_lt (hκ ▸ hi ▸ redWord_nodup i) (hj₂ ▸ redWord_nodup j₂) hdc
    obtain ⟨t, ht⟩ := (tensorMult_surjective_iff.1
      (tensorMult_bijective (Λ := Λ) hρ hQ hκ rfl hdc).2) a
    have he : redProj k Q Λ ν κ₂ * a * E * b * redProj k Q Λ ν κ₀ =
        redProj k Q Λ ν κ₂ * a * redProj k Q Λ ν κ * E * b * redProj k Q Λ ν κ₀ := by
      conv_lhs => rw [← hPE]
      simp only [mul_assoc]
    rw [he, ← ht]
    clear ht
    induction t using CornerTensor.induction_on with
    | tmul x w =>
      rw [CornerTensor.mult_tmul]
      have hpush := redProj_mul_mul_e_mem (Λ := Λ) hρ hQ (hi.trans hκ) hv
        (w * redProj k Q Λ ν κ)
      have key : ∀ z ∈ violSpan k Q Λ ν (L ++ d :: c :: M),
          redProj k Q Λ ν κ₂ * x * z * b * redProj k Q Λ ν κ₀ ∈
            violPairSpan k Q Λ ν κ₂ κ₁ κ₀ := by
        intro z hz
        induction hz using Submodule.span_induction with
        | mem z hz =>
          obtain ⟨u, j, w', hj, hjκ, rfl⟩ := hz
          have := ih _ hlt _ rfl j hj hjκ (x * u) (w' * b)
          simpa only [mul_assoc] using this
        | zero => rw [mul_zero, zero_mul, zero_mul]; exact zero_mem _
        | add z z' _ _ hz hz' =>
          rw [mul_add, add_mul, add_mul]; exact add_mem hz hz'
        | smul r z _ hz =>
          rw [mul_smul_comm, smul_mul_assoc, smul_mul_assoc]; exact Submodule.smul_mem _ r hz
      have := key _ hpush
      simpa only [mul_assoc] using this
    | add s t hs ht => rw [map_add, add_mul, add_mul, add_mul]; exact add_mem hs ht

include hρ hQ in
theorem redProj_mul_mul_redProj_mem (h0 : κ₀.Nodup) (hp : κ₀.Perm κ₁)
    (H : ∀ x y, [x, y] <+ κ₀ → [y, x] <+ κ₁ → [y, x] <+ κ₂) (z : BraidedStendhalAlgebra k Q Λ ν)
    (hz : violMk k Q Λ ν z = 0) :
    redProj k Q Λ ν κ₂ * z * redProj k Q Λ ν κ₀ ∈ violPairSpan k Q Λ ν κ₂ κ₁ κ₀ := by
  rw [violMk_eq_zero_iff, violIdeal, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hz
  induction hz using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨_, ⟨a, -, g, ⟨i, hi, rfl⟩, rfl⟩, b, -, rfl⟩ := hz
    have := redProj_mul_e_mul_mem hρ hQ h0 hp H _ _ rfl i hi rfl a b
    simpa only [mul_assoc] using this
  | zero => rw [mul_zero, zero_mul]; exact zero_mem _
  | add z w _ _ hz hw => rw [mul_add, add_mul]; exact add_mem hz hw
  | neg z _ hz => rw [mul_neg, neg_mul]; exact neg_mem hz

include hρ hQ in
/-- **Webster, Lemma 6.5** (arXiv:1309.3796v2) for the quotients `B_w`, injectivity: with the
length condition in inversion-set form, multiplication `B(κ₂, κ₁) ⊗ B(κ₁, κ₀) → B(κ₂, κ₀)` is
injective. -/
theorem violMk_mult_injective (h0 : κ₀.Nodup) (hp : κ₀.Perm κ₁)
    (H : ∀ x y, [x, y] <+ κ₀ → [y, x] <+ κ₁ → [y, x] <+ κ₂) :
    Function.Injective (CornerTensor.mult (k := k)
      ((isIdempotentElem_redProj (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ₂).map (violMk k Q Λ ν))
      ((isIdempotentElem_redProj κ₁).map (violMk k Q Λ ν))
      ((isIdempotentElem_redProj κ₀).map (violMk k Q Λ ν))) :=
  CornerTensor.mult_injective_of_ker _ _ _ _ violMk_surjective
    (tensorMult_injective_iff.1 (tensorMult_bijective_of_inversions (Λ := Λ) hρ hQ h0 hp H).1)
    (redProj_mul_mul_redProj_mem hρ hQ h0 hp H)

include hρ hQ in
/-- **Webster, Lemma 6.5** (arXiv:1309.3796v2) for the quotients `B_w`, surjectivity: every
element of `B(κ₂, κ₀)` is a product. -/
theorem violMk_mult_surjective (h0 : κ₀.Nodup) (hp : κ₀.Perm κ₁)
    (H : ∀ x y, [x, y] <+ κ₀ → [y, x] <+ κ₁ → [y, x] <+ κ₂) (y : ViolQuotient k Q Λ ν) :
    ∃ t, CornerTensor.mult (k := k)
      ((isIdempotentElem_redProj (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ₂).map (violMk k Q Λ ν))
      ((isIdempotentElem_redProj κ₁).map (violMk k Q Λ ν))
      ((isIdempotentElem_redProj κ₀).map (violMk k Q Λ ν)) t =
        violMk k Q Λ ν (redProj k Q Λ ν κ₂) * y * violMk k Q Λ ν (redProj k Q Λ ν κ₀) :=
  CornerTensor.mult_surjective_of_surjective _ _ _ _ violMk_surjective
    (tensorMult_surjective_iff.1 (tensorMult_bijective_of_inversions (Λ := Λ) hρ hQ h0 hp H).2) y

end BraidedStendhalAlgebra

end Categorification.Stendhal
