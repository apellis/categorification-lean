import Categorification.Algebra.BalancedTensorFiltration
import Categorification.WeightedKLR.Mackey.MiddleResIndEquiv
import Mathlib.Order.Extension.Linear

/-!
# The Mackey filtration of `Res ∘ Ind` as a chain of sub-bimodules

B. Webster, *Weighted Khovanov–Lauda–Rouquier algebras*, arXiv:1209.2463v4, proof of
Theorem 2.19 (after Khovanov–Lauda, arXiv:0803.4121v2, Proposition 2.18). For
`ν₁ + ν₂ = ν = ν' + ν''`, the top step of the Mackey filtration, the elements `z` of the gallery
algebra with `ι_{ν₁;ν₂}(1) z = z = z ι_{ν';ν''}(1)`, is a
`(W_{ν₁} ⊗ W_{ν₂}, W_{ν'} ⊗ W_{ν''})`-bimodule through `z ↦ ι(u) z ι(w)` (`ResIndBimodule`).

The finitely many shuffle types are listed as `f 0, …, f (n - 1)` in an order refining the
dominance order (`exists_enum_of_finite`), and the steps `F i` of the filtration belonging to
the lower sets generated by `f 0, …, f (i - 1)` form a chain of sub-bimodules
`0 = F 0 ≤ ⋯ ≤ F n = ResIndBimodule` (`resIndSubBimodule`). The subquotient `F (j + 1) / F j` is
the balanced tensor product `MiddleTensor` of the four-block layout of `f j`, a bimodule through
the identifications `W_{a+c} ⊗ W_{b+d} = W_{ν₁} ⊗ W_{ν₂}` and `W_{a+b} ⊗ W_{c+d} = W_{ν'} ⊗ W_{ν''}`
(`ResIndPiece`), by a surjective bimodule map with kernel `F j` (`resIndPieceMap`). Tensoring
with a projective module gives Webster's step (iii) in `K₀`:
`[ResIndBimodule ⊗ N] = ∑_j [ResIndPiece_j ⊗ N]` (`exists_resInd_balancedTensor_eq_sum`).

## Main definitions and results

* `exists_enum_of_finite`: an enumeration of a finite subset of a partial order refining the
  order.
* `ResIndBimodule`: the bimodule `Res_{ν₁;ν₂} Ind_{ν';ν''}`, the top step of `resIndFilt`.
* `resIndSubBimodule hS`: the step of a lower set `S` of shuffle types, a sub-bimodule.
* `ShuffleLayout`, `ResIndPiece`: a four-block layout and its bimodule `MiddleTensor`.
* `resIndPieceMap`: the map from a step onto a piece; `isBimoduleHom_resIndPieceMap`,
  `resIndPieceMap_surjective`, `resIndPieceMap_eq_zero_iff`.
* `exists_resInd_balancedTensor_eq_sum`: the class of `ResIndBimodule ⊗ N` in `K₀` is the sum of
  the classes of the pieces tensored with `N`.
-/

namespace Categorification

/-- **An enumeration refining a partial order.** A finite subset `T` of a partial order is the
range of an injective `f : Fin n → α` with `f i < f j → i < j`. -/
theorem exists_enum_of_finite {α : Type*} [PartialOrder α] {T : Set α} (hT : T.Finite) :
    ∃ (n : ℕ) (f : Fin n → α), Function.Injective f ∧ Set.range f = T ∧
      ∀ i j, f i < f j → i < j := by
  classical
  let T' : Finset (LinearExtension α) := hT.toFinset
  let g := T'.orderEmbOfFin rfl
  refine ⟨T'.card, fun i => (g i : α), g.injective, ?_, fun i j hij => ?_⟩
  · ext x
    exact (Set.ext_iff.1 (Finset.range_orderEmbOfFin T' rfl) x).trans hT.mem_toFinset
  · have hle : g i ≤ g j := (toLinearExtension (α := α)).monotone hij.le
    have hne : g i ≠ g j := fun h => hij.ne h
    exact g.lt_iff_lt.1 (lt_of_le_of_ne hle hne)

end Categorification

namespace Categorification.WeightedKLR

open FullChamber GalleryAlgebra Juxtapose MulOpposite
open scoped TensorProduct

universe u v w

variable {I : Type u}

/-! ### Steps of an enumeration of shuffle types -/

/-- The lower set generated by the first `i` terms of an enumeration `f` of shuffle types. -/
def shuffleTypeStep {n : ℕ} (f : Fin n → (I → ℕ)) (i : ℕ) : Set (I → ℕ) :=
  {μ | ∃ j : Fin n, (j : ℕ) < i ∧ μ ≤ f j}

section Step

variable {n : ℕ} (f : Fin n → (I → ℕ))

theorem isLowerSet_shuffleTypeStep (i : ℕ) : IsLowerSet (shuffleTypeStep f i) :=
  fun _ _ hba ⟨j, hj, h⟩ => ⟨j, hj, hba.trans h⟩

theorem shuffleTypeStep_zero : shuffleTypeStep f 0 = ∅ :=
  Set.eq_empty_of_forall_notMem fun _ ⟨_, hj, _⟩ => Nat.not_lt_zero _ hj

theorem shuffleTypeStep_mono : Monotone (shuffleTypeStep f) :=
  fun _ _ h _ ⟨j, hj, hμ⟩ => ⟨j, lt_of_lt_of_le hj h, hμ⟩

theorem range_subset_shuffleTypeStep : Set.range f ⊆ shuffleTypeStep f n :=
  fun _ ⟨j, hj⟩ => ⟨j, j.2, hj.symm.le⟩

variable {f}

theorem notMem_shuffleTypeStep (hf : Function.Injective f)
    (hlt : ∀ i j, f i < f j → i < j) (j : Fin n) : f j ∉ shuffleTypeStep f j := by
  rintro ⟨j', hj', h⟩
  rcases h.lt_or_eq with h | h
  · exact absurd (hlt _ _ h) (not_lt.2 (Fin.le_iff_val_le_val.2 hj'.le))
  · exact (Nat.lt_irrefl _ (hf h ▸ hj'))

theorem eq_of_mem_shuffleTypeStep_succ (j : Fin n) {μ : I → ℕ}
    (hμ : μ ∈ shuffleTypeStep f ((j : ℕ) + 1))
    (hμ' : μ ∉ shuffleTypeStep f j ∪ Set.Iio (f j)) : μ = f j := by
  obtain ⟨j', hj', h⟩ := hμ
  rcases Nat.lt_succ_iff_lt_or_eq.1 hj' with hj' | hj'
  · exact absurd (Or.inl ⟨j', hj', h⟩) hμ'
  · rw [Fin.ext hj'] at h
    exact h.eq_or_lt.resolve_right fun h' => hμ' (Or.inr h')

theorem shuffleTypeStep_union_Iio_inter (hlt : ∀ i j, f i < f j → i < j) (j : Fin n) :
    (shuffleTypeStep f j ∪ Set.Iio (f j)) ∩ Set.range f = shuffleTypeStep f j ∩ Set.range f := by
  refine Set.Subset.antisymm ?_ (Set.inter_subset_inter_left _ Set.subset_union_left)
  rintro μ ⟨hμ | hμ, ⟨j', rfl⟩⟩
  · exact ⟨hμ, j', rfl⟩
  · exact ⟨⟨j', hlt _ _ hμ, le_rfl⟩, j', rfl⟩

end Step

variable [DecidableEq I] {𝕜 : Type v} [Field 𝕜] [LinearOrder 𝕜]
  [IsStrictOrderedRing 𝕜] {k : Type w} [CommRing k] {Γ : WeightedGraph I 𝕜 k} {ν : I →₀ ℕ}

namespace GalleryAlgebra

variable {ν₁ ν₂ ν' ν'' : I →₀ ℕ}

variable {P : FullChamber Γ ν → FullChamber Γ ν → (Strand ν → 𝕜) × (Strand ν → 𝕜)}
  (hP : ∀ C E, IsChamberSegment C E (P C E)) (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops)
  (hΓ : Γ.PSymm) (hW : ∀ w : Wall Γ ν, IsRegular (w.factor (k := k)))
  (hL : ∀ (Q : MvPolynomial (Fin 2) k) (a b : Strand ν), Γ.loop a.1 = some Q → a ≠ b →
    a.1 = b.1 → IsRegular (loopFactor Q a b))

/-- A step of the filtration only depends on the shuffle types in `S` that occur. -/
theorem resIndFilt_congr (hν' : ν' + ν'' = ν) (hν₁ : ν₁ + ν₂ = ν) {S S' : Set (I → ℕ)}
    (h : S ∩ Set.range (shuffleType (ν := ν) ν' ν₁) = S' ∩ Set.range (shuffleType (ν := ν) ν' ν₁)) :
    resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ S = resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ S' := by
  ext z
  simp only [mem_resIndFilt_iff, ← mackeyFilt_inter_range hP hD hZ hΓ hW hL ν' ν₁ _ _ S, h,
    mackeyFilt_inter_range]

/-! ### The bimodule `Res_{ν₁;ν₂} Ind_{ν';ν''}` -/

section Bimodule

variable (hν' : ν' + ν'' = ν) (hν₁ : ν₁ + ν₂ = ν)

theorem inductionVal_mul_inductionVal_one
    (u : WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂) :
    inductionVal k hν₁ u * inductionVal k hν₁ 1 = inductionVal k hν₁ u := by
  rw [← inductionVal_mul, mul_one]

theorem inductionVal_one_mul_inductionVal
    (u : WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂) :
    inductionVal k hν₁ 1 * inductionVal k hν₁ u = inductionVal k hν₁ u := by
  rw [← inductionVal_mul, one_mul]

theorem mul_inductionVal_mul_inductionVal (X : GalleryAlgebra k Γ ν)
    (u u' : WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂) :
    X * inductionVal k hν₁ u * inductionVal k hν₁ u' = X * inductionVal k hν₁ (u * u') := by
  rw [mul_assoc, inductionVal_mul]

variable (k) in
/-- **The bimodule `Res_{ν₁;ν₂} Ind_{ν';ν''}`** (B. Webster, arXiv:1209.2463v4, proof of
Theorem 2.19): the elements `z` of the gallery algebra with `ι_{ν₁;ν₂}(1) z = z = z ι_{ν';ν''}(1)`,
the top step of the Mackey filtration. -/
def ResIndBimodule : Type (max u w) := resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ

noncomputable instance : AddCommGroup (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :=
  inferInstanceAs (AddCommGroup (resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ))

noncomputable instance : Module k (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :=
  inferInstanceAs (Module k (resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ))

/-- The underlying element of the gallery algebra. -/
def ResIndBimodule.val (z : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :
    GalleryAlgebra k Γ ν :=
  (z : resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ).1

theorem ResIndBimodule.val_injective :
    Function.Injective (ResIndBimodule.val hP hD hZ hΓ hW hL hν' hν₁) :=
  Subtype.val_injective

@[simp] theorem ResIndBimodule.val_add (z z' : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :
    (z + z').val = z.val + z'.val := rfl

@[simp] theorem ResIndBimodule.val_zero :
    (0 : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁).val = 0 := rfl

@[simp] theorem ResIndBimodule.val_smul (r : k) (z : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :
    (r • z).val = r • z.val := rfl

theorem resIndFilt_univ_one_mul (z : resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ) :
    inductionVal k hν₁ 1 * z.1 = z.1 :=
  z.2.1

theorem resIndFilt_univ_mul_one (z : resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ) :
    z.1 * inductionVal k hν' 1 = z.1 :=
  z.2.2.1

theorem ResIndBimodule.one_mul_val (z : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :
    inductionVal k hν₁ 1 * z.val = z.val :=
  (z : resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ).2.1

theorem ResIndBimodule.val_mul_one (z : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :
    z.val * inductionVal k hν' 1 = z.val :=
  (z : resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ).2.2.1

/-- The left action `z ↦ ι_{ν₁;ν₂}(u) z`, as a ring homomorphism. -/
noncomputable def resIndLeftHom :
    WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂ →+*
      Module.End k (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) where
  toFun u := resIndFiltMul hP hD hZ hΓ hW hL hν' hν₁ isLowerSet_univ u 1
  map_one' := LinearMap.ext fun z => ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
    change inductionVal k hν₁ 1 * z.val * inductionVal k hν' 1 = z.val
    rw [resIndFilt_univ_one_mul, resIndFilt_univ_mul_one])
  map_mul' u u' := LinearMap.ext fun z =>
    ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
      change inductionVal k hν₁ (u * u') * z.val * inductionVal k hν' 1 =
        inductionVal k hν₁ u * (inductionVal k hν₁ u' * z.val * inductionVal k hν' 1) *
          inductionVal k hν' 1
      rw [inductionVal_mul]
      simp only [mul_assoc, inductionVal_mul_inductionVal_one hν' 1])
  map_zero' := LinearMap.ext fun z => ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
    change inductionVal k hν₁ 0 * z.val * inductionVal k hν' 1 = 0
    rw [map_zero, zero_mul, zero_mul])
  map_add' u u' := LinearMap.ext fun z =>
    ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
      change inductionVal k hν₁ (u + u') * z.val * inductionVal k hν' 1 =
        inductionVal k hν₁ u * z.val * inductionVal k hν' 1 +
          inductionVal k hν₁ u' * z.val * inductionVal k hν' 1
      rw [map_add, add_mul, add_mul])

/-- The right action `z ↦ z ι_{ν';ν''}(w)`, as a ring homomorphism from the opposite algebra. -/
noncomputable def resIndRightHom :
    (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ →+*
      Module.End k (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) where
  toFun w := resIndFiltMul hP hD hZ hΓ hW hL hν' hν₁ isLowerSet_univ 1 w.unop
  map_one' := LinearMap.ext fun z => ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
    change inductionVal k hν₁ 1 * z.val * inductionVal k hν' 1 = z.val
    rw [resIndFilt_univ_one_mul, resIndFilt_univ_mul_one])
  map_mul' w w' := LinearMap.ext fun z =>
    ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
      change inductionVal k hν₁ 1 * z.val * inductionVal k hν' (w * w').unop =
        inductionVal k hν₁ 1 * (inductionVal k hν₁ 1 * z.val * inductionVal k hν' w'.unop) *
          inductionVal k hν' w.unop
      rw [unop_mul, inductionVal_mul]
      simp only [← mul_assoc, resIndFilt_univ_one_mul])
  map_zero' := LinearMap.ext fun z => ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
    change inductionVal k hν₁ 1 * z.val * inductionVal k hν' (0 : _ᵐᵒᵖ).unop = 0
    rw [unop_zero, map_zero, mul_zero])
  map_add' w w' := LinearMap.ext fun z =>
    ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
      change inductionVal k hν₁ 1 * z.val * inductionVal k hν' (w + w').unop =
        inductionVal k hν₁ 1 * z.val * inductionVal k hν' w.unop +
          inductionVal k hν₁ 1 * z.val * inductionVal k hν' w'.unop
      rw [unop_add, map_add, mul_add])

noncomputable instance :
    Module (WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
      (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :=
  Module.compHom _ (resIndLeftHom hP hD hZ hΓ hW hL hν' hν₁)

noncomputable instance :
    Module (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ
      (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :=
  Module.compHom _ (resIndRightHom hP hD hZ hΓ hW hL hν' hν₁)

theorem ResIndBimodule.val_smul_left
    (u : WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
    (z : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :
    (u • z).val = inductionVal k hν₁ u * z.val * inductionVal k hν' 1 := rfl

theorem ResIndBimodule.val_smul_right
    (w : (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ)
    (z : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :
    (w • z).val = inductionVal k hν₁ 1 * z.val * inductionVal k hν' w.unop := rfl

instance : SMulCommClass (WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
    (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ
    (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) where
  smul_comm u w z := ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
    rw [ResIndBimodule.val_smul_left, ResIndBimodule.val_smul_right,
      ResIndBimodule.val_smul_right, ResIndBimodule.val_smul_left]
    simp only [← mul_assoc, ← inductionVal_mul, mul_inductionVal_mul_inductionVal hν',
      mul_one, one_mul])

instance : IsScalarTower k (WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
    (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) where
  smul_assoc r u z := ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
    rw [ResIndBimodule.val_smul_left, ResIndBimodule.val_smul, ResIndBimodule.val_smul_left,
      map_smul, smul_mul_assoc, smul_mul_assoc])

instance : IsScalarTower k (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ
    (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) where
  smul_assoc r w z := ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ (by
    rw [ResIndBimodule.val_smul_right, ResIndBimodule.val_smul, ResIndBimodule.val_smul_right,
      unop_smul, map_smul, mul_smul_comm])

/-! ### The steps as sub-bimodules -/

variable {hP hD hZ hΓ hW hL hν' hν₁} in
/-- **The step of a lower set `S` of shuffle types, as a sub-bimodule** of `Res Ind`. -/
noncomputable def resIndSubBimodule {S : Set (I → ℕ)} (hS : IsLowerSet S) :
    SubBimodule (WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
      (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')
      (ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) where
  toSubmodule :=
    { carrier := {z | z.val ∈ resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ S}
      add_mem' {x y} hx hy := by
        change (x + y).val ∈ resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ S
        rw [ResIndBimodule.val_add]
        exact Submodule.add_mem _ hx hy
      zero_mem' := by
        change (0 : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁).val ∈
          resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ S
        rw [ResIndBimodule.val_zero]
        exact Submodule.zero_mem _
      smul_mem' u _ hz :=
        inductionVal_mul_mul_mem_resIndFilt hP hD hZ hΓ hW hL hν' hν₁ hS u 1 hz }
  op_smul_mem w _ hz := inductionVal_mul_mul_mem_resIndFilt hP hD hZ hΓ hW hL hν' hν₁ hS 1 w hz

theorem mem_resIndSubBimodule {S : Set (I → ℕ)} (hS : IsLowerSet S)
    (z : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁) :
    z ∈ (resIndSubBimodule hS).toSubmodule ↔ z.val ∈ resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ S :=
  Iff.rfl

theorem resIndSubBimodule_mono {S S' : Set (I → ℕ)} (hS : IsLowerSet S) (hS' : IsLowerSet S')
    (h : S ⊆ S') :
    (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule ≤ (resIndSubBimodule hS').toSubmodule :=
  fun _ hz => resIndFilt_mono hP hD hZ hΓ hW hL hν' hν₁ h hz

theorem resIndSubBimodule_empty :
    (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) isLowerSet_empty).toSubmodule = ⊥ := by
  refine (Submodule.eq_bot_iff _).2 fun z hz =>
    ResIndBimodule.val_injective hP hD hZ hΓ hW hL hν' hν₁ ?_
  rw [mem_resIndSubBimodule, resIndFilt_empty, Submodule.mem_bot] at hz
  exact hz

theorem resIndSubBimodule_eq_top {S : Set (I → ℕ)} (hS : IsLowerSet S)
    (h : Set.range (shuffleType (ν := ν) ν' ν₁) ⊆ S) :
    (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule = ⊤ := by
  refine Submodule.eq_top_iff'.2 fun z => ?_
  rw [mem_resIndSubBimodule, resIndFilt_congr hP hD hZ hΓ hW hL hν' hν₁ (S' := Set.univ)
    (by rw [Set.univ_inter, Set.inter_eq_right.2 h])]
  exact (z : resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ Set.univ).2

end Bimodule

end GalleryAlgebra

namespace Juxtapose

variable {a b c d : I →₀ ℕ}

section CornerMapAlgebra

theorem middleCornerMap_comp
    (zL zL' : WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d))
    (zR zR' : WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d)) :
    middleCornerMap zL zR ∘ₗ middleCornerMap zL' zR' = middleCornerMap (zL * zL') (zR' * zR) :=
  BalancedTensor.ext fun t y => by
    rw [LinearMap.comp_apply, middleCornerMap_tmul, middleCornerMap_tmul, middleCornerMap_tmul,
      mul_smul]
    congr 1
    exact Subtype.ext (mul_assoc _ _ _)

theorem middleCornerMap_zero_right
    (zL : WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d)) :
    middleCornerMap zL (0 : WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d)) =
      0 :=
  BalancedTensor.ext fun t y => by
    have hy : middleBotMulRight (0 : WeightedKLRAlgebra k Γ (a + b) ⊗[k] _) y = (0 : k) • y :=
      Subtype.ext (by rw [coe_middleBotMulRight, mul_zero, Submodule.coe_smul, zero_smul])
    rw [middleCornerMap_tmul, LinearMap.zero_apply, hy, BalancedTensor.tmul_smul, zero_smul]

theorem middleCornerMap_smul_right
    (zL : WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d)) (r : k)
    (zR : WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d)) :
    middleCornerMap zL (r • zR) = r • middleCornerMap zL zR :=
  BalancedTensor.ext fun t y => by
    have hy : middleBotMulRight (r • zR) y = r • middleBotMulRight zR y :=
      Subtype.ext (by
        rw [coe_middleBotMulRight, Submodule.coe_smul, coe_middleBotMulRight, mul_smul_comm])
    rw [middleCornerMap_tmul, LinearMap.smul_apply, middleCornerMap_tmul, hy,
      BalancedTensor.tmul_smul]

/-- `middleCornerMap z_L 1` is the left action of `z_L`. -/
theorem middleCornerMap_one_right_apply
    (zL : WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d))
    (x : MiddleTensor k Γ a b c d) : middleCornerMap zL 1 x = zL • x := by
  induction x using BalancedTensor.induction_on with
  | zero => rw [map_zero, smul_zero]
  | tmul t y =>
    rw [middleCornerMap_tmul, BalancedTensor.smul_tmul']
    congr 1
    exact Subtype.ext (mul_one _)
  | add x x' hx hx' => rw [map_add, hx, hx', smul_add]

theorem middleCornerMap_zero_left
    (zR : WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d)) :
    middleCornerMap (0 : WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d)) zR =
      0 :=
  BalancedTensor.ext fun t y => by
    rw [middleCornerMap_tmul, LinearMap.zero_apply, zero_smul, BalancedTensor.zero_tmul]

theorem middleCornerMap_algebraMap_one (r : k) :
    middleCornerMap
      (algebraMap k (WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d)) r)
      (1 : WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d)) =
      algebraMap k (Module.End k (MiddleTensor k Γ a b c d)) r := by
  rw [Algebra.algebraMap_eq_smul_one, Module.algebraMap_end_eq_smul_id, ← middleCornerMap_one_one]
  exact BalancedTensor.ext fun t y => by
    rw [middleCornerMap_tmul, LinearMap.smul_apply, middleCornerMap_tmul, smul_assoc, one_smul,
      BalancedTensor.smul_tmul]

theorem middleCornerMap_one_algebraMap (r : k) :
    middleCornerMap (1 : WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d))
      (algebraMap k (WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d)) r) =
      algebraMap k (Module.End k (MiddleTensor k Γ a b c d)) r := by
  rw [Algebra.algebraMap_eq_smul_one, middleCornerMap_smul_right, middleCornerMap_one_one,
    Module.algebraMap_end_eq_smul_id]

variable {B : Type*} [Ring B] [Algebra k B]

/-- The left action of `B` on `MiddleTensor` through an algebra map
`φ : B → W_{a+c} ⊗ W_{b+d}`: `u (t ⊗ y) = φ(u) t ⊗ y`. -/
noncomputable def middleLeftAct
    (φ : B →ₐ[k] WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d)) :
    B →ₐ[k] Module.End k (MiddleTensor k Γ a b c d) where
  toFun u := middleCornerMap (φ u) 1
  map_one' := by
    rw [map_one, middleCornerMap_one_one, Module.End.one_eq_id]
  map_mul' u u' := by
    rw [map_mul, Module.End.mul_eq_comp, middleCornerMap_comp, mul_one]
  map_zero' := by
    rw [map_zero, middleCornerMap_zero_left]
  map_add' u u' := by
    rw [map_add, middleCornerMap_add_left]
  commutes' r := by
    rw [AlgHom.commutes, middleCornerMap_algebraMap_one]

theorem middleLeftAct_apply
    (φ : B →ₐ[k] WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d)) (u : B) :
    middleLeftAct φ u = middleCornerMap (φ u) 1 := rfl

/-- The right action of `B` on `MiddleTensor` through an algebra map
`ψ : B → W_{a+b} ⊗ W_{c+d}`: `(t ⊗ y) w = t ⊗ y ψ(w)`. -/
noncomputable def middleRightAct
    (ψ : B →ₐ[k] WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d)) :
    Bᵐᵒᵖ →ₐ[k] Module.End k (MiddleTensor k Γ a b c d) where
  toFun w := middleCornerMap 1 (ψ w.unop)
  map_one' := by
    rw [MulOpposite.unop_one, map_one, middleCornerMap_one_one, Module.End.one_eq_id]
  map_mul' w w' := by
    rw [MulOpposite.unop_mul, map_mul, Module.End.mul_eq_comp, middleCornerMap_comp, mul_one]
  map_zero' := by
    rw [MulOpposite.unop_zero, map_zero, middleCornerMap_zero_right]
  map_add' w w' := by
    rw [MulOpposite.unop_add, map_add, middleCornerMap_add_right]
  commutes' r := by
    rw [MulOpposite.algebraMap_apply, MulOpposite.unop_op, AlgHom.commutes,
      middleCornerMap_one_algebraMap]

theorem middleRightAct_apply
    (ψ : B →ₐ[k] WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d)) (w : Bᵐᵒᵖ) :
    middleRightAct ψ w = middleCornerMap 1 (ψ w.unop) := rfl

theorem middleLeftAct_mul_middleRightAct {B' : Type*} [Ring B'] [Algebra k B']
    (φ : B →ₐ[k] WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d))
    (ψ : B' →ₐ[k] WeightedKLRAlgebra k Γ (a + b) ⊗[k] WeightedKLRAlgebra k Γ (c + d))
    (u : B) (w : B'ᵐᵒᵖ) :
    middleLeftAct φ u * middleRightAct ψ w = middleRightAct ψ w * middleLeftAct φ u := by
  rw [middleLeftAct_apply, middleRightAct_apply, Module.End.mul_eq_comp, Module.End.mul_eq_comp,
    middleCornerMap_comp, middleCornerMap_comp, one_mul, mul_one, one_mul, mul_one]

end CornerMapAlgebra

end Juxtapose

variable (ν' ν'' ν₁ ν₂ : I →₀ ℕ) in
/-- **A four-block layout** `ν' = a + b`, `ν'' = c + d`, `ν₁ = a + c`, `ν₂ = b + d` (B. Webster,
arXiv:1209.2463v4, proof of Theorem 2.19): the shape of a shuffle of type `c`. -/
structure ShuffleLayout where
  /-- The block of `ν'` staying in `ν₁`. -/
  a : I →₀ ℕ
  /-- The block of `ν'` moving to `ν₂`. -/
  b : I →₀ ℕ
  /-- The block of `ν''` moving to `ν₁`: the shuffle type. -/
  c : I →₀ ℕ
  /-- The block of `ν''` staying in `ν₂`. -/
  d : I →₀ ℕ
  hab : a + b = ν'
  hcd : c + d = ν''
  hac : a + c = ν₁
  hbd : b + d = ν₂

namespace ShuffleLayout

variable {ν' ν'' ν₁ ν₂ : I →₀ ℕ} (L : ShuffleLayout ν' ν'' ν₁ ν₂)

variable (k Γ) in
/-- `W_{a+c} ⊗ W_{b+d} ≃ W_{ν₁} ⊗ W_{ν₂}`. -/
noncomputable def leftEquiv :
    (WeightedKLRAlgebra k Γ (L.a + L.c) ⊗[k] WeightedKLRAlgebra k Γ (L.b + L.d)) ≃ₐ[k]
      (WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂) :=
  Algebra.TensorProduct.congr (castW k Γ L.hac) (castW k Γ L.hbd)

variable (k Γ) in
/-- `W_{a+b} ⊗ W_{c+d} ≃ W_{ν'} ⊗ W_{ν''}`. -/
noncomputable def rightEquiv :
    (WeightedKLRAlgebra k Γ (L.a + L.b) ⊗[k] WeightedKLRAlgebra k Γ (L.c + L.d)) ≃ₐ[k]
      (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'') :=
  Algebra.TensorProduct.congr (castW k Γ L.hab) (castW k Γ L.hcd)

end ShuffleLayout

open Juxtapose in
variable (k Γ) in
/-- **The piece of a four-block layout**: the balanced tensor product
`(W_{a+c} ⊗ W_{b+d}) e' ⊗_{W'} e (W_{a+b} ⊗ W_{c+d})` (`MiddleTensor`), as a
`(W_{ν₁} ⊗ W_{ν₂}, W_{ν'} ⊗ W_{ν''})`-bimodule through `ShuffleLayout.leftEquiv` and
`ShuffleLayout.rightEquiv`; the right action is `t ⊗ y ↦ t ⊗ y w` (B. Webster,
arXiv:1209.2463v4, proof of Theorem 2.19). -/
def ResIndPiece {ν' ν'' ν₁ ν₂ : I →₀ ℕ} (L : ShuffleLayout ν' ν'' ν₁ ν₂) : Type (max u w) :=
  MiddleTensor k Γ L.a L.b L.c L.d

namespace ResIndPiece

open Juxtapose

variable {ν' ν'' ν₁ ν₂ : I →₀ ℕ} (L : ShuffleLayout ν' ν'' ν₁ ν₂)

noncomputable instance : AddCommGroup (ResIndPiece k Γ L) :=
  inferInstanceAs (AddCommGroup (MiddleTensor k Γ L.a L.b L.c L.d))

noncomputable instance : Module k (ResIndPiece k Γ L) :=
  inferInstanceAs (Module k (MiddleTensor k Γ L.a L.b L.c L.d))

/-- The left action `t ⊗ y ↦ u t ⊗ y`, through the inverse of `ShuffleLayout.leftEquiv`. -/
noncomputable def leftAct :
    WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂ →ₐ[k]
      Module.End k (MiddleTensor k Γ L.a L.b L.c L.d) :=
  middleLeftAct (L.leftEquiv k Γ).symm.toAlgHom

/-- The right action `t ⊗ y ↦ t ⊗ y w`, through the inverse of `ShuffleLayout.rightEquiv`. -/
noncomputable def rightAct :
    (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ →ₐ[k]
      Module.End k (MiddleTensor k Γ L.a L.b L.c L.d) :=
  middleRightAct (L.rightEquiv k Γ).symm.toAlgHom

noncomputable instance :
    Module (WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂) (ResIndPiece k Γ L) :=
  Module.compHom (MiddleTensor k Γ L.a L.b L.c L.d) (ResIndPiece.leftAct L).toRingHom

noncomputable instance :
    Module (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ (ResIndPiece k Γ L) :=
  Module.compHom (MiddleTensor k Γ L.a L.b L.c L.d) (ResIndPiece.rightAct L).toRingHom

theorem smul_left_def (u : WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
    (x : ResIndPiece k Γ L) :
    u • x = ResIndPiece.leftAct L u x := rfl

theorem smul_right_def (w : (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ)
    (x : ResIndPiece k Γ L) :
    w • x = ResIndPiece.rightAct L w x := rfl

theorem smul_k_def (r : k) (x : ResIndPiece k Γ L) :
    r • x = (r • x : MiddleTensor k Γ L.a L.b L.c L.d) := rfl

instance : IsScalarTower k (WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
    (ResIndPiece k Γ L) where
  smul_assoc r u x := by
    rw [smul_left_def, smul_left_def, map_smul]
    rfl

instance : IsScalarTower k (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ
    (ResIndPiece k Γ L) where
  smul_assoc r w x := by
    rw [smul_right_def, smul_right_def, map_smul]
    rfl

instance : SMulCommClass (WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
    (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ (ResIndPiece k Γ L) where
  smul_comm u w x := by
    rw [smul_left_def, smul_right_def, smul_right_def, smul_left_def]
    exact LinearMap.congr_fun (middleLeftAct_mul_middleRightAct _ _ u w) x

end ResIndPiece

namespace GalleryAlgebra

variable {ν₁ ν₂ ν' ν'' : I →₀ ℕ}

variable {P : FullChamber Γ ν → FullChamber Γ ν → (Strand ν → 𝕜) × (Strand ν → 𝕜)}
  {hP : ∀ C E, IsChamberSegment C E (P C E)} {hD : Γ.Dagger} {hZ : Γ.NoZeroLoops}
  {hΓ : Γ.PSymm} {hW : ∀ w : Wall Γ ν, IsRegular (w.factor (k := k))}
  {hL : ∀ (Q : MvPolynomial (Fin 2) k) (a b : Strand ν), Γ.loop a.1 = some Q → a ≠ b →
    a.1 = b.1 → IsRegular (loopFactor Q a b)}
  {hν' : ν' + ν'' = ν} {hν₁ : ν₁ + ν₂ = ν}

/-! ### The pieces of the chain -/

/-- The underlying element of the gallery algebra, as a linear map. -/
noncomputable def ResIndBimodule.valHom :
    ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁ →ₗ[k] GalleryAlgebra k Γ ν where
  toFun z := z.val
  map_add' := ResIndBimodule.val_add hP hD hZ hΓ hW hL hν' hν₁
  map_smul' := ResIndBimodule.val_smul hP hD hZ hΓ hW hL hν' hν₁

/-- The quotient map of the step `S` onto the subquotient `S / S'`. -/
noncomputable def resIndStepMk (S' : Set (I → ℕ)) {S : Set (I → ℕ)} (hS : IsLowerSet S) :
    (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule →ₗ[k]
      ResIndSubquotient k hP hD hZ hΓ hW hL hν' hν₁ S' S :=
  Submodule.mkQ _ ∘ₗ LinearMap.codRestrict _
    (ResIndBimodule.valHom ∘ₗ (Submodule.subtype _).restrictScalars k) fun x => x.2

theorem resIndStepMk_apply (S' : Set (I → ℕ)) {S : Set (I → ℕ)} (hS : IsLowerSet S)
    (x : (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule) :
    resIndStepMk S' hS x =
      Submodule.Quotient.mk ⟨(x : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁).val, x.2⟩ :=
  rfl

theorem resIndStepMk_smul_left {S' S : Set (I → ℕ)} (hS' : IsLowerSet S') (hS : IsLowerSet S)
    (u : WeightedKLRAlgebra k Γ ν₁ ⊗[k] WeightedKLRAlgebra k Γ ν₂)
    (x : (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule) :
    resIndStepMk S' hS (u • x) =
      resIndSubquotientMul hP hD hZ hΓ hW hL hν' hν₁ hS' hS u 1 (resIndStepMk S' hS x) :=
  rfl

theorem resIndStepMk_smul_right {S' S : Set (I → ℕ)} (hS' : IsLowerSet S') (hS : IsLowerSet S)
    (w : (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')ᵐᵒᵖ)
    (x : (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule) :
    resIndStepMk S' hS (w • x) =
      resIndSubquotientMul hP hD hZ hΓ hW hL hν' hν₁ hS' hS 1 w.unop (resIndStepMk S' hS x) :=
  rfl

theorem resIndStepMk_surjective (S' : Set (I → ℕ)) {S : Set (I → ℕ)} (hS : IsLowerSet S) :
    Function.Surjective (resIndStepMk (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW)
      (hL := hL) (hν' := hν') (hν₁ := hν₁) S' hS) := by
  intro q
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  let z' : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁ :=
    ⟨z.1, resIndFilt_mono hP hD hZ hΓ hW hL hν' hν₁ (Set.subset_univ S) z.2⟩
  exact ⟨⟨z', z.2⟩, rfl⟩

theorem resIndStepMk_eq_zero_iff (S' : Set (I → ℕ)) {S : Set (I → ℕ)} (hS : IsLowerSet S)
    (x : (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule) :
    resIndStepMk S' hS x = 0 ↔
      (x : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁).val ∈
        resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ S' := by
  rw [resIndStepMk_apply, Submodule.Quotient.mk_eq_zero]
  rfl

section PieceMap

variable {S' S : Set (I → ℕ)} (hS' : IsLowerSet S') (hS : IsLowerSet S)
  (L : ShuffleLayout ν' ν'' ν₁ ν₂)
  (f : MiddleTensor k Γ L.a L.b L.c L.d ≃ₗ[k] ResIndSubquotient k hP hD hZ hΓ hW hL hν' hν₁ S' S)
  (hf : ∀ zL zR, f.toLinearMap ∘ₗ middleCornerMap zL zR =
    resIndSubquotientMul hP hD hZ hΓ hW hL hν' hν₁ hS' hS
      (Algebra.TensorProduct.congr (castW k Γ L.hac) (castW k Γ L.hbd) zL)
      (Algebra.TensorProduct.congr (castW k Γ L.hab) (castW k Γ L.hcd) zR) ∘ₗ f.toLinearMap)

include hf in
theorem symm_resIndSubquotientMul_eq (zL zR)
    (q : ResIndSubquotient k hP hD hZ hΓ hW hL hν' hν₁ S' S) :
    f.symm (resIndSubquotientMul hP hD hZ hΓ hW hL hν' hν₁ hS' hS
      (Algebra.TensorProduct.congr (castW k Γ L.hac) (castW k Γ L.hbd) zL)
      (Algebra.TensorProduct.congr (castW k Γ L.hab) (castW k Γ L.hcd) zR) q) =
      middleCornerMap zL zR (f.symm q) := by
  rw [LinearEquiv.symm_apply_eq]
  have h := LinearMap.congr_fun (hf zL zR) (f.symm q)
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply] at h
  exact h.symm

/-- **The projection of a step of the chain onto its piece**: `S → S / S' ≃ ResIndPiece L`, a
`W_{ν₁} ⊗ W_{ν₂}`-linear map. -/
noncomputable def resIndPieceMap :
    (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule →ₗ[WeightedKLRAlgebra k Γ ν₁ ⊗[k]
        WeightedKLRAlgebra k Γ ν₂] ResIndPiece k Γ L where
  toFun x := f.symm (resIndStepMk S' hS x)
  map_add' x y := by
    change f.symm (resIndStepMk S' hS (x + y)) =
      f.symm (resIndStepMk S' hS x) + f.symm (resIndStepMk S' hS y)
    rw [map_add, map_add]
  map_smul' u x := by
    rw [RingHom.id_apply]
    change f.symm (resIndStepMk S' hS (u • x)) =
      middleCornerMap ((L.leftEquiv k Γ).symm u) 1 (f.symm (resIndStepMk S' hS x))
    rw [← symm_resIndSubquotientMul_eq hS' hS L f hf, map_one, resIndStepMk_smul_left hS' hS]
    exact congrArg (fun z => f.symm (resIndSubquotientMul hP hD hZ hΓ hW hL hν' hν₁ hS' hS z 1
      (resIndStepMk S' hS x))) ((L.leftEquiv k Γ).apply_symm_apply u).symm

theorem resIndPieceMap_apply
    (x : (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule) :
    resIndPieceMap hS' hS L f hf x = f.symm (resIndStepMk S' hS x) := rfl

theorem isBimoduleHom_resIndPieceMap :
    BalancedTensor.IsBimoduleHom (A := WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')
      (M := (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
        (hν' := hν') (hν₁ := hν₁) hS).toSubmodule) (M' := ResIndPiece k Γ L)
      (resIndPieceMap hS' hS L f hf) := by
  intro w x
  change f.symm (resIndStepMk S' hS (op w • x)) =
    middleCornerMap 1 ((L.rightEquiv k Γ).symm (op w).unop) (f.symm (resIndStepMk S' hS x))
  rw [← symm_resIndSubquotientMul_eq hS' hS L f hf, map_one, resIndStepMk_smul_right hS' hS]
  exact congrArg (fun z => f.symm (resIndSubquotientMul hP hD hZ hΓ hW hL hν' hν₁ hS' hS 1 z
    (resIndStepMk S' hS x))) ((L.rightEquiv k Γ).apply_symm_apply (op w).unop).symm

theorem resIndPieceMap_surjective : Function.Surjective (resIndPieceMap hS' hS L f hf) :=
  f.symm.surjective.comp (resIndStepMk_surjective S' hS)

theorem resIndPieceMap_eq_zero_iff
    (x : (resIndSubBimodule (hP := hP) (hD := hD) (hZ := hZ) (hΓ := hΓ) (hW := hW) (hL := hL)
      (hν' := hν') (hν₁ := hν₁) hS).toSubmodule) :
    resIndPieceMap hS' hS L f hf x = 0 ↔
      (x : ResIndBimodule k hP hD hZ hΓ hW hL hν' hν₁).val ∈
        resIndFilt k hP hD hZ hΓ hW hL hν' hν₁ S' := by
  rw [resIndPieceMap_apply, ← resIndStepMk_eq_zero_iff]
  exact f.symm.map_eq_zero_iff

end PieceMap

