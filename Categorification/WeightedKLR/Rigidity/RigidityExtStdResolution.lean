import Categorification.WeightedKLR.Rigidity.RigidityExtLevelCounit
import Categorification.WeightedKLR.RedStrands.Prop55DimensionFinite

/-!
# Resolutions by standardizations

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.1,
Proposition 7.8 and its proof. Let `X` be a finite-dimensional module over `T^λ` killed by the
loadings with a black strand right of the last red strand (as `L_λ` is). Then `X` has a
resolution `0 → M_N → ⋯ → M_1 → M_0 → X → 0`, `N = |ν|`, in which `M_n` is a finite direct sum of
standardizations of finite-dimensional modules over the factor algebras of the splits `θ + β`
with `|β| = n`, i.e. with last red strand at position `|ν| + ℓ - n`.

The resolution is given by its short exact sequences `0 → K_{n+1} → M_n → K_n → 0`, `K_0 = X`.
Given `K_n`, `M_n` is the sum over the splits at position `q = |ν| + ℓ - n` of the
standardizations of the restrictions of `K_n` to their layers, mapping to `K_n` by the counits.
The proof keeps two invariants: `K_n` is killed by the loadings whose last red strand is at a
position `> q`, and `Extʲ(K_n, ∇(t, u)) = 0` unless the position of `∇(t, u)` plus `j` is `q`.
The counit map is surjective because its cokernel has no maps into dual standard modules
(`subsingleton_of_forall_subsingleton_hom_starDual_standard`), and its kernel is killed at `q`
because the counits are injective on the vectors `e(s) m`.

Webster's printed proof takes `M_n` to be a sum of standard modules; the kernels `K_n` need not
have such covers, and `M_n` is taken here to be a sum of standardizations of arbitrary
finite-dimensional modules (the subcategory generated by the standard modules of that level).

## Main results

* `exists_stdCover`: the counit map from the standardizations at one position.
* `exists_stdChain`: the short exact sequences of the resolution, for a module satisfying the
  invariants.
* `exists_stdResolution`: **Proposition 7.8**, the resolution for every finite-dimensional
  module killed by the loadings without the last red strand at the end.
-/

noncomputable section
namespace Categorification

open CategoryTheory CategoryTheory.Abelian Limits

universe w

/-- `Ext` out of a finite product of modules vanishes when it vanishes out of each factor. -/
theorem subsingleton_ext_pi {R : Type} [Ring R] [HasExt.{w} (ModuleCat.{0} R)] {J : Type}
    [Fintype J] (X : J → ModuleCat.{0} R) (Y : ModuleCat.{0} R) (n : ℕ)
    (h : ∀ j, Subsingleton (Ext.{w} (X j) Y n)) :
    Subsingleton (Ext.{w} (ModuleCat.of R (∀ j, X j)) Y n) := by
  have := (Ext.biproductAddEquiv (biproduct.isBilimit X) Y n).toEquiv.subsingleton
  exact Ext.subsingleton_of_iso (ModuleCat.biproductIsoPi X).symm Y n this

namespace Stendhal

open KLR KLRAlgebra

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification
attribute [local instance] ModuleCat.moduleOfAlgebraModule
  ModuleCat.isScalarTower_of_algebra_moduleCat

variable {I : Type} {k : Type} [DecidableEq I] [Field k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin (ℓ + 1) → I →₀ ℕ} {ν : Multiset I}

local notation "T" => TensorProductAlgebra k Q Λ ν
local notation "σT" => (tensorFlipRingEquiv (Q := Q) (Λ := Λ) ν : T ≃+* Tᵐᵒᵖ)

/-! ### Positions of two-piece loadings -/

section Position

omit [DecidableEq I] in
theorem word_cast_twoPieceLoading {θ β : Multiset I} (h : θ + β = ν)
    (t : Seq (stendhalWeight ℓ θ)) (w : Seq β) :
    (Seq.cast (congrArg (stendhalWeight (ℓ + 1)) h) (twoPieceLoading θ β t w)).word =
      websterWord (t.word.map (addRedColor ℓ)) w.word 0 := by
  rw [Seq.word_cast, websterWord, pickIn_zero, pickOut_zero]
  simp only [Seq.word, List.reverse_nil, List.map_nil, List.append_nil]
  rw [ofFn_twoPieceLoading]
  simp

/-- The last red strand of `t λ_ℓ w` is at position `|θ| + ℓ`. -/
theorem lbl_cast_twoPieceLoading {θ β : Multiset I} (h : θ + β = ν)
    (t : Seq (stendhalWeight ℓ θ)) (w : Seq β)
    (a : Fin (Multiset.card (stendhalWeight (ℓ + 1) ν))) :
    (Seq.cast (congrArg (stendhalWeight (ℓ + 1)) h) (twoPieceLoading θ β t w)).lbl a =
      Sum.inr (Fin.last ℓ) ↔ a.val = Multiset.card θ + ℓ := by
  have hlen : (t.word.map (addRedColor ℓ)).length = Multiset.card θ + ℓ := by
    rw [List.length_map, Seq.length_word]; simp [stendhalWeight]
  have hmem : (Seq.cast (congrArg (stendhalWeight (ℓ + 1)) h) (twoPieceLoading θ β t w)).word ∈
      websterWords (t.word.map (addRedColor ℓ)) w.word 0 := by
    rw [websterWords, Multiset.powersetCard_zero_left, Multiset.map_singleton,
      word_cast_twoPieceLoading h]
    exact Multiset.mem_singleton_self _
  have hlt : Multiset.card θ + ℓ < Multiset.card (stendhalWeight (ℓ + 1) ν) := by
    subst h; simp [stendhalWeight]; omega
  constructor
  · intro ha
    have hb := lbl_of_word_eq_websterWord hmem ⟨_, hlt⟩ (by simp only [hlen]; rfl)
    exact congrArg Fin.val (lastRed_unique _ ha hb)
  · intro ha
    exact lbl_of_word_eq_websterWord hmem a (by rw [ha, hlen]; rfl)

variable (Q Λ)

/-- A module killed by the loadings whose last red strand is at a position `≥ ℓ` is zero: every
last red strand is at a position `≥ ℓ`. -/
theorem subsingleton_of_killedFrom {Y : ModuleCat.{0} T} (hY : KilledFrom Q Λ ℓ Y) :
    Subsingleton Y := by
  classical
  let S := {s : Seq (stendhalWeight (ℓ + 1) ν) // IsRedOrdered s}
  have hsum' : (∑ s : S, StendhalAlgebra.e s.1 s.2 : StendhalAlgebra k Q Λ ν) = 1 := by
    apply Subtype.ext
    rw [KLR.Corner.val_sum, KLR.Corner.val_one]
    change (∑ s : S, StendhalAlgebraAllOrders.e s.1) =
      StendhalAlgebraAllOrders.redOrderedIdem k Q Λ ν
    exact (Finset.sum_subtype _ (fun s => by simp) _).symm
  have hsum : ∑ s : S, loadingIdem Q Λ s.1 s.2 = 1 := by
    rw [← map_one (TensorProductAlgebra.mk Q Λ ν), ← hsum', map_sum]
  have hy : ∀ y : Y, y = 0 := fun y => by
    rw [← one_smul T y, ← hsum, Finset.sum_smul]
    refine Finset.sum_eq_zero fun s _ => ?_
    obtain ⟨s, hs⟩ := s
    obtain ⟨θ, β, h, t, w, ht, rfl⟩ := exists_twoPieceLoading_eq hs
    have hlt : Multiset.card θ + ℓ < Multiset.card (stendhalWeight (ℓ + 1) ν) := by
      subst h; simp [stendhalWeight]; omega
    exact hY _ hs ⟨_, hlt⟩ (by simp)
      ((lbl_cast_twoPieceLoading h t w ⟨_, hlt⟩).2 rfl) y
  exact ⟨fun a b => (hy a).trans (hy b).symm⟩

theorem KilledFrom.mono {p p' : ℕ} (hpp : p ≤ p') {Y : ModuleCat.{0} T}
    (h : KilledFrom Q Λ p Y) : KilledFrom Q Λ p' Y :=
  fun s hs a ha hr y => h s hs a (hpp.trans ha) hr y

theorem KilledFrom.killedAfter {p : ℕ} {Y : ModuleCat.{0} T} (h : KilledFrom Q Λ (p + 1) Y) :
    KilledAfter Q Λ p Y :=
  fun s hs a ha hr y => h s hs a ha hr y

theorem KilledFrom.of_killedAfter_of_killedAt {p : ℕ} {Y : ModuleCat.{0} T}
    (h₁ : KilledAfter Q Λ p Y) (h₂ : KilledAt Q Λ p Y) : KilledFrom Q Λ p Y := by
  intro s hs a ha hr y
  rcases ha.lt_or_eq with ha | ha
  · exact h₁ s hs a ha hr y
  · exact h₂ s hs a ha.symm hr y

end Position

/-! ### The counit map at one position -/

section Cover

variable (Q Λ) (hQ : KLRSymm Q) {C : QuantumGroup.CartanDatum I} (hR : IsRouquierQ C Q)

include hR in
/-- Standardizations of finite-dimensional modules are finite-dimensional. -/
theorem finiteDimensional_stdLayerModule (c : StdLayer Q Λ ν) [FiniteDimensional k c.M.carrier] :
    FiniteDimensional k (stdLayerModule Q Λ hQ c) := by
  obtain ⟨θ, β, h, M⟩ := c
  subst h
  have := finiteDimensional_parabolicStandard_of_finiteDimensional (Λ := Λ) hR hQ θ β M.carrier
  let e : ParabolicStandard Q Λ θ β M.carrier ≃ₗ[k] stdLayerModule Q Λ hQ ⟨θ, β, rfl, M⟩ :=
    { toFun := fun x => x
      invFun := fun x => x
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl
      map_smul' := fun c x =>
        (algebraMap_smul (TensorProductAlgebra k Q Λ (θ + β)) c
          (show ParabolicStandardT Q Λ θ β M.carrier hQ from x)).symm }
  exact Module.Finite.equiv e

/-- A direct sum of standardizations at the position `q`: finitely many standardizations of
finite-dimensional modules over the factor algebras of splits `θ + β` with `|θ| + ℓ = q`. -/
def StdSum (q : ℕ) (M : ModuleCat.{0} T) : Prop :=
  ∃ (J : Type) (_ : Fintype J) (c : J → StdLayer Q Λ ν),
    (∀ i, Multiset.card (c i).θ + ℓ = q) ∧ (∀ i, FiniteDimensional k (c i).M.carrier) ∧
      Nonempty (M ≅ ModuleCat.of T (∀ i, stdLayerModule Q Λ hQ (c i)))

/-- **The counit map at one position.** For `Z` finite-dimensional and killed after `q`, the sum
of the counits of the splits at position `q` is a map `ε : ⊕_c S_c(R_c Z) → Z` whose image
contains `e(s) Z`, and whose kernel is killed by `e(s)`, for every loading `s` with last red
strand at `q`. -/
theorem exists_stdCover (Z : ModuleCat.{0} T) [FiniteDimensional k Z] (q : ℕ)
    (hZ : KilledAfter Q Λ q Z) :
    ∃ (J : Type) (_ : Fintype J) (c : J → StdLayer Q Λ ν)
      (_ : ∀ i, Multiset.card (c i).θ + ℓ = q) (_ : ∀ i, FiniteDimensional k (c i).M.carrier)
      (ε : (∀ i, stdLayerModule Q Λ hQ (c i)) →ₗ[T] Z),
      (∀ (s : Seq (stendhalWeight (ℓ + 1) ν)) (hs : IsRedOrdered s)
        (a : Fin (Multiset.card (stendhalWeight (ℓ + 1) ν))), a.val = q →
        s.lbl a = Sum.inr (Fin.last ℓ) → ∀ z : Z, loadingIdem Q Λ s hs • z ∈ LinearMap.range ε) ∧
      (∀ (s : Seq (stendhalWeight (ℓ + 1) ν)) (hs : IsRedOrdered s)
        (a : Fin (Multiset.card (stendhalWeight (ℓ + 1) ν))), a.val = q →
        s.lbl a = Sum.inr (Fin.last ℓ) → ∀ m, ε m = 0 → loadingIdem Q Λ s hs • m = 0) := by
  classical
  let F : Finset (Multiset I) := ν.powerset.toFinset.filter fun θ => Multiset.card θ + ℓ = q
  let J := {θ // θ ∈ F}
  have hle : ∀ i : J, i.1 ≤ ν := fun i =>
    Multiset.mem_powerset.1 (Multiset.mem_toFinset.1 (Finset.mem_filter.1 i.2).1)
  have hq : ∀ i : J, Multiset.card i.1 + ℓ = q := fun i => (Finset.mem_filter.1 i.2).2
  have hh : ∀ i : J, i.1 + (ν - i.1) = ν := fun i => add_tsub_cancel_of_le (hle i)
  have hK : ∀ i : J, KilledAfter Q Λ (Multiset.card i.1 + ℓ) Z := fun i => by
    rw [hq i]; exact hZ
  choose N hN ε hε using fun i : J => exists_levelCounit Q Λ hQ (hh i) Z (hK i)
  let c : J → StdLayer Q Λ ν := fun i => ⟨i.1, ν - i.1, hh i, N i⟩
  let εt : (∀ i, stdLayerModule Q Λ hQ (c i)) →ₗ[T] Z := ∑ i, (ε i).comp (LinearMap.proj i)
  have hεt : ∀ (i₀ : J) (x : ∀ i, stdLayerModule Q Λ hQ (c i)), (∀ i, i ≠ i₀ → x i = 0) →
      εt x = ε i₀ (x i₀) := by
    intro i₀ x hx
    rw [LinearMap.sum_apply, Finset.sum_eq_single i₀ (fun i _ hi => by
      rw [LinearMap.comp_apply, LinearMap.proj_apply, hx i hi, map_zero]) (by simp)]
    rfl
  -- The split of a loading with last red strand at `q`.
  have hsplit : ∀ (s : Seq (stendhalWeight (ℓ + 1) ν)) (hs : IsRedOrdered s)
      (a : Fin (Multiset.card (stendhalWeight (ℓ + 1) ν))), a.val = q →
      s.lbl a = Sum.inr (Fin.last ℓ) → ∃ (θ' β' : Multiset I) (h' : θ' + β' = ν)
        (t : Seq (stendhalWeight ℓ θ')) (w : Seq β') (ht : IsRedOrdered t)
        (hθ : θ' ∈ F), Seq.cast (congrArg (stendhalWeight (ℓ + 1)) h')
          (twoPieceLoading θ' β' t w) = s := by
    intro s hs a ha hr
    obtain ⟨θ', β', h', t, w, ht, rfl⟩ := exists_twoPieceLoading_eq hs
    have hpos := (lbl_cast_twoPieceLoading h' t w a).1 hr
    refine ⟨θ', β', h', t, w, ht, Finset.mem_filter.2 ⟨Multiset.mem_toFinset.2
      (Multiset.mem_powerset.2 (h' ▸ Multiset.le_add_right θ' β')), by omega⟩, rfl⟩
  refine ⟨J, inferInstance, c, hq, hN, εt, ?_, ?_⟩
  · intro s hs a ha hr z
    obtain ⟨θ', β', h', t, w, ht, hθ, rfl⟩ := hsplit s hs a ha hr
    obtain ⟨m, hm⟩ := (hε ⟨θ', hθ⟩ β' h' t ht w hs).1 z
    refine ⟨Pi.single (⟨θ', hθ⟩ : J) m, ?_⟩
    rw [hεt ⟨θ', hθ⟩ _ (fun i hi => Pi.single_eq_of_ne hi _), Pi.single_eq_same]
    exact hm
  · intro s hs a ha hr m hm
    obtain ⟨θ', β', h', t, w, ht, hθ, rfl⟩ := hsplit s hs a ha hr
    let i₀ : J := ⟨θ', hθ⟩
    have hoff : ∀ i, i ≠ i₀ → (loadingIdem Q Λ _ hs • m) i = 0 := by
      intro i hi
      refine loadingIdem_smul_stdLayerModule_eq_zero Q Λ hQ (c i) h' (fun hle' => hi ?_) ht w
        hs (m i)
      refine Subtype.ext (Multiset.eq_of_le_of_card_le hle' ?_).symm
      have := hq i
      have := (Finset.mem_filter.1 hθ).2
      change Multiset.card i.1 ≤ Multiset.card θ'
      omega
    have h0 : ε i₀ ((loadingIdem Q Λ _ hs • m) i₀) = 0 := by
      rw [← hεt i₀ _ hoff, LinearMap.map_smul, hm, smul_zero]
    funext i
    by_cases hi : i = i₀
    · subst hi
      exact (hε i₀ β' h' t ht w hs).2 (m i₀) h0
    · exact hoff i hi

end Cover

/-! ### The resolution -/

section Chain

variable (Q Λ) (hQ : KLRSymm Q) {C : QuantumGroup.CartanDatum I} (hR : IsRouquierQ C Q)
  (hall : AllFiniteDeltaInjective Q Λ hQ)
  [HasExt.{w} (ModuleCat.{0} (TensorProductAlgebra k Q Λ ν))]

/-- `Extʲ(K, ∇(t, u))` vanishes unless the position `|θ'| + ℓ` of `∇(t, u)` plus `j` is
`p - 1`. -/
def ExtDualStdBelow (p : ℕ) (K : ModuleCat.{0} T) : Prop :=
  ∀ (θ' : Multiset I) (t : Seq (stendhalWeight ℓ θ')) (ht : IsRedOrdered t) (u : List I)
    (h : θ' + wordWt u 0 = ν) (j : ℕ), Multiset.card θ' + ℓ + j + 1 ≠ p →
    Subsingleton (Ext.{w} K (starDualObj k σT
      (tensorStd Q Λ hQ h (oldProj Q Λ θ' t ht) (cycWord Q Λ u))) j)

include hR hall in
/-- Maps into a dual standard module of position `q` vanish on a module killed at `q`. -/
theorem subsingleton_hom_starDual_standard_of_killedAt {K : ModuleCat.{0} T} {q : ℕ}
    (hK : KilledAt Q Λ q K) {θ' : Multiset I} (t : Seq (stendhalWeight ℓ θ'))
    (ht : IsRedOrdered t) (u : List I) (h : θ' + wordWt u 0 = ν)
    (hp : Multiset.card θ' + ℓ = q) :
    Subsingleton (Ext.{w} K (starDualObj k σT
      (tensorStd Q Λ hQ h (oldProj Q Λ θ' t ht) (cycWord Q Λ u))) 0) := by
  have hlen : (t.word.map (addRedColor ℓ)).length = Multiset.card θ' + ℓ := by
    rw [List.length_map, Seq.length_word]; simp [stendhalWeight]
  refine subsingleton_ext_starDual_standard_of_killed Q Λ hQ hR hall t ht u h K 0 ?_
  intro s hs hmem
  have hlt : (t.word.map (addRedColor ℓ)).length + 0 <
      Multiset.card (stendhalWeight (ℓ + 1) ν) := by
    obtain ⟨Tm, hT, hw⟩ := Multiset.mem_map.1 hmem
    have hlen' := congrArg List.length hw
    rw [Seq.length_word] at hlen'
    rw [← hlen', websterWord]
    simp
  exact hK s hs ⟨_, hlt⟩ (by simp only [hlen]; omega) (lbl_of_word_eq_websterWord hmem _ rfl)

include hR hall in
/-- `Extʲ(S_c(N), ∇(t, u)) = 0` for a standardization at position `q` unless `∇(t, u)` is at
position `q` and `j = 0`. -/
theorem subsingleton_ext_stdLayer_starDual_standard_of_ne (c : StdLayer Q Λ ν)
    [FiniteDimensional k c.M.carrier] {θ' : Multiset I} (t : Seq (stendhalWeight ℓ θ'))
    (ht : IsRedOrdered t) (u : List I) (h : θ' + wordWt u 0 = ν) (j : ℕ)
    (hj : ¬ (Multiset.card θ' = Multiset.card c.θ ∧ j = 0)) :
    Subsingleton (Ext.{w} (stdLayerModule Q Λ hQ c) (starDualObj k σT
      (tensorStd Q Λ hQ h (oldProj Q Λ θ' t ht) (cycWord Q Λ u))) j) := by
  obtain ⟨θ, β, hc, N⟩ := c
  simp only at hj ⊢
  rcases Nat.lt_or_ge (Multiset.card θ') (Multiset.card θ) with hlt | hge
  · have hY := ((killedAfter_stdLayerModule Q Λ hQ
      (tensorLayer Q Λ h (oldProj Q Λ θ' t ht) (cycWord Q Λ u))).starDual).killedFrom
    exact subsingleton_ext_stdLayer_of_killedFrom Q Λ hQ hR hall hc
      (KilledFrom.mono Q Λ (by simp only [tensorLayer] at hY ⊢; omega) hY) j N
  · exact subsingleton_ext_stdLayer_starDual_standard Q Λ hQ hR hall ⟨θ, β, hc, N⟩ t ht u h j
      (by simp only; omega)

include hR hall in
/-- **The resolution by standardizations, as short exact sequences.** Let `K` be
finite-dimensional, killed by the loadings whose last red strand is at a position `≥ ℓ + r`,
with `Extʲ(K, ∇(t, u)) = 0` unless the position of `∇(t, u)` plus `j` is `ℓ + r - 1`. Then there
are short exact sequences `0 → K_{n+1} → M_n → K_n → 0` with `K_0 = K`, `M_n` a sum of
standardizations at position `ℓ + r - 1 - n` for `n < r`, and `M_n = 0` for `n ≥ r`. -/
theorem exists_stdChain (r : ℕ) : ∀ (K : ModuleCat.{0} T) [FiniteDimensional k K],
    KilledFrom Q Λ (ℓ + r) K → ExtDualStdBelow Q Λ hQ (ℓ + r) K →
    ∃ S : ℕ → ShortComplex (ModuleCat.{0} T), Nonempty ((S 0).X₃ ≅ K) ∧
      (∀ n, Nonempty ((S (n + 1)).X₃ ≅ (S n).X₁)) ∧ (∀ n, (S n).ShortExact) ∧
      (∀ n < r, StdSum Q Λ hQ (ℓ + r - 1 - n) (S n).X₂) ∧ ∀ n, r ≤ n → IsZero (S n).X₂ := by
  induction r with
  | zero =>
    intro K _ hK _
    have : Subsingleton K := subsingleton_of_killedFrom Q Λ (by simpa using hK)
    have hz : IsZero K := ModuleCat.isZero_of_subsingleton K
    refine ⟨fun _ => ShortComplex.mk (0 : K ⟶ K) (0 : K ⟶ K) (by simp),
      ⟨Iso.refl _⟩, fun _ => ⟨Iso.refl _⟩, fun _ => ?_, fun n hn => absurd hn (by omega),
      fun _ _ => hz⟩
    exact ShortComplex.ShortExact.mk' (ShortComplex.exact_of_isZero_X₂ _ hz)
      ((ModuleCat.mono_iff_injective _).mpr fun a b _ => Subsingleton.elim a b)
      ((ModuleCat.epi_iff_surjective _).mpr fun y => ⟨y, Subsingleton.elim _ _⟩)
  | succ r ih =>
    intro K _ hK hext
    set q := ℓ + r with hq
    have hKa : KilledAfter Q Λ q K := hK.killedAfter
    obtain ⟨J, _, c, hc, hfd, ε, hcov, hinj⟩ := exists_stdCover Q Λ hQ K q hKa
    have : ∀ i, FiniteDimensional k (stdLayerModule Q Λ hQ (c i)) := fun i =>
      finiteDimensional_stdLayerModule Q Λ hQ hR (c i)
    let M : ModuleCat.{0} T := ModuleCat.of T (∀ i, stdLayerModule Q Λ hQ (c i))
    have hMfd : FiniteDimensional k M :=
      inferInstanceAs (FiniteDimensional k (∀ i, stdLayerModule Q Λ hQ (c i)))
    -- `M` is killed after `q`.
    have hMa : KilledAfter Q Λ q M := by
      intro s hs a ha hr m
      funext i
      exact killedAfter_stdLayerModule Q Λ hQ (c i) s hs a (by rw [hc i]; exact ha) hr (m i)
    -- The counit map is surjective.
    have hsurj : Function.Surjective ε := by
      let Cq : ModuleCat.{0} T := ModuleCat.of T (K ⧸ LinearMap.range ε)
      let π : K ⟶ Cq := ModuleCat.ofHom (LinearMap.range ε).mkQ
      have hπ : Function.Surjective π.hom := Submodule.mkQ_surjective _
      have hCq : Subsingleton Cq := by
        refine subsingleton_of_forall_subsingleton_hom_starDual_standard Q Λ hQ hR hall Cq
          fun θ' t ht u h => ⟨fun g g' => ?_⟩
        have hcomp : ∀ g'' : Cq ⟶ starDualObj k σT
            (tensorStd Q Λ hQ h (oldProj Q Λ θ' t ht) (cycWord Q Λ u)),
            π ≫ g'' = 0 → g'' = 0 := fun g'' h0 => by
          refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
          obtain ⟨y, rfl⟩ := hπ x
          exact congrArg (fun f => f.hom y) h0
        by_cases hp : Multiset.card θ' + ℓ = q
        · -- `Cq` is killed at `q`.
          have hCk : KilledAt Q Λ q Cq := by
            intro s hs a ha hr x
            obtain ⟨y, rfl⟩ := hπ x
            change (LinearMap.range ε).mkQ (loadingIdem Q Λ s hs • y) = 0
            exact (Submodule.Quotient.mk_eq_zero _).2 (hcov s hs a ha hr y)
          have := subsingleton_hom_starDual_standard_of_killedAt Q Λ hQ hR hall hCk t ht u h hp
          exact (Ext.homEquiv₀.symm.subsingleton).elim g g'
        · have := hext θ' t ht u h 0 (by omega)
          have hK0 := (Ext.homEquiv₀ (X := K) (Y := starDualObj k σT
            (tensorStd Q Λ hQ h (oldProj Q Λ θ' t ht) (cycWord Q Λ u)))).symm.subsingleton
          rw [hcomp g (Subsingleton.elim _ _), hcomp g' (Subsingleton.elim _ _)]
      intro z
      have : (LinearMap.range ε).mkQ z = 0 := Subsingleton.elim (α := Cq) _ _
      exact (Submodule.Quotient.mk_eq_zero _).1 this
    -- The kernel.
    let K' : ModuleCat.{0} T := ModuleCat.of T (LinearMap.ker ε)
    have hK'fd : FiniteDimensional k K' :=
      Module.Finite.of_injective ((LinearMap.ker ε).subtype.restrictScalars k)
        Subtype.val_injective
    let S₀ : ShortComplex (ModuleCat.{0} T) :=
      ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker ε).subtype : K' ⟶ M) (ModuleCat.ofHom ε)
        (by ext x; exact x.2)
    have hS₀ : S₀.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
        exact LinearMap.exact_subtype_ker_map ε
      · exact (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
      · exact (ModuleCat.epi_iff_surjective _).mpr hsurj
    have hK'a : KilledAfter Q Λ q K' := fun s hs a ha hr x =>
      Subtype.ext (hMa s hs a ha hr x.1)
    have hK't : KilledAt Q Λ q K' := fun s hs a ha hr x =>
      Subtype.ext (hinj s hs a ha hr x.1 x.2)
    have hK'k : KilledFrom Q Λ (ℓ + r) K' := KilledFrom.of_killedAfter_of_killedAt Q Λ hK'a hK't
    have hK'e : ExtDualStdBelow Q Λ hQ (ℓ + r) K' := by
      intro θ' t ht u h j hj
      by_cases h0 : Multiset.card θ' + ℓ = q ∧ j = 0
      · obtain ⟨hp, rfl⟩ := h0
        exact subsingleton_hom_starDual_standard_of_killedAt Q Λ hQ hR hall hK't t ht u h hp
      · have h1 := hext θ' t ht u h (1 + j) (by omega)
        have h2 : Subsingleton (Ext.{w} M (starDualObj k σT
            (tensorStd Q Λ hQ h (oldProj Q Λ θ' t ht) (cycWord Q Λ u))) j) :=
          subsingleton_ext_pi _ _ j fun i =>
            subsingleton_ext_stdLayer_starDual_standard_of_ne Q Λ hQ hR hall (c i) t ht u h j
              (fun h3 => h0 ⟨by have := hc i; omega, h3.2⟩)
        exact Ext.subsingleton_X₁_of_X₃ hS₀ _ j
    obtain ⟨S, hS0, hSs, hSe, hSstd, hSz⟩ := ih K' hK'k hK'e
    refine ⟨fun n => Nat.casesOn n S₀ S, ⟨Iso.refl _⟩, fun n => ?_, fun n => ?_, fun n hn => ?_,
      fun n hn => ?_⟩
    · cases n with
      | zero => exact hS0
      | succ n => exact hSs n
    · cases n with
      | zero => exact hS₀
      | succ n => exact hSe n
    · cases n with
      | zero => exact ⟨J, inferInstance, c, fun i => by rw [hc i]; omega, hfd, ⟨Iso.refl _⟩⟩
      | succ n =>
        have := hSstd n (by omega)
        rwa [show ℓ + (r + 1) - 1 - (n + 1) = ℓ + r - 1 - n by omega]
    · cases n with
      | zero => omega
      | succ n => exact hSz n (by omega)

include hR hall in
/-- **Proposition 7.8** (Webster, arXiv:1309.3796v3, §7.1), ungraded, in the repaired reading.
Let `X` be finite-dimensional and killed by every loading idempotent `e(s)` with a black strand
right of the last red strand (as `L_λ` is). Then `X` has a resolution
`0 → M_N → ⋯ → M_1 → M_0 → X → 0`, `N = |ν|`, given by short exact sequences
`0 → K_{n+1} → M_n → K_n → 0` with `K_0 = X`, in which `M_n` is a finite sum of standardizations
of finite-dimensional modules over the factor algebras of the splits with `n` black strands right
of the last red strand (last red strand at position `|ν| + ℓ - n`), and `M_n = 0` for `n > N`.

Webster states that `M_n` lies in the subcategory generated by the standard modules
`S^{κ_n}_i`; the proof here takes `M_n` to be a sum of standardizations of arbitrary
finite-dimensional factor modules, which lie in that subcategory. Under the route hypothesis
`hall` of Proposition 7.6. The second clause, `M_N ≅ M_λ` for `X = L_λ`, is not part of this
statement. -/
theorem exists_stdResolution (X : ModuleCat.{0} T) [FiniteDimensional k X]
    (hX : ∀ (s : Seq (stendhalWeight (ℓ + 1) ν)) (hs : IsRedOrdered s), ¬HasLastRed s →
      ∀ x : X, loadingIdem Q Λ s hs • x = 0) :
    ∃ S : ℕ → ShortComplex (ModuleCat.{0} T), Nonempty ((S 0).X₃ ≅ X) ∧
      (∀ n, Nonempty ((S (n + 1)).X₃ ≅ (S n).X₁)) ∧ (∀ n, (S n).ShortExact) ∧
      (∀ n ≤ Multiset.card ν, StdSum Q Λ hQ (Multiset.card ν + ℓ - n) (S n).X₂) ∧
      ∀ n, Multiset.card ν < n → IsZero (S n).X₂ := by
  have hcard : Multiset.card (stendhalWeight (ℓ + 1) ν) = Multiset.card ν + ℓ + 1 := by
    simp [stendhalWeight]; omega
  have hK : KilledFrom Q Λ (ℓ + (Multiset.card ν + 1)) X := fun s hs a ha => by
    have := a.2
    omega
  have hE : ExtDualStdBelow Q Λ hQ (ℓ + (Multiset.card ν + 1)) X := by
    intro θ' t ht u h j hj
    have hc := congrArg Multiset.card h
    rw [← coe_reverse_eq_wordWt, Multiset.card_add, Multiset.coe_card, List.length_reverse] at hc
    exact subsingleton_ext_starDual_standard Q Λ hQ hR hall t ht u h X hX j (by omega)
  obtain ⟨S, h0, hs, he, hstd, hz⟩ := exists_stdChain Q Λ hQ hR hall _ X hK hE
  refine ⟨S, h0, hs, he, fun n hn => ?_, fun n hn => hz n (by omega)⟩
  have := hstd n (by omega)
  rwa [show ℓ + (Multiset.card ν + 1) - 1 - n = Multiset.card ν + ℓ - n by omega] at this

end Chain

end Stendhal

end Categorification
