import Categorification.KLR.Simple
import Categorification.KLR.Cyclotomic

/-!
# Cyclotomic quotients of large level

The cyclotomic ideal of `R(ν)` for the weight `Λ` is generated by the `x_1^{⟨α_{i_1}^∨, Λ⟩} e(𝐢)`,
of degree `⟨α_{i_1}^∨, Λ⟩ deg x_{i_1}`. If `R(ν)` is bounded below and dots have positive degree,
a nonzero element of `R(ν)` survives in `R^Λ(ν)` once `Λ` is large
(`KLRAlgebra.exists_cycKLR_mk_ne_zero`). This is used in the comparison of `T̃^λ` with
`T^{(λ₀, λ)}` for large `λ₀` (B. Webster, *Knot invariants and higher representation theory*,
arXiv:1309.3796v3, proof of Proposition 5.26).

## Main results

* `Graded.decompose_eq_zero_of_mem_span`: a two-sided ideal generated by homogeneous elements of
  degree above `n + 2c` has no component in degree `n` when the grading vanishes below `-c`.
* `KLRAlgebra.exists_cycKLR_mk_ne_zero`.
-/

namespace Categorification.Graded

open DirectSum

variable {k A : Type*} [CommRing k] [Ring A] [Algebra k A] (𝒜 : ℤ → Submodule k A)
  [GradedAlgebra 𝒜]

/-- A two-sided ideal generated by homogeneous elements of degree above `n + 2c` has no
component in degree `n` when the grading vanishes below `-c`. -/
theorem decompose_eq_zero_of_mem_span {c n : ℤ} (hc : ∀ m < -c, 𝒜 m = ⊥) {S : Set A}
    (hS : ∀ s ∈ S, ∃ d, n + 2 * c < d ∧ s ∈ 𝒜 d) {x : A} (hx : x ∈ TwoSidedIdeal.span S) :
    (decompose 𝒜 x n : A) = 0 := by
  classical
  let P : A →+ A := GradedRing.proj 𝒜 n
  let K : TwoSidedIdeal A := TwoSidedIdeal.mk' {y | ∀ a b : A, P (a * y * b) = 0}
    (fun a b => by simp)
    (fun {y z} hy hz a b => by simp only [mul_add, add_mul, map_add, hy a b, hz a b, add_zero])
    (fun {y} hy a b => by simp only [mul_neg, neg_mul, map_neg, hy a b, neg_zero])
    (fun {y z} hz a b => by simpa only [mul_assoc] using hz (a * y) b)
    (fun {y z} hy a b => by simpa only [mul_assoc] using hy a (z * b))
  have hle : TwoSidedIdeal.span S ≤ K := by
    apply TwoSidedIdeal.span_le.mpr
    intro s hs a b
    obtain ⟨d, hd, hsd⟩ := hS s hs
    change P (a * (s - 0) * b) = 0
    rw [sub_zero, ← sum_support_decompose 𝒜 a, ← sum_support_decompose 𝒜 b, Finset.sum_mul,
      Finset.sum_mul, map_sum]
    refine Finset.sum_eq_zero fun p _ => ?_
    rw [Finset.mul_sum, map_sum]
    refine Finset.sum_eq_zero fun q _ => ?_
    have hmem : (decompose 𝒜 a p : A) * s * (decompose 𝒜 b q : A) ∈ 𝒜 (p + d + q) :=
      SetLike.GradedMul.mul_mem (SetLike.GradedMul.mul_mem (decompose 𝒜 a p).2 hsd)
        (decompose 𝒜 b q).2
    change (decompose 𝒜 _ n : A) = 0
    have hvan (r : A) (m : ℤ) (hm : m < -c) : (decompose 𝒜 r m : A) = 0 := by
      have h := (decompose 𝒜 r m).2
      simp only [hc m hm, Submodule.mem_bot] at h
      exact h
    by_cases hpq : p + d + q = n
    · by_cases hp : p < -c
      · rw [hvan a p hp]
        simp
      · rw [hvan b q (by omega)]
        simp
    · exact decompose_of_mem_ne 𝒜 hmem hpq
  have h := hle hx 1 1
  rw [one_mul, mul_one, sub_zero] at h
  exact h

end Categorification.Graded

namespace Categorification.KLR.KLRAlgebra

open Polynomial DirectSum

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {Q : I → I → MvPolynomial (Fin 2) k}
  {ν : Multiset I}

theorem x_pow_mul_e_mem_grade (G : GradingDatum Q) (s : Seq ν) (a : Fin (Multiset.card ν))
    (n : ℕ) : (x a ^ n * e s : KLRAlgebra k Q ν) ∈ G.grade ν (n * G.degX (s.lbl a)) := by
  induction n with
  | zero => simpa using G.e_mem_grade s
  | succ n ih =>
    have h : (x a ^ (n + 1) * e s : KLRAlgebra k Q ν) = (x a * e s) * (x a ^ n * e s) := by
      have hc : Commute (e s : KLRAlgebra k Q ν) (x a ^ n) :=
        Commute.pow_right (show Commute (e s : KLRAlgebra k Q ν) (x a) from (x_mul_e a s).symm) n
      rw [mul_assoc, ← mul_assoc (e s), hc.eq, mul_assoc, e_mul_e]
      simp [pow_succ', mul_assoc]
    rw [h, show ((n + 1 : ℕ) : ℤ) * G.degX (s.lbl a) = G.degX (s.lbl a) +
      n * G.degX (s.lbl a) by push_cast; ring]
    exact SetLike.GradedMul.mul_mem (G.x_mul_e_mem_grade a s) ih

/-- **A nonzero element survives in cyclotomic quotients of large level**: if dots have positive
degree, for every nonzero `u ∈ R(ν)` there is `N` such that `u` is nonzero in `R^Λ(ν)` whenever
`⟨α_i^∨, Λ⟩ ≥ N` for every label `i` of `ν`. -/
theorem exists_cycKLR_mk_ne_zero {k : Type*} [Field k] {Q : I → I → MvPolynomial (Fin 2) k}
    (G : GradingDatum Q) (hG : ∀ a, 0 < G.degX a)
    {u : KLRAlgebra k Q ν} (hu : u ≠ 0) :
    ∃ N : ℕ, ∀ l : I → ℕ, (∀ i ∈ ν, N ≤ l i) → CycKLR.mk k Q (fun i => X ^ l i) ν u ≠ 0 := by
  classical
  obtain ⟨N₀, hN₀⟩ := exists_grade_eq_bot G (ν := ν) fun a => (hG a).le
  let D := (decompose (G.grade ν) u).support
  let N : ℕ := (∑ d ∈ D, d.natAbs) + 2 * N₀.natAbs + 1
  refine ⟨N, fun l hl hmk => hu ?_⟩
  rw [CycKLR.mk_eq_zero_iff] at hmk
  have hcomp : ∀ n, (decompose (G.grade ν) u n : KLRAlgebra k Q ν) = 0 := by
    intro n
    by_cases hn : n ∈ D
    · refine Graded.decompose_eq_zero_of_mem_span (G.grade ν) (c := -N₀)
        (fun m hm => hN₀ m (by omega)) ?_ hmk
      rintro _ ⟨i, rfl⟩
      by_cases h0 : 0 < Multiset.card ν
      · refine ⟨l (i.lbl ⟨0, h0⟩) * G.degX (i.lbl ⟨0, h0⟩), ?_, ?_⟩
        · have hmem : i.lbl ⟨0, h0⟩ ∈ ν := by
            have hm := Multiset.mem_map_of_mem i.1 (Finset.mem_univ_val (⟨0, h0⟩ : Fin _))
            rw [i.2] at hm
            exact hm
          have h1 := hl _ hmem
          have h2 := hG (i.lbl ⟨0, h0⟩)
          have h3 : n ≤ ∑ d ∈ D, (d.natAbs : ℤ) :=
            (Int.le_natAbs).trans (Finset.single_le_sum (f := fun d : ℤ => (d.natAbs : ℤ))
              (fun _ _ => Int.natCast_nonneg _) hn)
          have h4 : (N : ℤ) ≤ l (i.lbl ⟨0, h0⟩) := by exact_mod_cast h1
          have h5 : (l (i.lbl ⟨0, h0⟩) : ℤ) ≤ l (i.lbl ⟨0, h0⟩) * G.degX (i.lbl ⟨0, h0⟩) :=
            le_mul_of_one_le_right (Int.natCast_nonneg _) h2
          have h6 : (N : ℤ) = (∑ d ∈ D, (d.natAbs : ℤ)) + 2 * N₀.natAbs + 1 := by
            simp [N]
          have h7 : -N₀ ≤ (N₀.natAbs : ℤ) := by omega
          omega
        · rw [cycElt_of_pos _ _ _ h0, map_pow, aeval_X]
          exact x_pow_mul_e_mem_grade G i ⟨0, h0⟩ _
      · refine ⟨n + 2 * -N₀ + 1, by omega, ?_⟩
        simp only [cycElt, h0, ↓reduceDIte]
        exact zero_mem _
    · have h := (DFinsupp.notMem_support_iff
        (f := (decompose (G.grade ν) u : ⨁ n, G.grade ν n))).1 hn
      exact congrArg Subtype.val h
  have hdec : decompose (G.grade ν) u = 0 := DFinsupp.ext fun n => Subtype.ext (hcomp n)
  rw [← (decompose (G.grade ν)).symm_apply_apply u, hdec, decompose_symm_zero]

end Categorification.KLR.KLRAlgebra
