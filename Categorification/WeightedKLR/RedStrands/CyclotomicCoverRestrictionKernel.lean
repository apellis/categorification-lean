import Categorification.WeightedKLR.RedStrands.CyclotomicCoverDotRestriction
import Categorification.WeightedKLR.RedStrands.CyclotomicCoverQuotient
import Categorification.WeightedKLR.RedStrands.CyclotomicCoverTower
import Categorification.WeightedKLR.RedStrands.CyclotomicRestrictionWords
import Categorification.KLR.CyclotomicAction.Induction

/-!
# The kernel of the cyclotomic restriction map

For Webster, arXiv:1309.3796v2, Theorem 4.31 and Lemma 4.35, the upper
red-dot and unordered relations on the terminal-black restriction cut
are generated by the lower quotient ideal.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra KLRAlgebra.AbsentColour MvPolynomial QuantumGroup

variable {I k : Type*} [DecidableEq I] [Field k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k}
  (Λ : Fin ℓ → I →₀ ℕ) (ν : Multiset I) (C : CartanDatum I) (i : I)

local notation "D" => I ⊕ Fin ℓ
local notation "p" => cyclotomicCoverPolynomial (I := I) (ℓ := ℓ) (k := k)
local notation "S" => cyclotomicCoverQ C Λ Q
local notation "μ" => stendhalWeight ℓ ν
local notation "σ" => (Singleton.singleton (Sum.inl i) : Multiset D)
local notation "A" => CycKLR k S p μ
local notation "B" => CycKLR k S p (σ + μ)
local notation "J" => cyclotomicCoverIdeal (k := k) ν S
local notation "W" => Res S (Sum.inl i) p μ B

private theorem coverIdeal_cast {δ : Multiset D} {ν' : Multiset I}
    (h : δ = stendhalWeight ℓ ν') (b : CycKLR k S p δ)
    (hb : CyclotomicAction.castCyc S p h b ∈ cyclotomicCoverIdeal (k := k) ν' S) :
    b ∈ TwoSidedIdeal.span
      ({z | ∃ (s : KLR.Seq δ) (a : Fin δ.card), (s.lbl a).isRight ∧
        z = CycKLR.mk k S p δ (x a * e s)} ∪
       {z | ∃ s : KLR.Seq δ, ¬ IsRedOrdered s ∧ z = CycKLR.mk k S p δ (e s)}) := by
  subst δ
  exact hb

omit [DecidableEq I] in
private theorem red_exists {ν' : Multiset I} (r : Fin ℓ) (s : KLR.Seq (stendhalWeight ℓ ν')) :
    ∃ a, s.lbl a = Sum.inr r := by
  have h : (Sum.inr r : D) ∈ stendhalWeight ℓ ν' := by simp [stendhalWeight]
  rw [← s.2] at h
  obtain ⟨a, _, ha⟩ := Multiset.mem_map.mp h
  exact ⟨a, ha⟩

private theorem red_unique {δ : Multiset D} {ν' : Multiset I}
    (h : δ = stendhalWeight ℓ ν') (r : Fin ℓ) (s : KLR.Seq δ)
    (a b : Fin δ.card) (ha : s.lbl a = Sum.inr r) (hb : s.lbl b = Sum.inr r) : a = b := by
  subst δ
  have hred : Multiset.count (Sum.inr r : D) (ν'.map Sum.inl) = 0 := by
    apply Multiset.count_eq_zero_of_notMem
    simp
  have hcnt : Multiset.count (Sum.inr r : D) (stendhalWeight ℓ ν') ≤ 1 := by
    rw [stendhalWeight, Multiset.count_add, hred, zero_add]
    exact Multiset.nodup_iff_count_le_one.mp
      (Finset.univ.nodup.map Sum.inr_injective) _
  have hcard : (Finset.univ.filter (fun a => Sum.inr r = s.lbl a)).card ≤ 1 := by
    rw [← s.2, Multiset.count_map] at hcnt
    exact hcnt
  exact Finset.card_le_one_iff.mp hcard (by simp [ha]) (by simp [hb])

omit [DecidableEq I] in
private theorem factor_parameters {T : D → D → MvPolynomial (Fin 2) k}
    {E : CartanDatum D} (hT : IsRouquierQ E T) :
    ∃ P : D → D → MvPolynomial (Fin 2) k,
      (∀ a b, a ≠ b → T a b = P b a * rename ![1, 0] (P a b)) ∧
      (∀ a b, a ≠ b → P a b ≠ 0) := by
  classical
  let P (a b : D) := if univLt b a then T b a else 1
  refine ⟨P, ?_, ?_⟩
  · intro a b hab
    rcases univLt_total hab with h | h
    · simp [P, h, univLt_asymm h]
    · simpa [P, h, univLt_asymm h] using (hT.symm b a hab.symm).symm
  · intro a b hab
    dsimp [P]
    split_ifs
    · intro h
      exact (hT.unit_coeff b a hab.symm).ne_zero (by simp [h])
    · exact one_ne_zero

private theorem lower_unordered_mem (s : KLR.Seq μ) (hs : ¬ IsRedOrdered s) :
    CycKLR.mk k S p μ (e s) ∈ J :=
  TwoSidedIdeal.subset_span (Or.inr ⟨s, hs, rfl⟩)

private theorem lower_dot_mem (s : KLR.Seq μ) (a : Fin (Multiset.card μ)) (ha : (s.lbl a).isRight) :
    CycKLR.mk k S p μ (x a * e s) ∈ J :=
  TwoSidedIdeal.subset_span (Or.inl ⟨s, a, ha, rfl⟩)

local notation "exponents" => Sum.elim (fun _ : I => (0 : ℕ)) (fun _ : Fin ℓ => 1)

omit [DecidableEq I] in
private theorem coverPolynomial_eq_pow :
    p = fun c : D => (Polynomial.X : Polynomial k) ^ exponents c := by
  funext c
  cases c <;> simp [cyclotomicCoverPolynomial]

/-- The upper red-dot and unordered relations on the terminal-black
restriction cut are generated by the lower cover ideal. -/
theorem cyclotomicCover_cut_mem_idealActionSpan (hQ : IsRouquierQ C Q) (z : W)
    (hz : CyclotomicAction.castCyc S p (stendhalWeight_black_cons (ℓ := ℓ) i ν) z.val ∈
      cyclotomicCoverIdeal ({i} + ν) S) :
    z ∈ idealActionSpan J := by
  let hS := isRouquierQ_cyclotomicCoverQ C Λ Q hQ
  obtain ⟨P, hSP, hP⟩ := factor_parameters hS
  let red : Set D := {c | c.isRight}
  let extra : Set B := {d | ∃ s : KLR.Seq (σ + μ), ¬ IsRedOrdered s ∧ d = CycKLR.mk k S p _ (e s)}
  have hex : ∀ c ∈ red, ∀ s : KLR.Seq μ, ∃ a, s.lbl a = c := by
    intro c hc s
    cases c with
    | inl c => simp [red] at hc
    | inr r => exact red_exists r s
  have hlo : ∀ c ∈ red, ∀ (s : KLR.Seq μ) a b, s.lbl a = c → s.lbl b = c → a = b := by
    intro c hc s a b ha hb
    cases c with
    | inl c => simp [red] at hc
    | inr r => exact red_unique rfl r s a b ha hb
  have hhi : ∀ c ∈ red, ∀ (s : KLR.Seq (σ + μ)) a b, s.lbl a = c → s.lbl b = c → a = b := by
    intro c hc s a b ha hb
    cases c with
    | inl c => simp [red] at hc
    | inr r => exact red_unique (stendhalWeight_black_cons i ν) r s a b ha hb
  have he : ∀ d ∈ extra, ∀ b, cyclotomicRegularCut S μ (.inl i) p (b * d) ∈ idealActionSpan J := by
    rintro d ⟨s, hs, rfl⟩ b
    exact cut_mul_unordered_mem_span hS exponents p coverPolynomial_eq_pow i s hs J
      (lower_unordered_mem Λ ν C) b _ rfl
  have hd := cyclotomicRegularCut_mem_idealActionSpan S μ (.inl i) p hSP hP red extra J
    hex hlo hhi (lower_dot_mem Λ ν C) he (coverIdeal_cast Λ C _ z.val hz)
  have hcut : cyclotomicRegularCut S μ (.inl i) p z.val = z := Subtype.ext z.2
  rwa [hcut] at hd

/-- The kernel of the terminal-black cut map is contained in the lower
ideal's action span, as required for descent of restriction projectivity. -/
theorem cyclotomicCoverResMap_ker_le (hQ : IsRouquierQ C Q) :
    LinearMap.ker (cyclotomicCoverResMap (Q := Q) Λ ν C i) ≤ idealActionSpan J := by
  intro z hz
  have hm : cyclotomicCoverResMap (Q := Q) Λ ν C i z = 0 := LinearMap.mem_ker.mp hz
  have hu : cyclotomicCoverUpper (Q := Q) Λ ν C i z.val = 0 := congrArg Subtype.val hm
  exact cyclotomicCover_cut_mem_idealActionSpan Λ ν C i hQ z
    ((cyclotomicCoverUpper_eq_zero_iff (Q := Q) Λ ν C i z.val).mp hu)

end Categorification.Stendhal
