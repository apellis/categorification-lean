import Categorification.WeightedKLR.Rigidity.CupCapProp721AppendIotaSurj

/-!
# `K^{λ⁺}_λ e'⁺` is generated by the image of appending a strand

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.3, proof of
Proposition 7.21, the part for `𝔈_i`, for `j < ℓ`: the multiplication
`T̃^λ_{{i} + ν} e' ⊗ K_ν → K_{{i} + ν} e'⁺`, `a ⊗ c ↦ a · ι(c)`, is surjective. Every
`c e'⁺` is a sum of elements `a · ι(c')`. This is the statement at the level of the models
(`CupCap.appendBlackPlusOp_one_smul_mem_span_appendIota`), carried to the quotients by their
bottom-violated parts.

## Main results

* `CupCap.capLeftLin_mul`, `CupCap.capLeftLin_one`.
* `CupCap.appendBlackPlusOp_one_smul_mem_closure_capIota`.
-/

noncomputable section

namespace Categorification.Stendhal.CupCap

open KLR KLRAlgebra MulOpposite InductionAlong

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} [DecidableEq I] {k : Type} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {Λc : Fin 2 → I →₀ ℕ}
  {j : ℕ} {hj : j ≤ ℓ} {ν ν₀ : Multiset I}
  {L : Type} [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  {hL : ∀ (w : Seq (stendhalWeight 2 ν₀)) (v : L), ¬ IsCapGood ν₀ w →
    op (cupMap k Q Λc ν₀ (KLRAlgebra.e w)) • v = 0}

section Left

variable (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL) (hP : PullOff k Q Λc ν₀ L)
  (hPL : PullOffLeft k Q Λc ν₀ L) (hκ : ∀ i, IsUnit (cupScalar Q ν₀ i))

include hR hP hPL hκ in
/-- The left actions on `K^{λ⁺}_λ` compose. -/
theorem capLeftLin_mul (a b : StendhalAlgebra k Q Λ ν) (c : CapBimodule k Q Λ Λc j hj ν ν₀ L) :
    capLeftLin L a (capLeftLin L b c) = capLeftLin L (a * b) c := by
  obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (capModelRightEquiv hR hP hPL hκ c)
  apply (capModelRightEquiv hR hP hPL hκ).injective
  rw [capModelRightEquiv_capLeftLin hR hP hPL hκ a _ _
      (capModelRightEquiv_capLeftLin hR hP hPL hκ b c y hy.symm),
    capModelRightEquiv_capLeftLin hR hP hPL hκ (a * b) c y hy.symm, map_mul]
  rfl

include hR hP hPL hκ in
/-- The unit acts trivially on `K^{λ⁺}_λ`. -/
theorem capLeftLin_one (c : CapBimodule k Q Λ Λc j hj ν ν₀ L) : capLeftLin L 1 c = c := by
  obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (capModelRightEquiv hR hP hPL hκ c)
  apply (capModelRightEquiv hR hP hPL hκ).injective
  rw [capModelRightEquiv_capLeftLin hR hP hPL hκ 1 c y hy.symm, map_one]
  exact hy

end Left

variable (ν) (i : I)

local notation "νᵢ" => ((Singleton.singleton i : Multiset I) + ν)

variable [Module k L] [IsScalarTower k (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  (hR : MidKLRRel j hj Q Λ Λc ν ν₀ L hL)
  (hR' : MidKLRRel j hj Q Λ Λc ((Singleton.singleton i : Multiset I) + ν) ν₀ L hL)
  (hP : PullOff k Q Λc ν₀ L) (hPL : PullOffLeft k Q Λc ν₀ L)
  (hκ : ∀ i', IsUnit (cupScalar Q ν₀ i')) (h : j < ℓ)

/-- **Surjectivity of `T̃^λ_{{i} + ν} e' ⊗ K_ν → K_{{i} + ν} e'⁺`** (Webster,
arXiv:1309.3796v3, §7.3, proof of Proposition 7.21, the part for `𝔈_i`), for `j < ℓ`: every
`c e'⁺` is a sum of elements `a · ι(c')`, when the cup scalars are units and `L` satisfies the
pull-off identities. -/
theorem appendBlackPlusOp_one_smul_mem_closure_capIota
    (c : CapBimodule k Q Λ Λc j hj νᵢ ν₀ L) :
    appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 • c ∈
      AddSubmonoid.closure (Set.range fun p : StendhalAlgebra k Q Λ νᵢ ×
          CapBimodule k Q Λ Λc j hj ν ν₀ L =>
        capLeftLin L p.1 (capIota ν i hR hR' hP hPL hκ h p.2)) := by
  set S := AddSubmonoid.closure (Set.range fun p : StendhalAlgebra k Q Λ νᵢ ×
      CapBimodule k Q Λ Λc j hj ν ν₀ L =>
    capLeftLin L p.1 (capIota ν i hR hR' hP hPL hκ h p.2)) with hS
  have hlin : ∀ (a : StendhalAlgebra k Q Λ νᵢ) (c : CapBimodule k Q Λ Λc j hj νᵢ ν₀ L),
      c ∈ S → capLeftLin L a c ∈ S := by
    intro a c hc
    induction hc using AddSubmonoid.closure_induction with
    | mem x hx =>
      obtain ⟨⟨b, x⟩, rfl⟩ := hx
      rw [capLeftLin_mul hR' hP hPL hκ]
      exact AddSubmonoid.subset_closure ⟨(a * b, x), rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  have hπ : ∀ z ∈ Submodule.span (StendhalAlgebra k Q Λ νᵢ)
      (Set.range fun x : MidModel j hj Q Λ Λc ν ν₀ L =>
        toMidLeftModel ν i hR' (appendIota ν i L h x)),
      (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (z : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ S := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨x, rfl⟩ := hz
      have hc : (capModelRightEquiv hR' hP hPL hκ).symm
          (Submodule.Quotient.mk (appendIota ν i L h x)) =
          capIota ν i hR hR' hP hPL hκ h ((capModelRightEquiv hR hP hPL hκ).symm
            (Submodule.Quotient.mk x)) := by
        apply (capModelRightEquiv hR' hP hPL hκ).injective
        rw [LinearEquiv.apply_symm_apply,
          capModelRightEquiv_capIota ν i hR hR' hP hPL hκ h _ x
            (LinearEquiv.apply_symm_apply _ _)]
      change (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (appendIota ν i L h x)) ∈ S
      rw [hc, ← capLeftLin_one hR' hP hPL hκ (capIota ν i hR hR' hP hPL hκ h _)]
      exact AddSubmonoid.subset_closure ⟨(1, _), rfl⟩
    | zero =>
      change (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (0 : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ S
      rw [Submodule.Quotient.mk_zero, map_zero]
      exact zero_mem _
    | add x y _ _ hx hy =>
      convert add_mem hx hy using 1
      rw [← map_add]
      rfl
    | smul a z _ hz =>
      have hc : (capModelRightEquiv hR' hP hPL hκ).symm
          (Submodule.Quotient.mk (midLeftAlg L hL hR' a z)) =
          capLeftLin L a ((capModelRightEquiv hR' hP hPL hκ).symm
            (Submodule.Quotient.mk (z : MidModel j hj Q Λ Λc νᵢ ν₀ L))) := by
        apply (capModelRightEquiv hR' hP hPL hκ).injective
        rw [LinearEquiv.apply_symm_apply,
          capModelRightEquiv_capLeftLin hR' hP hPL hκ a _ z (LinearEquiv.apply_symm_apply _ _)]
      change (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (midLeftAlg L hL hR' a z)) ∈ S
      rw [hc]
      exact hlin a _ hz
  obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (capModelRightEquiv hR' hP hPL hκ c)
  have hc : appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 • c =
      (capModelRightEquiv hR' hP hPL hκ).symm
        (Submodule.Quotient.mk (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 • y)) := by
    apply (capModelRightEquiv hR' hP hPL hκ).injective
    rw [LinearEquiv.apply_symm_apply, LinearEquiv.map_smul, ← hy, Submodule.Quotient.mk_smul]
  rw [hc]
  exact hπ _ (appendBlackPlusOp_one_smul_mem_span_appendIota ν i h hR' hP hκ y)

end Categorification.Stendhal.CupCap
