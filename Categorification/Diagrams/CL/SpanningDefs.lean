import Categorification.Diagrams.CL.SlideCalculusC
import Categorification.Diagrams.CL.Specialize
import Categorification.Diagrams.KL3.Lemma39
import Categorification.Diagrams.KL3.SymmetryOmega

/-!
# The spanning statements of KL III Props 3.6 and 3.10 for Cautis–Lauda scalars

M. Khovanov, A. D. Lauda, *A categorification of quantum sl(n)* (KL III), arXiv:0807.3250v1,
Proposition 3.10: the map `ϕ_{ν,λ} : R(ν) ⊗ Π_λ → END_U(E_ν 1_λ)` is surjective. KL prove it
for their choice of scalars (`Categorification.Diagrams.KL3.Lemma39`, `prop310`). For a
presentation `P` on the signature of `U` (in particular `U_Q(g)` of S. Cautis, A. D. Lauda,
arXiv:1111.1431v3, Definition 1.1, `presCL RD k S`) this file states the same surjectivity in
the spanning form used by KL's proof (KL III, proof of Lemma 3.9), for upward and for downward
strands, and proves it for the KL scalars.

## Main definitions

* `bubGenC P λ i n`: the real bubble of degree `2 d_i (n + 1)` in the region `λ` (clockwise if
  `⟨i, λ⟩ ≥ 0`, counterclockwise otherwise), the generator `(i, n)` of `Π_λ` of KL III (3.25).
* `IsBubC P λ x`: `x ∈ END_P(1_λ)` lies in the image of `Π_λ` (the subalgebra generated by the
  `bubGenC`).
* `upSpanC P μ S T`, `dnSpanC P μ S T`: the span of upward (resp. downward) normal-form diagrams
  `E_S 1_μ ⟶ E_T 1_μ` followed by an element of the image of `Π_μ` on the far right.
* `UpSpans P μ ν`, `DnSpans P μ ν`: every 2-morphism `E_s 1_μ ⟶ E_t 1_μ` between upward (resp.
  downward) sequences `s, t ∈ Seq ν` lies in that span: KL III Proposition 3.10 for `E_ν 1_μ`
  (resp. `F_ν 1_μ`).
* `Prop310C RD k S μ ν`: `DnSpans` for `U_Q(g)` with the scalars `S`; `Prop310UpC` is the upward
  form.

## Main results

* `upSpans_pres`, `prop310UpC_kl`: the upward form for the KL scalars (from `prop310`).
* `dnSpans_pres`, `prop310C_kl`: the downward form for the KL scalars, from the upward form and
  the symmetry `ω̃` of KL III (3.43), which inverts the orientation of every strand.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.KL3.Diagram.CL

open CategoryTheory StringDiagrams QuantumGroup UDot Presentation

universe w u v

variable {I : Type u} {C : CartanDatum I} {X Y : Type v} [AddCommGroup X] [AddCommGroup Y]
  {RD : WeightDatum C X Y} {k : Type w} [CommRing k]

/-! ## Definitions for an arbitrary presentation -/

section Defs

variable (P : Presentation.{w, max u v} (psig RD) k)

/-- The generator `(i, n)` of `Π_λ` (KL III (3.25)) as an endomorphism of `1_λ` in `P`: the real
bubble of colour `i` with `⟨i, λ⟩ + n` dots, clockwise if `⟨i, λ⟩ ≥ 0`, and the counterclockwise
bubble with `-⟨i, λ⟩ + n` dots otherwise. -/
def bubGenC (lam : X) (i : I) (n : ℕ) : End (P.obj (ob RD lam [])) :=
  if 0 ≤ ip RD i lam then dgC P lam [] [] (cwLs i ((ip RD i lam).toNat + n))
  else dgC P lam [] [] (ccwLs i ((-ip RD i lam).toNat + n))

/-- `x` lies in the image of `Π_λ → END_P(1_λ)`: the subalgebra generated by the real bubbles
`bubGenC`. -/
def IsBubC (lam : X) (x : End (P.obj (ob RD lam []))) : Prop :=
  x ∈ Algebra.adjoin k (Set.range fun p : I × ℕ => bubGenC P lam p.1 p.2)

/-- An endomorphism of `1_μ` placed to the right of the strands `s`. -/
def bubAtC (μ : X) (s : List (Letter I)) :
    End (P.obj (ob RD μ [])) →ₗ[k] End (P.obj (ob RD μ s)) :=
  ctxLC P μ s s [] s [] [] [] []

/-- The shape is a downward dot or a downward crossing. -/
def IsDnShape : Shape I → Prop
  | .dot l => l.1 = false
  | .cross b _ _ => b = false
  | _ => False

/-- A list of layers of downward dots and downward crossings. -/
def Downward (ls : List (LayerData I)) : Prop := ∀ x ∈ ls, IsDnShape x.2.1

/-- The span of the upward normal-form diagrams `E_S 1_μ ⟶ E_T 1_μ` followed by an element of
the image of `Π_μ` on the far right. -/
def upSpanC (μ : X) (S T : List (Letter I)) :
    Submodule k (P.obj (ob RD μ S) ⟶ P.obj (ob RD μ T)) :=
  Submodule.span k {f | ∃ (A : List (LayerData I)) (γ : End (P.obj (ob RD μ []))),
    Upward A ∧ SChain S A T ∧ IsBubC P μ γ ∧ f = dgC P μ S T A ≫ bubAtC P μ T γ}

/-- The span of the downward normal-form diagrams `E_S 1_μ ⟶ E_T 1_μ` followed by an element of
the image of `Π_μ` on the far right. -/
def dnSpanC (μ : X) (S T : List (Letter I)) :
    Submodule k (P.obj (ob RD μ S) ⟶ P.obj (ob RD μ T)) :=
  Submodule.span k {f | ∃ (A : List (LayerData I)) (γ : End (P.obj (ob RD μ []))),
    Downward A ∧ SChain S A T ∧ IsBubC P μ γ ∧ f = dgC P μ S T A ≫ bubAtC P μ T γ}

/-- **KL III Proposition 3.10 for `E_ν 1_μ`, spanning form**: every 2-morphism `E_s 1_μ ⟶ E_t 1_μ`
(`s, t ∈ Seq ν`, upward strands) is a linear combination of upward diagrams followed by bubble
monomials on the far right; equivalently `R(ν) ⊗ Π_μ → END_P(E_ν 1_μ)` is surjective. -/
def UpSpans (μ : X) (ν : Multiset I) : Prop :=
  ∀ (s t : KLR.Seq ν)
    (f : P.obj (ob RD μ (ups (KLR.Diagram.word s))) ⟶ P.obj (ob RD μ (ups (KLR.Diagram.word t)))),
    f ∈ upSpanC P μ (ups (KLR.Diagram.word s)) (ups (KLR.Diagram.word t))

/-- **KL III Proposition 3.10 for `F_ν 1_μ`, spanning form**: every 2-morphism `F_s 1_μ ⟶ F_t 1_μ`
(`s, t ∈ Seq ν`, downward strands) is a linear combination of downward diagrams followed by
bubble monomials on the far right; equivalently `R(ν) ⊗ Π_μ → END_P(F_ν 1_μ)` is surjective. -/
def DnSpans (μ : X) (ν : Multiset I) : Prop :=
  ∀ (s t : KLR.Seq ν)
    (f : P.obj (ob RD μ (dns (KLR.Diagram.word s))) ⟶ P.obj (ob RD μ (dns (KLR.Diagram.word t)))),
    f ∈ dnSpanC P μ (dns (KLR.Diagram.word s)) (dns (KLR.Diagram.word t))

end Defs

variable (RD k) in
/-- **KL III Proposition 3.10 for `U_Q(g)`** (CL arXiv:1111.1431v3, Definition 1.1, scalars `S`),
on downward strands: `R(ν) ⊗ Π_μ → END_{U_Q(g)}(F_ν 1_μ)` is surjective (spanning form,
`DnSpans`). -/
def Prop310C (S : CLScalars C k) (μ : X) (ν : Multiset I) : Prop :=
  DnSpans (presCL RD k S) μ ν

variable (RD k) in
/-- **KL III Proposition 3.10 for `U_Q(g)`**, on upward strands: `R(ν) ⊗ Π_μ →
END_{U_Q(g)}(E_ν 1_μ)` is surjective (spanning form, `UpSpans`). -/
def Prop310UpC (S : CLScalars C k) (μ : X) (ν : Multiset I) : Prop :=
  UpSpans (presCL RD k S) μ ν

/-! ## The KL scalars -/

section KL

theorem dgC_pres (μ : X) (s t : List (Letter I)) (ls : List (LayerData I)) :
    dgC (pres RD k) μ s t ls = dg RD k μ s t ls := rfl

theorem bubGenC_pres (lam : X) (i : I) (n : ℕ) :
    bubGenC (pres RD k) lam i n = bubGen RD k lam i (n + 1) := by
  unfold bubGenC bubGen
  split_ifs with h
  · rw [dgC_pres, show ip RD i lam - 1 + ((n + 1 : ℕ) : ℤ) = (((ip RD i lam).toNat + n : ℕ) : ℤ)
      by push_cast; omega, cwU_of_nonneg]
  · rw [dgC_pres, show -ip RD i lam - 1 + ((n + 1 : ℕ) : ℤ) = (((-ip RD i lam).toNat + n : ℕ) : ℤ)
      by push_cast; omega, ccwU_of_nonneg]

theorem isBubC_pres {lam : X} {x : End ((pres RD k).obj (ob RD lam []))} (hx : IsBub RD k lam x) :
    IsBubC (pres RD k) lam x := by
  obtain ⟨p, hp⟩ := hx
  have key : ∀ q : PiLam I k, IsBubC (pres RD k) lam (bubMap RD k lam q).val := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C a =>
      rw [show bubMap RD k lam (MvPolynomial.C a) = algebraMap k (EndOne RD k lam) a from
        MvPolynomial.aeval_C _ _, EndOne.val_algebraMap]
      exact Subalgebra.smul_mem _ (Subalgebra.one_mem _) a
    | add p q hp hq => rw [map_add, EndOne.val_add]; exact Subalgebra.add_mem _ hp hq
    | mul_X p n hp =>
      rw [map_mul, EndOne.val_mul]
      refine Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ⟨n, ?_⟩)
      rw [show bubMap RD k lam (MvPolynomial.X n) = EndOne.of (bubGen RD k lam n.1 (n.2 + 1)) from
        MvPolynomial.aeval_X _ _, EndOne.val_of]
      exact bubGenC_pres _ _ _
  have := key p
  rwa [show bubMap RD k lam p = EndOne.of x from hp, EndOne.val_of] at this

theorem bubAtC_pres (μ : X) (s : List (Letter I)) : bubAtC (pres RD k) μ s = bubAt RD k μ s := rfl

theorem upSpan_le_upSpanC (μ : X) (S T : List (Letter I)) :
    upSpan RD k μ S T ≤ upSpanC (pres RD k) μ S T := by
  refine Submodule.span_le.2 ?_
  rintro f ⟨A, γ, hA, hc, hγ, rfl⟩
  exact Submodule.subset_span ⟨A, γ, hA, hc, isBubC_pres hγ, rfl⟩

/-- **KL III Proposition 3.10** (upward strands) for the presentation `pres RD k` of KL III
Definition 3.1. -/
theorem upSpans_pres [DecidableEq I] (μ : X) (ν : Multiset I) : UpSpans (pres RD k) μ ν :=
  fun s t f => upSpan_le_upSpanC μ _ _
    ((prop310_iff_upSpan RD k μ ν).1 (prop310 (RD := RD) (k := k) μ ν) s t f)

/-- **KL III Proposition 3.10** (upward strands) for `U_Q(g)` with the KL scalars. -/
theorem prop310UpC_kl [DecidableEq I] (μ : X) (ν : Multiset I) :
    Prop310UpC RD k CLScalars.kl μ ν := by
  unfold Prop310UpC
  rw [presCL_kl]
  exact upSpans_pres μ ν

/-! ### Downward strands, via `ω̃` -/

variable [DecidableEq I]

omit [DecidableEq I] in
theorem wls_map_whL_right (T : List (Letter I)) (ls : List (LayerData I)) :
    Omega.wls (ls.map (whL T [])) = (Omega.wls ls).map (whL (T.map Letter.dual) []) := by
  simp [Omega.wls, Omega.ld, whL, List.map_map, Function.comp_def]

/-- `ω̃` commutes with placing an endomorphism of `1_λ` on the far right. -/
theorem omegaU_bubAt (lam : X) (T : List (Letter I)) (β : End ((pres RD k).obj (ob RD lam []))) :
    (omegaU RD k).map (bubAt RD k lam T β) =
      TR RD k (Omega.trO lam T) (Omega.trO lam T)
        (bubAt RD k (-lam) (T.map Letter.dual) ((omegaU RD k).map β)) := by
  let φ : End ((pres RD k).obj (ob RD lam [])) →ₗ[k]
      ((pres RD k).obj (Omega.obj RD (ob RD lam T)) ⟶
        (pres RD k).obj (Omega.obj RD (ob RD lam T))) :=
    ((omegaU RD k).mapLinearMap k).comp (bubAt RD k lam T)
  let ψ : End ((pres RD k).obj (ob RD lam [])) →ₗ[k]
      ((pres RD k).obj (Omega.obj RD (ob RD lam T)) ⟶
        (pres RD k).obj (Omega.obj RD (ob RD lam T))) :=
    (TR RD k (Omega.trO lam T) (Omega.trO lam T)).comp
      ((bubAt RD k (-lam) (T.map Letter.dual)).comp ((omegaU RD k).mapLinearMap k))
  have key : φ = ψ := by
    refine hom_ext_dg RD k lam φ ψ fun ls h => ?_
    have hT : SChain T (ls.map (whL T [])) T := by simpa using h.whisk T []
    show (omegaU RD k).map (bubAt RD k lam T (dg RD k lam [] [] ls)) =
      TR RD k (Omega.trO lam T) (Omega.trO lam T)
        (bubAt RD k (-lam) (T.map Letter.dual) ((omegaU RD k).map (dg RD k lam [] [] ls)))
    rw [bubAt_dg, omegaU_dg lam _ hT, omegaU_dg_nil lam ls h, map_smul, bubAt_dg, map_smul,
      sgnS_map_whL, wls_map_whL_right]
  exact LinearMap.congr_fun key β

theorem omegaU_isBub {lam : X} {x : End ((pres RD k).obj (ob RD lam []))} (hx : IsBub RD k lam x) :
    IsBub RD k (-lam) ((omegaU RD k).map x) := by
  obtain ⟨p, hp⟩ := hx
  have key : ∀ q : PiLam I k, IsBub RD k (-lam) ((omegaU RD k).map (bubMap RD k lam q).val) := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C a =>
      rw [show bubMap RD k lam (MvPolynomial.C a) = algebraMap k (EndOne RD k lam) a from
        MvPolynomial.aeval_C _ _, EndOne.val_algebraMap,
        CategoryTheory.Functor.map_smul, CategoryTheory.Functor.map_id]
      exact IsBub.smul a IsBub.id
    | add p q hp hq =>
      rw [map_add, EndOne.val_add, Functor.map_add]; exact IsBub.add hp hq
    | mul_X p n hp =>
      rw [map_mul, EndOne.val_mul, Functor.map_comp]
      refine IsBub.comp ?_ hp
      rw [show bubMap RD k lam (MvPolynomial.X n) = EndOne.of (bubGen RD k lam n.1 (n.2 + 1)) from
        MvPolynomial.aeval_X _ _, EndOne.val_of]
      unfold bubGen
      split_ifs
      · rw [omegaU_cwU]; exact ccwU_isBub _ _
      · rw [omegaU_ccwU]; exact cwU_isBub _ _
  have := key p
  rwa [show bubMap RD k lam p = EndOne.of x from hp, EndOne.val_of] at this

omit [DecidableEq I] in
theorem downward_wls {A : List (LayerData I)} (hA : Upward A) : Downward (Omega.wls A) := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
  have := hA y hy
  obtain ⟨u, g, v⟩ := y
  cases g with
  | dot l => simpa [Omega.ld, Omega.shape, IsDnShape, Shape.isUp, Letter.dual] using this
  | cross ε i j => simpa [Omega.ld, Omega.shape, IsDnShape, Shape.isUp] using this
  | cup l => simp [Shape.isUp] at this
  | cap l => simp [Shape.isUp] at this

omit [DecidableEq I] in
theorem TR_TR' {a a' a'' b b' b'' : Obj (psig RD)} (ea : a = a') (eb : b = b') (ea' : a' = a'')
    (eb' : b' = b'') (f : (pres RD k).obj a'' ⟶ (pres RD k).obj b'') :
    TR RD k ea eb (TR RD k ea' eb' f) = TR RD k (ea.trans ea') (eb.trans eb') f := by
  subst ea eb ea' eb'; simp [TR_apply]

theorem omegaU_TR {a a' b b' : Obj (psig RD)} (ea : a = a') (eb : b = b')
    (f : (pres RD k).obj a' ⟶ (pres RD k).obj b') :
    (omegaU RD k).map (TR RD k ea eb f) =
      TR RD k (congrArg (Omega.obj RD) ea) (congrArg (Omega.obj RD) eb) ((omegaU RD k).map f) := by
  subst ea eb; simp only [TR_rfl]

omit [DecidableEq I] in
theorem TR_mem_dnSpanC {ν ν' : X} {S S' T T' : List (Letter I)} (hν : ν = ν') (hS : S = S')
    (hT : T = T') (ea : ob RD ν S = ob RD ν' S') (eb : ob RD ν T = ob RD ν' T')
    {f : (pres RD k).obj (ob RD ν' S') ⟶ (pres RD k).obj (ob RD ν' T')}
    (hf : f ∈ dnSpanC (pres RD k) ν' S' T') : TR RD k ea eb f ∈ dnSpanC (pres RD k) ν S T := by
  subst hν hS hT; rwa [TR_self]

/-- `ω̃` sends the span of upward diagrams with bubbles on the far right to the span of downward
diagrams with bubbles on the far right. -/
theorem omegaU_mem_dnSpanC {ν : X} {S T : List (Letter I)}
    {h : (pres RD k).obj (ob RD ν S) ⟶ (pres RD k).obj (ob RD ν T)} (hh : h ∈ upSpan RD k ν S T)
    (ea : ob RD (-ν) (S.map Letter.dual) = Omega.obj RD (ob RD ν S))
    (eb : ob RD (-ν) (T.map Letter.dual) = Omega.obj RD (ob RD ν T)) :
    TR RD k ea eb ((omegaU RD k).map h) ∈
      dnSpanC (pres RD k) (-ν) (S.map Letter.dual) (T.map Letter.dual) := by
  induction hh using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨A, γ, hA, hc, hγ, rfl⟩ := hf
    rw [Functor.map_comp, omegaU_dg ν A hc, omegaU_bubAt, Linear.smul_comp, TR_comp, map_smul,
      TR_TR]
    exact Submodule.smul_mem _ _ (Submodule.subset_span
      ⟨Omega.wls A, _, downward_wls hA, Omega.sChain_wls hc, isBubC_pres (omegaU_isBub hγ), rfl⟩)
  | zero => rw [Functor.map_zero, map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [Functor.map_add, map_add]; exact Submodule.add_mem _ hx hy
  | smul r x _ hx => rw [Functor.map_smul, map_smul]; exact Submodule.smul_mem _ _ hx

omit [DecidableEq I] in
theorem map_dual_dns (l : List I) : (dns l).map Letter.dual = ups l := by
  simp [ups, dns, List.map_map, Function.comp_def, Letter.dual]

/-- **KL III Proposition 3.10** (downward strands) for the presentation `pres RD k` of KL III
Definition 3.1, deduced from the upward form by the symmetry `ω̃`. -/
theorem dnSpans_pres (μ : X) (ν : Multiset I) : DnSpans (pres RD k) μ ν := by
  intro s t f
  have ea : ob RD (-μ) (ups (KLR.Diagram.word s)) =
      Omega.obj RD (ob RD μ (dns (KLR.Diagram.word s))) := by
    rw [Omega.trO, map_dual_dns]
  have eb : ob RD (-μ) (ups (KLR.Diagram.word t)) =
      Omega.obj RD (ob RD μ (dns (KLR.Diagram.word t))) := by
    rw [Omega.trO, map_dual_dns]
  have hg : TR RD k ea eb ((omegaU RD k).map f) ∈
      upSpan RD k (-μ) (ups (KLR.Diagram.word s)) (ups (KLR.Diagram.word t)) :=
    (prop310_iff_upSpan RD k (-μ) ν).1 (prop310 (RD := RD) (k := k) (-μ) ν) s t _
  have key := omegaU_mem_dnSpanC hg (Omega.trO (-μ) _).symm (Omega.trO (-μ) _).symm
  rw [omegaU_TR, TR_TR', omegaU_omegaU, TR_TR'] at key
  have := TR_mem_dnSpanC (neg_neg μ).symm (map_dual_ups _).symm (map_dual_ups _).symm
    (by rw [neg_neg, map_dual_ups]) (by rw [neg_neg, map_dual_ups]) key
  rwa [TR_TR', TR_self] at this

/-- **KL III Proposition 3.10** (downward strands) for `U_Q(g)` with the KL scalars. -/
theorem prop310C_kl (μ : X) (ν : Multiset I) : Prop310C RD k CLScalars.kl μ ν := by
  unfold Prop310C
  rw [presCL_kl]
  exact dnSpans_pres μ ν

end KL

end Categorification.KL3.Diagram.CL
