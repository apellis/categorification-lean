import Categorification.TypeA.FourSlotExits
import Categorification.KLR.InductionFree

/-!
# The four local exit generators

For the affine relation calculation after (6.21) in Webster v2's Lemma 6.8,
a four-slot interval with exchanged endpoints is generated by the left
multiples of its two extreme exits and both middle exits. The crossing
words act on bottom loadings with the rightmost letter first.
-/

namespace Categorification.KLR.KLRAlgebra
open TypeA Equiv MvPolynomial

variable {I k : Type*} [DecidableEq I] [CommRing k]
    {Q : I → I → MvPolynomial (Fin 2) k} {ν : Multiset I}

local notation "R" => KLRAlgebra k Q ν
local notation "m" => Multiset.card ν

private theorem exists_fourSlotExit_reduced_suffix_card {n : ℕ} (h : n = 4)
    (w : Perm (Fin n)) (hw : w ⟨3, by omega⟩ < w ⟨0, by omega⟩) :
    ∃ ρ ∈ fourSlotExitWords,
      IsReduced n (canWord n (w * (wordProd n ρ)⁻¹) ++ ρ) ∧
      wordProd n (canWord n (w * (wordProd n ρ)⁻¹) ++ ρ) = w := by
  subst n
  exact exists_fourSlotExit_reduced_suffix w hw

/-- The affine KLR column exchanging the endpoints of a four-slot loading
is generated on the left by the four undotted exits. -/
theorem mem_span_fourSlotExit_column (hQ : KLRSymm Q) (h : m = 4) (s t : Seq ν)
    (hex : ∀ w : Perm (Fin m), w • s = t → w ⟨3, by omega⟩ < w ⟨0, by omega⟩)
    (z : R) : e t * z * e s ∈ Submodule.span k {y : R |
      ∃ (ρ : List ℕ) (_ : ρ ∈ fourSlotExitWords) (x : R),
        e t * x * e ((wordProd m ρ) • s) = x ∧ y = x * (ψw ρ * e s)} := by
  classical
  let f (w : Perm (Fin m)) (hw : w • s = t) :=
    (exists_fourSlotExit_reduced_suffix_card h w (hex w hw)).choose
  let words (w : Perm (Fin m)) := if hw : w • s = t then
    canWord m (w * (wordProd m (f w hw))⁻¹) ++ f w hw else canWord m w
  have hwds : ∀ w, IsReduced m (words w) ∧ wordProd m (words w) = w := by
    intro w
    dsimp only [words]
    split_ifs with hw
    · exact (exists_fourSlotExit_reduced_suffix_card h w (hex w hw)).choose_spec.2
    · exact ⟨isReduced_canWord _ _, wordProd_canWord _ _⟩
  let B := lbasis (k := k) («μ» := ν) hQ words hwds
  induction B.mem_span z using Submodule.span_induction with
  | zero => simp
  | add _ _ _ _ hx hy => rw [mul_add, add_mul]; exact add_mem hx hy
  | smul c _ _ hx => rw [mul_smul_comm, smul_mul_assoc]; exact Submodule.smul_mem _ _ hx
  | mem _ hb =>
    obtain ⟨⟨b,w,d⟩, rfl⟩ := hb
    rw [show B (b,w,d) = _ from lbasis_apply .., mul_assoc, mul_assoc _ (e b), e_mul_e]
    by_cases he : b = s
    · rw [ite_eq_left he]
      subst b
      by_cases hw : w • s = t
      · apply Submodule.subset_span
        let ρ := f w hw
        let v := wordProd m ρ
        let x : R := e t * pol (monomial d 1) * ψw (canWord m (w * v⁻¹)) * e (v • s)
        refine ⟨ρ, (exists_fourSlotExit_reduced_suffix_card h w (hex w hw)).choose_spec.1,
          x, ?_, ?_⟩
        · dsimp only [x]
          simp only [← mul_assoc, e_mul_self]
          rw [mul_assoc _ (e (v • s)) (e (v • s)), e_mul_self]
        · have hi : (e (v • s) * (ψw ρ * e s) : R) = ψw ρ * e s := by
            have hh := e_mul_pol_ψw_e (Q := Q) 1 ρ s
            simpa only [map_one, one_mul, v] using hh
          change e t * (pol (monomial d 1) * ψw (words w) * e s) = x * _
          simp only [x, words, dite_eq_left hw, ψw_append]
          rw [mul_assoc _ (e (v • s)), hi]
          simp only [mul_assoc, v, ρ]
      · have cut := e_mul_pol_ψw_e (Q := Q) (monomial d (1 : k)) (words w) s
        rw [(hwds w).2] at cut
        rw [← cut, ← mul_assoc, e_mul_e, ite_eq_right (Ne.symm hw), zero_mul]
        exact zero_mem _
    · rw [ite_eq_right he, mul_zero, mul_zero]
      exact zero_mem _

end Categorification.KLR.KLRAlgebra
