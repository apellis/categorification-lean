import Categorification.KLR.TensorKLRK0
import Categorification.KLR.Prop32Mult
import Categorification.KLR.Theorem11
import Categorification.QuantumGroup.Coproduct

/-!
# `K₀(R)` as a twisted bialgebra: the coproduct `[Res]` and KL I, Theorem 1.1

Khovanov–Lauda I (arXiv:0803.4121v2), §1 and §3.1 (TeX lines ~290–305 and ~1882–1960):
"`[Res]` is the sum of maps `K₀(R(ν + ν')) → K₀(R(ν)) ⊗ K₀(R(ν'))` over all `ν, ν'`";
**Proposition 3.1** (`[Res]` is coassociative), the algebra structure (3.1)
`(x₁ ⊗ x₂)(x₁' ⊗ x₂') = q^{-|x₂|·|x₁'|} x₁x₁' ⊗ x₂x₂'` on `K₀(R) ⊗ K₀(R)`, **Proposition 3.2**
("`[Res]` is an algebra homomorphism"), and **Theorem 1.1** ("`γ : _𝒜 f → K₀(R)` is an
isomorphism of `ℕ[I]`-graded twisted bialgebras").

All tensor products of `K₀`'s are over `ℤ[q, q⁻¹]`; `K₀(R) = G.K0R = ⨁_ν K₀(R(ν))`.

## Definitions (any grading datum `G` with dots of positive degree, `hPQ`, `hP`)

* `GradingDatum.coprod` : **`Δ = [Res] : K₀(R) → K₀(R) ⊗ K₀(R)`**, the sum over all `ν, ν'` of
  `[Res_{ν,ν'}] : K₀(R(ν + ν')) → K₀(R(ν) ⊗ R(ν')) ≅ K₀(R(ν)) ⊗ K₀(R(ν'))` (the identification is
  `GradingDatum.k0TensorEquiv`). It is characterised by `coprod_spec` / `eq_coprod_of_spec`.
* `GradingDatum.twMul` : the twisted multiplication (3.1),
  `(x₁ ⊗ x₂)(x₁' ⊗ x₂') = q^{|x₂| ⋄ |x₁'|} x₁x₁' ⊗ x₂x₂'`, `|x₂| ⋄ |x₁'| = ∑ degΨ(a, c)`
  (`= -|x₂|·|x₁'|` for the KL I grading); it is associative with unit `1 ⊗ 1` (`twMul_assoc`,
  `twMul_one_left`, `twMul_one_right`).
* `GradingDatum.gammaTT`, `GradingDatum.gammaTTT` : `γ ⊗ γ` and `γ ⊗ γ ⊗ γ` on the twisted tensor
  powers of `'f`.

## Main results

For every grading datum:

* `GradingDatum.coprod_gammaG` : **`Δ ∘ γ = (γ ⊗ γ) ∘ r`** on `'f_{ℤ[q,q⁻¹]}`;
* `GradingDatum.gammaTT_mul`, `GradingDatum.coprod_mul_gammaG`, `GradingDatum.coprod_one` :
  Proposition 3.2 on the image of `γ`, and `Δ(1) = 1 ⊗ 1`;
* `GradingDatum.coassoc_gammaG` : coassociativity on the image of `γ` (from that of `r`).

For the KL I grading (`KLGamma`; Lusztig's normalisation: Cartan pairing, `v = q⁻¹`):

* `KLGamma.exists_smul_mem_range_gammaZ` : every `x ∈ K₀(R)` has a nonzero multiple `p x` in
  `γ('f_{ℤ[q,q⁻¹]})` (via KL I, Proposition 3.20); `K₀(R) ⊗ K₀(R)` is torsion-free;
* `KLGamma.coprod_mul` : **KL I, Proposition 3.2** on all of `K₀(R)`;
* `KLGamma.coassoc` : **KL I, Proposition 3.1** (coassociativity of `[Res]`);
* `KLGamma.coprod_gammaZ` : `[Res] ∘ γ = (γ ⊗ γ) ∘ r` for Lusztig's `r`;
* `KLGamma.map_gammaF_rbar` : over `ℚ(v)`, `(γ ⊗ γ) ∘ r̄ = Δ_{ℚ(v)} ∘ γ` on `f`, for Lusztig's
  `r̄ : f → f ⊗ f` (`PreF.rbar`); `KLGamma.map_gammaF_rbar_Af` : the same on `_𝒜 f`, with the
  integral `Δ`; `KLGamma.toK0QTT_injective`;
* `KLGamma.theorem_1_1_bialgebra` : **KL I, Theorem 1.1 in full** (bijectivity, gradings,
  twisted algebra structure, multiplicativity and coassociativity of `Δ`, compatibility with `r̄`).

## Hypotheses

The quantum Gabber–Kac hypothesis `hGK` (the radical of Lusztig's form is generated by the Serre
relations) is needed to define `f`, `_𝒜 f` and `γ : _𝒜 f → K₀(R)`; it is an explicit hypothesis
of the `f`-level statements, as in `Categorification.KLR.Theorem11`. The counit of `[Res]` is not
formalized.
-/

noncomputable section

namespace Categorification.KLR

open Graded GProj QuantumGroup PreF LaurentPolynomial
open scoped TensorProduct

variable {I : Type*} [DecidableEq I] {k : Type*} [Field k] {Q : I → I → MvPolynomial (Fin 2) k}
  {P : I → I → MvPolynomial (Fin 2) k}
  (hPQ : ∀ a b, a ≠ b → Q a b = P b a * MvPolynomial.rename ![1, 0] (P a b))
  (hP : ∀ a b, a ≠ b → P a b ≠ 0) (G : GradingDatum Q) (hG : ∀ a, 0 < G.degX a)

local notation "LP" => LaurentPolynomial ℤ

namespace GradingDatum

/-! ### Components of `K₀(R) ⊗ K₀(R)` -/

section Components

/-- The component map `K₀(R) ⊗ K₀(R) → K₀(R(ν)) ⊗ K₀(R(ν'))`. -/
def compTT (ν ν' : Multiset I) :
    G.K0R ⊗[LP] G.K0R →ₗ[LP] K0 (G.grade ν) ⊗[LP] K0 (G.grade ν') :=
  TensorProduct.map (DirectSum.component LP (Multiset I) G.K0fam ν)
    (DirectSum.component LP (Multiset I) G.K0fam ν')

/-- The inclusion `K₀(R(ν)) ⊗ K₀(R(ν')) → K₀(R) ⊗ K₀(R)`. -/
def inclTT (ν ν' : Multiset I) :
    K0 (G.grade ν) ⊗[LP] K0 (G.grade ν') →ₗ[LP] G.K0R ⊗[LP] G.K0R :=
  TensorProduct.map (DirectSum.lof LP (Multiset I) G.K0fam ν)
    (DirectSum.lof LP (Multiset I) G.K0fam ν')

theorem compTT_tmul (ν ν' : Multiset I) (x y : G.K0R) :
    G.compTT ν ν' (x ⊗ₜ y) = DirectSum.component LP (Multiset I) G.K0fam ν x ⊗ₜ
      DirectSum.component LP (Multiset I) G.K0fam ν' y := rfl

theorem compTT_inclTT_self (ν ν' : Multiset I) (z : K0 (G.grade ν) ⊗[LP] K0 (G.grade ν')) :
    G.compTT ν ν' (G.inclTT ν ν' z) = z := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    simp [compTT, inclTT, DirectSum.component.lof_self]
  | add z z' hz hz' => rw [map_add, map_add, hz, hz']

theorem compTT_inclTT_of_ne {ν ν' μ μ' : Multiset I} (h : (ν, ν') ≠ (μ, μ'))
    (z : K0 (G.grade ν) ⊗[LP] K0 (G.grade ν')) : G.compTT μ μ' (G.inclTT ν ν' z) = 0 := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    simp only [compTT, inclTT, TensorProduct.map_tmul, DirectSum.component.of]
    by_cases h1 : ν = μ
    · have h2 : ν' ≠ μ' := fun h2 => h (by rw [h1, h2])
      rw [dif_neg h2, TensorProduct.tmul_zero]
    · rw [dif_neg h1, TensorProduct.zero_tmul]
  | add z z' hz hz' => rw [map_add, map_add, hz, hz', add_zero]

theorem inclTT_of_tmul_of (i j : Multiset I) (a : K0 (G.grade i)) (b : K0 (G.grade j)) :
    (DirectSum.of G.K0fam i a ⊗ₜ[LP] DirectSum.of G.K0fam j b : G.K0R ⊗[LP] G.K0R) =
      G.inclTT i j (a ⊗ₜ b) := by
  rw [inclTT, TensorProduct.map_tmul, DirectSum.lof_eq_of, DirectSum.lof_eq_of]

/-- Every element of `K₀(R) ⊗ K₀(R)` is the finite sum of its components. -/
theorem exists_finset_eq_sum (Z : G.K0R ⊗[LP] G.K0R) :
    ∃ S : Finset (Multiset I × Multiset I), (∀ p ∉ S, G.compTT p.1 p.2 Z = 0) ∧
      Z = ∑ p ∈ S, G.inclTT p.1 p.2 (G.compTT p.1 p.2 Z) := by
  classical
  let Pr : G.K0R ⊗[LP] G.K0R → Prop := fun Z => ∃ S : Finset (Multiset I × Multiset I),
    (∀ p ∉ S, G.compTT p.1 p.2 Z = 0) ∧ Z = ∑ p ∈ S, G.inclTT p.1 p.2 (G.compTT p.1 p.2 Z)
  have h0 : Pr 0 := ⟨∅, fun _ _ => map_zero _, by simp⟩
  have hadd : ∀ Z Z', Pr Z → Pr Z' → Pr (Z + Z') := by
    rintro Z Z' ⟨S, hS, hZ⟩ ⟨S', hS', hZ'⟩
    refine ⟨S ∪ S', fun p hp => ?_, ?_⟩
    · rw [Finset.mem_union, not_or] at hp
      rw [map_add, hS p hp.1, hS' p hp.2, add_zero]
    · have e1 : ∑ p ∈ S ∪ S', G.inclTT p.1 p.2 (G.compTT p.1 p.2 Z) = Z := by
        rw [← Finset.sum_subset Finset.subset_union_left (fun p _ hp => by
          rw [hS p hp, map_zero]), ← hZ]
      have e2 : ∑ p ∈ S ∪ S', G.inclTT p.1 p.2 (G.compTT p.1 p.2 Z') = Z' := by
        rw [← Finset.sum_subset Finset.subset_union_right (fun p _ hp => by
          rw [hS' p hp, map_zero]), ← hZ']
      simp only [map_add, Finset.sum_add_distrib, e1, e2]
  have hof : ∀ (i j : Multiset I) (a : K0 (G.grade i)) (b : K0 (G.grade j)),
      Pr (G.inclTT i j (a ⊗ₜ b)) := by
    intro i j a b
    refine ⟨{(i, j)}, fun p hp => ?_, ?_⟩
    · refine G.compTT_inclTT_of_ne (fun h => hp ?_) _
      rw [Finset.mem_singleton, h]
    · rw [Finset.sum_singleton, compTT_inclTT_self]
  induction Z using TensorProduct.induction_on with
  | zero => exact h0
  | add Z Z' hZ hZ' => exact hadd Z Z' hZ hZ'
  | tmul x y =>
    induction x using DirectSum.induction_on with
    | zero => rw [TensorProduct.zero_tmul]; exact h0
    | add x x' hx hx' => rw [TensorProduct.add_tmul]; exact hadd _ _ hx hx'
    | of i a =>
      induction y using DirectSum.induction_on with
      | zero => rw [TensorProduct.tmul_zero]; exact h0
      | add y y' hy hy' => rw [TensorProduct.tmul_add]; exact hadd _ _ hy hy'
      | of j b => rw [inclTT_of_tmul_of]; exact hof i j a b

/-- The components `compTT ν ν'` jointly detect elements of `K₀(R) ⊗ K₀(R)`. -/
theorem ext_compTT {X Y : G.K0R ⊗[LP] G.K0R} (h : ∀ ν ν', G.compTT ν ν' X = G.compTT ν ν' Y) :
    X = Y := by
  obtain ⟨S, -, hS⟩ := G.exists_finset_eq_sum (X - Y)
  have : X - Y = 0 := by
    rw [hS]
    exact Finset.sum_eq_zero fun p _ => by rw [map_sub, h, sub_self, map_zero]
  exact sub_eq_zero.1 this

end Components

/-! ### The coproduct `Δ = [Res]` -/

section Coprod

/-- **`Δ = [Res] : K₀(R) → K₀(R) ⊗ K₀(R)`** (KL I, §3.1): on `K₀(R(μ))`, the sum over the
decompositions `μ = ν + ν'` of `[Res_{ν,ν'}]`, followed by
`K₀(R(ν) ⊗ R(ν')) ≅ K₀(R(ν)) ⊗ K₀(R(ν'))`. -/
def coprod : G.K0R →ₗ[LP] G.K0R ⊗[LP] G.K0R :=
  DirectSum.toModule LP (Multiset I) _ fun μ =>
    ∑ p ∈ (Multiset.antidiagonal μ).toFinset,
      G.inclTT p.1 p.2 ∘ₗ (G.k0TensorEquiv hPQ hP hG p.1 p.2).symm.toLinearMap ∘ₗ
        G.resComp p.1 p.2 hPQ hP ∘ₗ DirectSum.lof LP (Multiset I) G.K0fam μ

/-- **`Δ` is `[Res]`**: the `(ν, ν')`-component of `Δ x` is `[Res_{ν,ν'}] x_{ν+ν'}` under
`K₀(R(ν)) ⊗ K₀(R(ν')) ≅ K₀(R(ν) ⊗ R(ν'))`. -/
theorem coprod_spec (ν ν' : Multiset I) (x : G.K0R) :
    G.k0TensorEquiv hPQ hP hG ν ν' (G.compTT ν ν' (G.coprod hPQ hP hG x)) =
      G.resComp ν ν' hPQ hP x := by
  classical
  rw [← LinearEquiv.eq_symm_apply]
  induction x using DirectSum.induction_on with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  | of μ y =>
    rw [coprod, ← DirectSum.lof_eq_of LP, DirectSum.toModule_lof, LinearMap.sum_apply, map_sum]
    by_cases hμ : ν + ν' = μ
    · rw [Finset.sum_eq_single (ν, ν')]
      · simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
        rw [compTT_inclTT_self]
      · intro p _ hp
        simp only [LinearMap.comp_apply]
        exact G.compTT_inclTT_of_ne hp _
      · intro h
        exact absurd (Multiset.mem_toFinset.2 (Multiset.mem_antidiagonal.2 hμ)) h
    · have h0 : G.resComp ν ν' hPQ hP (DirectSum.lof LP (Multiset I) G.K0fam μ y) = 0 := by
        rw [resComp, LinearMap.comp_apply, DirectSum.component.of, dif_neg (Ne.symm hμ),
          map_zero]
      rw [h0, map_zero]
      refine Finset.sum_eq_zero fun p hp => ?_
      simp only [LinearMap.comp_apply]
      refine G.compTT_inclTT_of_ne ?_ _
      intro h
      obtain ⟨h1, h2⟩ := Prod.mk_inj.1 h
      apply hμ
      rw [← h1, ← h2]
      exact Multiset.mem_antidiagonal.1 (Multiset.mem_toFinset.1 hp)

theorem compTT_coprod (ν ν' : Multiset I) (x : G.K0R) :
    G.compTT ν ν' (G.coprod hPQ hP hG x) =
      (G.k0TensorEquiv hPQ hP hG ν ν').symm (G.resComp ν ν' hPQ hP x) := by
  rw [LinearEquiv.eq_symm_apply, coprod_spec]

/-- `Δ` is the unique map whose components are `[Res_{ν,ν'}]`. -/
theorem eq_coprod_of_spec (D : G.K0R →ₗ[LP] G.K0R ⊗[LP] G.K0R)
    (hD : ∀ ν ν' x, G.k0TensorEquiv hPQ hP hG ν ν' (G.compTT ν ν' (D x)) =
      G.resComp ν ν' hPQ hP x) : D = G.coprod hPQ hP hG :=
  LinearMap.ext fun x => G.ext_compTT fun ν ν' =>
    (G.k0TensorEquiv hPQ hP hG ν ν').injective (by rw [hD, coprod_spec])

end Coprod

/-! ### The twisted multiplication (3.1) -/

section TwMul

/-- Multiplication by `q^{λ ⋄ |x|}` on homogeneous `x`:
`x ↦ q^{∑_{a ∈ λ, c ∈ |x|} degΨ(a, c)} x`. -/
def twistOp (l : Multiset I) : G.K0R →ₗ[LP] G.K0R :=
  DirectSum.toModule LP (Multiset I) _ fun μ =>
    (T (wdot G.degΨ l μ) : LP) • DirectSum.lof LP (Multiset I) G.K0fam μ

theorem twistOp_of (l μ : Multiset I) (y : K0 (G.grade μ)) :
    G.twistOp l (DirectSum.of G.K0fam μ y) =
      (T (wdot G.degΨ l μ) : LP) • DirectSum.of G.K0fam μ y := by
  rw [twistOp, ← DirectSum.lof_eq_of LP, DirectSum.toModule_lof, LinearMap.smul_apply]

/-- The bilinear map behind `twMul`: `x₁ ↦ x₂ ↦ (y₁ ⊗ y₂ ↦ x₁ τ_{|x₂|}(y₁) ⊗ x₂ y₂)`. -/
def twMulAux : G.K0R →ₗ[LP] G.K0R →ₗ[LP] Module.End LP (G.K0R ⊗[LP] G.K0R) :=
  (DirectSum.toModule LP (Multiset I) _ fun μ₂ =>
    ((TensorProduct.mapBilinear LP G.K0R G.K0R G.K0R G.K0R ∘ₗ
        LinearMap.lcomp LP G.K0R (G.twistOp μ₂) ∘ₗ LinearMap.mul LP G.K0R).compl₂
      (LinearMap.mul LP G.K0R ∘ₗ DirectSum.lof LP (Multiset I) G.K0fam μ₂)).flip).flip

/-- **The twisted multiplication (3.1) on `K₀(R) ⊗ K₀(R)`**:
`(x₁ ⊗ x₂)(x₁' ⊗ x₂') = q^{|x₂| ⋄ |x₁'|} x₁x₁' ⊗ x₂x₂'` for homogeneous `x₂`, `x₁'`, where
`μ ⋄ μ' = ∑_{a ∈ μ, c ∈ μ'} degΨ(a, c)` (for the KL I grading, `q^{-|x₂|·|x₁'|}`). -/
def twMul : G.K0R ⊗[LP] G.K0R →ₗ[LP] G.K0R ⊗[LP] G.K0R →ₗ[LP] G.K0R ⊗[LP] G.K0R :=
  TensorProduct.lift G.twMulAux

theorem twMul_tmul_of (x₁ : G.K0R) (μ₂ : Multiset I) (b : K0 (G.grade μ₂)) (y₁ y₂ : G.K0R) :
    G.twMul (x₁ ⊗ₜ DirectSum.of G.K0fam μ₂ b) (y₁ ⊗ₜ y₂) =
      (x₁ * G.twistOp μ₂ y₁) ⊗ₜ (DirectSum.of G.K0fam μ₂ b * y₂) := by
  rw [twMul, TensorProduct.lift.tmul, twMulAux, LinearMap.flip_apply, ← DirectSum.lof_eq_of LP,
    DirectSum.toModule_lof]
  rfl

/-- `(x₁ ⊗ x₂)(x₁' ⊗ x₂') = q^{|x₂| ⋄ |x₁'|} x₁x₁' ⊗ x₂x₂'` for homogeneous `x₂`, `x₁'`. -/
theorem twMul_tmul (x₁ : G.K0R) {μ₂ μ₁' : Multiset I} (b : K0 (G.grade μ₂))
    (a' : K0 (G.grade μ₁')) (y₂ : G.K0R) :
    G.twMul (x₁ ⊗ₜ DirectSum.of G.K0fam μ₂ b) (DirectSum.of G.K0fam μ₁' a' ⊗ₜ y₂) =
      (T (wdot G.degΨ μ₂ μ₁') : LP) •
        ((x₁ * DirectSum.of G.K0fam μ₁' a') ⊗ₜ (DirectSum.of G.K0fam μ₂ b * y₂)) := by
  rw [twMul_tmul_of, twistOp_of, mul_smul_comm, TensorProduct.smul_tmul']

/-- Induction on `K₀(R) ⊗ K₀(R)` through homogeneous pure tensors. -/
theorem induction_homog {motive : G.K0R ⊗[LP] G.K0R → Prop} (Z : G.K0R ⊗[LP] G.K0R)
    (zero : motive 0) (add : ∀ Z Z', motive Z → motive Z' → motive (Z + Z'))
    (of : ∀ (μ μ' : Multiset I) (a : K0 (G.grade μ)) (b : K0 (G.grade μ')),
      motive (DirectSum.of G.K0fam μ a ⊗ₜ DirectSum.of G.K0fam μ' b)) : motive Z := by
  induction Z using TensorProduct.induction_on with
  | zero => exact zero
  | add Z Z' hZ hZ' => exact add Z Z' hZ hZ'
  | tmul x y =>
    induction x using DirectSum.induction_on with
    | zero => rw [TensorProduct.zero_tmul]; exact zero
    | add x x' hx hx' => rw [TensorProduct.add_tmul]; exact add _ _ hx hx'
    | of i a =>
      induction y using DirectSum.induction_on with
      | zero => rw [TensorProduct.tmul_zero]; exact zero
      | add y y' hy hy' => rw [TensorProduct.tmul_add]; exact add _ _ hy hy'
      | of j b => exact of i j a b

theorem twistOp_zero : G.twistOp 0 = LinearMap.id :=
  DirectSum.linearMap_ext LP fun μ => LinearMap.ext fun y => by
    rw [LinearMap.comp_apply, DirectSum.lof_eq_of, twistOp_of, wdot_zero_left, T_zero, one_smul]
    rfl

theorem twistOp_one (l : Multiset I) : G.twistOp l 1 = 1 := by
  rw [K0R_one, twistOp_of, wdot_zero_right, T_zero, one_smul]

set_option synthInstance.maxHeartbeats 400000 in
/-- `1 ⊗ 1` is a left unit for the twisted multiplication. -/
theorem twMul_one_left (X : G.K0R ⊗[LP] G.K0R) : G.twMul (1 ⊗ₜ 1) X = X := by
  induction X using TensorProduct.induction_on with
  | zero => rw [LinearMap.map_zero]
  | add X X' hX hX' => rw [LinearMap.map_add, hX, hX']
  | tmul y₁ y₂ =>
    rw [show (1 : G.K0R) ⊗ₜ[LP] (1 : G.K0R) =
        1 ⊗ₜ DirectSum.of G.K0fam 0 (K0.of (GProj.regular (G.grade 0))) from rfl, twMul_tmul_of,
      ← K0R_one, twistOp_zero, LinearMap.id_apply, one_mul, one_mul]

set_option synthInstance.maxHeartbeats 400000 in
/-- `1 ⊗ 1` is a right unit for the twisted multiplication. -/
theorem twMul_one_right (X : G.K0R ⊗[LP] G.K0R) : G.twMul X (1 ⊗ₜ 1) = X := by
  induction X using G.induction_homog with
  | zero => rw [LinearMap.map_zero, LinearMap.zero_apply]
  | add X X' hX hX' => rw [LinearMap.map_add, LinearMap.add_apply, hX, hX']
  | of μ μ' a b => rw [twMul_tmul_of, twistOp_one, mul_one, mul_one]

set_option synthInstance.maxHeartbeats 400000 in
/-- **The twisted multiplication (3.1) is associative.** -/
theorem twMul_assoc (X Y Z : G.K0R ⊗[LP] G.K0R) :
    G.twMul (G.twMul X Y) Z = G.twMul X (G.twMul Y Z) := by
  induction X using G.induction_homog with
  | zero => simp only [LinearMap.map_zero, LinearMap.zero_apply]
  | add X X' hX hX' => simp only [LinearMap.map_add, LinearMap.add_apply, hX, hX']
  | of μ₁ μ₂ a₁ a₂ =>
    induction Y using G.induction_homog with
    | zero => simp only [LinearMap.map_zero, LinearMap.zero_apply]
    | add Y Y' hY hY' => simp only [LinearMap.map_add, LinearMap.add_apply, hY, hY']
    | of μ₃ μ₄ a₃ a₄ =>
      induction Z using G.induction_homog with
      | zero => simp only [LinearMap.map_zero, LinearMap.zero_apply]
      | add Z Z' hZ hZ' => simp only [LinearMap.map_add, LinearMap.add_apply, hZ, hZ']
      | of μ₅ μ₆ a₅ a₆ =>
        rw [twMul_tmul, K0R_of_mul_of G a₂ a₄, LinearMap.map_smul, LinearMap.smul_apply,
