import Categorification.KLR.Cyclotomic
import Categorification.KLR.Examples.NonInteracting

/-!
# Cyclotomic KLR algebras with pairwise distinct, non-adjacent labels

Let the labels of `ν` be pairwise distinct (`ν.Nodup`) and pairwise non-adjacent
(`Q_{ij} = 1` for distinct `i, j ∈ ν`), and let every cyclotomic polynomial `a_i` be monic. Then
the cyclotomic quotient `R^Λ(ν)` (Kang–Kashiwara, arXiv:1102.4677v4, Def. 4.1;
`Categorification.KLR.Cyclotomic`) has an explicit description: for sequences `𝐢, 𝐢'` and the
permutation `w` with `w • 𝐢' = 𝐢`, the corner `e(𝐢) R^Λ(ν) e(𝐢')` is a free `k`-module with
basis `ψ_{ρ w} x^c e(𝐢')`, `0 ≤ c_p < deg a_{i'_p}`. This is the rank-one computation used in
the proof of Webster, *Unfurling Khovanov–Lauda–Rouquier algebras*, arXiv:1603.06311v3,
Thm. `nondegenerate` (the case where every strand carries its own label and the labels are
pairwise non-adjacent).

## Main results

* `KLRAlgebra.ψ_mul_ψ_of_nodup`, `KLRAlgebra.x_mul_ψ_of_nodup`, `KLRAlgebra.pol_mul_ψw_of_nodup`,
  `KLRAlgebra.ψw_reverse_mul_ψw_of_nodup`: in `R(ν)`, `ψ_j² = 1`, dots pass through crossings
  with relabelling, and products of crossings are invertible.
* `CycKLR.mk_aeval_x_mul_e_of_nodup`: in `R^Λ(ν)`, `a_{i_p}(x_p) e(𝐢) = 0` for every position
  `p`.
* `CycKLR.cornerBasis`, `CycKLR.cornerBasis_apply`: the basis of `e(𝐢) R^Λ(ν) e(𝐢')`;
  `CycKLR.finrank_corner`: its rank is `∏_p deg a_{i'_p}`.

## Method

Spanning: the spanning set of `R(ν)` (`KLRAlgebra.mem_span_corner'`), the cyclotomic relation
on every strand, and division by the monic polynomials `a_{i'_q}(x_q)` in
`k[x_1, …, x_m]` (`exists_boxSupported_sub_mem`). Linear independence: `R(ν)` acts on
`⊕_𝐬 k[x_1, …, x_m]` (`NonInteracting.toEnd`, dots acting through the variable attached to their
label); elements of the cyclotomic ideal act with values in `J · ⊕_𝐬 k[x]`, where `J` is the
ideal generated by the `a_{i'_q}(x_q)`, and the monomials `x^c`, `c_q < deg a_{i'_q}`, are linearly
independent modulo `J` (`eq_zero_of_boxSupported_of_mem`, by induction on the number of
variables).
-/

namespace Categorification.KLR

open MvPolynomial Equiv TypeA KLRAlgebra
open scoped Polynomial

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k]

/-! ### Division by monic polynomials in separate variables -/

/-- The ideal of `k[x_0, …, x_{n-1}]` generated by `b_q(x_q)`. -/
noncomputable def boxIdeal {n : ℕ} (b : Fin n → Polynomial k) : Ideal (MvPolynomial (Fin n) k) :=
  Ideal.span (Set.range fun q => Polynomial.aeval (X q) (b q))

/-- `f` only involves monomials `x^s` with `s_q < deg b_q` for all `q`. -/
def BoxSupported {n : ℕ} (b : Fin n → Polynomial k) (f : MvPolynomial (Fin n) k) : Prop :=
  ∀ s, f.coeff s ≠ 0 → ∀ q, s q < (b q).natDegree

section step

variable {n : ℕ} (b : Fin (n + 1) → Polynomial k)


private theorem finSuccEquiv_aeval (q : Fin (n + 1)) (p : Polynomial k) :
    finSuccEquiv k n (Polynomial.aeval (X q) p) = Polynomial.aeval (finSuccEquiv k n (X q)) p :=
  (Polynomial.aeval_algHom_apply _ _ _).symm

private theorem finSuccEquiv_aeval_zero (p : Polynomial k) :
    finSuccEquiv k n (Polynomial.aeval (X 0) p) =
      p.map (algebraMap k (MvPolynomial (Fin n) k)) := by
  rw [finSuccEquiv_aeval, finSuccEquiv_X_zero,
    ← Polynomial.aeval_map_algebraMap (MvPolynomial (Fin n) k),
    Polynomial.aeval_X_left_apply]

private theorem finSuccEquiv_aeval_succ (q : Fin n) (p : Polynomial k) :
    finSuccEquiv k n (Polynomial.aeval (X q.succ) p) = Polynomial.C (Polynomial.aeval (X q) p) := by
  rw [finSuccEquiv_aeval, finSuccEquiv_X_succ]
  exact Polynomial.aeval_algHom_apply
    (Polynomial.CAlgHom (R := k) (A := MvPolynomial (Fin n) k)) (X q) p

private theorem boxIdeal_le_comap :
    boxIdeal b ≤ Ideal.comap (finSuccEquiv k n)
      (Ideal.span {(b 0).map (algebraMap k (MvPolynomial (Fin n) k))} ⊔
        Ideal.map Polynomial.C (boxIdeal (Fin.tail b))) := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨q, rfl⟩
  refine Fin.cases ?_ (fun q => ?_) q
  · show _ ∈ Ideal.comap _ _
    rw [Ideal.mem_comap, finSuccEquiv_aeval_zero]
    exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  · show _ ∈ Ideal.comap _ _
    rw [Ideal.mem_comap, finSuccEquiv_aeval_succ]
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨q, rfl⟩))

private theorem le_comap_boxIdeal :
    Ideal.span {(b 0).map (algebraMap k (MvPolynomial (Fin n) k))} ⊔
        Ideal.map Polynomial.C (boxIdeal (Fin.tail b)) ≤
      Ideal.comap (finSuccEquiv k n).symm (boxIdeal b) := by
  refine sup_le ?_ ?_
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
      ← finSuccEquiv_aeval_zero, AlgEquiv.symm_apply_apply]
    exact Ideal.subset_span ⟨0, rfl⟩
  · rw [Ideal.map_le_iff_le_comap, boxIdeal, Ideal.span_le]
    rintro _ ⟨q, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap]
    change (finSuccEquiv k n).symm (Polynomial.C (Polynomial.aeval (X q) (b q.succ))) ∈ _
    rw [← finSuccEquiv_aeval_succ, AlgEquiv.symm_apply_apply]
    exact Ideal.subset_span ⟨q.succ, rfl⟩

end step

/-- For monic `b_q`, the monomials `x^s` with `s_q < deg b_q` are linearly independent modulo the
ideal generated by the `b_q(x_q)`: a polynomial supported on them and lying in that ideal is
zero. -/
theorem eq_zero_of_boxSupported_of_mem {n : ℕ} (b : Fin n → Polynomial k)
    (hb : ∀ q, (b q).Monic) {f : MvPolynomial (Fin n) k} (hf : BoxSupported b f)
    (hJ : f ∈ boxIdeal b) : f = 0 := by
  induction n with
  | zero =>
    have : boxIdeal b = ⊥ := by
      rw [boxIdeal, Set.range_eq_empty, Ideal.span_empty]
    rwa [this, Ideal.mem_bot] at hJ
  | succ n ih =>
    cases subsingleton_or_nontrivial k with
    | inl _ => exact Subsingleton.elim _ _
    | inr _ =>
    set φ := finSuccEquiv k n
    set β := (b 0).map (algebraMap k (MvPolynomial (Fin n) k))
    have hβ : β.Monic := (hb 0).map _
    set J' := boxIdeal (Fin.tail b)
    have hmem := boxIdeal_le_comap b hJ
    rw [Ideal.mem_comap] at hmem
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.1 hmem
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hy
    -- the coefficients of `φ f`
    have hcoeff : ∀ (j : ℕ) (s : Fin n →₀ ℕ), ((φ f).coeff j).coeff s ≠ 0 →
        j < (b 0).natDegree ∧ ∀ q, s q < (b q.succ).natDegree := by
      intro j s h
      rw [finSuccEquiv_coeff_coeff] at h
      have := hf _ h
      refine ⟨by simpa using this 0, fun q => by simpa using this q.succ⟩
    have hdeg : (φ f).degree < β.degree := by
      rw [(hb 0).degree_map, Polynomial.degree_eq_natDegree (hb 0).ne_zero,
        Polynomial.degree_lt_iff_coeff_zero]
      intro j hj
      ext s
      by_contra h
      exact absurd (hcoeff j s h).1 (not_lt.2 hj)
    have hF : φ f = z %ₘ β := by
      rw [← (Polynomial.modByMonic_eq_self_iff hβ).2 hdeg]
      exact Polynomial.modByMonic_eq_of_dvd_sub hβ ⟨c, by rw [← hyz]; ring⟩
    have hz0 : z.map (Ideal.Quotient.mk J') = 0 := by
      ext j
      rw [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_C_iff.1 hz j
    have hF0 : (φ f).map (Ideal.Quotient.mk J') = 0 := by
      rw [hF, Polynomial.map_modByMonic _ hβ, hz0, Polynomial.zero_modByMonic]
    have hφ : φ f = 0 := by
      ext j : 1
      have hj : (φ f).coeff j ∈ J' := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, ← Polynomial.coeff_map, hF0, Polynomial.coeff_zero]
      rw [Polynomial.coeff_zero]
      refine ih (Fin.tail b) (fun q => hb q.succ) (fun s hs q => ?_) hj
      exact (hcoeff j s hs).2 q
    rw [← map_zero φ] at hφ
    exact φ.injective hφ

/-- Division by the monic `b_q(x_q)`: every polynomial is congruent, modulo the ideal they
generate, to one supported on the monomials `x^s` with `s_q < deg b_q`. -/
theorem exists_boxSupported_sub_mem {n : ℕ} (b : Fin n → Polynomial k)
    (hb : ∀ q, (b q).Monic) (f : MvPolynomial (Fin n) k) :
    ∃ g, BoxSupported b g ∧ f - g ∈ boxIdeal b := by
  induction n with
  | zero => exact ⟨f, fun _ _ q => q.elim0, by rw [sub_self]; exact zero_mem _⟩
  | succ n ih =>
    cases subsingleton_or_nontrivial k with
    | inl _ =>
      exact ⟨f, fun s h => absurd (Subsingleton.elim _ _) h, by rw [sub_self]; exact zero_mem _⟩
    | inr _ =>
    set φ := finSuccEquiv k n
    set β := (b 0).map (algebraMap k (MvPolynomial (Fin n) k))
    have hβ : β.Monic := (hb 0).map _
    set J' := boxIdeal (Fin.tail b)
    set d := (b 0).natDegree
    set R := φ f %ₘ β
    have hR : ∀ j, d ≤ j → R.coeff j = 0 := by
      intro j hj
      apply Polynomial.coeff_eq_zero_of_degree_lt
      refine lt_of_lt_of_le (Polynomial.degree_modByMonic_lt _ hβ) ?_
      rw [(hb 0).degree_map, Polynomial.degree_eq_natDegree (hb 0).ne_zero]
      exact_mod_cast hj
    choose g hg using fun j => ih (Fin.tail b) (fun q => hb q.succ) (R.coeff j)
    set G : Polynomial (MvPolynomial (Fin n) k) :=
      ∑ j ∈ Finset.range d, Polynomial.monomial j (g j)
    have hG : ∀ j, G.coeff j = if j < d then g j else 0 := by
      intro j
      simp only [G, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
      rw [Finset.sum_ite_eq' (Finset.range d) j g]
      simp only [Finset.mem_range]
    refine ⟨φ.symm G, fun s hs q => ?_, ?_⟩
    · have key := finSuccEquiv_coeff_coeff (Finsupp.tail s) (φ.symm G) (s 0)
      rw [Finsupp.cons_tail, AlgEquiv.apply_symm_apply, hG] at key
      rw [← key] at hs
      split_ifs at hs with hlt
      · refine Fin.cases hlt (fun q => ?_) q
        exact (hg (s 0)).1 (Finsupp.tail s) hs q
      · simp at hs
    · have hmem : φ (f - φ.symm G) ∈
          Ideal.span {β} ⊔ Ideal.map Polynomial.C J' := by
        have hsplit : φ (f - φ.symm G) = β * (φ f /ₘ β) + (R - G) := by
          rw [map_sub, AlgEquiv.apply_symm_apply]
          have := Polynomial.modByMonic_add_div (φ f) β
          linear_combination -this
        rw [hsplit]
        refine add_mem (Ideal.mem_sup_left (Ideal.mem_span_singleton'.2 ⟨_, mul_comm _ _⟩))
          (Ideal.mem_sup_right (Ideal.mem_map_C_iff.2 fun j => ?_))
        rw [Polynomial.coeff_sub, hG]
        split_ifs with hlt
        · exact (hg j).2
        · rw [hR j (not_lt.1 hlt), sub_zero]; exact zero_mem _
      have := le_comap_boxIdeal b hmem
      rwa [Ideal.mem_comap, AlgEquiv.symm_apply_apply] at this


/-! ### Crossings and dots for pairwise distinct, non-adjacent labels -/

namespace KLRAlgebra

variable {Q : I → I → MvPolynomial (Fin 2) k} {ν : Multiset I}

local notation "m" => Multiset.card ν

section relations

variable (hnd : ν.Nodup)

omit [DecidableEq I] in
include hnd in
/-- Adjacent strands carry distinct labels when the labels of `ν` are pairwise distinct. -/
theorem lbl_ne_lbl_succ (i : Seq ν) {j : ℕ} (h : j + 1 < m) :
    i.lbl ⟨j, by omega⟩ ≠ i.lbl ⟨j + 1, h⟩ := fun e => by
  have := NonInteracting.seq_injective hnd i e
  simp [Fin.ext_iff] at this

include hnd in
/-- For pairwise distinct labels, a dot slides through a crossing, moving to the other strand:
`x_p ψ_j = ψ_j x_{s_j p}`. -/
theorem x_mul_ψ_of_nodup (p : Fin m) (j : ℕ) :
    (x p * ψ j : KLRAlgebra k Q ν) = ψ j * x (sadj m j p) := by
  by_cases h : j + 1 < m
  · have hsum : ∀ u v : KLRAlgebra k Q ν, (∀ i : Seq ν, u * e i = v * e i) → u = v := by
      intro u v huv
      rw [← mul_one u, ← mul_one v, ← sum_e, Finset.mul_sum, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => huv i
    by_cases hp : p.val = j
    · rcases p with ⟨p, hp0⟩
      simp only at hp
      subst hp
      rw [sadj_apply_left h]
      refine sub_eq_zero.1 (hsum _ 0 fun i => ?_)
      rw [zero_mul, dot_cross_left _ h i, ite_eq_right (lbl_ne_lbl_succ hnd i h)]
    by_cases hp' : p.val = j + 1
    · rcases p with ⟨p, hp0⟩
      simp only at hp'
      subst hp'
      rw [sadj_apply_right h]
      refine (sub_eq_zero.1 (hsum _ 0 fun i => ?_)).symm
      rw [zero_mul, dot_cross_right j h i, ite_eq_right (lbl_ne_lbl_succ hnd i h)]
    · rw [sadj_apply_of_ne p hp hp', x_mul_ψ p j hp hp']
  · rw [ψ_eq_zero j (by omega), zero_mul, mul_zero]

include hnd in
/-- Dots pass through a product of crossings with relabelling:
`x_p ψ_σ = ψ_σ x_{w⁻¹ p}`, `w = wordProd σ`. -/
theorem x_mul_ψw_of_nodup (p : Fin m) (σ : List ℕ) :
    (x p * ψw σ : KLRAlgebra k Q ν) = ψw σ * x ((wordProd m σ)⁻¹ p) := by
  induction σ generalizing p with
  | nil => simp
  | cons j σ ih =>
    rw [ψw_cons, ← mul_assoc, x_mul_ψ_of_nodup hnd, mul_assoc, ih, ← mul_assoc, wordProd_cons,
      mul_inv_rev, Perm.mul_apply, sadj_inv]

include hnd in
/-- Polynomials in the dots pass through a product of crossings with relabelling:
`f(x) ψ_σ = ψ_σ (w⁻¹ f)(x)`, `w = wordProd σ`. -/
theorem pol_mul_ψw_of_nodup (f : MvPolynomial (Fin m) k) (σ : List ℕ) :
    (pol f * ψw σ : KLRAlgebra k Q ν) = ψw σ * pol (rename ⇑(wordProd m σ)⁻¹ f) := by
  induction f using MvPolynomial.induction_on with
  | C c => rw [algHom_C, rename_C, algHom_C, Algebra.commutes]
  | add f g hf hg => rw [map_add, add_mul, hf, hg, map_add, map_add, mul_add]
  | mul_X f p hf =>
    rw [map_mul, pol_X, mul_assoc, x_mul_ψw_of_nodup hnd, ← mul_assoc, hf, map_mul, rename_X,
      map_mul, pol_X, mul_assoc]

variable (hQ : ∀ i ∈ ν, ∀ j ∈ ν, i ≠ j → Q i j = 1)

include hnd hQ in
/-- For pairwise distinct labels with `Q = 1`, every crossing squares to the identity:
`ψ_j² = 1` (`j + 1 < m`). -/
theorem ψ_mul_ψ_of_nodup {j : ℕ} (h : j + 1 < m) : (ψ j * ψ j : KLRAlgebra k Q ν) = 1 := by
  calc (ψ j * ψ j : KLRAlgebra k Q ν) = ∑ i, ψ j * ψ j * e i := by
        rw [← Finset.mul_sum, sum_e, mul_one]
    _ = ∑ i, e i := Finset.sum_congr rfl fun i _ => by
        have hne := lbl_ne_lbl_succ hnd i h
        rw [ψ_sq j h i, ite_eq_right hne, hQ _ (i.mem _) _ (i.mem _) hne, NonInteracting.ncEval_one,
          one_mul]
    _ = 1 := sum_e

include hnd hQ in
/-- `ψ_{σ^{rev}} ψ_σ = 1` for every valid word `σ`: products of crossings are invertible. -/
theorem ψw_reverse_mul_ψw_of_nodup {σ : List ℕ} (hσ : ValidWord m σ) :
    (ψw σ.reverse * ψw σ : KLRAlgebra k Q ν) = 1 := by
  induction σ with
  | nil => simp
  | cons j σ ih =>
    rw [List.reverse_cons, ψw_append, ψw_cons, ψw_cons, ψw_nil, mul_one, mul_assoc,
      ← mul_assoc (ψ j), ψ_mul_ψ_of_nodup hnd hQ (hσ j (by simp)), one_mul,
      ih fun l hl => hσ l (by simp [hl])]

include hnd hQ in
/-- `ψ_σ ψ_{σ^{rev}} = 1` for every valid word `σ`. -/
theorem ψw_mul_ψw_reverse_of_nodup {σ : List ℕ} (hσ : ValidWord m σ) :
    (ψw σ * ψw σ.reverse : KLRAlgebra k Q ν) = 1 := by
  simpa using ψw_reverse_mul_ψw_of_nodup hnd hQ (σ := σ.reverse) (validWord_reverse.2 hσ)

end relations

end KLRAlgebra

/-! ### The cyclotomic relation on every strand -/

namespace CycKLR

variable {Q : I → I → MvPolynomial (Fin 2) k} {a : I → Polynomial k} {ν : Multiset I}

local notation "m" => Multiset.card ν

variable (hnd : ν.Nodup) (hQ : ∀ i ∈ ν, ∀ j ∈ ν, i ≠ j → Q i j = 1)

include hnd hQ in
/-- For pairwise distinct labels with `Q = 1`, the cyclotomic relation holds on every strand:
`a_{i_p}(x_p) e(𝐢) = 0` in `R^Λ(ν)`, for every position `p` (Kang–Kashiwara, arXiv:1102.4677v4,
Def. 4.1 imposes it for `p = 1`); obtained by conjugating with crossings. -/
theorem mk_aeval_x_mul_e_of_nodup (i : Seq ν) (p : Fin m) :
    mk k Q a ν (Polynomial.aeval (x p : KLRAlgebra k Q ν) (a (i.lbl p)) * e i) = 0 := by
  have h0 : 0 < m := lt_of_le_of_lt (Nat.zero_le _) p.isLt
  set z : Fin m := ⟨0, h0⟩
  obtain ⟨σ, hσ, hw⟩ := exists_validWord m (swap p z)
  have hj : (swap p z • i).lbl z = i.lbl p := by
    simp [Seq.smul_apply, swap_apply_right]
  have hpol : ∀ q, (Polynomial.aeval (x q : KLRAlgebra k Q ν) (a (i.lbl p))) =
      pol (Polynomial.aeval (X q) (a (i.lbl p))) := fun q => by
    rw [← Polynomial.aeval_algHom_apply, pol_X]
  -- `a_{i_p}(x_p) e(𝐢) = ψ_{σ^{rev}} (a_{i_p}(x_z) e(swap p z • 𝐢)) ψ_σ`
  have key : (Polynomial.aeval (x p : KLRAlgebra k Q ν) (a (i.lbl p)) * e i) =
      ψw σ.reverse * (Polynomial.aeval (x z : KLRAlgebra k Q ν) (a (i.lbl p)) *
        e (swap p z • i)) * ψw σ := by
    rw [mul_assoc (ψw σ.reverse), mul_assoc _ (e _), e_mul_ψw, hw, inv_smul_smul, hpol p, hpol z,
      ← mul_assoc (pol _), pol_mul_ψw_of_nodup hnd, hw, ← mul_assoc, ← mul_assoc,
      ψw_reverse_mul_ψw_of_nodup hnd hQ hσ, one_mul, ← Polynomial.aeval_algHom_apply,
      ← Polynomial.aeval_algHom_apply, rename_X, swap_inv, swap_apply_right,
      Polynomial.aeval_algHom_apply]
  have hz : mk k Q a ν (Polynomial.aeval (x z : KLRAlgebra k Q ν) (a (i.lbl p)) *
      e (swap p z • i)) = 0 := by
    have := mk_aeval_x_mul_e (Q := Q) (a := a) (swap p z • i) h0
    rwa [hj] at this
  rw [key, map_mul, map_mul, hz, mul_zero, zero_mul]

end CycKLR

/-! ### The corner basis -/

namespace CycKLR

variable {Q : I → I → MvPolynomial (Fin 2) k} {a : I → Polynomial k} {ν : Multiset I}

local notation "m" => Multiset.card ν
local notation "Rm" => MvPolynomial (Fin (Multiset.card ν)) k
local notation "V" => (Seq ν → MvPolynomial (Fin (Multiset.card ν)) k)

variable (k Q a) in
/-- The corner `e(𝐣) R^Λ(ν) e(𝐢)`, as a submodule of `R^Λ(ν)`. -/
noncomputable def corner (j i : Seq ν) : Submodule k (CycKLR k Q a ν) :=
  LinearMap.range ((LinearMap.mulLeft k (mk k Q a ν (e j))).comp
    (LinearMap.mulRight k (mk k Q a ν (e i))))

variable (a) in
/-- Exponent vectors `c` with `c_p < deg a_{i_p}` for every position `p`. -/
abbrev DotExp (i : Seq ν) : Type _ := (p : Fin m) → Fin (a (i.lbl p)).natDegree

/-- The exponent vector of `c`, as a finitely supported function. -/
noncomputable def dotExp {i : Seq ν} (c : DotExp a i) : Fin m →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm fun p => (c p : ℕ)

omit [DecidableEq I] in
@[simp] theorem dotExp_apply {i : Seq ν} (c : DotExp a i) (p : Fin m) : dotExp c p = c p := rfl

omit [DecidableEq I] in
theorem dotExp_injective {i : Seq ν} : Function.Injective (dotExp (a := a) (i := i)) :=
  fun c c' h => funext fun p => Fin.ext (by simpa using DFunLike.congr_fun h p)

section rep

variable (hnd : ν.Nodup) (hQ : ∀ i ∈ ν, ∀ j ∈ ν, i ≠ j → Q i j = 1) (i' : Seq ν)

omit [DecidableEq I] in
private theorem var_self : NonInteracting.var hnd i' i' = 1 := by
  have : NonInteracting.toPerm hnd i' i' = 1 :=
    NonInteracting.smul_left_injective hnd i' (by rw [NonInteracting.toPerm_smul, one_smul])
  rw [NonInteracting.var, this]
  rfl

omit [DecidableEq I] in
private theorem mem_smul_top_of_end {J : Ideal Rm} (φ : Module.End Rm V) {f : V}
    (hf : f ∈ J • (⊤ : Submodule Rm V)) : φ f ∈ J • (⊤ : Submodule Rm V) := by
  have : J • (⊤ : Submodule Rm V) ≤ (J • (⊤ : Submodule Rm V)).comap φ :=
    Submodule.smul_le.2 fun r hr n _ => by
    rw [Submodule.mem_comap, map_smul]; exact Submodule.smul_mem_smul hr trivial
  exact this hf

omit [DecidableEq I] in
private theorem apply_mem_of_mem_smul_top {J : Ideal Rm} {f : V} (hf : f ∈ J • (⊤ : Submodule Rm V))
    (t : Seq ν) : f t ∈ J := by
  have : J • (⊤ : Submodule Rm V) ≤
      Submodule.comap (LinearMap.proj (R := Rm) (φ := fun _ : Seq ν => Rm) t)
      (J : Submodule Rm Rm) :=
    Submodule.smul_le.2 fun r hr n _ => by
      simp only [Submodule.mem_comap, LinearMap.coe_proj, Function.eval, Pi.smul_apply,
        smul_eq_mul]
      exact J.mul_mem_right _ hr
  exact this hf

/-- On `⊕_𝐬 k[x]`, the cyclotomic generators act with values in `J • ⊤`, where `J` is the ideal
generated by the `a_{i'_q}(x_q)`. -/
theorem toEnd_cycElt_mem (s : Seq ν) (f : V) :
    NonInteracting.toEnd hnd i' Q hQ (cycElt Q a s) f ∈
      (boxIdeal fun q => a (i'.lbl q)) • (⊤ : Submodule Rm V) := by
  unfold cycElt
  split_ifs with h
  · have hP : Polynomial.aeval (x ⟨0, h⟩ : KLRAlgebra k Q ν) (a (s.lbl ⟨0, h⟩)) =
        pol (Polynomial.aeval (X (⟨0, h⟩ : Fin m)) (a (s.lbl ⟨0, h⟩))) := by
      rw [← Polynomial.aeval_algHom_apply, pol_X]
    have heq : ∀ P : Rm, NonInteracting.toEnd hnd i' Q hQ (pol P * e s) f =
        rename (NonInteracting.var hnd i' s) P • NonInteracting.toEnd hnd i' Q hQ (e s) f := by
      intro P
      funext t
      rw [map_mul, Module.End.mul_apply, NonInteracting.toEnd_pol_apply, Pi.smul_apply,
        smul_eq_mul, NonInteracting.toEnd_e, NonInteracting.opE'_apply]
      split_ifs with ht
      · rw [ht]
      · rw [mul_zero, mul_zero]
    rw [hP, heq]
    refine Submodule.smul_mem_smul ?_ trivial
    rw [← Polynomial.aeval_algHom_apply, rename_X]
    refine Ideal.subset_span ⟨NonInteracting.var hnd i' s ⟨0, h⟩, ?_⟩
    simp only [Seq.lbl, NonInteracting.t₀_var]
  · rw [map_zero, LinearMap.zero_apply]; exact zero_mem _

/-- Elements of the cyclotomic ideal act on `⊕_𝐬 k[x]` with values in `J • ⊤`. -/
theorem toEnd_mem_of_mem_cycIdeal {r : KLRAlgebra k Q ν} (hr : r ∈ cycIdeal Q a ν) (f : V) :
    NonInteracting.toEnd hnd i' Q hQ r f ∈
      (boxIdeal fun q => a (i'.lbl q)) • (⊤ : Submodule Rm V) := by
  let S : TwoSidedIdeal (KLRAlgebra k Q ν) := TwoSidedIdeal.mk'
    {r | ∀ f, NonInteracting.toEnd hnd i' Q hQ r f ∈
      (boxIdeal fun q => a (i'.lbl q)) • (⊤ : Submodule Rm V)}
    (fun f => by rw [map_zero, LinearMap.zero_apply]; exact zero_mem _)
    (fun hx hy f => by rw [map_add, LinearMap.add_apply]; exact add_mem (hx f) (hy f))
    (fun hx f => by rw [map_neg, LinearMap.neg_apply]; exact neg_mem (hx f))
    (fun hy f => by rw [map_mul, Module.End.mul_apply]; exact mem_smul_top_of_end _ (hy f))
    (fun hx f => by rw [map_mul, Module.End.mul_apply]; exact hx _)
  have hle : cycIdeal Q a ν ≤ S := TwoSidedIdeal.span_le.2 (by
    rintro _ ⟨s, rfl⟩
    exact (TwoSidedIdeal.mem_mk' _ _ _ _ _ _ _).2 fun f => toEnd_cycElt_mem hnd hQ i' s f)
  exact (TwoSidedIdeal.mem_mk' _ _ _ _ _ _ _).1 (hle hr) f

private theorem toEnd_ψw_pol_e_single {σ : List ℕ} (hσ : ValidWord m σ) (P : Rm) :
    NonInteracting.toEnd hnd i' Q hQ (ψw σ * pol P * e i') (Pi.single i' 1)
      (wordProd m σ • i') = P := by
  rw [NonInteracting.toEnd_ψw_pol_e_apply hnd i' hQ hσ, inv_smul_smul, ite_eq_left rfl, var_self,
    Pi.single_eq_same, mul_one, Perm.coe_one, rename_id_apply]

include hnd hQ in
/-- In `R^Λ(ν)`, `f(x) e(𝐢') = 0` for every `f` in the ideal generated by the `a_{i'_q}(x_q)`. -/
theorem mk_pol_mul_e_eq_zero {F : Rm} (hF : F ∈ boxIdeal fun q => a (i'.lbl q)) :
    mk k Q a ν (pol F * e i') = 0 := by
  let K : Ideal Rm :=
    { carrier := {F | mk k Q a ν (pol F * e i') = 0}
      add_mem' := fun {F G} hF hG => by
        have hF : mk k Q a ν (pol F * e i') = 0 := hF
        have hG : mk k Q a ν (pol G * e i') = 0 := hG
        show mk k Q a ν (pol (F + G) * e i') = 0
        rw [map_add, add_mul, map_add, hF, hG, add_zero]
      zero_mem' := by
        show mk k Q a ν (pol 0 * e i') = 0
        rw [map_zero, zero_mul, map_zero]
      smul_mem' := fun c F hF => by
        have hF : mk k Q a ν (pol F * e i') = 0 := hF
        show mk k Q a ν (pol (c * F) * e i') = 0
        rw [show (pol (c * F) * e i' : KLRAlgebra k Q ν) = pol c * (pol F * e i') by
          rw [map_mul, mul_assoc], map_mul, hF, mul_zero] }
  have hle : (boxIdeal fun q => a (i'.lbl q)) ≤ K := Ideal.span_le.2 (by
    rintro _ ⟨q, rfl⟩
    show mk k Q a ν (pol (Polynomial.aeval (X q) (a (i'.lbl q))) * e i') = 0
    rw [← Polynomial.aeval_algHom_apply, pol_X]
    exact mk_aeval_x_mul_e_of_nodup hnd hQ i' q)
  exact hle hF

end rep

section basis

variable (hnd : ν.Nodup) (hQ : ∀ i ∈ ν, ∀ j ∈ ν, i ≠ j → Q i j = 1) (ha : ∀ i, (a i).Monic)
  (ρ : Perm (Fin (Multiset.card ν)) → List ℕ)
  (hρ : ∀ w : Perm (Fin (Multiset.card ν)),
    IsReduced (Multiset.card ν) (ρ w) ∧ wordProd (Multiset.card ν) (ρ w) = w)
  (i i' : Seq ν) (w : Perm (Fin (Multiset.card ν))) (hw : w • i' = i)

variable (a) in
/-- The family `ψ_{ρ w} x^c e(𝐢')`, `c_p < deg a_{i'_p}`, in `R^Λ(ν)`. -/
noncomputable def cornerElt (c : DotExp a i') : CycKLR k Q a ν :=
  mk k Q a ν (ψw (ρ w) * pol (monomial (dotExp c) 1) * e i')

include hnd hQ ha hρ in
/-- Linear independence of the `ψ_{ρ w} x^c e(𝐢')`, via the action of `R(ν)` on
`⊕_𝐬 k[x_1, …, x_m]`. -/
theorem linearIndependent_cornerElt :
    LinearIndependent k (cornerElt (Q := Q) a ρ i' w) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg c₀
  have h1 : ∑ c, g c • (ψw (ρ w) * pol (monomial (dotExp c) 1) * e i' : KLRAlgebra k Q ν) ∈
      cycIdeal Q a ν := by
    rw [← mk_eq_zero_iff, map_sum]
    simpa only [map_smul, cornerElt] using hg
  have h2 := apply_mem_of_mem_smul_top (toEnd_mem_of_mem_cycIdeal hnd hQ i' h1 (Pi.single i' 1))
    (wordProd m (ρ w) • i')
  simp only [map_sum, map_smul, LinearMap.sum_apply, Finset.sum_apply, LinearMap.smul_apply,
    Pi.smul_apply, toEnd_ψw_pol_e_single hnd hQ i' (hρ w).1.1] at h2
  have hsupp : BoxSupported (fun q => a (i'.lbl q))
      (∑ c, g c • monomial (dotExp c) (1 : k)) := by
    intro s hs q
    rw [coeff_sum] at hs
    obtain ⟨c, -, hc⟩ := Finset.exists_ne_zero_of_sum_ne_zero hs
    rw [coeff_smul, coeff_monomial] at hc
    split_ifs at hc with he
    · rw [← he]; exact (c q).isLt
    · simp at hc
  have h3 := congrArg (fun P : Rm => P.coeff (dotExp c₀))
    (eq_zero_of_boxSupported_of_mem _ (fun q => ha _) hsupp h2)
  rw [coeff_sum, Finset.sum_eq_single c₀, coeff_smul, coeff_monomial, ite_eq_left rfl, smul_eq_mul,
    mul_one] at h3
  · simpa using h3
  · intro c _ hc
    rw [coeff_smul, coeff_monomial, ite_eq_right (fun h => hc (dotExp_injective h)), smul_zero]
  · intro h; exact absurd (Finset.mem_univ c₀) h

include hnd hQ ha hρ hw in
/-- The `ψ_{ρ w} x^c e(𝐢')` span `e(𝐢) R^Λ(ν) e(𝐢')`. -/
theorem span_cornerElt :
    Submodule.span k (Set.range (cornerElt (Q := Q) a ρ i' w)) = corner k Q a i i' := by
  apply le_antisymm
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨c, rfl⟩
    refine ⟨cornerElt a ρ i' w c, ?_⟩
    simp only [cornerElt, LinearMap.coe_comp, Function.comp_apply, LinearMap.mulRight_apply,
      LinearMap.mulLeft_apply, ← map_mul]
    rw [gen_mul_e, ite_eq_left rfl, e_mul_gen, (hρ w).2, ← hw, inv_smul_smul, ite_eq_left rfl]
  · -- every `ψ_{ρ w} f(x) e(𝐢')` lies in the span
    have hgen : ∀ P : Rm, mk k Q a ν (ψw (ρ w) * pol P * e i') ∈
        Submodule.span k (Set.range (cornerElt (Q := Q) a ρ i' w)) := by
      intro P
      obtain ⟨G, hG, hPG⟩ := exists_boxSupported_sub_mem _ (fun q => ha (i'.lbl q)) P
      have hsplit : (ψw (ρ w) * pol P * e i' : KLRAlgebra k Q ν) =
          ψw (ρ w) * pol G * e i' + ψw (ρ w) * (pol (P - G) * e i') := by
        rw [map_sub]; noncomm_ring
      rw [hsplit, map_add, map_mul (mk k Q a ν) (ψw _), mk_pol_mul_e_eq_zero hnd hQ i' hPG,
        mul_zero, add_zero, G.as_sum, map_sum, Finset.mul_sum, Finset.sum_mul, map_sum]
      refine Submodule.sum_mem _ fun s hs => ?_
      have hs' := hG s (mem_support_iff.1 hs)
      rw [show monomial s (G.coeff s) = G.coeff s • monomial s (1 : k) by
          rw [smul_monomial, smul_eq_mul, mul_one], map_smul, mul_smul_comm, smul_mul_assoc,
        map_smul]
      refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨fun p => ⟨s p, hs' p⟩, ?_⟩)
      rw [cornerElt, show dotExp (fun p => ⟨s p, hs' p⟩ : DotExp a i') = s from
        Finsupp.ext fun p => rfl]
    rintro _ ⟨y, rfl⟩
    obtain ⟨y, rfl⟩ := mk_surjective y
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.mulRight_apply,
      LinearMap.mulLeft_apply, ← map_mul, ← mul_assoc]
    have hr : e i * (e i * y * e i') * e i' = (e i * y * e i' : KLRAlgebra k Q ν) := by
      simp only [← mul_assoc, e_mul_self]; rw [mul_assoc _ (e i'), e_mul_self]
    have hspan := KLRAlgebra.mem_span_corner' ρ hρ i' i hr
    have hle : Submodule.span k {b : KLRAlgebra k Q ν | ∃ (v : Perm (Fin m)) (u : Fin m →₀ ℕ),
        v • i' = i ∧ ψw (ρ v) * pol (monomial u 1) * e i' = b} ≤
        (Submodule.span k (Set.range (cornerElt (Q := Q) a ρ i' w))).comap
          (mk k Q a ν).toLinearMap := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨v, u, hv, rfl⟩
      obtain rfl : v = w := NonInteracting.smul_left_injective hnd i' (hv.trans hw.symm)
      exact hgen _
    exact hle hspan

/-- **The cyclotomic corner for pairwise distinct, non-adjacent labels.** Let the labels of `ν`
be pairwise distinct with `Q_{ij} = 1` for distinct `i, j ∈ ν`, and let every `a_i` be monic.
For sequences `𝐢, 𝐢'` and the permutation `w` with `w • 𝐢' = 𝐢` (it exists and is unique:
`NonInteracting.exists_smul_eq`, `NonInteracting.smul_left_injective`), the corner
`e(𝐢) R^Λ(ν) e(𝐢')` of the cyclotomic quotient (Kang–Kashiwara, arXiv:1102.4677v4, Def. 4.1) is a
free `k`-module with basis `ψ_{ρ w} x^c e(𝐢')`, `0 ≤ c_p < deg a_{i'_p}`, for any choice of
reduced words `ρ`. No assumption on `k` beyond commutativity is needed.

This is the rank-one computation used in the proof of Webster, *Unfurling
Khovanov–Lauda–Rouquier algebras*, arXiv:1603.06311v3, Thm. `nondegenerate` (the case where
every strand carries its own label and the labels are pairwise non-adjacent). -/
noncomputable def cornerBasis : Module.Basis (DotExp a i') k (corner k Q a i i') :=
  (Module.Basis.span (linearIndependent_cornerElt hnd hQ ha ρ hρ i' w)).map
    (LinearEquiv.ofEq _ _ (span_cornerElt hnd hQ ha ρ hρ i i' w hw))

theorem cornerBasis_apply (c : DotExp a i') :
    (cornerBasis hnd hQ ha ρ hρ i i' w hw c : CycKLR k Q a ν) =
      mk k Q a ν (ψw (ρ w) * pol (monomial (dotExp c) 1) * e i') := by
  simp [cornerBasis, Module.Basis.span_apply, cornerElt]

include hnd hQ ha hρ hw in
/-- The rank of `e(𝐢) R^Λ(ν) e(𝐢')` is `∏_p deg a_{i'_p}`. -/
theorem finrank_corner [Nontrivial k] :
    Module.finrank k (corner k Q a i i') = ∏ p, (a (i'.lbl p)).natDegree := by
  rw [Module.finrank_eq_card_basis (cornerBasis hnd hQ ha ρ hρ i i' w hw), Fintype.card_pi]
  simp

end basis

end CycKLR

end Categorification.KLR
