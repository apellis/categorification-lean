import Categorification.TensorProductCategorification.IdempotentStratification
import Categorification.Algebra.CornerLocalization
import Mathlib.Algebra.Module.Torsion.Basic
import Mathlib.RingTheory.Idempotents
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# The quotient functors `π_ξ` of an idempotent stratification

I. Losev, B. Webster, *On uniqueness of tensor products of irreducible categorifications*,
arXiv:1303.1336v3, Definition 2.1: the quotient `C_ξ = C_{≤ξ}/C_{<ξ}` and the functor
`π_ξ : C_{≤ξ} ⥤ C_ξ`, for modules over a ring `A` stratified by orthogonal idempotents
`e : T → A` with labels `β : T → Ξ` (to be applied to Webster's algebras `T^λ`,
arXiv:1309.3796v3, Corollary 5.27).

Let `I_ξ ⊆ A` be the two-sided ideal generated by the `e(t)` with `¬ β t ≤ ξ`, so that
`C_{≤ξ}` (`supportedIn e β (Set.Iic ξ)`) is the category of `A ⧸ I_ξ`-modules, and let
`e_ξ = ∑_{β t = ξ} e(t)`, with image `ē_ξ` in `A ⧸ I_ξ`. The quotient category is the category
of modules over the corner ring `ē_ξ (A ⧸ I_ξ) ē_ξ`, and `π_ξ M = e_ξ M`.

## Main results

* `stratumEquivalence`: `ModuleCat (A ⧸ I_ξ) ≌ C_{≤ξ}` (restriction of scalars).
* `stratumQuotient`: the functor `π_ξ : C_{≤ξ} ⥤ ModuleCat (ē_ξ (A ⧸ I_ξ) ē_ξ)`, `M ↦ e_ξ M`.
* `stratumQuotient_kernel`: the kernel of `π_ξ` is `C_{<ξ}` (`supportedLtIn`).
* `stratumQuotient_isLocalization`: `π_ξ` is the localization of `C_{≤ξ}` at the morphisms
  that are isomorphisms modulo `C_{<ξ}`.
-/

namespace Categorification.TensorProductCategorification

open CategoryTheory Limits

universe u

noncomputable section

section Idempotent

variable {A : Type u} [Ring A] {T : Type*} [Fintype T] (e : T → A) {Ξ : Type*} (β : T → Ξ)
  (ξ : Ξ)

open Classical in
/-- The idempotent `e_ξ = ∑_{β t = ξ} e(t)`. -/
def stratumIdempotent : A := ∑ t ∈ Finset.univ.filter (β · = ξ), e t

variable {e}

/-- `e(t) e_ξ = e(t)` when `β t = ξ`. -/
theorem mul_stratumIdempotent_of_eq (he : OrthogonalIdempotents e) {t : T} (h : β t = ξ) :
    e t * stratumIdempotent e β ξ = e t := by
  classical
  rw [stratumIdempotent, Finset.mul_sum, Finset.sum_eq_single t]
  · exact (he.idem t).eq
  · intro t' _ ht'
    exact he.ortho (Ne.symm ht')
  · intro ht
    exact absurd (Finset.mem_filter.2 ⟨Finset.mem_univ t, h⟩) ht

/-- `e(t) e_ξ = 0` when `β t ≠ ξ`. -/
theorem mul_stratumIdempotent_of_ne (he : OrthogonalIdempotents e) {t : T} (h : β t ≠ ξ) :
    e t * stratumIdempotent e β ξ = 0 := by
  classical
  rw [stratumIdempotent, Finset.mul_sum]
  refine Finset.sum_eq_zero fun t' ht' => he.ortho ?_
  rintro rfl
  exact h (Finset.mem_filter.1 ht').2

/-- `e_ξ` is idempotent. -/
theorem isIdempotentElem_stratumIdempotent (he : OrthogonalIdempotents e) :
    IsIdempotentElem (stratumIdempotent e β ξ) := by
  classical
  unfold IsIdempotentElem
  nth_rw 1 [stratumIdempotent]
  rw [Finset.sum_mul]
  conv_rhs => rw [stratumIdempotent]
  exact Finset.sum_congr rfl fun t ht =>
    mul_stratumIdempotent_of_eq β ξ he (Finset.mem_filter.1 ht).2

end Idempotent

section Ideal

variable {A : Type u} [Ring A] {T : Type*} (e : T → A) {Ξ : Type*} [PartialOrder Ξ] (β : T → Ξ)
  (ξ : Ξ)

/-- The two-sided ideal `I_ξ` generated by the idempotents `e(t)` with `¬ β t ≤ ξ`. -/
def stratumIdeal : Ideal A :=
  (TwoSidedIdeal.span (idempotentsOff e β (Set.Iic ξ))).asIdeal

instance : (stratumIdeal e β ξ).IsTwoSided := by
  unfold stratumIdeal; infer_instance

/-- The ring `A ⧸ I_ξ`, whose modules are the objects of `C_{≤ξ}`. -/
abbrev StratumRing : Type u := A ⧸ stratumIdeal e β ξ

/-- The generators `e(t)`, `¬ β t ≤ ξ`, lie in `I_ξ`. -/
theorem idempotentsOff_subset_stratumIdeal :
    idempotentsOff e β (Set.Iic ξ) ⊆ (stratumIdeal e β ξ : Set A) := by
  intro a ha
  change a ∈ (TwoSidedIdeal.span _).asIdeal
  rw [TwoSidedIdeal.mem_asIdeal]
  exact TwoSidedIdeal.subset_span ha

variable {e β ξ}

/-- A module in `C_{≤ξ}` is annihilated by `I_ξ`. -/
theorem isTorsionBySet_stratumIdeal {M : ModuleCat.{u} A}
    (hM : supportedIn e β (Set.Iic ξ) M) :
    Module.IsTorsionBySet A M (stratumIdeal e β ξ : Set A) := by
  rw [Module.isTorsionBySet_iff_subset_annihilator]
  intro a ha
  change a ∈ (TwoSidedIdeal.span _).asIdeal at ha
  rw [TwoSidedIdeal.mem_asIdeal] at ha
  have hle : TwoSidedIdeal.span (idempotentsOff e β (Set.Iic ξ)) ≤
      (Module.annihilator A M).toTwoSided := by
    rw [TwoSidedIdeal.span_le]
    intro b hb
    rw [Ideal.coe_toTwoSided, SetLike.mem_coe, Module.mem_annihilator]
    exact hM b hb
  have := hle ha
  rwa [Ideal.mem_toTwoSided] at this

/-- An `A ⧸ I_ξ`-module, viewed as an `A`-module, lies in `C_{≤ξ}`. -/
theorem supportedIn_restrictScalars (N : ModuleCat.{u} (StratumRing e β ξ)) :
    supportedIn e β (Set.Iic ξ)
      ((ModuleCat.restrictScalars (Ideal.Quotient.mk (stratumIdeal e β ξ))).obj N) := by
  intro a ha m
  rw [ModuleCat.restrictScalars.smul_def,
    (Ideal.Quotient.eq_zero_iff_mem).2 (idempotentsOff_subset_stratumIdeal e β ξ ha), zero_smul]
  rfl

end Ideal

section Equivalence

variable {A : Type u} [Ring A] {T : Type*} (e : T → A) {Ξ : Type*} [PartialOrder Ξ] (β : T → Ξ)
  (ξ : Ξ)

/-- Restriction of scalars along `A → A ⧸ I_ξ`, as a functor into `C_{≤ξ}`. -/
def stratumRestrict :
    ModuleCat.{u} (StratumRing e β ξ) ⥤ (supportedIn e β (Set.Iic ξ)).FullSubcategory :=
  (supportedIn e β (Set.Iic ξ)).lift
    (ModuleCat.restrictScalars (Ideal.Quotient.mk (stratumIdeal e β ξ)))
    (supportedIn_restrictScalars)

/-- Restriction of scalars along a surjective ring map is full. -/
instance restrictScalars_full_quotient :
    (ModuleCat.restrictScalars.{u} (Ideal.Quotient.mk (stratumIdeal e β ξ))).Full where
  map_surjective {N N'} f := by
    refine ⟨ModuleCat.ofHom
      { toFun := f.hom
        map_add' := f.hom.map_add
        map_smul' := fun r m => ?_ }, rfl⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
    exact f.hom.map_smul a m

instance : (stratumRestrict e β ξ).Full := by unfold stratumRestrict; infer_instance

instance : (stratumRestrict e β ξ).Faithful := by unfold stratumRestrict; infer_instance

instance : (stratumRestrict e β ξ).EssSurj where
  mem_essImage X := by
    let := (isTorsionBySet_stratumIdeal X.property).module
    let N : ModuleCat.{u} (StratumRing e β ξ) := ModuleCat.of _ X.obj
    let i : ((ModuleCat.restrictScalars (Ideal.Quotient.mk (stratumIdeal e β ξ))).obj N) ≅
        X.obj := LinearEquiv.toModuleIso
      { toFun := fun m => (m : X.obj)
        invFun := fun m => (m : N)
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    exact ⟨N, ⟨(supportedIn e β (Set.Iic ξ)).fullyFaithfulι.preimageIso i⟩⟩

instance : (stratumRestrict e β ξ).IsEquivalence where

/-- **`C_{≤ξ}` is a module category**: `ModuleCat (A ⧸ I_ξ) ≌ C_{≤ξ}`. -/
def stratumEquivalence :
    ModuleCat.{u} (StratumRing e β ξ) ≌ (supportedIn e β (Set.Iic ξ)).FullSubcategory :=
  (stratumRestrict e β ξ).asEquivalence

/-- `C_{<ξ}` as a property of objects of `C_{≤ξ}` (the shape of `SimpleLabelling.ltIn`). -/
def supportedLtIn : ObjectProperty (supportedIn.{u, u} e β (Set.Iic ξ)).FullSubcategory :=
  fun X => supportedIn e β (Set.Iio ξ) X.obj

end Equivalence

section Quotient

variable {A : Type u} [Ring A] {T : Type*} [Fintype T] {e : T → A} {Ξ : Type*} [PartialOrder Ξ]
  (β : T → Ξ) (ξ : Ξ) (he : OrthogonalIdempotents e)

include he in
/-- The image `ē_ξ` of `e_ξ` in `A ⧸ I_ξ` is idempotent. -/
theorem isIdempotentElem_stratumIdempotent_mk :
    IsIdempotentElem (Ideal.Quotient.mk (stratumIdeal e β ξ) (stratumIdempotent e β ξ)) :=
  (isIdempotentElem_stratumIdempotent β ξ he).map _

/-- The corner ring `ē_ξ (A ⧸ I_ξ) ē_ξ`; its modules form the subquotient category `C_ξ`. -/
abbrev StratumCorner : Type u := (isIdempotentElem_stratumIdempotent_mk β ξ he).Corner

/-- The inclusion of the corner `ē_ξ (A ⧸ I_ξ) ē_ξ` into `A ⧸ I_ξ`, a nonunital ring map sending
`1` to `ē_ξ`. -/
def stratumCornerIncl : StratumCorner β ξ he →ₙ+* StratumRing e β ξ where
  toFun z := z.1
  map_mul' _ _ := rfl
  map_add' _ _ := rfl
  map_zero' := rfl

/-- The corner inclusion is injective. -/
theorem stratumCornerIncl_injective : Function.Injective (stratumCornerIncl β ξ he) :=
  Subtype.val_injective

/-- The image of the corner inclusion is `ē_ξ (A ⧸ I_ξ) ē_ξ`. -/
theorem stratumCornerIncl_corner (z : StratumRing e β ξ) :
    ∃ a, stratumCornerIncl β ξ he a =
      stratumCornerIncl β ξ he 1 * z * stratumCornerIncl β ξ he 1 :=
  ⟨⟨_, z, rfl⟩, rfl⟩

/-- **The quotient functor** `π_ξ : C_{≤ξ} ⥤ ModuleCat (ē_ξ (A ⧸ I_ξ) ē_ξ)`, `M ↦ e_ξ M`. -/
def stratumQuotient :
    (supportedIn e β (Set.Iic ξ)).FullSubcategory ⥤ ModuleCat.{u} (StratumCorner β ξ he) :=
  (stratumEquivalence e β ξ).inverse ⋙ InductionAlong.resFunctor.{u, u} (stratumCornerIncl β ξ he)

omit [Fintype T] in
/-- Annihilation by an element is invariant under isomorphism. -/
theorem smul_eq_zero_of_iso {M M' : ModuleCat.{u} A} (i : M ≅ M') {a : A}
    (h : ∀ m : M, a • m = 0) (m' : M') : a • m' = 0 := by
  have : m' = i.hom (i.inv m') := by simp
  rw [this, ← map_smul, h, map_zero]

/-- The restriction to the corner vanishes iff `ē_ξ` annihilates the module. -/
theorem isZero_resFunctor_iff (N : ModuleCat.{u} (StratumRing e β ξ)) :
    IsZero ((InductionAlong.resFunctor.{u, u} (stratumCornerIncl β ξ he)).obj N) ↔
      ∀ n : N, Ideal.Quotient.mk (stratumIdeal e β ξ) (stratumIdempotent e β ξ) • n = 0 := by
  rw [ModuleCat.isZero_iff_subsingleton]
  set ε := Ideal.Quotient.mk (stratumIdeal e β ξ) (stratumIdempotent e β ξ)
  have hε : IsIdempotentElem ε := isIdempotentElem_stratumIdempotent_mk β ξ he
  constructor
  · intro hs n
    have hmem : stratumCornerIncl β ξ he 1 • (ε • n) = ε • n := by
      change ε • ε • n = ε • n
      rw [← mul_smul, hε.eq]
    let r : InductionAlong.Res (stratumCornerIncl β ξ he) N := InductionAlong.Res.mk _ hmem
    have := congrArg InductionAlong.Res.val (@Subsingleton.elim _ hs r 0)
    exact this
  · intro h
    refine ⟨fun x y => InductionAlong.Res.ext ?_⟩
    rw [← x.prop, ← y.prop]
    exact (h _).trans (h _).symm

include he in
/-- Inside `C_{≤ξ}`, `e_ξ M = 0` iff `M ∈ C_{<ξ}`. -/
theorem stratumIdempotent_smul_eq_zero_iff {M : ModuleCat.{u} A}
    (hM : supportedIn e β (Set.Iic ξ) M) :
    (∀ m : M, stratumIdempotent e β ξ • m = 0) ↔ supportedIn e β (Set.Iio ξ) M := by
  classical
  rw [supportedIn_iff]
  constructor
  · intro h t ht m
    by_cases hle : β t ≤ ξ
    · have hξ : β t = ξ := by
        by_contra hne
        exact ht (lt_of_le_of_ne hle hne)
      have : e t * stratumIdempotent e β ξ = e t := by
        exact mul_stratumIdempotent_of_eq β ξ he hξ
      rw [← this, mul_smul, h, smul_zero]
    · exact supportedIn_iff.1 hM t hle m
  · intro h m
    rw [stratumIdempotent, Finset.sum_smul]
    refine Finset.sum_eq_zero fun t ht => h t ?_ m
    have hξ := (Finset.mem_filter.1 ht).2
    simp only [Set.mem_Iio, hξ, lt_irrefl, not_false_eq_true]

/-- **The kernel of `π_ξ` is `C_{<ξ}`.** -/
theorem stratumQuotient_kernel :
    (stratumQuotient β ξ he).kernel = supportedLtIn e β ξ := by
  funext X
  apply propext
  change IsZero ((InductionAlong.resFunctor.{u, u} (stratumCornerIncl β ξ he)).obj
    ((stratumEquivalence e β ξ).inverse.obj X)) ↔ _
  rw [isZero_resFunctor_iff]
  change _ ↔ supportedIn e β (Set.Iio ξ) X.obj
  let i := (supportedIn e β (Set.Iic ξ)).ι.mapIso ((stratumEquivalence e β ξ).counitIso.app X)
  rw [← stratumIdempotent_smul_eq_zero_iff β ξ he X.property]
  constructor
  · intro h
    exact smul_eq_zero_of_iso i fun m => (ModuleCat.restrictScalars.smul_def _ _ m).trans (h m)
  · intro h n
    exact smul_eq_zero_of_iso i.symm h n

include he in
/-- `C_{<ξ}` is a Serre class inside `C_{≤ξ}`. -/
theorem isSerreClass_supportedLtIn [(supportedIn e β (Set.Iic ξ)).IsSerreClass] :
    (supportedLtIn e β ξ).IsSerreClass := by
  rw [← stratumQuotient_kernel β ξ he]
  have : PreservesFiniteLimits (stratumQuotient β ξ he) := by
    unfold stratumQuotient; infer_instance
  have : PreservesFiniteColimits (stratumQuotient β ξ he) := by
    unfold stratumQuotient; infer_instance
  infer_instance

/-- Equal Serre classes have equal classes of isomorphisms modulo them. -/
theorem isoModSerre_congr {C : Type*} [Category* C] [Abelian C] {P Q : ObjectProperty C}
    [P.IsSerreClass] [Q.IsSerreClass] (h : P = Q) : P.isoModSerre = Q.isoModSerre := by
  subst h; rfl

/-- **`π_ξ` is the quotient `C_{≤ξ} → C_{≤ξ}/C_{<ξ}`** (Losev–Webster, arXiv:1303.1336v3,
Definition 2.1): for orthogonal idempotents `e(t)` of `A`, the functor `M ↦ e_ξ M` from `C_{≤ξ}`
to modules over `ē_ξ (A ⧸ I_ξ) ē_ξ` is the localization at the morphisms that are isomorphisms
modulo `C_{<ξ}`. -/
theorem stratumQuotient_isLocalization [(supportedIn e β (Set.Iic ξ)).IsSerreClass]
    [(supportedLtIn e β ξ).IsSerreClass] :
    (stratumQuotient β ξ he).IsLocalization (supportedLtIn e β ξ).isoModSerre := by
  have : PreservesFiniteLimits (stratumQuotient β ξ he) := by
    unfold stratumQuotient; infer_instance
  have : PreservesFiniteColimits (stratumQuotient β ξ he) := by
    unfold stratumQuotient; infer_instance
  obtain ⟨h1, h2⟩ := InductionAlong.functor_full_faithful.{u, u} (stratumCornerIncl β ξ he)
    (stratumCornerIncl_injective β ξ he) (stratumCornerIncl_corner β ξ he)
  let adj := (InductionAlong.adjunction.{u, u} (stratumCornerIncl β ξ he)).comp
    (stratumEquivalence e β ξ).toAdjunction
  rw [← isoModSerre_congr (stratumQuotient_kernel β ξ he)]
  exact Abelian.isLocalization_isoModSerre_kernel_of_fullyFaithful_leftAdjoint _ adj

end Quotient

end

end Categorification.TensorProductCategorification
