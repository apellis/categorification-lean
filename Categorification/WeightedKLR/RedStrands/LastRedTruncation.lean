import Categorification.WeightedKLR.RedStrands.StendhalHom
import Categorification.KLR.CyclotomicTruncation
import Categorification.KLR.Concat

/-!
# Truncating a constant block to the right of the last red strand

Webster, arXiv:1309.3796v2, §4.7, proof of Theorem 4.38. Suppose the last
red strand of weight λ is immediately followed by at least λⁱ + 1 black
strands of colour i. The boundary idempotent lies in the ideal of diagrams
factoring through the loading obtained by moving the first such strand to
the left of that red strand.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR StendhalAlgebraAllOrders

/-- Compressing the ideal generated by a corner element gives its ideal
inside the corner. -/
theorem corner_mem_span_singleton_of_val {A : Type*} [Ring A] {E : A}
    (hE : IsIdempotentElem E) (e z : hE.Corner)
    (hz : z.val ∈ TwoSidedIdeal.span ({e.val} : Set A)) :
    z ∈ TwoSidedIdeal.span ({e} : Set hE.Corner) := by
  let J := TwoSidedIdeal.span ({e} : Set hE.Corner)
  let c : A →+ hE.Corner :=
    { toFun := fun a => ⟨E * a * E, a, rfl⟩
      map_zero' := Subtype.ext (by change E * 0 * E = 0; simp)
      map_add' := fun a b => Subtype.ext (by
        change E * (a+b) * E = E * a * E + E * b * E
        rw [mul_add, add_mul]) }
  have hc (y : hE.Corner) : c y.val = y := by
    apply Subtype.ext
    exact ((congrArg (· * E) (KLR.Corner.E_mul_val y)).trans (KLR.Corner.val_mul_E y))
  have H (x : A) (hx : x ∈ TwoSidedIdeal.span ({e.val} : Set A)) : ∀ a b, c (a * x * b) ∈ J := by
    induction hx using TwoSidedIdeal.span_induction with
    | mem x hx =>
      obtain rfl := Set.mem_singleton_iff.mp hx
      intro a b
      have h : c (a * e.val * b) = c a * e * c b := by
        apply Subtype.ext
        change E * (a * e.val * b) * E = E * a * E * e.val * (E * b * E)
        simp only [mul_assoc, KLR.Corner.E_mul_val, ← mul_assoc e.val E, KLR.Corner.val_mul_E]
      rw [h]
      exact J.mul_mem_right _ _ (J.mul_mem_left _ _ (TwoSidedIdeal.subset_span (Set.mem_singleton e)))
    | zero => simp
    | add x y _ _ hx hy =>
      intro a b
      simpa only [mul_add, add_mul, map_add] using J.add_mem (hx a b) (hy a b)
    | neg x _ hx =>
      intro a b
      simpa only [mul_neg, neg_mul, map_neg] using J.neg_mem (hx a b)
    | left_absorb r x _ hx =>
      intro a b
      simpa only [mul_assoc] using hx (a * r) b
    | right_absorb r x _ hx =>
      intro a b
      simpa only [mul_assoc] using hx a (r * b)
  simpa only [one_mul, mul_one, hc] using H z.val hz 1 1

variable {I : Type} {k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ}
    (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ+1) → I →₀ ℕ) {ν : Multiset I}
local notation "μ" => stendhalWeight (ℓ+1) ν
local notation "m" => Multiset.card μ
local notation "A" => StendhalAlgebraAllOrders k Q Λ ν

/-- Equation (4.2) factors the prescribed dot power through the adjacent
loading with one fewer black strand after the last red. -/
theorem lastRed_dot_pow_factor (s : Seq μ) (j : ℕ) (h : j + 1 < m) (i : I)
    (hr : s.lbl ⟨j, by omega⟩ = .inr (Fin.last ℓ)) (hi : s.lbl ⟨j+1,h⟩ = .inl i) :
    (x ⟨j+1,h⟩ ^ Λ (Fin.last ℓ) i * e s : A) =
      ψ j * e (TypeA.sadj m j • s) * (ψ j * e s) := by
  let t := TypeA.sadj m j • s
  have hc : (ψ j * e s : A) = e t * ψ j := by
    simpa only [map_mul, ψ, e, t] using congrArg (ofKLR k Q Λ ν) (KLRAlgebra.ψ_mul_e j s)
  have ht : (e t * (ψ j * e s) : A) = ψ j * e s := by
    rw [hc, ← mul_assoc, e_mul_e, ite_eq_left rfl]
  rw [← ψ_sq_red_black j h s i (Fin.last ℓ) hr hi, mul_assoc, mul_assoc, ht]

private theorem lastRed_boundary_mem_ambient (s : Seq μ) (j : ℕ) (h : j + 1 < m) (i : I)
    (hr : s.lbl ⟨j, by omega⟩ = .inr (Fin.last ℓ)) (hi : s.lbl ⟨j+1,h⟩ = .inl i)
    (hb : j + 1 + (Λ (Fin.last ℓ) i + 1) ≤ m)
    (hc : KLRAlgebra.IsConstOn s (j+1) (Λ (Fin.last ℓ) i + 1)) :
    (e s : A) ∈ TwoSidedIdeal.span ({e (TypeA.sadj m j • s)} : Set A) := by
  let J := TwoSidedIdeal.span ({e (TypeA.sadj m j • s)} : Set A)
  let φ := J.ringCon.mk'.comp (ofKLR k Q Λ ν).toRingHom
  have hx : (x ⟨j+1,h⟩ ^ Λ (Fin.last ℓ) i * e s : A) ∈ J := by
    rw [lastRed_dot_pow_factor Q Λ s j h i hr hi]
    exact J.mul_mem_right _ _ (J.mul_mem_left _ _ (TwoSidedIdeal.subset_span (Set.mem_singleton _)))
  have H := KLRAlgebra.map_e_eq_zero_of_block_dot_pow φ s (j+1) (Λ (Fin.last ℓ) i) hb hc (by
    change J.ringCon.mk' (ofKLR k Q Λ ν _) = 0
    rw [map_mul, map_pow]
    exact (TwoSidedIdeal.mem_ker _).mp ((TwoSidedIdeal.ker_ringCon_mk' J).symm ▸ hx))
  change e s ∈ J
  rw [← TwoSidedIdeal.ker_ringCon_mk' J]
  exact (TwoSidedIdeal.mem_ker _).mpr H

/-- The constant final-block truncation in Webster, arXiv:1309.3796v2, §4.7,
proof of Theorem 4.38. The idempotent is generated by the single loading in
which the last red strand has moved one place to the right. -/
theorem lastRed_boundary_mem_span (s : Seq μ) (hs : IsRedOrdered s)
    (j : ℕ) (h : j + 1 < m) (i : I)
    (hr : s.lbl ⟨j, by omega⟩ = .inr (Fin.last ℓ)) (hi : s.lbl ⟨j+1,h⟩ = .inl i)
    (hb : j + 1 + (Λ (Fin.last ℓ) i + 1) ≤ m)
    (hc : KLRAlgebra.IsConstOn s (j+1) (Λ (Fin.last ℓ) i + 1)) :
    TensorProductAlgebra.mk Q Λ ν (StendhalAlgebra.e s hs) ∈
      TwoSidedIdeal.span {TensorProductAlgebra.mk Q Λ ν (StendhalAlgebra.e (TypeA.sadj m j • s)
        (isRedOrdered_sadj (i := s) (n := j) hs h (Or.inr (by change (s.lbl _).isLeft; simp [hi]))))} := by
  let π := TensorProductAlgebra.mk Q Λ ν
  let t := TypeA.sadj m j • s
  have ht : IsRedOrdered t := isRedOrdered_sadj (i := s) (n := j) hs h (Or.inr (by change (s.lbl _).isLeft; simp [hi]))
  let b := StendhalAlgebra.e (Q := Q) (Λ := Λ) t ht
  let J := TwoSidedIdeal.span ({π b} : Set _)
  have hle : TwoSidedIdeal.span ({b} : Set _) ≤ J.comap π := TwoSidedIdeal.span_le.2 (by
    rintro _ rfl
    exact (TwoSidedIdeal.mem_comap ..).2 (TwoSidedIdeal.subset_span (Set.mem_singleton _)))
  exact (TwoSidedIdeal.mem_comap ..).1 (hle (corner_mem_span_singleton_of_val
    isIdempotentElem_redOrderedIdem b (StendhalAlgebra.e s hs)
    (lastRed_boundary_mem_ambient Q Λ s j h i hr hi hb hc)))

end Categorification.Stendhal
