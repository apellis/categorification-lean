import Categorification.WeightedKLR.RedStrands.StendhalHom
import Categorification.WeightedKLR.RedStrands.Stendhal

/-!
# Stendhal diagrams map to the weighted KLR algebra with the `0`-dot killed

B. Webster, *Weighted Khovanov–Lauda–Rouquier algebras*, arXiv:1209.2463v4, proof of
Theorem 3.5. The images `stFreeHom` of the KLR generators satisfy the KLR relations for the
polynomials `stQ` (`Stendhal.stFreeHom_rel`). Modulo the two-sided ideal generated by the dot
on the `0`-strand (`stZeroDotIdeal`) they satisfy the relations of Stendhal diagrams
(arXiv:1309.3796v2, Definition 4.5) for the polynomials `Γ.klrQ` between black strands:

* `stQ` and Stendhal's `stendhalQ Γ.klrQ Λ` agree between black strands, and differ by a
  multiple of the variable of the red strand otherwise; the same holds for the divided
  differences `Q̄` in the braid relation;
* a dot on a red strand goes to the dot on the `0`-strand, which is killed;
* a crossing of two red strands takes a red-ordered sequence to one that is not, and so
  vanishes.

## Main definitions and results

* `Stendhal.stDot`: the dots, as an algebra map from the polynomial ring.
* `Stendhal.stZeroDotIdeal`: the ideal generated by the dot on the `0`-strand.
* `Stendhal.stStendhalHom`: the map from `StendhalAlgebraAllOrders k Γ.klrQ Λ ν` to the quotient
  of the chamber algebra by `stZeroDotIdeal`.
-/

namespace Categorification.WeightedKLR

open Equiv MvPolynomial FullChamber GalleryAlgebra

section ChamberElt

variable {J : Type*} [DecidableEq J] {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜]
  [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k] {Δ : WeightedGraph J 𝕜 k} {ν : J →₀ ℕ}
  {ι : Type*} [Fintype ι] [DecidableEq ι] {F : ι → FullChamber Δ ν}

theorem chamberElt_mul_chamberElt (c c' : Matrix ι ι (GalleryAlgebra k Δ ν))
    (hc : Commute c (chamberIdem k F)) :
    chamberElt k F c * chamberElt k F c' = chamberElt k F (c * c') := by
  apply Subtype.ext
  have he := (isIdempotentElem_chamberIdem (k := k) F).eq
  change chamberIdem k F * c * chamberIdem k F * (chamberIdem k F * c' * chamberIdem k F) =
    chamberIdem k F * (c * c') * chamberIdem k F
  calc chamberIdem k F * c * chamberIdem k F * (chamberIdem k F * c' * chamberIdem k F)
      = chamberIdem k F * (c * (chamberIdem k F * chamberIdem k F)) * c' * chamberIdem k F := by
        simp only [mul_assoc]
    _ = chamberIdem k F * (chamberIdem k F * c) * c' * chamberIdem k F := by rw [he, hc.eq]
    _ = chamberIdem k F * (c * c') * chamberIdem k F := by
        rw [← mul_assoc, he]; simp only [mul_assoc]

theorem chamberElt_add (c c' : Matrix ι ι (GalleryAlgebra k Δ ν)) :
    chamberElt k F (c + c') = chamberElt k F c + chamberElt k F c' :=
  Subtype.ext (by
    change chamberIdem k F * (c + c') * chamberIdem k F =
      chamberIdem k F * c * chamberIdem k F + chamberIdem k F * c' * chamberIdem k F
    rw [mul_add, add_mul])

theorem chamberElt_smul (r : k) (c : Matrix ι ι (GalleryAlgebra k Δ ν)) :
    chamberElt k F (r • c) = r • chamberElt k F c :=
  Subtype.ext (by
    change chamberIdem k F * (r • c) * chamberIdem k F = r • (chamberIdem k F * c * chamberIdem k F)
    rw [mul_smul_comm, smul_mul_assoc])

theorem chamberElt_zero : chamberElt k F (0 : Matrix ι ι (GalleryAlgebra k Δ ν)) = 0 :=
  Subtype.ext (by
    change chamberIdem k F * 0 * chamberIdem k F = 0
    rw [mul_zero, zero_mul])

theorem chamberElt_one : chamberElt k F (1 : Matrix ι ι (GalleryAlgebra k Δ ν)) = 1 :=
  Subtype.ext (by
    change chamberIdem k F * 1 * chamberIdem k F = chamberIdem k F
    rw [mul_one, (isIdempotentElem_chamberIdem F).eq])

theorem chamberElt_val (x : ChamberAlgebra k F) : chamberElt k F x.1 = x := by
  apply Subtype.ext
  change chamberIdem k F * x.1 * chamberIdem k F = x.1
  have h := (Subsemigroup.mem_corner_iff (isIdempotentElem_chamberIdem F)).1 x.2
  rw [h.1, h.2]

theorem commute_val_chamberIdem (x : ChamberAlgebra k F) : Commute x.1 (chamberIdem k F) := by
  have h := (Subsemigroup.mem_corner_iff (isIdempotentElem_chamberIdem F)).1 x.2
  exact h.2.trans h.1.symm

theorem commute_diagonal_poly_chamberIdem (f : ι → PolyRing ν k) :
    Commute (Matrix.diagonal fun j => poly (f j)) (chamberIdem k F) := by
  rw [Commute, SemiconjBy, chamberIdem, Matrix.diagonal_mul_diagonal,
    Matrix.diagonal_mul_diagonal]
  congr 1
  funext j
  exact (e_mul_poly _ _).symm

end ChamberElt

end Categorification.WeightedKLR

namespace Categorification.KLR

open MvPolynomial

theorem qbar_X_one_mul {k : Type*} [CommRing k] (p : MvPolynomial (Fin 2) k) :
    qbar (X 1 * p) = X 1 * qbar p := by
  induction p using MvPolynomial.induction_on' with
  | monomial s c =>
    have hm : (X 1 : MvPolynomial (Fin 2) k) * monomial s c =
        monomial (s + Finsupp.single 1 1) c := by
      rw [X, monomial_mul_monomial, one_mul, add_comm]
    have h0 : (s + Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = s 0 := by simp
    have h1 : (s + Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 1 = s 1 + 1 := by simp
    rw [hm, qbar_monomial, qbar_monomial, h0, h1, pow_succ]
    ring
  | add p q hp hq => rw [mul_add, qbar_add, qbar_add, hp, hq, mul_add]

theorem qbar_sub {k : Type*} [CommRing k] (p q : MvPolynomial (Fin 2) k) :
    qbar (p - q) = qbar p - qbar q := by
  rw [eq_sub_iff_add_eq, ← qbar_add, sub_add_cancel]

end Categorification.KLR

namespace Categorification.Stendhal

open Categorification.WeightedKLR Equiv MvPolynomial FullChamber GalleryAlgebra

section Descent

variable {I : Type} [DecidableEq I] {ℓ : ℕ} {ν : Multiset I}
  {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k]
  {Γ : WeightedGraph I 𝕜 k} {Λ : Fin ℓ → I →₀ ℕ} {ϖ : Fin ℓ → 𝕜}

local notation "μ" => stendhalWeight ℓ ν
local notation "ν̃" => WeightedGraph.redWeight (Multiset.toFinsupp ν)
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "s₀" => GalleryAlgebra.zeroStrand (Multiset.toFinsupp ν)

variable (ν k Γ Λ ϖ) in
/-- The dots as diagonal matrices: a polynomial in the positions of the strands goes to the
diagonal matrix of its renamings to the strands of `ν̃`. -/
noncomputable def stDotMat :
    MvPolynomial (Fin m) k →ₐ[k]
      Matrix (OrdSeq ℓ ν) (OrdSeq ℓ ν) (GalleryAlgebra k (WeightedGraph.crawleyBoeveyIn Γ Λ ϖ) ν̃) :=
  (Matrix.diagonalAlgHom k).comp
    (AlgHom.pi fun j => (polyHom k (WeightedGraph.crawleyBoeveyIn Γ Λ ϖ) ν̃).comp (stRen j.1))

theorem stDotMat_apply (p : MvPolynomial (Fin m) k) :
    stDotMat ν k Γ Λ ϖ p = Matrix.diagonal fun j => poly (stRen j.1 p) := rfl

variable (ν k Λ) in
/-- The dots, as an algebra map from the polynomial ring to the chamber algebra. -/
noncomputable def stDot (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) :
    MvPolynomial (Fin m) k →ₐ[k] ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0) :=
  AlgHom.ofLinearMap
    { toFun := fun p => chamberElt k _ (stDotMat ν k Γ Λ ϖ p)
      map_add' := fun p q => by rw [map_add, chamberElt_add]
      map_smul' := fun r p => by rw [map_smul, chamberElt_smul]; rfl }
    (by
      change chamberElt k _ (stDotMat ν k Γ Λ ϖ 1) = 1
      rw [map_one, chamberElt_one])
    (fun p q => by
      change chamberElt k _ (stDotMat ν k Γ Λ ϖ (p * q)) =
        chamberElt k _ (stDotMat ν k Γ Λ ϖ p) * chamberElt k _ (stDotMat ν k Γ Λ ϖ q)
      rw [map_mul, stDotMat_apply, stDotMat_apply,
        chamberElt_mul_chamberElt _ _ (commute_diagonal_poly_chamberIdem _)])

theorem stDot_apply (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (p : MvPolynomial (Fin m) k) :
    stDot ν k Λ hϖ hw0 p = chamberElt k _ (Matrix.diagonal fun j => poly (stRen j.1 p)) :=
  rfl

theorem stFreeHom_fx (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) (a : Fin m) :
    stFreeHom ν k Λ hϖ hw0 (KLR.fx k μ a) = stDot ν k Λ hϖ hw0 (X a) := by
  rw [KLR.fx, stFreeHom_ι, stDot_apply]
  simp only [stGenMat, stRen, rename_X]

theorem stFreeHom_ncEval (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) {n : ℕ}
    (y : Fin n → FreeAlgebra k (KLR.Gen μ)) (v : Fin n → Fin m) (hy : ∀ c, y c = KLR.fx k μ (v c))
    (p : MvPolynomial (Fin n) k) :
    stFreeHom ν k Λ hϖ hw0 (KLR.ncEval y p) = stDot ν k Λ hϖ hw0 (rename v p) := by
  have h : (fun c => stFreeHom ν k Λ hϖ hw0 (y c)) = fun c => stDot ν k Λ hϖ hw0 (X (v c)) :=
    funext fun c => by rw [hy, stFreeHom_fx]
  rw [KLR.PolyRep.algHom_ncEval, h]
  exact KLR.PolyRep.ncEval_algHom_X _ v p

theorem stFreeHom_fe_of_not (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    {i : KLR.Seq μ} (hi : ¬ IsRedOrdered i) : stFreeHom ν k Λ hϖ hw0 (KLR.fe k μ i) = 0 := by
  have h : stGenMat k Λ hϖ hw0 (.idem i) = 0 := by
    simp only [stGenMat]
    rw [← Matrix.diagonal_zero]
    congr 1
    funext j
    have hj : j.1 ≠ i := fun h => hi (h ▸ j.2)
    simp [hj]
  rw [KLR.fe, stFreeHom_ι, h, chamberElt_zero]

variable (ν k Λ) in
/-- The dot on the `0`-strand, in every copy. -/
noncomputable def stZeroDot (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) :
    ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0) :=
  chamberElt k _ (Matrix.diagonal fun _ => poly (X s₀))

theorem stZeroDot_commute (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (y : ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0)) :
    Commute (stZeroDot ν k Λ hϖ hw0) y := by
  have hy := chamberElt_val y
  have hc : Matrix.diagonal (fun _ => poly (X s₀)) * y.1 = y.1 * Matrix.diagonal fun _ =>
      (poly (X s₀) : GalleryAlgebra k (WeightedGraph.crawleyBoeveyIn Γ Λ ϖ) ν̃) := by
    ext a b
    rw [Matrix.diagonal_mul, Matrix.mul_diagonal]
    exact (commute_poly_X (GalleryAlgebra.redWeight_zeroStrand _) _).eq
  rw [Commute, SemiconjBy, stZeroDot]
  conv_lhs => rw [← hy]
  conv_rhs => rw [← hy]
  rw [chamberElt_mul_chamberElt _ _ (commute_diagonal_poly_chamberIdem _),
    chamberElt_mul_chamberElt _ _ (commute_val_chamberIdem y), hc]

variable (ν k Λ) in
/-- The two-sided ideal generated by the dot on the `0`-strand. -/
noncomputable def stZeroDotIdeal (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) :
    TwoSidedIdeal (ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0)) :=
  TwoSidedIdeal.span {stZeroDot ν k Λ hϖ hw0}

theorem stZeroDot_mul_mem (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (y : ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0)) :
    stZeroDot ν k Λ hϖ hw0 * y ∈ stZeroDotIdeal ν k Λ hϖ hw0 :=
  TwoSidedIdeal.mul_mem_right _ _ _ (TwoSidedIdeal.subset_span rfl)

theorem stDot_X_mul_fe (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) {i : KLR.Seq μ}
    {b : Fin m} (hb : ¬ (i.1 b).isLeft) :
    stDot ν k Λ hϖ hw0 (X b) * stFreeHom ν k Λ hϖ hw0 (KLR.fe k μ i) =
      stZeroDot ν k Λ hϖ hw0 * stFreeHom ν k Λ hϖ hw0 (KLR.fe k μ i) := by
  rw [KLR.fe, stFreeHom_ι, stDot_apply, stZeroDot,
    chamberElt_mul_chamberElt _ _ (commute_diagonal_poly_chamberIdem _),
    chamberElt_mul_chamberElt _ _ (commute_diagonal_poly_chamberIdem _)]
  congr 1
  simp only [stGenMat, Matrix.diagonal_mul_diagonal]
  congr 1
  funext j
  by_cases hj : j.1 = i
  · subst hj
    rw [stRen, rename_X, toTilde_of_not_isLeft hb]
  · simp [hj]

theorem stDot_mul_mem (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) {i : KLR.Seq μ}
    {b : Fin m} (hb : ¬ (i.1 b).isLeft) (q : MvPolynomial (Fin m) k) :
    stDot ν k Λ hϖ hw0 (X b * q) * stFreeHom ν k Λ hϖ hw0 (KLR.fe k μ i) ∈
      stZeroDotIdeal ν k Λ hϖ hw0 := by
  rw [mul_comm, map_mul, mul_assoc, stDot_X_mul_fe hϖ hw0 hb, ← mul_assoc,
    ← (stZeroDot_commute hϖ hw0 _).eq, mul_assoc]
  exact stZeroDot_mul_mem hϖ hw0 _

omit [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] in
/-- `stQ` and Stendhal's polynomials agree between black strands, and differ by a multiple of
the variable of the red strand otherwise. -/
theorem stQ_sub_stendhalQ (a b : I ⊕ Fin ℓ) :
    ∃ h₀ h₁ : MvPolynomial (Fin 2) k, stQ Γ Λ a b - stendhalQ Γ.klrQ Λ a b =
      (if a.isLeft then 0 else X 0 * h₀) + (if b.isLeft then 0 else X 1 * h₁) := by
  rcases a with a | r <;> rcases b with b | r'
  · exact ⟨0, 0, by simp [stQ, stP, WeightedGraph.klrQ]⟩
  · obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow (X 0 - X 1 : MvPolynomial (Fin 2) k) (X 0) (Λ r' a)
    refine ⟨0, -c, ?_⟩
    simp only [stQ, stP, stendhalQ_inl_inr, map_pow, map_sub, rename_X, one_mul,
      Sum.isLeft_inl, Sum.isLeft_inr, ↓reduceIte, zero_add, Bool.false_eq_true]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    rw [hc]
    ring
  · obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow (X 1 - X 0 : MvPolynomial (Fin 2) k) (X 1) (Λ r b)
    refine ⟨-c, 0, ?_⟩
    simp only [stQ, stP, stendhalQ_inr_inl, map_one, mul_one,
      Sum.isLeft_inl, Sum.isLeft_inr, ↓reduceIte, add_zero, Bool.false_eq_true]
    rw [hc]
    ring
  · exact ⟨0, 0, by simp [stQ, stP, stendhalQ]⟩

end Descent

end Categorification.Stendhal
