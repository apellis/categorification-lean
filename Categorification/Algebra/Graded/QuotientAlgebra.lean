import Categorification.Algebra.Graded.Tensor
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# Quotients by homogeneous two-sided ideals

The grading in Webster, arXiv:1309.3796v2, Definitions 4.4–4.7 descends through
the two-sided ideal generated by the violated idempotents. We prove the needed
descent for homogeneous generators of any degrees in a graded algebra.
-/

namespace Categorification.Graded

open DirectSum

variable {k A B : Type*} [CommRing k] [Ring A] [Ring B] [Algebra k A] [Algebra k B]
  (𝒜 : ℤ → Submodule k A) [GradedAlgebra 𝒜]

/-- The two-sided ideal generated by homogeneous elements contains each homogeneous
component of each of its elements. -/
theorem decompose_mem_twoSidedSpan {S : Set A} (hS : ∀ x ∈ S, ∃ j, x ∈ 𝒜 j)
    {x : A} (hx : x ∈ TwoSidedIdeal.span S) :
    ∀ n, (decompose 𝒜 x n : A) ∈ TwoSidedIdeal.span S := by
  classical
  induction hx using TwoSidedIdeal.span_induction with
  | mem x hx =>
    obtain ⟨j, hj⟩ := hS x hx
    intro n
    by_cases h : j = n
    · subst n
      rw [decompose_of_mem_same 𝒜 hj]
      exact TwoSidedIdeal.subset_span hx
    · rw [decompose_of_mem_ne 𝒜 hj h]
      exact TwoSidedIdeal.zero_mem _
  | zero => intro n; simp
  | add x y _ _ hx hy =>
    intro n
    simpa only [decompose_add, DirectSum.add_apply, Submodule.coe_add] using
      TwoSidedIdeal.add_mem _ (hx n) (hy n)
  | neg x _ hx =>
    intro n
    rw [← zero_sub x, decompose_sub, DirectSum.sub_apply, Submodule.coe_sub,
      decompose_zero, DirectSum.zero_apply, Submodule.coe_zero, zero_sub]
    exact TwoSidedIdeal.neg_mem _ (hx n)
  | left_absorb a x _ hx =>
    intro n
    rw [decompose_mul, coe_mul_apply]
    exact sum_mem fun ij _ => TwoSidedIdeal.mul_mem_left _ _ _ (hx ij.2)
  | right_absorb b x _ hx =>
    intro n
    rw [decompose_mul, coe_mul_apply]
    exact sum_mem fun ij _ => TwoSidedIdeal.mul_mem_right _ _ _ (hx ij.1)

/-- The image grading of a surjective algebra map whose kernel is homogeneous. -/
@[instance_reducible] noncomputable def mapGradedAlgebra (π : A →ₐ[k] B)
    (hπ : Function.Surjective π)
    (hker : ∀ x, π x = 0 → ∀ n, π (decompose 𝒜 x n : A) = 0) :
    GradedAlgebra (map 𝒜 π.toLinearMap) where
  __ := mapDecomposition (π := π.toLinearMap) (𝒳 := 𝒜) hπ hker
  one_mem := ⟨1, SetLike.GradedOne.one_mem, π.map_one⟩
  mul_mem := by
    rintro _ _ _ _ ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
    exact ⟨x * y, SetLike.GradedMul.mul_mem hx hy, π.map_mul x y⟩

/-- Rank-nullity on a finite-dimensional subspace, with the kernel expressed in the ambient space. -/
theorem finrank_map_add_finrank_inf_ker {k X Y : Type*} [Field k] [AddCommGroup X] [AddCommGroup Y]
    [Module k X] [Module k Y] (π : X →ₗ[k] Y) (V : Submodule k X) [FiniteDimensional k V] :
    Module.finrank k (V.map π) + Module.finrank k (V ⊓ LinearMap.ker π : Submodule k X) =
      Module.finrank k V := by
  let f := π.comp V.subtype
  have hker : (LinearMap.ker f).map V.subtype = V ⊓ LinearMap.ker π := by
    rw [show LinearMap.ker f = (LinearMap.ker π).comap V.subtype from LinearMap.ker_comp ..,
      Submodule.map_comap_subtype]
  have hrange : LinearMap.range f = V.map π := by
    rw [show LinearMap.range f = Submodule.map π (LinearMap.range V.subtype) from LinearMap.range_comp ..,
      Submodule.range_subtype]
  rw [← hrange, ← hker, Submodule.finrank_map_subtype_eq]
  exact LinearMap.finrank_range_add_finrank_ker f

end Categorification.Graded
