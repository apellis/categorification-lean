import Categorification.Algebra.CompactModules
import Categorification.Algebra.ModuleFiltration

set_option backward.isDefEq.respectTransparency false

/-!
# Filtered modules in a localizing subcategory

Let `P` be a localizing subcategory of `D(R)`. A module, placed in degree `0`, whose
subquotients lie in `P` lies in `P` (`HasFiltration.mem_of_forall`); and if a filtered module
lies in `P`, together with all its subquotients but one which occurs once, then so does that one
(`HasFiltration.mem_of_mem`). This is the triangular argument showing that the standard modules
lie in the subcategory generated by the tilting modules, used in Webster, arXiv:1309.3796v3,
proof of Theorem 6.15.
-/

noncomputable section

namespace Categorification

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated DG DG.DerivedCategory
  ModuleFiltration
open scoped DG.DegreeZero

variable {R : Type} [Ring R] [HasDerivedCategory.{0, 0} R]
  {P : ObjectProperty (DerivedCategory.{0} R)} (hP : IsLocalizing.{0} P)
include hP

/-- A localizing property is closed under fibres. -/
theorem isLocalizing_ext₁ (T : Triangle (DerivedCategory.{0} R)) (hT : T ∈ distTriang _)
    (h₂ : P T.obj₂) (h₃ : P T.obj₃) : P T.obj₁ :=
  hP.ext₂ T.invRotate (inv_rot_of_distTriang T hT) (hP.shift _ (-1) h₃) h₂

/-- A localizing property contains the zero objects. -/
theorem isLocalizing_of_isZero {X : DerivedCategory.{0} R} (hX : IsZero X) : P X := by
  let c : Cofan (fun j : PEmpty.{1} => j.elim : PEmpty.{1} → DerivedCategory.{0} R) :=
    Cofan.mk X fun j => j.elim
  have hc : IsColimit c := Cofan.IsColimit.mk c (fun s => hX.to_ s.pt) (fun _ j => j.elim)
    fun _ _ _ => hX.eq_of_src _ _
  exact hP.coproduct c hc fun j => j.elim

omit hP [HasDerivedCategory.{0, 0} R] in
theorem shortExact_of_linear {X Y Z : ModuleCat.{0} R} (f : X →ₗ[R] Y) (g : Y →ₗ[R] Z)
    (hf : Function.Injective f) (hfg : Function.Exact f g) (hg : Function.Surjective g) :
    (ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g)
      (ModuleCat.hom_ext (LinearMap.ext fun x => hfg.apply_apply_eq_zero x))).ShortExact :=
  { exact := (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).2 hfg
    mono_f := (ModuleCat.mono_iff_injective _).2 hf
    epi_g := (ModuleCat.epi_iff_surjective _).2 hg }

theorem mem_moduleObj_of_equiv {M N : ModuleCat.{0} R} (e : M ≃ₗ[R] N) (h : P (moduleObj N)) :
    P (moduleObj M) :=
  hP.of_iso (Q.mapIso ((degreeZeroModuleFunctor R).mapIso e.toModuleIso)) h

/-- Two out of three for short exact sequences of modules: the middle term. -/
theorem mem_moduleObj_middle {X Y Z : ModuleCat.{0} R} (f : X →ₗ[R] Y) (g : Y →ₗ[R] Z)
    (hf : Function.Injective f) (hfg : Function.Exact f g) (hg : Function.Surjective g)
    (hX : P (moduleObj X)) (hZ : P (moduleObj Z)) : P (moduleObj Y) := by
  obtain ⟨δ, hT⟩ := exists_distinguished_of_shortExact_module _ (shortExact_of_linear f g hf hfg hg)
  exact hP.ext₂ _ hT hX hZ

/-- Two out of three for short exact sequences of modules: the submodule. -/
theorem mem_moduleObj_left {X Y Z : ModuleCat.{0} R} (f : X →ₗ[R] Y) (g : Y →ₗ[R] Z)
    (hf : Function.Injective f) (hfg : Function.Exact f g) (hg : Function.Surjective g)
    (hY : P (moduleObj Y)) (hZ : P (moduleObj Z)) : P (moduleObj X) := by
  obtain ⟨δ, hT⟩ := exists_distinguished_of_shortExact_module _ (shortExact_of_linear f g hf hfg hg)
  exact isLocalizing_ext₁ hP _ hT hY hZ

/-- Two out of three for short exact sequences of modules: the quotient. -/
theorem mem_moduleObj_right {X Y Z : ModuleCat.{0} R} (f : X →ₗ[R] Y) (g : Y →ₗ[R] Z)
    (hf : Function.Injective f) (hfg : Function.Exact f g) (hg : Function.Surjective g)
    (hX : P (moduleObj X)) (hY : P (moduleObj Y)) : P (moduleObj Z) := by
  obtain ⟨δ, hT⟩ := exists_distinguished_of_shortExact_module _ (shortExact_of_linear f g hf hfg hg)
  exact hP.ext₃ _ hT hX hY

theorem mem_moduleObj_of_subsingleton {X : ModuleCat.{0} R} (hX : Subsingleton X) :
    P (moduleObj X) :=
  isLocalizing_of_isZero hP ((degreeZeroModuleFunctor R ⋙ Q).map_isZero
    ((ModuleCat.isZero_iff_subsingleton).2 hX))

namespace ModuleFiltration

variable {ι : Type*} {L : ι → ModuleCat.{0} R}

/-- **A module filtered by modules of a localizing subcategory lies in it.** -/
theorem HasFiltration.mem_of_forall {m : List ι} {Y : ModuleCat.{0} R} (h : HasFiltration L m Y)
    (hm : ∀ c ∈ m, P (moduleObj (L c))) : P (moduleObj Y) := by
  induction h with
  | zero hY => exact mem_moduleObj_of_subsingleton hP hY
  | cons f g m c hf hfg hg _ hZ ih =>
    exact mem_moduleObj_middle hP f g hf hfg hg (ih fun d hd => hm d (List.mem_cons_of_mem _ hd))
      (mem_moduleObj_of_equiv hP hZ.some (hm c List.mem_cons_self))

/-- **The triangular step**: if a filtered module lies in a localizing subcategory, and so do
all its subquotients except one, whose label occurs once, then so does that one. -/
theorem HasFiltration.mem_of_mem [DecidableEq ι] {m : List ι} {Y : ModuleCat.{0} R}
    (h : HasFiltration L m Y) (hY : P (moduleObj Y)) {c : ι} (hc : m.count c = 1)
    (hm : ∀ d ∈ m, d ≠ c → P (moduleObj (L d))) : P (moduleObj (L c)) := by
  induction h with
  | zero _ => simp at hc
  | cons f g m d hf hfg hg hX hZ ih =>
    by_cases hdc : d = c
    · subst hdc
      have hX' : ∀ e ∈ m, P (moduleObj (L e)) := fun e he => hm e (List.mem_cons_of_mem _ he)
        (fun hed => by
          subst hed
          rw [List.count_cons_self] at hc
          exact absurd hc (by have := List.count_pos_iff.2 he; omega))
      have hZ' := mem_moduleObj_right hP f g hf hfg hg (hX.mem_of_forall hP hX') hY
      exact mem_moduleObj_of_equiv hP hZ.some.symm hZ'
    · have hZ' : P (moduleObj _) := mem_moduleObj_of_equiv hP hZ.some (hm d List.mem_cons_self hdc)
      refine ih (mem_moduleObj_left hP f g hf hfg hg hY hZ') ?_
        fun e he hec => hm e (List.mem_cons_of_mem _ he) hec
      rwa [List.count_cons_of_ne hdc] at hc

end ModuleFiltration

end Categorification
