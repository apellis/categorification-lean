import Categorification.TwoRep.BlockSumGen

/-!
# Composites of three block-sum functors

For index maps `s₁ : A → B`, `s₂ : B → B₂`, `s₃ : B₂ → D`, the composite
`blockSum s₁ L₁ ⋙ blockSum s₂ L₂ ⋙ blockSum s₃ L₃` is generated by
`gen₃ : L₃ (L₂ (L₁ (M a))) ⟶ (blockSum s₁ L₁ ⋙ blockSum s₂ L₂ ⋙ blockSum s₃ L₃).obj M d`
(`gen₃_ext`). A transformation of the two outer (`gen₃_whiskerLeft`) or of the two inner
(`gen₃_whiskerRight`) block sums that acts blockwise on generators of two-fold composites acts
blockwise on these generators. These are used for the braid relations of the weight-indexed
cyclotomic Rouquier family of KL III Thm. 1.2 (Brundan, arXiv:1501.00350v1, (1.4)).
-/

open CategoryTheory CategoryTheory.Limits

namespace Categorification.TwoRep

noncomputable section

/-- A chain of five transformations on generators, bracketed as in `RouqUpKLR.braid`. -/
theorem gen_chain_left {𝒟 : Type*} [Category 𝒟] {P₀ P₁ P₂ P₃ P₄ P₅ G₀ G₁ G₂ G₃ G₄ G₅ : 𝒟}
    {g₀ : P₀ ⟶ G₀} {g₁ : P₁ ⟶ G₁} {g₂ : P₂ ⟶ G₂} {g₃ : P₃ ⟶ G₃} {g₄ : P₄ ⟶ G₄} {g₅ : P₅ ⟶ G₅}
    {f₁ : G₀ ⟶ G₁} {f₂ : G₁ ⟶ G₂} {f₃ : G₂ ⟶ G₃} {f₄ : G₃ ⟶ G₄} {f₅ : G₄ ⟶ G₅}
    {a₁ : P₀ ⟶ P₁} {a₂ : P₁ ⟶ P₂} {a₃ : P₂ ⟶ P₃} {a₄ : P₃ ⟶ P₄} {a₅ : P₄ ⟶ P₅}
    (h₁ : g₀ ≫ f₁ = a₁ ≫ g₁) (h₂ : g₁ ≫ f₂ = a₂ ≫ g₂) (h₃ : g₂ ≫ f₃ = a₃ ≫ g₃)
    (h₄ : g₃ ≫ f₄ = a₄ ≫ g₄) (h₅ : g₄ ≫ f₅ = a₅ ≫ g₅) :
    g₀ ≫ f₁ ≫ ((f₂ ≫ f₃ ≫ f₄) ≫ f₅) = (a₁ ≫ ((a₂ ≫ a₃ ≫ a₄) ≫ a₅)) ≫ g₅ := by
  simp only [Category.assoc]
  rw [reassoc_of% h₁, reassoc_of% h₂, reassoc_of% h₃, reassoc_of% h₄, h₅]

/-- A chain of seven transformations on generators, bracketed as in `RouqUpKLR.braid`. -/
theorem gen_chain_right {𝒟 : Type*} [Category 𝒟]
    {P₀ P₁ P₂ P₃ P₄ P₅ P₆ P₇ G₀ G₁ G₂ G₃ G₄ G₅ G₆ G₇ : 𝒟}
    {g₀ : P₀ ⟶ G₀} {g₁ : P₁ ⟶ G₁} {g₂ : P₂ ⟶ G₂} {g₃ : P₃ ⟶ G₃} {g₄ : P₄ ⟶ G₄} {g₅ : P₅ ⟶ G₅}
    {g₆ : P₆ ⟶ G₆} {g₇ : P₇ ⟶ G₇}
    {f₁ : G₀ ⟶ G₁} {f₂ : G₁ ⟶ G₂} {f₃ : G₂ ⟶ G₃} {f₄ : G₃ ⟶ G₄} {f₅ : G₄ ⟶ G₅}
    {f₆ : G₅ ⟶ G₆} {f₇ : G₆ ⟶ G₇}
    {a₁ : P₀ ⟶ P₁} {a₂ : P₁ ⟶ P₂} {a₃ : P₂ ⟶ P₃} {a₄ : P₃ ⟶ P₄} {a₅ : P₄ ⟶ P₅}
    {a₆ : P₅ ⟶ P₆} {a₇ : P₆ ⟶ P₇}
    (h₁ : g₀ ≫ f₁ = a₁ ≫ g₁) (h₂ : g₁ ≫ f₂ = a₂ ≫ g₂) (h₃ : g₂ ≫ f₃ = a₃ ≫ g₃)
    (h₄ : g₃ ≫ f₄ = a₄ ≫ g₄) (h₅ : g₄ ≫ f₅ = a₅ ≫ g₅) (h₆ : g₅ ≫ f₆ = a₆ ≫ g₆)
    (h₇ : g₆ ≫ f₇ = a₇ ≫ g₇) :
    g₀ ≫ (f₁ ≫ f₂ ≫ f₃) ≫ f₄ ≫ (f₅ ≫ f₆ ≫ f₇) =
      ((a₁ ≫ a₂ ≫ a₃) ≫ a₄ ≫ (a₅ ≫ a₆ ≫ a₇)) ≫ g₇ := by
  simp only [Category.assoc]
  rw [reassoc_of% h₁, reassoc_of% h₂, reassoc_of% h₃, reassoc_of% h₄, reassoc_of% h₅,
    reassoc_of% h₆, h₇]

section Three

variable {A B B₂ Dd : Type*} (s₁ : A → B) (s₂ : B → B₂) (s₃ : B₂ → Dd)
  [∀ b, Finite {a // s₁ a = b}] [∀ c, Finite {b // s₂ b = c}] [∀ d, Finite {c // s₃ c = d}]
  {C : A → Type*} [∀ a, Category (C a)]
  {M₁ : B → Type*} [∀ b, Category (M₁ b)] [∀ b, Preadditive (M₁ b)]
  [∀ b, HasFiniteBiproducts (M₁ b)]
  {M₂ : B₂ → Type*} [∀ c, Category (M₂ c)] [∀ c, Preadditive (M₂ c)]
  [∀ c, HasFiniteBiproducts (M₂ c)]
  {D : Dd → Type*} [∀ d, Category (D d)] [∀ d, Preadditive (D d)]
  [∀ d, HasFiniteBiproducts (D d)]
  (L₁ : ∀ (a : A) (b : B), s₁ a = b → C a ⥤ M₁ b)
  (L₂ : ∀ (b : B) (c : B₂), s₂ b = c → M₁ b ⥤ M₂ c)
  (L₃ : ∀ (c : B₂) (d : Dd), s₃ c = d → M₂ c ⥤ D d)

/-- The generator of a composite of three block sums. -/
def gen₃ (M : ∀ a, C a) (a : A) {b : B} {c : B₂} {d : Dd} (h₁ : s₁ a = b) (h₂ : s₂ b = c)
    (h₃ : s₃ c = d) :
    (L₃ c d h₃).obj ((L₂ b c h₂).obj ((L₁ a b h₁).obj (M a))) ⟶
      (blockSum s₁ L₁ ⋙ blockSum s₂ L₂ ⋙ blockSum s₃ L₃).obj M d :=
  (L₃ c d h₃).map (gen₂ s₁ s₂ L₁ L₂ M a h₁ h₂) ≫
    blockι s₃ L₃ ((blockSum s₁ L₁ ⋙ blockSum s₂ L₂).obj M) (⟨c, h₃⟩ : {c' // s₃ c' = d})

theorem gen₃_eq (M : ∀ a, C a) (a : A) {b : B} {c : B₂} {d : Dd} (h₁ : s₁ a = b)
    (h₂ : s₂ b = c) (h₃ : s₃ c = d) :
    gen₃ s₁ s₂ s₃ L₁ L₂ L₃ M a h₁ h₂ h₃ =
      (L₃ c d h₃).map ((L₂ b c h₂).map (blockι s₁ L₁ M (⟨a, h₁⟩ : {a' // s₁ a' = b}))) ≫
        gen₂ s₂ s₃ L₂ L₃ ((blockSum s₁ L₁).obj M) b h₂ h₃ := by
  rw [gen₃, gen₂, gen₂, Functor.map_comp, Category.assoc]
  rfl

/-- Maps out of a composite of three block sums are determined on generators. -/
theorem gen₃_ext [∀ b c h, (L₂ b c h).Additive] [∀ c d h, (L₃ c d h).Additive]
    {M : ∀ a, C a} {N : ∀ d, D d}
    {f g : (blockSum s₁ L₁ ⋙ blockSum s₂ L₂ ⋙ blockSum s₃ L₃).obj M ⟶ N}
    (H : ∀ (a : A) (b : B) (c : B₂) (d : Dd) (h₁ : s₁ a = b) (h₂ : s₂ b = c) (h₃ : s₃ c = d),
      gen₃ s₁ s₂ s₃ L₁ L₂ L₃ M a h₁ h₂ h₃ ≫ f d = gen₃ s₁ s₂ s₃ L₁ L₂ L₃ M a h₁ h₂ h₃ ≫ g d) :
    f = g := by
  funext d
  refine biproduct.hom_ext' _ _ fun p => ?_
  obtain ⟨c, hc⟩ := p
  refine map_biproduct_hom_ext (L₃ c d hc) _ fun q => ?_
  obtain ⟨b, hb⟩ := q
  refine map_biproduct_hom_ext (L₂ b c hb ⋙ L₃ c d hc) _ fun r => ?_
  obtain ⟨a, ha⟩ := r
  have := H a b c d ha hb hc
  simp only [gen₃, gen₂, Functor.map_comp, Category.assoc] at this
  simp only [Functor.comp_map]
  exact this

/-- A transformation of the two outer block sums, blockwise on generators. -/
theorem gen₃_whiskerLeft {B₂' : Type*} {s₂' : B → B₂'} {s₃' : B₂' → Dd}
    [∀ c, Finite {b // s₂' b = c}] [∀ d, Finite {c // s₃' c = d}]
    {M₂' : B₂' → Type*} [∀ c, Category (M₂' c)] [∀ c, Preadditive (M₂' c)]
    [∀ c, HasFiniteBiproducts (M₂' c)]
    {L₂' : ∀ (b : B) (c : B₂'), s₂' b = c → M₁ b ⥤ M₂' c}
    {L₃' : ∀ (c : B₂') (d : Dd), s₃' c = d → M₂' c ⥤ D d}
    (η : blockSum s₂ L₂ ⋙ blockSum s₃ L₃ ⟶ blockSum s₂' L₂' ⋙ blockSum s₃' L₃')
    (M : ∀ a, C a) (a : A) {b : B} {c : B₂} {c' : B₂'} {d : Dd} (h₁ : s₁ a = b)
    (h₂ : s₂ b = c) (h₃ : s₃ c = d) (h₂' : s₂' b = c') (h₃' : s₃' c' = d)
    (τ : L₂ b c h₂ ⋙ L₃ c d h₃ ⟶ L₂' b c' h₂' ⋙ L₃' c' d h₃')
    (hη : gen₂ s₂ s₃ L₂ L₃ ((blockSum s₁ L₁).obj M) b h₂ h₃ ≫
        η.app ((blockSum s₁ L₁).obj M) d =
      τ.app ((blockSum s₁ L₁).obj M b) ≫ gen₂ s₂' s₃' L₂' L₃' ((blockSum s₁ L₁).obj M) b h₂' h₃') :
    gen₃ s₁ s₂ s₃ L₁ L₂ L₃ M a h₁ h₂ h₃ ≫ η.app ((blockSum s₁ L₁).obj M) d =
      τ.app ((L₁ a b h₁).obj (M a)) ≫ gen₃ s₁ s₂' s₃' L₁ L₂' L₃' M a h₁ h₂' h₃' := by
  rw [gen₃_eq, Category.assoc, hη, gen₃_eq, ← Category.assoc, ← Category.assoc]
  congr 1
  exact τ.naturality (blockι s₁ L₁ M (⟨a, h₁⟩ : {a' // s₁ a' = b}))

/-- A transformation of the two inner block sums, blockwise on generators. -/
theorem gen₃_whiskerRight {B' : Type*} {s₁' : A → B'} {s₂' : B' → B₂}
    [∀ b, Finite {a // s₁' a = b}] [∀ c, Finite {b // s₂' b = c}]
    {M₁' : B' → Type*} [∀ b, Category (M₁' b)] [∀ b, Preadditive (M₁' b)]
    [∀ b, HasFiniteBiproducts (M₁' b)]
    {L₁' : ∀ (a : A) (b : B'), s₁' a = b → C a ⥤ M₁' b}
    {L₂' : ∀ (b : B') (c : B₂), s₂' b = c → M₁' b ⥤ M₂ c}
    (η : blockSum s₁ L₁ ⋙ blockSum s₂ L₂ ⟶ blockSum s₁' L₁' ⋙ blockSum s₂' L₂')
    (M : ∀ a, C a) (a : A) {b : B} {b' : B'} {c : B₂} {d : Dd} (h₁ : s₁ a = b)
    (h₂ : s₂ b = c) (h₁' : s₁' a = b') (h₂' : s₂' b' = c) (h₃ : s₃ c = d)
    (τ : L₁ a b h₁ ⋙ L₂ b c h₂ ⟶ L₁' a b' h₁' ⋙ L₂' b' c h₂')
    (hη : gen₂ s₁ s₂ L₁ L₂ M a h₁ h₂ ≫ η.app M c =
      τ.app (M a) ≫ gen₂ s₁' s₂' L₁' L₂' M a h₁' h₂') :
    gen₃ s₁ s₂ s₃ L₁ L₂ L₃ M a h₁ h₂ h₃ ≫ (blockSum s₃ L₃).map (η.app M) d =
      (L₃ c d h₃).map (τ.app (M a)) ≫ gen₃ s₁' s₂' s₃ L₁' L₂' L₃ M a h₁' h₂' h₃ := by
  rw [gen₃, Category.assoc, blockι_map, ← Category.assoc, ← Functor.map_comp]
  erw [hη]
  rw [Functor.map_comp, Category.assoc]
  rfl

end Three

end

end Categorification.TwoRep
