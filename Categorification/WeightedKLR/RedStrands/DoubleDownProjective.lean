/-!
# The right ideal of an all-down boundary

Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2,
§4.7, Definition 4.34. The signed boundary module of an all-down object is
the right ideal generated by its boundary idempotent in the all-down matrix
algebra. Matrix multiplication is composition with the right matrix first,
so the idempotent selects the target of each retained entry.
-/

noncomputable section

namespace Categorification.Stendhal.DoubleDiagram

open CategoryTheory CategoryTheory.Preadditive CategoryTheory.Limits
  QuantumGroup QuantumGroup.UDot StringDiagrams KLR KLR.Diagram MulOpposite
open scoped Classical
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

universe w u v

variable {I : Type u} {C : CartanDatum I} {X Y : Type v} [AddCommGroup X] [AddCommGroup Y]
  {RD : WeightDatum C X Y} {ℓ : ℕ} {Λ : Fin ℓ → {x : X // ∀ i, 0 ≤ RD.pair (RD.iY i) x}}
  {k : Type w} [CommRing k] (P : Presentation.{w, max u v} (signature RD (Subtype.val ∘ Λ)) k)
  (ν : Multiset I)

local notation "A" => downwardMatrix P ν
local notation "M" => downSum P ν
local notation "e" => downwardMatrixEquivEnd P ν
local notation "D" => ViolatingCategory P (downRightWeight RD Λ ν)
local notation "Ord" => {s : Seq (stendhalWeight ℓ ν) // IsRedOrdered s}
local notation "index" => Fintype.equivFin Ord

/-- The right action on a boundary Hom is precomposition by the endomorphism
of the all-down sum represented by the matrix. -/
theorem boundaryRightModule_op_smul
    (b : DoubleStendhalTriple RD Λ 0 (downRightWeight RD Λ ν)) (a : A)
    (f : boundaryRightModule P ν b) :
    op a • f = (show M ⟶ (Mat_.embedding D).obj ((violatingFunctor P _).obj b) from e a ≫ f) :=
  rfl

variable (s : {s : Seq (stendhalWeight ℓ ν) // IsRedOrdered s})

local notation "B" => Functor.obj (Mat_.embedding D) (downObj P s)
local notation "H" => boundaryRightModule P ν (downTriple RD Λ s)
local notation "E" => downE P s.val

private theorem summandObj : (M).X (index s) = downObj P s :=
  congrArg (downObj P) ((index).symm_apply_apply s)

private def summandInclusion : B ⟶ M := fun _ j =>
  if h : index s = j then
    eqToHom ((summandObj P ν s).symm.trans (congrArg (M).X h))
  else 0

private def summandProjection : M ⟶ B := fun i _ =>
  if h : i = index s then
    eqToHom ((congrArg (M).X h).trans (summandObj P ν s))
  else 0

private theorem summandInclusion_at (i : (B).ι) :
    summandInclusion P ν s i (index s) = eqToHom (summandObj P ν s).symm := by
  exact dite_eq_left rfl

private theorem summandInclusion_off (i : (B).ι) {j : (M).ι} (h : j ≠ index s) :
    summandInclusion P ν s i j = 0 :=
  dite_eq_right (fun h' => h h'.symm)

private theorem summandProjection_at (j : (B).ι) :
    summandProjection P ν s (index s) j = eqToHom (summandObj P ν s) := by
  exact dite_eq_left rfl

private theorem summandProjection_off {i : (M).ι} (j : (B).ι) (h : i ≠ index s) :
    summandProjection P ν s i j = 0 :=
  dite_eq_right h

private theorem summandInclusion_projection :
    summandInclusion P ν s ≫ summandProjection P ν s = 𝟙 B := by
  apply Mat_.hom_ext
  intro i j
  let : Unique (B).ι := inferInstanceAs (Unique PUnit)
  obtain rfl : j = i := Subsingleton.elim j i
  rw [Mat_.comp_apply, Mat_.id_apply_self]
  let f : (M).ι → ((B).X j ⟶ (B).X j) :=
    fun b => summandInclusion P ν s j b ≫ summandProjection P ν s b j
  have hSum : ∑ b, f b = f (index s) := by
    apply Finset.sum_eq_single
    · intro b _ hb
      dsimp only [f]
      rw [summandInclusion_off P ν s j hb, Limits.zero_comp]
    · intro hb
      exact (hb (Finset.mem_univ (index s : (M).ι))).elim
  refine hSum.trans ?_
  dsimp only [f]
  rw [summandInclusion_at, summandProjection_at]
  exact (eqToHom_trans (summandObj P ν s).symm (summandObj P ν s)).trans (eqToHom_refl _ _)

private theorem matrixEquiv_apply (a : A) (i j : (M).ι) :
    (e a) i j = a ((index).symm i) ((index).symm j) := rfl

private theorem summandProjection_inclusion :
    summandProjection P ν s ≫ summandInclusion P ν s = e E := by
  apply Mat_.hom_ext
  intro i j
  let : Unique (B).ι := inferInstanceAs (Unique PUnit)
  rw [Mat_.comp_apply, Fintype.sum_unique, matrixEquiv_apply, downE_of_ordered P s, MatEnd.single_apply]
  have hIdx : (index).symm (index s) = s := (index).symm_apply_apply s
  by_cases hi : i = index s
  · subst i
    by_cases hj : j = index s
    · subst j
      rw [dite_eq_left ⟨hIdx, hIdx⟩, summandProjection_at, summandInclusion_at, Category.id_comp]
      rfl
    · have h' : ¬ ((index).symm (index s) = s ∧ (index).symm j = s) :=
        fun h => hj ((index).symm.injective (h.2.trans hIdx.symm))
      rw [dite_eq_right h', summandInclusion_off P ν s _ hj, Limits.comp_zero]
      rfl
  · have h' : ¬ ((index).symm i = s ∧ (index).symm j = s) :=
      fun h => hi ((index).symm.injective (h.1.trans hIdx.symm))
    rw [dite_eq_right h', summandProjection_off P ν s _ hi, Limits.zero_comp]
    rfl

/-- The signed right module at an all-down boundary is the right ideal of
its boundary idempotent. Postcomposition with the summand inclusion gives
the comparison (Webster, arXiv:1309.3796v2, §4.7, Definition 4.34). -/
def boundaryRightModuleDownEquiv : H ≃ₗ[Aᵐᵒᵖ] rIdeal E where
  toFun f :=
    let g : M ⟶ B := f
    ⟨(e).symm (g ≫ summandInclusion P ν s), by
      apply mem_rIdeal.mpr
      apply (e).injective
      rw [map_mul, (e).apply_symm_apply, ← summandProjection_inclusion P ν s, End.mul_def,
        Category.assoc, ← Category.assoc (summandInclusion P ν s), summandInclusion_projection,
        Category.id_comp]⟩
  invFun y := e y.val ≫ summandProjection P ν s
  left_inv f := by
    let g : M ⟶ B := f
    change e ((e).symm (g ≫ summandInclusion P ν s)) ≫ summandProjection P ν s = g
    rw [(e).apply_symm_apply, Category.assoc, summandInclusion_projection, Category.comp_id]
  right_inv y := by
    apply Subtype.ext
    apply (e).injective
    change e ((e).symm ((e y.val ≫ summandProjection P ν s) ≫ summandInclusion P ν s)) = e y.val
    rw [(e).apply_symm_apply, Category.assoc, summandProjection_inclusion, ← End.mul_def, ← map_mul,
      mem_rIdeal.mp y.prop]
  map_add' f g := by
    apply Subtype.ext
    let f' : M ⟶ B := f
    let g' : M ⟶ B := g
    change (e).symm ((f' + g') ≫ summandInclusion P ν s) =
      (e).symm (f' ≫ summandInclusion P ν s) + (e).symm (g' ≫ summandInclusion P ν s)
    rw [Preadditive.add_comp, map_add]
  map_smul' r f := by
    apply Subtype.ext
    let g : M ⟶ B := f
    change (e).symm ((e r.unop ≫ g) ≫ summandInclusion P ν s) =
      (e).symm (g ≫ summandInclusion P ν s) * r.unop
    apply (e).injective
    rw [(e).apply_symm_apply, map_mul, (e).apply_symm_apply, End.mul_def, Category.assoc]

/-- In the matrix model the precomposition action is the displayed sum of
composites with the entries of the acting matrix. -/
theorem boundaryRightModuleDownEquiv_smul_apply (a : A) (f : H) (i j : Ord) :
    (boundaryRightModuleDownEquiv P ν s (op a • f)).val i j =
      ∑ t : Ord, a i t ≫ (boundaryRightModuleDownEquiv P ν s f).val t j := by
  rw [map_smul]
  rfl

/-- The retained entries have target `s` in the source-first indexing of `MatEnd`. -/
theorem boundaryRightModuleDownEquiv_apply_of_target_ne (f : H) (i j : Ord) (h : j ≠ s) :
    (boundaryRightModuleDownEquiv P ν s f).val i j = 0 := by
  let y := boundaryRightModuleDownEquiv P ν s f
  have hy : E * y.val = y.val := mem_rIdeal.mp y.prop
  let a : A := y.val
  change a i j = 0
  calc
    a i j = (E * a) i j := congrArg (fun b : A => b i j) hy.symm
    _ = 0 := by
      rw [MatEnd.mul_apply, downE_of_ordered P s]
      exact Finset.sum_eq_zero fun t _ => by
        rw [MatEnd.single_apply_of_ne _ (fun he => h he.2), Limits.comp_zero]

/-- An isomorphism onto the all-down matrix algebra identifies the ordinary
principal right ideal with the signed boundary module, provided the ordinary
idempotent maps to the signed boundary idempotent. -/
def boundaryRightModuleDownEquiv_restrict {R : Type*} [Ring R] (τ : R ≃+* A)
    (p : R) (hp : τ p = E) :
    rIdeal p ≃ₗ[Rᵐᵒᵖ] ((ModuleCat.restrictScalars (RingEquiv.op τ).toRingHom).obj H) := by
  let ψ := boundaryRightModuleDownEquiv P ν s
  let toSigned (x : rIdeal p) : rIdeal E :=
    ⟨τ x.val, mem_rIdeal.mpr (by rw [← hp, ← map_mul, mem_rIdeal.mp x.prop])⟩
  let toOrdinary (y : rIdeal E) : rIdeal p :=
    ⟨τ.symm y.val, mem_rIdeal.mpr (τ.injective (by
      rw [map_mul, τ.apply_symm_apply, hp, mem_rIdeal.mp y.prop]))⟩
  refine
    { toFun := fun x => ψ.symm (toSigned x)
      invFun := fun y => toOrdinary (ψ y)
      left_inv := ?hLeft
      right_inv := ?hRight
      map_add' := ?hAdd
      map_smul' := ?hSmul }
  case hLeft =>
    intro x
    change toOrdinary (ψ (ψ.symm (toSigned x))) = x
    rw [ψ.apply_symm_apply]
    exact Subtype.ext (τ.symm_apply_apply x.val)
  case hRight =>
    intro y
    let y' : H := y
    change ψ.symm (toSigned (toOrdinary (ψ y'))) = y'
    have h : toSigned (toOrdinary (ψ y')) = ψ y' := Subtype.ext (τ.apply_symm_apply _)
    rw [h, ψ.symm_apply_apply]
  case hAdd =>
    intro x y
    change ψ.symm (toSigned (x + y)) = ψ.symm (toSigned x) + ψ.symm (toSigned y)
    rw [← map_add]
    exact congrArg ψ.symm (Subtype.ext (map_add τ x.val y.val))
  case hSmul =>
    intro r x
    change ψ.symm (toSigned (r • x)) = op (τ r.unop) • ψ.symm (toSigned x)
    rw [← map_smul]
    exact congrArg ψ.symm (Subtype.ext (map_mul τ x.val r.unop))

section EmptyRed

variable {weights : Fin 0 → {x : X // ∀ i, 0 ≤ RD.pair (RD.iY i) x}}
  (base : Presentation.{w, max u v} (signature RD (Subtype.val ∘ weights)) k)
  [IsEmpty base.Rel] (Q : I → I → MvPolynomial (Fin 2) k) (exponents : Fin 0 → I →₀ ℕ)
  (scalars : I → I → kˣ) (θ : Multiset I)
  (t : {s : Seq (stendhalWeight 0 θ) // IsRedOrdered s})

local notation "signed" => addRedUpRelations RD (Subtype.val ∘ weights) k
  (addMixedBlackRelations RD (Subtype.val ∘ weights) k scalars
    (addDownRelations RD (Subtype.val ∘ weights) (affineCoverQ Q exponents) base))
local notation "comparison" => AlgEquiv.ofBijective
  (ordinaryToDownwardMatrix base Q exponents scalars (ν := θ))
  (ordinaryToDownwardMatrix_bijective_empty_red base Q exponents scalars θ)
local notation "scalarChange" => RingEquiv.toRingHom (RingEquiv.op (AlgEquiv.toRingEquiv comparison))
local notation "ordinaryIdem" => TensorProductAlgebra.mk Q exponents θ (StendhalAlgebra.e t.val t.property)

example : rIdeal ordinaryIdem ≃ₗ[(TensorProductAlgebra k Q exponents θ)ᵐᵒᵖ]
    ((ModuleCat.restrictScalars scalarChange).obj (boundaryRightModule signed θ (downTriple RD weights t))) := by
  apply boundaryRightModuleDownEquiv_restrict signed θ t (comparison).toRingEquiv ordinaryIdem
  have he : affineTensorProjection exponents θ (KLRAlgebra.e t.val) = ordinaryIdem := by
    apply congrArg (TensorProductAlgebra.mk Q exponents θ)
    apply Subtype.ext
    change affineCover Q exponents θ (KLRAlgebra.e t.val) *
      StendhalAlgebraAllOrders.redOrderedIdem k Q exponents θ = StendhalAlgebraAllOrders.e t.val
    simp [StendhalAlgebraAllOrders.e_mul_redOrderedIdem, t.property]
  change ordinaryToDownwardMatrix base Q exponents scalars ordinaryIdem = downE signed t.val
  rw [← he]
  exact ordinaryToDownwardMatrix_e base Q exponents scalars t.val

end EmptyRed

end Categorification.Stendhal.DoubleDiagram
