import Categorification.WeightedKLR.RedStrands.StendhalGrading
import Categorification.KLR.Examples.Small
import Categorification.KLR.ConcatAssoc
import Categorification.KLR.Induction
import Categorification.Algebra.InductionAlong
import Categorification.WeightedKLR.GradedK0.ResIndTwist

/-!
# Right black-strand induction for tensor product algebras

B. Webster, arXiv:1309.3796v2, §4.6, Definition 4.30 and the paragraph
following Theorem 4.31 describe the lowering functor by appending a black
strand at the far right. In the left-module convention the induction
bimodule is the left ideal generated by the image of the identity.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra
variable {I : Type*} {ℓ : ℕ}
section Loadings
variable (i : I) (ν : Multiset I)

local notation "μ" => stendhalWeight ℓ ν
local notation "σᵢ" => (Singleton.singleton (Sum.inl i) : Multiset (I ⊕ Fin ℓ))
local notation "νᵢ" => ((Singleton.singleton i : Multiset I) + ν)

private theorem stendhalWeight_addBlack : μ + σᵢ = stendhalWeight ℓ νᵢ := by
  simp only [stendhalWeight, Multiset.map_add, Multiset.map_singleton]
  ac_rfl

/-- Append the black colour at the right boundary, preserving all red positions. -/
def appendBlackLoading (s : Seq μ) : Seq (stendhalWeight ℓ νᵢ) :=
  Seq.cast (stendhalWeight_addBlack i ν) (s.append (default : Seq σᵢ))

private def appendBlackPosition (a : Fin (Multiset.card μ)) :
    Fin (Multiset.card (stendhalWeight ℓ νᵢ)) :=
  Fin.cast (congrArg Multiset.card (stendhalWeight_addBlack i ν)) (Seq.posL σᵢ a)

private theorem appendBlackLoading_lbl (s : Seq μ) (a : Fin (Multiset.card μ)) :
    (appendBlackLoading i ν s).lbl (appendBlackPosition i ν a) = s.lbl a := by
  simp only [appendBlackLoading, appendBlackPosition, Seq.cast_apply, Fin.cast_cast,
    Fin.cast_eq_self, Seq.append_posL]

private theorem oldPosition_of_red (s : Seq μ) (a : Fin (Multiset.card (stendhalWeight ℓ νᵢ)))
    (r : Fin ℓ) (ha : (appendBlackLoading i ν s).lbl a = .inr r) :
    ∃ c, a = appendBlackPosition i ν c := by
  by_cases hc : a.val < Multiset.card μ
  · exact ⟨⟨_, hc⟩, Fin.ext rfl⟩
  · change (s.append (default : Seq σᵢ)).1 (Fin.cast _ a) = _ at ha
    rw [Seq.append_apply_ge _ _ _ (le_of_not_gt hc)] at ha
    exact (Sum.inl_ne_inr (((Multiset.mem_singleton.mp ((default : Seq σᵢ).mem _))).symm.trans ha)).elim

/-- The far-right black strand preserves the order of the red strands. -/
theorem appendBlackLoading_ordered (s : Seq μ) (hs : IsRedOrdered s) :
    IsRedOrdered (appendBlackLoading i ν s) := by
  intro a c r t hac har hct
  obtain ⟨a, rfl⟩ := oldPosition_of_red i ν s a r har
  obtain ⟨c, rfl⟩ := oldPosition_of_red i ν s c t hct
  exact hs a c r t hac ((appendBlackLoading_lbl i ν s a).symm.trans har)
    ((appendBlackLoading_lbl i ν s c).symm.trans hct)

/-- A previously violated left boundary is still violated after adding a black strand. -/
theorem appendBlackLoading_violated (s : Seq μ) (hs : IsViolated s) :
    IsViolated (appendBlackLoading i ν s) := by
  obtain ⟨h, ha⟩ := hs
  have hp := (appendBlackPosition i ν (⟨0,h⟩ : Fin (Multiset.card μ))).isLt
  refine ⟨hp, ?_⟩
  change ((appendBlackLoading i ν s).lbl (appendBlackPosition i ν ⟨0,h⟩)).isLeft
  rwa [appendBlackLoading_lbl]

end Loadings

section Algebra

variable [DecidableEq I] {k : Type*} [CommRing k]
    (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ) (i : I) (ν : Multiset I)
local notation "μ" => stendhalWeight ℓ ν
local notation "σᵢ" => (Singleton.singleton (Sum.inl i) : Multiset (I ⊕ Fin ℓ))
local notation "νᵢ" => ((Singleton.singleton i : Multiset I) + ν)
local notation "S" => stendhalQ Q Λ
local notation "A" => StendhalAlgebraAllOrders k Q Λ νᵢ

private def appendBlackAmbient : KLRAlgebra k S (μ + σᵢ) →ₐ[k] A :=
  (StendhalAlgebraAllOrders.ofKLR k Q Λ νᵢ).comp
    (castKLR S (stendhalWeight_addBlack i ν)).toAlgHom

private def terminalIdem : A :=
  appendBlackAmbient Q Λ i ν (oneConcat S μ σᵢ)

private theorem isIdempotentElem_terminalIdem : IsIdempotentElem (terminalIdem Q Λ i ν) :=
  (oneConcat_idem (Q := S) (ν := μ) (ν' := σᵢ)).map (appendBlackAmbient Q Λ i ν)

local instance : Algebra k (isIdempotentElem_terminalIdem Q Λ i ν).Corner :=
  KLR.cornerAlgebra _

private def appendBlackConcatCorner :
    ConcatCorner S μ σᵢ →ₐ[k] (isIdempotentElem_terminalIdem Q Λ i ν).Corner where
  toFun z := KLR.Corner.mk (appendBlackAmbient Q Λ i ν z.val) (by
    have hz : oneConcat S μ σᵢ * z.val * oneConcat S μ σᵢ = z.val :=
      (congrArg (· * oneConcat S μ σᵢ) (KLR.Corner.E_mul_val z)).trans
        (KLR.Corner.val_mul_E z)
    simpa only [map_mul, terminalIdem] using congrArg (appendBlackAmbient Q Λ i ν) hz)
  map_one' := rfl
  map_zero' := Subtype.ext (map_zero _)
  map_add' x y := Subtype.ext (map_add _ x.val y.val)
  map_mul' x y := Subtype.ext (map_mul _ x.val y.val)
  commutes' c := Subtype.ext (by
    change appendBlackAmbient Q Λ i ν (algebraMap k _ c * oneConcat S μ σᵢ) =
      algebraMap k A c * terminalIdem Q Λ i ν
    rw [map_mul, AlgHom.commutes]
    rfl)

private def appendBlackKLR : KLRAlgebra k S μ →ₐ[k] (isIdempotentElem_terminalIdem Q Λ i ν).Corner :=
  (appendBlackConcatCorner Q Λ i ν).comp ((blockL μ σᵢ).hom S)

private theorem appendBlackKLR_e (s : Seq μ) :
    (appendBlackKLR Q Λ i ν (KLRAlgebra.e s)).val =
      StendhalAlgebraAllOrders.e (appendBlackLoading i ν s) := by
  have hf : (blockL μ σᵢ).F s = {s.append (default : Seq σᵢ)} := by
    classical
    ext t
    change t ∈ Finset.univ.image (fun a : Seq σᵢ => s.append a) ↔ _
    simp only [Finset.mem_image, Finset.mem_univ, true_and, Finset.mem_singleton]
    exact ⟨fun ⟨a, ha⟩ => ha ▸ congrArg s.append (Subsingleton.elim a default),
      fun h => ⟨default, h.symm⟩⟩
  change appendBlackAmbient Q Λ i ν (((blockL μ σᵢ).hom S) (KLRAlgebra.e s)).val = _
  rw [BlockEmb.hom_e, BlockEmb.val_gE, BlockEmb.eF, hf, eSum, Finset.sum_singleton]
  exact congrArg (StendhalAlgebraAllOrders.ofKLR k Q Λ νᵢ) (castKLR_e (stendhalWeight_addBlack i ν) _)

private theorem appendBlackKLR_x (a : Fin (Multiset.card μ)) :
    (appendBlackKLR Q Λ i ν (KLRAlgebra.x a)).val =
      StendhalAlgebraAllOrders.x (appendBlackPosition i ν a) * terminalIdem Q Λ i ν := by
  change appendBlackAmbient Q Λ i ν (((blockL μ σᵢ).hom S) (KLRAlgebra.x a)).val = _
  rw [BlockEmb.hom_x, val_polCorner, pol_X, map_mul]
  congr 1
  exact congrArg (StendhalAlgebraAllOrders.ofKLR k Q Λ νᵢ) (castKLR_x (stendhalWeight_addBlack i ν) _)

private theorem appendBlackKLR_ψ {j : ℕ} (hj : j + 1 < Multiset.card μ) :
    (appendBlackKLR Q Λ i ν (KLRAlgebra.ψ j)).val =
      StendhalAlgebraAllOrders.ψ j * terminalIdem Q Λ i ν := by
  change appendBlackAmbient Q Λ i ν (((blockL μ σᵢ).hom S) (KLRAlgebra.ψ j)).val = _
  rw [BlockEmb.hom_ψ, BlockEmb.val_gψ _ hj, map_mul]
  congr 1
  simp only [blockL, Nat.zero_add]
  exact congrArg (StendhalAlgebraAllOrders.ofKLR k Q Λ νᵢ) (castKLR_ψ (stendhalWeight_addBlack i ν) j)

/-- Append the new black strand on the right of a diagram, before imposing the
violating ideal. The corner includes all orders of the earlier red strands. -/
def appendBlackAllOrders :
    StendhalAlgebraAllOrders k Q Λ ν →ₐ[k] (isIdempotentElem_terminalIdem Q Λ i ν).Corner :=
  RingQuot.liftAlgHom k
    ⟨(appendBlackKLR Q Λ i ν).comp (KLRAlgebra.mk k (stendhalQ Q Λ) μ), fun x y h => by
      cases h with
      | klr h =>
        exact congrArg (appendBlackKLR Q Λ i ν) (RingQuot.mkAlgHom_rel k h)
      | red_dot a s ha =>
        apply KLR.Corner.ext
        simp only [AlgHom.comp_apply, map_mul, map_zero, KLR.Corner.val_mul, KLR.Corner.val_zero]
        change (appendBlackKLR Q Λ i ν (KLRAlgebra.x a)).val *
          (appendBlackKLR Q Λ i ν (KLRAlgebra.e s)).val = 0
        have hs := KLR.Corner.E_mul_val (appendBlackKLR Q Λ i ν (KLRAlgebra.e s))
        rw [appendBlackKLR_e] at hs
        rw [appendBlackKLR_x, appendBlackKLR_e, mul_assoc]
        change StendhalAlgebraAllOrders.x (appendBlackPosition i ν a) *
          (terminalIdem Q Λ i ν * StendhalAlgebraAllOrders.e (appendBlackLoading i ν s)) = _
        rw [hs]
        have ha' : ((appendBlackLoading i ν s).lbl (appendBlackPosition i ν a)).isRight := by
          simpa only [appendBlackLoading_lbl] using ha
        exact StendhalAlgebraAllOrders.x_mul_e_of_red (appendBlackPosition i ν a) (appendBlackLoading i ν s) ha'
      | red_cross j hj s ha hb =>
        apply KLR.Corner.ext
        simp only [AlgHom.comp_apply, map_mul, map_zero, KLR.Corner.val_mul, KLR.Corner.val_zero]
        change (appendBlackKLR Q Λ i ν (KLRAlgebra.ψ j)).val *
          (appendBlackKLR Q Λ i ν (KLRAlgebra.e s)).val = 0
        have hs := KLR.Corner.E_mul_val (appendBlackKLR Q Λ i ν (KLRAlgebra.e s))
        rw [appendBlackKLR_e] at hs
        rw [appendBlackKLR_ψ Q Λ i ν hj, appendBlackKLR_e, mul_assoc]
        change StendhalAlgebraAllOrders.ψ j *
          (terminalIdem Q Λ i ν * StendhalAlgebraAllOrders.e (appendBlackLoading i ν s)) = _
        rw [hs]
        have hj' : j + 1 < Multiset.card (stendhalWeight ℓ νᵢ) := by
          simp [stendhalWeight] at hj ⊢
          omega
        have ha' : ((appendBlackLoading i ν s).lbl ⟨j, by omega⟩).isRight := by
          rw [show (⟨j, by omega⟩ : Fin (Multiset.card (stendhalWeight ℓ νᵢ))) =
            appendBlackPosition i ν ⟨j, by omega⟩ from Fin.ext rfl, appendBlackLoading_lbl]
          exact ha
        have hb' : ((appendBlackLoading i ν s).lbl ⟨j + 1, hj'⟩).isRight := by
          rw [show (⟨j + 1, hj'⟩ : Fin (Multiset.card (stendhalWeight ℓ νᵢ))) =
            appendBlackPosition i ν ⟨j + 1, hj⟩ from Fin.ext rfl, appendBlackLoading_lbl]
          exact hb
        exact StendhalAlgebraAllOrders.ψ_mul_e_of_red j hj' (appendBlackLoading i ν s) ha' hb'⟩

private theorem appendBlackAllOrders_ofKLR (z : KLRAlgebra k (stendhalQ Q Λ) μ) :
    appendBlackAllOrders Q Λ i ν (StendhalAlgebraAllOrders.ofKLR k Q Λ ν z) =
      appendBlackKLR Q Λ i ν z := by
  obtain ⟨w, rfl⟩ := KLRAlgebra.mk_surjective z
  rw [StendhalAlgebraAllOrders.ofKLR_mk]
  exact RingQuot.liftAlgHom_mkAlgHom_apply _ _ _ _

theorem appendBlackAllOrders_e (s : Seq μ) :
    (appendBlackAllOrders Q Λ i ν (StendhalAlgebraAllOrders.e s)).val =
      StendhalAlgebraAllOrders.e (appendBlackLoading i ν s) := by
  rw [StendhalAlgebraAllOrders.e, appendBlackAllOrders_ofKLR, appendBlackKLR_e]

/-- Adjoining the rightmost strand preserves an old dot at its original position
and cuts by the terminal idempotent in the upper block. -/
theorem appendBlackAllOrders_x (a : Fin (Multiset.card μ)) :
    (appendBlackAllOrders Q Λ i ν (StendhalAlgebraAllOrders.x a)).val =
      StendhalAlgebraAllOrders.x
        (⟨a.val, by simpa only [← stendhalWeight_addBlack i ν, Multiset.card_add,
          Multiset.card_singleton] using Nat.lt_succ_of_lt a.isLt⟩ : Fin (stendhalWeight ℓ νᵢ).card) *
        (appendBlackAllOrders Q Λ i ν 1).val := by
  rw [StendhalAlgebraAllOrders.x, appendBlackAllOrders_ofKLR, appendBlackKLR_x, map_one]
  rfl

/-- Adjoining a rightmost straight strand preserves each old crossing, cut by the
terminal idempotent in the upper block. -/
theorem appendBlackAllOrders_ψ (j : ℕ) (hj : j + 1 < Multiset.card μ) :
    (appendBlackAllOrders Q Λ i ν (StendhalAlgebraAllOrders.ψ j)).val =
      StendhalAlgebraAllOrders.ψ j * (appendBlackAllOrders Q Λ i ν 1).val := by
  rw [StendhalAlgebraAllOrders.ψ, appendBlackAllOrders_ofKLR, appendBlackKLR_ψ Q Λ i ν hj, map_one]
  rfl

private def appendBlackValue : StendhalAlgebraAllOrders k Q Λ ν →ₙ+* A :=
  (KLR.cornerVal (isIdempotentElem_terminalIdem Q Λ i ν)).comp
    (appendBlackAllOrders Q Λ i ν).toRingHom.toNonUnitalRingHom

private theorem appendBlackValue_e (s : Seq μ) :
    appendBlackValue Q Λ i ν (StendhalAlgebraAllOrders.e s) =
      StendhalAlgebraAllOrders.e (appendBlackLoading i ν s) :=
  appendBlackAllOrders_e Q Λ i ν s

private theorem appendBlackValue_smul (c : k) (z : StendhalAlgebraAllOrders k Q Λ ν) :
    appendBlackValue Q Λ i ν (c • z) = c • appendBlackValue Q Λ i ν z := by
  change (appendBlackAllOrders Q Λ i ν (c • z)).val =
    c • (appendBlackAllOrders Q Λ i ν z).val
  rw [AlgHom.map_smul_of_tower, KLR.Corner.val_smul]

/-- The all-orders right-black embedding is linear on diagram coefficients. -/
theorem appendBlackAllOrders_smul (c : k) (z : StendhalAlgebraAllOrders k Q Λ ν) :
    (appendBlackAllOrders Q Λ i ν (c • z)).val = c • (appendBlackAllOrders Q Λ i ν z).val :=
  appendBlackValue_smul Q Λ i ν c z

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

private theorem appendBlackValue_ordered :
    appendBlackValue Q Λ i ν (StendhalAlgebraAllOrders.redOrderedIdem k Q Λ ν) ∈
      Subsemigroup.corner (StendhalAlgebraAllOrders.redOrderedIdem k Q Λ νᵢ) := by
  classical
  apply (Subsemigroup.mem_corner_iff StendhalAlgebraAllOrders.isIdempotentElem_redOrderedIdem).2
  let J := Finset.univ.filter (fun s : Seq μ => IsRedOrdered s)
  let P := StendhalAlgebraAllOrders.redOrderedIdem k Q Λ νᵢ
  let E := ∑ s ∈ J, (StendhalAlgebraAllOrders.e s : StendhalAlgebraAllOrders k Q Λ ν)
  change P * appendBlackValue Q Λ i ν E = appendBlackValue Q Λ i ν E ∧
    appendBlackValue Q Λ i ν E * P = appendBlackValue Q Λ i ν E
  dsimp only [E]
  simp only [map_sum, appendBlackValue_e]
  constructor
  · rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun s hs => ?_
    exact (StendhalAlgebraAllOrders.redOrderedIdem_mul_e _).trans
      (ite_eq_left (appendBlackLoading_ordered i ν s (Finset.mem_filter.mp hs).2))
  · rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun s hs => ?_
    exact (StendhalAlgebraAllOrders.e_mul_redOrderedIdem _).trans
      (ite_eq_left (appendBlackLoading_ordered i ν s (Finset.mem_filter.mp hs).2))

private theorem appendBlackValue_corner (z : StendhalAlgebra k Q Λ ν) :
    appendBlackValue Q Λ i ν z.val ∈
      Subsemigroup.corner (StendhalAlgebraAllOrders.redOrderedIdem k Q Λ νᵢ) := by
  let f := appendBlackValue Q Λ i ν
  let E : StendhalAlgebra k Q Λ νᵢ := ⟨_, appendBlackValue_ordered Q Λ i ν⟩
  have hl : E.val * f z.val = f z.val :=
    (map_mul f _ _).symm.trans (congrArg f (KLR.Corner.E_mul_val z))
  have hr : f z.val * E.val = f z.val :=
    (map_mul f _ _).symm.trans (congrArg f (KLR.Corner.val_mul_E z))
  apply (Subsemigroup.mem_corner_iff StendhalAlgebraAllOrders.isIdempotentElem_redOrderedIdem).2
  exact ⟨by rw [← hl, ← mul_assoc]; exact congrArg (· * f z.val) (KLR.Corner.E_mul_val E),
    by rw [← hr, mul_assoc]; exact congrArg (f z.val * ·) (KLR.Corner.val_mul_E E)⟩

private def appendBlackStendhal : StendhalAlgebra k Q Λ ν →ₙₐ[k] StendhalAlgebra k Q Λ νᵢ where
  toFun z := ⟨appendBlackValue Q Λ i ν z.val, appendBlackValue_corner Q Λ i ν z⟩
  map_zero' := Subtype.ext (map_zero (appendBlackValue Q Λ i ν))
  map_add' x y := Subtype.ext (map_add (appendBlackValue Q Λ i ν) x.val y.val)
  map_mul' x y := Subtype.ext (map_mul (appendBlackValue Q Λ i ν) x.val y.val)
  map_smul' c z := Subtype.ext (appendBlackValue_smul Q Λ i ν c z.val)

private theorem appendBlackStendhal_e (s : Seq μ) (hs : IsRedOrdered s) :
    appendBlackStendhal Q Λ i ν (StendhalAlgebra.e s hs) =
      StendhalAlgebra.e (appendBlackLoading i ν s) (appendBlackLoading_ordered i ν s hs) :=
  Subtype.ext (appendBlackValue_e Q Λ i ν s)

local notation "T" => TensorProductAlgebra k Q Λ ν
local notation "T'" => TensorProductAlgebra k Q Λ νᵢ
local notation "π" => TensorProductAlgebra.mk Q Λ ν
local notation "π'" => TensorProductAlgebra.mk Q Λ νᵢ

private def intoQuotient : StendhalAlgebra k Q Λ ν →ₙₐ[k] T' :=
  (π').toNonUnitalAlgHom.comp (appendBlackStendhal Q Λ i ν)

private theorem appendBlack_ker :
    StendhalAlgebra.violatedIdeal k Q Λ ν ≤ TwoSidedIdeal.ker (intoQuotient Q Λ i ν) := by
  apply TwoSidedIdeal.span_le.2
  rintro _ ⟨s, hs, hV, rfl⟩
  apply (TwoSidedIdeal.mem_ker _).2
  change π' (appendBlackStendhal Q Λ i ν (StendhalAlgebra.e s hs)) = 0
  rw [appendBlackStendhal_e]
  change (StendhalAlgebra.violatedIdeal k Q Λ νᵢ).ringCon.mk' _ = 0
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk']
  exact TwoSidedIdeal.subset_span ⟨_, _, appendBlackLoading_violated i ν s hV, rfl⟩

/-- Webster's map `ν_i` which adjoins a black strand on the right,
arXiv:1309.3796v2, §4.6, following Theorem 4.31. -/
def appendBlack : T →ₙₐ[k] T' where
  toFun := Quotient.lift (intoQuotient Q Λ i ν)
    (fun _ _ h => (TwoSidedIdeal.ringCon_le_iff.mp (appendBlack_ker Q Λ i ν)) h)
  map_zero' := map_zero (intoQuotient Q Λ i ν)
  map_add' := by rintro ⟨x⟩ ⟨y⟩; exact map_add (intoQuotient Q Λ i ν) x y
  map_mul' := by rintro ⟨x⟩ ⟨y⟩; exact map_mul (intoQuotient Q Λ i ν) x y
  map_smul' := by rintro c ⟨x⟩; exact map_smul (intoQuotient Q Λ i ν) c x

/-- On an ordered boundary idempotent the map appends the black label to its sequence. -/
theorem appendBlack_mk_e (s : Seq μ) (hs : IsRedOrdered s) :
    appendBlack Q Λ i ν (π (StendhalAlgebra.e s hs)) =
      π' (StendhalAlgebra.e (appendBlackLoading i ν s) (appendBlackLoading_ordered i ν s hs)) :=
  congrArg π' (appendBlackStendhal_e Q Λ i ν s hs)

local instance : Fintype {s : Seq μ // IsRedOrdered s} := Fintype.ofFinite _

/-- The image of the unit is the sum of the right-black boundary idempotents
obtained by extending every ordered loading in the previous block. -/
theorem appendBlack_one :
    appendBlack Q Λ i ν 1 = ∑ s : {s : Seq μ // IsRedOrdered s},
      π' (StendhalAlgebra.e (appendBlackLoading i ν s.1) (appendBlackLoading_ordered i ν s.1 s.2)) := by
  classical
  have h : (1 : StendhalAlgebra k Q Λ ν) = ∑ s : {s : Seq μ // IsRedOrdered s},
      StendhalAlgebra.e s.1 s.2 := by
    apply Subtype.ext
    rw [KLR.Corner.val_one, KLR.Corner.val_sum]
    exact Finset.sum_subtype _ (fun s => by simp) _
  rw [← map_one π, h, map_sum, map_sum]
  exact Finset.sum_congr rfl fun s _ => appendBlack_mk_e Q Λ i ν s.1 s.2

/-- Appending a straight black strand preserves the degree of every diagram. -/
theorem appendBlack_mem_grade (G : GradingDatum S) {d : ℤ} {x : T}
    (hx : x ∈ tensorProductGrade G ν d) :
    appendBlack Q Λ i ν x ∈ tensorProductGrade G νᵢ d := by
  obtain ⟨z, hz, rfl⟩ := Submodule.mem_map.mp hx
  apply Graded.mem_map_of_mem (stendhalGrade G νᵢ) (π').toLinearMap
  change appendBlackValue Q Λ i ν z.val ∈ allOrdersGrade G νᵢ d
  obtain ⟨a, ha, he⟩ := Submodule.mem_map.mp
    (show z.val ∈ allOrdersGrade G ν d from hz)
  change StendhalAlgebraAllOrders.ofKLR k Q Λ ν a = z.val at he
  rw [← he]
  change (appendBlackAllOrders Q Λ i ν _).val ∈ _
  rw [appendBlackAllOrders_ofKLR]
  apply Graded.mem_map_of_mem
  exact G.castKLR_mem_grade _ ((blockL μ σᵢ).valHom_mem_grade G ha)

end Algebra

section Lowering

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

open Categorification.Graded DirectSum MulOpposite
variable [DecidableEq I] {k : Type*} [Field k] {Q : I → I → MvPolynomial (Fin 2) k}
    {Λ : Fin ℓ → I →₀ ℕ} (G : GradingDatum (stendhalQ Q Λ)) (i : I) (ν : Multiset I)
local notation "νᵢ" => ((Singleton.singleton i : Multiset I) + ν)
local notation "src" => tensorProductGrade G ν
local notation "dst" => tensorProductGrade G νᵢ
local notation "T" => TensorProductAlgebra k Q Λ ν
local notation "T'" => TensorProductAlgebra k Q Λ νᵢ
local notation "φ" => appendBlack Q Λ i ν
local notation "Mc" => InductionAlong.Corner (φ : T →ₙ+* T')
local notation "cornerGr" => Graded.submodule dst (lIdeal (φ 1))

private def blackProjective : GProj dst :=
  GProj.ofIdempotent (φ 1) (InductionAlong.unit_mul_unit (φ : T →ₙ+* T'))
    (appendBlack_mem_grade Q Λ i ν G SetLike.GradedOne.one_mem)

private local instance : Module.Finite T' Mc :=
  Module.Finite.of_surjective (leftIdealProj (InductionAlong.unit_mul_unit (φ : T →ₙ+* T')))
    fun z => ⟨z, Subtype.ext z.property⟩

private local instance : Module.Projective T' Mc :=
  Module.Projective.of_split (leftIdeal (φ 1)).subtype
    (leftIdealProj (InductionAlong.unit_mul_unit (φ : T →ₙ+* T'))) (leftIdealProj_comp_subtype _)

private theorem blackScalarTower : IsScalarTower k T' Mc where
  smul_assoc c a z := Subtype.ext (smul_mul_assoc c a z.val)
private local instance : DirectSum.Decomposition cornerGr := (blackProjective G i ν).decomposition
private local instance : IsScalarTower k Tᵐᵒᵖ Mc where
  smul_assoc c r z := Subtype.ext (by
    change z.val * φ (c • r.unop) = c • (z.val * φ r.unop)
    rw [map_smul, mul_smul_comm])

private theorem blackRightAction_mem {d n : ℤ} {m : Mc} {a : T}
    (hm : m ∈ cornerGr d) (ha : a ∈ src n) : op a • m ∈ cornerGr (d + n) :=
  SetLike.GradedMul.mul_mem (A := dst) hm (appendBlack_mem_grade Q Λ i ν G ha)

/-- The left-projective form of Webster's lowering functor (arXiv:1309.3796v2,
§4.6, Definition 4.30 and the paragraph following Theorem 4.31).
The new block acts on the left of the one-sided ideal. The old block acts
on its right by appending the straight black strand. -/
def blackIndProj (P : GProj src) : GProj dst :=
  @balancedIndGProj k _ T' _ _ dst T _ _ src _ Mc _ _ _ (blackScalarTower i ν) _ _ _ _ _ cornerGr
    (blackProjective G i ν).decomposition (blackProjective G i ν).gradedSMul
    (fun _ _ _ _ => blackRightAction_mem G i ν) P

/-- The unshifted lowering operator on integral graded projective Grothendieck
groups, defined by right black-strand induction in each weight (Webster,
arXiv:1309.3796v2, §4.6 after Theorem 4.31, and §4.7, Theorem 4.38). -/
def blackIndK0 : K0 src →ₗ[LaurentPolynomial ℤ] K0 dst :=
  @balancedIndK0 k _ T' _ _ dst T _ _ src _ Mc _ _ _ (blackScalarTower i ν) _ _ _ _ _ cornerGr
    (blackProjective G i ν).decomposition (blackProjective G i ν).gradedSMul
    (fun _ _ _ _ => blackRightAction_mem G i ν)

@[simp] theorem blackIndK0_of (P : GProj src) :
    blackIndK0 G i ν (K0.of P) = K0.of (blackIndProj G i ν P) :=
  @balancedIndK0_of k _ T' _ _ dst T _ _ src _ Mc _ _ _ (blackScalarTower i ν) _ _ _ _ _ cornerGr
    (blackProjective G i ν).decomposition (blackProjective G i ν).gradedSMul
    (fun _ _ _ _ => blackRightAction_mem G i ν) P

/-- The regular projective induces to the principal projective at the
right-black boundary idempotent. -/
theorem blackIndK0_regular :
    blackIndK0 G i ν (K0.of (GProj.regular src)) =
      K0.of (GProj.ofIdempotent (φ 1) (InductionAlong.unit_mul_unit (φ : T →ₙ+* T'))
        (appendBlack_mem_grade Q Λ i ν G SetLike.GradedOne.one_mem)) := by
  let : IsScalarTower k T' Mc := blackScalarTower i ν
  rw [blackIndK0_of]
  apply K0.of_eq_of_iso
  refine GradedEquiv.ofPreserves (BalancedTensor.rid k T' T Mc) ?_
  intro d y hy
  apply @balancedGrading_map_mem ℤ _ k T' T Mc T _ _ _ _ _ _ _ (blackScalarTower i ν)
    _ _ _ _ cornerGr src Mc _ _ cornerGr
    ((BalancedTensor.rid k T' T Mc).toLinearMap.restrictScalars k) _ d y hy
  intro d n m a hm ha
  exact blackRightAction_mem G i ν hm ha

local notation "K" => fun β : Multiset I => K0 (tensorProductGrade G β)

/-- The action of the lowering generator on the sum of all black weights,
obtained from the `ν_i` induction of Webster §4.6. -/
def blackLower : (⨁ β : Multiset I, K β) →ₗ[LaurentPolynomial ℤ] ⨁ β : Multiset I, K β :=
  DirectSum.toModule _ _ _ fun β =>
    DirectSum.lof _ _ _ ((Singleton.singleton i : Multiset I) + β) ∘ₗ blackIndK0 G i β

@[simp] theorem blackLower_lof (x : K ν) :
    blackLower G i (DirectSum.lof (LaurentPolynomial ℤ) _ K ν x) = DirectSum.lof (LaurentPolynomial ℤ) _ K νᵢ (blackIndK0 G i ν x) :=
  DirectSum.toModule_lof ..

end Lowering

end Categorification.Stendhal
