import Categorification.Algebra.DerivedTensorProjectiveCoefficient

/-!
# Quotients by stratifying ideals have no higher Tor

Let the right `B`-modules `S c` have ordered standard covers `0 → U_c → e_c B → S c → 0`
(`ModuleFiltration.OrderedStandardCovers`, over `Bᵐᵒᵖ`) for a well-founded relation `above`,
and let `G` be a set of labels closed upwards. Let `0 → V → M → M' → 0` be a short exact
sequence of right `B`-modules with `M` projective and `V` filtered by standards `S c`,
`c ∈ G`. Then for every left `B`-module `X` killed by the idempotents `e c`, `c ∈ G`, the
derived tensor product `M' ⊗ᴸ_B X` has no cohomology outside degree `0`
(`isZero_derivedTensorHomology_quotient_of_stratum`).

The proof: each `S c ⊗ᴸ X`, `c ∈ G`, vanishes in every degree
(`isZero_derivedTensorHomology_of_orderedStandardCovers_annihilated`), hence so does `V ⊗ᴸ X`
by the filtration; `M ⊗ᴸ X` is concentrated in degree `0` since `M` is projective; and the long
exact sequence of the coefficients gives the claim.

For a standardly stratified algebra `A` and the ideal `V` generated by the idempotents of an
upper set of strata, applied with `M = A` and `M' = A/V`, this says `A → A/V` is a homological
epimorphism: `Tor^A_{>0}(A/V, X) = 0` for every `A/V`-module `X`. This is the form needed for
B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, with
`A = T̃^λ`, standardly stratified by Corollary 5.23, and `A/V = T^λ`.

## Main results

* `isZero_derivedTensorHomology_of_hasFiltration_annihilated`,
  `isZero_derivedTensorHomology_quotient_of_stratum`.
-/

open CategoryTheory CategoryTheory.Limits DG DG.DegreeZero DG.DerivedCategory MulOpposite
open scoped DG.DegreeZero

noncomputable section

namespace Categorification

universe w

variable {B : Type} [Ring B] [HasDerivedCategory.{w, 0} ℤ] [HasDerivedCategory.{w, 0} B]
  {ι : Type*} {S : ι → ModuleCat.{0} Bᵐᵒᵖ} {e : ι → Bᵐᵒᵖ} {above : ι → ι → Prop}

/-- The derived tensor products with an ordinary module and with its projective resolution
have the same cohomology. -/
private def resolutionHomologyIso (X : ModuleCat.{0} B) (M : ModuleCat.{0} Bᵐᵒᵖ) (j : ℤ) :
    (homologyFunctor ℤ j).obj ((derivedTensor.{w} ℤ B M).obj
        (Q.obj (projectiveResolutionDGModel (projectiveResolution X)))) ≅
      (homologyFunctor ℤ j).obj ((derivedTensor.{w} ℤ B M).obj
        (Q.obj (DGModuleCat.of B (InDegreeZero X)))) :=
  have : IsIso (Q.map (projectiveResolutionDGAugToOrdinary (projectiveResolution X))) :=
    (isIso_Q_map_iff _).mpr (projectiveResolutionDGAugToOrdinary_quasiIso _)
  (homologyFunctor ℤ j).mapIso ((derivedTensor.{w} ℤ B M).mapIso
    (asIso (Q.map (projectiveResolutionDGAugToOrdinary (projectiveResolution X)))))

/-- **Tor vanishing for a coefficient filtered by standards of an upper set**: if `V` is
filtered by standards `S c`, `c ∈ G`, then `V ⊗ᴸ X` vanishes in every degree for every `X`
killed by the idempotents `e c`, `c ∈ G`. -/
theorem isZero_derivedTensorHomology_of_hasFiltration_annihilated
    (D : ModuleFiltration.OrderedStandardCovers S e above)
    (hwf : WellFounded fun a b => above b a) (G : Set ι)
    (hG : ∀ c d, c ∈ G → above c d → d ∈ G) (he : ∀ c ∈ G, IsIdempotentElem (e c))
    {V : ModuleCat.{0} Bᵐᵒᵖ} {m : List ι} (hm : ∀ c ∈ m, c ∈ G)
    (hV : ModuleFiltration.HasFiltration S m V)
    (X : ModuleCat.{0} B) (hX : ∀ c ∈ G, ∀ x : X, (e c).unop • x = 0) (n : ℤ) :
    IsZero ((homologyFunctor ℤ n).obj
      ((derivedTensor.{w} ℤ B V).obj (Q.obj (DGModuleCat.of B (InDegreeZero X))))) := by
  refine (hV.isZero_derivedTensorHomology_coefficient
    (projectiveResolutionDGModel_kProjective (projectiveResolution X)) n
    fun c hc => ?_).of_iso (resolutionHomologyIso X V n).symm
  exact (isZero_derivedTensorHomology_of_orderedStandardCovers_annihilated D hwf G hG he X hX c
    (hm c hc) n).of_iso (resolutionHomologyIso X (S c) n)

/-- **Quotients by a stratifying coefficient have no higher Tor**: for a short exact sequence
`0 → V → M → M' → 0` of right modules with `M` projective and `V` filtered by standards of an
upper set `G`, the derived tensor `M' ⊗ᴸ X` with any `X` killed by the idempotents `e c`,
`c ∈ G`, vanishes outside degree `0`. -/
theorem isZero_derivedTensorHomology_quotient_of_stratum
    (D : ModuleFiltration.OrderedStandardCovers S e above)
    (hwf : WellFounded fun a b => above b a) (G : Set ι)
    (hG : ∀ c d, c ∈ G → above c d → d ∈ G) (he : ∀ c ∈ G, IsIdempotentElem (e c))
    {V M M' : ModuleCat.{0} Bᵐᵒᵖ} [Module.Projective Bᵐᵒᵖ M] {m : List ι}
    (hm : ∀ c ∈ m, c ∈ G) (hV : ModuleFiltration.HasFiltration S m V)
    (f : V →ₗ[Bᵐᵒᵖ] M) (g : M →ₗ[Bᵐᵒᵖ] M') (hinj : Function.Injective f)
    (hex : Function.Exact f g) (hsurj : Function.Surjective g)
    (X : ModuleCat.{0} B) (hX : ∀ c ∈ G, ∀ x : X, (e c).unop • x = 0) (n : ℤ) (hn : n ≠ 0) :
    IsZero ((homologyFunctor ℤ n).obj
      ((derivedTensor.{w} ℤ B M').obj (Q.obj (DGModuleCat.of B (InDegreeZero X))))) := by
  let R := projectiveResolution X
  refine (isZero_derivedTensorHomology_coefficient_quotient (f.restrictScalars ℤ)
    (fun b x => f.map_smul (op b) x) (g.restrictScalars ℤ) (fun b x => g.map_smul (op b) x)
    (LinearMap.ext fun x => hex.apply_apply_eq_zero x) hinj hex hsurj
    (projectiveResolutionDGModel_kProjective R) (fun j => ?_) (fun j hj => ?_) n hn).of_iso
    (resolutionHomologyIso X M' n).symm
  · exact (isZero_derivedTensorHomology_of_hasFiltration_annihilated D hwf G hG he hm hV X hX
      j).of_iso (resolutionHomologyIso X V j)
  · exact isZero_derivedTensorHomology_projective_coefficient (A := ℤ) M X
      (projectiveResolutionDGAugToOrdinary R) (projectiveResolutionDGAugToOrdinary_quasiIso R)
      j hj

end Categorification
