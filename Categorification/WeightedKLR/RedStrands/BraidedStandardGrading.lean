/-!
# The internal grading at the Figure 5 loadings

Webster, arXiv:1309.3796v2, §4.1 Definition 4.4 and §6.1 Definition 6.2 and
Proposition 6.9, Figure 5.
The integer degree used for the ambient KLR algebra is auxiliary: it counts the
red/red crossing with its Stendhal auxiliary degree `-2`. In Webster's grading
that crossing instead has degree minus the pairing of the two red weights.
-/

noncomputable section
namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR MvPolynomial Categorification.Graded DirectSum Equiv TypeA QuantumGroup

section QuotientGrading

variable {I k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}
  (G : KLR.GradingDatum (stendhalQ Q Λ))

local notation "μ" => stendhalWeight ℓ ν
local notation "π" => ofKLR k Q Λ ν
local notation "q" => violMk k Q Λ ν

/-- The image of the augmented KLR grading on braided diagrams. The degree of a red/red
crossing in this auxiliary grading is the one in `G`, not the degree of Definition 6.2. -/
def auxiliaryGrade : ℤ → Submodule k (BraidedStendhalAlgebra k Q Λ ν) :=
  Graded.map (G.grade μ) (π).toLinearMap

private def gradeCoaction :
    BraidedStendhalAlgebra k Q Λ ν →ₐ[k] AddMonoidAlgebra (BraidedStendhalAlgebra k Q Λ ν) ℤ :=
  let f := (AddMonoidAlgebra.mapAlgHom ℤ π).comp G.coaction
  RingQuot.liftAlgHom k ⟨f.comp (KLRAlgebra.mk k _ μ), by
    intro a b hab
    cases hab with
    | klr h => exact congrArg f (RingQuot.mkAlgHom_rel k h)
    | red_dot a i h =>
      change AddMonoidAlgebra.mapAlgHom ℤ π (G.coaction (KLRAlgebra.mk k _ μ _)) = _
      rw [map_mul]
      change AddMonoidAlgebra.mapAlgHom ℤ π (G.coaction (KLRAlgebra.x a * KLRAlgebra.e i)) = _
      rw [G.mem_grade.mp (G.x_mul_e_mem_grade a i), AddMonoidAlgebra.mapAlgHom_single,
        ofKLR_x_mul_e_of_red a i h, AddMonoidAlgebra.single_zero, map_zero]⟩

private theorem gradeCoaction_ofKLR (x : KLRAlgebra k (stendhalQ Q Λ) μ) :
    gradeCoaction G (π x) = AddMonoidAlgebra.mapAlgHom ℤ π (G.coaction x) := by
  obtain ⟨a, rfl⟩ := KLRAlgebra.mk_surjective x
  rw [ofKLR_mk]
  exact RingQuot.liftAlgHom_mkAlgHom_apply _ _ _ _

instance auxiliaryGradedAlgebra : GradedAlgebra (auxiliaryGrade (ν := ν) G) :=
  Graded.mapGradedAlgebra (G.grade μ) π ofKLR_surjective fun x hx n => by
    have h := congrArg (fun a => (gradeCoaction G a).coeff n) hx
    rw [G.decompose_apply]
    simpa only [gradeCoaction_ofKLR, AddMonoidAlgebra.coeff_mapAlgHom, map_zero,
      AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply] using h

/-- The violated diagram quotient inherits the auxiliary grading, since the ideal is
 generated by loading idempotents. -/
def violAuxiliaryGrade : ℤ → Submodule k (ViolQuotient k Q Λ ν) :=
  Graded.map (auxiliaryGrade G) (q).toLinearMap

instance violAuxiliaryGradedAlgebra : GradedAlgebra (violAuxiliaryGrade (ν := ν) G) :=
  Graded.mapGradedAlgebra (auxiliaryGrade G) q violMk_surjective fun x hx n =>
    (violMk_eq_zero_iff _).2 <| by
      have h := (violMk_eq_zero_iff _).1 hx
      unfold violIdeal at h ⊢
      apply Graded.decompose_mem_twoSidedSpan (auxiliaryGrade G) _ h n
      rintro _ ⟨i, _, rfl⟩
      exact ⟨0, Graded.mem_map_of_mem _ (π).toLinearMap (G.e_mem_grade i)⟩

end QuotientGrading

section FigureFive

variable {I : Type} {k : Type*} [DecidableEq I] [CommRing k]
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin 2 → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight 2 ν
local notation "m" => Multiset.card (stendhalWeight 2 ν)
local notation "π" => ofKLR k Q Λ ν
local notation "q" => violMk k Q Λ ν

omit [DecidableEq I] in
private theorem EdgeBraid.invSet_eq_erase {h0 : 0 < m} {r : Fin 2} {g : Perm (Fin m)}
    {s t : Seq μ} (hb : EdgeBraid h0 r g s t) (ht : t.lbl ⟨0, h0⟩ = .inr r) :
    invSet m g = (Finset.univ.erase ⟨0, h0⟩).map
      ⟨fun b => (⟨0, h0⟩, b), fun _ _ h => congrArg Prod.snd h⟩ := by
  let z : Fin m := ⟨0, h0⟩
  let l : Fin m := ⟨m - 1, by omega⟩
  have hz : g z = l := by
    apply lbl_inj_of_inr s r _ hb.last
    rw [← hb.smul_eq, lbl_smul, Perm.coe_inv, Equiv.symm_apply_apply]
    exact ht
  have hg (b : Fin m) (hb' : b ≠ z) : (g b : ℕ) + 1 = b := by
    have hn : (g b : ℕ) ≠ m - 1 := fun h => hb' (g.injective ((Fin.ext h).trans hz.symm))
    simpa only [Perm.coe_inv, Equiv.symm_apply_apply] using (hb.shift (g b) hn).symm
  ext ⟨a, b⟩
  rw [mem_invSet, Finset.mem_map]
  change (a < b ∧ g b < g a) ↔ ∃ j ∈ Finset.univ.erase z, (z, j) = (a, b)
  simp only [Finset.mem_erase, Finset.mem_univ, and_true, Prod.mk.injEq]
  constructor
  · rintro ⟨hab, hba⟩
    have hb' : b ≠ z := fun h => by subst b; exact (Nat.not_lt_zero _ hab)
    refine ⟨b, hb', ?_, rfl⟩
    by_contra ha
    have hga := hg a (Ne.symm ha)
    have hgb := hg b hb'
    simp only [Fin.lt_def] at hab hba
    omega
  · rintro ⟨j, hb', ha, hjb⟩
    subst a
    subst j
    have hv : (b : ℕ) ≠ 0 := fun h => hb' (Fin.ext h)
    have hgb := hg b hb'
    rw [hz]
    change 0 < (b : ℕ) ∧ (g b : ℕ) < m - 1
    have := b.isLt
    omega

variable (C : CartanDatum I) (hQ : IsRouquierQ C Q)

omit [DecidableEq I] in
private theorem cartanDotDegree (i : I) : hQ.gradingDatum.degX i = 2 * UDot.di C i :=
  (hQ.gradingDatum_degX i).trans (UDot.two_mul_di C i).symm

local notation "G" => stendhalGradingDatum Λ hQ.gradingDatum (UDot.di C)
  (cartanDotDegree C hQ)
local notation "Δ" r:arg => Multiset.sum (Multiset.map (fun i => UDot.di C i * (Λ r i : ℤ)) ν)

/-- Webster, arXiv:1309.3796v2, Figure 5. In the auxiliary grading the very diagram used by
`violLoadingStandardEquivBraidCorner_mk` is homogeneous, for any black content and any
reduced choice of its crossing word. The single red/red crossing contributes `-2` here. -/
theorem figureFive_mem_violAuxiliaryGrade
    {ρ : Perm (Fin m) → List ℕ} (hρ : IsReducedChoice ρ) {s t : Seq μ} {r : Fin 2}
    {g : Perm (Fin m)} (h0 : 0 < m) (ht : t.lbl ⟨0, h0⟩ = .inr r)
    (hb : EdgeBraid h0 r g s t) :
    q (π (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t)) ∈ violAuxiliaryGrade G (Δ r - 2) := by
  have hdeg : (G).degW (ρ g) t = Δ r - 2 := by
    rw [GradingDatum.degW_eq_sum_invSet _ (hρ g).1, (hρ g).2, hb.invSet_eq_erase ht, Finset.sum_map]
    let f : I ⊕ Fin 2 → ℤ := Sum.elim (fun i => UDot.di C i * (Λ r i : ℤ)) (fun _ => -2)
    change (∑ b ∈ Finset.univ.erase ⟨0, h0⟩, (G).degΨ (t.lbl ⟨0, h0⟩) (t.lbl b)) = _
    rw [ht]
    have hf (x : I ⊕ Fin 2) : (G).degΨ (.inr r) x = f x := by cases x <;> rfl
    simp only [hf]
    have hsum : (∑ b, f (t.lbl b)) = Δ r + (-2 + -2) := by
      change (Finset.univ.val.map (f ∘ t.lbl)).sum = _
      rw [← Multiset.map_map, t.2, stendhalWeight, Multiset.map_add, Multiset.sum_add, Multiset.map_map,
        Multiset.map_map]
      simp [f, Function.comp_def]
    have he := Finset.sum_erase_add (s := Finset.univ) (fun b => f (t.lbl b))
      (Finset.mem_univ (⟨0, h0⟩ : Fin m))
    rw [hsum, ht] at he
    change _ + -2 = _ at he
    omega
  rw [← hdeg]
  have hψ := GradingDatum.ψw_mul_pol_mul_e_mem_grade G (ρ g) t (p := 1) (D := 0)
    (isWeightedHomogeneous_one k _)
  rw [map_one, mul_one, add_zero] at hψ
  exact Graded.mem_map_of_mem _ (q).toLinearMap
    (Graded.mem_map_of_mem _ (π).toLinearMap hψ)

private theorem violIdem_mem_auxiliaryGrade (j : Seq μ) :
    q (π (KLRAlgebra.e j)) ∈ violAuxiliaryGrade G 0 :=
  Graded.mem_map_of_mem _ (q).toLinearMap
    (Graded.mem_map_of_mem _ (π).toLinearMap ((G).e_mem_grade j))

private theorem violRedProj_mem_auxiliaryGrade (κ : List (Fin 2)) :
    q (redProj k Q Λ ν κ) ∈ violAuxiliaryGrade G 0 := by
  rw [redProj, redIdem, map_sum, map_sum]
  exact Submodule.sum_mem _ fun j _ => violIdem_mem_auxiliaryGrade C hQ j

/-- The auxiliary grading restricted to the cut of the braided bimodule at a loading. -/
def violCornerAuxiliaryGrade (s : Seq μ) (κ : List (Fin 2)) :
    ℤ → Submodule k (violCorner k Q Λ ν s κ) :=
  Graded.comap (violAuxiliaryGrade G) (violCorner k Q Λ ν s κ).subtype

instance violCornerAuxiliaryDecomposition (s : Seq μ) (κ : List (Fin 2)) :
    Decomposition (violCornerAuxiliaryGrade (Λ := Λ) C hQ s κ) := by
  apply IsInternal.chooseDecomposition
  apply Graded.isInternal_comap _ _ Subtype.val_injective
  intro x n
  let 𝒜 := violAuxiliaryGrade (ν := ν) G
  have h := mem_violCorner_iff.1 x.2
  refine ⟨⟨(decompose 𝒜 x.1 n : ViolQuotient k Q Λ ν), mem_violCorner_iff.2 ⟨?_, ?_⟩⟩, rfl⟩
  · rw [← coe_decompose_mul_of_left_mem_zero 𝒜 (violIdem_mem_auxiliaryGrade C hQ s), h.1]
  · rw [← coe_decompose_mul_of_right_mem_zero 𝒜 (violRedProj_mem_auxiliaryGrade C hQ κ), h.2]

variable {H : Type*} [AddCommGroup H] [Module ℂ H]

section RealizationPairing

variable [Fintype I] [Module.Finite ℂ H]

private def cartanSymmetrization : Matrix.Symmetrization (UDot.A C) where
  ε i := (UDot.di C i : ℚ)⁻¹
  ε_pos i := inv_pos.mpr (by exact_mod_cast UDot.di_pos C i)
  ε_mul_comm i j := by
    have hi : (UDot.di C i : ℚ) ≠ 0 := by exact_mod_cast (UDot.di_pos C i).ne'
    have hj : (UDot.di C j : ℚ) ≠ 0 := by exact_mod_cast (UDot.di_pos C j).ne'
    field_simp
    rw [mul_comm (UDot.A C i j : ℚ)]
    exact_mod_cast UDot.di_mul_A_comm C i j

variable (P : Matrix.Realization (UDot.A C) ℂ H)

/-- A realization of the pairing in Webster's Notation, using LieLean's choice of form on the
Cartan realization. The grading below takes the form as data, so it does not fix this extension
of the root/weight pairing for singular Cartan matrices. -/
def weightPairing : LinearMap.BilinForm ℂ (Module.Dual ℂ H) :=
  P.dualBilinForm (cartanSymmetrization C)

omit [DecidableEq I] in
theorem weightPairing_isSymm : (weightPairing C P).IsSymm := P.isSymm_dualBilinForm _

omit [DecidableEq I] in
/-- The root/weight pairing is `d_i` times the simple coroot evaluation, as in Definition 4.4. -/
theorem weightPairing_root (η : Module.Dual ℂ H) (i : I) :
    weightPairing C P (P.root i) η = (UDot.di C i : ℂ) * η (P.coroot i) := by
  rw [weightPairing, (P.isSymm_dualBilinForm _).eq, P.dualBilinForm_root_right]
  simp [cartanSymmetrization, div_eq_mul_inv, mul_comm]

end RealizationPairing

private theorem intCast_add_injective (c : ℂ) :
    Function.Injective (fun n : ℤ => (n : ℂ) + c) := fun _ _ h =>
  Int.cast_injective (add_right_cancel h)

private theorem isInternal_extend_bot {M : Type*} [AddCommGroup M] [Module k M]
    (f : ℤ → ℂ) (hf : Function.Injective f) (𝒩 : ℤ → Submodule k M)
    (h𝒩 : DirectSum.IsInternal 𝒩) : DirectSum.IsInternal (Function.extend f 𝒩 ⊥) := by
  refine isInternal_submodule_of_iSupIndep_of_iSup_eq_top ?_ ?_
  · intro d
    by_cases h : ∃ n, f n = d
    · obtain ⟨n, rfl⟩ := h
      rw [hf.extend_apply]
      apply (h𝒩.submodule_iSupIndep n).mono_right
      refine iSup₂_le fun e he => ?_
      by_cases h' : ∃ j, f j = e
      · obtain ⟨j, rfl⟩ := h'
        rw [hf.extend_apply]
        exact le_iSup₂_of_le j (fun h => he (congrArg f h)) le_rfl
      · rw [Function.extend_apply' _ _ _ h']
        exact bot_le
    · rw [Function.extend_apply' _ _ _ h]
      exact disjoint_bot_left
  · rw [iSup_extend_bot hf]
    exact h𝒩.submodule_iSup_eq_top

variable (B : LinearMap.BilinForm ℂ (Module.Dual ℂ H)) (η : Fin 2 → Module.Dual ℂ H)

/-- Definitions 4.4 and 6.2: the local crossing degree in Webster's additive group `ℂ`. -/
def websterCrossingDegree : I ⊕ Fin 2 → I ⊕ Fin 2 → ℂ
  | .inr a, .inr b => -B (η a) (η b)
  | a, b => ((G).degΨ a b : ℂ)

local notation "degC" => websterCrossingDegree (Λ := Λ) C hQ B η

omit [DecidableEq I] in
/-- In a reduced diagram retaining the red order, Definitions 4.4 and 6.2 agree with the
auxiliary grading: there is no red/red crossing. -/
theorem sameRedOrder_crossingDegree {t : Seq μ} {γ : List ℕ}
    (hγ : TypeA.IsReduced m γ) (ht : redWord (wordProd m γ • t) = redWord t) :
    (∑ p ∈ invSet m (wordProd m γ), degC (t.lbl p.1) (t.lbl p.2)) = ((G).degW γ t : ℂ) := by
  rw [GradingDatum.degW_eq_sum_invSet _ hγ, Int.cast_sum]
  refine Finset.sum_congr rfl fun p hp => ?_
  rcases hx : t.lbl p.1 with i | x <;> rcases hy : t.lbl p.2 with j | y <;> try rfl
  have hi := mem_invSet.mp hp
  have h := (redWord_smul_eq_iff t (wordProd m γ) 1).1 (by simpa using ht)
  exact (lt_asymm hi.2 (by simpa using (h p.1 p.2 x y hx hy).2 hi.1)).elim

omit [DecidableEq I] in
/-- For a reduced diagram switching the two red strands, the correction to the auxiliary degree
is exactly `2 - ⟨λ_r, λ_d⟩`. The reduced word crosses the two reds exactly once, as certified by
its inversion set; the same correction applies with any black dots since their degrees agree. -/
theorem twoRedSwap_crossingDegree {t : Seq μ} {r d : Fin 2} {γ : List ℕ}
    (hγ : TypeA.IsReduced m γ) (ht : redWord t = [r, d])
    (hs : redWord (wordProd m γ • t) = [d, r]) :
    (∑ p ∈ invSet m (wordProd m γ), degC (t.lbl p.1) (t.lbl p.2)) =
      ((G).degW γ t : ℂ) + (2 - B (η r) (η d)) := by
  obtain ⟨a, ha⟩ := exists_lbl_eq_inr t r
  obtain ⟨b, hb⟩ := exists_lbl_eq_inr t d
  have hab : a < b := by
    have h := redWord_pairwise_one t
    rw [ht, List.pairwise_cons] at h
    exact h.1 d (by simp) a b ha hb
  have hswap := (redWord_smul_eq_swap_iff (L := []) (M := []) ht ha hb (wordProd m γ)).1 hs
  let S := invSet m (wordProd m γ)
  have hmem : (a, b) ∈ S := mem_invSet.mpr ⟨hab,
    (hswap a b (by simp [ha]) (by simp [hb]) hab).2 ⟨rfl, rfl⟩⟩
  have hrest : (∑ p ∈ S.erase (a, b), degC (t.lbl p.1) (t.lbl p.2)) =
      ∑ p ∈ S.erase (a, b), ((G).degΨ (t.lbl p.1) (t.lbl p.2) : ℂ) := by
    refine Finset.sum_congr rfl fun p hp => ?_
    have hi := mem_invSet.mp ((Finset.mem_erase.mp hp).2 : p ∈ invSet m (wordProd m γ))
    rcases hx : t.lbl p.1 with i | x <;> rcases hy : t.lbl p.2 with j | y <;> try rfl
    obtain ⟨h₁, h₂⟩ := (hswap p.1 p.2 (by simp [hx]) (by simp [hy]) hi.1).1 hi.2
    exact ((Finset.mem_erase.mp hp).1 (Prod.ext h₁ h₂)).elim
  rw [GradingDatum.degW_eq_sum_invSet _ hγ]
  let f : Fin m × Fin m → ℂ := fun p => degC (t.lbl p.1) (t.lbl p.2)
  let fZ : Fin m × Fin m → ℤ := fun p => (G).degΨ (t.lbl p.1) (t.lbl p.2)
  change (∑ p ∈ S, f p) = ((∑ p ∈ S, fZ p : ℤ) : ℂ) + _
  calc
    (∑ p ∈ S, f p) = (∑ p ∈ S.erase (a, b), f p) + f (a, b) :=
      (Finset.sum_erase_add S f hmem).symm
    _ = ((∑ p ∈ S.erase (a, b), fZ p : ℤ) : ℂ) - B (η r) (η d) := by
      change (∑ p ∈ S.erase (a, b), degC (t.lbl p.1) (t.lbl p.2)) + _ = _
      rw [hrest, Int.cast_sum, sub_eq_add_neg]
      simp only [f, ha, hb, websterCrossingDegree]
      rfl
    _ = ((∑ p ∈ S, fZ p : ℤ) : ℂ) + (2 - B (η r) (η d)) := by
      have hsum := Finset.sum_erase_add S fZ hmem
      have hlast : fZ (a, b) = -2 := by
        change (G).degΨ (t.lbl a) (t.lbl b) = -2
        rw [ha, hb]
        rfl
      rw [← hsum, hlast, Int.cast_add, Int.cast_neg, Int.cast_two]
      ring

/-- Webster, arXiv:1309.3796v2, Definition 6.2, on the two-red cut with order `[d,r]` at `s`
and `[r,d]` at the module end. The complex numbers here are degree indices, not coefficients.
Replace the single auxiliary red/red contribution `-2` by `-⟨λ_r, λ_d⟩`. -/
def figureFiveCutGrade (s : Seq μ) (r d : Fin 2) :
    ℂ → Submodule k (violCorner k Q Λ ν s [r, d]) :=
  Function.extend (fun n : ℤ => (n : ℂ) + (2 - B (η r) (η d)))
    (violCornerAuxiliaryGrade C hQ s [r, d]) ⊥

theorem isInternal_figureFiveCutGrade (s : Seq μ) (r d : Fin 2) :
    DirectSum.IsInternal (figureFiveCutGrade (Λ := Λ) C hQ B η s r d) :=
  isInternal_extend_bot _ (intCast_add_injective _) _ (Decomposition.isInternal _)

variable [Fintype I] (P : Matrix.Realization (UDot.A C) ℂ H)
  (hB : ∀ i x, B (P.root i) x = (UDot.di C i : ℂ) * x (P.coroot i))
  (hΛ : ∀ j i, η j (P.coroot i) = (Λ j i : ℂ))

include hB hΛ in
omit [DecidableEq I] in
private theorem weightPairing_blackContent (r : Fin 2) :
    B (ν.map P.root).sum (η r) = ((Δ r : ℤ) : ℂ) := by
  induction ν using Multiset.induction_on with
  | empty => simp
  | cons i ν ih =>
    simp only [Multiset.map_cons, Multiset.sum_cons, map_add, LinearMap.add_apply,
      hB, hΛ, ih, Int.cast_add, Int.cast_mul, Int.cast_natCast]

include hB hΛ in
/-- Webster, arXiv:1309.3796v2, Proposition 6.9, Figure 5. The diagram in the loading comparison
has degree `-⟨λ_d - α, λ_r⟩` in the two-red cut, where `α` is the sum of the black roots.
Webster's shift `M(a)_n = M_(n+a)` is therefore the negative of this diagram degree. -/
theorem figureFive_mem_cutGrade
    (hSym : B.IsSymm) {ρ : Perm (Fin m) → List ℕ} (hρ : IsReducedChoice ρ)
    {s t : Seq μ} {r d : Fin 2}
    {g : Perm (Fin m)} (h1 : 1 < m)
    (ht₀ : t.lbl ⟨0, by omega⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d)
    (hb : EdgeBraid (show 0 < m by omega) r g s t) :
    ∃ y : violCorner k Q Λ ν s [r, d], y.1 = q (π (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t)) ∧
      y ∈ figureFiveCutGrade C hQ B η s r d (-B (η d - (ν.map P.root).sum) (η r)) := by
  have hs := hb.redWord_source_twoRed h1 ht₀ ht₁
  have hperm := redWord_perm t s
  rw [hs] at hperm
  have hperm' := hperm.trans (List.Perm.swap r d [])
  obtain ⟨L, hL⟩ := exists_redWord_eq_cons (by omega) ht₀
  rw [hL] at hperm'
  have ht : redWord t = [r, d] := by rw [hL, hperm'.cons_inv.eq_singleton]
  let a := π (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t)
  have hleft : π (KLRAlgebra.e s) * a = a := e_mul_psi_e hρ hb.smul_eq
  have hright : a * redProj k Q Λ ν [r, d] = a := by
    rw [show a = π (KLRAlgebra.ψw (ρ g)) * π (KLRAlgebra.e t) from map_mul _ _ _, mul_assoc,
      e_mul_redProj, ite_eq_left ht]
  refine ⟨⟨q a, mem_violCorner_iff.2 ⟨?_, ?_⟩⟩, rfl, ?_⟩
  · rw [← map_mul, hleft]
  · rw [← map_mul, hright]
  · have hdeg : -B (η d - (ν.map P.root).sum) (η r) =
        ((Δ r - 2 : ℤ) : ℂ) + (2 - B (η r) (η d)) := by
      rw [map_sub, LinearMap.sub_apply, weightPairing_blackContent C B η P hB hΛ]
      rw [Int.cast_sub, Int.cast_two, hSym.eq (η r) (η d)]
      ring
    rw [hdeg, figureFiveCutGrade, (intCast_add_injective _).extend_apply]
    exact figureFive_mem_violAuxiliaryGrade C hQ hρ _ ht₀ hb

end FigureFive

section LoadingComparison

variable {I : Type} {k : Type*} [DecidableEq I] [CommRing k]
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin 2 → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight 2 ν
local notation "m" => Multiset.card (stendhalWeight 2 ν)
local notation "Right" κ:arg => (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ)ᵐᵒᵖ
local notation "V" => ViolQuotient k Q Λ ν

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

local instance violOrderCornerRing (κ : List (Fin 2)) :
    Ring (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ) := _root_.instRingCorner _ _

private instance violCornerRightScalarTower (t : Seq μ) (κ : List (Fin 2)) :
    IsScalarTower k (Right κ) (violCorner k Q Λ ν t κ) where
  smul_assoc c a x := Subtype.ext <| by
    rw [violCorner_smul_val, Submodule.coe_smul_of_tower, violCorner_smul_val]
    change x.1 * (c • a.unop.val) = c • (x.1 * a.unop.val)
    rw [mul_smul_comm]

private instance violLoadingModule (t : Seq μ) (κ : List (Fin 2)) :
    Module k (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ) :=
  Submodule.Quotient.module' (violStandardUpper t κ)

variable (C : CartanDatum I) (hQ : IsRouquierQ C Q)

local notation "G" => stendhalGradingDatum Λ hQ.gradingDatum (UDot.di C) (cartanDotDegree C hQ)
local notation "Δ" r:arg => Multiset.sum (Multiset.map (fun i => UDot.di C i * (Λ r i : ℤ)) ν)
local notation "Agrade" => violAuxiliaryGrade (ν := ν) G

private def loadingMkQ (t : Seq μ) (κ : List (Fin 2)) :
    violCorner k Q Λ ν t κ →ₗ[k] ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ :=
  (violStandardUpper (k := k) (Q := Q) (Λ := Λ) t κ).mkQ.restrictScalars k

private def loadingAuxiliaryGrade (t : Seq μ) (κ : List (Fin 2)) :
    ℤ → Submodule k (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ) :=
  Graded.map (violCornerAuxiliaryGrade C hQ t κ) (loadingMkQ (Λ := Λ) t κ)

/-- The degree-`n` piece is the image of the degree-`n` piece of the same-order projective.
Complex indices outside the integers have zero piece. -/
def violLoadingGrade (t : Seq μ) (κ : List (Fin 2)) :
    ℂ → Submodule k (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ) :=
  Function.extend (fun n : ℤ => (n : ℂ)) (loadingAuxiliaryGrade C hQ t κ) ⊥

private theorem isInternal_loadingAuxiliaryGrade {s t : Seq μ} {κ : List (Fin 2)}
    {a : V} {D : ℤ} (ha : a ∈ Agrade D)
    (e : ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ ≃ₗ[Right κ] violCorner k Q Λ ν s κ)
    (he : ∀ y, (e (loadingMkQ (Λ := Λ) t κ y)).1 = a * y.1) :
    DirectSum.IsInternal (loadingAuxiliaryGrade (Λ := Λ) C hQ t κ) := by
  let f := loadingMkQ (k := k) (Q := Q) (Λ := Λ) t κ
  let 𝒯 := violCornerAuxiliaryGrade (Λ := Λ) C hQ t κ
  have hsub : PreservesGrading 𝒯 Agrade (violCorner k Q Λ ν t κ).subtype := by
    intro n x hx
    exact hx
  have hmul : PreservesGrading Agrade (Graded.shift Agrade (-D)) (LinearMap.mulLeft k a) := by
    intro n x hx
    change a * x ∈ Agrade (n - -D)
    rw [show n - -D = D + n by abel]
    exact SetLike.GradedMul.mul_mem ha hx
  have hker : ∀ x, f x = 0 → ∀ n, f (decompose 𝒯 x n) = 0 := by
    intro x hx n
    have hzero : a * x.1 = 0 := by
      rw [← he, show loadingMkQ (Λ := Λ) t κ x = 0 from hx, map_zero]
      rfl
    apply e.injective
    apply Subtype.ext
    rw [show e (f (decompose 𝒯 x n)) = e (loadingMkQ (Λ := Λ) t κ (decompose 𝒯 x n)) from rfl,
      he, map_zero]
    change a * (violCorner k Q Λ ν t κ).subtype (decompose 𝒯 x n) = 0
    rw [← Graded.decompose_map hsub x n]
    have hm := (Graded.decompose_map hmul x.1 n).symm
    change a * (decompose Agrade x.1 n : V) = _ at hm
    rw [show (LinearMap.mulLeft k a) x.1 = 0 from hzero, decompose_zero] at hm
    simpa using hm
  let _ : Decomposition (loadingAuxiliaryGrade (Λ := Λ) C hQ t κ) :=
    Graded.mapDecomposition (π := f) (𝒳 := 𝒯)
      (Submodule.mkQ_surjective (violStandardUpper (k := k) (Q := Q) (Λ := Λ) t κ)) hker
  exact Decomposition.isInternal _

/-- Webster, arXiv:1309.3796v2, §6.1 Proposition 6.9, Figure 5, at the loading endpoints.
The shift on the standard is `+⟨λ_d - α, λ_r⟩` in Webster's notation, i.e. its negative in
`Graded.shift`. This is the existing right-module comparison, with its internal grading. -/
def figureFiveGradedLoadingEquiv
    {ρ : Perm (Fin m) → List ℕ} (hρ : IsReducedChoice ρ) (hS : KLRSymm Q)
    {s t : Seq μ} {r d : Fin 2} {g : Perm (Fin m)} (h1 : 1 < m)
    (ht₀ : t.lbl ⟨0, Nat.zero_lt_one.trans h1⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d)
    (hb : EdgeBraid (Nat.zero_lt_one.trans h1) r g s t)
    {H : Type*} [AddCommGroup H] [Module ℂ H] [Fintype I]
    (P : Matrix.Realization (UDot.A C) ℂ H)
    (B : LinearMap.BilinForm ℂ (Module.Dual ℂ H)) (η : Fin 2 → Module.Dual ℂ H)
    (hB : ∀ i x, B (P.root i) x = (UDot.di C i : ℂ) * x (P.coroot i))
    (hΛ : ∀ j i, η j (P.coroot i) = (Λ j i : ℂ)) (hSym : B.IsSymm) :
    Graded.shift (violLoadingGrade (Λ := Λ) C hQ t [r, d]) (-B (η d - (ν.map P.root).sum) (η r))
      ≃ᵍ[Right [r, d]] figureFiveCutGrade (Λ := Λ) C hQ B η s r d := by
  let e := violLoadingStandardEquivBraidCorner (k := k) (Q := Q) (Λ₂ := Λ)
    (ν := ν) (s := s) (t := t) (r := r) (d := d) hρ hS h1 ht₀ ht₁ hb
  let a : V := violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t))
  have ha : a ∈ Agrade (Δ r - 2) := figureFive_mem_violAuxiliaryGrade C hQ hρ _ ht₀ hb
  have he (y : violCorner k Q Λ ν t [r, d]) : (e (loadingMkQ (Λ := Λ) t [r, d] y)).1 = a * y.1 :=
    violLoadingStandardEquivBraidCorner_mk hρ hS h1 ht₀ ht₁ hb y
  letI : Decomposition (violLoadingGrade (Λ := Λ) C hQ t [r, d]) :=
    (isInternal_extend_bot _ Int.cast_injective _
      (isInternal_loadingAuxiliaryGrade C hQ ha e he)).chooseDecomposition
  letI := (isInternal_figureFiveCutGrade (Λ := Λ) C hQ B η s r d).chooseDecomposition
  apply GradedEquiv.ofPreserves e
  intro z x hx
  change x ∈ Function.extend (fun n : ℤ => (n : ℂ))
    (loadingAuxiliaryGrade (Λ := Λ) C hQ t [r, d]) ⊥ (z - -B (η d - (ν.map P.root).sum) (η r)) at hx
  by_cases hz : ∃ n : ℤ, (n : ℂ) = z - -B (η d - (ν.map P.root).sum) (η r)
  · obtain ⟨n, hn⟩ := hz
    rw [← hn, (Int.cast_injective (α := ℂ)).extend_apply] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    have hz' : z = (((Δ r - 2) + n : ℤ) : ℂ) + (2 - B (η r) (η d)) := by
      rw [map_sub, LinearMap.sub_apply, weightPairing_blackContent C B η P hB hΛ] at hn
      rw [Int.cast_add, Int.cast_sub, Int.cast_two, hSym.eq (η r) (η d)]
      linear_combination -hn
    rw [hz', figureFiveCutGrade, (intCast_add_injective _).extend_apply]
    change (e (loadingMkQ (Λ := Λ) t [r, d] y)).1 ∈ Agrade (Δ r - 2 + n)
    rw [he]
    exact SetLike.GradedMul.mul_mem ha (show y.1 ∈ Agrade n from hy)
  · rw [Function.extend_apply' _ _ _ hz] at hx
    change x ∈ (⊥ : Submodule k (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t [r, d])) at hx
    rw [Submodule.mem_bot] at hx
    change e x ∈ _
    rw [hx, map_zero]
    exact zero_mem _

@[simp] theorem figureFiveGradedLoadingEquiv_toLinearEquiv
    {ρ : Perm (Fin m) → List ℕ} (hρ : IsReducedChoice ρ) (hS : KLRSymm Q)
    {s t : Seq μ} {r d : Fin 2} {g : Perm (Fin m)} (h1 : 1 < m)
    (ht₀ : t.lbl ⟨0, Nat.zero_lt_one.trans h1⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d)
    (hb : EdgeBraid (Nat.zero_lt_one.trans h1) r g s t)
    {H : Type*} [AddCommGroup H] [Module ℂ H] [Fintype I]
    (P : Matrix.Realization (UDot.A C) ℂ H)
    (B : LinearMap.BilinForm ℂ (Module.Dual ℂ H)) (η : Fin 2 → Module.Dual ℂ H)
    (hB : ∀ i x, B (P.root i) x = (UDot.di C i : ℂ) * x (P.coroot i))
    (hΛ : ∀ j i, η j (P.coroot i) = (Λ j i : ℂ)) (hSym : B.IsSymm) :
    (figureFiveGradedLoadingEquiv C hQ hρ hS h1 ht₀ ht₁ hb P B η hB hΛ hSym).toLinearEquiv =
      violLoadingStandardEquivBraidCorner (Λ₂ := Λ) hρ hS h1 ht₀ ht₁ hb := rfl

end LoadingComparison

end Categorification.Stendhal.BraidedStendhalAlgebra
