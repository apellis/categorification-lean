import Categorification.WeightedKLR.RedStrands.ProjectiveStandardFiltrationOrder

/-!
# Standard stratification of `T^λ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2,
Corollary 5.21, in the following form: for every red-ordered loading `s`, the kernel `U_s` of the
quotient map `T^λ e(s) → S_s` has a finite filtration whose subquotients are standard modules
`S_t` with `t` strictly above `s` in Webster's order (`StendhalLT s t`, dominance of black
counts). This is the condition on projectives in the definition of a standardly stratified
algebra; Webster states the corollary as the assertion that `T^λ` is standardly stratified with
these standard modules and this preorder.

The proof follows Webster's: the ordered standard filtration of `T^λ e(s)`
(`hasOrderedStandardFiltrations`) has top quotient `S_{s'}` with `s'` equivalent to `s`, and the
kernel of `T^λ e(s) → S_{s'}` is `U_s`. It is contained in `U_s` because it is generated by
vectors `e(t) y` with `t > s`, and it contains `U_s` because `e(t)` kills `S_{s'}` for `t > s'`.

## Main results

* `seqIdem_smul_leftStandard_eq_zero`: `e(t) S_s = 0` for `t` strictly above `s`.
* `HasFiltration.mem_span_seqIdem_smul`: a module with a standard filtration is generated by
  the vectors `e(t) z`, `t` a label of the filtration.
* `exists_hasFiltration_leftUpper`: the kernel `U_s` has a standard filtration with labels
  strictly above `s`. Route hypothesis: `AllFiniteDeltaInjective` (Proposition 5.5, `F`-part),
  as for Proposition 5.20.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal

open KLR ModuleFiltration
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} [DecidableEq I] {k : Type} [Field k]
  (Q : I → I → MvPolynomial (Fin 2) k)

section Generation

variable {n : ℕ} (Λ : Fin n → I →₀ ℕ) {ν : Multiset I}

local notation "A" => TensorProductAlgebra k Q Λ ν

/-- The generator of `S_s` is fixed by `e(s)`. -/
theorem seqIdem_smul_leftStandardUnit {s : Seq (stendhalWeight n ν)} (hs : IsRedOrdered s) :
    seqIdem Q Λ s hs • leftStandardUnit Q Λ s hs = leftStandardUnit Q Λ s hs := by
  rw [leftStandardUnit, ← Submodule.Quotient.mk_smul]
  congr 1
  exact Subtype.ext (seqIdem_mul_self Q Λ s hs)

/-- **Generation by idempotents**: a module with a standard filtration with labels `m` is
spanned by the vectors `e(t) z` with `t ∈ m`. -/
theorem HasFiltration.mem_span_seqIdem_smul {m : List {t : Seq (stendhalWeight n ν) //
      IsRedOrdered t}} {X : ModuleCat.{0} A} (h : HasFiltration (stdModule Q Λ ν) m X)
    (x : X) :
    x ∈ Submodule.span A {y | ∃ c ∈ m, ∃ z : X, y = seqIdem Q Λ c.1 c.2 • z} := by
  induction h with
  | zero hX => rw [Subsingleton.elim x 0]; exact Submodule.zero_mem _
  | @cons X Y Z f g m c hf hfg hg _ hZ ih =>
    obtain ⟨e⟩ := hZ
    obtain ⟨a, ha⟩ := leftStandard_exists_smul_unit c.1 c.2 (e (g x))
    obtain ⟨z, hz⟩ := hg (e.symm (leftStandardUnit Q Λ c.1 c.2))
    have hker : g (x - a • seqIdem Q Λ c.1 c.2 • z) = 0 := by
      apply e.injective
      rw [map_sub, map_smul, map_smul, hz, map_sub, map_smul, map_smul,
        LinearEquiv.apply_symm_apply, seqIdem_smul_leftStandardUnit, ha, sub_self, map_zero]
    obtain ⟨x', hx'⟩ := (hfg _).1 hker
    have hmap : (Submodule.span A {y | ∃ c' ∈ m, ∃ z : X,
        y = seqIdem Q Λ c'.1 c'.2 • z}).map f ≤ Submodule.span A {y | ∃ c' ∈ c :: m, ∃ z : Y,
        y = seqIdem Q Λ c'.1 c'.2 • z} := by
      rw [Submodule.map_span]
      refine Submodule.span_le.2 ?_
      rintro _ ⟨_, ⟨c', hc', z', rfl⟩, rfl⟩
      exact Submodule.subset_span ⟨c', List.mem_cons_of_mem _ hc', f z', map_smul _ _ _⟩
    have hmem := hmap ⟨x', ih x', rfl⟩
    have hx : x = f x' + a • seqIdem Q Λ c.1 c.2 • z := by rw [hx']; abel
    rw [hx]
    exact Submodule.add_mem _ hmem
      (Submodule.smul_mem _ a (Submodule.subset_span ⟨c, List.mem_cons_self, z, rfl⟩))

end Generation

variable {C : QuantumGroup.CartanDatum I} (hQ : KLRSymm Q)

/-- **Standard stratification of `T^λ`** (Webster, arXiv:1309.3796v2, Corollary 5.21, condition
on projectives): for every red-ordered loading `s`, the kernel `U_s` of `T^λ e(s) → S_s` has a
finite filtration by standard modules `S_t` with `t` strictly above `s`. Route hypothesis:
`AllFiniteDeltaInjective` (Proposition 5.5, `F`-part) at every number of red strands. -/
theorem exists_hasFiltration_leftUpper (hR : IsRouquierQ C Q)
    (hall : ∀ (n : ℕ) (Λ' : Fin (n + 1) → I →₀ ℕ), AllFiniteDeltaInjective Q Λ' hQ)
    {n : ℕ} (Λ : Fin n → I →₀ ℕ) (ν : Multiset I) (s : Seq (stendhalWeight n ν))
    (hs : IsRedOrdered s) :
    ∃ m : List {t : Seq (stendhalWeight n ν) // IsRedOrdered t},
      (∀ c ∈ m, StendhalLT s c.1) ∧
      HasFiltration (stdModule Q Λ ν) m (ModuleCat.of (TensorProductAlgebra k Q Λ ν)
        ((leftUpper Q Λ s hs).comap (lIdeal (seqIdem Q Λ s hs)).subtype)) := by
  obtain ⟨s', m, -, hs's, hm, h⟩ := hasOrderedStandardFiltrations Q hQ hR hall Λ ν s hs
  cases h with
  | @cons X Y Z f g m c hf hfg hg hX hZ =>
  obtain ⟨e⟩ := hZ
  set U := (leftUpper Q Λ s hs).comap (lIdeal (seqIdem Q Λ s hs)).subtype
  have hrange : LinearMap.range f = U := by
    apply le_antisymm
    · rintro _ ⟨x, rfl⟩
      have hx := HasFiltration.mem_span_seqIdem_smul Q Λ hX x
      induction hx using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨c', hc', z, rfl⟩ := hy
        rw [map_smul]
        change seqIdem Q Λ c'.1 c'.2 * (f z : _) ∈ leftUpper Q Λ s hs
        rw [← (f z).2]
        refine Submodule.subset_span ⟨c'.1, c'.2, (f z : _), hm c' hc', ?_⟩
        rw [mul_assoc]
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add y₁ y₂ _ _ h₁ h₂ => rw [map_add]; exact Submodule.add_mem _ h₁ h₂
      | smul b y _ hy => rw [map_smul]; exact Submodule.smul_mem _ b hy
    · intro u hu
      refine (hfg u).1 ?_
      have hu' : (u : TensorProductAlgebra k Q Λ ν) • g ⟨seqIdem Q Λ s hs,
          seqIdem_mul_self Q Λ s hs⟩ = 0 := by
        refine leftUpper_smul_eq_zero s hs _ (fun t ht a hst => ?_) hu
        apply e.injective
        rw [map_smul, map_zero, ← smul_smul]
        exact seqIdem_smul_leftStandard_eq_zero Q Λ s'.2 ht
          (stendhalLT_of_le_of_lt hs's hst) _
      rw [← map_smul] at hu'
      convert hu' using 2
      exact Subtype.ext u.2.symm
  exact ⟨m, hm, hX.of_equiv ((LinearEquiv.ofInjective f hf).trans (LinearEquiv.ofEq _ _ hrange))⟩

end Categorification.Stendhal
