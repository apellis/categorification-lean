import Categorification.WeightedKLR.RedStrands.BlockCrossingComparison
import Categorification.WeightedKLR.RedStrands.BlockCutGenerator
import Categorification.Algebra.BalancedTensorCyclic

/-!
# Stacking a generator of the crossing bimodule

Part of the proof of Webster, arXiv:1309.3796v2, §6.1, Proposition 6.9 (v3: Proposition
6.10), the reduction to two red strands. Lemma 6.8 identifies the column `S₁` of the crossed
order with the balanced tensor `C ⊗_{D₀} S₀` of the crossing bimodule with the uncrossed column
(`crossingStackEquiv`). If the summand `e C` is generated by `c` (`BlockCut.Generator`), then
`e S₁` is the image of `z ↦ c ⊗ z` (`exists_stack_generator`). On the summand of `S₀` fixed by
the bottom idempotent `τ`, the kernel of `z ↦ c ⊗ z` is the submodule generated by the relations
`H` (`mem_spanSmul_of_tmul_eq_zero`, `tmul_eq_zero_of_mem_spanSmul`). Both are instances of the
cyclic balanced-tensor lemmas of `Categorification.Algebra.BalancedTensorCyclic`.
-/

noncomputable section
namespace Categorification.Stendhal.RedBlock
open KLR BraidedStendhalAlgebra MulOpposite
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

universe v
variable {k : Type v} [CommRing k]
variable {I : Type} [DecidableEq I] {ℓ : ℕ}
    (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ) (hQ : KLRSymm Q)
    (L M : List (Fin ℓ × Multiset I)) (f : Fin 2 ↪ Fin ℓ) (β : Multiset I) {ν : Multiset I}
    (h : weightSum (adjacentRow L M f β) = stendhalWeight ℓ ν)
local notation "Bs" => adjacentRow L M f β
local notation "botOrd" => (fun (_ : RedBlock I ℓ) => 1)
local notation "topOrd" => (fun (_ : RedBlock I ℓ) => Fin.revPerm)
local notation "D₀" => orderedProduct Q Λ botOrd Bs
local notation "D₁" => orderedProduct Q Λ topOrd Bs
local notation "ι₀" => orderedInclusion Q Λ hQ botOrd Bs
local notation "ι₁" => orderedInclusion Q Λ hQ topOrd Bs
local notation "C" => crossingProduct Q Λ hQ M f β L
local notation "S₀" => orderedColumn Q Λ hQ botOrd L M f β h
local notation "S₁" => orderedColumn Q Λ hQ topOrd L M f β h
local notation "act" => blockProductAction Q Λ L M f β h
local notation "Z" => BalancedTensor k D₁ D₀ (BlockCut.space C) S₀
local notation "stk" => crossingStack Q Λ hQ L M f β h

private abbrev columnGroup (σ : (B : RedBlock I ℓ) → Equiv.Perm (Fin B.size)) :
    AddCommGroup (orderedColumn Q Λ hQ σ L M f β h) := Submodule.addCommGroup _
attribute [local instance] columnGroup

variable {Q Λ hQ L M f β}

private theorem cut_sandwich (y : quotients Q Λ Bs) :
    (C).cut (ι₁ 1 * y * ι₀ 1) = (C).cut y := by
  rw [← (C).incl_cut, (C).cut_incl]

private theorem rmul_eq_smul (c : (C).space) (a : D₀) :
    (C).rmul (LinearMap.ofClass ι₀) c a = op a • c := rfl

private theorem lproj_op_smul (e : quotients Q Λ Bs) (b : D₀) (x : (C).space) :
    (C).lproj e (op b • x) = op b • (C).lproj e x := by
  change (C).cut (e * (C).incl (op b • x)) = (C).cut ((C).incl ((C).cut (e * (C).incl x)) * ι₀ b)
  rw [crossing_incl_right, (C).incl_cut, ← cut_sandwich, ← cut_sandwich (y := _ * ι₀ b)]
  congr 1
  have h₀ := (C).right_fixed (l := ι₁) (r := ι₀) x
  have hp : ι₁ 1 * ι₁ 1 = ι₁ 1 := by rw [← map_mul, one_mul]
  simp only [MulOpposite.unop_op, mul_assoc]
  rw [← mul_assoc (ι₁ 1) (ι₁ 1), hp, ← mul_assoc ((C).incl x) (ι₀ 1), h₀]

/-- **The kernel of stacking a generator** (Webster, arXiv:1309.3796v2, §6.1, proof of
Proposition 6.9). On the summand of the uncrossed column fixed by the bottom idempotent, the
kernel of `z ↦ c ⊗ z` lies in the submodule generated by the relations. -/
theorem mem_spanSmul_of_tmul_eq_zero {c : BlockCut.space (C)} {e : quotients Q Λ Bs} {τ : D₀}
    {H : Submodule k D₀} (g : (C).Generator (LinearMap.ofClass ι₀) c e τ H)
    (hτ : IsIdempotentElem τ) {z : S₀} (hz : τ • z = z) (h0 : (BalancedTensor.tmul c z : Z) = 0) :
    z ∈ BalancedTensor.spanSmul (N := S₀) H := by
  have hfix : (C).lproj e c = c := by
    have hf := g.fix τ
    rwa [g.right] at hf
  exact BalancedTensor.mem_spanSmul_of_tmul_eq_zero _ g.ann _ g.gen (rmul_eq_smul c)
    (lproj_op_smul e) hτ g.right hfix hz h0

/-- The relations are killed by stacking the generator. -/
theorem tmul_eq_zero_of_mem_spanSmul {c : BlockCut.space (C)} {e : quotients Q Λ Bs} {τ : D₀}
    {H : Submodule k D₀} (g : (C).Generator (LinearMap.ofClass ι₀) c e τ H) {z : S₀}
    (hz : z ∈ BalancedTensor.spanSmul (N := S₀) H) : (BalancedTensor.tmul c z : Z) = 0 :=
  BalancedTensor.tmul_eq_zero_of_mem_spanSmul _ (rmul_eq_smul c) g.kill hz

/-- Projecting the top of a stacked tensor projects its crossing coefficient. -/
theorem act_crossingStack_tmul (e : quotients Q Λ Bs) (he : ι₁ 1 * e = e) (x : (C).space)
    (z : S₀) : act e (stk (BalancedTensor.tmul x z)).1 =
      (stk (BalancedTensor.tmul ((C).lproj e x) z)).1 := by
  rw [crossingStack_tmul, crossingStack_tmul, ← Module.End.mul_apply, ← map_mul]
  congr 2
  rw [BlockCut.lproj_apply, (C).incl_cut, ← mul_assoc, he, mul_assoc,
    (C).right_fixed (l := ι₁) (r := ι₀) x]

/-- **The top summand of the crossed column is generated** (Webster, arXiv:1309.3796v2,
§6.1, proof of Proposition 6.9): every element of `e S₁` is the stack of the generator on an
element of the uncrossed column. -/
theorem exists_stack_generator {c : BlockCut.space (C)} {e : quotients Q Λ Bs} {τ : D₀}
    {H : Submodule k D₀} (g : (C).Generator (LinearMap.ofClass ι₀) c e τ H)
    (he : ι₁ 1 * e = e) (y : S₁) :
    ∃ z : S₀, act e y.1 = (stk (BalancedTensor.tmul c z)).1 := by
  obtain ⟨w, rfl⟩ := crossingStack_surjective Q Λ hQ L M f β h y
  let F : Z →+ blockColumn Q Λ L M f β h :=
    (act e).toAddMonoidHom.comp ((LinearMap.toAddMonoidHom (S₁).subtype).comp
      (stk).toAddMonoidHom)
  let G : Z →+ blockColumn Q Λ L M f β h :=
    (LinearMap.toAddMonoidHom (S₁).subtype).comp (stk).toAddMonoidHom
  exact BalancedTensor.exists_map_eq_tmul _ _ g.gen (rmul_eq_smul c) F G
    (act_crossingStack_tmul h e he) w

end Categorification.Stendhal.RedBlock
