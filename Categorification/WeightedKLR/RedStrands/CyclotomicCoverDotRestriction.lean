import Categorification.WeightedKLR.RedStrands.CyclotomicRestrictionIdeal
import Categorification.KLR.Center

/-!
# Red-dot relations on the cyclotomic restriction cut

For the relation in Webster, arXiv:1309.3796v2, Definition 4.5, a red dot
is a component of the central dot sum selected by that red colour.
-/

noncomputable section

namespace Categorification.Stendhal

section ColourDots

open KLR KLRAlgebra Equiv MvPolynomial PolyRep

variable {C k : Type*} [DecidableEq C] [CommRing k]
  {S P : C → C → MvPolynomial (Fin 2) k} {β : Multiset C}
local notation "R" => KLRAlgebra k S β

private def colourDotPol (c : C) : Pol k β := fun s =>
  ∑ a : Fin (Multiset.card β), if s.lbl a = c then X a else 0

private theorem colourDotPol_sym (c : C) : colourDotPol (k := k) (β := β) c ∈ symNu k β := by
  intro w s
  unfold colourDotPol
  rw [map_sum]
  apply Fintype.sum_equiv w.symm
  intro a
  change (if s.lbl (w.symm a) = c then X a else 0) =
    rename w (if s.lbl (w.symm a) = c then X (w.symm a) else 0)
  split_ifs <;> simp

private abbrev colourDot (c : C) : R := polNu (colourDotPol c)

private theorem colourDot_mul_e (c : C) (s : Seq β) (a : Fin (Multiset.card β))
    (ha : s.lbl a = c) (hu : ∀ b, s.lbl b = c → b = a) :
    colourDot c * (e s : R) = x a * e s := by
  rw [polNu_mul_e]
  unfold colourDotPol
  rw [Finset.sum_eq_single a (fun b _ hb => ite_eq_right (fun hm => hb (hu b hm)))
    (fun h => (h (Finset.mem_univ a)).elim), ite_eq_left ha, pol_X]

private theorem colourDot_eq_sum (c : C) :
    (colourDot c : R) = ∑ s : Seq β, ∑ a : Fin (Multiset.card β),
      if s.lbl a = c then x a * e s else 0 := by
  unfold colourDot
  rw [polNu_apply]
  apply Finset.sum_congr rfl
  intro s _
  rw [colourDotPol, map_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro a _
  split_ifs <;> simp [pol_X]

private theorem commute_colourDot [IsDomain k]
    (hSP : ∀ a b, a ≠ b → S a b = P b a * rename ![1, 0] (P a b))
    (hP : ∀ a b, a ≠ b → P a b ≠ 0) (c : C) (z : R) :
    Commute z (colourDot c) :=
  (Subalgebra.mem_center_iff.mp (polNu_mem_center hSP hP (colourDotPol_sym c))) z

private theorem cL_colourDot (i c : C) (hex : ∀ s : Seq β, ∃ a, s.lbl a = c)
    (hlo : ∀ (s : Seq β) a b, s.lbl a = c → s.lbl b = c → a = b)
    (hhi : ∀ (s : Seq (Singleton.singleton i + β)) a b, s.lbl a = c → s.lbl b = c → a = b) :
    cL S i β (colourDot c) = colourDot c * cL S i β 1 := by
  let f : KLRAlgebra k S β →+ KLRAlgebra k S (Singleton.singleton i + β) :=
    ⟨⟨cL S i β, cL_zero i β⟩, cL_add i β⟩
  have hsum : (colourDot c : KLRAlgebra k S β) = ∑ s : Seq β, colourDot c * e s := by
    rw [← Finset.mul_sum, sum_e, mul_one]
  conv_lhs => rw [hsum]
  change f (∑ s : Seq β, colourDot c * e s) = _
  rw [map_sum, cL_one, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro s _
  obtain ⟨a, ha⟩ := hex s
  let t : Seq (Singleton.singleton i + β) := Seq.cast (add_comm β ({i} : Multiset C)) (s.append default)
  let p : Fin (Multiset.card ({i} + β : Multiset C)) :=
    Fin.cast (congrArg Multiset.card (add_comm β ({i} : Multiset C))) (Seq.posL {i} a)
  have hp : t.lbl p = c := by
    change (s.append (default : Seq ({i} : Multiset C))).1 (Fin.cast _ p) = c
    simpa only [p, Fin.cast_cast, Fin.cast_eq_self, Seq.append_posL] using ha
  change cL S i β (colourDot c * e s) = colourDot c * e t
  rw [colourDot_mul_e c s a ha (fun b hb => hlo s b a hb ha),
    colourDot_mul_e c t p hp (fun b hb => hhi t b p hb hp), cL_mul, cL_x, mul_assoc]
  rw [← cL_mul, one_mul, cL_e]

section Cut

open KLRAlgebra.AbsentColour

variable (S) (i : C) (p : C → Polynomial k) (β)
local notation "A" => CycKLR k S p β
local notation "B" => CycKLR k S p (Singleton.singleton i + β)
local notation "α" => cyclotomicLast S i p β
local notation "ε" => lastIdem S i p β
local notation "W" => Res S i p β B
local notation "π₀" => CycKLR.mk k S p β
local notation "π₁" => CycKLR.mk k S p (Singleton.singleton i + β)

/-- Multiply on the left by the terminal-colour idempotent of the upper algebra. -/
def cyclotomicRegularCut : B →+ W where
  toFun b := ⟨ε * b, by change ε * (ε * b) = ε * b; rw [← mul_assoc, lastIdem_mul]⟩
  map_zero' := Subtype.ext (mul_zero _)
  map_add' b c := Subtype.ext (mul_add _ b c)

private def cutRightMul (b : B) : W →ₗ[A] W where
  toFun x := ⟨x.1 * b, by change ε * (x.1 * b) = x.1 * b; rw [← mul_assoc]; exact congrArg (· * b) x.2⟩
  map_add' x y := Subtype.ext (add_mul x.1 y.1 b)
  map_smul' r x := Subtype.ext (mul_assoc (α r) x.1 b)

/-- A left-cut ideal generated by upper red dots and other relations is
contained in the lower ideal's action span when the other generators have
that property on every left multiple. The dot hypotheses express that each
red colour occurs once before and after adjoining the black strand. -/
theorem cyclotomicRegularCut_mem_idealActionSpan [IsDomain k]
    (hSP : ∀ a b, a ≠ b → S a b = P b a * rename ![1, 0] (P a b))
    (hP : ∀ a b, a ≠ b → P a b ≠ 0) (red : Set C) (extra : Set B)
    (I : TwoSidedIdeal A)
    (hex : ∀ c ∈ red, ∀ s : Seq β, ∃ a, s.lbl a = c)
    (hlo : ∀ c ∈ red, ∀ (s : Seq β) a b, s.lbl a = c → s.lbl b = c → a = b)
    (hhi : ∀ c ∈ red, ∀ (s : Seq (Singleton.singleton i + β)) a b, s.lbl a = c → s.lbl b = c → a = b)
    (hI : ∀ (s : Seq β) a, s.lbl a ∈ red → π₀ (x a * e s) ∈ I)
    (he : ∀ d ∈ extra, ∀ b, cyclotomicRegularCut S β i p (b * d) ∈ idealActionSpan I)
    {b : B} (hb : b ∈ TwoSidedIdeal.span
      ({d | ∃ (s : KLR.Seq (Singleton.singleton i + β)) (a : Fin (Multiset.card (Singleton.singleton i + β))), s.lbl a ∈ red ∧ d = π₁ (x a * e s)} ∪ extra)) :
    cyclotomicRegularCut S β i p b ∈ idealActionSpan I := by
  apply cut_span_mem_idealActionSpan I _ (cyclotomicRegularCut S β i p) (cutRightMul S β i p)
    (fun x b => Subtype.ext (mul_assoc ε x b).symm) _ hb
  rintro d (⟨s, a, ha, rfl⟩ | hd) b
  · let c := s.lbl a
    let D₀ : A := π₀ (colourDot c)
    let D₁ : B := π₁ (colourDot c)
    have hD₀ : D₀ ∈ I := by
      rw [show D₀ = π₀ (colourDot c) from rfl, colourDot_eq_sum, map_sum]
      apply sum_mem
      intro t _
      rw [map_sum]
      apply sum_mem
      intro j _
      split_ifs with h
      · exact hI t j (h ▸ ha)
      · rw [map_zero]
        exact I.zero_mem
    have hD₁ : D₁ * π₁ (e s) = π₁ (x a * e s) := by
      rw [← map_mul, colourDot_mul_e c s a rfl (fun j hj => hhi c ha s j a hj rfl)]
    have hc : ∀ b : B, Commute b D₁ := by
      intro y
      obtain ⟨z, rfl⟩ := CycKLR.mk_surjective y
      exact (commute_colourDot hSP hP c z).map π₁
    have hcut : α D₀ = D₁ * ε := by
      rw [show D₀ = π₀ (colourDot c) from rfl, cyclotomicLast_mk,
        cL_colourDot i c (hex c ha) (hlo c ha) (hhi c ha), map_mul]
      change D₁ * π₁ (cL S i β 1) = D₁ * α 1
      rw [cyclotomicLast_one]
    apply Submodule.subset_span
    refine ⟨D₀, hD₀, cyclotomicRegularCut S β i p (b * π₁ (e s)), Subtype.ext ?_⟩
    change ε * (b * π₁ (x a * e s)) = α D₀ * (ε * (b * π₁ (e s)))
    rw [← hD₁, ← mul_assoc b, (hc b).eq, mul_assoc D₁, ← mul_assoc ε,
      (hc ε).eq, hcut, mul_assoc D₁, mul_assoc D₁]
    congr 1
    rw [← mul_assoc ε ε, lastIdem_mul, ← mul_assoc]
  · exact he d hd b

end Cut

end ColourDots

end Categorification.Stendhal
