import Categorification.WeightedKLR.RedStrands.BraidedStandardTor
import Categorification.Algebra.DerivedTensorOrdinaryLinear
import Categorification.Algebra.DerivedTensorTwoFiltrations

/-!
# Tor between loading standards with different black counts

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.3, proof
of Proposition 7.22: the `E²` terms `Tor^k(𝕊(P_∅ ⊠ M_i), 𝕊(Ṁ_j ⊠ Ṗ_∅))` vanish unless the two
factors lie in the same piece of the semi-orthogonal decomposition. The source refers to "the
Tor-vanishing discussed in the proof of" Lemma 6.12; that proof (step `f_n → s_n`) gives the
vanishing in nonzero degrees (`isZero_derivedTensorHomology_loadingStandard`). Here the vanishing
in degree zero is added: for loading standards `S_t` and reflected `Ṡ_s` of a braid corner,
`S_t ⊗ Ṡ_s = 0` unless `s` and `t` have the same black counts (`StendhalLE` both ways). The
standards are cyclic, generated by the class of their loading idempotent; so `S_t ⊗ Ṡ_s` is
killed by `e(s)` from one side and by `e(t)` from the other.

## Main results

* `exists_smul_violLoadingStandardUnit`: loading standards are cyclic.
* `subsingleton_tensorProductOver_loadingStandard`: `S_t ⊗ Ṡ_s = 0` for different black counts.
* `isZero_derivedTensorHomology_loadingStandard_of_not_equiv`: `Tor_*(S_t, Ṡ_s) = 0` in every
  degree for different black counts.
-/

noncomputable section

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open CategoryTheory CategoryTheory.Limits KLR Equiv MulOpposite CornerEndomorphism DG

universe w
attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

variable {I k : Type} [DecidableEq I] [Field k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}
  {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : TypeA.IsReducedChoice ρ) (hQ : KLRSymm Q) (σ : Perm (Fin ℓ))

local notation "κ" => List.map σ (List.finRange ℓ)
local notation "C" => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ
local notation "μ" => stendhalWeight ℓ ν

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification
attribute [local instance 1200] Ring.toIntAlgebra

/-- The generator of the loading standard: the class of its loading idempotent, transported
from the left standard. -/
def violLoadingStandardUnit {t : Seq μ} (ht : IsRedOrdered t) :
    ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ :=
  (loadingStandardLeftEquiv (Λ := Λ) hρ hQ σ ht).symm (leftStandardUnit Q (Λ ∘ σ) t ht)

include hρ hQ in
/-- The generator is fixed by the loading idempotent. -/
theorem violLoadingIdem_smul_violLoadingStandardUnit {t : Seq μ} (ht : IsRedOrdered t) :
    op (violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (ν := ν) (redWord_relabel σ ht)) •
      violLoadingStandardUnit (Λ := Λ) hρ hQ σ ht =
        violLoadingStandardUnit (Λ := Λ) hρ hQ σ ht := by
  let E := loadingStandardLeftEquiv (Λ := Λ) hρ hQ σ ht
  apply E.injective
  rw [E.map_smulₛₗ]
  change leftCoefficientEquiv (Λ := Λ) hρ hQ σ (op (violLoadingIdem (redWord_relabel σ ht))) •
    E (E.symm (leftStandardUnit Q (Λ ∘ σ) t ht)) = E (E.symm (leftStandardUnit Q (Λ ∘ σ) t ht))
  rw [leftCoefficientEquiv_loadingIdem, LinearEquiv.apply_symm_apply]
  have h := leftStandard_mk_eq_smul_unit (Q := Q) (Λ := Λ ∘ σ) t ht
    ⟨seqIdem Q (Λ ∘ σ) t ht, seqIdem_mul_self Q (Λ ∘ σ) t ht⟩
  exact h.symm

include hρ hQ in
/-- **Loading standards are cyclic**, generated by `violLoadingStandardUnit`. -/
theorem exists_smul_violLoadingStandardUnit {t : Seq μ} (ht : IsRedOrdered t)
    (m : ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ) :
    ∃ a : Cᵐᵒᵖ, m = a • violLoadingStandardUnit (Λ := Λ) hρ hQ σ ht := by
  let E := loadingStandardLeftEquiv (Λ := Λ) hρ hQ σ ht
  obtain ⟨a, ha⟩ := leftStandard_exists_smul_unit (Q := Q) (Λ := Λ ∘ σ) t ht (E m)
  refine ⟨(leftCoefficientEquiv (Λ := Λ) hρ hQ σ).symm a, E.injective ?_⟩
  rw [E.map_smulₛₗ, ha]
  change a • leftStandardUnit Q (Λ ∘ σ) t ht =
    leftCoefficientEquiv (Λ := Λ) hρ hQ σ ((leftCoefficientEquiv (Λ := Λ) hρ hQ σ).symm a) •
      E (E.symm (leftStandardUnit Q (Λ ∘ σ) t ht))
  rw [RingEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]

/-- The reflected loading standard, a left module over the braid corner through the flip. -/
abbrev ReflectedLoadingStandard (s : Seq μ) : ModuleCat.{0} C :=
  (ModuleCat.restrictScalars (cornerFlipEquiv (Q := Q) (Λ := Λ) ν κ).symm.toRingHom).obj
    (ModuleCat.of Cᵐᵒᵖ (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ s) κ))

include hρ hQ in
/-- **Tor₀ between loading standards with different black counts**: `S_t ⊗ Ṡ_s = 0` unless
`s ≤ t` and `t ≤ s` in Webster's preorder. -/
theorem subsingleton_tensorProductOver_loadingStandard {s t : Seq μ} (hs : IsRedOrdered s)
    (ht : IsRedOrdered t) (hst : ¬ (StendhalLE s t ∧ StendhalLE t s)) :
    Subsingleton (TensorProductOver C
      (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ)
      (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s)) := by
  let es := violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (redWord_relabel σ hs)
  let et := violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (redWord_relabel σ ht)
  -- The left action of `c` on the reflected standard is the right action of its flip.
  have hact (c : C) (y : ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s) :
      c • y = (op (cornerFlip c) • (y : ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ)
        (Seq.redPerm σ s) κ) : ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ)
          (Seq.redPerm σ s) κ) := rfl
  have hflip (c : C) : op (cornerFlip (cornerFlip c)) = op c :=
    (cornerFlipEquiv (Q := Q) (Λ := Λ) ν κ).symm_apply_apply (op c)
  have hes : cornerFlip es = es := cornerFlip_violLoadingIdem σ hs
  have het : cornerFlip et = et := cornerFlip_violLoadingIdem σ ht
  have key : ∀ (m : ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ)
      (y : ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s),
      TensorProductOver.tmul C m y = 0 := by
    intro m y
    by_cases hle : StendhalLE s t
    · -- `e(t)` kills the reflected standard; move it across from the generator of `S_t`.
      have hts : ¬ StendhalLE t s := fun h => hst ⟨hle, h⟩
      obtain ⟨a, rfl⟩ := exists_smul_violLoadingStandardUnit (Λ := Λ) hρ hQ σ ht m
      have ha : a = op (unop a) := rfl
      rw [ha, TensorProductOver.op_smul_tmul,
        ← violLoadingIdem_smul_violLoadingStandardUnit (Λ := Λ) hρ hQ σ ht,
        TensorProductOver.op_smul_tmul]
      have hz : et • (unop a • y) = 0 := by
        rw [hact, het]
        exact violLoadingIdem_smul_violLoadingStandard_eq_zero_of_not_le hρ hQ σ hs ht hts _
      rw [hz, TensorProductOver.tmul_zero]
    · -- `e(s)` kills `S_t`; move it across from the generator of `Ṡ_s`.
      obtain ⟨a, ha⟩ := exists_smul_violLoadingStandardUnit (Λ := Λ) hρ hQ σ hs y
      let u : ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s :=
        violLoadingStandardUnit (Λ := Λ) hρ hQ σ hs
      have hy : y = cornerFlip (unop a) • u := by
        rw [hact, hflip]
        exact ha
      have hu : es • u = u := by
        rw [hact, hes]
        exact violLoadingIdem_smul_violLoadingStandardUnit (Λ := Λ) hρ hQ σ hs
      rw [hy, ← TensorProductOver.op_smul_tmul, ← hu, ← TensorProductOver.op_smul_tmul,
        violLoadingIdem_smul_violLoadingStandard_eq_zero_of_not_le hρ hQ σ ht hs hle,
        TensorProductOver.zero_tmul]
  refine ⟨fun x y => ?_⟩
  have hz : ∀ z : TensorProductOver C
      (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ)
      (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s), z = 0 := fun z => by
    induction z using TensorProductOver.induction_on with
    | zero => rfl
    | tmul m y => exact key m y
    | add x y hx hy => rw [hx, hy, add_zero]
  rw [hz x, hz y]

open DG.DerivedCategory
open scoped DG.DegreeZero

include hρ hQ in
/-- **Tor between loading standards with different black counts vanishes in every degree**
(Webster, arXiv:1309.3796v3, §7.3, proof of Proposition 7.22, the vanishing of the `E²` terms
off the diagonal piece of the semi-orthogonal decomposition): for loadings `s`, `t` that are not
equivalent in Webster's preorder, `Tor_*(S_t, Ṡ_s) = 0`. In nonzero degrees this is the
vanishing of the proof of Lemma 6.12 (`isZero_derivedTensorHomology_loadingStandard`), in degree
zero `subsingleton_tensorProductOver_loadingStandard`. -/
theorem isZero_derivedTensorHomology_loadingStandard_of_not_equiv
    [HasDerivedCategory.{w, 0} C] [HasDerivedCategory.{w, 0} ℤ]
    (D : ModuleFiltration.OrderedStandardCovers
      (fun s : {s : Seq μ // IsRedOrdered s} => ModuleCat.of (TensorProductAlgebra k Q (Λ ∘ σ) ν)
        (leftStandard Q (Λ ∘ σ) s.1 s.2))
      (fun s => seqIdem Q (Λ ∘ σ) s.1 s.2) (fun s t => StendhalLT s.1 t.1))
    {s t : Seq μ} (hs : IsRedOrdered s) (ht : IsRedOrdered t)
    (hst : ¬ (StendhalLE s t ∧ StendhalLE t s)) (n : ℤ) :
    IsZero ((homologyFunctor (A := ℤ) ℤ n).obj
      ((derivedTensor.{w} ℤ C
        (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ)).obj
        (DG.DerivedCategory.Q.obj ((degreeZeroModuleFunctor C).obj
          (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s))))) := by
  by_cases hn : n = 0
  · subst hn
    have := subsingleton_tensorProductOver_loadingStandard (Λ := Λ) hρ hQ σ hs ht hst
    have e := ambientDerivedTensorH0Equiv (k := ℤ) (A := C)
      (N := ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ)
      (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s)
    exact ModuleCat.isZero_iff_subsingleton.mpr e.toEquiv.subsingleton
  · exact isZero_derivedTensorHomology_loadingStandard hρ hQ σ D hs ht n hn

include hρ hQ in
/-- **Tor between modules filtered by loading standards with different black counts**: if
`M` is filtered by loading standards `S_t` and `Y` by reflected loading standards `Ṡ_s`, and no
label of `M` is equivalent to a label of `Y` in Webster's preorder, then `M ⊗ᴸ Y` has no
cohomology. This is the form used for the off-diagonal `E²` terms in Webster,
arXiv:1309.3796v3, §7.3, proof of Proposition 7.22. -/
theorem isZero_derivedTensorHomology_of_loadingFiltrations
    [HasDerivedCategory.{w, 0} C] [HasDerivedCategory.{w, 0} ℤ]
    (D : ModuleFiltration.OrderedStandardCovers
      (fun s : {s : Seq μ // IsRedOrdered s} => ModuleCat.of (TensorProductAlgebra k Q (Λ ∘ σ) ν)
        (leftStandard Q (Λ ∘ σ) s.1 s.2))
      (fun s => seqIdem Q (Λ ∘ σ) s.1 s.2) (fun s t => StendhalLT s.1 t.1))
    {m m' : List {s : Seq μ // IsRedOrdered s}} {M : ModuleCat.{0} Cᵐᵒᵖ} {Y : ModuleCat.{0} C}
    (hM : ModuleFiltration.HasFiltration (fun t : {s : Seq μ // IsRedOrdered s} =>
      ModuleCat.of Cᵐᵒᵖ (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t.1) κ))
      m M)
    (hY : ModuleFiltration.HasFiltration (fun s : {s : Seq μ // IsRedOrdered s} =>
      ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s.1) m' Y)
    (hlab : ∀ t ∈ m, ∀ s ∈ m', ¬ (StendhalLE s.1 t.1 ∧ StendhalLE t.1 s.1)) (n : ℤ) :
    IsZero ((homologyFunctor (A := ℤ) ℤ n).obj ((derivedTensor.{w} ℤ C M).obj
      (DG.DerivedCategory.Q.obj ((degreeZeroModuleFunctor C).obj Y)))) :=
  isZero_derivedTensorHomology_of_filtrations hM hY n fun t ht s hs =>
    isZero_derivedTensorHomology_loadingStandard_of_not_equiv hρ hQ σ D s.2 t.2
      (hlab t ht s hs) n

include hρ hQ in
/-- **Higher Tor between modules filtered by loading standards vanish** (Webster,
arXiv:1309.3796v3, proof of Lemma 6.12, step `f_n → s_n`, in filtered form): the form used for the
diagonal `E²` term in the proof of Proposition 7.22. -/
theorem isZero_derivedTensorHomology_of_loadingFiltrations_of_ne_zero
    [HasDerivedCategory.{w, 0} C] [HasDerivedCategory.{w, 0} ℤ]
    (D : ModuleFiltration.OrderedStandardCovers
      (fun s : {s : Seq μ // IsRedOrdered s} => ModuleCat.of (TensorProductAlgebra k Q (Λ ∘ σ) ν)
        (leftStandard Q (Λ ∘ σ) s.1 s.2))
      (fun s => seqIdem Q (Λ ∘ σ) s.1 s.2) (fun s t => StendhalLT s.1 t.1))
    {m m' : List {s : Seq μ // IsRedOrdered s}} {M : ModuleCat.{0} Cᵐᵒᵖ} {Y : ModuleCat.{0} C}
    (hM : ModuleFiltration.HasFiltration (fun t : {s : Seq μ // IsRedOrdered s} =>
      ModuleCat.of Cᵐᵒᵖ (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t.1) κ))
      m M)
    (hY : ModuleFiltration.HasFiltration (fun s : {s : Seq μ // IsRedOrdered s} =>
      ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ s.1) m' Y) (n : ℤ) (hn : n ≠ 0) :
    IsZero ((homologyFunctor (A := ℤ) ℤ n).obj ((derivedTensor.{w} ℤ C M).obj
      (DG.DerivedCategory.Q.obj ((degreeZeroModuleFunctor C).obj Y)))) :=
  isZero_derivedTensorHomology_of_filtrations hM hY n fun t _ s _ =>
    isZero_derivedTensorHomology_loadingStandard hρ hQ σ D s.2 t.2 n hn

end Categorification.Stendhal.BraidedStendhalAlgebra
