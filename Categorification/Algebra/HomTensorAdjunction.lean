import Categorification.Algebra.HomTensor

/-!
# Adjunctions between module functors induced by an adjunction

Let `Ψ : C ⥤ D` be left adjoint to `Φ : D ⥤ C`, with unit `η` and counit `ε`, and fix
objects `O : C`, `O' : D`. Write `A = End O` and `A' = End O'`. The bimodules `O' ⟶ Ψ O`
and `O ⟶ Φ O'` (see `HomTensor`) give functors between right modules,

`T_Ψ M = (O' ⟶ Ψ O) ⊗_A M`,   `T_Φ N = (O ⟶ Φ O') ⊗_{A'} N`.

If `Ψ O` is a direct summand of finitely many copies of `O'`, that is
`𝟙 (Ψ O) = ∑ⱼ πⱼ ≫ ιⱼ` with `πⱼ : Ψ O ⟶ O'` and `ιⱼ : O' ⟶ Ψ O`, then `T_Ψ` is left
adjoint to `T_Φ`: there is a bijection

`Hom_{A'}(T_Ψ M, N) ≃ Hom_A(M, T_Φ N)`,

natural in `M` and `N` (`homEquiv`). It sends `f` to `m ↦ ∑ⱼ (η ≫ Φ πⱼ) ⊗ f(ιⱼ ⊗ m)`,
and its inverse sends `g` to `β ⊗ m ↦ ev_β (g m)`, where `ev_β (α ⊗ n) = (β ≫ Ψ α ≫ ε) n`.
The proofs use only the triangle identities, naturality of `η` and `ε`, and `∑ⱼ πⱼ ≫ ιⱼ = 𝟙`.

This is the step that turns a biadjunction on a category generated by one object into
adjunctions in both directions between the induced functors on modules, used for Webster's
functors `Eᵢ`, `Fᵢ` on right `T^λ`-modules (arXiv:1309.3796v3, Theorem 4.31 and §5).

## Main definitions

* `HomTensor.eval`: the evaluation `ev_β : (O ⟶ Φ O') ⊗_{A'} N → N`.
* `HomTensor.toHom`, `HomTensor.ofHom`: the two directions of the bijection.
* `HomTensor.homEquiv`: `Hom_{A'}(T_Ψ M, N) ≃ Hom_A(M, T_Φ N)`, with naturality
  `homEquiv_naturality_left` and `homEquiv_naturality_right`.
-/

namespace Categorification.HomTensor

open CategoryTheory MulOpposite BalancedTensor

noncomputable section

attribute [local instance] bimodule

section SumTmul

variable {k B A M N : Type*} [CommRing k] [Ring B] [Algebra k B] [Ring A]
  [AddCommGroup M] [Module k M] [Module B M] [IsScalarTower k B M] [Module Aᵐᵒᵖ M]
  [AddCommGroup N] [Module k N] [Module A N]

theorem sum_tmul_left {X : Type*} (s : Finset X) (m : X → M) (n : N) :
    (tmul (∑ x ∈ s, m x) n : BalancedTensor k B A M N) = ∑ x ∈ s, tmul (m x) n :=
  map_sum ((mkBil k B A M N).flip n) m s

end SumTmul

/-- `op (x ≫ y) = op x * op y` in `(End X)ᵐᵒᵖ`. -/
theorem op_comp_eq_mul {D : Type*} [Category D] [Preadditive D] {X : D} (x y : X ⟶ X) :
    (op (x ≫ y) : (End X)ᵐᵒᵖ) = (op x : (End X)ᵐᵒᵖ) * (op y : (End X)ᵐᵒᵖ) :=
  MulOpposite.unop_injective (by
    rw [MulOpposite.unop_mul, MulOpposite.unop_op, MulOpposite.unop_op, MulOpposite.unop_op,
      End.mul_def])

variable (k : Type*) [CommRing k] {C : Type*} [Category C] [Preadditive C] [Linear k C]
  {D : Type*} [Category D] [Preadditive D] [Linear k D]
  {Ψ : C ⥤ D} {Φ : D ⥤ C} [Ψ.Additive] [Ψ.Linear k] [Φ.Additive]
  (adj : Ψ ⊣ Φ) (O : C) (O' : D)

variable {N : Type*} [AddCommGroup N] [Module k N] [Module (End O')ᵐᵒᵖ N]
  [IsScalarTower k (End O')ᵐᵒᵖ N]

/-- The bilinear map `α, n ↦ (β ≫ Ψ α ≫ ε) n`. -/
def evalBil (β : O' ⟶ Ψ.obj O) : (O ⟶ Φ.obj O') →ₗ[k] N →ₗ[k] N :=
  LinearMap.mk₂ k
    (fun α n => (op (β ≫ Ψ.map α ≫ adj.counit.app O') : (End O')ᵐᵒᵖ) • n)
    (fun α α' n => by
      rw [Ψ.map_add, Preadditive.add_comp, Preadditive.comp_add, MulOpposite.op_add,
        add_smul])
    (fun c α n => by
      rw [Functor.map_smul, Linear.smul_comp, Linear.comp_smul, MulOpposite.op_smul,
        smul_assoc])
    (fun α n n' => smul_add _ _ _)
    (fun c α n => smul_comm _ _ _)

/-- **Evaluation** `ev_β : (O ⟶ Φ O') ⊗_{A'} N → N`, `α ⊗ n ↦ (β ≫ Ψ α ≫ ε) n`. -/
def eval (β : O' ⟶ Ψ.obj O) :
    BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N →ₗ[k] N :=
  BalancedTensor.lift (evalBil k adj O O' β) (fun α a n => by
    change (op (β ≫ Ψ.map (α ≫ Φ.map a.unop) ≫ adj.counit.app O') : (End O')ᵐᵒᵖ) • n =
      (op (β ≫ Ψ.map α ≫ adj.counit.app O') : (End O')ᵐᵒᵖ) • a • n
    rw [← mul_smul, Ψ.map_comp, Category.assoc, adj.counit_naturality, ← Category.assoc,
      ← Category.assoc, op_comp_eq_mul, MulOpposite.op_unop, Category.assoc])

variable {k adj O O'}

variable (adj O) in
/-- The unit `η_O : O ⟶ Φ (Ψ O)`. -/
abbrev unitHom : O ⟶ Φ.obj (Ψ.obj O) := adj.unit.app O

theorem eval_tmul (β : O' ⟶ Ψ.obj O) (α : O ⟶ Φ.obj O') (n : N) :
    eval k adj O O' β (tmul α n) =
      (op (β ≫ Ψ.map α ≫ adj.counit.app O') : (End O')ᵐᵒᵖ) • n := rfl

theorem eval_add_left (β β' : O' ⟶ Ψ.obj O)
    (x : BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) :
    eval k adj O O' (β + β') x = eval k adj O O' β x + eval k adj O O' β' x := by
  induction x using BalancedTensor.induction_on with
  | zero => simp only [map_zero, add_zero]
  | tmul α n =>
    rw [eval_tmul, eval_tmul, eval_tmul, Preadditive.add_comp, MulOpposite.op_add, add_smul]
  | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]; abel

theorem eval_smul_left (c : k) (β : O' ⟶ Ψ.obj O)
    (x : BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) :
    eval k adj O O' (c • β) x = c • eval k adj O O' β x := by
  induction x using BalancedTensor.induction_on with
  | zero => simp only [map_zero, smul_zero]
  | tmul α n => rw [eval_tmul, eval_tmul, Linear.smul_comp, MulOpposite.op_smul, smul_assoc]
  | add x y hx hy => rw [map_add, map_add, hx, hy, smul_add]

/-- `ev_{b β} = b ev_β`. -/
theorem eval_comp_left (b : (End O')ᵐᵒᵖ) (β : O' ⟶ Ψ.obj O)
    (x : BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) :
    eval k adj O O' (b.unop ≫ β) x = b • eval k adj O O' β x := by
  induction x using BalancedTensor.induction_on with
  | zero => simp only [map_zero, smul_zero]
  | tmul α n =>
    rw [eval_tmul, eval_tmul, ← mul_smul, Category.assoc, op_comp_eq_mul, MulOpposite.op_unop]
  | add x y hx hy => rw [map_add, map_add, hx, hy, smul_add]

/-- `ev_β (a x) = ev_{β Ψ(a)} x`. -/
theorem eval_smul (a : (End O)ᵐᵒᵖ) (β : O' ⟶ Ψ.obj O)
    (x : BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) :
    eval k adj O O' β (a • x) = eval k adj O O' (β ≫ Ψ.map a.unop) x := by
  induction x using BalancedTensor.induction_on with
  | zero => simp only [smul_zero, map_zero]
  | tmul α n =>
    rw [smul_tmul', eval_tmul, eval_tmul]
    change (op (β ≫ Ψ.map (a.unop ≫ α) ≫ adj.counit.app O') : (End O')ᵐᵒᵖ) • n = _
    rw [Ψ.map_comp, Category.assoc, Category.assoc]
  | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy]

omit [Linear k D] [IsScalarTower k (End O')ᵐᵒᵖ N] in
/-- The balancing relation in `(O ⟶ Φ O') ⊗_{A'} N`, written with a morphism of `D`. -/
theorem tmul_op_smul (α : O ⟶ Φ.obj O') (c : O' ⟶ O') (n : N) :
    (tmul α ((op c : (End O')ᵐᵒᵖ) • n) :
        BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) =
      tmul (α ≫ Φ.map c) n :=
  (op_smul_tmul (B := (End O)ᵐᵒᵖ) α (op c : (End O')ᵐᵒᵖ) n).symm

variable {J : Type*} [Fintype J] (π : J → (Ψ.obj O ⟶ O')) (ι : J → (O' ⟶ Ψ.obj O))
  (h : ∑ j, π j ≫ ι j = 𝟙 (Ψ.obj O))

omit [Ψ.Additive] in
include h in
/-- `∑ⱼ η ≫ Φ πⱼ ≫ Φ (ιⱼ ≫ w) = η ≫ Φ w`. -/
theorem sum_unit_comp (w : Ψ.obj O ⟶ O') :
    ∑ j, unitHom adj O ≫ Φ.map (π j) ≫ Φ.map (ι j ≫ w) = unitHom adj O ≫ Φ.map w := by
  have e : ∑ j, π j ≫ ι j ≫ w = w := by
    simp only [← Category.assoc, ← Preadditive.sum_comp, h, Category.id_comp]
  rw [← Preadditive.comp_sum]
  simp only [← Φ.map_comp]
  rw [← Φ.map_sum, e]

variable {M : Type*} [AddCommGroup M] [Module k M] [Module (End O)ᵐᵒᵖ M]
  [IsScalarTower k (End O)ᵐᵒᵖ M]

omit [Linear k C] [Ψ.Linear k] [IsScalarTower k (End O)ᵐᵒᵖ M] in
include h in
/-- In `(O' ⟶ Ψ O) ⊗_A M`, `β ⊗ m = ∑ⱼ (β ≫ πⱼ) (ιⱼ ⊗ m)`. -/
theorem tmul_eq_sum (β : O' ⟶ Ψ.obj O) (m : M) :
    (tmul β m : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M) =
      ∑ j, (op (β ≫ π j) : (End O')ᵐᵒᵖ) • tmul (ι j) m := by
  simp only [smul_tmul']
  change _ = ∑ j, tmul ((β ≫ π j) ≫ ι j) m
  rw [← sum_tmul_left]
  simp only [Category.assoc]
  rw [← Preadditive.comp_sum, h, Category.comp_id]

variable (adj) in
/-- The map `m ↦ ∑ⱼ (η ≫ Φ πⱼ) ⊗ f(ιⱼ ⊗ m)` underlying `toHom`. -/
def toHomFun (f : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N)
    (m : M) : BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N :=
  ∑ j, tmul (unitHom adj O ≫ Φ.map (π j)) (f (tmul (ι j) m))

variable (adj) in
include h in
/-- **The forward map** `Hom_{A'}(T_Ψ M, N) → Hom_A(M, T_Φ N)`. -/
def toHom (f : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N) :
    M →ₗ[(End O)ᵐᵒᵖ] BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N where
  toFun := toHomFun adj π ι f
  map_add' m m' := by
    simp only [toHomFun, tmul_add, map_add, Finset.sum_add_distrib]
  map_smul' a m := by
    simp only [toHomFun, RingHom.id_apply, Finset.smul_sum, smul_tmul']
    have e : ∀ j, (tmul (ι j) (a • m) :
        BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M) =
          ∑ l, (op ((ι j ≫ Ψ.map a.unop) ≫ π l) : (End O')ᵐᵒᵖ) • tmul (ι l) m :=
        fun j => by
      rw [← op_smul_tmul]
      exact tmul_eq_sum π ι h _ m
    simp only [e, map_sum, map_smul, tmul_sum, tmul_op_smul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [← sum_tmul_left]
    congr 1
    simp only [Category.assoc]
    rw [sum_unit_comp π ι h, Φ.map_comp, ← Category.assoc, adj.unit_naturality,
      Category.assoc]
    rfl

omit [Ψ.Linear k] [IsScalarTower k (End O')ᵐᵒᵖ N]
  [IsScalarTower k (End O)ᵐᵒᵖ M] in
theorem toHom_apply
    (f : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N) (m : M) :
    toHom adj π ι h f m =
      ∑ j, tmul (unitHom adj O ≫ Φ.map (π j)) (f (tmul (ι j) m)) := rfl

variable (adj) in
/-- The bilinear map `β, m ↦ ev_β (g m)` underlying `ofHom`. -/
def ofHomBil
    (g : M →ₗ[(End O)ᵐᵒᵖ] BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) :
    (O' ⟶ Ψ.obj O) →ₗ[k] M →ₗ[k] N :=
  LinearMap.mk₂ k (fun β m => eval k adj O O' β (g m))
    (fun β β' m => eval_add_left β β' _)
    (fun c β m => eval_smul_left c β _)
    (fun β m m' => by rw [map_add, map_add])
    (fun c β m => by rw [LinearMap.map_smul_of_tower, map_smul])

variable (adj) in
/-- **The backward map** `Hom_A(M, T_Φ N) → Hom_{A'}(T_Ψ M, N)`, `β ⊗ m ↦ ev_β (g m)`. -/
def ofHom
    (g : M →ₗ[(End O)ᵐᵒᵖ] BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) :
    BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N :=
  BalancedTensor.liftB (ofHomBil adj g)
    (fun β a m => by
      change eval k adj O O' (β ≫ Ψ.map a.unop) (g m) = eval k adj O O' β (g (a • m))
      rw [map_smul, eval_smul])
    (fun b β m => eval_comp_left b β (g m))

theorem ofHom_tmul
    (g : M →ₗ[(End O)ᵐᵒᵖ] BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N)
    (β : O' ⟶ Ψ.obj O) (m : M) :
    ofHom adj g (tmul β m) = eval k adj O O' β (g m) := rfl

include h in
theorem ofHom_toHom
    (f : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N) :
    ofHom adj (toHom adj π ι h f) = f := by
  refine BalancedTensor.extB fun β m => ?_
  rw [ofHom_tmul, toHom_apply, map_sum, tmul_eq_sum π ι h β m, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [eval_tmul, map_smul, Ψ.map_comp, Category.assoc,
    adj.counit_naturality, ← Category.assoc (Ψ.map _), adj.left_triangle_components,
    Category.id_comp]

include h in
/-- `∑ⱼ (η ≫ Φ πⱼ) ⊗ ev_{ιⱼ} x = x`. -/
theorem sum_tmul_eval (x : BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) :
    ∑ j, tmul (unitHom adj O ≫ Φ.map (π j)) (eval k adj O O' (ι j) x) = x := by
  induction x using BalancedTensor.induction_on with
  | zero => simp only [map_zero, tmul_zero, Finset.sum_const_zero]
  | tmul α n =>
    simp only [eval_tmul, tmul_op_smul]
    rw [← sum_tmul_left]
    congr 1
    simp only [Category.assoc]
    rw [sum_unit_comp π ι h, Φ.map_comp, ← Category.assoc, adj.unit_naturality,
      Category.assoc]
    change α ≫ adj.unit.app (Φ.obj O') ≫ Φ.map (adj.counit.app O') = α
    rw [adj.right_triangle_components, Category.comp_id]
  | add x y hx hy =>
    simp only [map_add, tmul_add, Finset.sum_add_distrib, hx, hy]

include h in
theorem toHom_ofHom
    (g : M →ₗ[(End O)ᵐᵒᵖ] BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) :
    toHom adj π ι h (ofHom adj g) = g := by
  ext m
  rw [toHom_apply]
  exact sum_tmul_eval π ι h (g m)

variable (adj) in
include h in
/-- **The adjunction** `T_Ψ ⊣ T_Φ`: `Hom_{A'}(T_Ψ M, N) ≃ Hom_A(M, T_Φ N)`, for
`𝟙 (Ψ O) = ∑ⱼ πⱼ ≫ ιⱼ`. -/
def homEquiv :
    (BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N) ≃
      (M →ₗ[(End O)ᵐᵒᵖ] BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N) where
  toFun := toHom adj π ι h
  invFun := ofHom adj
  left_inv := ofHom_toHom π ι h
  right_inv := toHom_ofHom π ι h

theorem homEquiv_apply
    (f : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N) (m : M) :
    homEquiv adj π ι h f m =
      ∑ j, tmul (unitHom adj O ≫ Φ.map (π j)) (f (tmul (ι j) m)) := rfl

theorem homEquiv_symm_tmul
    (g : M →ₗ[(End O)ᵐᵒᵖ] BalancedTensor k (End O)ᵐᵒᵖ (End O')ᵐᵒᵖ (O ⟶ Φ.obj O') N)
    (β : O' ⟶ Ψ.obj O) (m : M) :
    (homEquiv adj π ι h).symm g (tmul β m) = eval k adj O O' β (g m) := rfl

/-- Naturality of `homEquiv` in `M`. -/
theorem homEquiv_naturality_left {M' : Type*} [AddCommGroup M'] [Module k M']
    [Module (End O)ᵐᵒᵖ M'] [IsScalarTower k (End O)ᵐᵒᵖ M'] (u : M' →ₗ[(End O)ᵐᵒᵖ] M)
    (f : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N) :
    homEquiv adj π ι h (f.comp (mapRight (k := k) (B := (End O')ᵐᵒᵖ) u)) =
      (homEquiv adj π ι h f).comp u := rfl

/-- Naturality of `homEquiv` in `N`. -/
theorem homEquiv_naturality_right {N' : Type*} [AddCommGroup N'] [Module k N']
    [Module (End O')ᵐᵒᵖ N'] [IsScalarTower k (End O')ᵐᵒᵖ N'] (q : N →ₗ[(End O')ᵐᵒᵖ] N')
    (f : BalancedTensor k (End O')ᵐᵒᵖ (End O)ᵐᵒᵖ (O' ⟶ Ψ.obj O) M →ₗ[(End O')ᵐᵒᵖ] N) :
    homEquiv adj π ι h (q.comp f) =
      (mapRight (k := k) (B := (End O)ᵐᵒᵖ) q).comp (homEquiv adj π ι h f) := by
  ext m
  simp only [LinearMap.comp_apply, homEquiv_apply, map_sum, mapRight_tmul]

end

end Categorification.HomTensor
