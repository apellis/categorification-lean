import Categorification.Algebra.BalancedTensor

/-!
# Tensoring with a bimodule generated by a free corner vector

Let `S` be an `(R, A)`-bimodule and `u ∈ S` a vector with an element `ε ∈ R` such that

* `ε u = u`, and `u` generates `S` as an `R`-module;
* `ε S = u A`, and `a ↦ u a` is injective.

Then `N ↦ S ⊗_A N` is fully faithful: `g ↦ S ⊗ g` is a bijection
`Hom_A(N, N') ≅ Hom_R(S ⊗_A N, S ⊗_A N')` (`IsCornerGenerator.mapRight_bijective`).
Indeed `ε (S ⊗_A N) = u ⊗ N` is a copy of `N` (`IsCornerGenerator.smul_eq_tmul_proj`,
`IsCornerGenerator.proj_tmul_gen`); an `R`-linear map preserves it, and its restriction to it is
`A`-linear because `u a ∈ R u`.

This is the shape of the standardization functors of B. Webster, *Knot invariants and higher
representation theory*, arXiv:1309.3796v3, Definition 5.4, with `u` the class of the idempotent
`e_α` in the standard module `S_α`, `R` the opposite of `T̃^λ` and `A` the opposite of the block
algebra of Proposition 5.3. The hypothesis `ε S = u A` freely is the identification
`S_α e_α ≅ R_{α(0)} ⊗ T^{λ_1}_{μ_1} ⊗ ⋯ ⊗ T^{λ_ℓ}_{μ_ℓ}` of Proposition 5.26.

## Main definitions

* `BalancedTensor.IsCornerGenerator`: the hypotheses above.
* `BalancedTensor.IsCornerGenerator.proj`: the map `S ⊗_A N → N`, `s ⊗ n ↦ c(s) n`, where
  `ε s = u c(s)`.

## Main results

* `BalancedTensor.IsCornerGenerator.mapRight_bijective`: full faithfulness.
-/

namespace Categorification

open MulOpposite

noncomputable section

namespace BalancedTensor

variable {k : Type*} [CommRing k] {R : Type*} [Ring R] [Algebra k R]
  {A : Type*} [Ring A] [Algebra k A]
  {S : Type*} [AddCommGroup S] [Module k S] [Module R S] [IsScalarTower k R S] [Module Aᵐᵒᵖ S]
  [IsScalarTower k Aᵐᵒᵖ S] [SMulCommClass R Aᵐᵒᵖ S]

variable (A) in
/-- `u` generates the `(R, A)`-bimodule `S` over `R`, is fixed by `ε`, and `ε S` is free of rank
one over `A` on `u`. -/
structure IsCornerGenerator (ε : R) (u : S) : Prop where
  fix : ε • u = u
  gen : ∀ s : S, ∃ r : R, r • u = s
  corner : ∀ s : S, ∃ a : A, ε • s = op a • u
  free : ∀ a : A, op a • u = 0 → a = 0

namespace IsCornerGenerator

variable {ε : R} {u : S} (h : IsCornerGenerator A ε u)

include h

/-- The coordinate `c(s)` of `ε s = u c(s)`. -/
def coord (s : S) : A := (h.corner s).choose

omit [SMulCommClass R Aᵐᵒᵖ S] in
theorem smul_eq_coord (s : S) : ε • s = op (h.coord s) • u := (h.corner s).choose_spec

omit [SMulCommClass R Aᵐᵒᵖ S] in
theorem coord_eq {s : S} {a : A} (hs : ε • s = op a • u) : h.coord s = a := by
  refine sub_eq_zero.1 (h.free _ ?_)
  rw [op_sub, sub_smul, ← h.smul_eq_coord, hs, sub_self]

theorem coord_op_smul_gen (a : A) : h.coord (op a • u) = a :=
  h.coord_eq (by rw [smul_comm, h.fix])

omit [SMulCommClass R Aᵐᵒᵖ S] in
theorem coord_gen : h.coord u = 1 :=
  h.coord_eq (by rw [h.fix, op_one, one_smul])

theorem coord_op_smul (a : A) (s : S) : h.coord (op a • s) = h.coord s * a :=
  h.coord_eq (by rw [smul_comm, h.smul_eq_coord, smul_smul, ← op_mul])

/-- The coordinate as a `k`-linear map. -/
def coordₗ : S →ₗ[k] A where
  toFun := h.coord
  map_add' s s' := h.coord_eq (by
    rw [smul_add, h.smul_eq_coord, h.smul_eq_coord, op_add, add_smul])
  map_smul' c s := h.coord_eq (by
    rw [RingHom.id_apply, smul_comm, h.smul_eq_coord, op_smul, smul_assoc])

omit [SMulCommClass R Aᵐᵒᵖ S] in
theorem coordₗ_apply (s : S) : h.coordₗ (k := k) s = h.coord s := rfl

variable {N N' : Type*} [AddCommGroup N] [Module k N] [Module A N] [IsScalarTower k A N]
  [AddCommGroup N'] [Module k N'] [Module A N'] [IsScalarTower k A N']

variable (N) in
/-- The bilinear map `(s, n) ↦ c(s) n`. -/
def projBil : S →ₗ[k] N →ₗ[k] N :=
  LinearMap.mk₂ k (fun s n => h.coord s • n)
    (fun s s' n => by rw [← coordₗ_apply (k := k), map_add, add_smul]; rfl)
    (fun c s n => by rw [← coordₗ_apply (k := k), map_smul, smul_assoc]; rfl)
    (fun s n n' => smul_add _ _ _)
    (fun c s n => smul_comm _ _ _)

variable (k R N) in
/-- The projection `S ⊗_A N → N`, `s ⊗ n ↦ c(s) n`. -/
def proj : BalancedTensor k R A S N →ₗ[k] N :=
  lift (h.projBil N) fun s a n => by
    change h.coord (op a • s) • n = h.coord s • (a • n)
    rw [h.coord_op_smul, mul_smul]

theorem proj_tmul (s : S) (n : N) : h.proj k R N (tmul s n) = h.coord s • n := rfl

theorem proj_tmul_gen (n : N) : h.proj k R N (tmul u n) = n := by
  rw [proj_tmul, coord_gen, one_smul]

/-- `ε (S ⊗_A N) = u ⊗ N`. -/
theorem smul_eq_tmul_proj (x : BalancedTensor k R A S N) :
    ε • x = tmul u (h.proj k R N x) := by
  induction x using induction_on with
  | zero => rw [smul_zero, map_zero, tmul_zero]
  | tmul s n =>
    rw [proj_tmul, ← op_smul_tmul, ← h.smul_eq_coord, smul_tmul']
  | add x y hx hy => rw [smul_add, hx, hy, map_add, tmul_add]

omit [Algebra k A] [IsScalarTower k Aᵐᵒᵖ S] [SMulCommClass R Aᵐᵒᵖ S] h
  [IsScalarTower k A N] in
theorem tmul_gen_eq_smul (s : S) (n : N) {r : R} (hr : r • u = s) :
    (tmul s n : BalancedTensor k R A S N) = r • tmul u n := by
  rw [smul_tmul', hr]

/-- The restriction of an `R`-linear map `S ⊗_A N → S ⊗_A N'` to `u ⊗ N`. -/
def restrictFun (φ : BalancedTensor k R A S N →ₗ[R] BalancedTensor k R A S N') (n : N) : N' :=
  h.proj k R N' (φ (tmul u n))

omit [IsScalarTower k A N] in
theorem tmul_restrictFun (φ : BalancedTensor k R A S N →ₗ[R] BalancedTensor k R A S N')
    (n : N) : tmul u (h.restrictFun φ n) = φ (tmul u n) := by
  rw [restrictFun, ← h.smul_eq_tmul_proj, ← map_smul, smul_tmul', h.fix]

/-- The restriction as an `A`-linear map. -/
def restrict (φ : BalancedTensor k R A S N →ₗ[R] BalancedTensor k R A S N') : N →ₗ[A] N' where
  toFun := h.restrictFun φ
  map_add' n n' := by rw [restrictFun, restrictFun, restrictFun, tmul_add, map_add, map_add]
  map_smul' a n := by
    obtain ⟨r, hr⟩ := h.gen (op a • u)
    rw [RingHom.id_apply, restrictFun, ← op_smul_tmul, tmul_gen_eq_smul _ n hr, map_smul,
      ← h.tmul_restrictFun, ← tmul_gen_eq_smul _ _ hr, op_smul_tmul, h.proj_tmul_gen]

omit [IsScalarTower k A N] in
theorem tmul_restrict (φ : BalancedTensor k R A S N →ₗ[R] BalancedTensor k R A S N') (n : N) :
    tmul u (h.restrict φ n) = φ (tmul u n) :=
  h.tmul_restrictFun φ n

theorem mapRight_restrict (φ : BalancedTensor k R A S N →ₗ[R] BalancedTensor k R A S N') :
    mapRight (h.restrict φ) = φ :=
  extB fun s n => by
    obtain ⟨r, hr⟩ := h.gen s
    rw [mapRight_tmul, tmul_gen_eq_smul _ _ hr, tmul_gen_eq_smul _ _ hr, map_smul,
      tmul_restrict]

theorem restrict_mapRight (g : N →ₗ[A] N') :
    h.restrict (mapRight (k := k) (B := R) (M := S) g) = g :=
  LinearMap.ext fun n => by
    rw [← h.proj_tmul_gen (k := k) (R := R) (N := N') (h.restrict _ n), tmul_restrict, mapRight_tmul,
      h.proj_tmul_gen]

/-- **Tensoring with `S` is fully faithful**: `g ↦ S ⊗ g` is a bijection
`Hom_A(N, N') ≅ Hom_R(S ⊗_A N, S ⊗_A N')`. -/
theorem mapRight_bijective :
    Function.Bijective (fun g : N →ₗ[A] N' => mapRight (k := k) (B := R) (M := S) g) :=
  Function.bijective_iff_has_inverse.2
    ⟨h.restrict, h.restrict_mapRight, h.mapRight_restrict⟩

end IsCornerGenerator

end BalancedTensor

end

end Categorification
