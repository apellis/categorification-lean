import Categorification.KLR.CyclotomicAbsentModule

/-!
# The cover ideal on a cyclotomic restriction cut

In the restriction of Webster, arXiv:1309.3796v2, Theorem 4.31, the
cyclotomic cover relations come from red dots and unordered red loadings.
-/

noncomputable section

namespace Categorification.Stendhal

/-- The submodule generated by the action of a two-sided ideal. -/
def idealActionSpan {A P : Type*} [Ring A] [AddCommGroup P] [Module A P]
    (I : TwoSidedIdeal A) : Submodule A P :=
  Submodule.span A {z | ∃ a ∈ I, ∃ p : P, z = a • p}

/-- Right multiplication preserves the submodule generated by the lower ideal. -/
theorem mapsTo_idealActionSpan {A P Q : Type*} [Ring A] [AddCommGroup P] [Module A P]
    [AddCommGroup Q] [Module A Q] (I : TwoSidedIdeal A) (f : P →ₗ[A] Q) :
    Set.MapsTo f (idealActionSpan (P := P) I) (idealActionSpan (P := Q) I) := by
  intro z hz
  refine (Submodule.span_le.mpr ?_ : idealActionSpan I ≤ (idealActionSpan I).comap f) hz
  rintro _ ⟨a, ha, p, rfl⟩
  exact Submodule.subset_span ⟨a, ha, f p, f.map_smul a p⟩

/-- If the left cut of every left multiple of each relation belongs to the
lower ideal's action submodule, the left cut of the whole two-sided ideal
does as well. The right action on the cut is linear over the lower ring. -/
theorem cut_span_mem_idealActionSpan
    {A B P : Type*} [Ring A] [Ring B] [AddCommGroup P] [Module A P]
    (I : TwoSidedIdeal A) (s : Set B) (cut : B →+ P) (rmul : B → P →ₗ[A] P)
    (hmul : ∀ x b, cut (x * b) = rmul b (cut x))
    (hs : ∀ x ∈ s, ∀ a, cut (a * x) ∈ idealActionSpan I)
    {x : B} (hx : x ∈ TwoSidedIdeal.span s) :
    cut x ∈ idealActionSpan I := by
  suffices h : ∀ a, cut (a * x) ∈ idealActionSpan I by simpa using h 1
  induction hx using TwoSidedIdeal.span_induction with
  | mem x hx => exact hs x hx
  | zero => simp
  | add x y _ _ hx hy => intro a; simpa only [mul_add, map_add] using (idealActionSpan I).add_mem (hx a) (hy a)
  | neg x _ hx => intro a; simpa only [mul_neg, map_neg] using (idealActionSpan I).neg_mem (hx a)
  | left_absorb a x _ hx => intro b; simpa only [mul_assoc] using hx (b * a)
  | right_absorb b x _ hx =>
    intro a
    rw [← mul_assoc, hmul]
    exact mapsTo_idealActionSpan I (rmul b) (hx a)

end Categorification.Stendhal
