import Categorification.Algebra.Graded.ExtensionK0
import Categorification.WeightedKLR.RedStrands.BlackRaising
import Categorification.WeightedKLR.RedStrands.CyclotomicCoverGrading

/-!
# Extension along a graded quotient

The quotient-module tensor identity used to compare restriction across the
cyclotomic cover for Webster, arXiv:1309.3796v2, Definition 4.30 and Lemma 4.35.
-/

noncomputable section
namespace Categorification.Graded

open MulOpposite BalancedTensor

universe u

variable {k : Type*} {A C : Type u} [CommRing k] [Ring A] [Algebra k A] [Ring C] [Algebra k C]
  (𝒜 : ℤ → Submodule k A) (ℬ : ℤ → Submodule k C) [GradedAlgebra 𝒜] [GradedAlgebra ℬ]
  (π : A →ₐ[k] C) (hπ : PreservesGrading 𝒜 ℬ π.toLinearMap)
  [Module Aᵐᵒᵖ C] [SMulCommClass C Aᵐᵒᵖ C] [IsScalarTower k Aᵐᵒᵖ C]
  (hact : ∀ (a : A) (c : C), op a • c = c * π a)

/-- A graded surjection with kernel generated by the action of the quotient ideal
identifies its target with extension of scalars. -/
def extensionProjIsoOfSurjective (P : GProj 𝒜) (W : GProj ℬ)
    (f : P.carrier →ₗ[k] W.carrier) (hdeg : PreservesGrading P.grading W.grading f)
    (hsmul : ∀ (a : A) (p : P.carrier), f (a • p) = π a • f p)
    (hsπ : Function.Surjective π) (hsf : Function.Surjective f)
    (hker : ∀ p, f p = 0 → p ∈ Submodule.span A
      {x | ∃ a : A, π a = 0 ∧ ∃ q : P.carrier, x = a • q}) :
    (extensionProj 𝒜 ℬ π hπ hact P).Iso W := by
  let T := (extensionProj 𝒜 ℬ π hπ hact P).carrier
  let g : P.carrier →ₗ[k] T := mkBil k C A C P.carrier 1
  have hg (p : P.carrier) : g p = tmul (1 : C) p := rfl
  have hsg : Function.Surjective g := by
    intro t
    induction t using BalancedTensor.induction_on with
    | zero => exact ⟨0, map_zero g⟩
    | tmul c p =>
      obtain ⟨a, rfl⟩ := hsπ c
      exact ⟨a • p, by rw [hg, ← op_smul_tmul, hact, one_mul]⟩
    | add x y hx hy =>
      obtain ⟨p, rfl⟩ := hx
      obtain ⟨q, rfl⟩ := hy
      exact ⟨p + q, map_add g ..⟩
  have hga (a : A) (p : P.carrier) : g (a • p) = π a • g p := by
    rw [hg, hg]
    change tmul (1 : C) (a • p) = π a • (tmul 1 p : BalancedTensor k C A C P.carrier)
    rw [← op_smul_tmul, hact, one_mul, smul_tmul', smul_eq_mul, mul_one]
  have hkg (p : P.carrier) (hp : f p = 0) : g p = 0 := by
    have hm := hker p hp
    clear hp
    induction hm using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, q, rfl⟩ := hx
      rw [hga, ha, zero_smul]
    | zero => exact map_zero g
    | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
    | smul a x _ hx => rw [hga, hx, smul_zero]
  let bil : C →ₗ[k] P.carrier →ₗ[k] W.carrier :=
    ((Algebra.lsmul k k W.carrier : C →ₐ[k] Module.End k W.carrier).toLinearMap).compl₂ f
  let F : T →ₗ[C] W.carrier := liftB bil
    (fun c a p => by change (op a • c) • f p = c • f (a • p); rw [hact, hsmul, mul_smul])
    (fun b c p => mul_smul b c (f p))
  have hFg (p : P.carrier) : F (g p) = f p := one_smul C _
  have hFi : Function.Injective F := by
    apply (LinearMap.ker_eq_bot.mp ?_)
    apply le_antisymm _ bot_le
    intro t ht
    obtain ⟨p, rfl⟩ := hsg t
    exact hkg p (show f p = 0 from (hFg p).symm.trans ht)
  let e := LinearEquiv.ofBijective F ⟨hFi, fun w => by
    obtain ⟨p, rfl⟩ := hsf w
    exact ⟨g p, hFg p⟩⟩
  letI : DirectSum.Decomposition (extensionProj 𝒜 ℬ π hπ hact P).grading :=
    (extensionProj 𝒜 ℬ π hπ hact P).decomposition
  refine GradedEquiv.ofPreserves (M := (extensionProj 𝒜 ℬ π hπ hact P).carrier) e ?_
  intro d x hx
  exact balancedGrading_map_mem W.grading (F.restrictScalars k)
    (fun _ _ _ _ hc hp => SetLike.GradedSMul.smul_mem (A := ℬ) (B := W.grading) hc (hdeg hp)) hx

end Categorification.Graded

namespace Categorification.Stendhal

open KLR KLRAlgebra KLRAlgebra.AbsentColour Categorification.Graded

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I k : Type*} [DecidableEq I] [Field k] {ℓ : ℕ}
    {Q : I → I → MvPolynomial (Fin 2) k} (Λ : Fin ℓ → I →₀ ℕ) (ν : Multiset I)
    (C : QuantumGroup.CartanDatum I) (i : I)
local notation "μ" => stendhalWeight ℓ ν
local notation "νᵢ" => ((Singleton.singleton i : Multiset I) + ν)
local notation "ci" => (Sum.inl i : I ⊕ Fin ℓ)
local notation "γ" => ((Singleton.singleton ci : Multiset (I ⊕ Fin ℓ)) + μ)
local notation "S" => cyclotomicCoverQ C Λ Q
local notation "p" => cyclotomicCoverPolynomial (I := I) (ℓ := ℓ) (k := k)
local notation "A" => CycKLR k S p μ
local notation "B" => CycKLR k S p γ
local notation "π" => cyclotomicCoverToTensor (Q := Q) Λ ν C
local notation "π'" => cyclotomicCoverUpper (Q := Q) Λ ν C i
local notation:max "src" e:arg => AbsentColour.Res S ci p μ (leftIdeal e)
local notation:max "dst" e:arg => BlackRes (Q := Q) (Λ := Λ) i ν (leftIdeal (π' e))

/-- The regular cut projection restricted to the left ideal of an upper idempotent. -/
def cyclotomicCoverResLeftIdealMap (e : B) : src e →ₗ[k] dst e where
  toFun z := ⟨⟨π' z.1.1, by
    change π' z.1.1 * π' e = π' z.1.1
    rw [← map_mul, z.1.2]⟩, Subtype.ext (by
      change appendBlack Q Λ i ν 1 * π' z.1.1 = π' z.1.1
      rw [← cyclotomicCoverUpper_lastIdem (Q := Q) Λ ν C i, ← map_mul]
      exact congrArg π' (congrArg Subtype.val z.2))⟩
  map_add' _ _ := Subtype.ext (Subtype.ext (map_add _ _ _))
  map_smul' a z := Subtype.ext (Subtype.ext ((π').toLinearMap.map_smul a z.1.1))

theorem cyclotomicCoverResLeftIdealMap_smul (e : B) (a : A) (z : src e) :
    cyclotomicCoverResLeftIdealMap Λ ν C i e (a • z) =
      π a • cyclotomicCoverResLeftIdealMap Λ ν C i e z := by
  apply Subtype.ext
  apply Subtype.ext
  change π' (cyclotomicLast S ci p μ a * z.1.1) = appendBlack Q Λ i ν (π a) * π' z.1.1
  rw [map_mul, cyclotomicCoverUpper_appendBlack]

theorem cyclotomicCoverResLeftIdealMap_surjective {e : B} (he : IsIdempotentElem e) :
    Function.Surjective (cyclotomicCoverResLeftIdealMap Λ ν C i e) := by
  intro y
  let y' : BlackRes (Q := Q) (Λ := Λ) i ν (TensorProductAlgebra k Q Λ νᵢ) :=
    ⟨y.1.1, congrArg Subtype.val y.2⟩
  obtain ⟨x, hx⟩ := cyclotomicCoverResMap_surjective Λ ν C i y'
  refine ⟨AbsentColour.resMap S ci p μ B (leftIdealProj he) x, Subtype.ext (Subtype.ext ?_)⟩
  change π' (x.1 * e) = y.1.1
  have h : π' x.1 = y.1.1 := congrArg Subtype.val hx
  rw [map_mul, h, y.1.2]

theorem cyclotomicCoverResLeftIdealMap_ker (hQ : IsRouquierQ C Q)
    {e : B} (he : IsIdempotentElem e) (z : src e)
    (hz : cyclotomicCoverResLeftIdealMap Λ ν C i e z = 0) :
    z ∈ Submodule.span A {x | ∃ a : A, π a = 0 ∧ ∃ q : src e, x = a • q} := by
  let x := AbsentColour.resMap S ci p μ (leftIdeal e) (leftIdeal e).subtype z
  have hx : cyclotomicCoverResMap (Q := Q) Λ ν C i x = 0 :=
    Subtype.ext (congrArg (fun t : dst e => t.1.1) hz)
  have hm := cyclotomicCoverResMap_ker_le (Q := Q) Λ ν C i hQ hx
  have h := mapsTo_idealActionSpan _ (AbsentColour.resMap S ci p μ B (leftIdealProj he)) hm
  rw [← cyclotomicCoverToTensor_ker (Q := Q) Λ ν C] at h
  have heq : AbsentColour.resMap S ci p μ B (leftIdealProj he) x = z :=
    Subtype.ext (Subtype.ext z.1.2)
  rw [heq] at h
  apply (Submodule.span_mono _ : idealActionSpan (TwoSidedIdeal.ker (π).toRingHom) ≤ _) h
  rintro x ⟨a, ha, q, rfl⟩
  exact ⟨a, (TwoSidedIdeal.mem_ker _).mp ha, q, rfl⟩


/-- Changing equal cyclotomic polynomials transports the quotient algebra. -/
def coverPolynomialCast {J : Type*} [DecidableEq J] (R : J → J → MvPolynomial (Fin 2) k)
    {q q' : J → Polynomial k} (h : q = q') (β : Multiset J) :
    CycKLR k R q β ≃ₐ[k] CycKLR k R q' β := by
  subst q'
  exact AlgEquiv.refl

theorem coverPolynomialCast_mk {J : Type*} [DecidableEq J] (R : J → J → MvPolynomial (Fin 2) k)
    {q q' : J → Polynomial k} (h : q = q') (β : Multiset J) (x : KLRAlgebra k R β) :
    coverPolynomialCast R h β (CycKLR.mk k R q β x) = CycKLR.mk k R q' β x := by
  subst q'
  rfl

local notation "H" hQ => IsRouquierQ.gradingDatum (isRouquierQ_cyclotomicCoverQ C Λ Q hQ)
local notation "G" hQ => stendhalGradingDatum Λ (IsRouquierQ.gradingDatum hQ)
    (fun j => C.dot j j / 2) (dotDegree C hQ)

theorem cyclotomicCoverUpper_preservesGrading (hQ : IsRouquierQ C Q) :
    PreservesGrading (Graded.map ((H hQ).grade γ) (CycKLR.mk k S p γ).toLinearMap)
      (tensorProductGrade (G hQ) νᵢ) (π').toLinearMap := by
  rintro d z ⟨x, hx, rfl⟩
  apply cyclotomicCoverToTensor_preservesGrading Λ C hQ νᵢ
  change CyclotomicAction.castCyc S p _ (CycKLR.mk k S p γ x) ∈ _
  rw [CyclotomicAction.castCyc_mk]
  exact Graded.mem_map_of_mem _ _ ((H hQ).castKLR_mem_grade _ hx)

local notation "ϕ" h => AlgHom.comp π (AlgEquiv.toAlgHom (coverPolynomialCast S h μ))
local notation "ϕ'" h => AlgHom.comp π' (AlgEquiv.toAlgHom (coverPolynomialCast S h γ))

private theorem exists_restriction_leftIdeal_map (hQ : IsRouquierQ C Q)
    {q : (I ⊕ Fin ℓ) → Polynomial k} (h : q = p) {e : CycKLR k S q γ} (he : IsIdempotentElem e) :
    ∃ f : AbsentColour.Res S ci q μ (leftIdeal e) →ₗ[k]
      BlackRes (Q := Q) (Λ := Λ) i ν (leftIdeal ((ϕ' h) e)),
      (∀ z, (f z).1.1 = (ϕ' h) z.1.1) ∧
      (∀ a z, f (a • z) = (ϕ h) a • f z) ∧ Function.Surjective f ∧
      ∀ z, f z = 0 → z ∈ Submodule.span (CycKLR k S q μ)
        {x | ∃ a : CycKLR k S q μ, (ϕ h) a = 0 ∧ ∃ t, x = a • t} := by
  subst q
  exact ⟨cyclotomicCoverResLeftIdealMap Λ ν C i e, fun _ => rfl,
    cyclotomicCoverResLeftIdealMap_smul Λ ν C i e,
    cyclotomicCoverResLeftIdealMap_surjective Λ ν C i he,
    cyclotomicCoverResLeftIdealMap_ker Λ ν C i hQ he⟩


section Powers

variable (m : (I ⊕ Fin ℓ) → ℕ)
local notation "q" => (fun j => (Polynomial.X : Polynomial k) ^ m j)
variable (hq : (fun j => (Polynomial.X : Polynomial k) ^ m j) =
  cyclotomicCoverPolynomial (I := I) (ℓ := ℓ)) (hQ : IsRouquierQ C Q)
local notation "Bq" => CycKLR k S q γ
local notation "Aq" => CycKLR k S q μ
local notation "T" => TensorProductAlgebra k Q Λ ν
local notation "𝒮" => CycKLR.grade (H hQ) m γ
local notation "𝒜" => CycKLR.grade (H hQ) m μ
local notation "𝒯" => tensorProductGrade (G hQ) ν
local notation "𝒰" => tensorProductGrade (G hQ) νᵢ
local notation "hS" => isRouquierQ_cyclotomicCoverQ C Λ Q hQ

theorem cyclotomicCoverUpperPower_preservesGrading :
    PreservesGrading 𝒮 𝒰 (ϕ' hq).toLinearMap := by
  rintro d z ⟨r, hr, rfl⟩
  apply cyclotomicCoverUpper_preservesGrading Λ ν C i hQ
  change coverPolynomialCast S hq γ (CycKLR.mk k S q γ r) ∈ _
  rw [coverPolynomialCast_mk]
  exact Graded.mem_map_of_mem _ _ hr


/-- Restriction of a homogeneous principal projective descends across the cyclotomic
cover quotient (Webster, arXiv:1309.3796v2, Definition 4.30 and Lemma 4.35). -/
theorem extensionK0_restriction_leftIdeal (ρ : Aq →ₐ[k] T) (hρ : PreservesGrading 𝒜 𝒯 ρ.toLinearMap)
    [Module Aqᵐᵒᵖ T] [SMulCommClass T Aqᵐᵒᵖ T] [IsScalarTower k Aqᵐᵒᵖ T]
    (hact : ∀ a c, MulOpposite.op a • c = c * ρ a)
    (hρeq : ρ = ϕ hq) {e : Bq} (he : IsIdempotentElem e) (he0 : e ∈ 𝒮 0) :
    extensionK0 𝒜 𝒯 ρ hρ hact
      (K0.of (CycKLR.gradedResProj (H hQ) m ci μ (hS).klrSymm (hS).polyInY_leading
        (GProj.ofIdempotent e he he0))) =
    K0.of (blackResProj (G hQ) i ν C hQ
      (GProj.ofIdempotent ((ϕ' hq) e) (he.map _) (cyclotomicCoverUpperPower_preservesGrading Λ ν C i m hq hQ he0))) := by
  subst ρ
  obtain ⟨f, heval, hsmul, hsurj, hker⟩ := exists_restriction_leftIdeal_map Λ ν C i hQ hq he
  rw [extensionK0_of]
  apply K0.of_eq_of_iso
  refine extensionProjIsoOfSurjective 𝒜 𝒯 (ϕ hq) hρ hact _ _ f ?_ hsmul
    ((cyclotomicCoverToTensor_surjective Λ ν C).comp (coverPolynomialCast S hq μ).surjective) hsurj hker
  intro d x hx
  let y : AbsentColour.Res S ci q μ (leftIdeal e) := x
  have hy : y.1.1 ∈ 𝒮 d := hx
  exact Eq.mpr (congrArg (fun t => t ∈ 𝒰 d) (heval y))
    (cyclotomicCoverUpperPower_preservesGrading Λ ν C i m hq hQ hy)

end Powers
end Categorification.Stendhal
