import Categorification.WeightedKLR.Rigidity.CupCapProp721AppendIotaCap
import Categorification.WeightedKLR.Rigidity.CupCapMidLeftFreeSurj
import Categorification.WeightedKLR.Rigidity.CupCapMidTriple
import Categorification.WeightedKLR.RedStrands.BraidedAppendCoset

/-!
# The appended model is generated by the image of appending a strand

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.3, proof of
Proposition 7.21, the part for `𝔈_i`, for `j < ℓ`: the multiplication
`T̃^λ_{{i} + ν} e' ⊗ K̃_ν → K̃_{{i} + ν} e'⁺`, `a ⊗ y ↦ a · ι(y)`, is surjective at the level of
the models. On a block generator `γ_g` at `{i} + ν` whose bottom ends in the black strand `i`, the
loading of `λ` is an appended loading and the window shuffle fixes the last strand, so that
`γ_g e'⁺` is `e'` times the appended generator at `ν`; on the other block generators `γ_g e'⁺`
vanishes, or the piece `L e(t_g)` is zero because `t_g` is not cap-good.

## Main results

* `CupCap.midGenElt_mul_appendBlackPlus_one`: the generator identity.
* `CupCap.MidGen.exists_appendBlackLoading_of_bot`: the generators whose bottom ends in `i`.
* `CupCap.appendBlackPlusOp_one_smul_mem_span_appendIota`: surjectivity at the level of the
  models.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal.CupCap

open KLR KLRAlgebra TypeA Equiv MulOpposite InductionAlong

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} [DecidableEq I] {k : Type} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {Λc : Fin 2 → I →₀ ℕ}
  {j : ℕ} {hj : j ≤ ℓ} (ν : Multiset I) {ν₀ : Multiset I} (i : I)

local notation "νᵢ" => ((Singleton.singleton i : Multiset I) + ν)
local notation "M" => Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "M'" => Multiset.card (stendhalWeight (ℓ + 2) (((Singleton.singleton i :
  Multiset I) + ν) + ν₀))
local notation "Rp" =>
  KLRAlgebra k (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "Ap" => appendPlus Q Λ Λc j hj ν ν₀ i
local notation "aBP" => appendBlackPlus Q Λ Λc j hj ν ν₀ i
local notation "e'" => appendIdemPlus Q Λ Λc j hj ν ν₀ i
local notation "botᵢ" => botMap k Q Λ Λc j hj ((Singleton.singleton i : Multiset I) + ν) ν₀
local notation "σᵢ" => midStendhal j hj Q Λ Λc ((Singleton.singleton i : Multiset I) + ν) ν₀

omit [DecidableEq I] in
/-- The number of strands of `λ⁺` after appending the strand. -/
theorem card_plus_appendBlack : M + 1 = M' := by
  have h := congrArg Multiset.card (plusAddBlack (ℓ := ℓ) ν ν₀ i)
  rw [Multiset.card_add, Multiset.card_singleton] at h
  exact h

/-- Appending the strand to `e(X) ψ_l`. -/
theorem appendPlus_e_mul_ψw {l : List ℕ} (hl : ValidWord M l)
    (X : Seq (stendhalWeight (ℓ + 2) (ν + ν₀))) :
    Ap (KLRAlgebra.e X * ψw l) =
      KLRAlgebra.e (Seq.cast (plusAddBlack ν ν₀ i)
        (X.append (default : Seq (Singleton.singleton (Sum.inl i) :
          Multiset (I ⊕ Fin (ℓ + 2)))))) * ψw l * Ap 1 := by
  rw [← mul_one (ψw l), map_mul, appendPlus_ψw_mul ν i l hl, appendPlus_e, mul_assoc]

/-- The loading at the window of an appended loading of `λ`, for `j < ℓ`. -/
theorem midSeq_appendBlackLoading (h : j < ℓ) (s : Seq (stendhalWeight ℓ ν))
    (t : Seq (stendhalWeight 2 ν₀)) :
    midSeq j hj (appendBlackLoading i ν s) t =
      Seq.cast (plusAddBlack ν ν₀ i) ((midSeq j hj s t).append
        (default : Seq (Singleton.singleton (Sum.inl i) : Multiset (I ⊕ Fin (ℓ + 2))))) := by
  rw [midSeq, midSeq, insertSeq_appendBlackLoading s (midPos j s) (midPos_le j s)
    (by rw [← midPos_appendBlackLoading j ν i h s]; exact midPos_le j _)]
  congr 1
  exact midPos_appendBlackLoading j ν i h s

/-- A generator without dots, for a choice of reduced words `ρ'` with `wordProd (ρ' u) = u`. -/
theorem midGenKLR_of_d_eq_zero {μ : Multiset I}
    {ρ' : Perm (Fin (Multiset.card (stendhalWeight (ℓ + 2) (μ + ν₀)))) → List ℕ}
    (g : MidGen j hj μ ν₀) (hd : g.d = 0)
    (hw : wordProd (Multiset.card (stendhalWeight (ℓ + 2) (μ + ν₀))) (ρ' g.u) = g.u) :
    midGenKLR Q Λ Λc ρ' g = KLRAlgebra.e (midSeq j hj g.s g.t) * ψw (ρ' g.u) := by
  have he : KLRAlgebra.e (midSeq j hj g.s g.t) * ψw (ρ' g.u) =
      (ψw (ρ' g.u) * KLRAlgebra.e g.bot : KLRAlgebra k (stendhalQ Q (plusLabels Λ Λc j hj))
        (stendhalWeight (ℓ + 2) (μ + ν₀))) := by
    rw [e_mul_ψw, hw]
    rfl
  rw [midGenKLR, hd, ← MvPolynomial.C_apply, MvPolynomial.C_1, map_one, map_one, mul_one, he,
    mul_assoc,
    KLRAlgebra.e_mul_self]

/-- **The generator identity** (arXiv:1309.3796v3, §7.3, proof of Proposition 7.21), for
`j < ℓ`: for a generator `g` without dots at `{i} + ν` whose loading of `λ` is the appended
loading `s i` and whose window shuffle is given by a word `l` on the first `M` strands,
`γ_g e'⁺ = e' · appendBlack(e(midSeq s t) ψ_l)`. -/
theorem midGenElt_mul_appendBlackPlus_one (h : j < ℓ) {ρ' : Perm (Fin M') → List ℕ}
    (g : MidGen j hj νᵢ ν₀) (hd : g.d = 0) {s : Seq (stendhalWeight ℓ ν)}
    (hs : g.s = appendBlackLoading i ν s) {l : List ℕ} (hl : ValidWord M l) (hρ : ρ' g.u = l)
    (hw : wordProd M' l = g.u) :
    midGenElt Q Λ Λc ρ' g * aBP 1 =
      e' * botᵢ (Ap (KLRAlgebra.e (midSeq j hj s g.t) * ψw l)) := by
  have hY : Ap (KLRAlgebra.e (midSeq j hj s g.t) * ψw l) = midGenKLR Q Λ Λc ρ' g * Ap 1 := by
    rw [appendPlus_e_mul_ψw ν i hl, midGenKLR_of_d_eq_zero g hd (by rw [hρ]; exact hw), hρ, hs,
      midSeq_appendBlackLoading ν i h]
  have h1 : aBP 1 * botᵢ (Ap (KLRAlgebra.e (midSeq j hj s g.t) * ψw l)) =
      midGenElt Q Λ Λc ρ' g * aBP 1 := by
    rw [appendBlackPlus_one, ← map_mul, appendPlus_one_mul, hY, map_mul, ← appendBlackPlus_one]
    rfl
  rw [← midStendhal_one_mul_appendBlackPlus_one ν i h, mul_assoc, h1, ← mul_assoc,
    midStendhal_one_mul_midGenElt]

/-- The generator identity, with the unit of the appended diagrams at the maximum in front. -/
theorem midGenElt_mul_appendBlackPlus_one' (h : j < ℓ) {ρ' : Perm (Fin M') → List ℕ}
    (g : MidGen j hj νᵢ ν₀) (hd : g.d = 0) {s : Seq (stendhalWeight ℓ ν)}
    (hs : g.s = appendBlackLoading i ν s) {l : List ℕ} (hl : ValidWord M l) (hρ : ρ' g.u = l)
    (hw : wordProd M' l = g.u) :
    midGenElt Q Λ Λc ρ' g * aBP 1 =
      e' * σᵢ 1 * aBP (midStendhal j hj Q Λ Λc ν ν₀ 1 *
        botMap k Q Λ Λc j hj ν ν₀ (KLRAlgebra.e (midSeq j hj s g.t) * ψw l)) * aBP 1 := by
  rw [midGenElt_mul_appendBlackPlus_one ν i h g hd hs hl hρ hw,
    map_mul (appendBlackPlus Q Λ Λc j hj ν ν₀ i), appendBlackPlus_midStendhal_one ν i h,
    appendIdemPlus_mul_midStendhal_one ν i h,
    ← mul_assoc, appendIdemPlus_mul_self ν i h, appendBlackPlus_botMap, mul_assoc,
    appendBlackPlus_one, ← map_mul, ← map_mul, mul_one]

section Model

variable {L : Type} [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]

/-- `ι` on generators, for `j < ℓ`: `ι(w ⊗ v) = e⁺ appendBlack(w) e' σ(1) ⊗ v`. -/
theorem appendIota_tmul (h : j < ℓ) (w : Corner (midOp j hj Q Λ Λc ν ν₀)) (v : L) :
    appendIota ν i L h (Ind.tmul w v) =
      Ind.tmul (cornerMul (intertwines_appendMid_mid ν i h)
        (compMul _ _ (unitGen (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i)) w)) v :=
  rfl

/-- **On a generator whose loading of `λ` is appended**, for `j < ℓ`: `(v γ_g) e'⁺` is `ι` of the
appended generator `v (e(midSeq s t) ψ_l)` at `ν`. -/
theorem appendBlackPlusOp_one_smul_tmul_midGenCorner (h : j < ℓ) {ρ' : Perm (Fin M') → List ℕ}
    (g : MidGen j hj νᵢ ν₀) (hd : g.d = 0) {s : Seq (stendhalWeight ℓ ν)}
    (hs : g.s = appendBlackLoading i ν s) {l : List ℕ} (hl : ValidWord M l) (hρ : ρ' g.u = l)
    (hw : wordProd M' l = g.u) (v : L) :
    appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
        (Ind.tmul (midGenCorner Q Λ Λc ρ' g) v : MidModel j hj Q Λ Λc νᵢ ν₀ L) =
      appendIota ν i L h (Ind.tmul (midGen j hj Q Λ Λc ν ν₀
        (botMap k Q Λ Λc j hj ν ν₀ (KLRAlgebra.e (midSeq j hj s g.t) * ψw l))) v) := by
  rw [Ind.smul_tmul, appendIota_tmul]
  congr 1
  apply Subtype.ext
  apply MulOpposite.unop_injective
  change midGenElt Q Λ Λc ρ' g * aBP 1 = _
  change _ = (appendMidOp Q Λ Λc j hj ν ν₀ i 1).unop *
    (aBP (midStendhal j hj Q Λ Λc ν ν₀ 1 *
      botMap k Q Λ Λc j hj ν ν₀ (KLRAlgebra.e (midSeq j hj s g.t) * ψw l)) * aBP 1)
  rw [appendMidOp_apply ν i h, unop_mul, midOp_apply, unop_op, unop_op, unop_one,
    midGenElt_mul_appendBlackPlus_one' ν i h g hd hs hl hρ hw, mul_assoc]

end Model

/-! ### Generators whose bottom ends in the strand `i` -/

omit [DecidableEq I] in
/-- **A block generator whose bottom ends in the black strand `i`** (arXiv:1309.3796v3, §7.3,
proof of Proposition 7.21), for `j < ℓ` and a cap-good loading at the maximum: its loading of `λ`
is an appended loading and its window shuffle fixes the last strand. -/
theorem MidGen.exists_appendBlackLoading_of_bot (h : j < ℓ) (g : MidGen j hj νᵢ ν₀)
    (hperm : g.perm = 1) (ht : IsCapGood ν₀ g.t) (c : Fin M') (hc : c.val + 1 = M')
    (hb : g.bot.lbl c = .inl i) :
    ∃ s : Seq (stendhalWeight ℓ ν), g.s = appendBlackLoading i ν s ∧ g.u c = c := by
  have hlbl : g.bot.lbl c = (midSeq j hj g.s g.t).lbl (g.u c) := rfl
  have hM := card_plus' (I := I) (ℓ := ℓ) (ν := νᵢ) (ν₀ := ν₀)
  rcases hz : g.shuffle.symm c with b | q
  · have hcb : g.shuffle (.inl b) = c := by rw [← hz, Equiv.apply_symm_apply]
    have hu : g.u c = outPos j ν₀ g.s b := by
      rw [← hcb, MidGen.u_shuffle_inl, hperm]
      rfl
    rw [hlbl, hu, midSeq_lbl_outPos] at hb
    have hsb : g.s.lbl b = .inl i := by
      cases hx : g.s.lbl b with
      | inl x =>
        rw [hx] at hb
        simp only [oldColour, Sum.map_inl, id, Sum.inl.injEq] at hb
        rw [hb]
      | inr r =>
        rw [hx] at hb
        simp [oldColour] at hb
    have hbl : b.val + 1 = Multiset.card (stendhalWeight ℓ νᵢ) := by
      by_contra hne
      have hb2 := b.2
      have hlt : b < ⟨Multiset.card (stendhalWeight ℓ νᵢ) - 1, by omega⟩ := by
        rw [Fin.lt_def]; simp only; omega
      have h1 := g.botOrd.lt_iff_lt.2 hlt
      rw [← MidGen.shuffle_inl, hcb, Fin.lt_def] at h1
      have h2 := (g.botOrd ⟨Multiset.card (stendhalWeight ℓ νᵢ) - 1, by omega⟩).isLt
      omega
    obtain ⟨s, hs⟩ := exists_appendBlackLoading_eq ν i g.s b hbl hsb
    refine ⟨s, hs.symm, Fin.ext ?_⟩
    have hmid := midPos_lt (j := j) (s := g.s) h
    rw [hu, outPos_val]
    split_ifs <;> omega
  · exfalso
    have hcq : g.shuffle (.inr q) = c := by rw [← hz, Equiv.apply_symm_apply]
    have hu : g.u c = winPos (midPos_add_N_le j ν₀ g.s) q := by
      rw [← hcq, MidGen.u_shuffle_inr]
    have hq2 := q.2
    have hq : q.val + 1 = Multiset.card (stendhalWeight 2 ν₀) := by
      by_contra hne
      have hlt : q < ⟨Multiset.card (stendhalWeight 2 ν₀) - 1, by omega⟩ := by
        rw [Fin.lt_def]; simp only; omega
      have h1 := g.hu hlt
      simp only at h1
      rw [← MidGen.shuffle_inr, hcq, Fin.lt_def] at h1
      have h2 := (g.u⁻¹ (winPos (midPos_add_N_le j ν₀ g.s)
        ⟨Multiset.card (stendhalWeight 2 ν₀) - 1, by omega⟩)).isLt
      omega
    rw [hlbl, hu, midSeq_lbl_winPos] at hb
    have hlast : g.t.lbl q = .inr 1 := by
      have := ht.2
      convert this using 2
      exact Fin.ext (by simp only; omega)
    rw [hlast] at hb
    simp [cupColour] at hb

/-- `e(X) e⁺ = 0` when the last strand of `X` is not black of colour `i`. -/
theorem e_mul_appendPlus_one_of_lbl (X : Seq (stendhalWeight (ℓ + 2) (νᵢ + ν₀))) (c : Fin M')
    (hc : c.val + 1 = M') (hX : X.lbl c ≠ .inl i) :
    (KLRAlgebra.e X : KLRAlgebra k (stendhalQ Q (plusLabels Λ Λc j hj))
      (stendhalWeight (ℓ + 2) (νᵢ + ν₀))) * Ap 1 = 0 := by
  rw [← KLRAlgebra.sum_e, map_sum, Finset.mul_sum]
  refine Finset.sum_eq_zero fun w _ => ?_
  rw [appendPlus_e, KLRAlgebra.e_mul_e, ite_eq_right_iff]
  rintro rfl
  exact absurd (lbl_last_cast_append ν i w c hc) hX

/-- `γ_g e'⁺ = 0` when the last strand at the bottom of `g` is not black of colour `i`. -/
theorem midGenElt_mul_appendBlackPlus_one_of_lbl {ρ' : Perm (Fin M') → List ℕ}
    (g : MidGen j hj νᵢ ν₀) (c : Fin M') (hc : c.val + 1 = M') (hb : g.bot.lbl c ≠ .inl i) :
    midGenElt Q Λ Λc ρ' g * aBP 1 = 0 := by
  rw [appendBlackPlus_one, midGenElt, ← map_mul, midGenKLR, mul_assoc,
    e_mul_appendPlus_one_of_lbl ν i _ c hc hb, mul_zero, map_zero]

/-- The reduced word through the last coset of a permutation fixing the last strand. -/
theorem lastCosetWord_extPerm {m m₀ : ℕ} (hm : m₀ + 1 = m) (ρ : Perm (Fin m₀) → List ℕ)
    (v : Perm (Fin m₀)) : lastCosetWord hm ρ (extPerm hm v) = ρ v := by
  have h := lastCosetSplit_eq hm (c := 1) (τ := v) (fun x y hxy => by
    simpa only [Perm.one_apply, blockEquiv_inl_lt_inl] using hxy)
  rw [one_mul] at h
  rw [lastCosetWord, h, canWord_one, List.nil_append]

/-! ### Surjectivity at the level of the models -/

section Surjective

variable {L : Type} [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  [Module k L] [IsScalarTower k (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]

omit [Module k L] [IsScalarTower k (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L] in
theorem appendIota_zero (h : j < ℓ) :
    appendIota ν i L h (0 : MidModel j hj Q Λ Λc ν ν₀ L) = 0 := by
  rw [appendIota, Ind.tmul_zero, map_zero]

/-- The choice of reduced words at `{i} + ν` through the last coset. -/
abbrev appendWords : Perm (Fin M') → List ℕ :=
  lastCosetWord (card_plus_appendBlack (ℓ := ℓ) (ν₀ := ν₀) ν i) (canWord M)

omit [DecidableEq I] in
theorem appendWords_spec (w : Perm (Fin M')) :
    IsReduced M' (appendWords (ℓ := ℓ) (ν₀ := ν₀) ν i w) ∧
      wordProd M' (appendWords (ℓ := ℓ) (ν₀ := ν₀) ν i w) = w :=
  isReducedChoice_lastCosetWord (fun w => ⟨isReduced_canWord _ w, wordProd_canWord _ w⟩) w

/-- **On a block generator**, for `j < ℓ`: `(v γ_g) e'⁺` lies in the image of `ι`, for the
reduced words through the last coset. -/
theorem exists_appendBlackPlusOp_one_smul_tmul_eq (h : j < ℓ)
    (hL : ∀ (w : Seq (stendhalWeight 2 ν₀)) (v : L), ¬ IsCapGood ν₀ w →
      op (cupMap k Q Λc ν₀ (KLRAlgebra.e w)) • v = 0)
    (g : MidBlockShuffle j hj νᵢ ν₀)
    (v : BalancedTensor.idemPart k L (midGenIdem (k := k) Q Λc g.1.1)) :
    ∃ x : MidModel j hj Q Λ Λc ν ν₀ L, appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
        (Ind.tmul (midGenCorner Q Λ Λc (appendWords ν i) g.1.1) (v : L) :
          MidModel j hj Q Λ Λc νᵢ ν₀ L) = appendIota ν i L h x := by
  have hm := card_plus_appendBlack (ℓ := ℓ) (ν₀ := ν₀) ν i
  by_cases htc : IsCapGood ν₀ g.1.1.t
  · by_cases hb : g.1.1.bot.lbl (lastPos hm) = .inl i
    · obtain ⟨s, hs, hu⟩ := MidGen.exists_appendBlackLoading_of_bot ν i h g.1.1 g.2 htc _
        (by simp only [lastPos_val]; exact hm) hb
      obtain ⟨u₀, hu₀⟩ := exists_extPerm_eq hm hu
      exact ⟨_, appendBlackPlusOp_one_smul_tmul_midGenCorner ν i h g.1.1 g.1.2 hs
        (validWord_canWord M u₀) (by rw [← hu₀]; exact lastCosetWord_extPerm hm _ u₀)
        (by rw [wordProd_canWord_ext hm, hu₀]) (v : L)⟩
    · refine ⟨0, ?_⟩
      rw [appendIota_zero, Ind.smul_tmul]
      have h0 : appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
          midGenCorner Q Λ Λc (appendWords ν i) g.1.1 = 0 := by
        apply Subtype.ext
        apply MulOpposite.unop_injective
        change midGenElt Q Λ Λc (appendWords ν i) g.1.1 * aBP 1 = 0
        exact midGenElt_mul_appendBlackPlus_one_of_lbl ν i g.1.1 _
          (by simp only [lastPos_val]; exact hm) hb
      rw [h0, Ind.zero_tmul]
  · have hv : (v : L) = 0 := by
      have hbot := idemPart_eq_bot_of_not_isCapGood L hL g.1.1.t g.1.1.ht htc
      have hx : (v : L) ∈ (⊥ : Submodule k L) := hbot ▸ v.2
      exact (Submodule.mem_bot k).1 hx
    refine ⟨0, ?_⟩
    rw [appendIota_zero, hv, Ind.tmul_zero, smul_zero]

variable {hL : ∀ (w : Seq (stendhalWeight 2 ν₀)) (v : L), ¬ IsCapGood ν₀ w →
  op (cupMap k Q Λc ν₀ (KLRAlgebra.e w)) • v = 0}

omit [DecidableEq I] [Module k L] [IsScalarTower k (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L] in
/-- An element of the model at `{i} + ν`, as an element of the left module. -/
def toMidLeftModel (hR' : MidKLRRel j hj Q Λ Λc νᵢ ν₀ L hL)
    (y : MidModel j hj Q Λ Λc νᵢ ν₀ L) : MidLeftModel L hL hR' :=
  y

/-- **Surjectivity of `T̃^λ_{{i} + ν} e' ⊗ K̃_ν → K̃_{{i} + ν} e'⁺` at the level of the models**
(Webster, arXiv:1309.3796v3, §7.3, proof of Proposition 7.21, the part for `𝔈_i`), for `j < ℓ`:
for every `y` in the model at `{i} + ν`, `y e'⁺` lies in the left `T̃^λ_{{i} + ν}`-span of the
image of `ι`, when the cup scalars are units and `L` satisfies the pull-off identity. -/
theorem appendBlackPlusOp_one_smul_mem_span_appendIota (h : j < ℓ)
    (hR' : MidKLRRel j hj Q Λ Λc νᵢ ν₀ L hL) (hP : PullOff k Q Λc ν₀ L)
    (hκ : ∀ i', IsUnit (cupScalar Q ν₀ i')) (y : MidModel j hj Q Λ Λc νᵢ ν₀ L) :
    toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 • y) ∈
      Submodule.span (StendhalAlgebra k Q Λ νᵢ)
        (Set.range fun x : MidModel j hj Q Λ Λc ν ν₀ L =>
          toMidLeftModel ν i hR' (appendIota ν i L h x)) := by
  classical
  obtain ⟨X, hXy⟩ := midThetaBlock_surjective hR' (appendWords ν i) (appendWords_spec ν i) hP hκ
    (toMidLeftModel ν i hR' y)
  change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
    (toMidLeftModel ν i hR' y : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ _
  rw [← hXy]
  clear hXy
  induction X using DirectSum.induction_on with
  | zero =>
    rw [map_zero]
    change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
      (0 : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ _
    rw [smul_zero]
    exact zero_mem _
  | of g w =>
    induction w using TensorProduct.inductionOn with
    | tmul a v =>
      rw [← DirectSum.lof_eq_of (StendhalAlgebra k Q Λ νᵢ), midThetaBlock_lof, midTheta_of_tmul]
      change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
        midLeftAlg L hL hR' (a : StendhalAlgebra k Q Λ νᵢ)
          (Ind.tmul (midGenCorner Q Λ Λc (appendWords ν i) g.1.1) (v : L))) ∈ _
      rw [← midLeftAlg_smul]
      obtain ⟨x, hx⟩ := exists_appendBlackPlusOp_one_smul_tmul_eq ν i h hL g v
      rw [hx]
      exact Submodule.smul_mem _ (a : StendhalAlgebra k Q Λ νᵢ)
        (Submodule.subset_span ⟨x, rfl⟩)
    | add w w' hw hw' =>
      rw [map_add, map_add]
      change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
        (_ + _ : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ _
      rw [smul_add]
      exact add_mem hw hw'
  | add X X' hX hX' =>
    rw [map_add]
    change toMidLeftModel ν i hR' (appendBlackPlusOp Q Λ Λc j hj ν ν₀ i 1 •
      (_ + _ : MidModel j hj Q Λ Λc νᵢ ν₀ L)) ∈ _
    rw [smul_add]
    exact add_mem hX hX'

end Surjective

end Categorification.Stendhal.CupCap
