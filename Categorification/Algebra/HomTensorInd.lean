import Categorification.Algebra.InductionAlong
import Categorification.Algebra.Generation

/-!
# Additive functors on generated objects as inductions along ring maps

This is the form of `HomTensor.equiv` in which the bimodule `O' ⟶ F O` is the corner of a
nonunital ring map. Let `F : C ⥤ D` be additive, `O : C`, `O' : D`, and let `φ : A →ₙ+* B`
be a nonunital ring map with ring isomorphisms `σ : A ≃+* (End O)ᵐᵒᵖ` and
`τ : B ≃+* (End O')ᵐᵒᵖ`. Let
`O ⟶ X` be an `A`-module through `σ` (`homModule`). An additive isomorphism
`c : B φ(1) ≃+ (O' ⟶ F O)` with `c (z φ(a)) = c z ≫ F (σ a)` gives an isomorphism

`B φ(1) ⊗_A (O ⟶ X) ≃+ (O' ⟶ F X)`,   `z ⊗ f ↦ c z ≫ F f`,

whenever the identity of `X` factors through finitely many copies of `O` (`indEquiv`). It is
semilinear along `τ` when `c` is (`indEquiv_smul`).

This passes from a categorical action on a category generated by one object to induction along
a ring map, the form in which Webster defines the functors `Fᵢ` on modules over the algebras
`T^λ` (arXiv:1309.3796v3, §4.6 and §5).
-/

namespace Categorification.HomTensor

open CategoryTheory MulOpposite InductionAlong

noncomputable section

universe u

variable {C : Type*} [Category C] [Preadditive C] {D : Type*} [Category D] [Preadditive D]
  (F : C ⥤ D) [F.Additive] (O : C) (O' : D)
  {A : Type u} [Ring A] {B : Type u} [Ring B] (φ : A →ₙ+* B)
  (σ : A ≃+* (End O)ᵐᵒᵖ)

/-- `O ⟶ X` as a module over `A` through `σ`: `a • f = σ(a) ≫ f`. -/
@[reducible] def homModule (X : C) : Module A (O ⟶ X) :=
  Module.compHom (O ⟶ X) σ.toRingHom

theorem homModule_smul (X : C) (a : A) (f : O ⟶ X) :
    (homModule O σ X).smul a f = (σ a).unop ≫ f := rfl

variable {F O O' φ σ}
variable (c : Corner φ ≃+ (O' ⟶ F.obj O))
  (hc : ∀ (a : A) (z : Corner φ), c (op a • z) = c z ≫ F.map (σ a).unop)

section

variable (X : C)

omit [F.Additive] in
include hc in
theorem indMap_balanced (z : Corner φ) (a : A) (f : O ⟶ X) :
    c (op a • z) ≫ F.map f = c z ≫ F.map ((σ a).unop ≫ f) := by
  rw [hc, F.map_comp, Category.assoc]

/-- The composition map `B φ(1) ⊗_A (O ⟶ X) → (O' ⟶ F X)`, `z ⊗ f ↦ c z ≫ F f`. -/
def indMap : letI := homModule O σ X; Ind (O ⟶ X) φ →+ (O' ⟶ F.obj X) :=
  letI := homModule O σ X
  Ind.liftAdd (fun z f => c z ≫ F.map f)
    (fun z z' f => by rw [map_add, Preadditive.add_comp])
    (fun z f f' => by rw [F.map_add, Preadditive.comp_add])
    (fun z a f => indMap_balanced c hc X z a f)

theorem indMap_tmul (z : Corner φ) (f : O ⟶ X) :
    letI := homModule O σ X
    indMap c hc X (Ind.tmul z f) = c z ≫ F.map f := rfl

end

variable {X : C} {J : Type*} [Fintype J] (π : J → (X ⟶ O)) (ι : J → (O ⟶ X))

/-- The inverse of the composition map, for `𝟙 X = ∑ⱼ πⱼ ≫ ιⱼ`. -/
def indInv : letI := homModule O σ X; (O' ⟶ F.obj X) →+ Ind (O ⟶ X) φ :=
  letI := homModule O σ X
  { toFun := fun ψ => ∑ j, Ind.tmul (c.symm (ψ ≫ F.map (π j))) (ι j)
    map_zero' := by simp only [Limits.zero_comp, map_zero, Ind.zero_tmul, Finset.sum_const_zero]
    map_add' := fun ψ ψ' => by
      simp only [Preadditive.add_comp, map_add, Ind.add_tmul, Finset.sum_add_distrib] }

variable (h : ∑ j, π j ≫ ι j = 𝟙 X)
include h

theorem indMap_indInv (ψ : O' ⟶ F.obj X) : indMap c hc X (indInv c π ι ψ) = ψ := by
  let _ := homModule O σ X
  change indMap c hc X (∑ j, Ind.tmul (c.symm (ψ ≫ F.map (π j))) (ι j)) = ψ
  rw [map_sum]
  simp only [indMap_tmul, AddEquiv.apply_symm_apply, Category.assoc, ← F.map_comp]
  rw [← Preadditive.comp_sum, ← Functor.map_sum, h, F.map_id, Category.comp_id]

theorem indInv_indMap (t : letI := homModule O σ X; Ind (O ⟶ X) φ) :
    indInv c π ι (indMap c hc X t) = t := by
  let _ := homModule O σ X
  induction t using Ind.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul z f =>
    change ∑ j, Ind.tmul (c.symm ((c z ≫ F.map f) ≫ F.map (π j))) (ι j) = Ind.tmul z f
    have hj : ∀ j, Ind.tmul (N := O ⟶ X) (φ := φ)
        (c.symm ((c z ≫ F.map f) ≫ F.map (π j))) (ι j)
        = Ind.tmul z (f ≫ π j ≫ ι j) := by
      intro j
      have hz : c.symm ((c z ≫ F.map f) ≫ F.map (π j)) =
          op (σ.symm (op (f ≫ π j))) • z := by
        apply c.injective
        rw [AddEquiv.apply_symm_apply, hc, RingEquiv.apply_symm_apply, unop_op, F.map_comp,
          Category.assoc]
      rw [hz, Ind.op_smul_tmul]
      change Ind.tmul z ((σ (σ.symm (op (f ≫ π j)))).unop ≫ ι j) = _
      rw [RingEquiv.apply_symm_apply, unop_op, Category.assoc]
    simp only [hj]
    let m : (O ⟶ X) →+ Ind (O ⟶ X) φ :=
      ⟨⟨Ind.tmul z, Ind.tmul_zero z⟩, Ind.tmul_add z⟩
    change ∑ j, m (f ≫ π j ≫ ι j) = m f
    rw [← map_sum, ← Preadditive.comp_sum, h, Category.comp_id]
  | add s t hs ht => rw [map_add, map_add, hs, ht]

/-- **The composition map is an isomorphism** when the identity of `X` factors through
finitely many copies of `O`: `B φ(1) ⊗_A (O ⟶ X) ≃+ (O' ⟶ F X)`. -/
def indEquiv : letI := homModule O σ X; Ind (O ⟶ X) φ ≃+ (O' ⟶ F.obj X) :=
  letI := homModule O σ X
  { indMap c hc X with
    invFun := indInv c π ι
    left_inv := indInv_indMap c hc π ι h
    right_inv := indMap_indInv c hc π ι h }

theorem indEquiv_tmul (z : Corner φ) (f : O ⟶ X) :
    letI := homModule O σ X
    indEquiv c hc π ι h (Ind.tmul z f) = c z ≫ F.map f := rfl

omit h in
/-- The composition map is semilinear along `τ` when `c` is. -/
theorem indMap_smul (τ : B ≃+* (End O')ᵐᵒᵖ)
    (hτ : ∀ (b : B) (z : Corner φ), c (b • z) = (τ b).unop ≫ c z) (b : B)
    (t : letI := homModule O σ X; Ind (O ⟶ X) φ) :
    indMap c hc X (b • t) = (τ b).unop ≫ indMap c hc X t := by
  let _ := homModule O σ X
  induction t using Ind.induction_on with
  | zero => rw [smul_zero, map_zero, Limits.comp_zero]
  | tmul z f => rw [Ind.smul_tmul, indMap_tmul, indMap_tmul, hτ, Category.assoc]
  | add s t hs ht => rw [smul_add, map_add, map_add, hs, ht, Preadditive.comp_add]

theorem indEquiv_smul (τ : B ≃+* (End O')ᵐᵒᵖ)
    (hτ : ∀ (b : B) (z : Corner φ), c (b • z) = (τ b).unop ≫ c z) (b : B)
    (t : letI := homModule O σ X; Ind (O ⟶ X) φ) :
    indEquiv c hc π ι h (b • t) = (τ b).unop ≫ indEquiv c hc π ι h t :=
  indMap_smul c hc τ hτ b t

end

end Categorification.HomTensor
