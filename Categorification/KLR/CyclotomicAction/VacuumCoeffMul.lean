import Categorification.KLR.CyclotomicAction.VacuumCyclic
import Categorification.KLR.CyclotomicAction.VacuumEval

/-!
# Vacuum entries of a product of upward matrices

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2, proof of
Proposition 3.25. Over a cyclic vacuum, every element of a word module is its coordinate times
the generator of the word (`eq_wcoord_smul_wgen`). Hence the vacuum entries of a composite of
matrices of upward 2-morphisms are the products of the entries
(`vacCoeff_mul`): `vacCoeff (φ * ψ) t s = ∑ j, vacCoeff ψ t j * vacCoeff φ j s`.
-/

namespace Categorification.KLR.CyclotomicAction

open CategoryTheory TwoRep KLRAlgebra

universe u v w u₁

noncomputable section

section Generic

variable {I : Type u} [DecidableEq I] {k : Type v} [CommRing k]
  {Q : I → I → MvPolynomial (Fin 2) k} {a : I → Polynomial k}
  (hQ : KLRSymm Q)
  (hlead : ∀ j l, j ≠ l → ∃ c : k, IsUnit c ∧ (polyInY (Q j l)).leadingCoeff = Polynomial.C c)
  (ha : ∀ j, (a j).Monic)
  {C : QuantumGroup.CartanDatum I} {X Y : Type u₁} [AddCommGroup X] [AddCommGroup Y]
  {RD : QuantumGroup.UDot.WeightDatum C X Y} {Λ : X}
  (hΛ : ∀ i, ((a i).natDegree : ℤ) = RD.pair (RD.iY i) Λ)
  (hdeg : ∀ i j, j ≠ i → ((polyInY (Q j i)).natDegree : ℤ) = -RD.pair (RD.iY i) (RD.iX j))
  {μ : X} (V : weightSpace.{u, v, w} Q a RD Λ μ) (h0 : blockWeight RD Λ 0 = μ)
  (v₀ : V ⟨0, h0⟩) {Ψ₀ : V ⟨0, h0⟩ →ₗ[CycKLR k Q a 0] CycKLR k Q a 0} {ν : Multiset I}

/-- **Over a cyclic vacuum, an element of a word module is its coordinate times the generator.** -/
theorem eq_wcoord_smul_wgen (hv : ∀ x : V ⟨0, h0⟩, ∃ z : CycKLR k Q a 0, x = z • v₀)
    (hΨ₀ : Ψ₀ v₀ = 1) (t : Seq ν)
    (x : ((RouqData.wordCell (cyclotomicFamily.{u, v, w} hQ hlead ha RD Λ hΛ hdeg).toRouqData
      μ t).obj.obj (familyObj hQ hlead ha hΛ hdeg V) (topBlk h0) : Type _)) :
    x = wcoord hQ hlead ha hΛ hdeg V h0 Ψ₀ t x • wgen hQ hlead ha hΛ hdeg V h0 v₀ t := by
  obtain ⟨z, hz⟩ := exists_eq_mul_e_smul_vgen hQ hlead ha hΛ hdeg V h0 v₀ hv _ _
    (wValid_wordL μ t) _ (topBlk_eq h0 t) x
  rw [wseq_wordL] at hz
  change x = (z * CycKLR.mk k Q a _ (e t.rev)) • wgen hQ hlead ha hΛ hdeg V h0 v₀ t at hz
  conv_rhs => rw [hz]
  rw [hz, map_smul, wcoord_wgen hQ hlead ha hΛ hdeg V h0 v₀ hΨ₀, smul_eq_mul, mul_assoc,
    ← map_mul, e_mul_self]

/-- The coordinate of an element of the word module of `t` over a cyclic vacuum is fixed on the
right by the idempotent of the reversed word. -/
theorem wcoord_eq_mul_e (hv : ∀ x : V ⟨0, h0⟩, ∃ z : CycKLR k Q a 0, x = z • v₀)
    (hΨ₀ : Ψ₀ v₀ = 1) (t : Seq ν)
    (x : ((RouqData.wordCell (cyclotomicFamily.{u, v, w} hQ hlead ha RD Λ hΛ hdeg).toRouqData
      μ t).obj.obj (familyObj hQ hlead ha hΛ hdeg V) (topBlk h0) : Type _)) :
    wcoord hQ hlead ha hΛ hdeg V h0 Ψ₀ t x =
      wcoord hQ hlead ha hΛ hdeg V h0 Ψ₀ t x * CycKLR.mk k Q a _ (e t.rev) := by
  conv_lhs => rw [eq_wcoord_smul_wgen hQ hlead ha hΛ hdeg V h0 v₀ hv hΨ₀ t x]
  rw [map_smul, wcoord_wgen hQ hlead ha hΛ hdeg V h0 v₀ hΨ₀, smul_eq_mul]

end Generic

section Universal

open QuantumGroup StringDiagrams Diagrams.BicatInterp KL3.Diagram

variable {I : Type u} [DecidableEq I] {k : Type v} [CommRing k] [Nontrivial k] {lam : I → ℕ}
  {C : CartanDatum I} {Q : I → I → MvPolynomial (Fin 2) k} (hQ : IsRouquierQ C Q)
  {X Y : Type u₁} [AddCommGroup X] [AddCommGroup Y] (RD : UDot.WeightDatum C X Y) (Λ : X)
  (hΛ : ∀ i, (lam i : ℤ) = RD.pair (RD.iY i) Λ)

attribute [local instance] ScalarRestriction.linearCatHom ScalarRestriction.precompLinear
  ScalarRestriction.postcompLinear

omit [Nontrivial k] in
/-- The vacuum `P_∅` is generated by `univVacGen`. -/
theorem univVac_cyclic (x : emptyBlockObj.{u, max u v, w} (cycQ k lam Q) (univCycPoly k lam) RD Λ
    ⟨0, rfl⟩) :
    ∃ z : CycKLR (UnivCycRing k lam) (cycQ k lam Q) (univCycPoly k lam) 0,
      x = z • univVacGen.{u, v, w} (Q := Q) (lam := lam) RD Λ := by
  refine ⟨(x ⟨rfl⟩).down, funext fun p => ?_⟩
  obtain rfl : p = ⟨rfl⟩ := Subsingleton.elim _ _
  exact ULift.ext _ _ (mul_one _).symm

/-- **Vacuum entries of a product**: the vacuum entries of `φ * ψ` (first `ψ`, then `φ`) are the
products of the entries of `ψ` and `φ`. -/
theorem vacCoeff_mul (ν : Multiset I)
    (φ ψ : KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t))))) (t s : KLR.Seq ν) :
    vacCoeff.{u, v, w} hQ RD Λ hΛ ν (φ * ψ) t s =
      ∑ j, vacCoeff.{u, v, w} hQ RD Λ hΛ ν ψ t j * vacCoeff.{u, v, w} hQ RD Λ hΛ ν φ j s := by
  unfold vacCoeff
  rw [map_mul, KLR.Diagram.MatEnd.mul_apply]
  erw [sum_app_apply, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  erw [comp_app_apply]
  conv_lhs => rw [eq_wcoord_smul_wgen _ _ _ _ _ _ rfl (univVacGen RD Λ) (univVac_cyclic RD Λ)
    (univVacCoord_univVacGen RD Λ) j (((((univFamily hQ RD Λ hΛ).upActP (univScalars hQ RD)
      (CL.presCL RD k (univScalars hQ RD)) (univPres_rel hQ RD Λ hΛ) (vacWt RD Λ) ν ψ) t
        j).hom.app (familyObj _ _ _ _ _ _) (topBlk rfl)).hom
      (wgen _ _ _ _ _ _ rfl (univVacGen RD Λ) t))]
  erw [map_smul, map_smul, smul_eq_mul]

/-- The vacuum entries of a sum of matrices. -/
theorem vacCoeff_add (ν : Multiset I)
    (φ ψ : KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t))))) (t s : KLR.Seq ν) :
    vacCoeff.{u, v, w} hQ RD Λ hΛ ν (φ + ψ) t s =
      vacCoeff.{u, v, w} hQ RD Λ hΛ ν φ t s + vacCoeff.{u, v, w} hQ RD Λ hΛ ν ψ t s := by
  unfold vacCoeff
  rw [map_add, KLR.Diagram.MatEnd.add_apply]
  erw [add_app_apply, map_add]

/-- A vacuum entry `(t, s)` is fixed on the right by the idempotent of the reversed word of `s`. -/
theorem vacCoeff_eq_mul_e (ν : Multiset I)
    (φ : KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t))))) (t s : KLR.Seq ν) :
    vacCoeff.{u, v, w} hQ RD Λ hΛ ν φ t s =
      vacCoeff.{u, v, w} hQ RD Λ hΛ ν φ t s *
        CycKLR.mk (UnivCycRing k lam) (cycQ k lam Q) (univCycPoly k lam) ν (e s.rev) :=
  wcoord_eq_mul_e _ _ _ _ _ _ rfl (univVacGen RD Λ) (univVac_cyclic RD Λ)
    (univVacCoord_univVacGen RD Λ) s _

/-- A vacuum entry `(t, s)` is fixed on the left by the idempotent of the reversed word of `t`. -/
theorem vacCoeff_eq_e_mul (ν : Multiset I)
    (φ : KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t))))) (t s : KLR.Seq ν) :
    vacCoeff.{u, v, w} hQ RD Λ hΛ ν φ t s =
      CycKLR.mk (UnivCycRing k lam) (cycQ k lam Q) (univCycPoly k lam) ν (e t.rev) *
        vacCoeff.{u, v, w} hQ RD Λ hΛ ν φ t s := by
  unfold vacCoeff
  conv_lhs => rw [← e_smul_wgen]
  erw [map_smul, map_smul, smul_eq_mul]

/-- **The comparison map at the vacuum** (Webster, arXiv:1309.3796v2, proof of Prop. 3.25): the
sum of all vacuum entries of a matrix of upward 2-morphisms, an element of `Ř^λ(ν)`. -/
def vacSum (ν : Multiset I)
    (φ : KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t))))) :
    CycKLR (UnivCycRing k lam) (cycQ k lam Q) (univCycPoly k lam) ν :=
  ∑ t, ∑ s, vacCoeff.{u, v, w} hQ RD Λ hΛ ν φ t s

theorem vacSum_add (ν : Multiset I)
    (φ ψ : KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t))))) :
    vacSum.{u, v, w} hQ RD Λ hΛ ν (φ + ψ) =
      vacSum.{u, v, w} hQ RD Λ hΛ ν φ + vacSum.{u, v, w} hQ RD Λ hΛ ν ψ := by
  simp only [vacSum, vacCoeff_add, Finset.sum_add_distrib]

/-- **The comparison map reverses products**: `vacSum (φ * ψ) = vacSum ψ * vacSum φ`. -/
theorem vacSum_mul (ν : Multiset I)
    (φ ψ : KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t))))) :
    vacSum.{u, v, w} hQ RD Λ hΛ ν (φ * ψ) =
      vacSum.{u, v, w} hQ RD Λ hΛ ν ψ * vacSum.{u, v, w} hQ RD Λ hΛ ν φ := by
  have h0 : ∀ t j j' s, j ≠ j' → vacCoeff.{u, v, w} hQ RD Λ hΛ ν ψ t j *
      vacCoeff.{u, v, w} hQ RD Λ hΛ ν φ j' s = 0 := by
    intro t j j' s hj
    rw [vacCoeff_eq_mul_e hQ RD Λ hΛ ν ψ t j, vacCoeff_eq_e_mul hQ RD Λ hΛ ν φ j' s, mul_assoc,
      ← mul_assoc (CycKLR.mk _ _ _ _ (e j.rev)), ← map_mul, e_mul_e,
      ite_eq_right_iff.mpr (fun h => absurd (Seq.rev_injective h) hj), map_zero, zero_mul, mul_zero]
  simp only [vacSum, vacCoeff_mul]
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [Finset.sum_mul]
  refine Finset.sum_comm.trans (Finset.sum_congr rfl fun j _ => ?_)
  refine (Finset.mul_sum _ _ _).symm.trans ?_
  refine Eq.trans ?_ (Finset.mul_sum _ _ _).symm
  symm
  refine Finset.sum_eq_single_of_mem j (Finset.mem_univ j) (fun j' _ hj' => ?_)
  rw [Finset.mul_sum]
  exact Finset.sum_eq_zero fun s _ => h0 t j j' s (Ne.symm hj')

/-- **The comparison map on upward KLR diagrams**: `vacSum (vacUpHom r)` is the class of
`hflip (σ r)` in `Ř^λ(ν)`, for the image of `r` in the KLR algebra over `Ř^λ_λ`. -/
theorem vacSum_vacUpHom (ν : Multiset I) (r : KLRAlgebra k (KL3.Diagram.CL.qCL
    (univScalars hQ RD)) ν) :
    vacSum.{u, v, w} hQ RD Λ hΛ ν (vacUpHom hQ RD Λ ν r) =
      CycKLR.mk _ (cycQ k lam Q) (univCycPoly k lam) ν
        (hflip (sigma hQ.cycQ.klrSymm (vacKLRMap hQ RD ν r))) := by
  have hR : vacKLRMap hQ RD ν r =
      ∑ t, ∑ s, (e s * vacKLRMap hQ RD ν r * e t :
        KLRAlgebra (UnivCycRing k lam) (cycQ k lam Q) ν) := by
    simp only [← Finset.sum_mul, ← Finset.mul_sum, sum_e, one_mul, mul_one]
  conv_rhs => rw [hR]
  simp only [vacSum, vacCoeff_vacUpHom, map_sum, hflip_sum]

theorem vacSum_one (ν : Multiset I) :
    vacSum.{u, v, w} hQ RD Λ hΛ ν 1 = 1 := by
  rw [← map_one (vacUpHom hQ RD Λ ν), vacSum_vacUpHom, map_one, map_one, hflip_one, map_one]

theorem vacSum_zero (ν : Multiset I) :
    vacSum.{u, v, w} hQ RD Λ hΛ ν 0 = 0 := by
  have h := vacSum_add hQ RD Λ hΛ ν 0 0
  rw [add_zero] at h
  simpa using h

/-- **The comparison map as a ring homomorphism** into the opposite of `Ř^λ(ν)`: the vacuum
entries reverse products (`vacSum_mul`). -/
def vacRingHom (ν : Multiset I) :
    KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t)))) →+*
      (CycKLR (UnivCycRing k lam) (cycQ k lam Q) (univCycPoly k lam) ν)ᵐᵒᵖ where
  toFun φ := MulOpposite.op (vacSum.{u, v, w} hQ RD Λ hΛ ν φ)
  map_one' := by rw [vacSum_one]; rfl
  map_mul' φ ψ := by rw [vacSum_mul, MulOpposite.op_mul]
  map_zero' := by rw [vacSum_zero]; rfl
  map_add' φ ψ := by rw [vacSum_add, MulOpposite.op_add]

theorem vacRingHom_apply (ν : Multiset I)
    (φ : KLR.Diagram.MatEnd (fun t : KLR.Seq ν =>
      (CL.presCL RD k (univScalars hQ RD)).obj
        (ob RD (vacWt RD Λ) (ups (KLR.Diagram.word t))))) :
    vacRingHom.{u, v, w} hQ RD Λ hΛ ν φ = MulOpposite.op (vacSum.{u, v, w} hQ RD Λ hΛ ν φ) := rfl

end Universal

end

end Categorification.KLR.CyclotomicAction
