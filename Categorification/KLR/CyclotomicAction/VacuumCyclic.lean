import Categorification.KLR.CyclotomicAction.Vacuum

/-!
# Words applied to a cyclic vacuum are cyclic

Webster, arXiv:1309.3796v3, §4.6, proof of Lemma 4.29. In the cyclotomic Rouquier family
(Kang–Kashiwara, arXiv:1102.4677v4, §4.2), a word applied to a vacuum generated by one vector
`v₀` is generated, as an `R^Λ(δ)`-module, by the generator `vgen` of the word: induction of a
cyclic module is cyclic (`InductionAlong.Ind.exists_eq_smul_tmul_unitGen`), and each block sum
of the word has a single summand. Since `vgen` is fixed by the idempotent of the reversed
word (`e_smul_vgen`), every element of the word module is fixed by it
(`e_smul_eq_of_mem_word`).
-/

namespace Categorification

namespace InductionAlong

open MulOpposite

universe u w

variable {A B : Type u} [Ring A] [Ring B] {φ : A →ₙ+* B} {N : Type w} [AddCommGroup N]
  [Module A N]

/-- **Induction of a cyclic module is cyclic**: if `N = A n₀`, then `Ind N` is generated by
`φ(1) ⊗ n₀`. -/
theorem Ind.exists_eq_smul_tmul_unitGen {n₀ : N} (hn : ∀ n : N, ∃ c : A, n = c • n₀)
    (t : Ind N φ) : ∃ b : B, t = b • Ind.tmul (unitGen φ) n₀ := by
  induction t using Ind.induction_on with
  | zero => exact ⟨0, (zero_smul _ _).symm⟩
  | tmul z n =>
    obtain ⟨c, rfl⟩ := hn n
    refine ⟨z.1 * φ c, ?_⟩
    rw [← Ind.op_smul_tmul, Ind.smul_tmul]
    congr 1
    exact Subtype.ext (by
      change z.1 * φ c = z.1 * φ c * φ 1
      rw [mul_assoc, ← map_mul, mul_one])
  | add s t hs ht =>
    obtain ⟨b, rfl⟩ := hs
    obtain ⟨b', rfl⟩ := ht
    exact ⟨b + b', (add_smul _ _ _).symm⟩

/-- **Induction kills a module generated through a vanishing element**: if every element of
`N` is `(c e) • n₀` and `φ e = 0`, then `Ind N φ = 0`. -/
theorem Ind.eq_zero_of_forall_eq_mul_smul {n₀ : N} {e : A} (he : φ e = 0)
    (hn : ∀ n : N, ∃ c : A, n = (c * e) • n₀) (t : Ind N φ) : t = 0 := by
  induction t using Ind.induction_on with
  | zero => rfl
  | tmul z n =>
    obtain ⟨c, rfl⟩ := hn n
    rw [← Ind.op_smul_tmul]
    have hz : MulOpposite.op (c * e) • z = 0 :=
      Subtype.ext (by
        change z.1 * φ (c * e) = 0
        rw [map_mul, he, mul_zero, mul_zero])
    rw [hz]
    exact Ind.zero_tmul _
  | add s t hs ht => rw [hs, ht, add_zero]

end InductionAlong

namespace KLR.CyclotomicAction

open CategoryTheory CategoryTheory.Limits TwoRep KLRAlgebra

universe u v w u₁

noncomputable section

variable {I : Type u} [DecidableEq I] {k : Type v} [CommRing k]
  {Q : I → I → MvPolynomial (Fin 2) k} {a : I → Polynomial k}
  (hQ : KLRSymm Q)
  (hlead : ∀ j l, j ≠ l → ∃ c : k, IsUnit c ∧ (polyInY (Q j l)).leadingCoeff = Polynomial.C c)
  (ha : ∀ j, (a j).Monic)
  {C : QuantumGroup.CartanDatum I} {X Y : Type u₁} [AddCommGroup X] [AddCommGroup Y]
  {RD : QuantumGroup.UDot.WeightDatum C X Y} {Λ : X}
  (hΛ : ∀ i, ((a i).natDegree : ℤ) = RD.pair (RD.iY i) Λ)
  (hdeg : ∀ i j, j ≠ i → ((polyInY (Q j i)).natDegree : ℤ) = -RD.pair (RD.iY i) (RD.iX j))

set_option quotPrecheck false in
set_option hygiene false in
local notation "S" => cyclotomicFamily.{u, v, w} hQ hlead ha RD Λ hΛ hdeg

variable {μ : X} (V : weightSpace.{u, v, w} Q a RD Λ μ) (h0 : blockWeight RD Λ 0 = μ)
  (v₀ : V ⟨0, h0⟩)

/-- **Words applied to a cyclic vacuum are cyclic.** If the vacuum is generated by `v₀`, every
element of a word applied to it is a multiple of the generator `vgen` of the word. -/
theorem exists_eq_smul_vgen (hv : ∀ x : V ⟨0, h0⟩, ∃ z : CycKLR k Q a 0, x = z • v₀) :
    ∀ (L : List (I × X)) (μ' : X) (h : wValid RD μ L μ') (δ : WeightBlocks RD Λ μ')
      (hδ : δ.1 = ↑(L.map Prod.fst))
      (x : ((RouqData.wcell (S).toRouqData μ L μ' h).obj.obj V δ : Type _)),
      ∃ z : CycKLR k Q a δ.1, x = z • vgen hQ hlead ha hΛ hdeg V h0 v₀ L μ' h δ hδ
  | [], μ', h, δ, hδ, x => by
    subst h
    obtain ⟨δ, hw⟩ := δ
    simp only [List.map_nil, Multiset.coe_nil] at hδ
    subst hδ
    exact hv x
  | (c, ν) :: L, μ', h, δ, hδ, x => by
    let p : {β : WeightBlocks RD Λ ν // blockSucc RD Λ c h.2 β = δ} :=
      ⟨wblk h0 L ν h.1, blockSucc_wblk h0 c ν L h hδ⟩
    let e := blockιIso (blockSucc RD Λ c h.2) (indBlock Q a RD Λ c h.2)
      ((RouqData.wcell (S).toRouqData μ L ν h.1).obj.obj V) p (fun q => Subsingleton.elim q p)
    obtain ⟨b, hb⟩ := InductionAlong.Ind.exists_eq_smul_tmul_unitGen
      (exists_eq_smul_vgen hv L ν h.1 (wblk h0 L ν h.1) rfl) (e.inv.hom x)
    refine ⟨b, ?_⟩
    have hx : x = e.hom.hom (e.inv.hom x) :=
      (congrArg (fun f => ModuleCat.Hom.hom f x) e.inv_hom_id).symm
    rw [hx, hb]
    exact LinearMap.map_smul e.hom.hom b _

/-- **Every element of a word applied to a cyclic vacuum factors through the idempotent of the
reversed word**: it is `z e(rev L)` times the generator. -/
theorem exists_eq_mul_e_smul_vgen (hv : ∀ x : V ⟨0, h0⟩, ∃ z : CycKLR k Q a 0, x = z • v₀)
    (L : List (I × X)) (μ' : X) (h : wValid RD μ L μ') (δ : WeightBlocks RD Λ μ')
    (hδ : δ.1 = ↑(L.map Prod.fst))
    (x : ((RouqData.wcell (S).toRouqData μ L μ' h).obj.obj V δ : Type _)) :
    ∃ z : CycKLR k Q a δ.1,
      x = (z * CycKLR.mk k Q a δ.1 (e (wseq L hδ))) • vgen hQ hlead ha hΛ hdeg V h0 v₀ L μ' h δ hδ := by
  obtain ⟨z, rfl⟩ := exists_eq_smul_vgen hQ hlead ha hΛ hdeg V h0 v₀ hv L μ' h δ hδ x
  exact ⟨z, by rw [mul_smul, e_smul_vgen]⟩

/-- **A word module over a cyclic vacuum vanishes after scalar extension** along a
homomorphism killing the idempotent of the reversed word. -/
theorem ind_word_eq_zero (hv : ∀ x : V ⟨0, h0⟩, ∃ z : CycKLR k Q a 0, x = z • v₀)
    (L : List (I × X)) (μ' : X) (h : wValid RD μ L μ') (δ : WeightBlocks RD Λ μ')
    (hδ : δ.1 = ↑(L.map Prod.fst)) {B : Type _} [Ring B] (φ : CycKLR k Q a δ.1 →ₙ+* B)
    (he : φ (CycKLR.mk k Q a δ.1 (e (wseq L hδ))) = 0)
    (t : InductionAlong.Ind ((RouqData.wcell (S).toRouqData μ L μ' h).obj.obj V δ : Type _) φ) :
    t = 0 :=
  InductionAlong.Ind.eq_zero_of_forall_eq_mul_smul he
    (exists_eq_mul_e_smul_vgen hQ hlead ha hΛ hdeg V h0 v₀ hv L μ' h δ hδ) t

end

end KLR.CyclotomicAction

end Categorification
