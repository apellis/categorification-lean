import Categorification.Algebra.Graded.RightTwist
import Categorification.WeightedKLR.RedStrands.BoundaryHomReflection

/-!
# Horizontal reflection and right projectives

Webster, arXiv:1309.3796v2, §4.7, Lemma 4.35.
Horizontal reflection takes the left sequence projective to the right
sequence projective and preserves graded direct-sum decompositions.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR Categorification.Graded MulOpposite
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I k : Type*} [DecidableEq I] [Field k] {ℓ : ℕ} {ν : Multiset I}
    {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ}

local notation "μ" => stendhalWeight ℓ ν
local notation "S" => stendhalQ Q Λ

/-- The graded right ideal generated by the sequence idempotent. -/
def rightSequenceProj (G : GradingDatum S) (s : Seq μ) (hs : IsRedOrdered s) :
    GProj (oppositeGrade (tensorProductGrade G ν)) :=
  GProj.ofIdempotent (op (TensorProductAlgebra.mk Q Λ ν (StendhalAlgebra.e s hs)))
    (congrArg op (isIdempotentElem_mk_e s hs))
    (show _ ∈ oppositeGrade (tensorProductGrade G ν) 0 from mk_e_mem_tensorProductGrade G ν s hs)

/-- In Webster, arXiv:1309.3796v2, §4.7, the downward boundary projective is the
right sequence ideal. Horizontal reflection sends the left sequence ideal to it. -/
def sequenceProj_rightEquiv (G : GradingDatum S)
    (hsymm : ∀ a b, G.degΨ a b = G.degΨ b a) (s : Seq μ) (hs : IsRedOrdered s) :
    ((sequenceProj (Q := Q) G s hs).rightTwist (tensorReflection G hsymm)).Iso
      (rightSequenceProj G s hs) :=
  GProj.rightTwistIdempotentIso (tensorReflection G hsymm) (isIdempotentElem_mk_e s hs)
    (mk_e_mem_tensorProductGrade G ν s hs) (tensorReflection_e G hsymm s hs)

end Categorification.Stendhal
