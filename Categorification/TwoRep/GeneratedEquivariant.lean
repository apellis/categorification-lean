/-- **Uniqueness of strongly equivariant functors** out of a module category whose images of
`P₀` are dense and full: an isomorphism `β(P₀) ≅ β'(P₀)` extends to an isomorphism `β ≅ β'`. -/
noncomputable def strongTransIso : β ≅ β' :=
  Pseudofunctor.StrongTrans.isoMk (isoAt hF hD e₀) (fun h => isoAt_naturality hF hD e₀ h)

/-- The categorical bookkeeping behind `strongTransIso_hom_app`. -/
theorem strongTransIso_aux {C D : Type*} [Category C] [Category D]
    (Bd B'd : C ⥤ D) {Z X : C} (m : Z ≅ X) (tX : Bd.obj X ⟶ B'd.obj X)
    (tZ : Bd.obj Z ⟶ B'd.obj Z) (nat : Bd.map m.hom ≫ tX = tZ ≫ B'd.map m.hom)
    {P P' : D} (p : Bd.obj Z ≅ P) (q : P ⟶ P') (p' : B'd.obj Z ≅ P')
    (htZ : tZ = p.hom ≫ q ≫ p'.inv) (cc : P ≅ Bd.obj X) (cc' : P' ≅ B'd.obj X)
    (e : Bd.obj X ⟶ B'd.obj X) (hq : q ≫ cc'.hom = cc.hom ≫ e)
    (Nβ : p.hom ≫ cc.hom = Bd.map m.hom ≫ 𝟙 _ ≫ 𝟙 _)
    (Nβ' : p'.hom ≫ cc'.hom = B'd.map m.hom ≫ 𝟙 _ ≫ 𝟙 _) : tX = e := by
  simp only [Category.comp_id] at Nβ Nβ'
  have hX : tX = Bd.map m.inv ≫ tZ ≫ B'd.map m.hom := by
    rw [← nat, ← Category.assoc, ← Functor.map_comp, Iso.inv_hom_id,
      CategoryTheory.Functor.map_id, Category.id_comp]
  have h1 : p'.inv ≫ B'd.map m.hom = cc'.hom := by rw [Iso.inv_comp_eq, Nβ']
  have h2 : cc.hom = p.inv ≫ Bd.map m.hom := by rw [Iso.eq_inv_comp, Nβ]
  rw [hX, htZ]
  simp only [Category.assoc]
  rw [h1, hq, h2, ← Category.assoc p.hom, Iso.hom_inv_id_assoc, ← Category.assoc,
    ← Functor.map_comp, Iso.inv_hom_id, CategoryTheory.Functor.map_id, Category.id_comp]

theorem strongTransIso_hom_app :
    ((strongTransIso hF hD e₀).hom.as.app a).hom.app P₀ = e₀.hom := by
  change (isoAt hF hD e₀ a).hom.hom.app P₀ = e₀.hom
  have nat := (isoAt hF hD e₀ a).hom.hom.naturality (idApp ℵ₁ a P₀).hom
  have Nβ : (natApp β (𝟙 a) P₀).hom ≫ (idApp ℵ₂ a ((β.app a).obj.obj P₀)).hom =
      (β.app a).obj.map (idApp ℵ₁ a P₀).hom ≫ 𝟙 _ ≫ 𝟙 _ :=
    congrArg (fun θ => θ.hom.app P₀) (β.naturality_id a)
  have Nβ' : (natApp β' (𝟙 a) P₀).hom ≫ (idApp ℵ₂ a ((β'.app a).obj.obj P₀)).hom =
      (β'.app a).obj.map (idApp ℵ₁ a P₀).hom ≫ 𝟙 _ ≫ 𝟙 _ :=
    congrArg (fun θ => θ.hom.app P₀) (β'.naturality_id a)
  have hq : (ℵ₂.map (𝟙 a)).obj.map e₀.hom ≫ (idApp ℵ₂ a ((β'.app a).obj.obj P₀)).hom =
      (idApp ℵ₂ a ((β.app a).obj.obj P₀)).hom ≫ e₀.hom :=
    (ℵ₂.mapId a).hom.hom.naturality e₀.hom
  exact strongTransIso_aux (β.app a).obj (β'.app a).obj (idApp ℵ₁ a P₀) _ _ nat
    (natApp β (𝟙 a) P₀) _ (natApp β' (𝟙 a) P₀) (isoAt_hom_app hF hD e₀ (𝟙 a)) _ _ _ hq Nβ Nβ'

