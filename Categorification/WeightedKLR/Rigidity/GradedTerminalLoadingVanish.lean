import Categorification.WeightedKLR.Rigidity.GradedTerminalStandardResolution
import Categorification.Algebra.DiagramWeightLoadingVanish

/-!
# Loading support for the fundamental terminal standard

This is an instance of the higher-loading vanishing argument of Webster,
arXiv:1309.3796v2, Lemma 6.11, on the actual two-term graded resolution of
the terminal standard. The terminal character kills the strictly higher
middle loading.
-/

noncomputable section
namespace Categorification.Stendhal.FundamentalCorner

open CategoryTheory DG CatModule MulOpposite StendhalAlgebraAllOrders
open scoped DG.DegreeZero CatModule
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification
local notation "T" => TensorProductAlgebra ℚ Q wt ({()} : Multiset Unit)
local notation "𝒜" => tensorProductGrade grading ({()} : Multiset Unit)
local instance instTerminalLoadingInternalGrading : InternalGrading Tᵐᵒᵖ := gradedAlgebraInternalGrading (Graded.oppositeGrade 𝒜)
local instance instTerminalLoadingBigradedRing : BigradedDGRing Tᵐᵒᵖ := gradedAlgebraBigradedDGRing (Graded.oppositeGrade 𝒜)

private theorem middleOrdered : IsRedOrdered middle := by unfold IsRedOrdered; decide +kernel

/-- Every negative term of the terminal-standard resolution is generated by
transport from the middle loading idempotent. -/
theorem gradedTerminalStandardResolution_loading_support (Z : WeightCategory Tᵐᵒᵖ)
    {n : ℤ} (hn : n < 0) (x : gradedTerminalStandardResolution.obj Z) (hx : x ∈ DG.grading n) :
    x ∈ AddSubgroup.closure (diagramWeightLoadingGenerators gradedTerminalStandardResolution
      (fun W (_ : Unit) => (gradedLoadingIdempotentAt middle middleOrdered W.as).val) Z) := by
  obtain ⟨y, rfl, _⟩ := gradedTerminalStandardResolution_negative_component Z hn x hx
  let e := gradedLoadingIdempotentAt middle middleOrdered 1
  let g := shift.mk 1 (cornerGen e)
  have hgen := (isCornerGenerator_corner e).shift 1
  obtain ⟨a, ha⟩ := hgen.surjective Z (shift.mk 1 y)
  refine AddSubgroup.subset_closure ⟨⟨1⟩, (), a, (g, 0), ?_⟩
  apply Prod.ext
  · change shift.mk 1 y = (shift 1 (corner e)).act a ((shift 1 (corner e)).act e.val g)
    have hg : (shift 1 (corner e)).act e.val g = g := hgen.val_smul
    rw [hg]
    exact ha.symm
  · change 0 = (shiftedLoadingModule terminal terminal_ordered 0).act a
      ((shiftedLoadingModule terminal terminal_ordered 0).act e.val 0)
    rw [map_zero, map_zero]


local instance instTerminalLoadingScalarInternalGrading : InternalGrading ℚ := scalarInternalGrading ℚ
local instance instTerminalLoadingScalarBigradedRing : BigradedDGRing ℚ := scalarBigradedDGRing ℚ

private def terminalCoefficientCharacter : Tᵐᵒᵖᵐᵒᵖ →+* ℚ :=
  terminalCharacter.toRingHom.comp (RingEquiv.opOp T).symm.toRingHom

local instance instTerminalLoadingRightModule : Module Tᵐᵒᵖᵐᵒᵖ ℚ := Module.compHom ℚ terminalCoefficientCharacter

local instance instTerminalLoadingScalarCommutes : SMulCommClass ℚ Tᵐᵒᵖᵐᵒᵖ ℚ where
  smul_comm a b x := by
    change a * (terminalCoefficientCharacter b * x) =
      terminalCoefficientCharacter b * (a * x)
    ring

private theorem terminalCoefficientLeft {i j : ℤ} {a x : ℚ}
    (ha : a ∈ wgrading i) (hx : x ∈ DG.grading j) :
    a • x ∈ DG.grading (i + j) :=
  mul_mem_grading ha hx

private theorem terminalCoefficientRight {i j : ℤ} {b : Tᵐᵒᵖ} {x : ℚ}
    (hb : b ∈ wgrading i) (hx : x ∈ DG.grading j) :
    op b • x ∈ DG.grading (j + i) := by
  change terminalCoefficientCharacter (op b) * x ∈ DG.grading (j + i)
  rw [show terminalCoefficientCharacter (op b) = terminalCharacter b.unop from rfl]
  by_cases hi : i = 0
  · subst i
    rw [add_zero, mul_comm (terminalCharacter b.unop) x]
    simpa only [add_zero] using mul_mem_grading hx
      (InDegreeZero.ring_mem_grading_iff.mpr (Or.inl rfl) : terminalCharacter b.unop ∈ DG.grading 0)
  · have hz : terminalCharacter b.unop = 0 := by
      unfold terminalCharacter
      exact FirstWeight.boundaryCharacter_eq_zero_of_ne_grade Q wt grading
        (by intro r; simp [wt]) terminal terminal_ordered
        (by unfold IsViolated; decide +kernel) hi hb
    rw [hz, zero_mul]
    exact zero_mem _

universe v

variable [CatModule.HasDerivedCategory.{v,0} (WeightCategory ℚ)]
  [CatModule.HasDerivedCategory.{v,0} (WeightCategory Tᵐᵒᵖ)]

/-- Derived tensor with the one-dimensional terminal character coefficient. -/
def gradedTerminalCoefficientTensor :
    CatModule.DerivedCategory.{v,0} (WeightCategory Tᵐᵒᵖ) ⥤
      CatModule.DerivedCategory.{v,0} (WeightCategory ℚ) :=
  diagramWeightDerivedTensor (fun j => DG.grading (M := ℚ) j)
    terminalCoefficientLeft terminalCoefficientRight

/-- The terminal coefficient annihilates the strictly higher loading in the actual
graded terminal-standard resolution. Consequently the terminal-standard evaluation has
no negative derived tensor cohomology. -/
theorem gradedTerminalStandard_terminalCoefficient_cohomology_isZero
    (X : WeightCategory ℚ) {n : ℤ} (hn : n < 0) :
    CategoryTheory.Limits.IsZero ((CatModule.DerivedCategory.cohomologyFunctor X n).obj
      (gradedTerminalCoefficientTensor.obj
        (CatModule.DerivedCategory.Q.obj gradedTerminalStandard))) := by
  refine diagramWeightDerivedTensor_cohomology_isZero_of_loading_support
    (fun j => DG.grading (M := ℚ) j) terminalCoefficientLeft terminalCoefficientRight
    gradedTerminalStandardResolutionAugmentation gradedTerminalStandardResolution_isKProjective
    gradedTerminalStandardResolution_quasiIso X n
    (fun W (_ : Unit) => (gradedLoadingIdempotentAt middle middleOrdered W.as).val)
    (fun Z x hx => gradedTerminalStandardResolution_loading_support Z hn x hx) ?_
  intro W i p
  apply Subtype.ext
  change terminalCoefficientCharacter
    (op (gradedLoadingIdempotentAt middle middleOrdered W.as).val.val) * p.val = 0
  rw [show terminalCoefficientCharacter
    (op (gradedLoadingIdempotentAt middle middleOrdered W.as).val.val) =
      terminalCharacter (TensorProductAlgebra.mk Q wt {()} (StendhalAlgebra.e middle middleOrdered)) from rfl]
  have hz : terminalCharacter (TensorProductAlgebra.mk Q wt {()}
      (StendhalAlgebra.e middle middleOrdered)) = 0 := by
    simp [terminalCharacter, FirstWeight.boundaryCharacter_e,
      show middle ≠ terminal by decide +kernel]
  rw [hz, zero_mul]

end Categorification.Stendhal.FundamentalCorner
