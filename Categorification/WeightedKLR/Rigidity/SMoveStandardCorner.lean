import Categorification.WeightedKLR.Rigidity.SMoveStandardTor
import Categorification.WeightedKLR.RedStrands.StandardPartialKernel

/-!
# Tor between a loading standard and its reflection

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.3, proof
of Proposition 7.22: after dévissage, the only surviving `E²` term of the S-move is the tensor
product of a standard module with the reflection of a standard module with the same black
counts. This file computes that tensor product for a loading standard and its own reflection:
`S_t ⊗ Ṡ_t ≅ S_t e(t)`, the vectors of `S_t = e(t) T / U_t` fixed by `e(t)`, that is
`e(t) T e(t) / e(t) U_t`. Together with the vanishing of the higher Tor
(`isZero_derivedTensorHomology_loadingStandard`), `S_t ⊗ᴸ Ṡ_t` is `S_t e(t)` in degree zero.

The proof: `S_t` is cyclic, generated by the class `u` of `e(t)`, so `m ↦ m ⊗ u` is onto. Its
inverse sends `m ⊗ [x]` to `m · flip(x)`; this is well defined because the relations `U_t` of
the standard module form (the corner part of) the two-sided ideal generated by the loading
idempotents above `t` (`mem_violStandardUpper_iff`), which the flip preserves.

## Main results

* `flip_mem_stendhalUpperIdeal`: the flip preserves the ideal of higher loadings.
* `tensorProductOverReflectedEquiv`: `S_t ⊗ Ṡ_t ≃+ S_t e(t)`.
* `nonempty_addEquiv_derivedTensorHomology_reflected`: `Tor₀(S_t, Ṡ_t) ≃+ S_t e(t)`.
-/

noncomputable section

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open CategoryTheory CategoryTheory.Limits KLR Equiv MulOpposite CornerEndomorphism DG

universe w
attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

section Ideal

variable {I k : Type} [DecidableEq I] [Field k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

/-- **The flip preserves the ideal of higher loadings**: the two-sided ideal generated by the
loading idempotents strictly above `t` is stable under the top–bottom flip, which fixes each
loading idempotent. -/
theorem flip_mem_stendhalUpperIdeal {t : Seq (stendhalWeight ℓ ν)} {κ : List (Fin ℓ)}
    {z : ViolQuotient k Q Λ ν} (hz : z ∈ stendhalUpperIdeal k Q Λ ν t κ) :
    violFlip z ∈ stendhalUpperIdeal k Q Λ ν t κ := by
  induction hz using TwoSidedIdeal.span_induction with
  | mem x hx =>
    obtain ⟨v, hv, hlt, rfl⟩ := hx
    change violFlip (violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.e v))) ∈ _
    rw [violFlip_violMk, flip_e]
    exact TwoSidedIdeal.subset_span ⟨v, hv, hlt, rfl⟩
  | zero => rw [violFlip_zero']; exact zero_mem _
  | add x y _ _ hx hy => rw [violFlip_add']; exact add_mem hx hy
  | neg x _ hx =>
    have h : violFlip (-x) = -violFlip x := by
      rw [eq_neg_iff_add_eq_zero, ← violFlip_add', neg_add_cancel, violFlip_zero']
    rw [h]; exact neg_mem hx
  | left_absorb a x _ hx =>
    rw [violFlip_mul']; exact TwoSidedIdeal.mul_mem_right _ _ _ hx
  | right_absorb b x _ hx =>
    rw [violFlip_mul']; exact TwoSidedIdeal.mul_mem_left _ _ _ hx

/-- `mem_violStandardUpper_iff` at a red order given by an equation. -/
theorem mem_violStandardUpper_iff_of_redWord {t : Seq (stendhalWeight ℓ ν)} {κ : List (Fin ℓ)}
    (hκ : redWord t = κ) (x : violCorner k Q Λ ν t κ) :
    x ∈ violStandardUpper t κ ↔ x.1 ∈ stendhalUpperIdeal k Q Λ ν t κ := by
  subst hκ; exact mem_violStandardUpper_iff x

end Ideal

variable {I k : Type} [DecidableEq I] [Field k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}
  {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : TypeA.IsReducedChoice ρ) (hQ : KLRSymm Q) (σ : Perm (Fin ℓ))

local notation "κ" => List.map σ (List.finRange ℓ)
local notation "C" => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ
local notation "μ" => stendhalWeight ℓ ν

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

theorem cornerFlip_mul (a b : C) : cornerFlip (a * b) = cornerFlip b * cornerFlip a :=
  Subtype.ext (violFlip_mul' a.1 b.1)

/-- An element of the loading corner `e(t) V e_κ`, as an element of the braid corner. -/
def violCornerToCorner {t : Seq μ} (ht : redWord t = κ) (x : violCorner k Q Λ ν t κ) : C :=
  ⟨x.1, by
    have hp := isIdempotentElem_violMk_redProj k Q Λ ν κ
    let f := violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (ν := ν) ht
    have hx := mem_violCorner_iff.1 x.2
    refine (Subsemigroup.mem_corner_iff hp).2 ⟨?_, hx.2⟩
    calc _ * x.1 = _ * (f.val * x.1) := congrArg (_ * ·) hx.1.symm
      _ = x.1 := (mul_assoc _ _ _).symm.trans
        ((congrArg (· * x.1) (corner_mul_left hp f)).trans hx.1)⟩

theorem violCornerToCorner_val {t : Seq μ} (ht : redWord t = κ) (x : violCorner k Q Λ ν t κ) :
    (violCornerToCorner σ ht x).1 = x.1 := rfl

/-- The class of the loading idempotent in the loading standard. -/
def violLoadingStandardGen {t : Seq μ} (ht : redWord t = κ) :
    ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ :=
  Submodule.Quotient.mk ⟨(violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (ν := ν) ht).1,
    mem_violCorner_iff.2 ⟨congrArg Subtype.val (isIdempotentElem_violLoadingIdem ht),
      corner_mul_right (isIdempotentElem_violMk_redProj k Q Λ ν κ) _⟩⟩

theorem mk_eq_smul_violLoadingStandardGen {t : Seq μ} (ht : redWord t = κ)
    (x : violCorner k Q Λ ν t κ) :
    (Submodule.Quotient.mk x : ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ) =
      op (violCornerToCorner σ ht x) • violLoadingStandardGen σ ht := by
  rw [violLoadingStandardGen, ← Submodule.Quotient.mk_smul]
  congr 1
  exact Subtype.ext (mem_violCorner_iff.1 x.2).1.symm

local notation "𝕊" t:arg => ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ
local notation "𝔼" t:arg => violCorner k Q Λ ν (Seq.redPerm σ t) κ

theorem cornerFlip_add (a b : C) : cornerFlip (a + b) = cornerFlip a + cornerFlip b :=
  Subtype.ext (violFlip_add' a.1 b.1)

/-- For `m ∈ S_t`, the additive map `x ↦ m · flip(x)` on the loading corner. -/
def reflectedPairingAux {t : Seq μ} (ht : IsRedOrdered t) (m : 𝕊 t) : 𝔼 t →+ 𝕊 t :=
  AddMonoidHom.mk'
    (fun x => op (cornerFlip (violCornerToCorner (ν := ν) σ (redWord_relabel σ ht) x)) • m)
    fun x y => by
      have h : violCornerToCorner (ν := ν) σ (redWord_relabel σ ht) (x + y) =
          violCornerToCorner σ (redWord_relabel σ ht) x +
            violCornerToCorner σ (redWord_relabel σ ht) y := Subtype.ext rfl
      rw [h, cornerFlip_add]
      exact (congrArg (· • m) (op_add _ _)).trans (add_smul _ _ m)

theorem reflectedPairingAux_eq_zero {t : Seq μ} (ht : IsRedOrdered t) (m : 𝕊 t) (x : 𝔼 t)
    (hx : x ∈ violStandardUpper (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ) :
    reflectedPairingAux σ ht m x = 0 := by
  have hx' := (mem_violStandardUpper_iff_of_redWord (redWord_relabel σ ht) x).1 hx
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  change op (cornerFlip (violCornerToCorner (ν := ν) σ (redWord_relabel σ ht) x)) •
    (Submodule.Quotient.mk y : 𝕊 t) = 0
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
    mem_violStandardUpper_iff_of_redWord (redWord_relabel σ ht), violCorner_smul_val]
  exact TwoSidedIdeal.mul_mem_left _ _ _ (flip_mem_stendhalUpperIdeal hx')

/-- For `m ∈ S_t`, the additive map `[x] ↦ m · flip(x)` on `S_t`. -/
def reflectedPairing {t : Seq μ} (ht : IsRedOrdered t) (m : 𝕊 t) : 𝕊 t →+ 𝕊 t :=
  QuotientAddGroup.lift
    (violStandardUpper (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ t) κ).toAddSubgroup
    (reflectedPairingAux σ ht m) (reflectedPairingAux_eq_zero σ ht m)

theorem reflectedPairing_mk {t : Seq μ} (ht : IsRedOrdered t) (m : 𝕊 t) (x : 𝔼 t) :
    reflectedPairing σ ht m (Submodule.Quotient.mk x) =
      op (cornerFlip (violCornerToCorner (ν := ν) σ (redWord_relabel σ ht) x)) • m := rfl

theorem reflectedPairing_add {t : Seq μ} (ht : IsRedOrdered t) (m m' : 𝕊 t) :
    reflectedPairing σ ht (m + m') = reflectedPairing σ ht m + reflectedPairing σ ht m' := by
  ext y
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  exact smul_add (M := Cᵐᵒᵖ) _ m m'

/-- The pairing `S_t × Ṡ_t → S_t`, `(m, [x]) ↦ m · flip(x)`. -/
def reflectedPairingHom {t : Seq μ} (ht : IsRedOrdered t) :
    𝕊 t →+ ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t →+ 𝕊 t :=
  AddMonoidHom.mk' (reflectedPairing σ ht) (reflectedPairing_add σ ht)

theorem violCornerToCorner_smul {t : Seq μ} (ht : IsRedOrdered t) (c : C) (x : 𝔼 t) :
    violCornerToCorner (ν := ν) σ (redWord_relabel σ ht) (op c • x) =
      violCornerToCorner σ (redWord_relabel σ ht) x * c := Subtype.ext rfl

theorem reflectedPairingHom_balanced {t : Seq μ} (ht : IsRedOrdered t) (c : C) (m : 𝕊 t)
    (y : ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t) :
    reflectedPairingHom σ ht (op c • m) y = reflectedPairingHom σ ht m (c • y) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ (show 𝕊 t from y)
  change reflectedPairing σ ht (op c • m) (Submodule.Quotient.mk x) =
    reflectedPairing σ ht m (op (cornerFlip c) • (Submodule.Quotient.mk x : 𝕊 t))
  rw [← Submodule.Quotient.mk_smul, reflectedPairing_mk, reflectedPairing_mk,
    violCornerToCorner_smul σ ht, cornerFlip_mul, cornerFlip_cornerFlip, op_mul]
  exact (mul_smul (_ : Cᵐᵒᵖ) _ m).symm

/-- The map `S_t ⊗ Ṡ_t → S_t`, `m ⊗ [x] ↦ m · flip(x)`. -/
def reflectedTensorToStandard {t : Seq μ} (ht : IsRedOrdered t) :
    TensorProductOver C (𝕊 t) (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t) →+
      𝕊 t :=
  TensorProductOver.lift (reflectedPairingHom σ ht) (reflectedPairingHom_balanced σ ht)

theorem reflectedTensorToStandard_tmul {t : Seq μ} (ht : IsRedOrdered t) (m : 𝕊 t)
    (x : 𝔼 t) :
    reflectedTensorToStandard σ ht (TensorProductOver.tmul C m
      (show ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t from
        Submodule.Quotient.mk x)) =
      op (cornerFlip (violCornerToCorner (ν := ν) σ (redWord_relabel σ ht) x)) • m := rfl

/-- The vectors of `S_t` fixed by the loading idempotent `e(t)`: the module `S_t e(t)`. -/
def loadingStandardFixed {t : Seq μ} (ht : IsRedOrdered t) : AddSubgroup (𝕊 t) where
  carrier := {m | op (violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (ν := ν)
    (redWord_relabel σ ht)) • m = m}
  add_mem' {a b} ha hb := by
    simp only [Set.mem_ofPred_eq] at *
    rw [smul_add, ha, hb]
  zero_mem' := smul_zero _
  neg_mem' {a} ha := by
    simp only [Set.mem_ofPred_eq] at *
    rw [smul_neg, ha]

theorem reflectedTensorToStandard_mem {t : Seq μ} (ht : IsRedOrdered t)
    (z : TensorProductOver C (𝕊 t) (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t)) :
    reflectedTensorToStandard σ ht z ∈
      loadingStandardFixed (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ ht := by
  let e := violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (ν := ν) (redWord_relabel σ ht)
  induction z using TensorProductOver.induction_on with
  | zero => rw [map_zero]; exact zero_mem _
  | add a b ha hb => rw [map_add]; exact add_mem ha hb
  | tmul m y =>
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ (show 𝕊 t from y)
    change op e • reflectedTensorToStandard σ ht (TensorProductOver.tmul C m
      (show ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t from
        Submodule.Quotient.mk x)) = _
    rw [reflectedTensorToStandard_tmul]
    refine (mul_smul (_ : Cᵐᵒᵖ) _ m).symm.trans (congrArg (fun a : Cᵐᵒᵖ => a • m) ?_)
    rw [← op_mul]
    congr 1
    have hex : e * violCornerToCorner (ν := ν) σ (redWord_relabel σ ht) x =
        violCornerToCorner σ (redWord_relabel σ ht) x :=
      Subtype.ext (mem_violCorner_iff.1 x.2).1
    conv_rhs => rw [← hex]
    rw [cornerFlip_mul, cornerFlip_violLoadingIdem σ ht]

theorem tmul_reflectedTensorToStandard {t : Seq μ} (ht : IsRedOrdered t)
    (z : TensorProductOver C (𝕊 t) (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t)) :
    TensorProductOver.tmul C (reflectedTensorToStandard σ ht z)
      (show ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t from
        violLoadingStandardGen (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ (redWord_relabel σ ht)) =
      z := by
  induction z using TensorProductOver.induction_on with
  | zero => rw [map_zero, TensorProductOver.zero_tmul]
  | add a b ha hb => rw [map_add, TensorProductOver.add_tmul, ha, hb]
  | tmul m y =>
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ (show 𝕊 t from y)
    rw [reflectedTensorToStandard_tmul, TensorProductOver.op_smul_tmul]
    congr 1
    change op (cornerFlip (cornerFlip (violCornerToCorner (ν := ν) σ (redWord_relabel σ ht) x)))
      • violLoadingStandardGen (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ (redWord_relabel σ ht) =
        Submodule.Quotient.mk x
    rw [cornerFlip_cornerFlip, ← mk_eq_smul_violLoadingStandardGen]

/-- **Tor₀ of a loading standard with its reflection** (Webster, arXiv:1309.3796v3, §7.3, proof
of Proposition 7.22, the surviving `E²` term): `S_t ⊗ Ṡ_t ≅ S_t e(t)`, by
`m ⊗ [x] ↦ m · flip(x)` with inverse `m ↦ m ⊗ [e(t)]`. -/
def tensorProductOverReflectedEquiv {t : Seq μ} (ht : IsRedOrdered t) :
    TensorProductOver C (𝕊 t) (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t) ≃+
      loadingStandardFixed (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ ht where
  toFun z := ⟨reflectedTensorToStandard σ ht z, reflectedTensorToStandard_mem σ ht z⟩
  invFun m := TensorProductOver.tmul C m.1
    (show ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t from
      violLoadingStandardGen (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ (redWord_relabel σ ht))
  map_add' a b := Subtype.ext (map_add _ a b)
  right_inv m := by
    apply Subtype.ext
    change reflectedTensorToStandard σ ht (TensorProductOver.tmul C m.1
      (show ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t from
        Submodule.Quotient.mk _)) = m.1
    rw [reflectedTensorToStandard_tmul]
    have he : violCornerToCorner (ν := ν) σ (redWord_relabel σ ht)
        ⟨(violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (ν := ν) (redWord_relabel σ ht)).1,
          mem_violCorner_iff.2 ⟨congrArg Subtype.val
            (isIdempotentElem_violLoadingIdem (redWord_relabel σ ht)),
            corner_mul_right (isIdempotentElem_violMk_redProj k Q Λ ν κ) _⟩⟩ =
        violLoadingIdem (redWord_relabel σ ht) := Subtype.ext rfl
    rw [he, cornerFlip_violLoadingIdem σ ht]
    exact m.2
  left_inv z := tmul_reflectedTensorToStandard σ ht z

section Derived

open DG.DerivedCategory
open scoped DG.DegreeZero

attribute [local instance 1200] Ring.toIntAlgebra

variable [HasDerivedCategory.{w, 0}
    (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) (List.map σ (List.finRange ℓ)))]
  [HasDerivedCategory.{w, 0} ℤ]

/-- **Tor between a loading standard and its reflection, degree zero** (Webster,
arXiv:1309.3796v3, §7.3, proof of Proposition 7.22): `Tor₀(S_t, Ṡ_t) ≅ S_t e(t)`. -/
theorem nonempty_addEquiv_derivedTensorHomology_reflected {t : Seq μ} (ht : IsRedOrdered t) :
    Nonempty ((homologyFunctor (A := ℤ) ℤ 0).obj
      ((derivedTensor.{w} ℤ C (𝕊 t)).obj
        (DG.DerivedCategory.Q.obj ((degreeZeroModuleFunctor C).obj
          (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t)))) ≃+
      loadingStandardFixed (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ ht) :=
  ⟨(ambientDerivedTensorH0Equiv (k := ℤ) (A := C) (N := 𝕊 t)
    (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t)).toAddEquiv.trans
      (tensorProductOverReflectedEquiv σ ht)⟩

include hρ hQ in
/-- **Tor between a loading standard and its reflection is concentrated in degree zero**
(Webster, arXiv:1309.3796v3, proof of Lemma 6.12, step `f_n → s_n`): the higher Tor vanish, so
`S_t ⊗ᴸ Ṡ_t ≅ S_t e(t)` (`nonempty_addEquiv_derivedTensorHomology_reflected`). -/
theorem isZero_derivedTensorHomology_reflected_of_ne_zero
    (D : ModuleFiltration.OrderedStandardCovers
      (fun s : {s : Seq μ // IsRedOrdered s} => ModuleCat.of (TensorProductAlgebra k Q (Λ ∘ σ) ν)
        (leftStandard Q (Λ ∘ σ) s.1 s.2))
      (fun s => seqIdem Q (Λ ∘ σ) s.1 s.2) (fun s t => StendhalLT s.1 t.1))
    {t : Seq μ} (ht : IsRedOrdered t) (n : ℤ) (hn : n ≠ 0) :
    IsZero ((homologyFunctor (A := ℤ) ℤ n).obj
      ((derivedTensor.{w} ℤ C (𝕊 t)).obj
        (DG.DerivedCategory.Q.obj ((degreeZeroModuleFunctor C).obj
          (ReflectedLoadingStandard (k := k) (Q := Q) (Λ := Λ) σ t))))) :=
  isZero_derivedTensorHomology_loadingStandard hρ hQ σ D ht ht n hn

end Derived

end Categorification.Stendhal.BraidedStendhalAlgebra
