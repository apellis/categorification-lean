import Categorification.WeightedKLR.KLR.SpacedComparison

/-!
# The reduced quotient

B. Webster, *Weighted Khovanov–Lauda–Rouquier algebras*, arXiv:1209.2463v4, §3.1: the
**reduced quotient** `W̄^ϑ_ν̃` of the weighted KLR algebra of the Crawley-Boevey graph, for the
weight `ν̃ = ν + α_0`, is the quotient by the ideal generated by the dots on the strand labelled
`0`.

The results here hold for any weighted graph and any strand `s₀` which is the only strand of its
colour (`ν s₀.1 = 1`), as is the `0`-labelled strand for the weight `ν̃`. Such a strand is not
involved in any diagonal hyperplane and is fixed by every colour-preserving permutation, so the
dot `y_{s₀}` on it is central in the gallery algebra (`GalleryAlgebra.commute_poly_X`). Hence
the ideal generated by `e * y_{s₀} * e` in Webster's algebra `e A e` is `y_{s₀} * e A e`
(`GalleryAlgebra.mem_dotIdeal_iff`), and in the basis of Webster's Theorem 2.8 it is spanned by
the basis elements whose monomial has positive degree in `y_{s₀}`. The reduced quotient therefore
has the basis of the images of the basis elements with no dot on `s₀`
(`GalleryAlgebra.reducedBasis`): this is the basis used in the proof of Webster's Theorem 3.5.

## Main definitions

* `GalleryAlgebra.reducedDot`: the dot `e * y_{s₀} * e` in Webster's algebra.
* `GalleryAlgebra.dotIdeal`: the two-sided ideal it generates.
* `GalleryAlgebra.ReducedQuotient`: the reduced quotient.
* `GalleryAlgebra.reducedBasis`, `GalleryAlgebra.redReducedBasis`: its basis, in general and for
  the Crawley-Boevey graph.
-/

namespace Categorification.WeightedKLR

open MvPolynomial

section QuotientBasis

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N]

/-- If a surjective linear map `f` has kernel spanned by the basis vectors `b i` with `¬ p i`,
the images of the other basis vectors form a basis of the target. -/
noncomputable def basisOfKerEqSpan (b : Module.Basis ι R M) (p : ι → Prop) (f : M →ₗ[R] N)
    (hf : Function.Surjective f) (hker : LinearMap.ker f = Submodule.span R (b '' {i | ¬ p i})) :
    Module.Basis {i // p i} R N :=
  Module.Basis.mk (v := fun i => f (b i.1))
    (by
      rw [linearIndependent_iff]
      intro l hl
      have h1 : Finsupp.linearCombination R (b ∘ Subtype.val) l ∈ LinearMap.ker f := by
        rw [LinearMap.mem_ker, Finsupp.apply_linearCombination]
        exact hl
      rw [hker, b.mem_span_image, Finsupp.linearCombination_comp, LinearMap.comp_apply,
        b.repr_linearCombination] at h1
      ext i
      have h2 : (Finsupp.lmapDomain R R Subtype.val l) i.1 = l i :=
        Finsupp.mapDomain_apply_of_injective Subtype.val_injective l i
      rw [← h2, Finsupp.coe_zero, Pi.zero_apply]
      by_contra h3
      exact h1 (Finsupp.mem_support_iff.2 h3) i.2)
    (by
      rintro y -
      obtain ⟨x, rfl⟩ := hf y
      rw [← b.linearCombination_repr x, Finsupp.linearCombination_apply, Finsupp.sum, map_sum]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [map_smul]
      by_cases hi : p i
      · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨i, hi⟩, rfl⟩)
      · have : f (b i) = 0 := by
          rw [← LinearMap.mem_ker, hker]
          exact Submodule.subset_span ⟨i, hi, rfl⟩
        rw [this, smul_zero]
        exact zero_mem _)

theorem basisOfKerEqSpan_apply (b : Module.Basis ι R M) (p : ι → Prop) (f : M →ₗ[R] N)
    (hf : Function.Surjective f) (hker : LinearMap.ker f = Submodule.span R (b '' {i | ¬ p i}))
    (i : {i // p i}) : basisOfKerEqSpan b p f hf hker i = f (b i.1) := by
  simp [basisOfKerEqSpan]

end QuotientBasis

variable {I : Type*} [DecidableEq I] {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜]
  [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k] {Γ : WeightedGraph I 𝕜 k} {ν : I →₀ ℕ}

namespace GalleryAlgebra

/-! ### A strand alone in its colour -/

section Unique

variable {s₀ : Strand ν} (h₀ : ν s₀.1 = 1)

include h₀

omit [DecidableEq I] in
theorem eq_of_fst_eq {s : Strand ν} (h : s.1 = s₀.1) : s = s₀ := by
  obtain ⟨i, a⟩ := s
  obtain ⟨i₀, a₀⟩ := s₀
  dsimp only at h h₀
  subst h
  have ha : (a : ℕ) < ν i := a.isLt
  have ha₀ : (a₀ : ℕ) < ν i := a₀.isLt
  have h₀' : ν i = 1 := h₀
  congr 1
  ext
  omega

omit [DecidableEq I] in
theorem colPerm_apply_eq (g : ColPerm ν) : g.1 s₀ = s₀ :=
  eq_of_fst_eq h₀ (ColPerm.apply_fst g s₀)

omit [DecidableEq I] in
theorem diag_ne (d : Diag ν) : d.fst ≠ s₀ ∧ d.snd ≠ s₀ := by
  have h1 : d.fst.1 = d.snd.1 := d.2.1
  have h2 : d.fst.2.val < d.snd.2.val := d.2.2
  have hne : d.fst ≠ d.snd := fun h => by rw [h] at h2; exact lt_irrefl _ h2
  refine ⟨fun h => hne ?_, fun h => hne ?_⟩
  · rw [h, eq_of_fst_eq h₀ (h1.symm.trans (congrArg Sigma.fst h))]
  · rw [h, eq_of_fst_eq h₀ (h1.trans (congrArg Sigma.fst h))]

omit [IsStrictOrderedRing 𝕜] in
theorem stepFactor_X (C : FullChamber Γ ν) (d : Diag ν) :
    stepFactor Γ (d.left C) (d.right C) (X s₀ : PolyRing ν k) = 0 := by
  have hd := diag_ne h₀ d
  have h2 : d.fst.2.val < d.snd.2.val := d.2.2
  have hne : d.fst ≠ d.snd := fun h => by rw [h] at h2; exact lt_irrefl _ h2
  have hl : s₀ ≠ d.left C := by
    unfold Diag.left; split_ifs
    exacts [hd.1.symm, hd.2.symm]
  have hr : s₀ ≠ d.right C := by
    unfold Diag.right; split_ifs
    exacts [hd.2.symm, hd.1.symm]
  have hlr : d.left C ≠ d.right C := by
    unfold Diag.left Diag.right; split_ifs
    exacts [hne, hne.symm]
  unfold stepFactor
  split
  · exact ddiff_X_of_ne hlr hl hr
  · rw [rename_X, Equiv.swap_apply_of_ne_of_ne hl hr, sub_self, mul_zero]

/-- **The dot on a strand alone in its colour is central** in the gallery algebra. -/
theorem commute_poly_X (x : GalleryAlgebra k Γ ν) : Commute (poly (X s₀)) x := by
  obtain ⟨x, rfl⟩ := mk_surjective x
  induction x using FreeAlgebra.induction with
  | grade0 c =>
    rw [AlgHom.commutes]
    exact (Algebra.commutes c _).symm
  | grade1 g =>
    cases g with
    | idem C => exact (e_mul_poly C _).symm
    | poly f =>
      show poly (X s₀) * poly f = poly f * poly (X s₀)
      rw [poly_mul_poly, poly_mul_poly, mul_comm]
    | relabel g C =>
      show poly (X s₀) * r g C = r g C * poly (X s₀)
      rw [r_mul_poly, rename_X, colPerm_apply_eq h₀]
    | step C C' =>
      show poly (X s₀) * t C C' = t C C' * poly (X s₀)
      by_cases hadj : ∃ h, C.Adjacent C' h
      · obtain ⟨h | d, hh⟩ := hadj
        · exact (t_mul_poly_inl hh _).symm
        · have h0 : (poly 0 : GalleryAlgebra k Γ ν) = 0 := by
            rw [← polyHom_apply, map_zero]
          rw [t_mul_poly_inr hh, stepFactor_X h₀, h0, zero_mul, add_zero]
      · push Not at hadj
        have : (t C C' : GalleryAlgebra k Γ ν) = 0 := by
          have := rel (Rel.step_zero (k := k) C C' hadj)
          rwa [map_zero] at this
        rw [this, mul_zero, zero_mul]
  | add a b ha hb => rw [map_add]; exact ha.add_right hb
  | mul a b ha hb => rw [map_mul]; exact ha.mul_right hb

end Unique

/-! ### The reduced quotient -/

variable (k Γ ν) in
/-- The dot `e * y_{s₀} * e` on the strand `s₀` in Webster's algebra `e A e`. -/
noncomputable def reducedDot (s₀ : Strand ν) : WeightedKLRAlgebra k Γ ν :=
  ⟨rankIdem k Γ ν * poly (X s₀) * rankIdem k Γ ν, by
    rw [Subsemigroup.mem_corner_iff isIdempotentElem_rankIdem]
    constructor
    · rw [← mul_assoc, ← mul_assoc, isIdempotentElem_rankIdem.eq]
    · rw [mul_assoc, isIdempotentElem_rankIdem.eq]⟩

variable (k Γ ν) in
/-- **Webster's ideal of dots on the `0`-labelled strand** (arXiv:1209.2463v4, §3.1), for a
strand `s₀`: the two-sided ideal of Webster's algebra generated by the dot `e * y_{s₀} * e`. -/
noncomputable def dotIdeal (s₀ : Strand ν) : TwoSidedIdeal (WeightedKLRAlgebra k Γ ν) :=
  TwoSidedIdeal.span {reducedDot k Γ ν s₀}

variable (k Γ ν) in
/-- **Webster's reduced quotient** (arXiv:1209.2463v4, §3.1): Webster's algebra modulo the
ideal generated by the dots on the strand `s₀`. -/
abbrev ReducedQuotient (s₀ : Strand ν) : Type _ := (dotIdeal k Γ ν s₀).ringCon.Quotient

variable (k Γ ν) in
/-- The quotient map onto the reduced quotient. -/
noncomputable def reducedMk (s₀ : Strand ν) :
    WeightedKLRAlgebra k Γ ν →ₐ[k] ReducedQuotient k Γ ν s₀ :=
  (dotIdeal k Γ ν s₀).ringCon.mkₐ k

theorem reducedMk_surjective (s₀ : Strand ν) : Function.Surjective (reducedMk k Γ ν s₀) :=
  (dotIdeal k Γ ν s₀).ringCon.mk'_surjective

theorem reducedMk_eq_zero_iff {s₀ : Strand ν} {x : WeightedKLRAlgebra k Γ ν} :
    reducedMk k Γ ν s₀ x = 0 ↔ x ∈ dotIdeal k Γ ν s₀ := by
  rw [← TwoSidedIdeal.mem_ker]
  change x ∈ TwoSidedIdeal.ker ((dotIdeal k Γ ν s₀).ringCon.mk') ↔ _
  rw [TwoSidedIdeal.ker_ringCon_mk']

section Unique

variable {s₀ : Strand ν} (h₀ : ν s₀.1 = 1)

include h₀

theorem reducedDot_mul_val (y : WeightedKLRAlgebra k Γ ν) :
    (reducedDot k Γ ν s₀ * y).1 = poly (X s₀) * y.1 := by
  have hy := (Subsemigroup.mem_corner_iff isIdempotentElem_rankIdem).1 y.2
  change rankIdem k Γ ν * poly (X s₀) * rankIdem k Γ ν * y.1 = _
  rw [mul_assoc _ _ y.1, hy.1, ← (commute_poly_X h₀ _).eq, mul_assoc, hy.1]

theorem reducedDot_commute (y : WeightedKLRAlgebra k Γ ν) :
    reducedDot k Γ ν s₀ * y = y * reducedDot k Γ ν s₀ := by
  have hy := (Subsemigroup.mem_corner_iff isIdempotentElem_rankIdem).1 y.2
  apply Subtype.ext
  rw [reducedDot_mul_val h₀]
  change _ = y.1 * (rankIdem k Γ ν * poly (X s₀) * rankIdem k Γ ν)
  have hd : rankIdem k Γ ν * poly (X s₀) * rankIdem k Γ ν = poly (X s₀) * rankIdem k Γ ν := by
    rw [← (commute_poly_X h₀ (rankIdem k Γ ν)).eq, mul_assoc, isIdempotentElem_rankIdem.eq]
  rw [hd, ← mul_assoc, ← (commute_poly_X h₀ y.1).eq, mul_assoc, hy.2]

/-- **The ideal of dots on a strand alone in its colour** is `y_{s₀} * e A e`: its elements are
the multiples of the dot. -/
theorem mem_dotIdeal_iff {x : WeightedKLRAlgebra k Γ ν} :
    x ∈ dotIdeal k Γ ν s₀ ↔ ∃ y, x = reducedDot k Γ ν s₀ * y := by
  constructor
  · intro hx
    induction hx using TwoSidedIdeal.span_induction with
    | mem x hx => exact ⟨1, by rw [Set.mem_singleton_iff.1 hx, mul_one]⟩
    | zero => exact ⟨0, (mul_zero _).symm⟩
    | add x x' _ _ hx hx' =>
      obtain ⟨y, rfl⟩ := hx
      obtain ⟨y', rfl⟩ := hx'
      exact ⟨y + y', (mul_add _ _ _).symm⟩
    | neg x _ hx =>
      obtain ⟨y, rfl⟩ := hx
      have := mul_neg (reducedDot k Γ ν s₀) y
      exact ⟨-y, this.symm⟩
    | left_absorb a x _ hx =>
      obtain ⟨y, rfl⟩ := hx
      exact ⟨a * y, by rw [← mul_assoc, ← reducedDot_commute h₀, mul_assoc]⟩
    | right_absorb b x _ hx =>
      obtain ⟨y, rfl⟩ := hx
      exact ⟨y * b, mul_assoc _ _ _⟩
  · rintro ⟨y, rfl⟩
    exact TwoSidedIdeal.mul_mem_right _ _ _ (TwoSidedIdeal.subset_span rfl)

end Unique

/-! ### The basis of the reduced quotient -/

variable (k Γ ν) in
/-- Webster's algebra as a ring (`WeightedKLRAlgebra`) and as a subspace of the gallery algebra
(`weightedKLR`) are the same `k`-module. -/
noncomputable def cornerLinearEquiv : WeightedKLRAlgebra k Γ ν ≃ₗ[k] weightedKLR k Γ ν where
  toFun x := ⟨x.1, mem_weightedKLR_iff_mem_corner.2 x.2⟩
  invFun x := ⟨x.1, mem_weightedKLR_iff_mem_corner.1 x.2⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl

attribute [local instance] ColPerm.fintype

/-- Adding one dot on the strand `s₀` to the monomial of a basis index. -/
noncomputable def addDot (s₀ : Strand ν) (i : RankChamber Γ ν × RankChamber Γ ν × ColPerm ν × (Strand ν →₀ ℕ)) :
    RankChamber Γ ν × RankChamber Γ ν × ColPerm ν × (Strand ν →₀ ℕ) :=
  (i.1, i.2.1, i.2.2.1, i.2.2.2 + Finsupp.single s₀ 1)

omit [DecidableEq I] [IsStrictOrderedRing 𝕜] in
theorem addDot_injective (s₀ : Strand ν) : Function.Injective (addDot (Γ := Γ) s₀) := by
  rintro ⟨C, D, g, m⟩ ⟨C', D', g', m'⟩ h
  simp only [addDot, Prod.mk.injEq, add_left_inj] at h
  obtain ⟨rfl, rfl, rfl, rfl⟩ := h
  rfl

omit [DecidableEq I] [IsStrictOrderedRing 𝕜] in
theorem range_addDot (s₀ : Strand ν) :
    Set.range (addDot (Γ := Γ) s₀) = {i | ¬ i.2.2.2 s₀ = 0} := by
  ext ⟨C, D, g, m⟩
  simp only [Set.mem_range, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨⟨C', D', g', m'⟩, h⟩
    simp only [addDot, Prod.mk.injEq] at h
    obtain ⟨-, -, -, rfl⟩ := h
    simp
  · intro hm
    refine ⟨(C, D, g, m - Finsupp.single s₀ 1), ?_⟩
    simp only [addDot, Prod.mk.injEq, true_and]
    exact tsub_add_cancel_of_le (Finsupp.single_le_iff.2 (Nat.one_le_iff_ne_zero.2 hm))

variable {P : FullChamber Γ ν → FullChamber Γ ν → (Strand ν → 𝕜) × (Strand ν → 𝕜)}
  (hP : ∀ C E, IsChamberSegment C E (P C E)) (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops)
  (hΓ : Γ.PSymm) (hW : ∀ w : Wall Γ ν, IsRegular (w.factor (k := k)))
  (hL : ∀ (Q : MvPolynomial (Fin 2) k) (a b : Strand ν), Γ.loop a.1 = some Q → a ≠ b →
    a.1 = b.1 → IsRegular (loopFactor Q a b))

/-- The basis of Webster's Theorem 2.8 of the ring `WeightedKLRAlgebra`. -/
noncomputable def algebraBasis :
    Module.Basis (RankChamber Γ ν × RankChamber Γ ν × ColPerm ν × (Strand ν →₀ ℕ)) k
      (WeightedKLRAlgebra k Γ ν) :=
  (weightedKLRBasis hP hD hZ hΓ hW hL).map (cornerLinearEquiv k Γ ν).symm

theorem algebraBasis_val (C D : RankChamber Γ ν) (g : ColPerm ν) (m : Strand ν →₀ ℕ) :
    (algebraBasis hP hD hZ hΓ hW hL (C, D, g, m)).1 =
      r g (g⁻¹ • D.1) * segGallery P C.1 (g⁻¹ • D.1) * poly (monomial m 1) :=
  weightedKLRBasis_apply hP hD hZ hΓ hW hL C D g m

variable {s₀ : Strand ν} (h₀ : ν s₀.1 = 1)

include h₀

theorem reducedDot_mul_algebraBasis (i) :
    reducedDot k Γ ν s₀ * algebraBasis hP hD hZ hΓ hW hL i =
      algebraBasis hP hD hZ hΓ hW hL (addDot s₀ i) := by
  obtain ⟨C, D, g, m⟩ := i
  apply Subtype.ext
  rw [reducedDot_mul_val h₀, algebraBasis_val, addDot, algebraBasis_val,
    (commute_poly_X h₀ _).left_comm, poly_mul_poly, X, monomial_mul_monomial, one_mul, add_comm]

/-- **The ideal of dots on `s₀` in Webster's basis**: it is spanned by the basis elements of
Webster's Theorem 2.8 whose monomial has positive degree in `y_{s₀}`. -/
theorem ker_reducedMk :
    LinearMap.ker (reducedMk k Γ ν s₀).toLinearMap = Submodule.span k
      (algebraBasis hP hD hZ hΓ hW hL '' {i | ¬ i.2.2.2 s₀ = 0}) := by
  set b := algebraBasis hP hD hZ hΓ hW hL
  have hL' : LinearMap.ker (reducedMk k Γ ν s₀).toLinearMap =
      LinearMap.range (LinearMap.mulLeft k (reducedDot k Γ ν s₀)) := by
    ext x
    rw [LinearMap.mem_ker, AlgHom.toLinearMap_apply, reducedMk_eq_zero_iff,
      mem_dotIdeal_iff h₀, LinearMap.mem_range]
    exact ⟨fun ⟨y, hy⟩ => ⟨y, hy.symm⟩, fun ⟨y, hy⟩ => ⟨y, hy.symm⟩⟩
  rw [hL', LinearMap.range_eq_map, ← b.span_eq, Submodule.map_span, ← range_addDot,
    ← Set.range_comp, ← Set.range_comp]
  congr 2
  funext i
  exact reducedDot_mul_algebraBasis hP hD hZ hΓ hW hL h₀ i

/-- **The basis of the reduced quotient** (the basis used in the proof of Webster's Theorem 3.5,
arXiv:1209.2463v4): for a strand `s₀` alone in its colour, the images in the reduced quotient of
the basis elements `r g (g⁻¹ • D) * segGallery P C (g⁻¹ • D) * poly (y^m)` of Webster's Theorem
2.8 with no dot on `s₀` (`m s₀ = 0`) form a `k`-basis. -/
noncomputable def reducedBasis :
    Module.Basis {i : RankChamber Γ ν × RankChamber Γ ν × ColPerm ν × (Strand ν →₀ ℕ) //
      i.2.2.2 s₀ = 0} k (ReducedQuotient k Γ ν s₀) :=
  basisOfKerEqSpan (algebraBasis hP hD hZ hΓ hW hL) _ (reducedMk k Γ ν s₀).toLinearMap
    (reducedMk_surjective s₀) (ker_reducedMk hP hD hZ hΓ hW hL h₀)

theorem reducedBasis_apply (i) :
    reducedBasis hP hD hZ hΓ hW hL h₀ i =
      reducedMk k Γ ν s₀ (algebraBasis hP hD hZ hΓ hW hL i.1) :=
  basisOfKerEqSpan_apply _ _ _ _ _ i

end GalleryAlgebra

/-! ### The Crawley-Boevey graph -/

namespace GalleryAlgebra

open WeightedGraph

variable {J : Type} [DecidableEq J] {Γ' : WeightedGraph J 𝕜 k} {ℓ : ℕ} {Λ : Fin ℓ → J →₀ ℕ}
  {ϖ : Fin ℓ → 𝕜}

variable (ν) in
/-- The strand of `ν̃ = ν + α_0` (`redWeight ν`) labelled by the new vertex `0` of the
Crawley-Boevey graph (arXiv:1209.2463v4, §3.1). -/
def zeroStrand (ν : J →₀ ℕ) : Strand (redWeight ν) :=
  ⟨⟨none, Finsupp.mem_support_iff.2 (by simp)⟩, ⟨0, by simp⟩⟩

omit [DecidableEq J] in
/-- The `0`-labelled strand is the only strand of its colour. -/
theorem redWeight_zeroStrand (ν : J →₀ ℕ) : redWeight ν (zeroStrand ν).1 = 1 :=
  redWeight_none ν

attribute [local instance] ColPerm.fintype

/-- **The basis of Webster's reduced quotient** `W̄^ϑ_ν̃` of the weighted KLR algebra of the
Crawley-Boevey graph `Γ_λ` (arXiv:1209.2463v4, §3.1, the basis used in the proof of
Theorem 3.5): for a choice `P` of simple segments, the images of the basis elements
`r g (g⁻¹ • D) * segGallery P C (g⁻¹ • D) * poly (y^m)` of Theorem 2.8 with no dot on the
`0`-labelled strand form a `k`-basis, when `Γ` satisfies the standing hypothesis and (†) and the
weights `ϖ_j` are distinct. -/
noncomputable def redReducedBasis (ν : J →₀ ℕ)
    {P : FullChamber (Γ'.crawleyBoevey Λ ϖ) (redWeight ν) →
      FullChamber (Γ'.crawleyBoevey Λ ϖ) (redWeight ν) →
      (Strand (redWeight ν) → 𝕜) × (Strand (redWeight ν) → 𝕜)}
    (hP : ∀ C E, IsChamberSegment C E (P C E)) (hD : Γ'.Dagger) (hZ : Γ'.NoZeroLoops)
    (hS : Γ'.Standing) (hϖ : Function.Injective ϖ) :
    Module.Basis {i : RankChamber (Γ'.crawleyBoevey Λ ϖ) (redWeight ν) ×
        RankChamber (Γ'.crawleyBoevey Λ ϖ) (redWeight ν) × ColPerm (redWeight ν) ×
        (Strand (redWeight ν) →₀ ℕ) // i.2.2.2 (zeroStrand ν) = 0} k
      (ReducedQuotient k (Γ'.crawleyBoevey Λ ϖ) (redWeight ν) (zeroStrand ν)) :=
  reducedBasis hP (crawleyBoevey_dagger hD hϖ) (crawleyBoevey_noZeroLoops hZ)
    (crawleyBoevey_psymm hS.psymm) (crawleyBoevey_isRegular_factor hS)
    (crawleyBoevey_isRegular_loopFactor hS) (redWeight_zeroStrand ν)

theorem redReducedBasis_apply (ν : J →₀ ℕ)
    {P : FullChamber (Γ'.crawleyBoevey Λ ϖ) (redWeight ν) →
      FullChamber (Γ'.crawleyBoevey Λ ϖ) (redWeight ν) →
      (Strand (redWeight ν) → 𝕜) × (Strand (redWeight ν) → 𝕜)}
    (hP : ∀ C E, IsChamberSegment C E (P C E)) (hD : Γ'.Dagger) (hZ : Γ'.NoZeroLoops)
    (hS : Γ'.Standing) (hϖ : Function.Injective ϖ) (i) :
    redReducedBasis ν hP hD hZ hS hϖ i = reducedMk k _ _ _ (algebraBasis hP
      (crawleyBoevey_dagger hD hϖ) (crawleyBoevey_noZeroLoops hZ)
      (crawleyBoevey_psymm hS.psymm) (crawleyBoevey_isRegular_factor hS)
      (crawleyBoevey_isRegular_loopFactor hS) i.1) :=
  reducedBasis_apply _ _ _ _ _ _ _ i

