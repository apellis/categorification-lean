/-!
# Standard modules of `T̃^λ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §5.1,
Definition 5.1 and the cyclotomic step of the proof of Proposition 5.3.

For a sequence `s` of black and red strands with the red strands in the order `λ_1, …, λ_ℓ`,
`blackCount s r i` is the number of black `i`-strands of `s` left of the red strand `λ_r`.
Webster's preorder on sequences compares these numbers: `s ≤ t` when every red strand has at
least as many black strands of each label to its left in `t` as in `s`, i.e. the black strands
of `t` lie further left.

The right projective `P̃_s = e(s) T̃^λ` has the submodule `U_s` generated by the images of the
maps `P̃_t → P̃_s` for `t > s`, that is by the elements `e(s) a e(t)`; the standard module is
`S_s = P̃_s / U_s` (Definition 5.1). Definition 5.1 says `(t, κ') ≥ (s, κ)`; we read this as
the strict order, as in the definition of `S_α` there: with `≥`, the identity of `P̃_s` would
make every standard module zero.

The cyclotomic step of Proposition 5.3: if the red strand `λ_r` is immediately followed by a
black `i`-strand, then `y^{α_i^∨(λ_r)} e(s)` (dots on the black strand) factors through the
sequence with the two strands exchanged, which is strictly higher; so it lies in `U_s`
(`StendhalAlgebra.dotPow_mem_upperSubmodule`), and the cyclotomic relation holds in `S_s`.

## Main definitions

* `Stendhal.blackCount`, `Stendhal.StendhalLE`, `Stendhal.StendhalLT`: Webster's preorder.
* `Stendhal.StendhalAlgebra.seqProj`, `upperSubmodule`, `StandardModule`: `P̃_s`, `U_s`, `S_s`.

## Main results

* `Stendhal.stendhalLT_sadj`: exchanging a red strand with the black strand to its right
  raises the sequence strictly.
* `Stendhal.StendhalAlgebra.dotPow_mem_upperSubmodule`: the cyclotomic step of Prop. 5.3.
-/

namespace Categorification.Stendhal

open KLR MulOpposite

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}

/-! ### Webster's preorder on sequences -/

section Preorder

variable {μ : Multiset (I ⊕ Fin ℓ)}

/-- The number of black `i`-strands of `s` left of the red strand `λ_r`. -/
def blackCount (s : Seq μ) (r : Fin ℓ) (i : I) : ℕ :=
  (Finset.univ.filter fun a => s.lbl a = .inl i ∧ ∀ b, s.lbl b = .inr r → a < b).card

/-- Webster's preorder (arXiv:1309.3796v3, §5.1): `s ≤ t` when, for every red strand, `t` has
at least as many black strands of each label to its left as `s`. -/
def StendhalLE (s t : Seq μ) : Prop :=
  ∀ r i, blackCount s r i ≤ blackCount t r i

/-- The strict part of Webster's preorder. -/
def StendhalLT (s t : Seq μ) : Prop :=
  StendhalLE s t ∧ ¬ StendhalLE t s

local notation "m" => Multiset.card μ

omit [DecidableEq I] in
theorem sadj_sadj_apply (j : ℕ) (a : Fin m) : TypeA.sadj m j (TypeA.sadj m j a) = a := by
  rw [← Equiv.Perm.mul_apply, KLRAlgebra.sadj_mul_self]; rfl

omit [DecidableEq I] in
theorem lbl_sadj (j : ℕ) (s : Seq μ) (a : Fin m) :
    (TypeA.sadj m j • s).lbl a = s.lbl (TypeA.sadj m j a) :=
  KLRAlgebra.sadj_smul_apply j s a

omit [DecidableEq I] in
theorem lbl_eq_of_val (s : Seq μ) {a b : Fin m} (h : a.val = b.val) : s.lbl a = s.lbl b := by
  rw [Fin.ext h]

/-- Counting the black strands of `sadj j • s` by the positions in `s`. -/
theorem blackCount_sadj (j : ℕ) (s : Seq μ) (r : Fin ℓ) (i : I) :
    blackCount (TypeA.sadj m j • s) r i =
      (Finset.univ.filter fun c => s.lbl c = .inl i ∧ ∀ d, s.lbl d = .inr r →
        TypeA.sadj m j c < TypeA.sadj m j d).card := by
  refine Finset.card_bij (fun a _ => TypeA.sadj m j a) ?_ ?_ ?_
  · intro a ha
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, lbl_sadj] at ha ⊢
    refine ⟨ha.1, fun d hd => ?_⟩
    rw [sadj_sadj_apply]
    exact ha.2 (TypeA.sadj m j d) (by rw [sadj_sadj_apply]; exact hd)
  · intro a _ b _ h
    simpa [sadj_sadj_apply] using congrArg (TypeA.sadj m j) h
  · intro c hc
    refine ⟨TypeA.sadj m j c, ?_, sadj_sadj_apply j c⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, lbl_sadj, sadj_sadj_apply] at hc ⊢
    refine ⟨hc.1, fun b hb => ?_⟩
    simpa [sadj_sadj_apply] using hc.2 (TypeA.sadj m j b) hb

variable {j : ℕ} {s : Seq μ} {r : Fin ℓ} {i : I}

omit [DecidableEq I] in
/-- A black strand left of a red strand stays left of it after exchanging the strands at
`j`, `j + 1`, unless these are a red strand at `j` and a black strand at `j + 1`. -/
theorem sadj_lt_sadj (h : j + 1 < m) (hr : s.lbl ⟨j, by omega⟩ = .inr r)
    (hi : s.lbl ⟨j + 1, h⟩ = .inl i)
    {c d : Fin m} {i' : I} {r' : Fin ℓ} (hc : s.lbl c = .inl i') (hd : s.lbl d = .inr r')
    (hcd : c < d) : TypeA.sadj m j c < TypeA.sadj m j d := by
  have hcj : c.val ≠ j := fun e => by
    rw [lbl_eq_of_val s (b := ⟨j, by omega⟩) e, hr] at hc; cases hc
  have hdj : d.val ≠ j + 1 := fun e => by
    rw [lbl_eq_of_val s (b := ⟨j + 1, h⟩) e, hi] at hd; cases hd
  rw [Fin.lt_def] at hcd ⊢
  rw [KLRAlgebra.sadj_apply_val h, KLRAlgebra.sadj_apply_val h]
  split_ifs <;> omega

/-- Exchanging a red strand `λ_r` with the black `i`-strand to its right moves the black strand
left, raising the sequence strictly in Webster's preorder (the red strand `λ_r` occurring only
at `j`). -/
theorem stendhalLT_sadj (h : j + 1 < m) (hr : s.lbl ⟨j, by omega⟩ = .inr r)
    (hi : s.lbl ⟨j + 1, h⟩ = .inl i)
    (hu : ∀ d, s.lbl d = .inr r → d = ⟨j, by omega⟩) :
    StendhalLT s (TypeA.sadj m j • s) := by
  have hsub : ∀ r' i', (Finset.univ.filter fun a : Fin m =>
      s.lbl a = .inl i' ∧ ∀ b, s.lbl b = .inr r' → a < b) ⊆
      Finset.univ.filter fun c => s.lbl c = .inl i' ∧ ∀ d, s.lbl d = .inr r' →
        TypeA.sadj m j c < TypeA.sadj m j d := by
    intro r' i' c hc
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hc ⊢
    exact ⟨hc.1, fun d hd => sadj_lt_sadj h hr hi hc.1 hd (hc.2 d hd)⟩
  have hle : StendhalLE s (TypeA.sadj m j • s) := fun r' i' => by
    rw [blackCount_sadj]; exact Finset.card_le_card (hsub r' i')
  refine ⟨hle, fun hge => ?_⟩
  have hlt : blackCount s r i < blackCount (TypeA.sadj m j • s) r i := by
    rw [blackCount_sadj]
    refine Finset.card_lt_card ⟨hsub r i, fun hs => ?_⟩
    have hmem : (⟨j + 1, h⟩ : Fin m) ∈ Finset.univ.filter fun c => s.lbl c = .inl i ∧
        ∀ d, s.lbl d = .inr r → TypeA.sadj m j c < TypeA.sadj m j d := by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      refine ⟨hi, fun d hd => ?_⟩
      rw [hu d hd, Fin.lt_def, KLRAlgebra.sadj_apply_val h, KLRAlgebra.sadj_apply_val h]
      simp
    have := hs hmem
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at this
    exact absurd (this.2 ⟨j, by omega⟩ hr) (by simp [Fin.lt_def])
  exact absurd (hge r i) (by omega)

end Preorder

/-- Each red label occurs at one position of a sequence of Stendhal strands. -/
theorem lbl_eq_inr_unique {ν : Multiset I} {s : Seq (stendhalWeight ℓ ν)}
    {a b : Fin (Multiset.card (stendhalWeight ℓ ν))} {r : Fin ℓ}
    (ha : s.lbl a = .inr r) (hb : s.lbl b = .inr r) : a = b := by
  classical
  have hcount : (Finset.univ.filter fun c => s.lbl c = .inr r).card = 1 := by
    have h1 : Multiset.count (.inr r) (Finset.univ.val.map s.lbl) = 1 := by
      rw [s.2, stendhalWeight, Multiset.count_add,
        Multiset.count_map_eq_count' _ _ Sum.inr_injective, Multiset.count_eq_zero.2]
      · simp
      · simp
    rw [Multiset.count_map] at h1
    rw [← h1, Finset.card_def, Finset.filter_val]
    congr 1
    exact Multiset.filter_congr fun c _ => eq_comm
  obtain ⟨c, hc⟩ := Finset.card_eq_one.1 hcount
  have ha' : a ∈ Finset.univ.filter fun c => s.lbl c = .inr r := by simp [ha]
  have hb' : b ∈ Finset.univ.filter fun c => s.lbl c = .inr r := by simp [hb]
  rw [hc, Finset.mem_singleton] at ha' hb'
  rw [ha', hb']

/-! ### The bigon through the higher sequence -/

/-- In a KLR algebra, the bigon `ψ_j ψ_j e(s)` factors through `e(sadj j • s)`. -/
theorem _root_.Categorification.KLR.KLRAlgebra.e_ψ_e_ψ_e {J : Type*} [DecidableEq J]
    {P : J → J → MvPolynomial (Fin 2) k} {ν' : Multiset J} (j : ℕ) (s : Seq ν') :
    (KLRAlgebra.e s * KLRAlgebra.ψ j * KLRAlgebra.e (TypeA.sadj (Multiset.card ν') j • s) *
        KLRAlgebra.ψ j * KLRAlgebra.e s : KLRAlgebra k P ν') =
      KLRAlgebra.ψ j * KLRAlgebra.ψ j * KLRAlgebra.e s := by
  set E := (KLRAlgebra.e s : KLRAlgebra k P ν')
  set F := (KLRAlgebra.e (TypeA.sadj (Multiset.card ν') j • s) : KLRAlgebra k P ν')
  set y := (KLRAlgebra.ψ j : KLRAlgebra k P ν')
  have h2 : y * F = E * y := by
    simp only [y, F, E]
    rw [KLRAlgebra.ψ_mul_e, KLRAlgebra.sadj_smul_smul]
  have hee : E * E = E := by
    simp only [E]
    rw [KLRAlgebra.e_mul_e, ite_eq_left_of_eq_true _ _ (eq_true rfl)]
  calc E * y * F * y * E = E * E * y * (y * E) := by
        rw [mul_assoc E, h2]; simp only [mul_assoc]
    _ = E * (y * y) * E := by
        rw [hee]; simp only [mul_assoc]
    _ = y * y * E := by
        simp only [y, E]
        rw [KLRAlgebra.e_mul_ψ_mul_ψ, mul_assoc]; exact congrArg _ hee

namespace StendhalAlgebraAllOrders

variable {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

/-- **The bigon through the higher sequence**: if the red strand `λ_r` at `j` is followed by a
black `i`-strand, then `y_{j+1}^{α_i^∨(λ_r)} e(s)` factors through `e(sadj j • s)`. -/
theorem dotPow_e_eq (j : ℕ) (h : j + 1 < m) (s : Seq μ) (i : I) (r : Fin ℓ)
    (hr : s.lbl ⟨j, by omega⟩ = .inr r) (hi : s.lbl ⟨j + 1, h⟩ = .inl i) :
    (x ⟨j + 1, h⟩ ^ Λ r i * e s : StendhalAlgebraAllOrders k Q Λ ν) =
      e s * ψ j * e (TypeA.sadj m j • s) * ψ j * e s := by
  rw [← ψ_sq_red_black j h s i r hr hi]
  have := congrArg (ofKLR k Q Λ ν)
    (KLRAlgebra.e_ψ_e_ψ_e (k := k) (P := stendhalQ Q Λ) j s)
  simpa only [map_mul, e, ψ] using this.symm

end StendhalAlgebraAllOrders

/-! ### Standard modules -/

namespace StendhalAlgebra

open StendhalAlgebraAllOrders (x ψ redOrderedIdem e_mul_redOrderedIdem redOrderedIdem_mul_e
  dotPow_e_eq)

variable {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "A" => StendhalAlgebra k Q Λ ν

/-- The element `e(s) y e(t)` of `T̃^λ`, for sequences `s`, `t` with red strands in order. -/
noncomputable def sandwich (s : Seq μ) (hs : IsRedOrdered s) (t : Seq μ) (ht : IsRedOrdered t)
    (y : StendhalAlgebraAllOrders k Q Λ ν) : A :=
  e s hs * ⟨redOrderedIdem k Q Λ ν * y * redOrderedIdem k Q Λ ν, y, rfl⟩ * e t ht

theorem coe_sandwich (s : Seq μ) (hs : IsRedOrdered s) (t : Seq μ) (ht : IsRedOrdered t)
    (y : StendhalAlgebraAllOrders k Q Λ ν) :
    (sandwich s hs t ht y).1 =
      StendhalAlgebraAllOrders.e s * y * StendhalAlgebraAllOrders.e t := by
  classical
  change StendhalAlgebraAllOrders.e s * (redOrderedIdem k Q Λ ν * y * redOrderedIdem k Q Λ ν) *
    StendhalAlgebraAllOrders.e t = _
  rw [← mul_assoc, ← mul_assoc, e_mul_redOrderedIdem, ite_eq_left_of_eq_true _ _ (eq_true hs),
    mul_assoc _ _
    (StendhalAlgebraAllOrders.e t), redOrderedIdem_mul_e, ite_eq_left_of_eq_true _ _ (eq_true ht)]

variable (Q Λ) in
/-- The right projective `P̃_s = e(s) T̃^λ`, as a right ideal of `T̃^λ`. -/
noncomputable def seqProj (s : Seq μ) (hs : IsRedOrdered s) : Submodule Aᵐᵒᵖ A :=
  Submodule.span Aᵐᵒᵖ {e s hs}

variable (Q Λ) in
/-- The submodule `U_s` of `P̃_s` generated by the images of the maps `P̃_t → P̃_s` with `t`
strictly above `s` (arXiv:1309.3796v3, Definition 5.1): the right ideal generated by the
elements `e(s) a e(t)`. -/
noncomputable def upperSubmodule (s : Seq μ) (hs : IsRedOrdered s) : Submodule Aᵐᵒᵖ A :=
  Submodule.span Aᵐᵒᵖ
    {z | ∃ (t : Seq μ) (ht : IsRedOrdered t) (a : A), StendhalLT s t ∧ z = e s hs * a * e t ht}

theorem e_mul_e_self (s : Seq μ) (hs : IsRedOrdered s) : (e s hs : A) * e s hs = e s hs := by
  apply Subtype.ext
  change (StendhalAlgebraAllOrders.e s : StendhalAlgebraAllOrders k Q Λ ν) *
    StendhalAlgebraAllOrders.e s = _
  rw [StendhalAlgebraAllOrders.e_mul_e, ite_eq_left_of_eq_true _ _ (eq_true rfl)]
  rfl

theorem upperSubmodule_le_seqProj (s : Seq μ) (hs : IsRedOrdered s) :
    upperSubmodule Q Λ s hs ≤ seqProj Q Λ s hs := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨t, ht, a, -, rfl⟩
  have : e s hs * a * e t ht = op (a * e t ht) • (e s hs : A) := by
    rw [op_smul_eq_mul, mul_assoc]
  rw [SetLike.mem_coe, this]
  exact Submodule.smul_mem _ _ (Submodule.subset_span rfl)

variable (Q Λ) in
/-- **The standard module** `S_s = P̃_s / U_s` of arXiv:1309.3796v3, Definition 5.1, as a right
`T̃^λ`-module. Since `U_s ⊆ P̃_s` (`upperSubmodule_le_seqProj`), it is realized as the image of
`P̃_s` in `T̃^λ / U_s`. -/
noncomputable def standardModule (s : Seq μ) (hs : IsRedOrdered s) :
    Submodule Aᵐᵒᵖ (A ⧸ upperSubmodule Q Λ s hs) :=
  (seqProj Q Λ s hs).map (upperSubmodule Q Λ s hs).mkQ

/-- **The cyclotomic step of Proposition 5.3** (arXiv:1309.3796v3, §5.1): if the red strand
`λ_r` is immediately followed by a black `i`-strand, then `y^{α_i^∨(λ_r)} e(s)`, with the dots
on the black strand, lies in `U_s`; so it acts by zero on the standard module. -/
theorem dotPow_mem_upperSubmodule {j : ℕ} (h : j + 1 < m) (s : Seq μ) (hs : IsRedOrdered s)
    (i : I) (r : Fin ℓ) (hr : s.lbl ⟨j, by omega⟩ = .inr r)
    (hi : s.lbl ⟨j + 1, h⟩ = .inl i) :
    sandwich s hs s hs (x ⟨j + 1, h⟩ ^ Λ r i) ∈ upperSubmodule Q Λ s hs := by
  have hs' := isRedOrdered_sadj hs h (Or.inr (by change (s.lbl _).isLeft; simp [hi]))
  set s' := TypeA.sadj m j • s
  have heq : sandwich s hs s hs (x ⟨j + 1, h⟩ ^ Λ r i) =
      (e s hs : A) * sandwich s hs s' hs' (ψ j) * e s' hs' * sandwich s' hs' s hs (ψ j) := by
    apply Subtype.ext
    change _ = (e s hs).1 * (sandwich s hs s' hs' (ψ j)).1 * (e s' hs').1 *
      (sandwich s' hs' s hs (ψ j)).1
    rw [coe_sandwich, coe_sandwich, coe_sandwich]
    change _ = StendhalAlgebraAllOrders.e s * (StendhalAlgebraAllOrders.e s * ψ j *
      StendhalAlgebraAllOrders.e s') * StendhalAlgebraAllOrders.e s' *
      (StendhalAlgebraAllOrders.e s' * ψ j * StendhalAlgebraAllOrders.e s)
    have hee : ∀ (t : Seq μ) (z : StendhalAlgebraAllOrders k Q Λ ν),
        StendhalAlgebraAllOrders.e t * (StendhalAlgebraAllOrders.e t * z) =
          StendhalAlgebraAllOrders.e t * z := fun t z => by
      rw [← mul_assoc, StendhalAlgebraAllOrders.e_mul_e,
        ite_eq_left_of_eq_true _ _ (eq_true rfl)]
    rw [mul_assoc (StendhalAlgebraAllOrders.e s), dotPow_e_eq j h s i r hr hi]
    simp only [mul_assoc, hee]
    rfl
  rw [heq, show (e s hs : A) * sandwich s hs s' hs' (ψ j) * e s' hs' *
      sandwich s' hs' s hs (ψ j) = op (sandwich s' hs' s hs (ψ j)) •
        ((e s hs : A) * sandwich s hs s' hs' (ψ j) * e s' hs') from
    (op_smul_eq_mul _ _).symm]
  exact Submodule.smul_mem _ _ (Submodule.subset_span
    ⟨s', hs', _, stendhalLT_sadj h hr hi (fun d hd => lbl_eq_inr_unique hd hr), rfl⟩)

end StendhalAlgebra

end Categorification.Stendhal
