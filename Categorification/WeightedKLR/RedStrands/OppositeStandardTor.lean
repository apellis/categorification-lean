import Categorification.Algebra.DerivedTensor
import Categorification.Algebra.OrdinaryProjectiveResolutionDG
import Categorification.WeightedKLR.RedStrands.LeftStandardModule

/-!
# Derived tensor with an opposite loading standard

In Webster, arXiv:1309.3796v2, §6.1, p. 65, the proof of Lemma 6.11
(`f_n → s_n`) tensors a projective resolution of a standard with an opposite
standard. Every loading projective in its higher terms is annihilated by that
opposite standard. This proves the vanishing implication for supplied models and
uses the vanishing of a higher loading idempotent on `leftStandard`.
-/

open CategoryTheory CategoryTheory.Limits DG DG.DerivedCategory MulOpposite
open scoped DG.DegreeZero

noncomputable section

namespace Categorification

universe w u

section Model

variable {A B M : Type u} [Ring A] [Ring B] [AddCommGroup M] [Module A M]
  [Module Bᵐᵒᵖ M] [SMulCommClass A Bᵐᵒᵖ M]
  [HasDerivedCategory.{w, u} A] [HasDerivedCategory.{w, u} B]

open TensorProductOver

omit [HasDerivedCategory B] in
private theorem tmul_eq_zero_of_loading
    {P : DGModuleCat.{u} B} {x : P}
    (hx : x ∈ Submodule.span B { y : P | ∃ e : B, e • y = y ∧
      ∀ m : M, op e • m = 0 }) (m : InDegreeZero M) :
    tmul B m x = 0 := by
  refine (Submodule.span_induction (p := fun y _ => ∀ m : InDegreeZero M, tmul B m y = 0)
    ?_ ?_ ?_ ?_ hx) m
  · rintro y ⟨e, hy, he⟩ m
    rw [← hy, ← op_smul_tmul, show op e • m = 0 from he m, zero_tmul]
  · exact tmul_zero
  · intro x y _ _ hx hy m
    rw [tmul_add, hx m, hy m, add_zero]
  · intro b x _ hx m
    rw [← op_smul_tmul]
    exact hx (op b • m)

omit [HasDerivedCategory B] in
private theorem tensor_grade_eq_zero_of_loading
    {P : DGModuleCat.{u} B} {n : ℤ}
    (hs : ∀ x : P, x ∈ grading n → x ∈ Submodule.span B { y : P |
      ∃ e : B, e • y = y ∧ ∀ m : M, op e • m = 0 })
    {z : TensorProductOver B (InDegreeZero M) P} (hz : z ∈ grading n) : z = 0 := by
  refine TensorProductOver.induction_on_mem_grading (P := fun z => z = 0) rfl ?_
    (fun _ _ hx hy => by rw [hx, hy, add_zero]) (fun _ hx => by rw [hx, neg_zero]) hz
  intro i j m x hm hx hij
  rcases (InDegreeZero.mem_grading_iff _).mp hm with rfl | rfl
  · simp only [zero_add] at hij
    subst j
    exact tmul_eq_zero_of_loading (hs _ hx) m
  · exact zero_tmul _

/-- Webster's Lemma 6.11, step f_n → s_n. On a supplied K-projective model
whose nonzero-degree terms are generated by loading summands killed by the ordinary
opposite standard, derived tensor cohomology vanishes away from degree zero. -/
theorem isZero_derivedTensorHomology_of_loading_annihilation
    {P S : DGModuleCat.{u} B} (hP : IsKProjective.{u} B P) (q : P ⟶ S)
    (hq : q.hom.IsQuasiIso)
    (hs : ∀ (n : ℤ), n ≠ 0 → ∀ x : P, x ∈ grading n →
      x ∈ Submodule.span B { y : P | ∃ e : B, e • y = y ∧
        ∀ m : M, op e • m = 0 })
    (n : ℤ) (hn : n ≠ 0) :
    IsZero ((homologyFunctor (A := A) ℤ n).obj ((derivedTensor A B M).obj (Q.obj S))) := by
  let W := (DGModuleCat.tensorFunctor (B := B) A (InDegreeZero M)).obj P
  let H := homologyFunctor (A := A) ℤ n
  have : IsIso (Q.map q) := (isIso_Q_map_iff q).mpr hq
  let e := H.mapIso ((derivedTensor A B M).mapIso (asIso (Q.map q)).symm ≪≫
    derivedTensorObjIso hP)
  apply IsZero.of_iso (Y := H.obj (Q.obj W)) _ e
  apply ModuleCat.isZero_iff_subsingleton.mpr
  have hz : ∀ z : cocycles W n, z = 0 := fun z => Subtype.ext
    (tensor_grade_eq_zero_of_loading (M := M) (hs n hn) (cocycles.mem_grading z))
  let : Subsingleton (cocycles W n) := ⟨fun x y => (hz x).trans (hz y).symm⟩
  have : Subsingleton (cohomology W n) := (cohomology.mk_surjective W n).subsingleton
  exact (cohomologyAddEquiv ℤ W n).symm.injective.subsingleton

/-- A supplied model with loading projective summands away from degree zero has
degree-zero derived tensor cohomology when the coefficient is killed by those loadings. -/
theorem isZero_derivedTensorHomology_of_loading_projective_summands
    {P S : DGModuleCat.{u} B} (hP : IsKProjective.{u} B P) (q : P ⟶ S)
    (hq : q.hom.IsQuasiIso)
    {ι : ℤ → Type*} (e : ∀ n, ι n → B) (he : ∀ n i, IsIdempotentElem (e n i))
    (summand : ∀ n i, lIdeal (e n i) →ₗ[B] P)
    (hspan : ∀ n : ℤ, n ≠ 0 → ∀ x : P, x ∈ grading n →
      x ∈ Submodule.span B { y | ∃ (i : ι n) (z : lIdeal (e n i)), summand n i z = y })
    (hkill : ∀ (n : ℤ), n ≠ 0 → ∀ (i : ι n) (m : M), op (e n i) • m = 0)
    (n : ℤ) (hn : n ≠ 0) :
    IsZero ((homologyFunctor (A := A) ℤ n).obj ((derivedTensor A B M).obj (Q.obj S))) := by
  refine isZero_derivedTensorHomology_of_loading_annihilation hP q hq ?_ n hn
  intro j hj x hx
  refine (Submodule.span_le.mpr ?_) (hspan j hj x hx)
  rintro y ⟨i, z, rfl⟩
  let u : lIdeal (e j i) := ⟨e j i, he j i⟩
  have hu : e j i • u = u := Subtype.ext (he j i).eq
  have hunit : e j i • summand j i u = summand j i u := by
    rw [← map_smul, hu]
  have hz : (z : B) • u = z := Subtype.ext z.2
  rw [← hz, map_smul]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨e j i, hunit, hkill j hj i⟩)


/-- An ordinary projective resolution with the prescribed loading support gives derived
tensor vanishing away from zero. -/
theorem isZero_derivedTensorHomology_of_projectiveResolution_loading_support
    {X : ModuleCat.{u} B} (P : ProjectiveResolution X)
    {ι : Type*} (e : ι → B) (good : ι → Prop)
    (he : ∀ i, IsIdempotentElem (e i))
    (hs : ∀ n : ℕ, ∃ (J : Type) (label : J → ι)
      (inc : ∀ i, lIdeal (e (label i)) →ₗ[B] P.complex.X (n+1)),
      (∀ i, good (label i)) ∧ ∀ x : P.complex.X (n+1),
        x ∈ Submodule.span B {y | ∃ i z, inc i z = y})
    (hkill : ∀ i, good i → ∀ m : M, op (e i) • m = 0)
    (n : ℤ) (hn : n ≠ 0) :
    IsZero ((homologyFunctor (A := A) ℤ n).obj
      ((derivedTensor A B M).obj (Q.obj (DGModuleCat.of B (InDegreeZero X))))) := by
  classical
  have h (j : ℤ) : ∃ (J : Type) (label : J → ι)
      (inc : ∀ i, lIdeal (e (label i)) →ₗ[B] projectiveResolutionDGModel P),
      (∀ i, good (label i)) ∧ (j ≠ 0 → ∀ x : projectiveResolutionDGModel P,
        x ∈ grading j → x ∈ Submodule.span B {y | ∃ i z, inc i z = y}) := by
    by_cases hj : j = 0
    · exact ⟨Empty, Empty.elim, fun i => i.elim, fun i => i.elim, fun h => (h hj).elim⟩
    · obtain ⟨J, label, inc, hl, hspan⟩ := projectiveResolutionDGModel_loading_support P e good hs j hj
      exact ⟨J, label, inc, hl, fun _ => hspan⟩
  choose J label inc hl hspan using h
  exact isZero_derivedTensorHomology_of_loading_projective_summands
    (projectiveResolutionDGModel_kProjective P) (projectiveResolutionDGAugToOrdinary P)
    (projectiveResolutionDGAugToOrdinary_quasiIso P)
    (fun j i => e (label j i)) (fun j i => he (label j i)) inc hspan
    (fun j _ i m => hkill _ (hl j i) m) n hn


end Model

namespace Stendhal

open KLR

variable {I k : Type} [DecidableEq I] [Field k] {ℓ : ℕ} {ν : Multiset I}
    (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)

local notation "T" => TensorProductAlgebra k Q Λ ν

/-- Webster's Lemma 6.11, p. 65, step f_n → s_n for a fixed opposite loading
standard. The higher terms of the supplied resolution are covered by loading
projectives strictly above its label in Webster's order. -/
theorem isZero_derivedRightTensorHomology_leftStandard_of_higher_loadings
    [HasDerivedCategory.{w, 0} Tᵐᵒᵖ] [HasDerivedCategory.{w, 0} ℤ]
    {s : Seq (stendhalWeight ℓ ν)} (hs : IsRedOrdered s)
    {P S : DGModuleCat.{0} Tᵐᵒᵖ} (hP : IsKProjective.{0} Tᵐᵒᵖ P) (q : P ⟶ S)
    (hq : q.hom.IsQuasiIso)
    {ι : ℤ → Type*} (label : ∀ n, ι n → {t : Seq (stendhalWeight ℓ ν) // IsRedOrdered t})
    (summand : ∀ n i, lIdeal (op (seqIdem Q Λ (label n i).1 (label n i).2)) →ₗ[Tᵐᵒᵖ] P)
    (hspan : ∀ n : ℤ, n ≠ 0 → ∀ x : P, x ∈ grading n →
      x ∈ Submodule.span Tᵐᵒᵖ { y | ∃ i z, summand n i z = y })
    (hlabel : ∀ (n : ℤ), n ≠ 0 → ∀ i : ι n, StendhalLT s (label n i).1)
    (n : ℤ) (hn : n ≠ 0) :
    IsZero ((homologyFunctor (A := ℤ) ℤ n).obj
      ((derivedTensor ℤ Tᵐᵒᵖ (OpBimodule T (leftStandard Q Λ s hs))).obj (DG.DerivedCategory.Q.obj S))) := by
  refine isZero_derivedTensorHomology_of_loading_projective_summands
    (A := ℤ) (B := Tᵐᵒᵖ) (M := OpBimodule T (leftStandard Q Λ s hs))
    hP q hq (fun j i => op (seqIdem Q Λ (label j i).1 (label j i).2)) ?_
    summand hspan ?_ n hn
  · intro j i
    change IsIdempotentElem (op (seqIdem Q Λ (label j i).1 (label j i).2))
    exact congrArg op (seqIdem_mul_self Q Λ (label j i).1 (label j i).2)
  · intro j hj i m
    change seqIdem Q Λ (label j i).1 (label j i).2 • (m : leftStandard Q Λ s hs) = 0
    exact seqIdem_smul_leftStandard_eq_zero Q Λ hs (label j i).2 (hlabel j hj i) m

end Stendhal

end Categorification
