/-!
# Graded ordered resolutions in a reflected braid corner

For Webster, arXiv:1309.3796v2, Lemma 6.11, transport the homogeneous
ordered-cover quotient along the left coefficient equivalence. The negative
terms are generated by the actual higher red-order loading projectors.
-/

noncomputable section

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open CategoryTheory KLR QuantumGroup DG ModuleFiltration MulOpposite
open scoped DG.DegreeZero
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

universe v

variable {I k : Type} [DecidableEq I] [Field k] {ℓ : ℕ} {ν : Multiset I}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ}
  {cartan : CartanDatum I} (hR : IsRouquierQ cartan Q)
  (σ : Equiv.Perm (Fin ℓ))
  {ρ : Equiv.Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : TypeA.IsReducedChoice ρ) (hQ : KLRSymm Q)

private abbrev coefficientGrading (Ω : Fin ℓ → I →₀ ℕ) : KLR.GradingDatum (stendhalQ Q Ω) :=
  stendhalGradingDatum Ω hR.gradingDatum (UDot.di cartan)
    (fun i => (hR.gradingDatum_degX i).trans (UDot.two_mul_di cartan i).symm)

local notation "κ" => List.map σ (List.finRange ℓ)
local notation "C" => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ
local notation "D" => TensorProductAlgebra k Q (Λ ∘ σ) ν
local notation "G" => coefficientGrading hR Λ
local notation "G'" => coefficientGrading hR (Λ ∘ σ)
local notation "V" => violAuxiliaryGrade (ν := ν) G
local notation "hE" => isIdempotentElem_violMk_redProj k Q Λ ν κ
local notation "CG" => Graded.oppositeGrade (Graded.cornerGrading V hE)
local notation "DG'" => tensorProductGrade (G') ν
local notation "ψ" => leftCoefficientEquiv (Λ := Λ) hρ hQ σ
private abbrev OrderedLoading (l : ℕ) (weight : Multiset I) :=
  {t : Seq (stendhalWeight l weight) // IsRedOrdered t}

local notation "Label" => OrderedLoading ℓ ν

private abbrev standardModule (Q : I → I → MvPolynomial (Fin 2) k)
    (Ω : Fin ℓ → I →₀ ℕ) (s : Label) :=
  ModuleCat.of (TensorProductAlgebra k Q Ω ν) (leftStandard Q Ω s.1 s.2)

local notation "Std" => standardModule (ν := ν) Q (Λ ∘ σ)
private abbrev loadingIdem (Q : I → I → MvPolynomial (Fin 2) k)
    (Ω : Fin ℓ → I →₀ ℕ) (t : Label) := seqIdem Q Ω t.1 t.2

private abbrev loadingOrder (t u : Label) := StendhalLT t.1 u.1

local notation "e" => loadingIdem (ν := ν) Q (Λ ∘ σ)
local notation "above" => loadingOrder (ℓ := ℓ) (ν := ν)

private abbrev standardKernel (Q : I → I → MvPolynomial (Fin 2) k)
    (Ω : Fin ℓ → I →₀ ℕ) (t : Label) :=
  (leftUpper Q Ω t.1 t.2).comap (lIdeal (seqIdem Q Ω t.1 t.2)).subtype

variable (hU : ∀ t : OrderedLoading ℓ ν, ∃ m : List (OrderedLoading ℓ ν),
  (∀ u ∈ m, StendhalLT t.1 u.1) ∧
    HasFiltration (standardModule Q (Λ ∘ σ)) m
      (ModuleCat.of (TensorProductAlgebra k Q (Λ ∘ σ) ν) (standardKernel Q (Λ ∘ σ) t)))
  (s : OrderedLoading ℓ ν)

local notation "data" => orderedStandardCovers Q (Λ ∘ σ) hU

private abbrev standardGrade (Ω : Fin ℓ → I →₀ ℕ)
    (grading : KLR.GradingDatum (stendhalQ Q Ω)) (t : Label) (n : ℤ) :
    AddSubgroup (standardModule Q Ω t) :=
  (gradedLeftStandard grading t.1 t.2 n).toAddSubgroup

local instance instReflectedStandardGradeDecomposition :
    DirectSum.Decomposition (standardGrade (Λ ∘ σ) G' s) := by
  let Γ := gradedLeftStandard G' s.1 s.2
  let _ : DirectSum.Decomposition Γ := gradedLeftStandardDecomposition G' s.1 s.2
  exact {
    decompose' := DirectSum.Decomposition.decompose' (ℳ := Γ)
    left_inv := DirectSum.Decomposition.left_inv (ℳ := Γ)
    right_inv := DirectSum.Decomposition.right_inv (ℳ := Γ) }

private theorem coefficientHomogeneous {i : ℤ} {a : Cᵐᵒᵖ}
    (ha : a.unop.val ∈ V i) : ψ a ∈ DG' i := by
  simpa only [op_unop] using
    (leftCoefficientEquiv_mem_grade_iff (Λ := Λ) hR σ hρ hQ a.unop).mpr ha

private theorem coefficientInvHomogeneous {i : ℤ} {b : D}
    (hb : b ∈ DG' i) : ((ψ).symm b).unop.val ∈ V i := by
  apply (leftCoefficientEquiv_mem_grade_iff (Λ := Λ) hR σ hρ hQ ((ψ).symm b).unop).mp
  simpa only [op_unop, RingEquiv.apply_symm_apply] using hb

private theorem loadingOrder_trans (s t u : Label) (hst : above s t) (htu : above t u) :
    above s u :=
  ⟨fun r i => (hst.1 r i).trans (htu.1 r i), fun hus =>
    hst.2 (fun r i => (htu.1 r i).trans (hus r i))⟩

local notation "T" => transportedStandardGrading (RingEquiv.symm ψ) s (standardGrade (Λ ∘ σ) G' s)
local notation "Dₛ" => OrderedStandardCovers.transport data (RingEquiv.symm ψ)
local notation "Sₛ" => fun t : Label =>
  CategoryTheory.Functor.obj (ModuleCat.restrictScalars (RingEquiv.toRingHom (RingEquiv.symm (RingEquiv.symm ψ)))) (Std t)

local instance instReflectedWeightGradeDecomposition : DirectSum.Decomposition T :=
  instReflectedStandardGradeDecomposition hR σ s

private theorem reflectedStandardSmul {i j : ℤ} {a : Cᵐᵒᵖ} {x : Sₛ s}
    (ha : a.unop.val ∈ V i) (hx : x ∈ T j) : a • x ∈ T (i+j) :=
  gradedLeftStandard_smul_mem G' s.1 s.2 (coefficientHomogeneous hR σ hρ hQ ha) hx

/-- The diagrammatic left standard restricted to the opposite red-order corner
and retaining the quotient's internal grading. -/
def reflectedStandardWeightModule :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    CatModule (WeightCategory (hE).Cornerᵐᵒᵖ) := by
  letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  letI := gradedAlgebraInternalGrading CG
  letI := gradedAlgebraBigradedDGRing CG
  letI : DirectSum.Decomposition T := instReflectedWeightGradeDecomposition hR σ hρ hQ s
  exact orderedWeightDgTarget (S := Sₛ) s T
    (fun {_ _ _ _} ha hx => reflectedStandardSmul hR σ hρ hQ s ha hx)

private theorem reflectedLoading_mem_grade (t : Label) :
    ((ψ).symm (e t)).unop.val ∈ V 0 :=
  coefficientInvHomogeneous hR σ hρ hQ
    (mk_e_mem_tensorProductGrade G' ν t.1 t.2)

private theorem reflectedLoading_idempotent (t : Label) : IsIdempotentElem ((ψ).symm (e t)) := by
  change (ψ).symm (e t) * (ψ).symm (e t) = (ψ).symm (e t)
  rw [← map_mul, seqIdem_mul_self]

private theorem reflectedQuotient_mem_grade {j : ℤ} {x : lIdeal ((ψ).symm (e s))}
    (hx : x.val.unop.val ∈ V j) : (Dₛ).quotient s x ∈ T j := by
  let _ := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  let _ := gradedAlgebraInternalGrading CG
  let _ := gradedAlgebraInternalGrading DG'
  exact (data).transport_quotient_mem_weight (ψ).symm s (standardGrade (Λ ∘ σ) G' s)
    (fun h => coefficientHomogeneous hR σ hρ hQ h)
    (fun h => gradedLeftStandard_mkQ_mem G' s.1 s.2 _ h) hx

/-- The ordered resolution of the restricted standard over the opposite diagram corner. -/
def reflectedStandardWeightResolution :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    CatModule (WeightCategory (hE).Cornerᵐᵒᵖ) := by
  letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  letI := gradedAlgebraInternalGrading CG
  letI := gradedAlgebraBigradedDGRing CG
  exact orderedWeightDgResolution Dₛ s (reflectedLoading_mem_grade hR σ hρ hQ)
    (reflectedLoading_idempotent σ hρ hQ) loadingOrder_trans T
    (fun {_ _} h => reflectedQuotient_mem_grade hR σ hρ hQ hU s h)

theorem reflectedStandardWeightResolution_isKProjective :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    CatModule.IsKProjective (reflectedStandardWeightResolution hR σ hρ hQ hU s) := by
  let _ := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  let _ := gradedAlgebraInternalGrading CG
  let _ := gradedAlgebraBigradedDGRing CG
  exact orderedWeightDgResolution_isKProjective Dₛ s (reflectedLoading_mem_grade hR σ hρ hQ)
    (reflectedLoading_idempotent σ hρ hQ) loadingOrder_trans T
    (fun {_ _} h => reflectedQuotient_mem_grade hR σ hρ hQ hU s h)

/-- Augmentation by the homogeneous, scalar-restricted standard quotient. -/
def reflectedStandardWeightAugmentation :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    reflectedStandardWeightResolution hR σ hρ hQ hU s ⟶
      reflectedStandardWeightModule hR σ hρ hQ s := by
  letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  letI := gradedAlgebraInternalGrading CG
  letI := gradedAlgebraBigradedDGRing CG
  exact orderedWeightDgAugmentation Dₛ s (reflectedLoading_mem_grade hR σ hρ hQ)
    (reflectedLoading_idempotent σ hρ hQ) loadingOrder_trans T
    (fun {_ _ _ _} ha hx => reflectedStandardSmul hR σ hρ hQ s ha hx)
    (fun {_ _} h => reflectedQuotient_mem_grade hR σ hρ hQ hU s h)

theorem reflectedStandardWeightAugmentation_quasiIso :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    CatModule.IsQuasiIso (reflectedStandardWeightAugmentation hR σ hρ hQ hU s) := by
  let _ := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  let _ := gradedAlgebraInternalGrading CG
  let _ := gradedAlgebraBigradedDGRing CG
  exact orderedWeightDgAugmentation_quasiIso Dₛ s (reflectedLoading_mem_grade hR σ hρ hQ)
    (reflectedLoading_idempotent σ hρ hQ) loadingOrder_trans T
    (fun {_ _ _ _} ha hx => reflectedStandardSmul hR σ hρ hQ s ha hx)
    (fun {_ _} h => reflectedQuotient_mem_grade hR σ hρ hQ hU s h)

private theorem reflectedLoading_eq (t : Label) :
    (ψ).symm (e t) = op (violLoadingIdem (k := k) (Q := Q) (Λ := Λ) (redWord_relabel σ t.2)) := by
  apply (ψ).injective
  rw [RingEquiv.apply_symm_apply]
  exact (leftCoefficientEquiv_loadingIdem hρ hQ σ t.2).symm

theorem reflectedStandardWeightResolution_loading_support :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    ∀ (n : ℕ) (X : WeightCategory (hE).Cornerᵐᵒᵖ)
      (x : (reflectedStandardWeightResolution hR σ hρ hQ hU s).obj X),
      x ∈ DG.grading (-((n + 1 : ℕ) : ℤ)) →
      x ∈ AddSubgroup.closure (diagramWeightLoadingGenerators
        (reflectedStandardWeightResolution hR σ hρ hQ hU s)
        (fun Z (i : {i : Label // above s i}) =>
          auxiliaryGradedLoadingHom G (redWord_relabel σ i.1.2) Z) X) := by
  let _ := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  let _ := gradedAlgebraInternalGrading CG
  let _ := gradedAlgebraBigradedDGRing CG
  intro n X x hx
  have hl (Z : WeightCategory (hE).Cornerᵐᵒᵖ) (i : {i : Label // above s i}) :
      WeightCategory.homMk (A := (hE).Cornerᵐᵒᵖ) (k := Z) (l := Z)
        ((ψ).symm (e i.1)) (by
          rw [sub_self]
          change ((ψ).symm (e i.1)).unop.val ∈ V 0
          exact reflectedLoading_mem_grade hR σ hρ hQ i.1) =
      auxiliaryGradedLoadingHom G (redWord_relabel σ i.1.2) Z := by
    apply WeightCategory.hom_ext
    exact reflectedLoading_eq σ hρ hQ i.1
  simp_rw [← hl]
  exact orderedWeightDgResolution_loading_support Dₛ s (reflectedLoading_mem_grade hR σ hρ hQ)
    (reflectedLoading_idempotent σ hρ hQ) loadingOrder_trans T
    (fun {_ _} h => reflectedQuotient_mem_grade hR σ hρ hQ hU s h) n X x hx

local notation "TargetGrade" c:arg =>
  Graded.oppositeGrade (Graded.cornerGrading V (isIdempotentElem_violMk_redProj k Q Λ ν c))

include hU in
/-- Higher left loading annihilation gives negative cohomology vanishing for
the auxiliary graded braid of the scalar-restricted standard. -/
theorem reflectedStandardWeightBraiding_negative_isZero (κ' : List (Fin ℓ)) :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := Graded.cornerGradedAlgebra V (isIdempotentElem_violMk_redProj k Q Λ ν κ')
      (redProj_mem_violAuxiliaryGrade G κ')
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraInternalGrading (TargetGrade κ')
    letI := gradedAlgebraBigradedDGRing CG
    letI := gradedAlgebraBigradedDGRing (TargetGrade κ')
    ∀ [CatModule.HasDerivedCategory.{v,0} (WeightCategory (hE).Cornerᵐᵒᵖ)]
      [CatModule.HasDerivedCategory.{v,0}
        (WeightCategory (isIdempotentElem_violMk_redProj k Q Λ ν κ').Cornerᵐᵒᵖ)]
      (X : WeightCategory (isIdempotentElem_violMk_redProj k Q Λ ν κ').Cornerᵐᵒᵖ) (n : ℕ),
      (∀ t : Label, above s t → ∀ p : braidingBimodule k Q Λ ν κ κ',
        (violLoadingIdem (redWord_relabel σ t.2)).val * p.val = 0) →
      CategoryTheory.Limits.IsZero
        ((CatModule.DerivedCategory.cohomologyFunctor X (-((n + 1 : ℕ) : ℤ))).obj
          ((auxiliaryGradedBraidingFunctor G κ κ').obj
            (CatModule.DerivedCategory.Q.obj (reflectedStandardWeightModule hR σ hρ hQ s)))) := by
  intro hSource hTarget X n hk
  exact auxiliaryGradedBraiding_cohomology_isZero_of_loading_support G κ κ'
    (reflectedStandardWeightAugmentation hR σ hρ hQ hU s)
    (reflectedStandardWeightResolution_isKProjective hR σ hρ hQ hU s)
    (reflectedStandardWeightAugmentation_quasiIso hR σ hρ hQ hU s)
    X (-((n + 1 : ℕ) : ℤ))
    (ι := {t : Label // above s t}) (fun t => ⟨Seq.redPerm σ t.1.1, redWord_relabel σ t.1.2⟩)
    (reflectedStandardWeightResolution_loading_support hR σ hρ hQ hU s n)
    (fun t => hk t.1 t.2)

/-- Cohomology at a specified weight of the graded braid of the reflected standard. -/
def reflectedStandardWeightBraidingCohomology (κ' : List (Fin ℓ)) :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := Graded.cornerGradedAlgebra V (isIdempotentElem_violMk_redProj k Q Λ ν κ')
      (redProj_mem_violAuxiliaryGrade G κ')
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraInternalGrading (TargetGrade κ')
    letI := gradedAlgebraBigradedDGRing CG
    letI := gradedAlgebraBigradedDGRing (TargetGrade κ')
    ∀ [CatModule.HasDerivedCategory.{v,0} (WeightCategory (hE).Cornerᵐᵒᵖ)]
      [CatModule.HasDerivedCategory.{v,0}
        (WeightCategory (isIdempotentElem_violMk_redProj k Q Λ ν κ').Cornerᵐᵒᵖ)]
      (_X : WeightCategory (isIdempotentElem_violMk_redProj k Q Λ ν κ').Cornerᵐᵒᵖ) (_n : ℤ),
      AddCommGrpCat := by
  letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  letI := Graded.cornerGradedAlgebra V (isIdempotentElem_violMk_redProj k Q Λ ν κ')
    (redProj_mem_violAuxiliaryGrade G κ')
  letI := gradedAlgebraInternalGrading CG
  letI := gradedAlgebraInternalGrading (TargetGrade κ')
  letI := gradedAlgebraBigradedDGRing CG
  letI := gradedAlgebraBigradedDGRing (TargetGrade κ')
  intro hSource hTarget X n
  exact ((CatModule.DerivedCategory.cohomologyFunctor X n).obj
          ((auxiliaryGradedBraidingFunctor G κ κ').obj
            (CatModule.DerivedCategory.Q.obj (reflectedStandardWeightModule hR σ hρ hQ s))))

include hU in
/-- Higher left loading annihilation gives nonzero-degree cohomology vanishing for
the auxiliary graded braid of the scalar-restricted standard. -/
theorem reflectedStandardWeightBraiding_isZero (κ' : List (Fin ℓ)) :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := Graded.cornerGradedAlgebra V (isIdempotentElem_violMk_redProj k Q Λ ν κ')
      (redProj_mem_violAuxiliaryGrade G κ')
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraInternalGrading (TargetGrade κ')
    letI := gradedAlgebraBigradedDGRing CG
    letI := gradedAlgebraBigradedDGRing (TargetGrade κ')
    ∀ [CatModule.HasDerivedCategory.{v,0} (WeightCategory (hE).Cornerᵐᵒᵖ)]
      [CatModule.HasDerivedCategory.{v,0}
        (WeightCategory (isIdempotentElem_violMk_redProj k Q Λ ν κ').Cornerᵐᵒᵖ)]
      (X : WeightCategory (isIdempotentElem_violMk_redProj k Q Λ ν κ').Cornerᵐᵒᵖ) (n : ℤ),
      n ≠ 0 →
      (∀ t : Label, above s t → ∀ p : braidingBimodule k Q Λ ν κ κ',
        (violLoadingIdem (redWord_relabel σ t.2)).val * p.val = 0) →
      CategoryTheory.Limits.IsZero
        (reflectedStandardWeightBraidingCohomology hR σ hρ hQ s κ' X n) := by
  intro hSource hTarget X n hn hk
  unfold reflectedStandardWeightBraidingCohomology
  let _ := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  let _ := gradedAlgebraInternalGrading CG
  let _ := gradedAlgebraBigradedDGRing CG
  refine auxiliaryGradedBraiding_cohomology_isZero_of_loading_support G κ κ'
    (reflectedStandardWeightAugmentation hR σ hρ hQ hU s)
    (reflectedStandardWeightResolution_isKProjective hR σ hρ hQ hU s)
    (reflectedStandardWeightAugmentation_quasiIso hR σ hρ hQ hU s)
    X n (ι := {t : Label // above s t})
    (fun t => ⟨Seq.redPerm σ t.1.1, redWord_relabel σ t.1.2⟩) ?_
    (fun t => hk t.1 t.2)
  intro Z x hx
  by_cases hp : 0 < n
  · have hzero := orderedWeightDgResolution_positive_eq_zero Dₛ s
      (reflectedLoading_mem_grade hR σ hρ hQ)
      (reflectedLoading_idempotent σ hρ hQ) loadingOrder_trans T
      (fun {_ _} h => reflectedQuotient_mem_grade hR σ hρ hQ hU s h) Z n hp x hx
    rw [hzero]
    exact AddSubgroup.zero_mem _
  · let j := (-(n+1)).toNat
    have hj : -((j+1 : ℕ) : ℤ) = n := by dsimp [j]; omega
    exact reflectedStandardWeightResolution_loading_support hR σ hρ hQ hU s j Z x
      (by rw [hj]; exact hx)

/-- The literal opposite-corner resolution of the reflected standard
preserves acyclicity of the other coend input (Webster v2, Lemma 6.11). -/
theorem reflectedStandardWeightResolution_tensor_acyclic :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    ∀ (N : CatModule.{0} (DGOpposite (WeightCategory (hE).Cornerᵐᵒᵖ))),
      CatModule.IsAcyclic N →
      DG.IsAcyclic (CatTensorProduct N (reflectedStandardWeightResolution hR σ hρ hQ hU s)) := by
  let _ := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  let _ := gradedAlgebraInternalGrading CG
  let _ := gradedAlgebraBigradedDGRing CG
  intro N hN
  exact orderedWeightDgResolution_tensor_acyclic Dₛ s (reflectedLoading_mem_grade hR σ hρ hQ)
    (reflectedLoading_idempotent σ hρ hQ) loadingOrder_trans T
    (fun {_ _} h => reflectedQuotient_mem_grade hR σ hρ hQ hU s h) N hN
    (fun f => WeightCategory.mem_grading_iff.mpr (mem_degreeZeroGrading_zero _ f.val))

local notation "OG" => Graded.cornerGrading V hE

/-- Viewed as a right module over the original corner, the reflected ordered
model can be used as a resolution in the first tensor argument. -/
def reflectedStandardRightWeightResolution :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading OG
    letI := gradedAlgebraBigradedDGRing OG
    CatModule (DGOpposite (WeightCategory (hE).Corner)) := by
  letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  letI := gradedAlgebraInternalGrading OG
  letI := gradedAlgebraBigradedDGRing OG
  letI := gradedAlgebraInternalGrading CG
  letI := gradedAlgebraBigradedDGRing CG
  let F := oppositeWeightFunctor OG
  letI : F.Additive := oppositeWeightFunctor_additive OG
  letI : F.IsDGFunctor := oppositeWeightFunctor_isDGFunctor OG
  exact CatModule.precompObj F (reflectedStandardWeightResolution hR σ hρ hQ hU s)

/-- After opposite-weight restriction, the reflected ordered model retains
the coend acyclicity needed for Webster v2, Lemma 6.11. -/
theorem reflectedStandardRightWeightResolution_tensor_acyclic :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading OG
    letI := gradedAlgebraBigradedDGRing OG
    ∀ (N : CatModule.{0} (DGOpposite (DGOpposite (WeightCategory (hE).Corner)))),
      CatModule.IsAcyclic N →
      DG.IsAcyclic (CatTensorProduct N
        (reflectedStandardRightWeightResolution hR σ hρ hQ hU s)) := by
  let _ := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  let _ := gradedAlgebraInternalGrading OG
  let _ := gradedAlgebraBigradedDGRing OG
  let _ := gradedAlgebraInternalGrading CG
  let _ := gradedAlgebraBigradedDGRing CG
  let F := oppositeWeightFunctor OG
  let _ : F.Additive := oppositeWeightFunctor_additive OG
  let _ : F.IsDGFunctor := oppositeWeightFunctor_isDGFunctor OG
  let M := reflectedStandardWeightResolution hR σ hρ hQ hU s
  have hsource {X Y : DGOpposite (WeightCategory (hE).Corner)} (f : X ⟶ Y) :
      f ∈ DG.grading (0 : ℤ) :=
    WeightCategory.mem_grading_iff.mpr (mem_degreeZeroGrading_zero _ (DGOpposite.homUnop f).val)
  have htarget {X Y : WeightCategory (hE).Cornerᵐᵒᵖ} (f : X ⟶ Y) :
      f ∈ DG.grading (0 : ℤ) :=
    WeightCategory.mem_grading_iff.mpr (mem_degreeZeroGrading_zero _ f.val)
  intro N hN
  change DG.IsAcyclic (CatTensorProduct N (CatModule.precompObj F M))
  exact CatTensorProduct.isAcyclic_precomp_of_coend F hsource htarget
    (oppositeWeightFunctor_bijective OG) (oppositeWeightFullyFaithful OG) M
    (reflectedStandardWeightResolution_tensor_acyclic hR σ hρ hQ hU s) N hN

/-- Restriction of the reflected augmentation to the original right-module
weight category preserves its objectwise quasi-isomorphism. -/
theorem reflectedStandardRightWeightAugmentation_quasiIso :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading OG
    letI := gradedAlgebraBigradedDGRing OG
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    let F := oppositeWeightFunctor OG
    letI : F.Additive := oppositeWeightFunctor_additive OG
    letI : F.IsDGFunctor := oppositeWeightFunctor_isDGFunctor OG
    CatModule.IsQuasiIso ((CatModule.precomp F).map
      (reflectedStandardWeightAugmentation hR σ hρ hQ hU s)) := by
  let _ := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  let _ := gradedAlgebraInternalGrading OG
  let _ := gradedAlgebraBigradedDGRing OG
  let _ := gradedAlgebraInternalGrading CG
  let _ := gradedAlgebraBigradedDGRing CG
  let F := oppositeWeightFunctor OG
  let _ : F.Additive := oppositeWeightFunctor_additive OG
  let _ : F.IsDGFunctor := oppositeWeightFunctor_isDGFunctor OG
  change CatModule.IsQuasiIso ((CatModule.precomp F).map
    (reflectedStandardWeightAugmentation hR σ hρ hQ hU s))
  exact fun X n => reflectedStandardWeightAugmentation_quasiIso hR σ hρ hQ hU s (F.obj X) n

section StandardPairBalance

variable (t : OrderedLoading ℓ ν) (hSym : ∀ i j, (G).degΨ i j = (G).degΨ j i)

local notation "O" => C
local notation "Fop" => oppositeWeightFunctor OG
local notation "flipRing" => RingEquiv.symm (cornerFlipEquiv (Q := Q) (Λ := Λ) ν κ)

/-- Resolving either reflected standard computes the same coend cohomology.
The left coefficient uses the degree-preserving horizontal reflection. -/
def reflectedStandardPairCohomologyEquiv (j : ℤ) :
    letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
    letI := gradedAlgebraInternalGrading OG
    letI := gradedAlgebraBigradedDGRing OG
    letI := gradedAlgebraInternalGrading CG
    letI := gradedAlgebraBigradedDGRing CG
    let hgrade : ∀ {n : ℤ} (a : O), flipRing a ∈ wgrading (M := Oᵐᵒᵖ) n ↔ a ∈ wgrading (M := O) n :=
      fun {n} a => by
        have h := (cornerFlipEquiv_mem_violAuxiliaryGrade_iff G hSym κ n (flipRing a)).symm
        rw [RingEquiv.apply_symm_apply] at h
        exact h
    let F := weightFunctorOfRingEquiv flipRing hgrade
    letI : F.Additive := weightFunctorOfRingEquiv_additive flipRing hgrade
    letI : F.IsDGFunctor := weightFunctorOfRingEquiv_isDGFunctor flipRing hgrade
    letI : (Fop).Additive := oppositeWeightFunctor_additive OG
    letI : (Fop).IsDGFunctor := oppositeWeightFunctor_isDGFunctor OG
    DG.cohomology (CatTensorProduct
      (CatModule.precompObj Fop (reflectedStandardWeightModule hR σ hρ hQ s))
      (CatModule.precompObj F (reflectedStandardWeightResolution hR σ hρ hQ hU t))) j ≃+
    DG.cohomology (CatTensorProduct
      (reflectedStandardRightWeightResolution hR σ hρ hQ hU s)
      (CatModule.precompObj F (reflectedStandardWeightModule hR σ hρ hQ t))) j := by
  letI := Graded.cornerGradedAlgebra V hE (redProj_mem_violAuxiliaryGrade G κ)
  letI := gradedAlgebraInternalGrading OG
  letI := gradedAlgebraBigradedDGRing OG
  letI := gradedAlgebraInternalGrading CG
  letI := gradedAlgebraBigradedDGRing CG
  have hgrade {n : ℤ} (a : O) : flipRing a ∈ wgrading (M := Oᵐᵒᵖ) n ↔ a ∈ wgrading (M := O) n := by
    have h := (cornerFlipEquiv_mem_violAuxiliaryGrade_iff G hSym κ n (flipRing a)).symm
    rw [RingEquiv.apply_symm_apply] at h
    exact h
  let F := weightFunctorOfRingEquiv flipRing hgrade
  letI : F.Additive := weightFunctorOfRingEquiv_additive flipRing hgrade
  letI : F.IsDGFunctor := weightFunctorOfRingEquiv_isDGFunctor flipRing hgrade
  letI : (Fop).Additive := oppositeWeightFunctor_additive OG
  letI : (Fop).IsDGFunctor := oppositeWeightFunctor_isDGFunctor OG
  let f := (CatModule.precomp Fop).map (reflectedStandardWeightAugmentation hR σ hρ hQ hU s)
  let g := (CatModule.precomp F).map (reflectedStandardWeightAugmentation hR σ hρ hQ hU t)
  have hf : CatModule.IsQuasiIso f :=
    reflectedStandardRightWeightAugmentation_quasiIso hR σ hρ hQ hU s
  have hg : CatModule.IsQuasiIso g := fun X n =>
    reflectedStandardWeightAugmentation_quasiIso hR σ hρ hQ hU t (F.obj X) n
  have h₀ {X Y : WeightCategory O} (p : X ⟶ Y) : p ∈ DG.grading (0 : ℤ) :=
    WeightCategory.mem_grading_iff.mpr (mem_degreeZeroGrading_zero _ p.val)
  have h₀' {X Y : WeightCategory Oᵐᵒᵖ} (p : X ⟶ Y) : p ∈ DG.grading (0 : ℤ) :=
    WeightCategory.mem_grading_iff.mpr (mem_degreeZeroGrading_zero _ p.val)
  have hF : Function.Bijective F.obj :=
    ⟨fun _ _ h => WeightCategory.ext (congrArg WeightCategory.as h),
      fun X => ⟨⟨X.as⟩, rfl⟩⟩
  letI : F.IsEquivalence := weightFunctorOfRingEquiv_isEquivalence flipRing hgrade
  let M := reflectedStandardWeightResolution hR σ hρ hQ hU t
  have hM (P : CatModule.{0} (DGOpposite (WeightCategory O))) (hP : CatModule.IsAcyclic P) :
      DG.IsAcyclic (CatTensorProduct P (CatModule.precompObj F M)) :=
    CatTensorProduct.isAcyclic_precomp_of_coend F h₀ h₀' hF
      (Functor.FullyFaithful.ofFullyFaithful F) M
      (reflectedStandardWeightResolution_tensor_acyclic hR σ hρ hQ hU t) P hP
  exact CatTensorProduct.resolutionCohomologyEquiv h₀ f hf g hg hM
    (reflectedStandardRightWeightResolution_tensor_acyclic hR σ hρ hQ hU s) j

end StandardPairBalance

end Categorification.Stendhal.BraidedStendhalAlgebra
