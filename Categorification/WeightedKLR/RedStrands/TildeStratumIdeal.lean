import Categorification.WeightedKLR.RedStrands.TildePhiLayers
import Categorification.WeightedKLR.RedStrands.CoarseAssignment

/-!
# Stratum ideals of `T̃^λ` and the projectives `T̃^λ e(s)`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, Corollary
5.23 and the description of the standard modules after Definition 5.1. For a set `Γ` of
red-ordered loadings closed upwards under Webster's preorder, let `J_Γ` be the ideal of `T̃^λ`
generated by the idempotents `e(u)`, `u ∈ Γ`. In left-module form:

* `J_Γ e(s) = Σ_{φ • s ∈ Γ} T̃^λ x̃_φ` inside `P̃ = T̃^λ e(s)`
  (`comap_stratumIdeal_eq_phiStratumSub`). One inclusion holds because `x̃_φ = e(φ • s) x̃_φ`;
  the other is the straightening `phiCut_mem_tildePhiSpan`, since every bottom occurring for
  `e(u) T̃^λ e(s)` lies above `u`.
* **Support of the standard modules**: `e(u) T̃^λ e(t) ⊆ Ũ_t` unless `u ≤ t`
  (`e_mul_mul_e_mem_tildeLeftUpper`); equivalently, `e(u)` kills the left standard module
  `S̃_t` unless `u ≤ t` (`e_smul_tildeStandard_eq_zero`).
* `J_Γ` is a two-sided ideal generated by idempotents (`stratumIdeal_mul_mem`,
  `mem_stratumIdeal_iff_exists`).

## Main definitions

* `IsUpperLoadingSet`, `stratumIdeal`, `phiStratumSub`.

## Main results

* `comap_stratumIdeal_eq_phiStratumSub`, `e_mul_mul_e_mem_tildeLeftUpper`,
  `e_smul_tildeStandard_eq_zero`, `stratumIdeal_mul_mem`.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR TypeA Equiv

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ} {ν : Multiset I}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "B" => StendhalAlgebra k Q Λ ν

/-- A shortcut: instance search does not unfold `StendhalAlgebra` to find the additive group of
a submodule of a left ideal. -/
private abbrev addCommGroupSubmoduleLIdeal' (x : B) (M : Submodule B (lIdeal x)) :
    AddCommGroup M :=
  Submodule.addCommGroup (R := B) M

attribute [local instance] addCommGroupSubmoduleLIdeal'

/-- A set of loadings closed upwards under Webster's preorder. -/
def IsUpperLoadingSet (Γ : Set (Seq μ)) : Prop :=
  ∀ ⦃u v : Seq μ⦄, u ∈ Γ → StendhalLE u v → v ∈ Γ

/-- **The stratum ideal `J_Γ = T̃^λ e_Γ T̃^λ`**: as a left ideal it is spanned by the
`e(u) b` with `u ∈ Γ` red-ordered. -/
def stratumIdeal (Γ : Set (Seq μ)) : Submodule B B :=
  Submodule.span B {z | ∃ (u : Seq μ) (hu : IsRedOrdered u) (b : B),
    u ∈ Γ ∧ z = StendhalAlgebra.e u hu * b}

/-- `P̃_Γ = Σ_{φ • s ∈ Γ} T̃^λ x̃_φ` inside `P̃ = T̃^λ e(s)`. -/
def phiStratumSub (ρ : Perm (Fin m) → List ℕ) {s : Seq μ} (hs : IsRedOrdered s)
    (Γ : Set (Seq μ)) : Submodule B (lIdeal (StendhalAlgebra.e s hs : B)) :=
  ⨆ (g : PhiIndex s) (_ : phiBottom s g.1 ∈ Γ), tildePhiSub Q Λ ρ hs g

variable {Q Λ}

/-- `J_Γ` is closed under right multiplication, so it is a two-sided ideal. -/
theorem stratumIdeal_mul_mem {Γ : Set (Seq μ)} {z : B} (hz : z ∈ stratumIdeal Q Λ Γ)
    (c : B) : z * c ∈ stratumIdeal Q Λ Γ := by
  induction hz using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨u, hu, b, hΓ, rfl⟩ := hx
    exact Submodule.subset_span ⟨u, hu, b * c, hΓ, by rw [mul_assoc]⟩
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [add_mul]; exact Submodule.add_mem _ hx hy
  | smul a x _ hx =>
    rw [smul_eq_mul, mul_assoc]
    exact Submodule.smul_mem _ a hx

theorem e_mul_mem_stratumIdeal {Γ : Set (Seq μ)} {u : Seq μ} (hu : IsRedOrdered u) (hΓ : u ∈ Γ)
    (b : B) : StendhalAlgebra.e u hu * b ∈ stratumIdeal Q Λ Γ :=
  Submodule.subset_span ⟨u, hu, b, hΓ, rfl⟩

/-- `J_Γ` is generated by idempotents: every generator `e(u) b` equals `e(u) (e(u) b)`. -/
theorem mem_stratumIdeal_iff_exists {Γ : Set (Seq μ)} {z : B} :
    z ∈ stratumIdeal Q Λ Γ ↔ z ∈ Submodule.span B {w | ∃ (u : Seq μ) (hu : IsRedOrdered u)
      (b : B), u ∈ Γ ∧ w = StendhalAlgebra.e u hu * b ∧
        StendhalAlgebra.e u hu * w = w} := by
  constructor
  · intro hz
    refine (Submodule.span_le.2 ?_ : stratumIdeal Q Λ Γ ≤ _) hz
    rintro _ ⟨u, hu, b, hΓ, rfl⟩
    refine Submodule.subset_span ⟨u, hu, b, hΓ, rfl, ?_⟩
    rw [← mul_assoc, stendhalAlgebra_e_mul_e_self]
  · intro hz
    refine (Submodule.span_le.2 ?_ : _ ≤ stratumIdeal Q Λ Γ) hz
    rintro _ ⟨u, hu, b, hΓ, rfl, -⟩
    exact e_mul_mem_stratumIdeal hu hΓ b

private theorem mem_of_val_mem_map'' {M : Submodule B B} {S : Submodule B M} {x : M}
    (h : (x : B) ∈ S.map M.subtype) : x ∈ S := by
  obtain ⟨y, hy, he⟩ := h
  rwa [show y = x from Subtype.ext he] at hy

/-- **The stratum identity `J_Γ e(s) = P̃_Γ`**, a consequence of the straightening in the proof
of Webster, arXiv:1309.3796v3, Corollary 5.23: for `Γ` closed upwards, `J_Γ e(s)` is the span
`P̃_Γ` of the `T̃^λ x̃_φ` with `φ • s ∈ Γ`. -/
theorem comap_stratumIdeal_eq_phiStratumSub (ρ : Perm (Fin m) → List ℕ)
    (hρ : ∀ w : Perm (Fin m), TypeA.IsReduced m (ρ w) ∧ wordProd m (ρ w) = w) {s : Seq μ}
    (hs : IsRedOrdered s) {Γ : Set (Seq μ)} (hΓ : IsUpperLoadingSet Γ) :
    (stratumIdeal Q Λ Γ).comap (lIdeal (StendhalAlgebra.e s hs : B)).subtype =
      phiStratumSub Q Λ ρ hs Γ := by
  apply le_antisymm
  · intro y hy
    refine mem_of_val_mem_map'' ?_
    have hmul : ∀ z ∈ stratumIdeal Q Λ Γ, z * StendhalAlgebra.e s hs ∈
        (phiStratumSub Q Λ ρ hs Γ).map (lIdeal (StendhalAlgebra.e s hs : B)).subtype := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨u, hu, b, hu', rfl⟩ := hx
        have hmem := phiCut_mem_tildePhiSpan (Q := Q) (Λ := Λ) ρ hρ hs hu b.1
        rw [← e_mul_mul_e_eq_phiCut] at hmem
        refine (Submodule.span_le.2 ?_ : tildePhiSpan Q Λ ρ hs u ≤ _) hmem
        rintro _ ⟨g, hg, hle, rfl⟩
        refine ⟨tildePhiVec Q Λ ρ hs ⟨g, List.mem_toFinset.2 hg⟩, ?_, rfl⟩
        exact Submodule.mem_iSup_of_mem ⟨g, List.mem_toFinset.2 hg⟩
          (Submodule.mem_iSup_of_mem (hΓ hu' hle) (Submodule.subset_span rfl))
      | zero => rw [zero_mul]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [add_mul]; exact Submodule.add_mem _ hx hy
      | smul a x _ hx =>
        rw [smul_eq_mul, mul_assoc]
        exact Submodule.smul_mem _ a hx
    have h := hmul (y : B) hy
    rwa [show ((y : B) * StendhalAlgebra.e s hs) = (y : B) from y.2] at h
  · refine iSup₂_le fun g hg => ?_
    refine Submodule.span_le.2 ?_
    rintro _ rfl
    change tildePhiElt Q Λ ρ hs g.mem ∈ stratumIdeal Q Λ Γ
    rw [← e_mul_tildePhiElt ρ hs g.mem]
    exact e_mul_mem_stratumIdeal _ hg _

/-- **Support of the standard modules of `T̃^λ`** (Webster, arXiv:1309.3796v3, the description
of `U_t` after Definition 5.1, left form): `e(u) T̃^λ e(t) ⊆ Ũ_t` unless `u ≤ t`. The proof is
the straightening `phiCut_mem_tildePhiSpan` at `s = t`: every bottom `φ • t` that occurs lies
above `u` and above `t`, hence strictly above `t` when `u ≰ t`. -/
theorem e_mul_mul_e_mem_tildeLeftUpper (ρ : Perm (Fin m) → List ℕ)
    (hρ : ∀ w : Perm (Fin m), TypeA.IsReduced m (ρ w) ∧ wordProd m (ρ w) = w) {t u : Seq μ}
    (ht : IsRedOrdered t) (hu : IsRedOrdered u) (b : B) (hut : ¬ StendhalLE u t) :
    StendhalAlgebra.e u hu * b * StendhalAlgebra.e t ht ∈ tildeLeftUpper Q Λ ν t ht := by
  have hmem := phiCut_mem_tildePhiSpan (Q := Q) (Λ := Λ) ρ hρ ht hu b.1
  rw [← e_mul_mul_e_eq_phiCut] at hmem
  refine (Submodule.span_le.2 ?_ : tildePhiSpan Q Λ ρ ht u ≤ _) hmem
  rintro _ ⟨g, hg, hle, rfl⟩
  have htb : StendhalLE t (phiBottom t g) := stendhalLE_phiBottom ht hg
  have hlt : StendhalLT t (phiBottom t g) :=
    ⟨htb, fun hbt => hut fun r i => (hle r i).trans (hbt r i)⟩
  refine Submodule.subset_span ⟨phiBottom t g, isRedOrdered_phiBottom ht hg,
    tildePhiElt Q Λ ρ ht hg, hlt, ?_⟩
  rw [e_mul_tildePhiElt, tildePhiElt_mul_e]

/-- `e(u)` kills the left standard module `S̃_t = T̃^λ e(t) / Ũ_t` unless `u ≤ t`. -/
theorem e_smul_tildeStandard_eq_zero (ρ : Perm (Fin m) → List ℕ)
    (hρ : ∀ w : Perm (Fin m), TypeA.IsReduced m (ρ w) ∧ wordProd m (ρ w) = w) {t u : Seq μ}
    (ht : IsRedOrdered t) (hu : IsRedOrdered u) (hut : ¬ StendhalLE u t)
    (x : tildeStandard Q Λ t ht) : (StendhalAlgebra.e u hu : B) • x = 0 := by
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
  change StendhalAlgebra.e u hu * (y : B) ∈ tildeLeftUpper Q Λ ν t ht
  have h := e_mul_mul_e_mem_tildeLeftUpper ρ hρ ht hu (y : B) hut
  rwa [show StendhalAlgebra.e u hu * (y : B) * StendhalAlgebra.e t ht =
    StendhalAlgebra.e u hu * (y : B) by rw [mul_assoc, y.2]] at h

end Categorification.Stendhal
