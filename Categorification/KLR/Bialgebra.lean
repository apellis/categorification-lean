theorem distribBaseChange_one_tmul (Z : (Gkl).K0R ⊗[LP] (Gkl).K0R) :
    TensorProduct.AlgebraTensorModule.distribBaseChange LP (RatFunc ℚ) (Gkl).K0R (Gkl).K0R
      ((1 : RatFunc ℚ) ⊗ₜ Z) = toK0QTT k Γ Z := by
  induction Z using TensorProduct.induction_on with
  | zero => rw [TensorProduct.tmul_zero, LinearEquiv.map_zero, AddMonoidHom.map_zero]
  | tmul x y =>
    rw [toK0QTT_tmul]
    rw [TensorProduct.AlgebraTensorModule.distribBaseChange, LinearEquiv.symm_apply_eq,
      LinearEquiv.trans_apply]
    change _ = TensorProduct.AlgebraTensorModule.assoc LP LP (RatFunc ℚ) (RatFunc ℚ) (Gkl).K0R
      (Gkl).K0R (TensorProduct.AlgebraTensorModule.cancelBaseChange LP (RatFunc ℚ) (RatFunc ℚ)
        (RatFunc ℚ ⊗[LP] (Gkl).K0R) (Gkl).K0R
        (((1 : RatFunc ℚ) ⊗ₜ[LP] x) ⊗ₜ[RatFunc ℚ] ((1 : RatFunc ℚ) ⊗ₜ[LP] y)))
    rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, one_smul,
      TensorProduct.AlgebraTensorModule.assoc_tmul]
  | add Z Z' hZ hZ' =>
    rw [TensorProduct.tmul_add, LinearEquiv.map_add, hZ, hZ', AddMonoidHom.map_add]

set_option synthInstance.maxHeartbeats 400000 in
/-- `Δ_{ℚ(v)}` extends `Δ`: `Δ_{ℚ(v)}(x) = Δ(x)` for `x ∈ K₀(R)`. -/
theorem coprodQ_toK0Q (y : (Gkl).K0R) :
    coprodQ k Γ (toK0Q k Γ y) = toK0QTT k Γ (coprodKL k Γ y) := by
  change coprodQ k Γ ((1 : RatFunc ℚ) ⊗ₜ y) = _
  rw [coprodQ, LinearMap.comp_apply]
  erw [LinearMap.baseChange_tmul]
  exact distribBaseChange_one_tmul k Γ (coprodKL k Γ y)

omit [DecidableEq I] in
theorem qToV_qUnitLP_inv_zpow (n : ℤ) :
    qToV (((qUnitLP⁻¹ : LPˣ) ^ n : LPˣ) : LP) = ((vQ ^ n : (RatFunc ℚ)ˣ) : RatFunc ℚ) := by
  have h : Units.map qToV.toMonoidHom (qUnitLP⁻¹ : LPˣ) = vQ := Units.ext qToV_qUnitLP_inv
  rw [← h, ← map_zpow]
  rfl

variable (hGK : PreF.GabberKac (KL.C Γ).dot vQ (KL.C Γ).c)

set_option synthInstance.maxHeartbeats 400000 in
/-- `(γ ⊗ γ)(r̄ θ_w) = Δ(γ θ_w)` on words `θ_w = θ_{w_1} ⋯ θ_{w_m}`. -/
theorem map_gammaF_rbar_word (w : FreeMonoid I) :
    TensorProduct.map (gammaF k Γ hGK).toLinearMap (gammaF k Γ hGK).toLinearMap
        (twSqFEquiv _ _ _ (rbar _ _ _ (KL.C Γ).symm (KL.π Γ (word w)))) =
      toK0QTT k Γ (gammaZTT k Γ (r (KL.C Γ).dot qUnitLP⁻¹ (word w))) := by
  obtain ⟨m, f, rfl⟩ : ∃ (m : ℕ) (f : Fin m → I), FreeMonoid.ofList (List.ofFn f) = w :=
    ⟨_, (FreeMonoid.toList w).get, by rw [List.ofFn_get]; rfl⟩
  rw [twSqFEquiv_rbar_π, r_ofFn, r_ofFn, map_sum, map_sum, map_sum, map_sum]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [toTensorF_single, LinearMap.map_smul, TensorProduct.map_tmul, gammaZTT_single,
    toK0QTT_smul, toK0QTT_tmul, qToV_qUnitLP_inv_zpow]
  simp only [AlgHom.toLinearMap_apply]
  rw [gammaF_π, gammaF_π, gammaQ_word_eq, gammaQ_word_eq]

set_option synthInstance.maxHeartbeats 400000 in
/-- **KL I, Theorem 1.1 (coalgebra part) over `ℚ(v)`**: `γ ⊗ γ` intertwines Lusztig's
comultiplication `r̄ : f → f ⊗ f` with `[Res]`: `(γ ⊗ γ)(r̄ x) = Δ_{ℚ(v)}(γ x)` for all `x ∈ f`
(`f` defined under the quantum Gabber–Kac hypothesis `hGK`). -/
theorem map_gammaF_rbar (x : KL.F Γ) :
    TensorProduct.map (gammaF k Γ hGK).toLinearMap (gammaF k Γ hGK).toLinearMap
        (twSqFEquiv _ _ _ (rbar _ _ _ (KL.C Γ).symm x)) =
      coprodQ k Γ (gammaF k Γ hGK x) := by
  obtain ⟨y, rfl⟩ := PreF.π_surjective x
  induction y using PreF.induction_linear with
  | zero => simp
  | add y y' hy hy' => rw [map_add, map_add, map_add, map_add, hy, hy', map_add, map_add]
  | smul_word w c =>
    rw [map_smul, map_smul, LinearEquiv.map_smul, LinearMap.map_smul, map_smul,
      LinearMap.map_smul, map_gammaF_rbar_word]
    congr 1
    change _ = coprodQ k Γ (gammaF k Γ hGK (KL.π Γ (word w)))
    rw [gammaF_π, gammaQ_word_eq, coprodQ_toK0Q, coprod_gammaZ]

set_option synthInstance.maxHeartbeats 400000 in
/-- **KL I, Theorem 1.1 (coalgebra part) on `_𝒜 f`**: for `x ∈ _𝒜 f`,
`(γ ⊗ γ)(r̄ x) = Δ(γ x)`, the right-hand side computed integrally in `K₀(R) ⊗ K₀(R)` (with
`γ : _𝒜 f ≅ K₀(R)`, `KLGamma.gammaIntEquiv`). -/
theorem map_gammaF_rbar_Af (x : KL.Af Γ) :
    TensorProduct.map (gammaF k Γ hGK).toLinearMap (gammaF k Γ hGK).toLinearMap
        (twSqFEquiv _ _ _ (rbar _ _ _ (KL.C Γ).symm x)) =
      toK0QTT k Γ (coprodKL k Γ (gammaIntEquiv k Γ hGK x)) := by
  rw [map_gammaF_rbar, gammaIntEquiv_apply, gammaInt', ← coprodQ_toK0Q, toK0Q_gammaInt]

set_option synthInstance.maxHeartbeats 400000 in
/-- `K₀(R) ⊗ K₀(R) → K₀(R)_{ℚ(v)} ⊗ K₀(R)_{ℚ(v)}` is injective (`K₀(R) ⊗ K₀(R)` is free over
`ℤ[q, q⁻¹]`, and `q ↦ v⁻¹` is injective); so `r̄` determines `Δ` on `_𝒜 f`. -/
theorem toK0QTT_injective : Function.Injective (toK0QTT k Γ) := by
  haveI := K0R_free k Γ
  have h1 : Function.Injective fun Z : (Gkl).K0R ⊗[LP] (Gkl).K0R =>
      ((1 : RatFunc ℚ) ⊗ₜ[LP] Z : RatFunc ℚ ⊗[LP] ((Gkl).K0R ⊗[LP] (Gkl).K0R)) :=
    Algebra.TensorProduct.includeRight_injective (A := RatFunc ℚ) (qToV_injective)
  intro Z Z' h
  apply h1
  apply (TensorProduct.AlgebraTensorModule.distribBaseChange LP (RatFunc ℚ) (Gkl).K0R
    (Gkl).K0R).injective
  simp only
  rw [distribBaseChange_one_tmul, distribBaseChange_one_tmul, h]

set_option synthInstance.maxHeartbeats 400000 in
/-- **KL I, Theorem 1.1 in full: `γ : _𝒜 f → K₀(R)` is an isomorphism of `ℕ[I]`-graded twisted
bialgebras** (under the quantum Gabber–Kac hypothesis `hGK` used to define `f`):

1. `γ` is a ring isomorphism (`KLGamma.theorem_1_1`);
2. it respects the `ℕ[I]`-gradings (`KLGamma.gammaInt_mem_grade`);
3. `Δ = [Res]` is an algebra homomorphism for the twisted multiplication (3.1), which is
   associative and unital (KL I, Proposition 3.2);
4. `Δ` is coassociative (KL I, Proposition 3.1);
5. `γ` intertwines Lusztig's `r̄` with `Δ`: for `x ∈ _𝒜 f`, `(γ ⊗ γ)(r̄ x) = Δ(γ x)` (compared in
   `K₀(R)_{ℚ(v)} ⊗ K₀(R)_{ℚ(v)}`, into which `K₀(R) ⊗ K₀(R)` embeds). -/
theorem theorem_1_1_bialgebra :
    Function.Bijective (gammaInt' k Γ hGK) ∧
    (∀ {ν : Multiset I} (x : KL.Af Γ) {y : PreF (RatFunc ℚ) I},
      y ∈ PreF.grade (RatFunc ℚ) ν → (x : KL.F Γ) = KL.π Γ y →
        gammaInt' k Γ hGK x ∈
          LinearMap.range (DirectSum.lof LP (Multiset I) (Gkl).K0fam ν)) ∧
    (∀ x y : (Gkl).K0R, coprodKL k Γ (x * y) = (Gkl).twMul (coprodKL k Γ x) (coprodKL k Γ y)) ∧
    coprodKL k Γ 1 = 1 ⊗ₜ 1 ∧
    (∀ X Y Z : (Gkl).K0R ⊗[LP] (Gkl).K0R,
      (Gkl).twMul ((Gkl).twMul X Y) Z = (Gkl).twMul X ((Gkl).twMul Y Z)) ∧
    (∀ X, (Gkl).twMul (1 ⊗ₜ 1) X = X ∧ (Gkl).twMul X (1 ⊗ₜ 1) = X) ∧
    (∀ x : (Gkl).K0R, (coprodKL k Γ).rTensor (Gkl).K0R (coprodKL k Γ x) =
      (TensorProduct.assoc LP (Gkl).K0R (Gkl).K0R (Gkl).K0R).symm
        ((coprodKL k Γ).lTensor (Gkl).K0R (coprodKL k Γ x))) ∧
    (∀ x : KL.Af Γ,
      TensorProduct.map (gammaF k Γ hGK).toLinearMap (gammaF k Γ hGK).toLinearMap
          (twSqFEquiv _ _ _ (rbar _ _ _ (KL.C Γ).symm x)) =
        toK0QTT k Γ (coprodKL k Γ (gammaIntEquiv k Γ hGK x))) ∧
    Function.Injective (toK0QTT k Γ) :=
  ⟨theorem_1_1 k Γ hGK, fun x _ hy hxy => gammaInt_mem_grade k Γ hGK _ x hy hxy,
    coprod_mul k Γ, coprod_one k Γ, (Gkl).twMul_assoc,
    fun X => ⟨(Gkl).twMul_one_left X, (Gkl).twMul_one_right X⟩, coassoc k Γ,
    map_gammaF_rbar_Af k Γ hGK, toK0QTT_injective k Γ⟩

