import Categorification.WeightedKLR.RedStrands.BraidedStandardInjective

set_option backward.isDefEq.respectTransparency false

/-!
# The right-module map of the edge braid

Let `e(t)` be an idempotent whose leftmost strand is the red strand `λ_r` and let `g` carry this
strand to the right edge, shifting the other strands one step left, with `g • t = s`. Write `J`
for the violated ideal and `U_r` for the ideal generated by `J` and the idempotents starting
with `λ_r` followed by a black strand. Left multiplication by `ψ_{ρ(g)} e(t)` induces

`e(t) (A / U_r) e_{r :: L} ≃ e(s) (A / J) e_{r :: L}`.

For two red strands this is the diagram in B. Webster, *Knot invariants and higher representation
theory*, arXiv:1309.3796v2, §6.1, Proposition 6.9, Figure 5. Both sides are right modules over
`e_{r :: L} (A / J) e_{r :: L}`: the left-hand side acts through the quotient `A / J → A / U_r`,
and the right-hand side by multiplication in `A / J`. No grading shift or derived comparison
is asserted here.

## Main results

* `BraidedStendhalAlgebra.braidCornerEquiv` : the `k`-linear equivalence.
* `BraidedStendhalAlgebra.braidCornerRightEquiv` : the same equivalence of right modules.
-/

namespace Categorification.Stendhal

open KLR TypeA Equiv MvPolynomial

variable {I : Type} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

namespace BraidedStendhalAlgebra

variable (k Q Λ ν) in
/-- The quotient by the ideal `U_r`. -/
abbrev EdgeQuotient (r : Fin ℓ) : Type _ := (edgeIdeal k Q Λ ν r).ringCon.Quotient

variable (k Q Λ ν) in
/-- The quotient map onto `A / U_r`. -/
noncomputable def edgeMk (r : Fin ℓ) :
    BraidedStendhalAlgebra k Q Λ ν →ₐ[k] EdgeQuotient k Q Λ ν r :=
  (edgeIdeal k Q Λ ν r).ringCon.mkₐ k

theorem edgeMk_eq_zero_iff (r : Fin ℓ) (x : BraidedStendhalAlgebra k Q Λ ν) :
    edgeMk k Q Λ ν r x = 0 ↔ x ∈ edgeIdeal k Q Λ ν r := by
  change (edgeIdeal k Q Λ ν r).ringCon.mk' x = 0 ↔ _
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk']

theorem edgeMk_surjective (r : Fin ℓ) : Function.Surjective (edgeMk k Q Λ ν r) :=
  RingCon.mkₐ_surjective _

variable (k Q Λ ν) in
/-- The corner `e(t) (A / U_r) e_κ`. -/
noncomputable def edgeCorner (r : Fin ℓ) (t : Seq μ) (κ : List (Fin ℓ)) :
    Submodule k (EdgeQuotient k Q Λ ν r) :=
  LinearMap.range ((edgeMk k Q Λ ν r).toLinearMap ∘ₗ
    (LinearMap.mulLeft k (ofKLR k Q Λ ν (KLRAlgebra.e t)) ∘ₗ
      LinearMap.mulRight k (redProj k Q Λ ν κ)))

variable (k Q Λ ν) in
/-- The corner `e(s) (A / A e_viol A) e_κ`. -/
noncomputable def violCorner (s : Seq μ) (κ : List (Fin ℓ)) :
    Submodule k (ViolQuotient k Q Λ ν) :=
  LinearMap.range ((violMk k Q Λ ν).toLinearMap ∘ₗ
    (LinearMap.mulLeft k (ofKLR k Q Λ ν (KLRAlgebra.e s)) ∘ₗ
      LinearMap.mulRight k (redProj k Q Λ ν κ)))

theorem mem_edgeCorner {r : Fin ℓ} {t : Seq μ} {κ : List (Fin ℓ)}
    (x : BraidedStendhalAlgebra k Q Λ ν) :
    edgeMk k Q Λ ν r (ofKLR k Q Λ ν (KLRAlgebra.e t) * x * redProj k Q Λ ν κ) ∈
      edgeCorner k Q Λ ν r t κ :=
  ⟨x, by simp [mul_assoc]⟩

theorem mem_violCorner {s : Seq μ} {κ : List (Fin ℓ)} (x : BraidedStendhalAlgebra k Q Λ ν) :
    violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.e s) * x * redProj k Q Λ ν κ) ∈
      violCorner k Q Λ ν s κ :=
  ⟨x, by simp [mul_assoc]⟩

variable {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : IsReducedChoice ρ) (hQ : KLRSymm Q)

omit [DecidableEq I] in
/-- Every black strand of `s` lies left of its last strand `λ_r`. -/
theorem EdgeBraid.black_lt {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (a p : Fin m) (ha : (s.lbl a).isLeft)
    (hp : s.lbl p = .inr r) : a < p := by
  have hpm : p = ⟨m - 1, by omega⟩ := lbl_inj_of_inr s r hp hb.last
  have hap : a ≠ p := by
    rintro rfl
    rw [hp] at ha
    simp at ha
  subst hpm
  rw [Fin.lt_def]
  have := a.isLt
  have : (a : ℕ) ≠ m - 1 := fun h => hap (Fin.ext h)
  simp only
  omega

include hρ hQ in
/-- Left multiplication by the braiding diagram sends `U_r` into the violated ideal. -/
theorem psi_mul_mem_violIdeal {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) {y : BraidedStendhalAlgebra k Q Λ ν}
    (hy : y ∈ edgeIdeal k Q Λ ν r) :
    ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * y ∈ violIdeal k Q Λ ν := by
  rw [edgeIdeal, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hy
  induction hy using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨_, ⟨a, -, _, ⟨i, hi, rfl⟩, rfl⟩, b, -, rfl⟩ := hz
    rcases hi with hi | ⟨h1, hi0, hi1⟩
    · rw [← mul_assoc, ← mul_assoc]
      exact TwoSidedIdeal.mul_mem_right _ _ _
        (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span ⟨i, hi, rfl⟩))
    · rw [← e_mul_psi_e hρ hb.smul_eq,
        show ∀ x y z w : BraidedStendhalAlgebra k Q Λ ν, x * y * (z * w * b) =
          x * (y * z) * w * b from fun x y z w => by noncomm_ring]
      refine TwoSidedIdeal.mul_mem_right _ _ _ ?_
      exact e_mul_mul_e_mem_violIdeal hρ hQ h1 hi0 hi1 hb.black_lt _
  | zero => rw [mul_zero]; exact zero_mem _
  | add z w _ _ hz hw => rw [mul_add]; exact add_mem hz hw
  | neg z _ hz => rw [mul_neg]; exact neg_mem hz

variable (k Q Λ) in
/-- Left multiplication by the braiding diagram `ψ_{ρ(g)} e(t)`, from `A / U_r` to
`A / A e_viol A`, as a function. -/
noncomputable def braidQuotFun {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) : EdgeQuotient k Q Λ ν r → ViolQuotient k Q Λ ν :=
  Quotient.lift (fun z => violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * z))
    fun a b h => by
      have h' : a - b ∈ edgeIdeal k Q Λ ν r := (TwoSidedIdeal.rel_iff _ a b).1 h
      have := psi_mul_mem_violIdeal hρ hQ hb h'
      rw [mul_sub, ← violMk_eq_zero_iff, map_sub, sub_eq_zero] at this
      exact this

theorem braidQuotFun_edgeMk {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (z : BraidedStendhalAlgebra k Q Λ ν) :
    braidQuotFun k Q Λ hρ hQ hb (edgeMk k Q Λ ν r z) =
      violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * z) :=
  rfl

variable (k Q Λ) in
/-- Left multiplication by the braiding diagram `ψ_{ρ(g)} e(t)`, from `A / U_r` to
`A / A e_viol A`. -/
noncomputable def braidQuot {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) : EdgeQuotient k Q Λ ν r →ₗ[k] ViolQuotient k Q Λ ν where
  toFun := braidQuotFun k Q Λ hρ hQ hb
  map_add' x y := by
    obtain ⟨x, rfl⟩ := edgeMk_surjective r x
    obtain ⟨y, rfl⟩ := edgeMk_surjective r y
    rw [← map_add, braidQuotFun_edgeMk, braidQuotFun_edgeMk, braidQuotFun_edgeMk, mul_add,
      map_add]
  map_smul' c x := by
    obtain ⟨x, rfl⟩ := edgeMk_surjective r x
    rw [← map_smul, braidQuotFun_edgeMk, braidQuotFun_edgeMk, mul_smul_comm, map_smul]
    rfl

theorem braidQuot_edgeMk {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (z : BraidedStendhalAlgebra k Q Λ ν) :
    braidQuot k Q Λ hρ hQ hb (edgeMk k Q Λ ν r z) =
      violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * z) :=
  rfl

theorem psi_e_mul_e (g : Perm (Fin m)) (t : Seq μ) :
    ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * ofKLR k Q Λ ν (KLRAlgebra.e t) =
      ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) := by
  rw [← map_mul, mul_assoc, KLRAlgebra.e_mul_e, ite_eq_left_of_eq_true _ _ (eq_true rfl)]

theorem redProj_mul_self (κ : List (Fin ℓ)) :
    redProj k Q Λ ν κ * redProj k Q Λ ν κ = redProj k Q Λ ν κ := by
  rw [redProj, ← map_mul, redIdem_mul_redIdem]

include hρ in
/-- The image of a corner element under the braiding map. -/
theorem braidQuot_corner {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (κ : List (Fin ℓ)) (x : BraidedStendhalAlgebra k Q Λ ν) :
    braidQuot k Q Λ hρ hQ hb
        (edgeMk k Q Λ ν r (ofKLR k Q Λ ν (KLRAlgebra.e t) * x * redProj k Q Λ ν κ)) =
      violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.e s) *
        (ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * x) * redProj k Q Λ ν κ) := by
  rw [braidQuot_edgeMk, ← mul_assoc, ← mul_assoc, psi_e_mul_e,
    ← mul_assoc (ofKLR k Q Λ ν (KLRAlgebra.e s)), e_mul_psi_e hρ hb.smul_eq]

theorem braidQuot_mapsTo {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (κ : List (Fin ℓ)) {y : EdgeQuotient k Q Λ ν r}
    (hy : y ∈ edgeCorner k Q Λ ν r t κ) :
    braidQuot k Q Λ hρ hQ hb y ∈ violCorner k Q Λ ν s κ := by
  obtain ⟨x, rfl⟩ := hy
  have := braidQuot_corner hρ hQ hb κ x
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.mulRight_apply,
    LinearMap.mulLeft_apply, AlgHom.toLinearMap_apply] at this ⊢
  rw [← mul_assoc, this]
  exact mem_violCorner _

include hρ hQ in
theorem braidQuot_restrict_bijective {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (L : List (Fin ℓ)) :
    Function.Bijective ((braidQuot k Q Λ hρ hQ hb).restrict
      fun _ hy => braidQuot_mapsTo hρ hQ hb (r :: L) hy) := by
    constructor
    · rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      rintro ⟨y, x, rfl⟩ hy
      simp only [LinearMap.mem_ker, LinearMap.restrict_apply, Submodule.mk_eq_zero,
        LinearMap.coe_comp, Function.comp_apply, LinearMap.mulRight_apply,
        LinearMap.mulLeft_apply, AlgHom.toLinearMap_apply] at hy ⊢
      rw [← mul_assoc] at hy ⊢
      rw [braidQuot_edgeMk, violMk_eq_zero_iff, ← mul_assoc, ← mul_assoc, psi_e_mul_e] at hy
      rw [edgeMk_eq_zero_iff]
      exact mem_edgeIdeal_of_mem_violIdeal hρ hQ hb L x hy
    · rintro ⟨z, w, rfl⟩
      obtain ⟨x, hx⟩ := exists_e_mul_mul_redProj_sub_mem_of_last hρ hQ (L := L) h0 g
        hb.smul_eq hb.last hb.shift w
      refine ⟨⟨_, mem_edgeCorner (r := r) (t := t) (κ := r :: L) x⟩, ?_⟩
      apply Subtype.ext
      simp only [LinearMap.restrict_apply, LinearMap.coe_comp, Function.comp_apply,
        LinearMap.mulRight_apply, LinearMap.mulLeft_apply, AlgHom.toLinearMap_apply]
      rw [braidQuot_edgeMk, ← mul_assoc, ← mul_assoc, psi_e_mul_e, ← mul_assoc, ← sub_eq_zero,
        ← map_sub, violMk_eq_zero_iff]
      have h := mem_violIdeal_of_mem_violBottom
        (mul_redProj_mem_violBottom (r :: L) hx)
      rw [sub_mul, mul_assoc _ (redProj k Q Λ ν (r :: L)), redProj_mul_self] at h
      rw [← neg_mem_iff, neg_sub]
      exact h

variable (k Q Λ) in
/-- The `k`-linear corner equivalence underlying Webster, arXiv:1309.3796v2, §6.1,
Proposition 6.9, Figure 5, for two red strands. It is left multiplication by `ψ_{ρ(g)} e(t)`;
its `EdgeBraid` hypothesis describes a move across the entire loading, not a general adjacent
swap. The right-module refinement is `braidCornerRightEquiv`; this declaration does not
identify a standardization, its grading shift, or a derived tensor product. -/
noncomputable def braidCornerEquiv {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (L : List (Fin ℓ)) :
    edgeCorner k Q Λ ν r t (r :: L) ≃ₗ[k] violCorner k Q Λ ν s (r :: L) :=
  LinearEquiv.ofBijective _ (braidQuot_restrict_bijective hρ hQ hb L)

theorem braidCornerEquiv_apply {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (L : List (Fin ℓ)) (y : edgeCorner k Q Λ ν r t (r :: L)) :
    (braidCornerEquiv k Q Λ hρ hQ hb L y : ViolQuotient k Q Λ ν) =
      braidQuot k Q Λ hρ hQ hb y :=
  rfl

/-! ### Right multiplication in the two quotients -/

variable (k Q Λ ν) in
/-- The quotient map `A / J → A / U_r`, since every violated idempotent is an edge
ideal generator. -/
noncomputable def edgeOfViol (r : Fin ℓ) :
    ViolQuotient k Q Λ ν →ₐ[k] EdgeQuotient k Q Λ ν r :=
  (violIdeal k Q Λ ν).ringCon.liftₐ (edgeMk k Q Λ ν r) fun x y h => by
    rw [RingCon.ker_apply]
    change edgeMk k Q Λ ν r x = edgeMk k Q Λ ν r y
    rw [← sub_eq_zero, ← map_sub, edgeMk_eq_zero_iff]
    have hle : violIdeal k Q Λ ν ≤ edgeIdeal k Q Λ ν r := by
      rw [violIdeal, TwoSidedIdeal.span_le]
      rintro _ ⟨i, hi, rfl⟩
      exact TwoSidedIdeal.subset_span ⟨i, Or.inl hi, rfl⟩
    exact hle ((TwoSidedIdeal.rel_iff _ x y).1 h)

@[simp] theorem edgeOfViol_violMk (r : Fin ℓ) (x : BraidedStendhalAlgebra k Q Λ ν) :
    edgeOfViol k Q Λ ν r (violMk k Q Λ ν x) = edgeMk k Q Λ ν r x := rfl

/-- The corner ring at the red order `κ`, in the quotient by violated idempotents. -/
noncomputable abbrev ViolOrderCorner (κ : List (Fin ℓ)) : Type _ :=
  ((isIdempotentElem_redProj (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ).map
    (violMk k Q Λ ν)).Corner

private theorem mem_sandwichRange_iff {A B : Type*} [Ring A] [Ring B] [Algebra k A] [Algebra k B]
    (q : A →ₐ[k] B) (hq : Function.Surjective q) {e f : A}
    (he : IsIdempotentElem e) (hf : IsIdempotentElem f) {x : B} :
    x ∈ LinearMap.range (q.toLinearMap ∘ₗ (LinearMap.mulLeft k e ∘ₗ LinearMap.mulRight k f)) ↔
      q e * x = x ∧ x * q f = x := by
  constructor
  · rintro ⟨a, rfl⟩
    change q e * q (e * (a * f)) = q (e * (a * f)) ∧ q (e * (a * f)) * q f = q (e * (a * f))
    simp only [map_mul]
    exact ⟨by rw [← mul_assoc, (he.map q).eq],
      by rw [mul_assoc, mul_assoc, (hf.map q).eq]⟩
  · rintro ⟨hl, hr⟩
    obtain ⟨a, rfl⟩ := hq x
    exact ⟨a, by change q (e * (a * f)) = q a; rw [map_mul, map_mul, hr, hl]⟩

theorem mem_edgeCorner_iff {r : Fin ℓ} {t : Seq μ} {κ : List (Fin ℓ)}
    {x : EdgeQuotient k Q Λ ν r} :
    x ∈ edgeCorner k Q Λ ν r t κ ↔
      edgeMk k Q Λ ν r (ofKLR k Q Λ ν (KLRAlgebra.e t)) * x = x ∧
      x * edgeMk k Q Λ ν r (redProj k Q Λ ν κ) = x :=
  mem_sandwichRange_iff _ (edgeMk_surjective r)
    (by change _ * _ = _; rw [← map_mul, KLRAlgebra.e_mul_e, ite_eq_left rfl])
    (isIdempotentElem_redProj κ)

theorem mem_violCorner_iff {s : Seq μ} {κ : List (Fin ℓ)} {x : ViolQuotient k Q Λ ν} :
    x ∈ violCorner k Q Λ ν s κ ↔
      violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.e s)) * x = x ∧
      x * violMk k Q Λ ν (redProj k Q Λ ν κ) = x :=
  mem_sandwichRange_iff _ violMk_surjective
    (by change _ * _ = _; rw [← map_mul, KLRAlgebra.e_mul_e, ite_eq_left rfl])
    (isIdempotentElem_redProj κ)

open MulOpposite in
/-- Right multiplication on a sandwich, restricted along a homomorphism on the ambient rings.
The unit of the corner is its idempotent, which fixes every element of the sandwich. -/
@[instance_reducible] private def sandwichRightModule {A B : Type*} [Ring A] [Ring B] [Algebra k B]
    {f : A} (hf : IsIdempotentElem f) (q : A →+* B) (e : B) (M : Submodule k B)
    (hM : ∀ {x : B}, x ∈ M ↔ e * x = x ∧ x * q f = x) : Module hf.Cornerᵐᵒᵖ M where
  smul b x := ⟨x.1 * q b.unop.val, hM.2 ⟨by rw [← mul_assoc, (hM.1 x.2).1],
    by rw [mul_assoc, ← map_mul, ((Subsemigroup.mem_corner_iff hf).1 b.unop.2).2]⟩⟩
  one_smul x := Subtype.ext (hM.1 x.2).2
  mul_smul b c x := Subtype.ext (by
    change x.1 * q (c.unop.val * b.unop.val) = x.1 * q c.unop.val * q b.unop.val
    rw [map_mul, mul_assoc])
  smul_zero b := Subtype.ext (zero_mul (q b.unop.val))
  smul_add b x y := Subtype.ext (add_mul x.1 y.1 (q b.unop.val))
  add_smul b c x := Subtype.ext (by
    change x.1 * q (b.unop.val + c.unop.val) = x.1 * q b.unop.val + x.1 * q c.unop.val
    rw [map_add, mul_add])
  zero_smul x := Subtype.ext (by change x.1 * q 0 = 0; rw [map_zero, mul_zero])

/-- The right action of the violated corner on the edge quotient, by its image in `A / U_r`. -/
noncomputable instance edgeCornerModuleRight (r : Fin ℓ) (t : Seq μ) (κ : List (Fin ℓ)) :
    Module (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ)ᵐᵒᵖ
      (edgeCorner k Q Λ ν r t κ) :=
  sandwichRightModule _ (edgeOfViol k Q Λ ν r).toRingHom _ _ mem_edgeCorner_iff

/-- The right action of the violated corner by multiplication in `A / J`. -/
noncomputable instance violCornerModuleRight (s : Seq μ) (κ : List (Fin ℓ)) :
    Module (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ)ᵐᵒᵖ
      (violCorner k Q Λ ν s κ) :=
  sandwichRightModule _ (RingHom.id _) _ _ mem_violCorner_iff

local notation "C" => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν)

theorem edgeCorner_smul_val {r : Fin ℓ} {t : Seq μ} {κ : List (Fin ℓ)}
    (a : (C κ)ᵐᵒᵖ) (y : edgeCorner k Q Λ ν r t κ) :
    (a • y).1 = y.1 * edgeOfViol k Q Λ ν r a.unop.val := rfl

theorem violCorner_smul_val {s : Seq μ} {κ : List (Fin ℓ)}
    (a : (C κ)ᵐᵒᵖ) (y : violCorner k Q Λ ν s κ) :
    (a • y).1 = y.1 * a.unop.val := rfl

/-- Associativity for the braid on the two quotients, with the coefficient first mapped into
`A / U_r` on the domain side. -/
theorem braidQuot_mul_edgeOfViol {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (x : EdgeQuotient k Q Λ ν r) (a : ViolQuotient k Q Λ ν) :
    braidQuot k Q Λ hρ hQ hb (x * edgeOfViol k Q Λ ν r a) =
      braidQuot k Q Λ hρ hQ hb x * a := by
  obtain ⟨x, rfl⟩ := edgeMk_surjective r x
  obtain ⟨a, rfl⟩ := violMk_surjective a
  rw [edgeOfViol_violMk, ← map_mul, braidQuot_edgeMk, braidQuot_edgeMk, ← map_mul, mul_assoc]

/-- Right equivariance of the map in Webster, arXiv:1309.3796v2, §6.1, Proposition 6.9,
Figure 5. The common coefficient ring is the corner in the *violated* quotient, not in the
edge quotient. -/
theorem braidCornerEquiv_map_smul {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (L : List (Fin ℓ)) (a : (C (r :: L))ᵐᵒᵖ)
    (y : edgeCorner k Q Λ ν r t (r :: L)) :
    braidCornerEquiv k Q Λ hρ hQ hb L (a • y) = a • braidCornerEquiv k Q Λ hρ hQ hb L y := by
  apply Subtype.ext
  rw [braidCornerEquiv_apply, edgeCorner_smul_val, violCorner_smul_val, braidCornerEquiv_apply]
  exact braidQuot_mul_edgeOfViol hρ hQ hb y.1 a.unop.val

variable (k Q Λ) in
/-- The ungraded right-module equivalence of corners given by Webster's Figure 5
(arXiv:1309.3796v2, §6.1, Proposition 6.9) in the two-red case. For the edge move
`EdgeBraid` it has the same underlying map as `braidCornerEquiv`. -/
noncomputable def braidCornerRightEquiv {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)} {s t : Seq μ}
    (hb : EdgeBraid h0 r g s t) (L : List (Fin ℓ)) :
    edgeCorner k Q Λ ν r t (r :: L) ≃ₗ[(C (r :: L))ᵐᵒᵖ] violCorner k Q Λ ν s (r :: L) where
  toEquiv := (braidCornerEquiv k Q Λ hρ hQ hb L).toEquiv
  map_add' := map_add (braidCornerEquiv k Q Λ hρ hQ hb L)
  map_smul' := braidCornerEquiv_map_smul hρ hQ hb L

@[simp] theorem braidCornerRightEquiv_apply {h0 : 0 < m} {r : Fin ℓ} {g : Perm (Fin m)}
    {s t : Seq μ} (hb : EdgeBraid h0 r g s t) (L : List (Fin ℓ))
    (y : edgeCorner k Q Λ ν r t (r :: L)) :
    braidCornerRightEquiv k Q Λ hρ hQ hb L y = braidCornerEquiv k Q Λ hρ hQ hb L y := rfl

end BraidedStendhalAlgebra

end Categorification.Stendhal
