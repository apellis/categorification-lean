/-!
# The standardization of Definition 5.4 is fully faithful on endomorphisms

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3,
Proposition 5.26. For blocks `b` with `b_0 = 0` and a right module `M` over the block algebra
`B = R^{λ_1}(b_1) ⊗ ⋯ ⊗ R^{λ_ℓ}(b_ℓ)` of Proposition 5.3, the standardization
`S(M) = M ⊗_B S^L_α` of Definition 5.4 satisfies `End_B(M) ≅ End_{T^λ}(S(M))`, through
`g ↦ g ⊗ 1` (`standardizationEndEquiv`).

The proof is by induction on the number of red strands. With no red strands `S(M) = M`
(`leftStandardizationZeroEquiv`). For `ℓ + 1` red strands, `S(M)` is the two-piece
standardization of `X_M = M ⊗_{B'} S^L_{α'}` naturally in `M` (`splitStandardEquiv_mapRight`),
and the two-piece standardization is fully faithful (`parabolicStandardMapT_bijective`). An
endomorphism of `X_M` over the factor algebra `T^{λ'} ⊗ R^{λ_{ℓ+1}}(β)` is, by induction,
`g ⊗ 1` for an endomorphism `g` of `M` over `B'`; it commutes with the last factor exactly when
`g` does, by injectivity of `g ↦ g ⊗ 1`, and `B` is generated by `B'` and the last factor
(`blockAlgebra_subalgebra_eq_top`).
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra MulOpposite
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

namespace StendhalAlgebra

variable {I : Type} [DecidableEq I] {k : Type} [Field k] (Q : I → I → MvPolynomial (Fin 2) k)

/-- Standardization on endomorphisms, `g ↦ g ⊗ 1`, as a map of algebras. -/
abbrev standardizationEndAlg {n : ℕ} (Λ : Fin n → I →₀ ℕ) {b : Fin (n + 1) → Multiset I}
    {ν : Multiset I} (hb : blockPrefix b (n + 1) = ν) (hα : RootNonViolated (ν := ν) (blockRoot b))
    (M : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M] :
    Module.End (BlockAlgebra k Q Λ b)ᵐᵒᵖ M →ₐ[k]
      Module.End (TensorProductAlgebra k Q Λ ν) (LeftStandardization Q Λ b hb hα M) :=
  BalancedTensor.endMapRight k (TensorProductAlgebra k Q Λ ν) (BlockLeftStandard Q Λ b hb hα)
    (N := M)

/-- The statement that standardization with `n` red strands is bijective on endomorphisms. -/
def StandardizationEndBijective (n : ℕ) : Prop :=
  ∀ (Λ : Fin n → I →₀ ℕ) (b : Fin (n + 1) → Multiset I) (ν : Multiset I)
    (hb : blockPrefix b (n + 1) = ν) (hα : RootNonViolated (ν := ν) (blockRoot b)), b 0 = 0 →
    ∀ (M : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
      [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M],
      Function.Bijective (standardizationEndAlg Q Λ hb hα M)

omit [DecidableEq I] in
theorem blockPrefix_one_eq_zero {n : ℕ} (b : Fin (n + 1) → Multiset I) (hb0 : b 0 = 0) :
    blockPrefix b 1 = 0 :=
  Finset.sum_eq_zero fun j hj => by
    have hj' : j.val < 1 := (Finset.mem_filter.1 hj).2
    rw [show j = 0 from Fin.ext (by rw [Fin.val_zero]; omega), hb0]

theorem rootNonViolated_of_eq_zero {ν : Multiset I} (hν : ν = 0) (α : Fin 0 → I → ℕ) :
    RootNonViolated (ν := ν) α := by
  subst hν
  rintro s _ ⟨h, _⟩
  simp [stendhalWeight] at h

/-- **With no red strands, standardization is bijective on endomorphisms.** -/
theorem standardizationEndBijective_zero : StandardizationEndBijective Q 0 := by
  intro Λ b ν hb hα hb0 M _ _ _ _
  obtain rfl : ν = 0 := hb.symm.trans (blockPrefix_one_eq_zero b hb0)
  let e := leftStandardizationZeroEquiv Q Λ b hb0 hb hα M
  have he : ∀ (g : Module.End (BlockAlgebra k Q Λ b)ᵐᵒᵖ M) y,
      e (standardizationEndAlg Q Λ hb hα M g y) = g (e y) :=
    fun g y => leftStandardizationZeroEquiv_mapRight Q Λ b hb0 hb hα M g y
  refine ⟨fun g g' h => LinearMap.ext fun m => ?_, fun φ => ?_⟩
  · have := congrArg e (LinearMap.congr_fun h (e.symm m))
    rwa [he, he, LinearEquiv.apply_symm_apply] at this
  · let g : Module.End (BlockAlgebra k Q Λ b)ᵐᵒᵖ M :=
      { toFun := fun m => e (φ (e.symm m))
        map_add' := fun m m' => by rw [map_add, map_add, map_add]
        map_smul' := fun a m => by
          induction a using MulOpposite.rec' with | _ x =>
          obtain ⟨c, rfl⟩ := blockAlgebraZero_scalar Q Λ b hb0 x
          rw [show (op (algebraMap k (BlockAlgebra k Q Λ b) c) :
              (BlockAlgebra k Q Λ b)ᵐᵒᵖ) = algebraMap k _ c from rfl, algebraMap_smul,
            RingHom.id_apply, algebraMap_smul, map_smul, φ.map_smul_of_tower, map_smul] }
    refine ⟨g, LinearMap.ext fun y => e.injective ?_⟩
    rw [he]
    change e (φ (e.symm (e y))) = _
    rw [LinearEquiv.symm_apply_apply]

section Step

variable (hQ : KLRSymm Q) {ℓ : ℕ} (Λ : Fin (ℓ + 1) → I →₀ ℕ) (b : Fin (ℓ + 2) → Multiset I)
  (hα' : RootNonViolated (ν := initWeight b) (blockRoot (initBlocks b)))
  (hα : RootNonViolated (ν := initWeight b + lastBlock b) (blockRoot b))
  (M : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]

local notation "𝔹" => BlockAlgebra k Q Λ b
local notation "Cyc" => CycKLR k Q (fun i : I => (Polynomial.X : Polynomial k) ^ Λ (Fin.last ℓ) i)
  (lastBlock b)
local notation "Told" => TensorProductAlgebra k Q (Λ ∘ Fin.castSucc) (initWeight b)
local notation "D" => parabolicFactorAlgebra Q Λ (initWeight b) (lastBlock b)
local notation "XL" => LeftStandardization Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
  (InitRestrict Q Λ b M)
local notation "X" => TwoPieceInput Q Λ b M hα'
local notation "ofR" => initRestrictOf Q Λ b (M := M)
local notation "ofX" => twoPieceInputOf Q Λ b M hα'
local notation "mR" => BalancedTensor.mapRight (k := k) (B := Told)
  (M := BlockLeftStandard Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα')

theorem tmul_one_smul_twoPieceInputOf (t : Told) (x : XL) :
    (t ⊗ₜ[k] (1 : Cyc) : D) • ofX x = ofX (t • x) := by
  rw [twoPieceInput_smul_def, twoPieceInputAction_tmul, lastFactorEnd_one,
    BalancedTensor.mapRight_id]
  rfl

theorem one_tmul_smul_twoPieceInputOf (c : Cyc) (x : XL) :
    ((1 : Told) ⊗ₜ[k] c : D) • ofX x = ofX (mR (lastFactorEnd Q Λ b c) x) := by
  rw [twoPieceInput_smul_def, twoPieceInputAction_tmul, one_smul]

/-- An endomorphism of `X_M` over the factor algebra, as an endomorphism over `T^{λ'}`. -/
def twoPieceEndRestrict (ψ : Module.End D X) : Module.End Told XL where
  toFun x := (ofX).symm (ψ (ofX x))
  map_add' x y := by rw [map_add, map_add, map_add]
  map_smul' t x := by
    rw [RingHom.id_apply]
    apply (ofX).injective
    rw [LinearEquiv.apply_symm_apply, ← tmul_one_smul_twoPieceInputOf Q Λ b hα' M t x, map_smul,
      ← (ofX).apply_symm_apply (ψ (ofX x)),
      tmul_one_smul_twoPieceInputOf Q Λ b hα' M t ((ofX).symm (ψ (ofX x))),
      LinearEquiv.apply_symm_apply]

include hQ in
/-- **The induction step**: if standardization with the first `ℓ` red strands is bijective on
endomorphisms of `M`, so is standardization with `ℓ + 1`. -/
theorem standardizationEnd_bijective_step
    (ih : Function.Bijective (standardizationEndAlg Q (Λ ∘ Fin.castSucc)
      (rfl : blockPrefix (initBlocks b) (ℓ + 1) = initWeight b) hα' (InitRestrict Q Λ b M))) :
    Function.Bijective (standardizationEndAlg Q Λ (blockPrefix_last b) hα M) := by
  let e := splitStandardEquiv Q Λ hQ b hα' hα M
  have hnat : ∀ (g : Module.End 𝔹ᵐᵒᵖ M) y,
      e (standardizationEndAlg Q Λ (blockPrefix_last b) hα M g y) =
        parabolicStandardMapT Q Λ hQ (twoPieceEnd Q Λ b hα' g) (e y) :=
    fun g y => splitStandardEquiv_mapRight Q Λ hQ b hα' hα g y
  have hFF := parabolicStandardMapT_bijective Q Λ (initWeight b) (lastBlock b) hQ (N := X)
    (N' := X)
  have hIR : ∀ (g : Module.End 𝔹ᵐᵒᵖ M) (x : XL),
      twoPieceEnd Q Λ b hα' g (ofX x) = ofX (mR (initRestrictEnd Q Λ b g) x) :=
    fun g x => twoPieceEnd_of Q Λ b hα' g x
  constructor
  · intro g₁ g₂ h
    have h1 : twoPieceEnd Q Λ b hα' g₁ = twoPieceEnd Q Λ b hα' g₂ := by
      apply hFF.1
      refine LinearMap.ext fun z => ?_
      obtain ⟨y, rfl⟩ := e.surjective z
      rw [← hnat, ← hnat, h]
    have h2 : initRestrictEnd Q Λ b g₁ = initRestrictEnd Q Λ b g₂ := by
      apply ih.1
      refine LinearMap.ext fun x => (ofX).injective ?_
      have := LinearMap.congr_fun h1 (ofX x)
      rw [hIR, hIR] at this
      exact this
    exact LinearMap.ext fun m => (ofR).injective (LinearMap.congr_fun h2 (ofR m))
  · intro φ
    let φ' : Module.End (TensorProductAlgebra k Q Λ (initWeight b + lastBlock b))
        (ParabolicStandardT Q Λ (initWeight b) (lastBlock b) X hQ) :=
      e.toLinearMap ∘ₗ φ ∘ₗ e.symm.toLinearMap
    obtain ⟨ψ, hψ⟩ := hFF.2 φ'
    obtain ⟨g', hg'⟩ := ih.2 (twoPieceEndRestrict Q Λ b hα' M ψ)
    have hg'x : ∀ x : XL, ofX (mR g' x) = ψ (ofX x) := fun x => by
      rw [← (ofX).apply_symm_apply (ψ (ofX x))]
      exact congrArg ofX (LinearMap.congr_fun hg' x)
    have hcomm : ∀ c : Cyc, lastFactorEnd Q Λ b c ∘ₗ g' = g' ∘ₗ lastFactorEnd Q Λ b c := by
      intro c
      apply ih.1
      refine LinearMap.ext fun x => (ofX).injective ?_
      change ofX (mR (lastFactorEnd Q Λ b c ∘ₗ g') x) = ofX (mR (g' ∘ₗ lastFactorEnd Q Λ b c) x)
      rw [BalancedTensor.mapRight_comp, BalancedTensor.mapRight_comp, LinearMap.comp_apply,
        LinearMap.comp_apply, ← one_tmul_smul_twoPieceInputOf Q Λ b hα' M c (mR g' x), hg'x x,
        ← map_smul, one_tmul_smul_twoPieceInputOf, ← hg'x (mR (lastFactorEnd Q Λ b c) x)]
    let g₀ : M →ₗ[k] M :=
      (ofR).symm.toLinearMap ∘ₗ (g'.restrictScalars k) ∘ₗ (ofR).toLinearMap
    have hg₀ : ∀ m, ofR (g₀ m) = g' (ofR m) := fun m => (ofR).apply_symm_apply _
    let P : Subalgebra k 𝔹 :=
      { carrier := {x | ∀ m, g₀ ((op x : 𝔹ᵐᵒᵖ) • m) = (op x : 𝔹ᵐᵒᵖ) • g₀ m}
        mul_mem' := fun {x y} hx hy m => by
          have hx' : ∀ m, g₀ ((op x : 𝔹ᵐᵒᵖ) • m) = (op x : 𝔹ᵐᵒᵖ) • g₀ m := hx
          have hy' : ∀ m, g₀ ((op y : 𝔹ᵐᵒᵖ) • m) = (op y : 𝔹ᵐᵒᵖ) • g₀ m := hy
          rw [op_mul, mul_smul, mul_smul, hy', hx']
        add_mem' := fun {x y} hx hy m => by
          have hx' : ∀ m, g₀ ((op x : 𝔹ᵐᵒᵖ) • m) = (op x : 𝔹ᵐᵒᵖ) • g₀ m := hx
          have hy' : ∀ m, g₀ ((op y : 𝔹ᵐᵒᵖ) • m) = (op y : 𝔹ᵐᵒᵖ) • g₀ m := hy
          rw [op_add, add_smul, add_smul, map_add, hx', hy']
        algebraMap_mem' := fun c m => by
          change g₀ ((algebraMap k 𝔹ᵐᵒᵖ c) • m) = (algebraMap k 𝔹ᵐᵒᵖ c) • g₀ m
          rw [algebraMap_smul, algebraMap_smul, map_smul] }
    have hP : P = ⊤ := blockAlgebra_subalgebra_eq_top Q Λ b P
      (fun y m => (ofR).injective (by
        rw [hg₀, ← op_smul_initRestrictOf, map_smul, ← hg₀, op_smul_initRestrictOf]))
      (fun c m => by
        obtain ⟨c', rfl⟩ : ∃ c' : Cyc, CycKLR.flip _ _ c' = c := ⟨CycKLR.flip _ _ c,
          CycKLR.flip_flip _ _ c⟩
        refine (ofR).injective ?_
        rw [hg₀, ← lastFactorEnd_of, ← LinearMap.comp_apply g', ← hcomm, LinearMap.comp_apply,
          ← hg₀, lastFactorEnd_of])
    let g : Module.End 𝔹ᵐᵒᵖ M :=
      { toFun := g₀
        map_add' := g₀.map_add
        map_smul' := fun a m => by
          induction a using MulOpposite.rec' with | _ x =>
          exact (show x ∈ P from hP ▸ Algebra.mem_top) m }
    have hIRg : initRestrictEnd Q Λ b g = g' := LinearMap.ext fun z => by
      obtain ⟨m, rfl⟩ := (ofR).surjective z
      rw [initRestrictEnd_of]
      exact hg₀ m
    have htp : twoPieceEnd Q Λ b hα' g = ψ := LinearMap.ext fun z => by
      obtain ⟨x, rfl⟩ := (ofX).surjective z
      rw [hIR, hIRg]
      exact hg'x x
    refine ⟨g, LinearMap.ext fun y => e.injective ?_⟩
    rw [hnat, htp, hψ]
    change e (φ (e.symm (e y))) = e (φ y)
    rw [LinearEquiv.symm_apply_apply]

end Step

theorem standardizationEndBijective_succ (hQ : KLRSymm Q) {ℓ : ℕ}
    (ih : StandardizationEndBijective Q ℓ) : StandardizationEndBijective Q (ℓ + 1) := by
  intro Λ b ν hb hα hb0 M _ _ _ _
  obtain rfl : ν = initWeight b + lastBlock b := hb.symm.trans (blockPrefix_last b)
  have hb0' : initBlocks b 0 = 0 := by
    change b (Fin.castSucc 0) = 0
    simpa using hb0
  have hα' : RootNonViolated (ν := initWeight b) (blockRoot (initBlocks b)) := by
    rcases Nat.eq_zero_or_pos ℓ with rfl | hℓ
    · exact rootNonViolated_of_eq_zero (blockPrefix_one_eq_zero (initBlocks b) hb0') _
    · exact rootNonViolated_blockRoot hℓ hb0'
  exact standardizationEnd_bijective_step Q hQ Λ b hα' hα M (ih _ _ _ rfl hα' hb0' _)

/-- **Standardization is bijective on endomorphisms** for every number of red strands. -/
theorem standardizationEndBijective (hQ : KLRSymm Q) : ∀ n, StandardizationEndBijective Q n
  | 0 => standardizationEndBijective_zero Q
  | n + 1 => standardizationEndBijective_succ Q hQ (standardizationEndBijective hQ n)

/-- **Endomorphisms of a standardization** (Webster, arXiv:1309.3796v3, Proposition 5.26, full
faithfulness of the standardization of Definition 5.4 on endomorphisms): for blocks `b` with
`b_0 = 0` and every right module `M` over the block algebra `B`,
`End_B(M) ≅ End_{T^λ}(M ⊗_B S^L_α)` through `g ↦ g ⊗ 1`. -/
def standardizationEndEquiv (hQ : KLRSymm Q) {n : ℕ} (Λ : Fin n → I →₀ ℕ)
    (b : Fin (n + 1) → Multiset I) (hb0 : b 0 = 0)
    (hα : RootNonViolated (ν := blockPrefix b (n + 1)) (blockRoot b))
    (M : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M] :
    Module.End (BlockAlgebra k Q Λ b)ᵐᵒᵖ M ≃ₐ[k]
      Module.End (TensorProductAlgebra k Q Λ (blockPrefix b (n + 1)))
        (LeftStandardization Q Λ b rfl hα M) :=
  AlgEquiv.ofBijective (standardizationEndAlg Q Λ rfl hα M)
    (standardizationEndBijective Q hQ n Λ b _ rfl hα hb0 M)

theorem standardizationEndEquiv_apply (hQ : KLRSymm Q) {n : ℕ} (Λ : Fin n → I →₀ ℕ)
    (b : Fin (n + 1) → Multiset I) (hb0 : b 0 = 0)
    (hα : RootNonViolated (ν := blockPrefix b (n + 1)) (blockRoot b))
    (M : Type) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
    [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M] (g : Module.End (BlockAlgebra k Q Λ b)ᵐᵒᵖ M) :
    standardizationEndEquiv Q hQ Λ b hb0 hα M g =
      BalancedTensor.mapRight (k := k) (B := TensorProductAlgebra k Q Λ (blockPrefix b (n + 1)))
        (M := BlockLeftStandard Q Λ b rfl hα) g :=
  rfl

section RootStandardEnd

variable {n : ℕ} (Λ : Fin n → I →₀ ℕ) (b : Fin (n + 1) → Multiset I)
  (hα : RootNonViolated (ν := blockPrefix b (n + 1)) (blockRoot b))

instance blockLeftStandard_isScalarTower_opOp :
    IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖᵐᵒᵖ (BlockLeftStandard Q Λ b rfl hα) where
  smul_assoc c a l := by
    induction a using MulOpposite.rec' with | _ a =>
    induction a using MulOpposite.rec' with | _ x =>
    have h1 := LinearMap.congr_fun (show leftBlockActionOf Q Λ b rfl hα (c • x) =
        leftBlockActionOf Q Λ b rfl hα (algebraMap k _ c) * leftBlockActionOf Q Λ b rfl hα x from
      (congrArg (leftBlockActionOf Q Λ b rfl hα) (Algebra.smul_def c x)).trans (map_mul _ _ _)) l
    rw [AlgHom.commutes] at h1
    exact h1

/-- **Endomorphisms of the root standard module** (Webster, arXiv:1309.3796v3,
Proposition 5.26, `End(S_α) ≅ T^{μ_1} ⊗ ⋯ ⊗ T^{μ_ℓ}`, in left-module form): for blocks with
`b_0 = 0`, the block action of Proposition 5.3 identifies the block algebra with the
endomorphism algebra of the left root standard module `S^L_α`. -/
theorem bijective_leftBlockActionOf (hQ : KLRSymm Q) (hb0 : b 0 = 0) :
    Function.Bijective (leftBlockActionOf Q Λ b rfl hα) := by
  let A := (BlockAlgebra k Q Λ b)ᵐᵒᵖ
  let r := BalancedTensor.rid k (TensorProductAlgebra k Q Λ (blockPrefix b (n + 1))) A
    (BlockLeftStandard Q Λ b rfl hα)
  let h : BlockAlgebra k Q Λ b → Module.End A A :=
    fun x => AlgEquiv.moduleEndSelf (A := A) k (op (op x))
  have hh : Function.Bijective h :=
    (AlgEquiv.moduleEndSelf (A := A) k).bijective.comp
      ((MulOpposite.opEquiv.trans MulOpposite.opEquiv).bijective)
  have hS := standardizationEndBijective Q hQ n Λ b _ rfl hα hb0 A
  let C : Module.End (TensorProductAlgebra k Q Λ (blockPrefix b (n + 1)))
      (LeftStandardization Q Λ b rfl hα A) ≃
      Module.End (TensorProductAlgebra k Q Λ (blockPrefix b (n + 1)))
        (BlockLeftStandard Q Λ b rfl hα) :=
    { toFun := fun φ => r.toLinearMap ∘ₗ φ ∘ₗ r.symm.toLinearMap
      invFun := fun ψ => r.symm.toLinearMap ∘ₗ ψ ∘ₗ r.toLinearMap
      left_inv := fun φ => LinearMap.ext fun y => by
        change r.symm (r (φ (r.symm (r y)))) = φ y
        rw [r.symm_apply_apply, r.symm_apply_apply]
      right_inv := fun ψ => LinearMap.ext fun y => by
        change r (r.symm (ψ (r (r.symm y)))) = ψ y
        rw [r.apply_symm_apply, r.apply_symm_apply] }
  have heq : (leftBlockActionOf Q Λ b rfl hα : BlockAlgebra k Q Λ b → _) =
      C ∘ (standardizationEndAlg Q Λ rfl hα A) ∘ h := by
    funext x
    refine LinearMap.ext fun l => ?_
    change _ = r (BalancedTensor.mapRight (h x) (r.symm l))
    rw [BalancedTensor.rid_symm_apply, BalancedTensor.mapRight_tmul]
    change _ = r (BalancedTensor.tmul l ((op (op x) : Aᵐᵒᵖ) • (1 : A)))
    rw [BalancedTensor.rid_tmul]
    change _ = (op ((1 : A) * op x) : Aᵐᵒᵖ) • (show BlockLeftStandard Q Λ b rfl hα from l)
    rw [one_mul, op_op_smul_blockLeftStandard]
  rw [heq]
  exact C.bijective.comp (hS.comp hh)

end RootStandardEnd

end StendhalAlgebra

