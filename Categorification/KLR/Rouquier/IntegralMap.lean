import Categorification.QuantumGroup.GabberKacBridge

/-!
# Integral quantum-group maps from divided-power classes

R. Rouquier, *2-Kac–Moody algebras*, arXiv:0812.5023v1, §4.1.2, p. 33:
the positive integral form is the `ℤ[v,v⁻¹]`-algebra generated by divided powers.
The categorical application uses the divided-projective Serre relations of
Khovanov–Lauda II, arXiv:0804.2080v1, §3, Proposition 6 and Corollary 7.
This supporting construction for Webster arXiv:1209.2463v4, Theorem 2.19,
separates that descent from the construction of the weighted Grothendieck ring.

The explicit intermediate data consist of divided-power classes in a Laurent
algebra, an injective scalar-extension map, the factorial identity, and the
Serre relations. Quantum Gabber–Kac is supplied by the proved library theorem.
The construction makes no assertion of surjectivity.
-/

noncomputable section

namespace Categorification.KLR.Rouquier

open Categorification.QuantumGroup LaurentPolynomial Finset

variable {I R S : Type*} [Ring R] [Algebra (LaurentPolynomial ℤ) R]
  [Ring S] [Algebra (RatFunc ℚ) S]

/-- The explicit algebraic inputs for integral quantum-group descent.
The scalar convention is `q ↦ v⁻¹`, as in KL I arXiv:0803.4121v2, §3.1.
These are hypotheses of an intermediate construction, discharged by divided
projectives in its applications to Grothendieck rings. -/
structure IntegralMapData (C : CartanDatum I) (R S : Type*) [Ring R]
    [Algebra (LaurentPolynomial ℤ) R] [Ring S] [Algebra (RatFunc ℚ) S] where
  embed : R →+* S
  injective_embed : Function.Injective embed
  embed_smul : ∀ (p : LaurentPolynomial ℤ) (r : R),
    embed (p • r) = laurentEval vQ⁻¹ p • embed r
  divided : I → ℕ → R
  factorial : ∀ i n, embed (divided i 1) ^ n =
    qfact (PreF.vi C.dot vQ i) n • embed (divided i n)
  serre : ∀ i j, i ≠ j →
    ∑ n ∈ range (C.serreN i j + 1), ((-1 : LaurentPolynomial ℤ) ^ n) •
      (divided i n * divided j 1 * divided i (C.serreN i j - n)) = 0

namespace IntegralMapData

variable {C : CartanDatum I} (H : IntegralMapData C R S)

/-- Evaluate the free positive algebra at the simple-generator classes after
scalar extension. -/
def freeMap : PreF (RatFunc ℚ) I →ₐ[RatFunc ℚ] S :=
  MonoidAlgebra.lift (RatFunc ℚ) S (FreeMonoid I)
    (FreeMonoid.lift fun i => H.embed (H.divided i 1))

@[simp] theorem freeMap_θ (i : I) :
    H.freeMap (PreF.θ i) = H.embed (H.divided i 1) := by
  simp [freeMap, PreF.θ, PreF.word, MonoidAlgebra.lift_single]

theorem freeMap_dpow (i : I) (n : ℕ) :
    H.freeMap (PreF.dpow C.dot vQ i n) = H.embed (H.divided i n) := by
  rw [PreF.dpow, map_smul, map_pow, freeMap_θ, H.factorial]
  exact inv_smul_smul₀ (C.qfact_ne_zero i n) _

theorem freeMap_serreDiv {i j : I} (hij : i ≠ j) :
    H.freeMap (PreF.serreDiv C.dot vQ i j (C.serreN i j)) = 0 := by
  let N := C.serreN i j
  have hs := congrArg H.embed (H.serre i j hij)
  simp only [map_sum, map_zero, H.embed_smul, map_pow, map_neg, map_one] at hs
  have hterm (a b : ℕ) : H.freeMap
      (PreF.dpow C.dot vQ i a * PreF.θ j * PreF.dpow C.dot vQ i b) =
      H.embed (H.divided i a * H.divided j 1 * H.divided i b) := by
    rw [map_mul, map_mul, freeMap_dpow, freeMap_dpow, freeMap_θ, map_mul, map_mul]
  rw [PreF.serreDiv, map_sum, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  simp only [map_smul, hterm]
  have hsign : ∀ n ∈ range (N + 1), ((-1 : RatFunc ℚ) ^ (N - n)) =
      (-1) ^ N * (-1) ^ n := by
    intro n hn
    have hn' : n ≤ N := Nat.le_of_lt_succ (mem_range.1 hn)
    have he : ((-1 : RatFunc ℚ) ^ (N - n)) * (-1) ^ n = (-1) ^ N := by
      rw [← pow_add, Nat.sub_add_cancel hn']
    rw [← he, mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, mul_one]
  rw [sum_congr rfl fun n hn => by rw [hsign n hn, mul_smul], ← smul_sum]
  rw [hs, smul_zero]

theorem freeMap_serreSeq {i j : I} (hij : i ≠ j) :
    H.freeMap (PreF.serreSeq C.dot vQ i j (C.serreN i j)) = 0 := by
  rw [C.serreSeq_eq_qfact_smul_serreDiv hij, map_smul, freeMap_serreDiv H hij, smul_zero]

private theorem freeMap_eq_zero_of_mem_span {x : PreF (RatFunc ℚ) I}
    (hx : x ∈ TwoSidedIdeal.span (C.serreSet vQ)) : H.freeMap x = 0 := by
  have hle : TwoSidedIdeal.span (C.serreSet (K := RatFunc ℚ) vQ) ≤
      (RingHom.ker H.freeMap).toTwoSided := by
    rw [TwoSidedIdeal.span_le]
    rintro _ ⟨i, j, hij, rfl⟩
    exact Ideal.mem_toTwoSided.2 (H.freeMap_serreSeq hij)
  exact Ideal.mem_toTwoSided.1 (hle hx)

/-- The map on Lusztig's rational positive half. The proved quantum
Gabber–Kac theorem supplies its defining-ideal comparison. -/
def rationalMap : C.F →ₐ[RatFunc ℚ] S :=
  Ideal.Quotient.liftₐ (PreF.radical C.dot vQ C.c) H.freeMap (by
    intro x hx
    apply H.freeMap_eq_zero_of_mem_span
    apply TwoSidedIdeal.mem_asIdeal.1
    have hGK := C.quantumGabberKac.gabberKac
    rw [CartanDatum.GabberKac] at hGK
    rw [← hGK]
    exact hx)

@[simp] theorem rationalMap_π (x : PreF (RatFunc ℚ) I) :
    H.rationalMap (PreF.π C.dot vQ C.c x) = H.freeMap x := rfl

theorem rationalMap_dpowF (i : I) (n : ℕ) :
    H.rationalMap (PreF.dpowF C.dot vQ C.c i n) = H.embed (H.divided i n) :=
  H.freeMap_dpow i n

private theorem scalar_eval_T (n : ℤ) :
    laurentEval vQ⁻¹ (T n) = ((vQ ^ (-n) : (RatFunc ℚ)ˣ) : RatFunc ℚ) := by
  rw [laurentEval_T, inv_zpow']

theorem rationalMap_mem_range {x : C.F} (hx : x ∈ C.Af) :
    H.rationalMap x ∈ H.embed.range := by
  have hle : C.Af ≤ H.embed.range.comap H.rationalMap.toRingHom := by
    refine Subring.closure_le.2 ?_
    rintro y (⟨⟨i, n⟩, rfl⟩ | hy)
    · exact ⟨H.divided i n, (H.rationalMap_dpowF i n).symm⟩
    · have hscalar (n : ℤ) : H.rationalMap
          (algebraMap (RatFunc ℚ) C.F ((vQ ^ n : (RatFunc ℚ)ˣ) : RatFunc ℚ)) ∈
            H.embed.range := by
        refine ⟨(T (-n) : LaurentPolynomial ℤ) • (1 : R), ?_⟩
        rw [H.embed_smul, map_one, scalar_eval_T, neg_neg, AlgHom.commutes,
          Algebra.algebraMap_eq_smul_one]
      rcases hy with rfl | rfl
      · simpa using hscalar 1
      · simpa using hscalar (-1)
  exact hle hx

private def rangeEquiv : R ≃+* H.embed.range :=
  RingEquiv.ofBijective H.embed.rangeRestrict
    ⟨fun _ _ h => H.injective_embed (congrArg Subtype.val h), H.embed.rangeRestrict_surjective⟩

/-- The integral positive-half map determined by divided-power classes, supporting
Rouquier arXiv:0812.5023v1, §4.2.4, and Webster arXiv:1209.2463v4, Theorem 2.19.
All construction hypotheses are recorded explicitly in `IntegralMapData`. -/
def integralMap : C.Af →+* R :=
  H.rangeEquiv.symm.toRingHom.comp
    ((H.rationalMap.toRingHom.comp C.Af.subtype).codRestrict _
      fun x => H.rationalMap_mem_range x.2)

theorem embed_integralMap (x : C.Af) : H.embed (H.integralMap x) = H.rationalMap x := by
  have h := H.rangeEquiv.apply_symm_apply
    (⟨H.rationalMap x, H.rationalMap_mem_range x.2⟩ : H.embed.range)
  exact congrArg Subtype.val h

theorem integralMap_dpow (i : I) (n : ℕ) :
    H.integralMap ⟨PreF.dpowF C.dot vQ C.c i n, PreF.dpowF_mem_Af i n⟩ =
      H.divided i n := by
  apply H.injective_embed
  rw [embed_integralMap, rationalMap_dpowF]

theorem integralMap_generator (i : I) :
    H.integralMap ⟨PreF.π C.dot vQ C.c (PreF.θ i), PreF.π_θ_mem_Af i⟩ =
      H.divided i 1 := by
  simpa only [PreF.dpowF, PreF.dpow_one] using H.integralMap_dpow i 1

private theorem algebraMap_scalar_mem_Af (p : LaurentPolynomial ℤ) :
    algebraMap (RatFunc ℚ) C.F (laurentEval vQ⁻¹ p) ∈ C.Af := by
  induction p using AddMonoidAlgebra.induction_linear with
  | zero => simp only [map_zero]; exact Subring.zero_mem _
  | add p q hp hq => rw [map_add, map_add]; exact Subring.add_mem _ hp hq
  | single n m =>
    have he : (AddMonoidAlgebra.single n m : LaurentPolynomial ℤ) = m • T n := by
      rw [LaurentPolynomial.single_eq_C_mul_T, LaurentPolynomial.smul_eq_C_mul]
    rw [he, map_zsmul, map_zsmul, scalar_eval_T]
    exact Subring.zsmul_mem _ (PreF.algebraMap_zpow_mem_Af (-n)) m

/-- Laurent linearity with `q` acting on the integral quantum group as `v⁻¹`. -/
theorem integralMap_smul (p : LaurentPolynomial ℤ) (x : C.Af) :
    H.integralMap
        ⟨algebraMap (RatFunc ℚ) C.F (laurentEval vQ⁻¹ p) * x,
          Subring.mul_mem _ (algebraMap_scalar_mem_Af p) x.2⟩ =
      p • H.integralMap x := by
  apply H.injective_embed
  rw [embed_integralMap, H.embed_smul, embed_integralMap, map_mul, AlgHom.commutes,
    Algebra.smul_def]

end IntegralMapData

end Categorification.KLR.Rouquier
