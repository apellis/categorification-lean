import DG.Compact.Brown
import DG.Compact.Triangulated
import Mathlib.CategoryTheory.Triangulated.Subcategory

/-!
# Equivalences detected on a compact generator

Let `C` be a pretriangulated category with coproducts, compactly generated by a family `G`, and
let `F : C ⥤ D` be a triangulated functor which preserves coproducts and sends each `G i` to a
compact object. If `F` is bijective on the morphisms `G i⟦n⟧ ⟶ G j⟦m⟧`, then `F` is fully
faithful (`Categorification.map_bijective_of_compactlyGenerates`); if moreover the `F (G i)`
compactly generate `D`, then `F` is an equivalence
(`Categorification.isEquivalence_of_compactlyGenerates`).

The proof is the standard dévissage. For a fixed shifted generator `X = G i⟦n⟧`, the objects `Y`
on which `F : (X ⟶ Y) → (F X ⟶ F Y)` is bijective (at all shifts of `Y`) form a localizing
subcategory, since `Hom(X, -)` and `Hom(F X, F -)` are homological and preserve coproducts
(`X` and `F X` are compact). So the bijection holds for every `Y`. For a fixed `Y`, the objects
`X` on which it holds form a localizing subcategory by the contravariant form of the same
argument (`DG.isLocalizing_bijective`), so it holds for every `X`. The essential image of a full
triangulated functor preserving coproducts is localizing, so it is everything as soon as it
contains a family of compact generators.

This is used for B. Webster, *Knot invariants and higher representation theory*,
arXiv:1309.3796v3, Theorem 6.15, where the braiding functors are shown to be equivalences.
-/

universe w v v' u u'

noncomputable section

namespace Categorification

open CategoryTheory Limits Pretriangulated Opposite DG

variable {C : Type u} [Category.{v} C]

/-! ### Covariant homological functors -/

section Covariant

variable {H₁ H₂ : C ⥤ AddCommGrpCat.{v'}} (η : H₁ ⟶ H₂)

/-- Bijectivity of the components of a natural transformation is invariant under
isomorphism. -/
theorem bijective_app_of_iso_covariant {A B : C} (e : A ≅ B)
    (h : Function.Bijective (η.app B)) : Function.Bijective (η.app A) := by
  have nat : (H₂.map e.hom) ∘ (η.app A) = (η.app B) ∘ (H₁.map e.hom) := by
    funext x
    exact (NatTrans.naturality_apply η e.hom x).symm
  have h1 : Function.Bijective (H₁.map e.hom) :=
    ConcreteCategory.bijective_of_isIso (H₁.map e.hom)
  have h2 : Function.Bijective (H₂.map e.hom) :=
    ConcreteCategory.bijective_of_isIso (H₂.map e.hom)
  rw [← Function.Bijective.of_comp_iff' h2, nat]
  exact h.comp h1

/-- Naturality of `η`, as an equality of additive maps. -/
theorem map_hom_comp_app_hom_covariant {A B : C} (f : A ⟶ B) :
    (H₂.map f).hom.comp (η.app A).hom = (η.app B).hom.comp (H₁.map f).hom := by
  rw [← AddCommGrpCat.hom_comp, ← AddCommGrpCat.hom_comp, η.naturality]

/-- If `H₁` and `H₂` preserve a colimit cocone `c` and `η` is an isomorphism at every object of
the diagram, then `η` is an isomorphism at the point of `c`. -/
theorem isIso_app_of_isColimit {J : Type*} [Category J] {K : J ⥤ C} [PreservesColimit K H₁]
    [PreservesColimit K H₂] {c : Cocone K} (hc : IsColimit c)
    (h : ∀ j, IsIso (η.app (K.obj j))) : IsIso (η.app c.pt) := by
  have hc₁ := isColimitOfPreserves H₁ hc
  have hc₂ := isColimitOfPreserves H₂ hc
  have : ∀ j, IsIso ((Functor.whiskerLeft K η).app j) := h
  have : IsIso (Functor.whiskerLeft K η) := NatIso.isIso_of_isIso_app _
  have key : (hc₁.coconePointsIsoOfNatIso hc₂ (asIso (Functor.whiskerLeft K η))).hom =
      η.app c.pt := hc₁.hom_ext fun j => by
    rw [IsColimit.comp_coconePointsIsoOfNatIso_hom]
    simp only [Functor.mapCocone_ι_app, asIso_hom, Functor.whiskerLeft_app]
    exact (η.naturality (c.ι.app j)).symm
  rw [← key]
  infer_instance

variable [Preadditive C] [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] [H₁.IsHomological] [H₂.IsHomological]

/-- The five lemma for a natural transformation between covariant homological functors: for a
distinguished triangle `X₁ ⟶ X₂ ⟶ X₃ ⟶ X₁⟦1⟧`, `η` is bijective at `X₂` if it is surjective at
`X₃⟦-1⟧`, bijective at `X₁` and `X₃`, and injective at `X₁⟦1⟧`. -/
theorem bijective_app_obj₂_covariant (T : Triangle C) (hT : T ∈ distTriang C)
    (h₁ : Function.Surjective (η.app (T.obj₃⟦(-1 : ℤ)⟧)))
    (h₂ : Function.Bijective (η.app T.obj₁)) (h₄ : Function.Bijective (η.app T.obj₃))
    (h₅ : Function.Injective (η.app (T.obj₁⟦(1 : ℤ)⟧))) :
    Function.Bijective (η.app T.obj₂) := by
  have ex : ∀ (H : C ⥤ AddCommGrpCat.{v'}) [H.IsHomological] (T : Triangle C)
      (hT : T ∈ distTriang C), Function.Exact (H.map T.mor₁) (H.map T.mor₂) := fun H _ T hT =>
    (ShortComplex.ab_exact_iff_function_exact _).1 (H.map_distinguished_exact T hT)
  have hT' := inv_rot_of_distTriang T hT
  have hT'' := rot_of_distTriang T hT
  exact AddMonoidHom.bijective_of_surjective_of_bijective_of_bijective_of_injective
    (H₁.map T.invRotate.mor₁).hom (H₁.map T.mor₁).hom (H₁.map T.mor₂).hom (H₁.map T.mor₃).hom
    (H₂.map T.invRotate.mor₁).hom (H₂.map T.mor₁).hom (H₂.map T.mor₂).hom (H₂.map T.mor₃).hom
    (η.app _).hom (η.app _).hom (η.app _).hom (η.app _).hom (η.app _).hom
    (map_hom_comp_app_hom_covariant η _) (map_hom_comp_app_hom_covariant η _)
    (map_hom_comp_app_hom_covariant η _) (map_hom_comp_app_hom_covariant η _)
    (ex H₁ _ hT') (ex H₁ T hT) (ex H₁ _ hT'') (ex H₂ _ hT') (ex H₂ T hT) (ex H₂ _ hT'')
    h₁ h₂ h₄ h₅

/-- For a natural transformation `η` between covariant homological functors which preserve
coproducts, the objects `Y` such that `η` is bijective at every shift `Y⟦n⟧` form a localizing
subcategory. -/
theorem isLocalizing_bijective_covariant
    (hH₁ : ∀ J : Type w, PreservesColimitsOfShape (Discrete J) H₁)
    (hH₂ : ∀ J : Type w, PreservesColimitsOfShape (Discrete J) H₂) :
    IsLocalizing.{w} fun Y : C => ∀ n : ℤ, Function.Bijective (η.app (Y⟦n⟧)) := by
  have shift : ∀ (X : C) (m : ℤ), (∀ n : ℤ, Function.Bijective (η.app (X⟦n⟧))) →
      ∀ n : ℤ, Function.Bijective (η.app (X⟦m⟧⟦n⟧)) := fun X m h n =>
    bijective_app_of_iso_covariant η ((shiftFunctorAdd C m n).app X).symm (h (m + n))
  have self : ∀ X : C, (∀ n : ℤ, Function.Bijective (η.app (X⟦n⟧))) →
      Function.Bijective (η.app X) := fun X h =>
    bijective_app_of_iso_covariant η ((shiftFunctorZero C ℤ).app X).symm (h 0)
  refine ⟨fun e h n => bijective_app_of_iso_covariant η ((shiftFunctor C n).mapIso e) (h n),
    shift, ?_, ?_⟩
  · intro T hT h₁ h₃ n
    let T' := (CategoryTheory.shiftFunctor (Triangle C) n).obj T
    have hT' : T' ∈ distTriang C := Triangle.shift_distinguished T hT n
    exact bijective_app_obj₂_covariant η T' hT'
      (self _ (shift _ (-1) (shift _ n h₃))).2 (h₁ n) (h₃ n) (self _ (shift _ 1 (shift _ n h₁))).1
  · intro J Y c hc h n
    have := hH₁ J
    have := hH₂ J
    let K := Discrete.functor Y ⋙ shiftFunctor C n
    let c' : Cocone K := (shiftFunctor C n).mapCocone c
    have hc' : IsColimit c' := isColimitOfPreserves (shiftFunctor C n) hc
    have : IsIso (η.app c'.pt) := isIso_app_of_isColimit η hc' fun ⟨j⟩ =>
      (ConcreteCategory.isIso_iff_bijective _).2 (h j n)
    exact (ConcreteCategory.isIso_iff_bijective _).1 this

end Covariant

/-! ### The criterion -/

section Criterion

variable [Preadditive C] [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C]
  {D : Type u'} [Category.{v} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
  (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated]

/-- The action of `F` on morphisms out of `X`, as a natural transformation
`Hom(X, -) ⟶ Hom(F X, F -)`. -/
@[simps]
def coyonedaMapNatTrans (X : C) :
    preadditiveCoyoneda.obj (op X) ⟶ F ⋙ preadditiveCoyoneda.obj (op (F.obj X)) where
  app Y := AddCommGrpCat.ofHom F.mapAddHom
  naturality _ _ f := by
    ext g
    exact F.map_comp g f

/-- The action of `F` on morphisms into `Y`, as a natural transformation
`Hom(-, Y) ⟶ Hom(F -, F Y)`. -/
@[simps]
def yonedaMapNatTrans (Y : C) :
    preadditiveYoneda.obj Y ⟶ F.op ⋙ preadditiveYoneda.obj (F.obj Y) where
  app X := AddCommGrpCat.ofHom F.mapAddHom
  naturality _ _ f := by
    ext g
    exact F.map_comp f.unop g

variable {ι : Type w} {G : ι → C}

open Pretriangulated.Opposite in
/-- **A coproduct-preserving triangulated functor which is fully faithful on a compact
generator is fully faithful.** If `G` compactly generates `C`, `F` preserves coproducts, every
`F (G i)` is compact and `F` is bijective on the morphisms `G i⟦n⟧ ⟶ G j⟦m⟧`, then `F` is
bijective on all morphisms. -/
theorem map_bijective_of_compactlyGenerates [HasCoproducts.{max w v} C]
    [HasCoproducts.{max w v} D] (hG : CompactlyGenerates G)
    (hF : ∀ J : Type (max w v), PreservesColimitsOfShape (Discrete J) F)
    (hFG : ∀ i, IsCompact.{max w v} (F.obj (G i)))
    (h : ∀ (i j : ι) (n m : ℤ),
      Function.Bijective (F.map : ((G i)⟦n⟧ ⟶ (G j)⟦m⟧) → (F.obj ((G i)⟦n⟧) ⟶ F.obj ((G j)⟦m⟧))))
    (X Y : C) : Function.Bijective (F.map : (X ⟶ Y) → (F.obj X ⟶ F.obj Y)) := by
  -- Step 1: morphisms out of a shifted generator.
  have step₁ : ∀ (i : ι) (n : ℤ) (Y : C),
      Function.Bijective (F.map : ((G i)⟦n⟧ ⟶ Y) → (F.obj ((G i)⟦n⟧) ⟶ F.obj Y)) := by
    intro i n
    let X := (G i)⟦n⟧
    have hX : IsCompact.{max w v} X := (hG.isCompact i).shift n
    have hFX : IsCompact.{max w v} (F.obj X) :=
      IsCompact.of_iso ((F.commShiftIso n).app (G i)) ((hFG i).shift n)
    have hP := isLocalizing_bijective_covariant.{max w v} (coyonedaMapNatTrans F X)
      ((isCompact_iff_preservesColimitsOfShape X).1 hX)
      (fun J => have := hF J
        have := (isCompact_iff_preservesColimitsOfShape (F.obj X)).1 hFX J
        inferInstance)
    intro Y
    have := hG.forall_of_isLocalizing hP (fun j m => h i j n m) Y 0
    exact (bijective_app_of_iso_covariant (coyonedaMapNatTrans F X)
      ((shiftFunctorZero C ℤ).app Y).symm this)
  -- Step 2: all morphisms into a fixed object.
  have hP := isLocalizing_bijective.{max w v} (yonedaMapNatTrans F Y)
    (sendsCoproductsToProducts_preadditiveYoneda Y)
    (sendsCoproductsToProducts_op_comp_preadditiveYoneda F hF (F.obj Y))
  have := hG.forall_of_isLocalizing hP (fun i n => step₁ i n Y) X 0
  exact bijective_app_of_iso (yonedaMapNatTrans F Y) ((shiftFunctorZero C ℤ).app X).symm this

/-- The full faithfulness of `map_bijective_of_compactlyGenerates`, as a structure. -/
def fullyFaithfulOfCompactlyGenerates [HasCoproducts.{max w v} C]
    [HasCoproducts.{max w v} D] (hG : CompactlyGenerates G)
    (hF : ∀ J : Type (max w v), PreservesColimitsOfShape (Discrete J) F)
    (hFG : ∀ i, IsCompact.{max w v} (F.obj (G i)))
    (h : ∀ (i j : ι) (n m : ℤ),
      Function.Bijective (F.map : ((G i)⟦n⟧ ⟶ (G j)⟦m⟧) → (F.obj ((G i)⟦n⟧) ⟶ F.obj ((G j)⟦m⟧)))) :
    F.FullyFaithful where
  preimage {X Y} f :=
    (Equiv.ofBijective _ (map_bijective_of_compactlyGenerates F hG hF hFG h X Y)).symm f
  map_preimage {X Y} f :=
    (Equiv.ofBijective _ (map_bijective_of_compactlyGenerates F hG hF hFG h X Y)).apply_symm_apply f
  preimage_map {X Y} f :=
    (Equiv.ofBijective _ (map_bijective_of_compactlyGenerates F hG hF hFG h X Y)).symm_apply_apply f

/-- The essential image of a full triangulated functor preserving coproducts is localizing. -/
theorem isLocalizing_essImage [F.Full] [HasCoproducts.{w} C]
    (hF : ∀ J : Type w, PreservesColimitsOfShape (Discrete J) F) :
    IsLocalizing.{w} F.essImage where
  of_iso e h := F.essImage.prop_of_iso e.symm h
  shift X n h := F.essImage.le_shift n X h
  ext₂ T hT h₁ h₃ := F.essImage.ext_of_isTriangulatedClosed₂ T hT h₁ h₃
  coproduct {J Y} c hc h := by
    choose X e using fun j => h j
    have := hF J
    let e' : c.pt ≅ F.obj (∐ X) :=
      hc.coconePointsIsoOfNatIso (isColimitOfPreserves F (coproductIsCoproduct X))
        (Discrete.natIso fun j => (e j.as).some.symm)
    exact ⟨∐ X, ⟨e'.symm⟩⟩

/-- **A coproduct-preserving triangulated functor which is fully faithful on a compact
generator, and sends it to a compact generator, is an equivalence.** -/
theorem isEquivalence_of_compactlyGenerates [HasCoproducts.{max w v} C]
    [HasCoproducts.{max w v} D] (hG : CompactlyGenerates G)
    (hF : ∀ J : Type (max w v), PreservesColimitsOfShape (Discrete J) F)
    (hFG : CompactlyGenerates fun i => F.obj (G i))
    (h : ∀ (i j : ι) (n m : ℤ),
      Function.Bijective (F.map : ((G i)⟦n⟧ ⟶ (G j)⟦m⟧) → (F.obj ((G i)⟦n⟧) ⟶ F.obj ((G j)⟦m⟧)))) :
    F.IsEquivalence := by
  let hff := fullyFaithfulOfCompactlyGenerates F hG hF hFG.isCompact h
  have := hff.full
  have := hff.faithful
  have : F.EssSurj := ⟨fun Y => hFG.forall_of_isLocalizing (isLocalizing_essImage F hF)
    (fun i => F.obj_mem_essImage (G i)) Y⟩
  exact { }

end Criterion

end Categorification
