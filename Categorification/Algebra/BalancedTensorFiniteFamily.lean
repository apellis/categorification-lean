import Categorification.Algebra.BalancedTensor

/-!
# Finite generator families in a balanced tensor

A finite generating family for the lower module gives a sum with one upper
coefficient per generator. A finite family of compatible relations annihilates
that sum by balancing.
-/

open MulOpposite
open scoped BigOperators

namespace Categorification.BalancedTensor

variable {k : Type*} [CommRing k] {T : Type*} [Ring T]
  {M : Type*} [AddCommGroup M] [Module k M] [Module Tᵐᵒᵖ M]
  {N : Type*} [AddCommGroup N] [Module k N] [Module T N]
  {I : Type*} [Fintype I]

/-- If the lower factor is generated by a finite family, every tensor can be
collected into one upper coefficient per lower generator. -/
theorem exists_sum_tmul_of_finite_generators (w : I → N)
    (generate : ∀ n : N, ∃ d : I → T, n=∑ i, d i • w i)
    (z : BalancedTensor k k T M N) :
    ∃ c : I → M, z=∑ i, tmul (c i) (w i) := by
  induction z using BalancedTensor.induction_on with
  | zero => exact ⟨fun _ => 0,by simp⟩
  | tmul m n =>
    obtain ⟨d,rfl⟩ := generate n
    exact ⟨fun i => op (d i) • m,by simp only [tmul_sum,op_smul_tmul]⟩
  | add x y hx hy =>
    obtain ⟨c,hc⟩ := hx
    obtain ⟨d,hd⟩ := hy
    refine ⟨fun i => c i+d i,?_⟩
    simp only [hc,hd,add_tmul,Finset.sum_add_distrib]

variable {J : Type*} [Fintype J]

/-- A finite collection of elementary relations vanishes after balancing when
each relation is multiplied by a coefficient in the right module. -/
theorem sum_tmul_eq_zero_of_jointRelations
    (w : I → N) (x : I → M) (p : I → T) (g : J → M) (d : J → I → T)
    (hw : ∀ i, p i • w i = w i)
    (hx : ∀ i, op (p i) • x i = ∑ j, op (d j i) • g j)
    (hd : ∀ j, ∑ i, d j i • w i = 0) :
    (∑ i, tmul (x i) (w i) : BalancedTensor k k T M N) = 0 := by
  calc
    _ = ∑ i, tmul (op (p i) • x i) (w i) := by
      simp only [op_smul_tmul, hw]
    _ = ∑ i, ∑ j, tmul (op (d j i) • g j) (w i) := by
      simp only [hx]
      exact Finset.sum_congr rfl (fun i _ => map_sum ((mkBil k k T M N).flip (w i)) ..)
    _ = ∑ j, tmul (g j) (∑ i, d j i • w i) := by
      rw [Finset.sum_comm]
      simp only [op_smul_tmul]
      exact Finset.sum_congr rfl (fun j _ => (map_sum (mkBil k k T M N (g j)) ..).symm)
    _ = 0 := by
      simp only [hd, tmul_zero, Finset.sum_const_zero]

end Categorification.BalancedTensor
