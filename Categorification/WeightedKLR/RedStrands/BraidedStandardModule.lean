import Categorification.WeightedKLR.RedStrands.BraidedStandardIso
import Categorification.WeightedKLR.RedStrands.StandardModule

set_option backward.isDefEq.respectTransparency false

/-!
# The loading standard in the two-red edge quotient

Webster, arXiv:1309.3796v2, §5.1 Definition 5.1 and §6.1 Proposition 6.9, Figure 5.
For the loading `t` with both red strands at its left, its standard module over the ordered
violated corner is the quotient of `e(t) T` by the images of strictly higher loading projectives.
The extra generators of the edge ideal in Figure 5 are exactly the nonviolated higher loadings:
a black strand has moved between the two reds. Compressing the ideal to the diagonal of the
swapped order therefore identifies the edge corner with that loading standard.
-/

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR Equiv MvPolynomial MulOpposite

variable {I : Type} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "A" => BraidedStendhalAlgebra k Q Λ ν
local notation "V" => ViolQuotient k Q Λ ν
local notation "C" => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν)
local notation "ι" => ofKLR k Q Λ ν
local notation "q" => violMk k Q Λ ν
local notation:max "E" j:arg => ι (KLRAlgebra.e j)
local notation:max "P" κ:arg => redProj k Q Λ ν κ

private noncomputable def violSandwich (t : Seq μ) (κ : List (Fin ℓ)) : V →+ violCorner k Q Λ ν t κ where
  toFun x := ⟨q (E t) * x * q (P κ), by
    obtain ⟨a, rfl⟩ := violMk_surjective x
    simpa only [map_mul] using mem_violCorner (s := t) (κ := κ) a⟩
  map_zero' := Subtype.ext (by simp)
  map_add' x y := Subtype.ext (by simp only [mul_add, add_mul]; rfl)

private noncomputable def violOrderSandwich (κ : List (Fin ℓ)) (x : V) : C κ :=
  ⟨q (P κ) * x * q (P κ), x, rfl⟩

/-- The submodule of `e(t) T` generated by the images of strictly higher loading projectives,
where `T` is the violated corner at order `κ`. For `redWord t = κ`, its generators are the
products `e(t) a e(j)` in `T`: the red-order projection on the right restricts `j` to `κ`,
and the middle factor can then be compressed to that same order. -/
noncomputable def violStandardUpper (t : Seq μ) (κ : List (Fin ℓ)) :
    Submodule (C κ)ᵐᵒᵖ (violCorner k Q Λ ν t κ) :=
  Submodule.span _ {y | ∃ (j : Seq μ) (a : V), redWord j = κ ∧ StendhalLT t j ∧
    y = violSandwich t κ (a * q (E j))}

/-- Webster, arXiv:1309.3796v2, §5.1, Definition 5.1, in the violated corner at `κ`:
`S_t = e(t) T / U_t` for a nonviolated loading `t` of that order. As in `StendhalAlgebra.standardModule`,
the order is strict (the printed `≥` would kill `e(t)`). This is the ungraded loading standard,
not the functorial standardization of Definition 5.4. -/
noncomputable abbrev ViolLoadingStandard (t : Seq μ) (κ : List (Fin ℓ)) :=
  (violCorner k Q Λ ν t κ) ⧸ violStandardUpper t κ

private noncomputable def edgeCornerProjection (r : Fin ℓ) (t : Seq μ) (κ : List (Fin ℓ)) :
    violCorner k Q Λ ν t κ →ₗ[(C κ)ᵐᵒᵖ] edgeCorner k Q Λ ν r t κ where
  toFun x := ⟨edgeOfViol k Q Λ ν r x.1, by
    have h := mem_violCorner_iff.1 x.2
    apply mem_edgeCorner_iff.2
    constructor
    · simpa only [map_mul, edgeOfViol_violMk] using congrArg (edgeOfViol k Q Λ ν r) h.1
    · simpa only [map_mul, edgeOfViol_violMk] using congrArg (edgeOfViol k Q Λ ν r) h.2⟩
  map_add' x y := Subtype.ext (map_add (edgeOfViol k Q Λ ν r) x.1 y.1)
  map_smul' a x := Subtype.ext (by
    rw [RingHom.id_apply, edgeCorner_smul_val]
    change edgeOfViol k Q Λ ν r (a • x).1 = _
    rw [violCorner_smul_val]
    exact map_mul (edgeOfViol k Q Λ ν r) x.1 a.unop.val)

private theorem edgeCornerProjection_sandwich_val (r : Fin ℓ) (t : Seq μ) (κ : List (Fin ℓ))
    (a : A) : (edgeCornerProjection r t κ (violSandwich t κ (q a))).1 =
      edgeMk k Q Λ ν r (E t * a * P κ) := by
  change edgeOfViol k Q Λ ν r (q (E t) * q a * q (P κ)) = _
  rw [← map_mul, ← map_mul, edgeOfViol_violMk]

private theorem edgeCornerProjection_surjective (r : Fin ℓ) (t : Seq μ) (κ : List (Fin ℓ)) :
    Function.Surjective (edgeCornerProjection (k := k) (Q := Q) (Λ := Λ) r t κ) := by
  intro y
  obtain ⟨a, ha⟩ := edgeMk_surjective r y.1
  refine ⟨violSandwich t κ (q a), Subtype.ext ?_⟩
  have h := mem_edgeCorner_iff.1 y.2
  rw [edgeCornerProjection_sandwich_val, map_mul, map_mul, ha, h.1, h.2]

section TwoRed

variable {Λ₂ : Fin 2 → I →₀ ℕ}
local notation "μ₂" => stendhalWeight 2 ν
local notation "m₂" => Multiset.card (stendhalWeight 2 ν)

omit [DecidableEq I] in
private theorem redWord_pair_of_first {j : Seq μ₂} {r d : Fin 2} (hne : r ≠ d)
    (h0 : 0 < m₂) (hj : j.lbl ⟨0, h0⟩ = .inr r) : redWord j = [r, d] := by
  obtain ⟨L, hL⟩ := exists_redWord_eq_cons h0 hj
  have hp : (redWord j).Perm [r, d] := by
    apply (List.perm_ext_iff_of_nodup (redWord_nodup _) (by simp [hne])).2
    intro x
    refine ⟨fun _ => ?_, fun _ => mem_redWord j x⟩
    have hx : x = r ∨ x = d := by
      have := x.isLt
      have := r.isLt
      have := d.isLt
      simp only [Fin.ext_iff] at hne ⊢
      omega
    simpa using hx
  rw [hL] at hp ⊢
  rw [(hp.cons_inv).eq_singleton]

omit [DecidableEq I] in
private theorem red_labels_ne {t : Seq μ₂} {r d : Fin 2} (h1 : 1 < m₂)
    (ht₀ : t.lbl ⟨0, by omega⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d) : r ≠ d := by
  rintro rfl
  have h := congrArg Fin.val (lbl_inj_of_inr t r ht₀ ht₁)
  contradiction

private theorem blackCount_two_reds_first (t : Seq μ₂) {r d : Fin 2} (h1 : 1 < m₂)
    (ht₀ : t.lbl ⟨0, by omega⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d)
    (p : Fin 2) (i : I) : blackCount t p i = 0 := by
  rw [blackCount, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro a _ ha
  have hp : p = r ∨ p = d := by
    have hne := red_labels_ne h1 ht₀ ht₁
    have := p.isLt
    have := r.isLt
    have := d.isLt
    simp only [Fin.ext_iff] at hne ⊢
    omega
  rcases hp with rfl | rfl
  · exact Nat.not_lt_zero _ (ha.2 _ ht₀)
  · have ha' := ha.2 _ ht₁
    have ha₀ : a = ⟨0, by omega⟩ := Fin.ext (Nat.lt_one_iff.1 ha')
    rw [ha₀, ht₀] at ha
    cases ha.1

/-- The strict order of §5.1 at the upper loading of Figure 5: among nonviolated loadings of
its red order, being higher means that the second strand is black. -/
private theorem higher_iff_second_black {t j : Seq μ₂} {r d : Fin 2} (h1 : 1 < m₂)
    (ht₀ : t.lbl ⟨0, by omega⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d)
    (hj : redWord j = [r, d]) (hv : ¬ IsViolated j) :
    StendhalLT t j ↔ (j.lbl ⟨1, h1⟩).isLeft := by
  have hj₀ := lbl_zero_of_not_isViolated (by omega) hv hj
  have hne := red_labels_ne h1 ht₀ ht₁
  constructor
  · intro h
    cases hj₁ : j.lbl ⟨1, h1⟩ with
    | inl i => simp
    | inr p =>
      have hp : p = d := by
        have hpr : p ≠ r := by
          intro hpr
          have hl : j.lbl ⟨1, h1⟩ = .inr r := hj₁.trans (congrArg Sum.inr hpr)
          have h := congrArg Fin.val (lbl_inj_of_inr j r hl hj₀)
          contradiction
        have := p.isLt
        have := r.isLt
        have := d.isLt
        simp only [Fin.ext_iff] at hpr hne ⊢
        omega
      subst p
      exact False.elim (h.2 fun p i => by
        rw [blackCount_two_reds_first j h1 hj₀ hj₁]
        exact Nat.zero_le _)
  · cases hj₁ : j.lbl ⟨1, h1⟩ with
    | inr p => simp
    | inl i =>
      intro _
      refine ⟨fun p i => by rw [blackCount_two_reds_first t h1 ht₀ ht₁]; omega, fun h => ?_⟩
      have hz := h d i
      rw [blackCount_two_reds_first t h1 ht₀ ht₁] at hz
      have ha : (⟨1, h1⟩ : Fin m₂) ∈ (Finset.univ.filter fun a =>
          j.lbl a = .inl i ∧ ∀ b, j.lbl b = .inr d → a < b) := by
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        refine ⟨hj₁, fun b hb => ?_⟩
        have h0 : b.val ≠ 0 := fun h => by
          rw [show b = ⟨0, by omega⟩ from Fin.ext h, hj₀] at hb
          exact hne (Sum.inr.inj hb)
        have h1' : b.val ≠ 1 := fun h => by
          rw [show b = ⟨1, h1⟩ from Fin.ext h, hj₁] at hb
          cases hb
        show 1 < b.val
        omega
      exact (Nat.not_lt_zero _ (lt_of_lt_of_le (Finset.card_pos.2 ⟨_, ha⟩) hz))

local notation "A₂" => BraidedStendhalAlgebra k Q Λ₂ ν
local notation "q₂" => violMk k Q Λ₂ ν
local notation:max "E₂" j:arg => ofKLR k Q Λ₂ ν (KLRAlgebra.e j)
local notation:max "P₂" κ:arg => redProj k Q Λ₂ ν κ

private theorem violStandardUpper_eq_ker {t : Seq μ₂} {r d : Fin 2} (h1 : 1 < m₂)
    (ht₀ : t.lbl ⟨0, by omega⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d) :
    violStandardUpper (k := k) (Q := Q) (Λ := Λ₂) t [r, d] =
      (edgeCornerProjection r t [r, d]).ker := by
  apply le_antisymm
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨j, a, hj, hjt, rfl⟩
    obtain ⟨a, rfl⟩ := violMk_surjective a
    change _ ∈ (edgeCornerProjection (Λ := Λ₂) r t [r, d]).ker
    rw [LinearMap.mem_ker]
    apply Subtype.ext
    rw [← map_mul, edgeCornerProjection_sandwich_val]
    change edgeMk k Q Λ₂ ν r _ = 0
    rw [edgeMk_eq_zero_iff]
    apply TwoSidedIdeal.mul_mem_right
    rw [← mul_assoc]
    apply TwoSidedIdeal.mul_mem_left
    apply TwoSidedIdeal.subset_span
    refine ⟨j, ?_, rfl⟩
    by_cases hv : IsViolated j
    · exact Or.inl hv
    · exact Or.inr ⟨h1, lbl_zero_of_not_isViolated (by omega) hv hj,
        (higher_iff_second_black h1 ht₀ ht₁ hj hv).1 hjt⟩
  · have hspan (z : A₂) (hz' : z ∈ edgeIdeal k Q Λ₂ ν r) :
        violSandwich t [r, d] (q₂ z) ∈ violStandardUpper (Λ := Λ₂) t [r, d] := by
      rw [edgeIdeal, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hz'
      induction hz' using AddSubgroup.closure_induction with
      | zero => rw [map_zero, map_zero]; exact zero_mem _
      | add x y _ _ hx hy => rw [map_add, map_add]; exact add_mem hx hy
      | neg x _ hx => rw [map_neg, map_neg]; exact neg_mem hx
      | mem w hw =>
        obtain ⟨_, ⟨a, -, _, ⟨j, h, rfl⟩, rfl⟩, b, -, rfl⟩ := hw
        rcases h with h | ⟨hj₁, hj₀, hblack⟩
        · simp only [map_mul, violMk_e h, mul_zero, zero_mul, map_zero]
          exact zero_mem _
        · have hj := redWord_pair_of_first (red_labels_ne h1 ht₀ ht₁) (by omega) hj₀
          have hv := not_isViolated_of_lbl_zero (by omega) hj₀
          have hgen : violSandwich t [r, d] (q₂ (a * E₂ j)) ∈
              violStandardUpper (Λ := Λ₂) t [r, d] :=
            Submodule.subset_span ⟨j, q₂ a, hj,
              (higher_iff_second_black h1 ht₀ ht₁ hj hv).2 hblack, congrArg _ (map_mul q₂ _ _)⟩
          have hcut : E₂ j * P₂ [r, d] = E₂ j := by rw [e_mul_redProj, ite_eq_left hj]
          have heq : violSandwich t [r, d] (q₂ (a * E₂ j * b)) =
              op (violOrderSandwich [r, d] (q₂ b)) • violSandwich t [r, d] (q₂ (a * E₂ j)) := by
            apply Subtype.ext
            rw [violCorner_smul_val]
            change q₂ (E₂ t) * q₂ (a * E₂ j * b) * q₂ (P₂ [r, d]) =
              q₂ (E₂ t) * q₂ (a * E₂ j) * q₂ (P₂ [r, d]) * (q₂ (P₂ [r, d]) * q₂ b * q₂ (P₂ [r, d]))
            simp only [← map_mul]
            congr 1
            simp only [mul_assoc]
            rw [← mul_assoc (E₂ j) (P₂ [r, d]), hcut, ← mul_assoc (E₂ j) (P₂ [r, d]), hcut]
          rw [heq]
          exact Submodule.smul_mem _ _ hgen
    intro y hy
    obtain ⟨z, hz⟩ := violMk_surjective (Λ := Λ₂) y.1
    have hz' : z ∈ edgeIdeal k Q Λ₂ ν r := by
      rw [← edgeMk_eq_zero_iff, ← edgeOfViol_violMk, hz]
      exact congrArg Subtype.val (LinearMap.mem_ker.1 hy)
    have hy' : violSandwich t [r, d] (q₂ z) = y := by
      apply Subtype.ext
      change q₂ (E₂ t) * q₂ z * q₂ (P₂ [r, d]) = y.1
      rw [hz, (mem_violCorner_iff.1 y.2).1, (mem_violCorner_iff.1 y.2).2]
    rw [← hy']
    exact hspan z hz'

/-- Webster, arXiv:1309.3796v2, §6.1, Proposition 6.9 and Figure 5: the edge quotient at the
upper loading of the figure is the loading standard over the swapped-order corner. The map
is the canonical quotient map on diagrams, with no grading or derived assertion. -/
noncomputable def violLoadingStandardEquivEdgeCorner {t : Seq μ₂} {r d : Fin 2} (h1 : 1 < m₂)
    (ht₀ : t.lbl ⟨0, by omega⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d) :
    ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ₂) t [r, d] ≃ₗ[
      (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ₂) (ν := ν) [r, d])ᵐᵒᵖ]
      edgeCorner k Q Λ₂ ν r t [r, d] := by
  let U := violStandardUpper (k := k) (Q := Q) (Λ := Λ₂) t [r, d]
  let f := edgeCornerProjection (k := k) (Q := Q) (Λ := Λ₂) r t [r, d]
  have hU : U = f.ker := violStandardUpper_eq_ker (k := k) (Q := Q) (Λ₂ := Λ₂) h1 ht₀ ht₁
  have hf : Function.Surjective f := edgeCornerProjection_surjective r t [r, d]
  exact (Submodule.quotEquivOfEq U f.ker hU).trans (f.quotKerEquivOfSurjective hf)

/-- Webster, arXiv:1309.3796v2, §6.1, Proposition 6.9, Figure 5: the two-red loading standard
is isomorphic as an ungraded right module to the cut of the braiding bimodule, by the figure's
diagram. This does not identify a standardization functor or evaluate a tensor product. -/
noncomputable def violLoadingStandardEquivBraidCorner
    {ρ : Perm (Fin m₂) → List ℕ} (hρ : TypeA.IsReducedChoice ρ) (hQ : KLRSymm Q)
    {s t : Seq μ₂} {r d : Fin 2} {g : Perm (Fin m₂)} (h1 : 1 < m₂)
    (ht₀ : t.lbl ⟨0, by omega⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d)
    (hb : EdgeBraid (show 0 < m₂ by omega) r g s t) :
    ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ₂) t [r, d] ≃ₗ[
      (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ₂) (ν := ν) [r, d])ᵐᵒᵖ]
      violCorner k Q Λ₂ ν s [r, d] :=
  (violLoadingStandardEquivEdgeCorner h1 ht₀ ht₁).trans (braidCornerRightEquiv k Q Λ₂ hρ hQ hb [d])

/-- On a representative of the loading standard, the comparison is multiplication by the
Figure 5 diagram, evaluated in the quotient by violated idempotents. -/
theorem violLoadingStandardEquivBraidCorner_mk
    {ρ : Perm (Fin m₂) → List ℕ} (hρ : TypeA.IsReducedChoice ρ) (hQ : KLRSymm Q)
    {s t : Seq μ₂} {r d : Fin 2} {g : Perm (Fin m₂)} (h1 : 1 < m₂)
    (ht₀ : t.lbl ⟨0, by omega⟩ = .inr r) (ht₁ : t.lbl ⟨1, h1⟩ = .inr d)
    (hb : EdgeBraid (show 0 < m₂ by omega) r g s t) (x : violCorner k Q Λ₂ ν t [r, d]) :
    (violLoadingStandardEquivBraidCorner hρ hQ h1 ht₀ ht₁ hb (Submodule.Quotient.mk x)).1 =
      q₂ (ofKLR k Q Λ₂ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t)) * x.1 := by
  have hx : (violLoadingStandardEquivEdgeCorner h1 ht₀ ht₁ (Submodule.Quotient.mk x)).1 =
      edgeOfViol k Q Λ₂ ν r x.1 := rfl
  rw [violLoadingStandardEquivBraidCorner, LinearEquiv.trans_apply, braidCornerRightEquiv_apply,
    braidCornerEquiv_apply, hx]
  obtain ⟨a, ha⟩ := violMk_surjective x.1
  rw [← ha, edgeOfViol_violMk, braidQuot_edgeMk, map_mul]

end TwoRed

end Categorification.Stendhal.BraidedStendhalAlgebra