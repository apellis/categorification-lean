import Categorification.WeightedKLR.Rigidity.CupCapFunctor
import Categorification.Algebra.DerivedTensorTriangulated
import Categorification.Algebra.DerivedTensorCoproducts
import DG.Compact.Brown
import DG.Derived.Perfect

/-!
# The quantum trace functor `𝕋^{λ⁺}_λ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.3,
Definition 7.18 (second part).

The quantum trace functor is the right adjoint of the coevaluation functor
`𝕂^{λ⁺}_λ = - ⊗ᴸ_{T^λ} K^{λ⁺}_λ` (`coevaluationFunctor`), followed by a homological shift. The
right adjoint exists for every coefficient
module `L` at the maximum of the cap: the derived category of right `T^λ`-modules is compactly
generated by the regular module, and `𝕂^{λ⁺}_λ` is a triangulated functor preserving
coproducts, so Brown representability (`DG.CompactlyGenerates.isLeftAdjoint`) gives the right
adjoint. Webster describes it as `RHom_{T^{λ⁺}}(K^{λ⁺}_λ, -)`; here it is characterized by the
adjunction (`coevaluationAdjunction`), which determines it up to unique isomorphism.

## Main definitions

* `CupCap.coevaluationRightAdjoint`: `RHom_{T^{λ⁺}}(K^{λ⁺}_λ, -) : D(T^{λ⁺}) ⥤ D(T^λ)` on derived
  categories of right modules, and `CupCap.coevaluationAdjunction`.
* `CupCap.quantumTraceFunctor`: `𝕋^{λ⁺}_λ`, the right adjoint followed by the shift.
-/

noncomputable section

namespace Categorification.Stendhal.CupCap

open CategoryTheory DG DG.DegreeZero

universe u

variable {I : Type u} [DecidableEq I] (k : Type u) [CommRing k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ) (Λc : Fin 2 → I →₀ ℕ)
  (j : ℕ) (hj : j ≤ ℓ) (ν ν₀ : Multiset I)
  (L : Type u) [AddCommGroup L] [Module (StendhalAlgebra k Q Λc ν₀)ᵐᵒᵖ L]
  [HasDerivedCategory.{u} (TensorProductAlgebra k Q Λ ν)ᵐᵒᵖ]
  [HasDerivedCategory.{u} (TensorProductAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))ᵐᵒᵖ]

noncomputable instance coevaluationFunctor_commShift :
    (coevaluationFunctor.{u} k Q Λ Λc j hj ν ν₀ L).CommShift ℤ :=
  inferInstanceAs ((derivedRightTensor.{u} (TensorProductAlgebra k Q Λ ν)
    (TensorProductAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))
    (CapBimodule k Q Λ Λc j hj ν ν₀ L)).CommShift ℤ)

instance coevaluationFunctor_isTriangulated :
    (coevaluationFunctor.{u} k Q Λ Λc j hj ν ν₀ L).IsTriangulated :=
  inferInstanceAs (derivedRightTensor.{u} (TensorProductAlgebra k Q Λ ν)
    (TensorProductAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))
    (CapBimodule k Q Λ Λc j hj ν ν₀ L)).IsTriangulated

/-- The coevaluation functor has a right adjoint (Brown representability). -/
instance coevaluationFunctor_isLeftAdjoint :
    (coevaluationFunctor.{u} k Q Λ Λc j hj ν ν₀ L).IsLeftAdjoint :=
  (DG.DerivedCategory.compactlyGenerates (A := (TensorProductAlgebra k Q Λ ν)ᵐᵒᵖ)).isLeftAdjoint
    _ fun J => inferInstanceAs (Limits.PreservesColimitsOfShape (Discrete J)
      (derivedRightTensor.{u} (TensorProductAlgebra k Q Λ ν)
        (TensorProductAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))
        (CapBimodule k Q Λ Λc j hj ν ν₀ L)))

/-- The right adjoint of the coevaluation functor `𝕂^{λ⁺}_λ`, from the derived category of right
`T^{λ⁺}`-modules to that of right `T^λ`-modules: Webster's `RHom_{T^{λ⁺}}(K^{λ⁺}_λ, -)`. -/
def coevaluationRightAdjoint :
    DG.DerivedCategory.{u} (TensorProductAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))ᵐᵒᵖ ⥤
      DG.DerivedCategory.{u} (TensorProductAlgebra k Q Λ ν)ᵐᵒᵖ :=
  (coevaluationFunctor.{u} k Q Λ Λc j hj ν ν₀ L).rightAdjoint

/-- The adjunction `𝕂^{λ⁺}_λ ⊣ RHom_{T^{λ⁺}}(K^{λ⁺}_λ, -)`. -/
def coevaluationAdjunction :
    coevaluationFunctor.{u} k Q Λ Λc j hj ν ν₀ L ⊣ coevaluationRightAdjoint k Q Λ Λc j hj ν ν₀ L :=
  Adjunction.ofIsLeftAdjoint _

/-- **The quantum trace functor** `𝕋^{λ⁺}_λ = RHom_{T^{λ⁺}}(K^{λ⁺}_λ, -)[shift]`
(arXiv:1309.3796v3, Definition 7.18). Webster's homological shift is `shift = -⟨2ρ^∨, μ⟩` for the
label `μ` of the cap; the internal grading shift `(2⟨μ, ρ⟩)` is not tracked, as for the
coevaluation functor. -/
def quantumTraceFunctor (shift : ℤ) :
    DG.DerivedCategory.{u} (TensorProductAlgebra k Q (plusLabels Λ Λc j hj) (ν + ν₀))ᵐᵒᵖ ⥤
      DG.DerivedCategory.{u} (TensorProductAlgebra k Q Λ ν)ᵐᵒᵖ :=
  coevaluationRightAdjoint k Q Λ Λc j hj ν ν₀ L ⋙
    shiftFunctor (DG.DerivedCategory.{u} (TensorProductAlgebra k Q Λ ν)ᵐᵒᵖ) shift

end Categorification.Stendhal.CupCap
