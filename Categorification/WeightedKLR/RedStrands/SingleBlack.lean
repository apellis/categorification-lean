import Categorification.WeightedKLR.RedStrands.SingleRed
import Categorification.KLR.CyclotomicSingleK0
import Categorification.KLR.DividedPowerIdempotents
import Categorification.WeightedKLR.RedStrands.StendhalGrading
import Mathlib.RingTheory.AdjoinRoot

/-!
# One black strand in Webster's one-factor algebra

B. Webster, arXiv:1309.3796v2, §4.4, Theorem 4.20. In black weight
`αᵢ` the cyclotomic KLR algebra is a truncated polynomial ring. The map
from Stendhal diagrams evaluates the unique nonviolated word at 1 and
its black dot at the tautological root.

For §4.7, Theorem 4.38, the same one-factor block of graded projective
`K₀` is freely generated by the regular class for positive multiplicity.
At multiplicity zero its Grothendieck group vanishes.
-/

noncomputable section

namespace Categorification.Stendhal.SingleBlack

open KLR StendhalAlgebraAllOrders

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type*} {k : Type*} [CommRing k] (i : I)
variable (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin 1 → I →₀ ℕ)

local notation "μ" => stendhalWeight 1 (Singleton.singleton i : Multiset I)
local notation "pΛ" => (Polynomial.X ^ Λ 0 i : Polynomial k)
local notation "S" => AdjoinRoot pΛ

private theorem weight_eq : μ = ({Sum.inr 0} + {Sum.inl i} : Multiset (I ⊕ Fin 1)) := by
  simp [stendhalWeight, add_comm]

private theorem card_eq : Multiset.card μ = 2 := by simp [stendhalWeight]

/-- The red strand followed by the black strand. -/
def word : Seq μ :=
  KLRAlgebra.Seq.ofList [.inr 0, .inl i] (by rw [weight_eq]; rfl)

private theorem word_zero : (word i).lbl ⟨0, by rw [card_eq]; decide⟩ = .inr 0 := rfl

private theorem word_one : (word i).lbl ⟨1, by rw [card_eq]; decide⟩ = .inl i := rfl

private theorem word_not_violated : ¬ IsViolated (word i) := by
  rintro ⟨h, hv⟩
  rw [word_zero] at hv
  exact Bool.noConfusion hv

variable [DecidableEq I]

private def gen : Gen μ → S
  | .idem s => if s = word i then 1 else 0
  | .dot a => if a.val = 1 then AdjoinRoot.root pΛ else 0
  | .cross _ => 0

omit [DecidableEq I] in
private theorem root_pow : (AdjoinRoot.root pΛ) ^ Λ 0 i = 0 := by
  simpa only [← AdjoinRoot.mk_X, ← map_pow] using (AdjoinRoot.mk_self (f := pΛ))

omit [DecidableEq I] in
private theorem ncEval_eq_aeval {A : Type*} [CommRing A] [Algebra k A]
    {n : ℕ} (v : Fin n → A) (p : MvPolynomial (Fin n) k) :
    ncEval v p = MvPolynomial.aeval v p := by
  simpa using (ncEval_algHom_X (MvPolynomial.aeval v) id p)

private theorem eval_rel {x y : FreeAlgebra k (Gen μ)} (h : Rel k Q Λ {i} x y) :
    FreeAlgebra.lift k (gen (k := k) i Λ) x = FreeAlgebra.lift k (gen (k := k) i Λ) y := by
  classical
  cases h with
  | red_dot a s hr =>
    by_cases hs : s = word i
    · subst s
      have ha : a.val ≠ 1 := by
        intro h
        have h' := (congrArg (word i).lbl (Fin.ext h)).trans (word_one i)
        simp [h'] at hr
      simp [fx, fe, gen, ha]
    · simp [fx, fe, gen, hs]
  | red_cross => simp [fψ, fe, gen]
  | klr h =>
    cases h with
    | idem_mul s t =>
      by_cases hst : s = t <;> by_cases hs : s = word i <;>
        by_cases ht : t = word i <;> simp_all [fe, gen]
    | idem_sum => simp [fe, gen]
    | dot_idem | dot_dot => simp [fx, fe, gen, mul_comm]
    | cross_idem | cross_zero | cross_cross | dot_cross => simp [fx, fe, fψ, gen]
    | dot_cross_left j h s | dot_cross_right j h s =>
      have hj : j = 0 := by rw [card_eq] at h; omega
      subst j
      by_cases hs : s = word i
      · subst s
        simp [fx, fe, fψ, gen, word_zero, word_one]
      · split_ifs <;> simp [fx, fe, fψ, gen, hs]
    | cross_sq j h s =>
      have hj : j = 0 := by rw [card_eq] at h; omega
      subst j
      by_cases hs : s = word i
      · subst s
        simp [fx, fe, fψ, gen, word_zero, word_one, ncEval_map, ncEval_eq_aeval,
          root_pow, stendhalQ]
      · split_ifs <;> simp [fe, fψ, gen, hs]
    | braid j h s => rw [card_eq] at h; omega

/-- Evaluation of Stendhal diagrams with both boundary orderings. -/
def evalAll : StendhalAlgebraAllOrders k Q Λ {i} →ₐ[k] S :=
  RingQuot.liftAlgHom k ⟨FreeAlgebra.lift k (gen (k := k) i Λ), fun _ _ h => eval_rel i Q Λ h⟩

private theorem evalAll_mk (x : FreeAlgebra k (Gen μ)) :
    evalAll i Q Λ (RingQuot.mkAlgHom k (Rel k Q Λ {i}) x) = FreeAlgebra.lift k (gen (k := k) i Λ) x :=
  RingQuot.liftAlgHom_mkAlgHom_apply _ _ _ _

private theorem evalAll_e (s : Seq μ) :
    evalAll i Q Λ (e s) = if s = word i then 1 else 0 := by
  rw [e, KLRAlgebra.e, ofKLR_mk, evalAll_mk]
  simp [fe, gen]

omit [DecidableEq I] in
private theorem eq_word_of_not_violated (s : Seq μ) (hs : ¬ IsViolated s) : s = word i := by
  have hc := card_eq i
  have h0 : 0 < Multiset.card μ := by omega
  have h1 : 1 < Multiset.card μ := by omega
  have hr : s.lbl ⟨0, h0⟩ = .inr 0 := by
    cases h : s.lbl ⟨0, h0⟩ with
    | inl c => exact (hs ⟨h0, by simp [h]⟩).elim
    | inr r => exact congrArg Sum.inr (Subsingleton.elim r 0)
  have hmem : Sum.inl i ∈ Finset.univ.val.map s.lbl := by
    rw [show Finset.univ.val.map s.lbl = μ from s.2, weight_eq]
    simp
  obtain ⟨b, _, hb⟩ := Multiset.mem_map.1 hmem
  have hb0 : b.val ≠ 0 := by
    intro h
    have h' := (congrArg s.lbl (Fin.ext h)).trans hr
    rw [hb] at h'
    contradiction
  have hb1 : b.val = 1 := by have := b.2; omega
  apply Subtype.ext
  funext a
  by_cases ha : a.val = 0
  · exact (congrArg s.lbl (Fin.ext ha)).trans (hr.trans ((congrArg (word i).lbl (Fin.ext ha)).trans
      (word_zero i)).symm)
  · have ha1 : a.val = 1 := by have := a.2; omega
    exact (congrArg s.lbl (Fin.ext (ha1.trans hb1.symm))).trans (hb.trans
      ((congrArg (word i).lbl (Fin.ext ha1)).trans (word_one i)).symm)

private def evalCorner : StendhalAlgebra k Q Λ {i} →ₐ[k] S :=
  (evalAll i Q Λ).comp (SingleRed.orderedEquiv Q Λ {i}).symm.toAlgHom

/-- Evaluation at the black dot on the surviving red-black word. -/
def eval : TensorProductAlgebra k Q Λ {i} →ₐ[k] S :=
  (StendhalAlgebra.violatedIdeal k Q Λ {i}).ringCon.liftₐ (evalCorner i Q Λ) (by
    apply (TwoSidedIdeal.ringCon_le_iff (J := TwoSidedIdeal.ker (evalCorner i Q Λ).toRingHom)).mp
    apply TwoSidedIdeal.span_le.2
    rintro _ ⟨s, ho, hv, rfl⟩
    apply (TwoSidedIdeal.mem_ker _).mpr
    change evalAll i Q Λ (e s) = 0
    have hs : s ≠ word i := fun h => word_not_violated i (h ▸ hv)
    rw [evalAll_e, ite_eq_right hs])

private theorem eval_mk (z : StendhalAlgebraAllOrders k Q Λ {i}) :
    eval i Q Λ (SingleRed.mk Q Λ {i} z) = evalAll i Q Λ z := by
  exact RingCon.liftₐ_mk _ _ _ _

private theorem mk_e_word : SingleRed.mk Q Λ {i} (e (word i)) = 1 := by
  classical
  have hsum : (∑ s : Seq μ, e s : StendhalAlgebraAllOrders k Q Λ {i}) = 1 := by
    simp only [e, ← map_sum, KLRAlgebra.sum_e, map_one]
  have hs := congrArg (SingleRed.mk Q Λ {i}) hsum
  rw [map_sum, map_one, Finset.sum_eq_single (word i)] at hs
  · exact hs
  · intro s _ hne
    exact SingleRed.mk_e_of_violated Q Λ s (by
      by_contra h
      exact hne (eq_word_of_not_violated i s h))
  · simp

/-- The dot on the black strand. -/
def dot : TensorProductAlgebra k Q Λ {i} :=
  SingleRed.mk Q Λ {i} (x ⟨1, by rw [card_eq]; decide⟩)

private theorem eval_dot : eval i Q Λ (dot i Q Λ) = AdjoinRoot.root pΛ := by
  rw [dot, eval_mk, x, KLRAlgebra.x, ofKLR_mk, evalAll_mk]
  simp [fx, gen]

private theorem dot_pow : dot i Q Λ ^ Λ 0 i = 0 := by
  have h := SingleRed.first_black_dot_pow Q Λ (ν := ({i} : Multiset I))
    (by rw [card_eq]; decide) (word i) i (word_zero i) (word_one i)
  rw [mk_e_word, mul_one] at h
  exact h

private theorem aeval_dot_surjective : Function.Surjective (Polynomial.aeval (R := k) (dot i Q Λ)) := by
  intro z
  obtain ⟨a, rfl⟩ := SingleRed.mk_surjective Q Λ {i} z
  obtain ⟨b, rfl⟩ := ofKLR_surjective a
  induction b using KLRAlgebra.klr_induction with
  | hr c => exact ⟨Polynomial.C c, by simp⟩
  | he s =>
    change ∃ p : Polynomial k, _ = SingleRed.mk Q Λ {i} (e s)
    by_cases hs : IsViolated s
    · exact ⟨0, by rw [map_zero, SingleRed.mk_e_of_violated _ _ _ hs]⟩
    · exact ⟨1, by rw [map_one, eq_word_of_not_violated i s hs, mk_e_word]⟩
  | hx a =>
    change ∃ p : Polynomial k, _ = SingleRed.mk Q Λ {i} (x a)
    have hc := card_eq i
    by_cases h0 : a.val = 0
    · rw [show a = ⟨0, by rw [card_eq]; decide⟩ from Fin.ext h0]
      exact ⟨0, by rw [map_zero, SingleRed.mk_first_dot]⟩
    · have ha1 : a.val = 1 := by have := a.2; omega
      rw [show a = ⟨1, by rw [card_eq]; decide⟩ from Fin.ext ha1]
      exact ⟨Polynomial.X, Polynomial.aeval_X _⟩
  | hψ j =>
    refine ⟨0, ?_⟩
    by_cases h0 : j = 0
    · subst j
      exact (map_zero _).trans (SingleRed.mk_first_cross _ _).symm
    · have hf : Multiset.card μ ≤ j + 1 := by rw [card_eq]; omega
      simp [KLRAlgebra.ψ_eq_zero j hf]
  | hadd u v hu hv =>
    obtain ⟨a, ha⟩ := hu
    obtain ⟨b, hb⟩ := hv
    exact ⟨a + b, by rw [map_add, ha, hb, map_add, map_add]⟩
  | hmul u v hu hv =>
    obtain ⟨a, ha⟩ := hu
    obtain ⟨b, hb⟩ := hv
    exact ⟨a * b, by rw [map_mul, ha, hb, map_mul, map_mul]⟩

private theorem eval_aeval_dot (p : Polynomial k) :
    eval i Q Λ (Polynomial.aeval (dot i Q Λ) p) = AdjoinRoot.mk pΛ p := by
  rw [← Polynomial.aeval_algHom_apply, eval_dot, AdjoinRoot.aeval_eq]

/-- **Webster, arXiv:1309.3796v2, Theorem 4.20**, in black weight `αᵢ`:
the black dot gives the canonical coordinate in `k[x]/(x^⟨hᵢ,λ⟩)`. -/
def oneBlackOneRedEquiv : TensorProductAlgebra k Q Λ {i} ≃ₐ[k] S :=
  AlgEquiv.ofBijective (eval i Q Λ) ⟨by
    intro z z' h
    obtain ⟨p, rfl⟩ := aeval_dot_surjective i Q Λ z
    obtain ⟨q, rfl⟩ := aeval_dot_surjective i Q Λ z'
    simp only [eval_aeval_dot] at h
    obtain ⟨t, ht⟩ := AdjoinRoot.mk_eq_mk.mp h
    apply sub_eq_zero.mp
    rw [← map_sub, ht, map_mul, map_pow, Polynomial.aeval_X, dot_pow, zero_mul],
    by
      intro z
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective z
      exact ⟨Polynomial.aeval (dot i Q Λ) p, eval_aeval_dot i Q Λ p⟩⟩

@[simp] theorem oneBlackOneRedEquiv_dot :
    oneBlackOneRedEquiv i Q Λ (dot i Q Λ) = AdjoinRoot.root pΛ := eval_dot i Q Λ

section K0

open Categorification.Graded

variable {k : Type*} [Field k] {Q : I → I → MvPolynomial (Fin 2) k}
    {Λ : Fin 1 → I →₀ ℕ} (G : KLR.GradingDatum (stendhalQ Q Λ))

/-- The one-factor, first lowering block in Webster, arXiv:1309.3796v2,
§4.7, Theorem 4.38, with positive multiplicity: its graded projective
Grothendieck group is Laurent-free on the regular projective. -/
def oneBlackK0Equiv (hi : 0 < Λ 0 i) :
    K0 (tensorProductGrade G {i}) ≃ₗ[LaurentPolynomial ℤ] LaurentPolynomial ℤ :=
  CycKLR.truncatedPolynomialK0Equiv _ (oneBlackOneRedEquiv i Q Λ) hi

@[simp] theorem oneBlackK0Equiv_regular (hi : 0 < Λ 0 i) :
    oneBlackK0Equiv i G hi (K0.of (GProj.regular (tensorProductGrade G {i}))) = 1 :=
  CycKLR.truncatedPolynomialK0Equiv_regular _ (oneBlackOneRedEquiv i Q Λ) hi

/-- For Webster, arXiv:1309.3796v2, §4.7, Theorem 4.38, the one-factor
block at `λ − αᵢ` vanishes when the red weight has zero multiplicity at `i`. -/
theorem oneBlackK0_eq_zero (hi : Λ 0 i = 0) (x : K0 (tensorProductGrade G {i})) : x = 0 := by
  have h := dot_pow i Q Λ
  rw [hi, pow_zero] at h
  let := subsingleton_of_zero_eq_one h.symm
  induction x using K0.induction_on with
  | of P =>
    let := Module.subsingleton (TensorProductAlgebra k Q Λ {i}) P.carrier
    exact K0.of_eq_zero_of_subsingleton P
  | zero => rfl
  | add _ _ hx hy => simp [hx, hy]
  | neg _ hx => simp [hx]

end K0

section Euler

open Categorification.Graded

variable {k : Type*} [Field k]
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin 1 → I →₀ ℕ}
  (G : KLR.GradingDatum (stendhalQ Q Λ))

local notation "ν" => (Singleton.singleton i : Multiset I)
local notation "𝒜" => tensorProductGrade G ν
local notation "deg" => G.degX (Sum.inl i)

/-- The single surviving black dot has the degree of its color. -/
theorem dot_mem_grade : dot i Q Λ ∈ 𝒜 deg := by
  let a : Fin (Multiset.card μ) := ⟨1, by rw [card_eq]; decide⟩
  have hd := G.x_mul_e_mem_grade (k := k) a (word i)
  rw [show (word i).lbl a = .inl i from word_one i] at hd
  have hm := Graded.mem_map_of_mem (G.grade μ) (ofKLR k Q Λ ν).toLinearMap hd
  have hs : (SingleRed.orderedEquiv Q Λ ν)
      (ofKLR k Q Λ ν (KLRAlgebra.x a * KLRAlgebra.e (word i))) ∈ stendhalGrade G ν deg := hm
  have ht := Graded.mem_map_of_mem (stendhalGrade G ν) (TensorProductAlgebra.mk Q Λ ν).toLinearMap hs
  have he : dot i Q Λ = SingleRed.mk Q Λ ν
      (ofKLR k Q Λ ν (KLRAlgebra.x a * KLRAlgebra.e (word i))) := by
    rw [map_mul, map_mul]
    change _ = dot i Q Λ * SingleRed.mk Q Λ ν (e (word i))
    rw [mk_e_word, mul_one]
  rw [he]
  exact ht

end Euler

end Categorification.Stendhal.SingleBlack
