import Categorification.WeightedKLR.Rigidity.CupCapSpanning
import Categorification.KLR.CyclotomicMaps
import Categorification.KLR.BarDivided
import Categorification.KLR.KL2.SerreSeq

/-!
# Strands passing under the maximum of the cap

Webster, arXiv:1309.3796v3, §7.3, proof of Lemma 7.17. In the bimodule `K̃^{λ⁺}_λ` the strands
right of the maximum of the cap pass under it to the left. We compute in the KLR algebra of `λ⁺`
how such a passage `underRight N q` (the strand at position `q` passing under the window
`[q + 1, q + N]` of the strands at the maximum) interacts with the diagrams on that window.

The cap generators at `s` and `n` have the window at `[n, n + N)` in their bottom loadings
`insertSeq s n t`; the passage carries the bottom loadings with window at `q + 1` to those with
window at `q` (`underRight_mul_e_insertSeq`).

A diagram `z` at the maximum slides through the passage up to diagrams in which a strand leaves the
window at the top (`exitSpan`): `ι_{q+1}(z) · underRight N q - underRight N q · ι_q(z)` lies in the
span of the `ι_{q+1}(y) · r` with `y` in the ideal `capNull` generated by the idempotents of the
loadings not of the form `μ ⋯ μ*` (`slides`). A dot moved through the passage leaves a term in
which a window strand of the colour of the passing strand is pulled out to the right end, and such
a strand is black (`slides_x`); a crossing leaves a braid defect of the same kind, whose dots slide
off the crossing (`slides_ψ`). On a coefficient module supported on the loadings `μ ⋯ μ*`, the
ideal `capNull` acts by zero.

## Main results

* `CupCap.slides`: every diagram at the maximum slides through a passage modulo `exitSpan`.
* `CupCap.x_mul_underRight`, `CupCap.ψ_mul_underRight`: the KLR identities behind it.
-/

noncomputable section

namespace Categorification.Stendhal.CupCap

open KLR KLRAlgebra TypeA MvPolynomial

section Generic

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k]

theorem e_mul_eqIdem {μ : Multiset I} {Q' : I → I → MvPolynomial (Fin 2) k} (p : ℕ)
    (h : p + 1 < Multiset.card μ) (t : Seq μ) :
    (KLRAlgebra.e t * KLRAlgebra.eqIdem p h : KLRAlgebra k Q' μ) =
      if t.1 ⟨p, by omega⟩ = t.1 ⟨p + 1, h⟩ then KLRAlgebra.e t else 0 := by
  rw [KLRAlgebra.eqIdem, Finset.mul_sum, Finset.sum_eq_single t]
  · split_ifs <;> simp [KLRAlgebra.e_mul_self]
  · intro u _ hu; split_ifs <;> simp [KLRAlgebra.e_mul_e, Ne.symm hu]
  · simp

theorem range'_split (q : ℕ) {c n : ℕ} (hc : c < n) :
    List.range' q n = List.range' q c ++ (q + c) :: List.range' (q + 1 + c) (n - 1 - c) := by
  obtain ⟨d, rfl⟩ : ∃ d, n = c + (d + 1) := ⟨n - c - 1, by omega⟩
  rw [← List.range'_append_1, List.range'_succ, show c + (d + 1) - 1 - c = d by omega,
    show q + c + 1 = q + 1 + c by omega]

/-- A dot on a passing window strand, moved through the passage `underRight`: the error term has
the strand at the crossing joined to the passing strand. -/
theorem x_mul_underRight {μ : Multiset I} {Q' : I → I → MvPolynomial (Fin 2) k} {q c n : ℕ}
    (hc : c < n) (h : q + n < Multiset.card μ) :
    (KLRAlgebra.x ⟨q + 1 + c, by omega⟩ * KLRAlgebra.ψw (List.range' q n) :
        KLRAlgebra k Q' μ) =
      KLRAlgebra.ψw (List.range' q n) * KLRAlgebra.x ⟨q + c, by omega⟩ -
        KLRAlgebra.ψw (List.range' q c) * KLRAlgebra.eqIdem (q + c) (by omega) *
          KLRAlgebra.ψw (List.range' (q + 1 + c) (n - 1 - c)) := by
  rw [range'_split q hc, KLRAlgebra.ψw_append, KLRAlgebra.ψw_cons]
  have h1 : Commute (KLRAlgebra.x ⟨q + 1 + c, by omega⟩ : KLRAlgebra k Q' μ)
      (KLRAlgebra.ψw (List.range' q c)) :=
    KLRAlgebra.commute_x_ψw fun p hp => by rw [List.mem_range'_1] at hp; dsimp only; omega
  have h2 : Commute (KLRAlgebra.x ⟨q + c, by omega⟩ : KLRAlgebra k Q' μ)
      (KLRAlgebra.ψw (List.range' (q + 1 + c) (n - 1 - c))) :=
    KLRAlgebra.commute_x_ψw fun p hp => by rw [List.mem_range'_1] at hp; dsimp only; omega
  have h3 := KLRAlgebra.x_succ_mul_ψ (k := k) (Q := Q') (ν := μ) (q + c) (by omega)
  rw [show (⟨q + c + 1, _⟩ : Fin (Multiset.card μ)) = ⟨q + 1 + c, by omega⟩ from
    Fin.ext (by simp; omega)] at h3
  rw [← mul_assoc, h1.eq, mul_assoc, ← mul_assoc _ (KLRAlgebra.ψ _), h3, sub_mul,
    mul_assoc (KLRAlgebra.ψ _), h2.eq]
  noncomm_ring

theorem range'_split2 (q : ℕ) {r n : ℕ} (hr : r + 1 < n) :
    List.range' q n = List.range' q r ++ (q + r) :: (q + r + 1) ::
      List.range' (q + 1 + (r + 1)) (n - 1 - (r + 1)) := by
  rw [range'_split q (show r < n by omega), show n - 1 - r = (n - 1 - (r + 1)) + 1 by omega,
    List.range'_succ, show q + 1 + r = q + r + 1 by omega,
    show q + r + 1 + 1 = q + 1 + (r + 1) by omega]

/-- A crossing of two passing window strands, moved through the passage `underRight`: the error
is a braid defect. -/
theorem ψ_mul_underRight {μ : Multiset I} {Q' : I → I → MvPolynomial (Fin 2) k} {q r n : ℕ}
    (hr : r + 1 < n) :
    (KLRAlgebra.ψ (q + r + 1) * KLRAlgebra.ψw (List.range' q n) : KLRAlgebra k Q' μ) =
      KLRAlgebra.ψw (List.range' q n) * KLRAlgebra.ψ (q + r) -
        KLRAlgebra.ψw (List.range' q r) *
          (KLRAlgebra.ψ (q + r) * KLRAlgebra.ψ (q + r + 1) * KLRAlgebra.ψ (q + r) -
            KLRAlgebra.ψ (q + r + 1) * KLRAlgebra.ψ (q + r) * KLRAlgebra.ψ (q + r + 1)) *
          KLRAlgebra.ψw (List.range' (q + 1 + (r + 1)) (n - 1 - (r + 1))) := by
  rw [range'_split2 q hr, KLRAlgebra.ψw_append, KLRAlgebra.ψw_cons, KLRAlgebra.ψw_cons]
  have h1 : Commute (KLRAlgebra.ψ (q + r + 1) : KLRAlgebra k Q' μ)
      (KLRAlgebra.ψw (List.range' q r)) :=
    KLRAlgebra.commute_ψ_ψw fun p hp => by rw [List.mem_range'_1] at hp; omega
  have h2 : Commute (KLRAlgebra.ψ (q + r) : KLRAlgebra k Q' μ)
      (KLRAlgebra.ψw (List.range' (q + 1 + (r + 1)) (n - 1 - (r + 1)))) :=
    KLRAlgebra.commute_ψ_ψw fun p hp => by rw [List.mem_range'_1] at hp; omega
  rw [← mul_assoc, h1.eq]
  simp only [mul_assoc, mul_sub, sub_mul]
  rw [← h2.eq]
  noncomm_ring

end Generic

section Sliding

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {Λc : Fin 2 → I →₀ ℕ}
  {j : ℕ} {hj : j ≤ ℓ} {ν ν₀ : Multiset I}

local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "N" => Multiset.card (stendhalWeight 2 ν₀)
local notation "M" => Multiset.card (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "Rp" =>
  KLRAlgebra k (stendhalQ Q (plusLabels Λ Λc j hj)) (stendhalWeight (ℓ + 2) (ν + ν₀))
local notation "Rc" => KLRAlgebra k (stendhalQ Q Λc) (stendhalWeight 2 ν₀)

omit [DecidableEq I] in
theorem card_plus' : M = m + N := by
  simp [stendhalWeight]; omega

omit [DecidableEq I] in
/-- The passage of the strand at `q` under the window `[q + 1, q + N]` moves the window of a
bottom loading of the cap generators from `q + 1` to `q`. -/
theorem range'_smul_insertSeq (s : Seq (stendhalWeight ℓ ν))
    (t : Seq ((stendhalWeight 2 ν₀).map (cupColour j hj))) {q : ℕ} (hq : q + 1 ≤ m) :
    wordProd M (List.range' q N) • insertSeq s q (by omega) t = insertSeq s (q + 1) hq t := by
  have hM := card_plus' (I := I) (ℓ := ℓ) (ν := ν) (ν₀ := ν₀)
  have hb := Multiset.card_map (cupColour (I := I) (ℓ := ℓ) j hj) (stendhalWeight 2 ν₀)
  apply Subtype.ext
  funext c
  have hc := c.2
  change (wordProd M (List.range' q N) • insertSeq s q _ t).lbl c = (insertSeq s (q + 1) hq t).lbl c
  rw [KL2.lbl_range'_smul (by omega) _ c ⟨KL2.rfun q N c, by unfold KL2.rfun; split_ifs <;> omega⟩
    rfl]
  by_cases h1 : c.val < q
  · have e1 : KL2.rfun q N c = c.val := by unfold KL2.rfun; split_ifs <;> omega
    rw [insertSeq_lbl_lt s _ t ⟨c.val, by omega⟩ (by simp; omega) (by simp [e1]),
      insertSeq_lbl_lt s _ t ⟨c.val, by omega⟩ (by simp; omega) rfl]
  by_cases h2 : c.val = q
  · have e1 : KL2.rfun q N c = q + N := by unfold KL2.rfun; split_ifs; omega
    rw [insertSeq_lbl_ge s _ t ⟨q, by omega⟩ le_rfl (by simp [e1]),
      insertSeq_lbl_lt s _ t ⟨q, by omega⟩ (by simp) (by simp [h2])]
  by_cases h3 : c.val ≤ q + N
  · have e1 : KL2.rfun q N c = c.val - 1 := by unfold KL2.rfun; split_ifs <;> omega
    rw [insertSeq_lbl_win s _ t ⟨c.val - 1 - q, by omega⟩ (by simp [e1]; omega),
      insertSeq_lbl_win s _ t ⟨c.val - 1 - q, by omega⟩ (by simp; omega)]
  · have e1 : KL2.rfun q N c = c.val := by unfold KL2.rfun; split_ifs <;> omega
    rw [insertSeq_lbl_ge s _ t ⟨c.val - N, by omega⟩ (by simp; omega) (by simp [e1]; omega),
      insertSeq_lbl_ge s _ t ⟨c.val - N, by omega⟩ (by simp; omega) (by simp; omega)]

/-! ### Diagrams at the maximum, in a window -/

section Window

omit [DecidableEq I] in
theorem add_lt_M {n : ℕ} (hn : n ≤ m) (b : Fin N) : n + b.val < M := by
  have := card_plus' (I := I) (ℓ := ℓ) (ν := ν) (ν₀ := ν₀); omega

variable (Q Λ Λc)

local notation "ι" => insertMap (j := j) (hj := hj) (ν₀ := ν₀) Q Λ Λc

local notation "E" s:max n:max hn:max =>
  KLRAlgebra.eSum (stendhalQ Q (plusLabels Λ Λc j hj))
    (insertSet (j := j) (hj := hj) (ν₀ := ν₀) s n hn)

theorem insertMap_one (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) :
    ι s n hn 1 = E s n hn := by
  rw [insertMap, map_one, Corner.val_one]

theorem insertMap_add (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) (x y : Rc) :
    ι s n hn (x + y) = ι s n hn x + ι s n hn y := by
  rw [insertMap, map_add, Corner.val_add]; rfl

theorem insertMap_algebraMap (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) (c : k) :
    ι s n hn (algebraMap k Rc c) = c • E s n hn := by
  rw [insertMap, AlgHom.commutes, Corner.val_algebraMap, Algebra.smul_def]

theorem insertMap_x (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) (b : Fin N) :
    ι s n hn (KLRAlgebra.x b) =
      KLRAlgebra.x ⟨n + b.val, add_lt_M hn b⟩ * E s n hn := by
  show (((insertEmb s n hn).hom (stendhalQ Q (plusLabels Λ Λc j hj)))
    (KLRAlgebra.relabelHom (cupRelabel (j := j) (hj := hj) (ν₀ := ν₀) k Q Λ Λc)
      (KLRAlgebra.x b))).val = _
  rw [KLRAlgebra.relabelHom_x, KLRAlgebra.BlockEmb.hom_x, val_polCorner, pol_X]
  rfl

/-- The idempotent of the window sum, loading by loading. -/
theorem eSum_insertSet (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) :
    E s n hn = ∑ w : Seq (stendhalWeight 2 ν₀),
      KLRAlgebra.e (insertSeq s n hn (Seq.map (cupColour j hj) w)) := by
  rw [KLRAlgebra.eSum, insertSet, Finset.sum_image fun a _ b _ h => insertSeq_injective s hn h]
  exact (Fintype.sum_equiv (Seq.mapEquiv (cupColour_injective j hj) _) _ _ fun _ => rfl).symm

theorem e_insertSeq_mul_eSum (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m)
    (t : Seq ((stendhalWeight 2 ν₀).map (cupColour j hj))) :
    (KLRAlgebra.e (insertSeq s n hn t) * E s n hn : Rp) = KLRAlgebra.e (insertSeq s n hn t) := by
  rw [KLRAlgebra.e_mul_eSum,
    ite_eq_left (show _ ∈ insertSet s n hn from Finset.mem_image_of_mem _ (Finset.mem_univ t))]

theorem eSum_mul_e_insertSeq (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m)
    (t : Seq ((stendhalWeight 2 ν₀).map (cupColour j hj))) :
    (E s n hn * KLRAlgebra.e (insertSeq s n hn t) : Rp) = KLRAlgebra.e (insertSeq s n hn t) := by
  rw [KLRAlgebra.eSum_mul_e,
    ite_eq_left (show _ ∈ insertSet s n hn from Finset.mem_image_of_mem _ (Finset.mem_univ t))]

variable {Q Λ Λc}

theorem underRight_mul_e_insertSeq (s : Seq (stendhalWeight ℓ ν))
    (t : Seq ((stendhalWeight 2 ν₀).map (cupColour j hj))) {q : ℕ} (hq : q + 1 ≤ m) :
    (underRight N q * KLRAlgebra.e (insertSeq s q (by omega) t) : Rp) =
      KLRAlgebra.e (insertSeq s (q + 1) hq t) * underRight N q := by
  rw [underRight, KLRAlgebra.ψw_mul_e, range'_smul_insertSeq]

variable (Q Λ Λc) in
theorem underRight_mul_eSum (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) :
    (underRight N q * E s q (by omega) : Rp) = E s (q + 1) hq * underRight N q := by
  rw [eSum_insertSet, eSum_insertSet, Finset.mul_sum, Finset.sum_mul]
  exact Finset.sum_congr rfl fun w _ => underRight_mul_e_insertSeq s _ hq

end Window

/-! ### Diagrams in which a strand leaves the maximum -/

section Exit

variable (Q Λ Λc)

local notation "ι" => insertMap (j := j) (hj := hj) (ν₀ := ν₀) Q Λ Λc

variable (ν₀) in
/-- The two-sided ideal of `R((μ, μ*))` generated by the idempotents of the loadings that are not
of the form `μ ⋯ μ*`. It acts by zero on every module supported on the loadings `μ ⋯ μ*`. -/
def capNull : TwoSidedIdeal Rc :=
  TwoSidedIdeal.span {y | ∃ w, ¬ IsCapGood ν₀ w ∧ y = KLRAlgebra.e w}

variable (j hj) in
/-- The diagrams `ι_{s,n}(z) r` with `z` in `capNull`: a strand at the maximum leaves the window
at its top. -/
def exitSpan (s : Seq (stendhalWeight ℓ ν)) (n : ℕ) (hn : n ≤ m) : Submodule k Rp :=
  Submodule.span k {y | ∃ z ∈ capNull (k := k) Q Λc ν₀, ∃ r : Rp, y = ι s n hn z * r}

variable {Q Λ Λc}

theorem e_mem_capNull {w : Seq (stendhalWeight 2 ν₀)} (hw : ¬ IsCapGood ν₀ w) :
    (KLRAlgebra.e w : Rc) ∈ capNull (k := k) Q Λc ν₀ :=
  TwoSidedIdeal.subset_span ⟨w, hw, rfl⟩

theorem mem_exitSpan (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) {z : Rc}
    (hz : z ∈ capNull (k := k) Q Λc ν₀) (r : Rp) : ι s n hn z * r ∈ exitSpan Q Λ Λc j hj s n hn :=
  Submodule.subset_span ⟨z, hz, r, rfl⟩

theorem exitSpan_mul_right (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) {y : Rp}
    (hy : y ∈ exitSpan Q Λ Λc j hj s n hn) (r : Rp) : y * r ∈ exitSpan Q Λ Λc j hj s n hn := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨z, hz, r', rfl⟩ := hy
    rw [mul_assoc]; exact mem_exitSpan s hn hz _
  | zero => rw [zero_mul]; exact zero_mem _
  | add y y' _ _ h h' => rw [add_mul]; exact add_mem h h'
  | smul c y _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c h

theorem insertMap_mul_mem_exitSpan (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) (x : Rc)
    {y : Rp} (hy : y ∈ exitSpan Q Λ Λc j hj s n hn) :
    ι s n hn x * y ∈ exitSpan Q Λ Λc j hj s n hn := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨z, hz, r', rfl⟩ := hy
    rw [← mul_assoc, ← insertMap_mul]
    exact mem_exitSpan s hn (TwoSidedIdeal.mul_mem_left _ x z hz) _
  | zero => rw [mul_zero]; exact zero_mem _
  | add y y' _ _ h h' => rw [mul_add]; exact add_mem h h'
  | smul c y _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ c h

variable (Q Λ Λc j hj) in
/-- **Sliding through a passage**: `ι_{s,q+1}(x) · underRight N q ≡ underRight N q · ι_{s,q}(x)`
modulo diagrams in which a strand leaves the window at the top. -/
def Slides (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) (x : Rc) : Prop :=
  ι s (q + 1) hq x * underRight N q - underRight N q * ι s q (by omega) x ∈
    exitSpan Q Λ Λc j hj s (q + 1) hq

theorem slides_add (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) {x y : Rc}
    (hx : Slides Q Λ Λc j hj s hq x) (hy : Slides Q Λ Λc j hj s hq y) :
    Slides Q Λ Λc j hj s hq (x + y) := by
  unfold Slides
  rw [insertMap_add, insertMap_add]
  convert add_mem hx hy using 1
  noncomm_ring

theorem slides_mul (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) {x y : Rc}
    (hx : Slides Q Λ Λc j hj s hq x) (hy : Slides Q Λ Λc j hj s hq y) :
    Slides Q Λ Λc j hj s hq (x * y) := by
  unfold Slides
  rw [insertMap_mul, insertMap_mul]
  convert add_mem (insertMap_mul_mem_exitSpan s hq x hy)
    (exitSpan_mul_right s hq hx (ι s q (by omega) y)) using 1
  noncomm_ring

theorem slides_algebraMap (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) (c : k) :
    Slides Q Λ Λc j hj s hq (algebraMap k Rc c) := by
  unfold Slides
  rw [insertMap_algebraMap, insertMap_algebraMap, smul_mul_assoc, mul_smul_comm,
    ← underRight_mul_eSum Q Λ Λc s hq, sub_self]
  exact zero_mem _

theorem slides_e (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m)
    (w : Seq (stendhalWeight 2 ν₀)) : Slides Q Λ Λc j hj s hq (KLRAlgebra.e w) := by
  unfold Slides
  rw [insertMap_e, insertMap_e, underRight_mul_e_insertSeq s _ hq, sub_self]
  exact zero_mem _

end Exit

/-! ### The dot generators -/

section Dots

local notation "ι" => insertMap (j := j) (hj := hj) (ν₀ := ν₀) Q Λ Λc

local notation "E" s:max n:max hn:max =>
  KLRAlgebra.eSum (stendhalQ Q (plusLabels Λ Λc j hj))
    (insertSet (j := j) (hj := hj) (ν₀ := ν₀) s n hn)

omit [DecidableEq I] in
theorem oldColour_ne_cupColour_inr (a : I ⊕ Fin ℓ) (r : Fin 2) :
    oldColour j hj a ≠ cupColour (I := I) j hj (.inr r) := by
  rcases a with i | r'
  · simp [oldColour, cupColour]
  · simp only [oldColour, cupColour, Sum.map_inr, ne_eq, Sum.inr.injEq]
    intro h
    exact Sum.inl_ne_inr ((insertPos ℓ 2 j hj).injective h)

omit [DecidableEq I] in
/-- The labels after the strand at `c` has moved to the end. -/
theorem lbl_exit (w : Seq (stendhalWeight 2 ν₀)) {c : ℕ} (hc : c < N) :
    ((wordProd N (List.range' c (N - 1 - c)))⁻¹ • w).lbl
      ⟨N - 1, Nat.sub_lt (Nat.lt_of_le_of_lt (Nat.zero_le c) hc) one_pos⟩ = w.lbl ⟨c, hc⟩ := by
  rw [← wordProd_reverse]
  exact KL2.lbl_range'_reverse_smul (by omega) w _ _
    (show c = KL2.lfun c (N - 1 - c) (N - 1) by unfold KL2.lfun; split_ifs <;> omega)

/-- A black strand at the maximum moved to the right end: the bottom loading is not of the form
`μ ⋯ μ*`. -/
theorem e_mul_exit_mem_capNull (w : Seq (stendhalWeight 2 ν₀)) {c : ℕ} (hc : c < N)
    (hb : (w.lbl ⟨c, hc⟩).isLeft) :
    (KLRAlgebra.e w * KLRAlgebra.ψw (List.range' c (N - 1 - c)) : Rc) ∈
      capNull (k := k) Q Λc ν₀ := by
  rw [KLRAlgebra.e_mul_ψw]
  refine TwoSidedIdeal.mul_mem_left _ _ _ (e_mem_capNull ?_)
  intro h
  have h2 : w.lbl ⟨c, hc⟩ = .inr 1 := (lbl_exit w hc).symm.trans h.2
  simp [h2] at hb

theorem e_insertSeq_mul_exit (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m)
    (w : Seq (stendhalWeight 2 ν₀)) (c : ℕ) :
    (KLRAlgebra.e (insertSeq s n hn (Seq.map (cupColour j hj) w)) *
        KLRAlgebra.ψw (List.range' (n + c) (N - 1 - c)) : Rp) =
      ι s n hn (KLRAlgebra.e w * KLRAlgebra.ψw (List.range' c (N - 1 - c))) := by
  rw [insertMap_mul, insertMap_e, insertMap_ψw s hn _ (fun p hp => by
      rw [List.mem_range'_1] at hp; omega),
    ← mul_assoc, e_insertSeq_mul_eSum, List.map_add_range']


theorem eSum_mul_insertMap (s : Seq (stendhalWeight ℓ ν)) {n : ℕ} (hn : n ≤ m) (x : Rc) :
    (E s n hn * ι s n hn x : Rp) = ι s n hn x := by
  rw [← insertMap_one Q Λ Λc s hn, ← insertMap_mul, one_mul]

/-- The errors of a passage are fixed by the top window idempotent. -/
theorem eSum_mul_slidesDiff (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) (x : Rc) :
    E s (q + 1) hq * (ι s (q + 1) hq x * underRight N q - underRight N q * ι s q (by omega) x) =
      ι s (q + 1) hq x * underRight N q - underRight N q * ι s q (by omega) x := by
  rw [mul_sub, ← mul_assoc, eSum_mul_insertMap, ← mul_assoc, ← underRight_mul_eSum Q Λ Λc s hq,
    mul_assoc, eSum_mul_insertMap]

/-- **The dot generators slide through a passage.** -/
theorem slides_x (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) (b : Fin N) :
    Slides Q Λ Λc j hj s hq (KLRAlgebra.x b) := by
  have hM := card_plus' (I := I) (ℓ := ℓ) (ν := ν) (ν₀ := ν₀)
  have hqN : q + N < M := by omega
  have hb := b.2
  unfold Slides
  rw [← eSum_mul_slidesDiff]
  have hD : (ι s (q + 1) hq (KLRAlgebra.x b) * underRight N q -
        underRight N q * ι s q (by omega) (KLRAlgebra.x b) : Rp) =
      -(KLRAlgebra.ψw (List.range' q b.val) * KLRAlgebra.eqIdem (q + b.val) (by omega) *
        KLRAlgebra.ψw (List.range' (q + 1 + b.val) (N - 1 - b.val)) * E s q (by omega)) := by
    rw [insertMap_x, insertMap_x, mul_assoc, ← underRight_mul_eSum Q Λ Λc s hq]
    simp only [← mul_assoc]
    rw [underRight, x_mul_underRight b.2 hqN]
    noncomm_ring
  rw [hD, mul_neg]
  refine neg_mem ?_
  rw [eSum_insertSet, Finset.sum_mul]
  refine Submodule.sum_mem _ fun w _ => ?_
  simp only [← mul_assoc]
  rw [KLRAlgebra.e_mul_ψw, mul_assoc (KLRAlgebra.ψw _) (KLRAlgebra.e _), e_mul_eqIdem]
  split_ifs with hcond
  · rw [← KLRAlgebra.e_mul_ψw, mul_assoc (KLRAlgebra.e _) (KLRAlgebra.ψw _),
      (KLRAlgebra.commute_ψw_ψw fun p hp p' hp' => by
        rw [List.mem_range'_1] at hp hp'; omega).eq, ← mul_assoc,
      e_insertSeq_mul_exit s hq w b.val, mul_assoc]
    refine mem_exitSpan s hq (e_mul_exit_mem_capNull w b.2 ?_) _
    rw [← wordProd_reverse] at hcond
    have e1 := KL2.lbl_range'_reverse_smul (q := q) (l := b.val) (by omega)
      (insertSeq s (q + 1) hq (Seq.map (cupColour j hj) w)) ⟨q + b.val, by omega⟩ ⟨q, by omega⟩
      (by unfold KL2.lfun; dsimp only; split_ifs <;> omega)
    have e2 := KL2.lbl_range'_reverse_smul (q := q) (l := b.val) (by omega)
      (insertSeq s (q + 1) hq (Seq.map (cupColour j hj) w)) ⟨q + b.val + 1, by omega⟩
      ⟨q + b.val + 1, by omega⟩ (by unfold KL2.lfun; dsimp only; split_ifs <;> omega)
    have h3 := e1.symm.trans (hcond.trans e2)
    rw [insertSeq_lbl_lt s hq _ ⟨q, by omega⟩ (Nat.lt_succ_self q) rfl,
      insertSeq_lbl_win s hq _ ⟨b.val, by rw [Multiset.card_map]; exact b.2⟩
        (by dsimp only; omega), Seq.map_lbl] at h3
    rcases hw : w.lbl ⟨b.val, b.2⟩ with i | r
    · rfl
    · exact absurd (hw ▸ h3) (oldColour_ne_cupColour_inr _ _)
  · rw [mul_zero, zero_mul, zero_mul]
    exact zero_mem _

/-! ### The crossing generators -/

local notation "Aψ" q:max r:max => (KLRAlgebra.ψw (List.range' q r) : Rp)

local notation "Xψ" q:max r:max =>
  (KLRAlgebra.ψw (List.range' (q + 1 + (r + 1)) (N - 1 - (r + 1))) : Rp)

local notation "Bw" s:max q:max hq:max w:max =>
  KLRAlgebra.e (insertSeq s q (Nat.le_of_succ_le hq) (Seq.map (cupColour j hj) w))

/-- The braid defect with no dots: the window strand that leaves the passage at the bottom right
is black, so the diagram lies in `exitSpan`. -/
theorem crossBase_mem (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) {r : ℕ}
    (hr : r + 1 < N) (w : Seq (stendhalWeight 2 ν₀)) :
    E s (q + 1) hq * (Aψ q r * (Xψ q r * Bw s q hq w)) ∈ exitSpan Q Λ Λc j hj s (q + 1) hq := by
  have hM := card_plus' (I := I) (ℓ := ℓ) (ν := ν) (ν₀ := ν₀)
  have hAX : Commute (Aψ q r) (Xψ q r) :=
    KLRAlgebra.commute_ψw_ψw fun p hp p' hp' => by
      rw [List.mem_range'_1] at hp hp'; omega
  rw [eSum_insertSet, Finset.sum_mul]
  refine Submodule.sum_mem _ fun w' _ => ?_
  by_cases hb : (w'.lbl ⟨r + 1, hr⟩).isLeft
  · rw [← mul_assoc (KLRAlgebra.ψw _), hAX.eq, mul_assoc, ← mul_assoc (KLRAlgebra.e _),
      e_insertSeq_mul_exit s hq w' (r + 1)]
    exact mem_exitSpan s hq (e_mul_exit_mem_capNull w' hr hb) _
  · rw [← mul_assoc (KLRAlgebra.ψw _), ← KLRAlgebra.ψw_append, ← mul_assoc, KLRAlgebra.e_mul_ψw,
      mul_assoc, KLRAlgebra.e_mul_e]
    split_ifs with heq
    swap
    · rw [mul_zero]; exact zero_mem _
    exfalso
    have h1 := congrArg (fun t : Seq (stendhalWeight (ℓ + 2) (ν + ν₀)) =>
      t.lbl ⟨q + 1 + (r + 1), by omega⟩) (inv_smul_eq_iff.mp heq)
    rw [insertSeq_lbl_win s hq _ ⟨r + 1, by rw [Multiset.card_map]; exact hr⟩ rfl, Seq.map_lbl,
      wordProd_append, mul_smul,
      KL2.lbl_range'_smul (by omega) _ _ ⟨q + 1 + (r + 1), by omega⟩
        (by unfold KL2.rfun; dsimp only; split_ifs <;> omega),
      KL2.lbl_range'_smul (by omega) _ _ ⟨q + N, by omega⟩
        (by unfold KL2.rfun; dsimp only; split_ifs <;> omega),
      insertSeq_lbl_ge s _ _ ⟨q, by omega⟩ le_rfl rfl] at h1
    rcases hw : w'.lbl ⟨r + 1, hr⟩ with i | r'
    · simp [hw] at hb
    · exact oldColour_ne_cupColour_inr _ _ (hw ▸ h1).symm

theorem crossStepRight (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) {r : ℕ}
    (w : Seq (stendhalWeight 2 ν₀)) (g : Rp) (b : Fin M)
    (hb : ∀ p ∈ List.range' (q + 1 + (r + 1)) (N - 1 - (r + 1)), (b : ℕ) ≠ p ∧ (b : ℕ) ≠ p + 1)
    (hg : E s (q + 1) hq * (Aψ q r * (g * (Xψ q r * Bw s q hq w))) ∈
      exitSpan Q Λ Λc j hj s (q + 1) hq) :
    E s (q + 1) hq * (Aψ q r * (g * KLRAlgebra.x b * (Xψ q r * Bw s q hq w))) ∈
      exitSpan Q Λ Λc j hj s (q + 1) hq := by
  have : (KLRAlgebra.x b * (Xψ q r * Bw s q hq w) : Rp) =
      Xψ q r * Bw s q hq w * KLRAlgebra.x b := by
    rw [← mul_assoc, (KLRAlgebra.commute_x_ψw hb).eq, mul_assoc, KLRAlgebra.x_mul_e, mul_assoc]
  rw [mul_assoc g, this]
  convert exitSpan_mul_right s hq hg (KLRAlgebra.x b) using 1
  simp only [mul_assoc]

theorem crossStepLeft (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) {r : ℕ}
    (hr : r + 1 < N) (w : Seq (stendhalWeight 2 ν₀)) (f : MvPolynomial (Fin M) k)
    (hg : E s (q + 1) hq * (Aψ q r * (KLRAlgebra.pol f * (Xψ q r * Bw s q hq w))) ∈
      exitSpan Q Λ Λc j hj s (q + 1) hq) :
    E s (q + 1) hq * (Aψ q r * (KLRAlgebra.pol f * KLRAlgebra.x ⟨q + 1 + (r + 1),
        add_lt_M hq ⟨r + 1, hr⟩⟩ * (Xψ q r * Bw s q hq w))) ∈
      exitSpan Q Λ Λc j hj s (q + 1) hq := by
  have hc : Commute (KLRAlgebra.pol f : Rp) (KLRAlgebra.x ⟨q + 1 + (r + 1),
      add_lt_M hq ⟨r + 1, hr⟩⟩) := by
    rw [← KLRAlgebra.pol_X, Commute, SemiconjBy, ← map_mul, ← map_mul, mul_comm]
  have hA : Commute (KLRAlgebra.x ⟨q + 1 + (r + 1), add_lt_M (ν₀ := ν₀) hq ⟨r + 1, hr⟩⟩ : Rp)
      (Aψ q r) :=
    KLRAlgebra.commute_x_ψw fun p hp => by rw [List.mem_range'_1] at hp; dsimp only; omega
  rw [hc.eq, mul_assoc, ← mul_assoc (Aψ q r), ← hA.eq, mul_assoc, ← mul_assoc (E s (q + 1) hq),
    ← KLRAlgebra.pol_X, ← KLRAlgebra.pol_mul_eSum, KLRAlgebra.pol_X,
    show (KLRAlgebra.x ⟨q + 1 + (r + 1), add_lt_M (ν₀ := ν₀) hq ⟨r + 1, hr⟩⟩ *
        E s (q + 1) hq : Rp) =
      ι s (q + 1) hq (KLRAlgebra.x ⟨r + 1, hr⟩) from (insertMap_x Q Λ Λc s hq ⟨r + 1, hr⟩).symm,
    ← mul_one (KLRAlgebra.x ⟨r + 1, hr⟩ : Rc), insertMap_mul, insertMap_one, mul_assoc]
  exact insertMap_mul_mem_exitSpan s hq _ hg

/-- The braid defect with dots on the three strands at the crossing lies in `exitSpan`: dots on the
two left strands slide down past the exit, a dot on the right strand slides up to the top of the
window. -/
theorem crossTerm_mem (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) {r : ℕ}
    (hr : r + 1 < N) (w : Seq (stendhalWeight 2 ν₀)) (p : MvPolynomial (Fin 3) k) :
    E s (q + 1) hq * (Aψ q r * (KLRAlgebra.pol (MvPolynomial.rename
        ![⟨q + r, add_lt_M (ν₀ := ν₀) (Nat.le_of_succ_le hq) ⟨r, by omega⟩⟩,
          ⟨q + 1 + r, add_lt_M (ν₀ := ν₀) hq ⟨r, by omega⟩⟩,
          ⟨q + 1 + (r + 1), add_lt_M (ν₀ := ν₀) hq ⟨r + 1, hr⟩⟩] p) * (Xψ q r * Bw s q hq w))) ∈
      exitSpan Q Λ Λc j hj s (q + 1) hq := by
  induction p using MvPolynomial.induction_on with
  | C c =>
    rw [MvPolynomial.rename_C, MvPolynomial.algHom_C, ← Algebra.smul_def, mul_smul_comm,
      mul_smul_comm]
    exact Submodule.smul_mem _ c (crossBase_mem s hq hr w)
  | add p p' hp hp' =>
    rw [map_add, map_add, add_mul, mul_add, mul_add]
    exact add_mem hp hp'
  | mul_X p n hp =>
    rw [map_mul, MvPolynomial.rename_X, map_mul, KLRAlgebra.pol_X]
    fin_cases n
    · exact crossStepRight
        (b := ⟨q + r, add_lt_M (ν₀ := ν₀) (Nat.le_of_succ_le hq) ⟨r, by omega⟩⟩) s hq w _
        (fun p' hp' => by rw [List.mem_range'_1] at hp'; dsimp only; omega) hp
    · exact crossStepRight (b := ⟨q + 1 + r, add_lt_M (ν₀ := ν₀) hq ⟨r, by omega⟩⟩) s hq w _
        (fun p' hp' => by rw [List.mem_range'_1] at hp'; dsimp only; omega) hp
    · exact crossStepLeft s hq hr w _ hp

/-- **The crossing generators slide through a passage.** -/
theorem slides_ψ (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) {r : ℕ}
    (hr : r + 1 < N) : Slides Q Λ Λc j hj s hq (KLRAlgebra.ψ r : Rc) := by
  have hM := card_plus' (I := I) (ℓ := ℓ) (ν := ν) (ν₀ := ν₀)
  unfold Slides
  rw [← eSum_mul_slidesDiff]
  have hD : (ι s (q + 1) hq (KLRAlgebra.ψ r) * underRight N q -
        underRight N q * ι s q (by omega) (KLRAlgebra.ψ r) : Rp) =
      -(Aψ q r * ((KLRAlgebra.ψ (q + r) * KLRAlgebra.ψ (q + r + 1) * KLRAlgebra.ψ (q + r) -
            KLRAlgebra.ψ (q + r + 1) * KLRAlgebra.ψ (q + r) * KLRAlgebra.ψ (q + r + 1)) *
          (Xψ q r * E s q (by omega)))) := by
    rw [insertMap_ψ s hq hr, insertMap_ψ s _ hr, mul_assoc, ← underRight_mul_eSum Q Λ Λc s hq]
    simp only [← mul_assoc]
    rw [underRight, show q + 1 + r = q + r + 1 by omega, ψ_mul_underRight hr]
    noncomm_ring
  rw [hD, mul_neg]
  refine neg_mem ?_
  rw [eSum_insertSet Q Λ Λc s (n := q), Finset.mul_sum, Finset.mul_sum, Finset.mul_sum,
    Finset.mul_sum]
  refine Submodule.sum_mem _ fun w _ => ?_
  rw [KLRAlgebra.ψw_mul_e, ← mul_assoc (_ - _), KLRAlgebra.braid (q + r) (by omega)]
  split_ifs
  · rw [mul_assoc (ncEval _ _), ← KLRAlgebra.ψw_mul_e, ncEval_x_three,
      show (⟨q + r + 2, by omega⟩ : Fin M) =
          ⟨q + 1 + (r + 1), add_lt_M (ν₀ := ν₀) hq ⟨r + 1, hr⟩⟩ from
        Fin.ext (by dsimp only; omega),
      show (⟨q + r + 1, by omega⟩ : Fin M) = ⟨q + 1 + r, add_lt_M (ν₀ := ν₀) hq ⟨r, by omega⟩⟩ from
        Fin.ext (by dsimp only; omega)]
    exact crossTerm_mem s hq hr w _
  · rw [zero_mul, mul_zero, mul_zero]
    exact zero_mem _

/-- **Every diagram at the maximum slides through a passage**, modulo diagrams in which a strand
leaves the window at the top. -/
theorem slides (s : Seq (stendhalWeight ℓ ν)) {q : ℕ} (hq : q + 1 ≤ m) (z : Rc) :
    Slides Q Λ Λc j hj s hq z := by
  induction z using KLRAlgebra.klr_induction with
  | hadd u v hu hv => exact slides_add s hq hu hv
  | hmul u v hu hv => exact slides_mul s hq hu hv
  | hr c => exact slides_algebraMap s hq c
  | he w => exact slides_e s hq w
  | hx b => exact slides_x s hq b
  | hψ r =>
    by_cases hr : r + 1 < N
    · exact slides_ψ s hq hr
    · rw [KLRAlgebra.ψ_eq_zero r (by omega), ← map_zero (algebraMap k Rc)]
      exact slides_algebraMap s hq 0

end Dots

end Sliding

end Categorification.Stendhal.CupCap
