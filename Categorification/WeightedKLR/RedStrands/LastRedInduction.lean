import Categorification.WeightedKLR.RedStrands.AddRedInjective
import Categorification.WeightedKLR.RedStrands.Projectives
import Categorification.WeightedKLR.GradedK0.ResIndTwist
import Categorification.Algebra.InductionAlong

/-!
# Last-red induction on graded projectives

Webster, arXiv:1309.3796v2, §4.7, Lemma 4.37, case `q(P) = 0`.
For left modules the induction bimodule is the left ideal generated by the
terminal-red idempotent, with right action from Proposition 4.18.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR Categorification.Graded DirectSum MulOpposite
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I k : Type*} [DecidableEq I] [Field k] {ℓ : ℕ}
    {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin (ℓ + 1) → I →₀ ℕ}
    (G : GradingDatum (stendhalQ Q Λ)) (ν : Multiset I)
local notation "src" => tensorProductGrade (restrictRedGrading Q Λ G) ν
local notation "dst" => tensorProductGrade G ν
local notation "T" => TensorProductAlgebra k Q (Λ ∘ Fin.castSucc) ν
local notation "T'" => TensorProductAlgebra k Q Λ ν

private def appendRedValueHom : T →ₙ+* T' :=
  (KLR.cornerVal (TensorProductAlgebra.isIdempotentElem_lastRedIdem Q Λ ν)).comp
    (appendRed Q Λ ν).toRingHom.toNonUnitalRingHom

local notation "φ" => appendRedValueHom (Q := Q) (Λ := Λ) ν
local notation "Mc" => InductionAlong.Corner (φ : T →ₙ+* T')
local notation "cornerGr" => Graded.submodule dst (lIdeal (φ 1))

private def redProjective : GProj dst :=
  GProj.ofIdempotent (φ 1) (InductionAlong.unit_mul_unit (φ : T →ₙ+* T'))
    (appendRed_mem_grade Q Λ ν G SetLike.GradedOne.one_mem)

private local instance : Module.Finite T' Mc :=
  Module.Finite.of_surjective (leftIdealProj (InductionAlong.unit_mul_unit (φ : T →ₙ+* T')))
    fun z => ⟨z, Subtype.ext z.property⟩

private local instance : Module.Projective T' Mc :=
  Module.Projective.of_split (leftIdeal (φ 1)).subtype
    (leftIdealProj (InductionAlong.unit_mul_unit (φ : T →ₙ+* T'))) (leftIdealProj_comp_subtype _)

private theorem redScalarTower : IsScalarTower k T' Mc where
  smul_assoc c a z := Subtype.ext (smul_mul_assoc c a z.val)
private local instance : DirectSum.Decomposition cornerGr := (redProjective G ν).decomposition
private local instance : IsScalarTower k Tᵐᵒᵖ Mc where
  smul_assoc c r z := Subtype.ext (by
    change z.val * (appendRed Q Λ ν (c • r.unop)).val =
      c • (z.val * (appendRed Q Λ ν r.unop).val)
    rw [map_smul, KLR.Corner.val_smul, mul_smul_comm])

private theorem redRightAction_mem {d n : ℤ} {m : Mc} {a : T}
    (hm : m ∈ cornerGr d) (ha : a ∈ src n) : op a • m ∈ cornerGr (d + n) :=
  SetLike.GradedMul.mul_mem (A := dst) hm (appendRed_mem_grade Q Λ ν G ha)

/-- The functor of last-red induction on left projectives in the proof of
Webster, arXiv:1309.3796v2, Lemma 4.37. -/
def lastRedIndProj (P : GProj src) : GProj dst :=
  @balancedIndGProj k _ T' _ _ dst T _ _ src _ Mc _ _ _ (redScalarTower (Q := Q) (Λ := Λ) ν) _ _ _ _ _ cornerGr
    (redProjective G ν).decomposition (redProjective G ν).gradedSMul
    (fun _ _ _ _ => redRightAction_mem G ν) P

/-- Last-red induction on graded projective Grothendieck groups
(Webster, arXiv:1309.3796v2, Lemma 4.37). -/
def lastRedIndK0 : K0 src →ₗ[LaurentPolynomial ℤ] K0 dst :=
  @balancedIndK0 k _ T' _ _ dst T _ _ src _ Mc _ _ _ (redScalarTower (Q := Q) (Λ := Λ) ν) _ _ _ _ _ cornerGr
    (redProjective G ν).decomposition (redProjective G ν).gradedSMul
    (fun _ _ _ _ => redRightAction_mem G ν)

@[simp] theorem lastRedIndK0_of (P : GProj src) :
    lastRedIndK0 G ν (K0.of P) = K0.of (lastRedIndProj G ν P) :=
  @balancedIndK0_of k _ T' _ _ dst T _ _ src _ Mc _ _ _ (redScalarTower (Q := Q) (Λ := Λ) ν) _ _ _ _ _ cornerGr
    (redProjective G ν).decomposition (redProjective G ν).gradedSMul
    (fun _ _ _ _ => redRightAction_mem G ν) P

private local instance : IsScalarTower k T' Mc := redScalarTower (Q := Q) (Λ := Λ) ν

private def indMul (e : T) : BalancedTensor k T' T Mc (leftIdeal e) →ₗ[T'] T' :=
  (lIdeal (φ 1)).subtype.comp <|
    (BalancedTensor.rid k T' T Mc).toLinearMap.comp (BalancedTensor.mapRight (leftIdeal e).subtype)

private theorem indMul_tmul (e : T) (b : Mc) (x : leftIdeal e) :
    indMul (Q := Q) (Λ := Λ) ν e (BalancedTensor.tmul b x) = b.val * φ x.val := rfl

private def indPrincipalEquiv {e : T} (he : IsIdempotentElem e) :
    BalancedTensor k T' T Mc (leftIdeal e) ≃ₗ[T'] leftIdeal (φ e) := by
  let p : leftIdeal e := ⟨e, he.eq⟩
  let f := (indMul (Q := Q) (Λ := Λ) ν e).codRestrict (leftIdeal (φ e)) fun t => by
    induction t using BalancedTensor.induction_on with
    | zero => rw [map_zero]; exact zero_mem _
    | tmul b x =>
      change (b.val * φ x.val) * φ e = b.val * φ x.val
      rw [mul_assoc, ← map_mul, mem_leftIdeal.mp x.2]
    | add x y hx hy => rw [map_add]; exact add_mem hx hy
  have inc (z : leftIdeal (φ e)) : z.val ∈ lIdeal (φ 1) := by
    change z.val * φ 1 = z.val
    conv_lhs => rw [← mem_leftIdeal.mp z.property, mul_assoc, ← map_mul, mul_one]
    exact z.property
  let g : leftIdeal (φ e) →ₗ[T'] BalancedTensor k T' T Mc (leftIdeal e) :=
    { toFun := fun b => BalancedTensor.tmul (⟨b.val, inc b⟩ : Mc) p
      map_add' := fun x y => BalancedTensor.add_tmul (⟨x.val, inc x⟩ : Mc) (⟨y.val, inc y⟩ : Mc) p
      map_smul' := fun c x => BalancedTensor.smul_tmul' c (⟨x.val, inc x⟩ : Mc) p }
  apply LinearEquiv.ofLinearMap f g
  · ext x
    exact x.property
  · apply BalancedTensor.extB
    intro b x
    change BalancedTensor.tmul (op x.val • b) p = BalancedTensor.tmul b x
    rw [BalancedTensor.op_smul_tmul]
    exact congrArg (BalancedTensor.tmul b) (Subtype.ext (mem_leftIdeal.mp x.property))

/-- Last-red induction sends a degree-zero principal projective to the one at the
appended idempotent (Webster, arXiv:1309.3796v2, Lemma 4.37). -/
theorem lastRedIndK0_ofIdempotent {e : T} (he : IsIdempotentElem e) (he0 : e ∈ src 0) :
    lastRedIndK0 G ν (K0.of (GProj.ofIdempotent e he he0)) =
      K0.of (GProj.ofIdempotent (𝒜 := dst) (appendRed Q Λ ν e).val (he.map (φ)) (appendRed_mem_grade Q Λ ν G he0)) := by
  rw [lastRedIndK0_of]
  apply K0.of_eq_of_iso
  refine GradedEquiv.ofPreserves (indPrincipalEquiv (Q := Q) (Λ := Λ) ν he) ?_
  intro d y hy
  change indMul (Q := Q) (Λ := Λ) ν e y ∈ dst d
  apply balancedGrading_map_mem dst ((indMul (Q := Q) (Λ := Λ) ν e).restrictScalars k) _ hy
  intro a b z x hz hx
  rw [LinearMap.restrictScalars_apply, indMul_tmul]
  exact SetLike.GradedMul.mul_mem (A := dst) hz (appendRed_mem_grade Q Λ ν G hx)


section

variable {I : Type} [DecidableEq I] {Q : I → I → MvPolynomial (Fin 2) k}
    {Λ : Fin (ℓ + 1) → I →₀ ℕ} (G : GradingDatum (stendhalQ Q Λ)) (ν : Multiset I)
local notation "srcG" => tensorProductGrade (restrictRedGrading Q Λ G) ν
local notation "dstG" => tensorProductGrade G ν
local notation "E" => TensorProductAlgebra.isIdempotentElem_lastRedIdem Q Λ ν

/-- Inducing the projective of an ordered loading appends the terminal red
strand to that loading (Webster, arXiv:1309.3796v2, §4.7, Lemma 4.37). -/
theorem lastRedIndK0_sequenceProj (s : Seq (stendhalWeight ℓ ν)) (hs : IsRedOrdered s) :
    lastRedIndK0 G ν (K0.of (sequenceProj (restrictRedGrading Q Λ G) s hs)) =
      K0.of (sequenceProj G (appendRedLoading s) ((appendRedLoading_ordered_iff s).2 hs)) := by
  unfold sequenceProj
  rw [lastRedIndK0_ofIdempotent]
  exact K0.of_ofIdempotent_congr (appendRed_mk_e Q Λ ν s hs) _ _ _ _

/-- A degree-zero idempotent in the terminal-red corner gives a principal
projective induced from the shorter red family (Webster, arXiv:1309.3796v2,
§4.7, proof of Lemma 4.37, case `q(P) = 0`). -/
theorem exists_lastRedIndK0_of_corner {C : QuantumGroup.CartanDatum I} (hQ : IsRouquierQ C Q)
    (p : TensorProductAlgebra.lastRedCorner Q Λ ν) (hp : IsIdempotentElem p) (hp0 : p.val ∈ dstG 0) :
    ∃ P : GProj srcG, lastRedIndK0 G ν (K0.of P) =
      K0.of (GProj.ofIdempotent p.val (hp.map (KLR.cornerVal E)) hp0) := by
  let σ := appendRedEquiv Q Λ ν hQ
  let f : TensorProductAlgebra k Q (Λ ∘ Fin.castSucc) ν →ₗ[k] TensorProductAlgebra k Q Λ ν :=
    { toFun := fun x => (σ x).val
      map_add' x y := congrArg Subtype.val (map_add σ x y)
      map_smul' c x := (congrArg Subtype.val (map_smul σ c x)).trans (KLR.Corner.val_smul _ _) }
  have hf : PreservesGrading srcG dstG f := fun _ _ hx => appendRed_mem_grade Q Λ ν G hx
  have h₀ : σ.symm p ∈ srcG 0 := by
    apply mem_of_injective_of_mem hf (Subtype.val_injective.comp σ.injective)
    change (σ (σ.symm p)).val ∈ dstG 0
    rwa [σ.apply_symm_apply]
  refine ⟨GProj.ofIdempotent (σ.symm p) (hp.map σ.symm) h₀, ?_⟩
  rw [lastRedIndK0_ofIdempotent]
  exact K0.of_ofIdempotent_congr (congrArg Subtype.val (σ.apply_symm_apply p)) _ _ _ _

local notation "B" => TensorProductAlgebra k Q Λ ν
local notation "eℓ" => TensorProductAlgebra.lastRedIdem Q Λ ν
local notation "L" => leftIdeal eℓ
local notation "Lgr" => Graded.submodule dstG L

/-- Every graded direct summand of the terminal-red left ideal has class
induced from the shorter family. This is the last-red step in Webster,
arXiv:1309.3796v2, §4.7, proof of Lemma 4.37. -/
theorem exists_lastRedIndK0_of_retract {C : QuantumGroup.CartanDatum I} (hQ : IsRouquierQ C Q)
    (P : GProj dstG) (i : P.carrier →ₗ[B] L) (r : L →ₗ[B] P.carrier)
    (hr : r.comp i = LinearMap.id)
    (hi₀ : PreservesGrading P.grading Lgr i) (hr₀ : PreservesGrading Lgr P.grading r) :
    ∃ P₀ : GProj srcG, lastRedIndK0 G ν (K0.of P₀) = K0.of P := by
  let u : L := ⟨eℓ, (E).eq⟩
  let v := r u
  let p := (i v).val
  have hri (x : P.carrier) : r (i x) = x := LinearMap.congr_fun hr x
  have hu (z : L) : z.val • u = z := Subtype.ext z.property
  have hv (z : L) : z.val • v = r z := by
    change z.val • r u = _
    rw [← map_smul, hu]
  have hit (x : P.carrier) : (i x).val * p = (i x).val := by
    change (i x).val * (i v).val = _
    exact congrArg Subtype.val ((i.map_smul (i x).val v).symm.trans (congrArg i ((hv (i x)).trans (hri x))))
  have hep : eℓ * p = p := congrArg Subtype.val ((i.map_smul u.val v).symm.trans (congrArg i (hv u)))
  let pc : TensorProductAlgebra.lastRedCorner Q Λ ν :=
    ⟨p, (Subsemigroup.mem_corner_iff E).2 ⟨hep, (i v).property⟩⟩
  have hpc : IsIdempotentElem pc := Subtype.ext (hit v)
  have hu₀ : u ∈ Lgr 0 := TensorProductAlgebra.lastRedIdem_mem_grade Q Λ ν G
  have hp₀ : p ∈ dstG 0 := hi₀ (hr₀ hu₀)
  obtain ⟨P₀, hP₀⟩ := exists_lastRedIndK0_of_corner G ν hQ pc hpc hp₀
  refine ⟨P₀, hP₀.trans (K0.of_eq_of_iso ?_)⟩
  let j : P.carrier →ₗ[B] leftIdeal p := ((L).subtype.comp i).codRestrict _ hit
  have ej : Function.Bijective j := by
    constructor
    · intro a b h
      have hab : i a = i b := Subtype.ext (congrArg (fun t : leftIdeal p => t.val) h)
      exact (hri a).symm.trans ((congrArg r hab).trans (hri b))
    · intro z
      refine ⟨z.val • v, Subtype.ext ?_⟩
      change (i (z.val • v)).val = z.val
      rw [map_smul]
      exact z.property
  let Y := GProj.ofIdempotent pc.val (hpc.map (KLR.cornerVal E)) hp₀
  let : Decomposition Y.grading := Y.decomposition
  exact (GradedEquiv.ofPreserves (ℳ := P.grading) (𝒩 := Y.grading) (LinearEquiv.ofBijective j ej)
    (fun _ _ hx => hi₀ hx)).symm

end

end Categorification.Stendhal
