import Categorification.WeightedKLR.RedStrands.BraidedViolatedPush
import Categorification.WeightedKLR.RedStrands.BraidedViolatedQuotient

set_option backward.isDefEq.respectTransparency false

/-!
# A red strand at the left edge followed by a black strand

Let `e(t')` be an idempotent whose leftmost strand is red, labelled `λ_r`, and whose second
strand is black, and let `e(s)` be an idempotent in which every black strand lies to the left of
the red strand `λ_r`. Then every element `e(s) w e(t')` of the braided Stendhal algebra lies in
the ideal generated by violated idempotents: in any diagram from `t'` to `s`, the black strand
at position `1` crosses the red strand `λ_r`, and the crossing can be performed first, producing
a violated idempotent at the bottom.

This is the well-definedness step of B. Webster, *Knot invariants and higher representation
theory*, arXiv:1309.3796v2, Proposition 6.9, for two red strands: multiplication by the braiding
diagram kills the generators of the submodule `U_t` that defines the standard module `S_t`.

## Main results

* `BraidedStendhalAlgebra.e_mul_mul_e_mem_violIdeal` : `e(s) w e(t')` lies in the violated
  ideal.
* `BraidedStendhalAlgebra.exists_e_mul_mul_redProj_sub_mem` : factoring `e(s) w e_κ` through a
  fixed diagram `ψ_{ρ(g)} e(t)` modulo violated idempotents.
* `BraidedStendhalAlgebra.exists_e_mul_mul_redProj_sub_mem_of_last` : the case where `g` carries
  the leftmost strand `λ_r` of `t` to the right edge of `s`, the surjectivity step of
  Proposition 6.9.
-/

namespace Categorification.Stendhal

open KLR TypeA Equiv MvPolynomial

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "R" => KLR.KLRAlgebra k (stendhalQ Q Λ) (stendhalWeight ℓ ν)

namespace BraidedStendhalAlgebra

open Classical in
/-- The frame performing the crossing of the strands at positions `0` and `1`, if `τ` inverts
them, and `1` otherwise. -/
noncomputable def edgeFrame (h1 : 1 < m) (τ : Perm (Fin m)) : Perm (Fin m) :=
  if ((⟨0, by omega⟩ : Fin m), (⟨1, h1⟩ : Fin m)) ∈ invSet m τ then sadj m 0 else 1

omit [DecidableEq I] in
theorem edgeFrame_le (h1 : 1 < m) (τ : Perm (Fin m)) :
    invSet m (edgeFrame h1 τ) ⊆ invSet m τ := by
  unfold edgeFrame
  split_ifs with h
  · have hs := invSet_sadj_mul_of_lt (k := 0) h1 (w := 1)
      (by simp [Fin.lt_def])
    rw [mul_one] at hs
    rw [hs]
    intro p hp
    rcases Finset.mem_insert.1 hp with rfl | hp
    · simpa using h
    · exact invSet_one_subset τ hp
  · exact invSet_one_subset τ

variable {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : IsReducedChoice ρ) (hQ : KLRSymm Q)

include hρ hQ in
/-- **A black strand crossing a red strand at the left edge.** If the leftmost strand of `t'` is
the red strand `λ_r`, its second strand is black, and every black strand of `s` lies left of
`λ_r`, then `e(s) w e(t')` lies in the ideal generated by violated idempotents. -/
theorem e_mul_mul_e_mem_violIdeal {s t' : Seq μ} {r : Fin ℓ} (h1 : 1 < m)
    (h0 : t'.lbl ⟨0, by omega⟩ = .inr r) (hb : (t'.lbl ⟨1, h1⟩).isLeft)
    (hs : ∀ a p, (s.lbl a).isLeft → s.lbl p = .inr r → a < p)
    (w : BraidedStendhalAlgebra k Q Λ ν) :
    ofKLR k Q Λ ν (KLRAlgebra.e s) * w * ofKLR k Q Λ ν (KLRAlgebra.e t') ∈
      violIdeal k Q Λ ν := by
  set ρ' := fun τ => ρ (τ * (edgeFrame h1 τ)⁻¹) ++ ρ (edgeFrame h1 τ)
  have hρ' : IsReducedChoice ρ' := isReducedChoice_frame hρ _ (edgeFrame_le h1)
  induction (basis hQ ρ' hρ').mem_span w using Submodule.span_induction with
  | zero => rw [mul_zero, zero_mul]; exact zero_mem _
  | add x y _ _ hx hy => rw [mul_add, add_mul]; exact add_mem hx hy
  | smul c x _ hx =>
    rw [mul_smul_comm, smul_mul_assoc, Algebra.smul_def]
    exact TwoSidedIdeal.mul_mem_left _ _ _ hx
  | mem x hx =>
    obtain ⟨⟨⟨j, τ, u⟩, hu⟩, rfl⟩ := hx
    rw [basis_apply, ← map_mul, ← map_mul]
    dsimp only
    rw [mul_assoc (KLRAlgebra.e s), mul_assoc (_ * _) (KLRAlgebra.e j), KLRAlgebra.e_mul_e]
    split_ifs with hj
    swap
    · rw [mul_zero, mul_zero, map_zero]; exact zero_mem _
    subst hj
    have hy := e_mul_std (Q := Q) (Λ := Λ) (ρ' τ) (monomial u 1) j
    rw [(hρ' τ).2] at hy
    rw [← hy, ← mul_assoc, KLRAlgebra.e_mul_e]
    split_ifs with hτ
    swap
    · rw [zero_mul, map_zero]; exact zero_mem _
    rw [map_mul]
    refine TwoSidedIdeal.mul_mem_left _ _ _ ?_
    have h0' : (⟨0, by omega⟩ : Fin m) < ⟨1, h1⟩ := by simp [Fin.lt_def]
    have hinv : ((⟨0, by omega⟩ : Fin m), (⟨1, h1⟩ : Fin m)) ∈ invSet m τ := by
      rw [mem_invSet_pair]
      refine ⟨h0', hs _ _ ?_ ?_⟩
      · rw [hτ, lbl_smul]; simpa using hb
      · rw [hτ, lbl_smul]; simpa using h0
    have hv : edgeFrame h1 τ = sadj m 0 := by simp [edgeFrame, hinv]
    have hviol : IsViolated (sadj m 0 • j) := by
      refine ⟨by omega, ?_⟩
      rw [lbl_smul, sadj_inv]
      convert hb using 3
      exact sadj_apply_left h1
    have hz := e_mul_std (Q := Q) (Λ := Λ) (ρ (sadj m 0)) (monomial u 1) j
    rw [(hρ (sadj m 0)).2] at hz
    have hρτ : ρ' τ = ρ (τ * (sadj m 0)⁻¹) ++ ρ (sadj m 0) := by simp only [ρ', hv]
    rw [hρτ, KLRAlgebra.ψw_append, mul_assoc (KLRAlgebra.ψw _), mul_assoc (KLRAlgebra.ψw _),
      ← hz, ← mul_assoc, map_mul, map_mul]
    exact TwoSidedIdeal.mul_mem_right _ _ _
      (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span ⟨_, hviol, rfl⟩))

omit [DecidableEq I] in
/-- If `e(j)` is not violated and its red strands read `r :: L`, its leftmost strand is `λ_r`. -/
theorem lbl_zero_of_not_isViolated {j : Seq μ} {r : Fin ℓ} {L : List (Fin ℓ)} (h0 : 0 < m)
    (hj : ¬ IsViolated j) (hr : redWord j = r :: L) : j.lbl ⟨0, h0⟩ = .inr r := by
  obtain ⟨r', hr'⟩ : ∃ r', j.lbl ⟨0, h0⟩ = .inr r' := by
    rcases hl : j.lbl ⟨0, h0⟩ with b | r'
    · exact absurd ⟨h0, by simp [hl]⟩ hj
    · exact ⟨r', rfl⟩
  rw [hr']
  by_contra hne
  have hmem : r' ∈ L := by
    have := mem_redWord j r'
    rw [hr, List.mem_cons] at this
    exact this.resolve_left fun h => hne (by rw [h])
  have hpw := redWord_pairwise_one j
  rw [hr, List.pairwise_cons] at hpw
  obtain ⟨a, ha⟩ := exists_lbl_eq_inr j r
  exact absurd (hpw.1 r' hmem a _ ha hr') (by simp [Fin.lt_def])

omit [DecidableEq I] in
/-- **The inversions of moving the leftmost strand to the right edge.** Let `c` send every
position `p` other than the last one to `p + 1`, and let `τ` send `0` to the last
position. Then every inversion of `c τ` is an inversion of `τ`: the diagram `τ` factors through
the diagram `c⁻¹` that carries the strand at the left edge to the right edge. -/
theorem invSet_mul_subset_of_last {c τ : Perm (Fin m)} (h0 : 0 < m)
    (hc : ∀ x : Fin m, (x : ℕ) ≠ m - 1 → (c x : ℕ) = x + 1)
    (hτ : τ ⟨0, h0⟩ = ⟨m - 1, by omega⟩) : invSet m (c * τ) ⊆ invSet m τ := by
  rintro ⟨a, b⟩ hab
  rw [mem_invSet_pair] at hab ⊢
  rw [Perm.mul_apply, Perm.mul_apply] at hab
  refine ⟨hab.1, ?_⟩
  have hb : (τ b : ℕ) ≠ m - 1 := by
    intro h
    have : τ b = τ ⟨0, h0⟩ := by rw [hτ]; exact Fin.ext h
    have := τ.injective this
    subst this
    exact absurd hab.1 (by simp [Fin.lt_def])
  by_cases ha : (τ a : ℕ) = m - 1
  · rw [Fin.lt_def, ha]; have := (τ b).isLt; omega
  · have h2 := hab.2
    rw [Fin.lt_def, hc _ hb, hc _ ha] at h2
    rw [Fin.lt_def]; omega

open Classical in
/-- The right factor `g⁻¹ τ` of `τ` through `g`, if the lengths add, and `1` otherwise. -/
noncomputable def throughFrame (g τ : Perm (Fin m)) : Perm (Fin m) :=
  if invSet m (g⁻¹ * τ) ⊆ invSet m τ then g⁻¹ * τ else 1

omit [DecidableEq I] in
theorem throughFrame_le (g τ : Perm (Fin m)) : invSet m (throughFrame g τ) ⊆ invSet m τ := by
  unfold throughFrame
  split_ifs with h
  · exact h
  · exact invSet_one_subset τ

variable (k Q Λ ν) in
/-- The left ideal spanned by the products `w e(j)` with `e(j)` violated: the diagrams whose
bottom is a violated idempotent. -/
noncomputable def violBottom : Submodule k (BraidedStendhalAlgebra k Q Λ ν) :=
  Submodule.span k {y | ∃ (w : BraidedStendhalAlgebra k Q Λ ν) (j : Seq μ), IsViolated j ∧
    y = w * ofKLR k Q Λ ν (KLRAlgebra.e j)}

theorem mul_e_mem_violBottom (w : BraidedStendhalAlgebra k Q Λ ν) {j : Seq μ}
    (hj : IsViolated j) : w * ofKLR k Q Λ ν (KLRAlgebra.e j) ∈ violBottom k Q Λ ν :=
  Submodule.subset_span ⟨w, j, hj, rfl⟩

theorem mul_mem_violBottom (a : BraidedStendhalAlgebra k Q Λ ν)
    {y : BraidedStendhalAlgebra k Q Λ ν}
    (hy : y ∈ violBottom k Q Λ ν) : a * y ∈ violBottom k Q Λ ν := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, j, hj, rfl⟩ := hy
    rw [← mul_assoc]; exact mul_e_mem_violBottom _ hj
  | zero => rw [mul_zero]; exact zero_mem _
  | add y y' _ _ hy hy' => rw [mul_add]; exact add_mem hy hy'
  | smul c y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hy

theorem mem_violIdeal_of_mem_violBottom {y : BraidedStendhalAlgebra k Q Λ ν}
    (hy : y ∈ violBottom k Q Λ ν) : y ∈ violIdeal k Q Λ ν := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, j, hj, rfl⟩ := hy
    exact TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span ⟨j, hj, rfl⟩)
  | zero => exact zero_mem _
  | add y y' _ _ hy hy' => exact add_mem hy hy'
  | smul c y _ hy =>
    rw [Algebra.smul_def]; exact TwoSidedIdeal.mul_mem_left _ _ _ hy

/-- A diagram with violated bottom is killed by a non-violated idempotent. -/
theorem mul_e_eq_zero_of_mem_violBottom {y : BraidedStendhalAlgebra k Q Λ ν}
    (hy : y ∈ violBottom k Q Λ ν) {t : Seq μ} (ht : ¬ IsViolated t) :
    y * ofKLR k Q Λ ν (KLRAlgebra.e t) = 0 := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, j, hj, rfl⟩ := hy
    have hne : j ≠ t := by rintro rfl; exact ht hj
    rw [mul_assoc, ← map_mul, KLRAlgebra.e_mul_e, ite_eq_right hne, map_zero, mul_zero]
  | zero => rw [zero_mul]
  | add y y' _ _ hy hy' => rw [add_mul, hy, hy', add_zero]
  | smul c y _ hy => rw [smul_mul_assoc, hy, smul_zero]

include hρ hQ in
/-- **Factoring through a fixed diagram modulo violated idempotents.** Let `g • t = s`, and
suppose that every diagram `τ` from a non-violated `j` of red order `κ` to `s` factors through
`g` with lengths adding. Then `e(s) w e_κ` is `ψ_{ρ(g)} e(t) x` modulo diagrams with violated
bottom. -/
theorem exists_e_mul_mul_redProj_sub_mem {s t : Seq μ} {κ : List (Fin ℓ)} (g : Perm (Fin m))
    (hgt : g • t = s)
    (hg : ∀ (j : Seq μ) (τ : Perm (Fin m)), τ • j = s → redWord j = κ → ¬ IsViolated j →
      invSet m (g⁻¹ * τ) ⊆ invSet m τ)
    (w : BraidedStendhalAlgebra k Q Λ ν) :
    ∃ x, ofKLR k Q Λ ν (KLRAlgebra.e s) * w * redProj k Q Λ ν κ -
      ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * x ∈ violBottom k Q Λ ν := by
  set ρ' := fun τ => ρ (τ * (throughFrame g τ)⁻¹) ++ ρ (throughFrame g τ)
  have hρ' : IsReducedChoice ρ' := isReducedChoice_frame hρ _ (throughFrame_le g)
  induction (basis hQ ρ' hρ').mem_span w using Submodule.span_induction with
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨x', hx'⟩ := hx
    obtain ⟨y', hy'⟩ := hy
    refine ⟨x' + y', ?_⟩
    convert add_mem hx' hy' using 1
    noncomm_ring
  | smul c x _ hx =>
    obtain ⟨x', hx'⟩ := hx
    refine ⟨c • x', ?_⟩
    convert Submodule.smul_mem _ c hx' using 1
    simp only [smul_sub, mul_smul_comm, smul_mul_assoc]
  | mem x hx =>
    obtain ⟨⟨⟨j, τ, u⟩, hu⟩, rfl⟩ := hx
    rw [basis_apply, redProj, ← map_mul, ← map_mul]
    dsimp only
    rw [mul_assoc (KLRAlgebra.e s), mul_assoc (_ * _) (KLRAlgebra.e j), e_mul_redIdem]
    split_ifs with hκ
    swap
    · exact ⟨0, by simp⟩
    have hy := e_mul_std (Q := Q) (Λ := Λ) (ρ' τ) (monomial u 1) j
    rw [(hρ' τ).2] at hy
    rw [← hy, ← mul_assoc, KLRAlgebra.e_mul_e]
    split_ifs with hτ
    swap
    · exact ⟨0, by simp⟩
    rw [hτ, hy]
    by_cases hv : IsViolated j
    · refine ⟨0, ?_⟩
      rw [mul_zero, sub_zero, map_mul]
      exact mul_e_mem_violBottom _ hv
    have hle := hg j τ hτ.symm hκ hv
    have hf : throughFrame g τ = g⁻¹ * τ := by simp [throughFrame, hle]
    have hρτ : ρ' τ = ρ g ++ ρ (g⁻¹ * τ) := by simp only [ρ', hf, mul_inv_rev, inv_inv,
      mul_inv_cancel_left]
    have hz := e_mul_std (Q := Q) (Λ := Λ) (ρ (g⁻¹ * τ)) (monomial u 1) j
    rw [(hρ (g⁻¹ * τ)).2, mul_smul, ← hτ, ← hgt, inv_smul_smul] at hz
    refine ⟨ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (g⁻¹ * τ)) * KLRAlgebra.pol (monomial u 1) *
      KLRAlgebra.e j), ?_⟩
    have hY : (KLRAlgebra.ψw (ρ g ++ ρ (g⁻¹ * τ)) * KLRAlgebra.pol (monomial u 1) *
        KLRAlgebra.e j : R) = KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t *
          (KLRAlgebra.ψw (ρ (g⁻¹ * τ)) * KLRAlgebra.pol (monomial u 1) * KLRAlgebra.e j) := by
      rw [KLRAlgebra.ψw_append]
      conv_rhs => rw [mul_assoc, hz]
      simp only [mul_assoc]
    rw [hρτ, hY, map_mul, sub_self]
    exact zero_mem _

include hρ hQ in
/-- **Surjectivity step of Proposition 6.9** (arXiv:1309.3796v2, two red strands). If the last
strand of `s` is the red strand `λ_r`, `g • t = s`, and `g⁻¹` moves every position other than
the last one by one step to the right, then for the red order `r :: L` every element
`e(s) w e_{r :: L}` is `ψ_{ρ(g)} e(t) x` modulo diagrams with violated bottom. -/
theorem exists_e_mul_mul_redProj_sub_mem_of_last {s t : Seq μ} {r : Fin ℓ} {L : List (Fin ℓ)}
    (h0 : 0 < m) (g : Perm (Fin m)) (hgt : g • t = s) (hs : s.lbl ⟨m - 1, by omega⟩ = .inr r)
    (hc : ∀ x : Fin m, (x : ℕ) ≠ m - 1 → (g⁻¹ x : ℕ) = x + 1)
    (w : BraidedStendhalAlgebra k Q Λ ν) :
    ∃ x, ofKLR k Q Λ ν (KLRAlgebra.e s) * w * redProj k Q Λ ν (r :: L) -
      ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ g) * KLRAlgebra.e t) * x ∈ violBottom k Q Λ ν := by
  refine exists_e_mul_mul_redProj_sub_mem hρ hQ g hgt (fun j τ hτ hκ hv => ?_) w
  have hj0 := lbl_zero_of_not_isViolated h0 hv hκ
  have hτ0 : τ ⟨0, h0⟩ = ⟨m - 1, by omega⟩ := by
    refine lbl_inj_of_inr s r ?_ hs
    rw [← hτ, lbl_smul]
    simpa using hj0
  exact invSet_mul_subset_of_last h0 hc hτ0

end BraidedStendhalAlgebra

end Categorification.Stendhal
