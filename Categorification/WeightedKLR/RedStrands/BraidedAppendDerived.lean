import Categorification.Algebra.DerivedTensorDegreeZero
import Categorification.Algebra.ExactDerivedTensor

set_option backward.isDefEq.respectTransparency false

/-!
# The braiding functors commute with `𝔈_i`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2,
Proposition 6.7, for the functor `𝔈_i`. At a red order `κ`, `𝔈_i` is the derived tensor product
with the corner `E_κ` of the induction along appending a black strand
(`BraidedAppendProjective`); the braiding functor `𝔅(κ', κ)` is the derived tensor product with
`B(κ', κ) = e_{κ'} V e_κ` (`BraidingFunctor`, Definition 6.6).

Webster's proof: both composites are tensor products with bimodules projective where needed, so
the derived composites are tensor products of bimodules, and both bimodules are the corner
`e_{κ'} V φ(e_κ)` of the quotient `V` by violated idempotents for `i + ν`.

* The first composite `B(κ', κ) ⊗_{R_κ} E_κ` is the corner by multiplication (`firstEquiv`),
  since `E_κ` is generated by `φ(e_κ)`.
* The second composite `E_{κ'} ⊗_{S_{κ'}} B(κ', κ)` is the corner by multiplication
  (`secondEquiv`), which uses injectivity of the multiplication of the quotient by violated
  idempotents along appending a black strand (`violMk_mult_injective_append`).
* `E_κ` is projective as a left module and `E_{κ'}` as a right module
  (`appendCorner_projective_left`, `appendCorner_projective_right`), which makes the derived
  composites underived.

## Main definitions and results

* `BraidedStendhalAlgebra.appendFunctor κ`: the functor `𝔈_i` at the red order `κ`.
* `BraidedStendhalAlgebra.compDGEquiv`: the two composite bimodules are isomorphic.
* `BraidedStendhalAlgebra.braidingFunctorCompAppendFunctorIso`: **Proposition 6.7** for `𝔈_i`,
  `𝔈_i ∘ 𝔅(κ', κ) ≅ 𝔅(κ', κ) ∘ 𝔈_i`, for symmetric Rouquier `Q` and `κ'` an ordering of the red
  labels.

The functors live on the unbounded derived categories of ungraded right modules (rings in degree
`0`); Webster works with bounded above derived categories of graded modules.
-/

namespace Categorification

open MulOpposite

attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

/-- A projective left `C`-module is projective as a right `Cᵐᵒᵖ`-module. -/
theorem OpBimodule.projective_opOp {C M : Type*} [Ring C] [AddCommGroup M] [Module C M]
    [Module.Projective C M] : Module.Projective Cᵐᵒᵖᵐᵒᵖ (OpBimodule C M) :=
  Module.Projective.of_equiv (σ := ((RingEquiv.opOp C : C ≃+* Cᵐᵒᵖᵐᵒᵖ) : C →+* Cᵐᵒᵖᵐᵒᵖ))
    (σ' := ((RingEquiv.opOp C).symm : Cᵐᵒᵖᵐᵒᵖ →+* C))
    (show M ≃ₛₗ[((RingEquiv.opOp C : C ≃+* Cᵐᵒᵖᵐᵒᵖ) : C →+* Cᵐᵒᵖᵐᵒᵖ)] OpBimodule C M from
      { toFun := fun m => m
        invFun := fun m => m
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl })

end Categorification

namespace Categorification.Stendhal

open KLR TypeA Equiv InductionAlong MulOpposite DG DG.DegreeZero

namespace BraidedStendhalAlgebra

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ) (i : I) (ν : Multiset I)

set_option quotPrecheck false in
local notation "Rc" κ:max =>
  (isIdempotentElem_violMk_redProj k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ).Corner
set_option quotPrecheck false in
local notation "Sc" κ:max => (isIdempotentElem_violMk_redProj k Q Λ ν κ).Corner
set_option quotPrecheck false in
local notation "Ec" κ:max => InductionAlong.Corner (appendCornerHom Q Λ i ν κ)
set_option quotPrecheck false in
local notation "BR" κ':max κ:max =>
  ↥(braidingBimodule k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ' κ)
set_option quotPrecheck false in
local notation "BS" κ':max κ:max => ↥(braidingBimodule k Q Λ ν κ' κ)
set_option quotPrecheck false in
local notation "Vi" => ViolQuotient k Q Λ ((Singleton.singleton i : Multiset I) + ν)

set_option quotPrecheck false in
local notation "eR" κ:max => violMk k Q Λ ((Singleton.singleton i : Multiset I) + ν)
  (redProj k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ)
set_option quotPrecheck false in
local notation "eS" κ:max => violMk k Q Λ ν (redProj k Q Λ ν κ)
set_option quotPrecheck false in
local notation "φ" => appendViol Q Λ i ν

section Facts

variable {Q Λ i ν}

theorem corner_left {V : Type*} [Ring V] {e : V} {h : IsIdempotentElem e} (x : h.Corner) :
    e * x.1 = x.1 :=
  ((Subsemigroup.mem_corner_iff h).mp x.2).1

theorem corner_right {V : Type*} [Ring V] {e : V} {h : IsIdempotentElem e} (x : h.Corner) :
    x.1 * e = x.1 :=
  ((Subsemigroup.mem_corner_iff h).mp x.2).2

end Facts

section First

variable (κ' κ : List (Fin ℓ))

/-- The tensor product `B(κ', κ) ⊗_{R_κ} E_κ` of the first composite. -/
abbrev firstTensor : Type :=
  TensorProductOver (Rc κ)ᵐᵒᵖ (InDegreeZero (OpBimodule (Rc κ) (Ec κ)))
    (InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)))

/-- Multiplication `b ⊗ x ↦ b x` on the first composite. -/
noncomputable def firstMult : firstTensor (k := k) Q Λ i ν κ' κ →+ Vi :=
  TensorProductOver.lift
    (AddMonoidHom.mk' (fun x : InDegreeZero (OpBimodule (Rc κ) (Ec κ)) =>
      AddMonoidHom.mk' (fun b : InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)) =>
        (show BR κ' κ from b).1 * (show Ec κ from x).1.1)
        (fun b b' => add_mul _ _ _))
      (fun x x' => by ext b; exact mul_add _ _ _))
    (fun a x b => (mul_assoc _ _ _).symm)

theorem firstMult_tmul (x : InDegreeZero (OpBimodule (Rc κ) (Ec κ)))
    (b : InDegreeZero (OpBimodule (Rc κ') (BR κ' κ))) :
    firstMult Q Λ i ν κ' κ (TensorProductOver.tmul _ x b) =
      (show BR κ' κ from b).1 * (show Ec κ from x).1.1 := rfl

variable {Q Λ i ν κ' κ} in
theorem firstMult_mem (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    firstMult Q Λ i ν κ' κ t ∈ cornerBimodule (eR κ') (φ (eS κ)) := by
  induction t using TensorProductOver.induction_on with
  | zero => exact zero_mem _
  | tmul x b =>
    rw [firstMult_tmul, mem_cornerBimodule]
    refine ⟨by rw [← mul_assoc, (show BR κ' κ from b).2.1], ?_⟩
    rw [mul_assoc]
    exact congrArg (_ * ·) (congrArg Subtype.val (show Ec κ from x).2)
  | add s t hs ht => rw [map_add]; exact add_mem hs ht

theorem mem_braidingBimodule_of_mem {z : Vi} (hz : z ∈ cornerBimodule (eR κ') (φ (eS κ))) :
    z ∈ braidingBimodule k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ' κ := by
  refine ⟨hz.1, ?_⟩
  rw [← hz.2, mul_assoc]
  exact congrArg (z * ·) (corner_right (appendCornerHom Q Λ i ν κ 1))

variable {Q Λ i ν κ' κ} in
theorem eq_tmul_unitGen (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    t = TensorProductOver.tmul _
      (show InDegreeZero (OpBimodule (Rc κ) (Ec κ)) from unitGen (appendCornerHom Q Λ i ν κ))
      (show InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)) from
        ⟨firstMult Q Λ i ν κ' κ t, mem_braidingBimodule_of_mem Q Λ i ν κ' κ (firstMult_mem t)⟩) :=
    by
  induction t using TensorProductOver.induction_on with
  | zero =>
    symm
    convert TensorProductOver.tmul_zero _ using 2
    exact Subtype.ext (map_zero _)
  | tmul x b =>
    have hx : x = (op (op (show Ec κ from x).1) : (Rc κ)ᵐᵒᵖᵐᵒᵖ) •
        (show InDegreeZero (OpBimodule (Rc κ) (Ec κ)) from unitGen (appendCornerHom Q Λ i ν κ)) :=
      Subtype.ext (show Ec κ from x).2.symm
    conv_lhs => rw [hx, TensorProductOver.op_smul_tmul]
    rfl
  | add s t hs ht =>
    conv_lhs => rw [hs, ht, ← TensorProductOver.tmul_add]
    congr 1
    exact Subtype.ext (map_add _ _ _).symm

theorem firstMult_injective : Function.Injective (firstMult Q Λ i ν κ' κ) := fun s t h => by
  rw [eq_tmul_unitGen s, eq_tmul_unitGen t]
  congr 2
  exact Subtype.ext h

theorem firstMult_surjective {z : Vi} (hz : z ∈ cornerBimodule (eR κ') (φ (eS κ))) :
    ∃ t, firstMult Q Λ i ν κ' κ t = z :=
  ⟨TensorProductOver.tmul _
    (show InDegreeZero (OpBimodule (Rc κ) (Ec κ)) from unitGen (appendCornerHom Q Λ i ν κ))
    (show InDegreeZero (OpBimodule (Rc κ') (BR κ' κ)) from
      ⟨z, mem_braidingBimodule_of_mem Q Λ i ν κ' κ hz⟩), hz.2⟩

/-- Multiplication identifies `B(κ', κ) ⊗_{R_κ} E_κ` with `e_{κ'} B φ(e_κ)`. -/
noncomputable def firstEquiv :
    firstTensor (k := k) Q Λ i ν κ' κ ≃+ cornerBimodule (eR κ') (φ (eS κ)) :=
  AddEquiv.ofBijective ((firstMult Q Λ i ν κ' κ).codRestrict _ firstMult_mem)
    ⟨fun _ _ h => firstMult_injective Q Λ i ν κ' κ (congrArg Subtype.val h),
      fun z => (firstMult_surjective Q Λ i ν κ' κ z.2).imp fun _ h => Subtype.ext h⟩

theorem firstEquiv_val (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    (firstEquiv Q Λ i ν κ' κ t).1 = firstMult Q Λ i ν κ' κ t := rfl

end First

section Second

variable (κ' κ : List (Fin ℓ))

/-- The tensor product `E_{κ'} ⊗_{S_{κ'}} B(κ', κ)` of the second composite. -/
abbrev secondTensor : Type :=
  TensorProductOver (Sc κ')ᵐᵒᵖ (InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)))
    (InDegreeZero (OpBimodule (Rc κ') (Ec κ')))

/-- Multiplication `x ⊗ b ↦ x φ(b)` on the second composite. -/
noncomputable def secondMult : secondTensor (k := k) Q Λ i ν κ' κ →+ Vi :=
  TensorProductOver.lift
    (AddMonoidHom.mk' (fun b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)) =>
      AddMonoidHom.mk' (fun x : InDegreeZero (OpBimodule (Rc κ') (Ec κ')) =>
        (show Ec κ' from x).1.1 * φ (show BS κ' κ from b).1)
        (fun x x' => add_mul _ _ _))
      (fun b b' => by
        ext x
        exact (congrArg (_ * ·) (map_add φ _ _)).trans (mul_add _ _ _)))
    (fun a b x => by
      change _ * φ (_ * _) = _ * φ _ * φ _
      rw [map_mul, mul_assoc]
      rfl)

theorem secondMult_tmul (b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)))
    (x : InDegreeZero (OpBimodule (Rc κ') (Ec κ'))) :
    secondMult Q Λ i ν κ' κ (TensorProductOver.tmul _ b x) =
      (show Ec κ' from x).1.1 * φ (show BS κ' κ from b).1 := rfl

variable {Q Λ i ν κ' κ} in
theorem secondMult_mem (t : secondTensor (k := k) Q Λ i ν κ' κ) :
    secondMult Q Λ i ν κ' κ t ∈ cornerBimodule (eR κ') (φ (eS κ)) := by
  induction t using TensorProductOver.induction_on with
  | zero => exact zero_mem _
  | tmul b x =>
    rw [secondMult_tmul, mem_cornerBimodule]
    refine ⟨by rw [← mul_assoc, corner_left (show Ec κ' from x).1], ?_⟩
    rw [mul_assoc, ← map_mul, (show BS κ' κ from b).2.2]
  | add s t hs ht => rw [map_add]; exact add_mem hs ht

/-- The tensor product along `φ` of Proposition 6.7. -/
abbrev secondAlong : Type :=
  TensorAlong k Vi (ViolQuotient k Q Λ ν) φ (eR κ') (eS κ') (eS κ)

/-- The comparison `x ⊗ b ↦ x ⊗ b` with the tensor product along `φ`. -/
noncomputable def toAlong : secondTensor (k := k) Q Λ i ν κ' κ →+ secondAlong Q Λ i ν κ' κ :=
  TensorProductOver.lift
    (AddMonoidHom.mk' (fun b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)) =>
      AddMonoidHom.mk' (fun x : InDegreeZero (OpBimodule (Rc κ') (Ec κ')) =>
        (TensorAlong.tmul (show Ec κ' from x).1.1 (show BS κ' κ from b).1 :
          secondAlong Q Λ i ν κ' κ))
        (fun x x' => LinearMap.map_add₂ _ _ _ _))
      (fun b b' => by ext x; exact TensorAlong.tmul_add_right _ _ _))
    (fun a b x => by
      have ha : eS κ' * a.unop.1 * eS κ' = a.unop.1 := by
        rw [corner_left a.unop, corner_right a.unop]
      change TensorAlong.tmul (show Ec κ' from x).1.1 (a.unop.1 * (show BS κ' κ from b).1) =
        TensorAlong.tmul ((show Ec κ' from x).1.1 * φ a.unop.1) (show BS κ' κ from b).1
      rw [← ha, TensorAlong.tmul_balance])

theorem toAlong_tmul (b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)))
    (x : InDegreeZero (OpBimodule (Rc κ') (Ec κ'))) :
    toAlong Q Λ i ν κ' κ (TensorProductOver.tmul _ b x) =
      TensorAlong.tmul (show Ec κ' from x).1.1 (show BS κ' κ from b).1 := rfl

theorem mult_toAlong (t : secondTensor (k := k) Q Λ i ν κ' κ) :
    TensorAlong.mult ((idemAppend Q Λ i ν κ').map (violMk k Q Λ _))
      ((idemBase Q Λ ν κ').map (violMk k Q Λ ν)) ((idemBase Q Λ ν κ).map (violMk k Q Λ ν))
      (toAlong Q Λ i ν κ' κ t) = secondMult Q Λ i ν κ' κ t := by
  induction t using TensorProductOver.induction_on with
  | zero => simp only [map_zero]
  | tmul b x =>
    rw [toAlong_tmul, TensorAlong.mult_tmul, secondMult_tmul, corner_left (show Ec κ' from x).1,
      (show BS κ' κ from b).2.1, (show BS κ' κ from b).2.2]
  | add s t hs ht => rw [map_add, map_add, hs, ht, map_add]

section Inverse

variable {Q Λ i ν κ' κ}

theorem idemR (κ : List (Fin ℓ)) : eR κ * eR κ = eR κ :=
  (isIdempotentElem_violMk_redProj k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ).eq

theorem idemS (κ : List (Fin ℓ)) : eS κ * eS κ = eS κ :=
  (isIdempotentElem_violMk_redProj k Q Λ ν κ).eq

theorem phi_idemS_mul_idemR (κ : List (Fin ℓ)) : φ (eS κ) * eR κ = φ (eS κ) :=
  corner_right (appendCornerHom Q Λ i ν κ 1)

theorem idemS_mul (κ : List (Fin ℓ)) (z : ViolQuotient k Q Λ ν) :
    eS κ * (eS κ * z) = eS κ * z := by rw [← mul_assoc, idemS]

theorem idemR_mul (κ : List (Fin ℓ)) (z : Vi) : eR κ * (eR κ * z) = eR κ * z := by
  rw [← mul_assoc, idemR]

theorem phi_idemS (κ : List (Fin ℓ)) : φ (eS κ) * φ (eS κ) = φ (eS κ) := by
  rw [← map_mul, idemS]

theorem phi_idemS_mul (κ : List (Fin ℓ)) (z : Vi) : φ (eS κ) * (φ (eS κ) * z) = φ (eS κ) * z := by
  rw [← mul_assoc, phi_idemS]

variable (κ' κ) in
/-- The corner part `e_{κ'} y e_κ` of `y`. -/
noncomputable def mkB (y : ViolQuotient k Q Λ ν) : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)) :=
  (⟨eS κ' * y * eS κ, by rw [← mul_assoc, ← mul_assoc, idemS], by rw [mul_assoc, idemS]⟩ :
    BS κ' κ)

variable (κ') in
/-- The part `e_{κ'} x φ(e_{κ'})` of `x`, in `E_{κ'}`. -/
noncomputable def mkE (x : Vi) : InDegreeZero (OpBimodule (Rc κ') (Ec κ')) :=
  (⟨⟨eR κ' * x * φ (eS κ'), (Subsemigroup.mem_corner_iff
      (isIdempotentElem_violMk_redProj k Q Λ ((Singleton.singleton i : Multiset I) + ν) κ')).2
      ⟨by rw [← mul_assoc, ← mul_assoc, idemR], by rw [mul_assoc, phi_idemS_mul_idemR]⟩⟩,
    Subtype.ext (show eR κ' * x * φ (eS κ') * φ (eS κ') = _ by
      rw [mul_assoc, ← map_mul, idemS])⟩ : Ec κ')

theorem mkB_val (y : ViolQuotient k Q Λ ν) :
    (show BS κ' κ from mkB κ' κ y).1 = eS κ' * y * eS κ := rfl

theorem mkE_val (x : Vi) :
    (show Ec κ' from mkE (Q := Q) (Λ := Λ) (i := i) (ν := ν) κ' x).1.1 =
      eR κ' * x * φ (eS κ') := rfl

theorem mkB_self (b : InDegreeZero (OpBimodule (Sc κ') (BS κ' κ))) :
    mkB κ' κ (show BS κ' κ from b).1 = b :=
  Subtype.ext (by
    change eS κ' * (show BS κ' κ from b).1 * eS κ = _
    rw [(show BS κ' κ from b).2.1, (show BS κ' κ from b).2.2])

theorem mkE_self (x : InDegreeZero (OpBimodule (Rc κ') (Ec κ'))) :
    mkE κ' (show Ec κ' from x).1.1 = x :=
  Subtype.ext (Subtype.ext (by
    change eR κ' * (show Ec κ' from x).1.1 * φ (eS κ') = _
    rw [corner_left (show Ec κ' from x).1]
    exact congrArg Subtype.val (show Ec κ' from x).2))

end Inverse

section Inverse'

variable {Q Λ i ν κ' κ}

theorem mkB_add (y y' : ViolQuotient k Q Λ ν) :
    mkB κ' κ (y + y') = mkB (Q := Q) (Λ := Λ) κ' κ y + mkB κ' κ y' :=
  Subtype.ext (show eS κ' * (y + y') * eS κ = eS κ' * y * eS κ + eS κ' * y' * eS κ by
    rw [mul_add, add_mul])

theorem mkE_add (x x' : Vi) :
    mkE κ' (x + x') = mkE (Q := Q) (Λ := Λ) (i := i) (ν := ν) κ' x + mkE κ' x' :=
  Subtype.ext (Subtype.ext (show eR κ' * (x + x') * φ (eS κ') =
      eR κ' * x * φ (eS κ') + eR κ' * x' * φ (eS κ') by rw [mul_add, add_mul]))

variable (Q Λ i ν κ' κ) in
/-- The biadditive map `x, y ↦ e_{κ'} y e_κ ⊗ e_{κ'} x φ(e_{κ'})`. -/
noncomputable def invPair : Vi →+ ViolQuotient k Q Λ ν →+ secondTensor (k := k) Q Λ i ν κ' κ :=
  AddMonoidHom.mk' (fun x => AddMonoidHom.mk' (fun y => TensorProductOver.tmul _ (mkB κ' κ y)
      (mkE κ' x)) (fun y y' => by rw [mkB_add, TensorProductOver.add_tmul]))
    (fun x x' => by
      ext y
      exact (congrArg _ (mkE_add x x')).trans (TensorProductOver.tmul_add _ _ _))

theorem invPair_apply (x : Vi) (y : ViolQuotient k Q Λ ν) :
    invPair Q Λ i ν κ' κ x y = TensorProductOver.tmul _ (mkB κ' κ y) (mkE κ' x) := rfl

theorem invPair_corner (x : Vi) (y : ViolQuotient k Q Λ ν) :
    invPair Q Λ i ν κ' κ (eR κ' * x * φ (eS κ')) (eS κ' * y * eS κ) = invPair Q Λ i ν κ' κ x y := by
  rw [invPair_apply, invPair_apply]
  congr 1
  · exact Subtype.ext (show eS κ' * (eS κ' * y * eS κ) * eS κ = eS κ' * y * eS κ by
      simp only [mul_assoc, idemS, idemS_mul])
  · exact Subtype.ext (Subtype.ext (show eR κ' * (eR κ' * x * φ (eS κ')) * φ (eS κ') =
      eR κ' * x * φ (eS κ') by simp only [mul_assoc, idemR_mul, phi_idemS]))

theorem invPair_balance (x : Vi) (c y : ViolQuotient k Q Λ ν) :
    invPair Q Λ i ν κ' κ (x * φ (eS κ' * c * eS κ')) y =
      invPair Q Λ i ν κ' κ x (eS κ' * c * eS κ' * y) := by
  let s : Sc κ' := ⟨eS κ' * c * eS κ', c, rfl⟩
  have hE : mkE κ' (x * φ (eS κ' * c * eS κ')) = (op s : (Sc κ')ᵐᵒᵖ) • mkE κ' x :=
    Subtype.ext (Subtype.ext (show eR κ' * (x * φ (eS κ' * c * eS κ')) * φ (eS κ') =
      eR κ' * x * φ (eS κ') * φ (eS κ' * c * eS κ') by
        simp only [map_mul, mul_assoc, phi_idemS, phi_idemS_mul]))
  have hB : mkB κ' κ (eS κ' * c * eS κ' * y) =
      (op (op s) : (Sc κ')ᵐᵒᵖᵐᵒᵖ) • mkB (Q := Q) (Λ := Λ) κ' κ y :=
    Subtype.ext (show eS κ' * (eS κ' * c * eS κ' * y) * eS κ =
      eS κ' * c * eS κ' * (eS κ' * y * eS κ) by simp only [mul_assoc, idemS_mul])
  rw [invPair_apply, invPair_apply, hE, hB, TensorProductOver.op_smul_tmul]

theorem invPair_smul (r : k) (x : Vi) (y : ViolQuotient k Q Λ ν) :
    invPair Q Λ i ν κ' κ (r • x) y = invPair Q Λ i ν κ' κ x (r • y) := by
  let s : Sc κ' := ⟨r • eS κ', (Subsemigroup.mem_corner_iff
    (isIdempotentElem_violMk_redProj k Q Λ ν κ')).2
      ⟨by rw [mul_smul_comm, idemS], by rw [smul_mul_assoc, idemS]⟩⟩
  have hE : mkE κ' (r • x) = (op s : (Sc κ')ᵐᵒᵖ) • mkE (Q := Q) (Λ := Λ) (i := i) (ν := ν) κ' x :=
    Subtype.ext (Subtype.ext (show eR κ' * (r • x) * φ (eS κ') =
      eR κ' * x * φ (eS κ') * φ (r • eS κ') by
        simp only [map_smul, mul_smul_comm, smul_mul_assoc, mul_assoc, phi_idemS]))
  have hB : mkB κ' κ (r • y) = (op (op s) : (Sc κ')ᵐᵒᵖᵐᵒᵖ) • mkB (Q := Q) (Λ := Λ) κ' κ y :=
    Subtype.ext (show eS κ' * (r • y) * eS κ = r • eS κ' * (eS κ' * y * eS κ) by
      simp only [mul_smul_comm, smul_mul_assoc, mul_assoc, idemS_mul])
  rw [invPair_apply, invPair_apply, hE, hB, TensorProductOver.op_smul_tmul]

theorem invPair_corner_smul (r : k) (x : Vi) (y : ViolQuotient k Q Λ ν) :
    invPair Q Λ i ν κ' κ (r • x) y =
      invPair Q Λ i ν κ' κ (r • (eR κ' * x * φ (eS κ'))) (eS κ' * y * eS κ) := by
  have h : eR κ' * (r • x) * φ (eS κ') = r • (eR κ' * x * φ (eS κ')) := by
    rw [mul_smul_comm, smul_mul_assoc]
  rw [← h, invPair_corner]

theorem invPair_balance_smul (r : k) (x : Vi) (c y : ViolQuotient k Q Λ ν) :
    invPair Q Λ i ν κ' κ (r • (x * φ (eS κ' * c * eS κ'))) y =
      invPair Q Λ i ν κ' κ (r • x) (eS κ' * c * eS κ' * y) := by
  rw [← smul_mul_assoc, invPair_balance]

variable (Q Λ i ν κ' κ) in
/-- The map `Vi ⊗[k] V → secondTensor` induced by `invPair`. -/
noncomputable def invLift :
    TensorProduct k Vi (ViolQuotient k Q Λ ν) →+ secondTensor (k := k) Q Λ i ν κ' κ :=
  TensorProduct.liftAddHom (invPair Q Λ i ν κ' κ) invPair_smul

theorem invLift_tmul (x : Vi) (y : ViolQuotient k Q Λ ν) :
    invLift Q Λ i ν κ' κ (TensorProduct.tmul k x y) = invPair Q Λ i ν κ' κ x y := rfl

theorem invLift_smul_rel (t : TensorProduct k Vi (ViolQuotient k Q Λ ν))
    (ht : t ∈ TensorAlong.rel k _ _ φ (eR κ') (eS κ') (eS κ)) (r : k) :
    invLift Q Λ i ν κ' κ (r • t) = 0 := by
  induction ht using Submodule.span_induction generalizing r with
  | mem t ht =>
    rcases ht with ⟨x, y, rfl⟩ | ⟨x, c, y, rfl⟩
    · rw [smul_sub, TensorProduct.smul_tmul', TensorProduct.smul_tmul', map_sub, sub_eq_zero,
        invLift_tmul, invLift_tmul]
      exact invPair_corner_smul r x y
    · rw [smul_sub, TensorProduct.smul_tmul', TensorProduct.smul_tmul', map_sub, sub_eq_zero,
        invLift_tmul, invLift_tmul]
      exact invPair_balance_smul r x c y
  | zero => rw [smul_zero, map_zero]
  | add s t _ _ hs ht => rw [smul_add, map_add, hs, ht, add_zero]
  | smul a t _ ht => rw [smul_smul]; exact ht _

theorem invLift_rel (t : TensorProduct k Vi (ViolQuotient k Q Λ ν))
    (ht : t ∈ TensorAlong.rel k _ _ φ (eR κ') (eS κ') (eS κ)) :
    invLift Q Λ i ν κ' κ t = 0 := by
  simpa using invLift_smul_rel t ht 1

variable (Q Λ i ν κ' κ) in
/-- The inverse of `toAlong`, from the tensor product along `φ`. -/
noncomputable def fromAlong : secondAlong Q Λ i ν κ' κ →+ secondTensor (k := k) Q Λ i ν κ' κ :=
  QuotientAddGroup.lift (TensorAlong.rel k _ _ φ (eR κ') (eS κ') (eS κ)).toAddSubgroup
    (invLift Q Λ i ν κ' κ) (fun t ht => invLift_rel t ht)

theorem fromAlong_tmul (x : Vi) (y : ViolQuotient k Q Λ ν) :
    fromAlong Q Λ i ν κ' κ (TensorAlong.tmul x y) = invPair Q Λ i ν κ' κ x y := rfl

theorem fromAlong_toAlong (t : secondTensor (k := k) Q Λ i ν κ' κ) :
    fromAlong Q Λ i ν κ' κ (toAlong Q Λ i ν κ' κ t) = t := by
  induction t using TensorProductOver.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul b x => rw [toAlong_tmul, fromAlong_tmul, invPair_apply, mkB_self, mkE_self]
  | add s t hs ht => rw [map_add, map_add, hs, ht]

theorem toAlong_injective : Function.Injective (toAlong Q Λ i ν κ' κ) :=
  Function.LeftInverse.injective fromAlong_toAlong

theorem toAlong_surjective : Function.Surjective (toAlong Q Λ i ν κ' κ) := fun t => by
  induction t using TensorAlong.induction_on with
  | tmul x y => exact ⟨TensorProductOver.tmul _ (mkB κ' κ y) (mkE κ' x),
      (TensorAlong.tmul_corner x y).symm⟩
  | add s t hs ht =>
    obtain ⟨s, rfl⟩ := hs
    obtain ⟨t, rfl⟩ := ht
    exact ⟨s + t, map_add _ _ _⟩

end Inverse'

section Bijective

variable {Q Λ i ν} (hQ : KLRSymm Q)
  {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ} (hρ : IsReducedChoice ρ)

include hQ hρ in
theorem secondMult_injective : Function.Injective (secondMult Q Λ i ν κ' κ) := fun s t h => by
  apply toAlong_injective
  apply violMk_mult_injective_append Q Λ i ν hQ ρ hρ κ' κ
  rw [mult_toAlong, mult_toAlong, h]

include hQ hρ in
theorem secondMult_surjective {z : Vi} (hz : z ∈ cornerBimodule (eR κ') (φ (eS κ))) :
    ∃ t, secondMult Q Λ i ν κ' κ t = z := by
  obtain ⟨u, hu⟩ := violMk_mult_surjective_append Q Λ i ν hQ ρ hρ κ' κ z
  obtain ⟨t, rfl⟩ := toAlong_surjective (Q := Q) (Λ := Λ) (i := i) (ν := ν) (κ' := κ') (κ := κ) u
  refine ⟨t, ?_⟩
  rw [← mult_toAlong, hu, hz.1, hz.2]

/-- Multiplication identifies `E_{κ'} ⊗_{S_{κ'}} B(κ', κ)` with `e_{κ'} B φ(e_κ)`. -/
noncomputable def secondEquiv :
    secondTensor (k := k) Q Λ i ν κ' κ ≃+ cornerBimodule (eR κ') (φ (eS κ)) :=
  AddEquiv.ofBijective ((secondMult Q Λ i ν κ' κ).codRestrict _ secondMult_mem)
    ⟨fun _ _ h => secondMult_injective κ' κ hQ hρ (congrArg Subtype.val h),
      fun z => (secondMult_surjective κ' κ hQ hρ z.2).imp fun _ h => Subtype.ext h⟩

theorem secondEquiv_val (t : secondTensor (k := k) Q Λ i ν κ' κ) :
    (secondEquiv κ' κ hQ hρ t).1 = secondMult Q Λ i ν κ' κ t := rfl

end Bijective

section Linear

open TensorProductOver.RightAction

variable {Q Λ i ν κ' κ}

theorem firstMult_smul (a : (Sc κ)ᵐᵒᵖ) (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    firstMult Q Λ i ν κ' κ (a • t) = firstMult Q Λ i ν κ' κ t * φ a.unop.1 :=
  DFunLike.congr_fun (TensorProductOver.addHom_ext
    (f := (firstMult Q Λ i ν κ' κ).comp (DistribSMul.toAddMonoidHom _ a))
    (g := (AddMonoidHom.mulRight (φ a.unop.1)).comp (firstMult Q Λ i ν κ' κ))
    fun _ _ => (mul_assoc _ _ _).symm) t

theorem secondMult_smul (a : (Sc κ)ᵐᵒᵖ) (t : secondTensor (k := k) Q Λ i ν κ' κ) :
    secondMult Q Λ i ν κ' κ (a • t) = secondMult Q Λ i ν κ' κ t * φ a.unop.1 :=
  DFunLike.congr_fun (TensorProductOver.addHom_ext
    (f := (secondMult Q Λ i ν κ' κ).comp (DistribSMul.toAddMonoidHom _ a))
    (g := (AddMonoidHom.mulRight (φ a.unop.1)).comp (secondMult Q Λ i ν κ' κ))
    fun _ _ => by
      change _ * φ (_ * _) = _ * φ _ * φ _
      rw [map_mul, mul_assoc]) t

theorem firstMult_op_smul (c : (Rc κ')ᵐᵒᵖᵐᵒᵖ) (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    firstMult Q Λ i ν κ' κ (c • t) = c.unop.unop.1 * firstMult Q Λ i ν κ' κ t :=
  DFunLike.congr_fun (TensorProductOver.addHom_ext
    (f := (firstMult Q Λ i ν κ' κ).comp (DistribSMul.toAddMonoidHom _ c))
    (g := (AddMonoidHom.mulLeft c.unop.unop.1).comp (firstMult Q Λ i ν κ' κ))
    fun _ _ => mul_assoc _ _ _) t

theorem secondMult_op_smul (c : (Rc κ')ᵐᵒᵖᵐᵒᵖ) (t : secondTensor (k := k) Q Λ i ν κ' κ) :
    secondMult Q Λ i ν κ' κ (c • t) = c.unop.unop.1 * secondMult Q Λ i ν κ' κ t :=
  DFunLike.congr_fun (TensorProductOver.addHom_ext
    (f := (secondMult Q Λ i ν κ' κ).comp (DistribSMul.toAddMonoidHom _ c))
    (g := (AddMonoidHom.mulLeft c.unop.unop.1).comp (secondMult Q Λ i ν κ' κ))
    fun _ _ => mul_assoc _ _ _) t

end Linear

section Comparison

open TensorProductOver.RightAction

variable {Q Λ i ν} (hQ : KLRSymm Q)
  {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ} (hρ : IsReducedChoice ρ)

/-- The two composite bimodules agree, both being the corner `e_κ' V φ(e_κ)`. -/
noncomputable def compAddEquiv :
    firstTensor (k := k) Q Λ i ν κ' κ ≃+ secondTensor (k := k) Q Λ i ν κ' κ :=
  (firstEquiv Q Λ i ν κ' κ).trans (secondEquiv κ' κ hQ hρ).symm

theorem secondMult_compAddEquiv (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    secondMult Q Λ i ν κ' κ (compAddEquiv κ' κ hQ hρ t) = firstMult Q Λ i ν κ' κ t :=
  congrArg Subtype.val ((secondEquiv κ' κ hQ hρ).apply_symm_apply (firstEquiv Q Λ i ν κ' κ t))

theorem compAddEquiv_smul (a : (Sc κ)ᵐᵒᵖ) (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    compAddEquiv κ' κ hQ hρ (a • t) = a • compAddEquiv κ' κ hQ hρ t :=
  secondMult_injective κ' κ hQ hρ (by
    rw [secondMult_compAddEquiv, firstMult_smul, secondMult_smul, secondMult_compAddEquiv])

theorem compAddEquiv_op_smul (c : (Rc κ')ᵐᵒᵖᵐᵒᵖ) (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    compAddEquiv κ' κ hQ hρ (c • t) = c • compAddEquiv κ' κ hQ hρ t :=
  secondMult_injective κ' κ hQ hρ (by
    rw [secondMult_compAddEquiv, firstMult_op_smul, secondMult_op_smul,
      secondMult_compAddEquiv])

/-- The comparison as a linear isomorphism of left `(Sc κ)ᵐᵒᵖ`-modules. -/
noncomputable def compLinearEquiv :
    firstTensor (k := k) Q Λ i ν κ' κ ≃ₗ[(Sc κ)ᵐᵒᵖ] secondTensor (k := k) Q Λ i ν κ' κ where
  __ := compAddEquiv κ' κ hQ hρ
  map_smul' := compAddEquiv_smul κ' κ hQ hρ

/-- The comparison as an isomorphism of dg modules concentrated in degree `0`. -/
noncomputable def compDGEquiv :
    firstTensor (k := k) Q Λ i ν κ' κ ≃ᵈᵍ[(Sc κ)ᵐᵒᵖ] secondTensor (k := k) Q Λ i ν κ' κ :=
  DGModuleEquiv.ofDegreeZero (compLinearEquiv κ' κ hQ hρ)
    (fun hx hn => TensorProductOver.eq_zero_of_mem_grading_inDegreeZero hn hx)
    TensorProductOver.d_inDegreeZero TensorProductOver.mem_grading_zero_inDegreeZero
    TensorProductOver.d_inDegreeZero

theorem compDGEquiv_op_smul (b : (Rc κ')ᵐᵒᵖ) (t : firstTensor (k := k) Q Λ i ν κ' κ) :
    compDGEquiv (Λ := Λ) (i := i) κ' κ hQ hρ (MulOpposite.op b • t) =
      MulOpposite.op b • compDGEquiv (Λ := Λ) (i := i) κ' κ hQ hρ t :=
  compAddEquiv_op_smul κ' κ hQ hρ _ t

end Comparison

section Derived

open CategoryTheory TensorProductOver.RightAction

universe w

variable (κ : List (Fin ℓ))

/-- **The functor `𝔈_i` at the red order `κ`** (arXiv:1309.3796v2, §6.1): the derived tensor
product `- ⊗ᴸ E_κ` with the corner of the induction along appending a black strand, from right
modules over the corner at `κ` for `i + ν` to right modules over the corner at `κ` for `ν`. -/
noncomputable def appendFunctor [HasDerivedCategory.{w} (Rc κ)ᵐᵒᵖ]
    [HasDerivedCategory.{w} (Sc κ)ᵐᵒᵖ] :
    DG.DerivedCategory.{w} (Rc κ)ᵐᵒᵖ ⥤ DG.DerivedCategory.{w} (Sc κ)ᵐᵒᵖ :=
  derivedRightTensor.{w} (Rc κ) (Sc κ) (Ec κ)

variable {Q Λ i ν} {κ' κ : List (Fin ℓ)}

/-- **Webster, Proposition 6.7** for `𝔈_i`: the braiding functors commute with `𝔈_i`,
`𝔈_i ∘ 𝔅(κ', κ) ≅ 𝔅(κ', κ) ∘ 𝔈_i`, for symmetric Rouquier polynomials `Q` and a red order
`κ'` that is a permutation of `1, …, ℓ`. -/
noncomputable def braidingFunctorCompAppendFunctorIso (hQ : KLRSymm Q)
    {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
    {ρ' : Perm (Fin (Multiset.card (stendhalWeight ℓ ({i} + ν)))) → List ℕ}
    (hρ : IsReducedChoice ρ) (hρ' : IsReducedChoice ρ') (C : QuantumGroup.CartanDatum I)
    (hR : IsRouquierQ C Q) (hκ' : κ'.Perm (List.finRange ℓ))
    [HasDerivedCategory.{w} (Rc κ')ᵐᵒᵖ] [HasDerivedCategory.{w} (Rc κ)ᵐᵒᵖ]
    [HasDerivedCategory.{w} (Sc κ')ᵐᵒᵖ] [HasDerivedCategory.{w} (Sc κ)ᵐᵒᵖ] :
    braidingFunctor.{w} k Q Λ ({i} + ν) κ' κ ⋙ appendFunctor.{w} Q Λ i ν κ ≅
      appendFunctor.{w} Q Λ i ν κ' ⋙ braidingFunctor.{w} k Q Λ ν κ' κ :=
  have : Module.Projective (Rc κ)ᵐᵒᵖᵐᵒᵖ (OpBimodule (Rc κ) (Ec κ)) := by
    have := appendCorner_projective_left Q Λ i ν κ
    exact OpBimodule.projective_opOp
  have : Module.Projective (Sc κ')ᵐᵒᵖ (OpBimodule (Rc κ') (Ec κ')) :=
    appendCorner_projective_right hρ hρ' hQ C hR hκ'
  derivedTensorCompIsoOfProjective.{w} _ _ ≪≫
    dgDerivedTensorIsoOfEquiv (compDGEquiv κ' κ hQ hρ)
      (fun b t => compDGEquiv_op_smul (Λ := Λ) (i := i) κ' κ hQ hρ b t) ≪≫
    (dgDerivedTensorCompIso.{w} (InDegreeZero (OpBimodule (Sc κ') (BS κ' κ)))
      (InDegreeZero.isKProjective :
        IsKProjective (Sc κ')ᵐᵒᵖ (InDegreeZero (OpBimodule (Rc κ') (Ec κ'))))).symm

end Derived


