namespace BraidedStendhalAlgebra

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "C" => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν)
local notation "ord" => List.finRange ℓ

/-- The cut `e(t) V e_κ`, for `t` of red order `κ`, is a cyclic right module over the corner at
`κ`, generated by `e(t)`. -/
theorem module_finite_violCorner {t : Seq μ} {κ : List (Fin ℓ)} (ht : redWord t = κ) :
    Module.Finite (C κ)ᵐᵒᵖ (violCorner k Q Λ ν t κ) := by
  have hE : violMk k Q Λ ν (ofKLR k Q Λ ν (e t)) * violMk k Q Λ ν (ofKLR k Q Λ ν (e t)) =
      violMk k Q Λ ν (ofKLR k Q Λ ν (e t)) := by
    rw [← map_mul, ← map_mul, e_mul_e]
    simp
  have hEP : violMk k Q Λ ν (ofKLR k Q Λ ν (e t)) * violMk k Q Λ ν (redProj k Q Λ ν κ) =
      violMk k Q Λ ν (ofKLR k Q Λ ν (e t)) := by
    rw [← map_mul, e_mul_redProj]
    simp [ht]
  have hPE : violMk k Q Λ ν (redProj k Q Λ ν κ) * violMk k Q Λ ν (ofKLR k Q Λ ν (e t)) =
      violMk k Q Λ ν (ofKLR k Q Λ ν (e t)) := by
    rw [← map_mul, redProj_mul_e]
    simp [ht]
  let g : violCorner k Q Λ ν t κ :=
    ⟨violMk k Q Λ ν (ofKLR k Q Λ ν (e t)), mem_violCorner_iff.2 ⟨hE, hEP⟩⟩
  refine Module.Finite.of_surjective (LinearMap.toSpanSingleton (C κ)ᵐᵒᵖ _ g) fun y => ?_
  obtain ⟨h1, h2⟩ := mem_violCorner_iff.1 y.2
  have hy : violMk k Q Λ ν (redProj k Q Λ ν κ) * y.1 = y.1 := by
    rw [← h1, ← mul_assoc, hPE]
  let c : (C κ)ᵐᵒᵖ := op ⟨y.1, (Subsemigroup.mem_corner_iff
    ((isIdempotentElem_redProj (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ).map
      (violMk k Q Λ ν))).2 ⟨hy, h2⟩⟩
  refine ⟨c, Subtype.ext ?_⟩
  change violMk k Q Λ ν (ofKLR k Q Λ ν (e t)) * y.1 = y.1
  exact h1

/-- The loading standards of red order `κ` are cyclic right modules over the corner at `κ`. -/
theorem module_finite_violLoadingStandard {t : Seq μ} {κ : List (Fin ℓ)} (ht : redWord t = κ) :
    Module.Finite (C κ)ᵐᵒᵖ (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ) :=
  have := module_finite_violCorner (k := k) (Q := Q) (Λ := Λ) ht
  Module.Finite.of_surjective _ (Submodule.mkQ_surjective _)

variable {𝔠 : QuantumGroup.CartanDatum I} (hR : IsRouquierQ 𝔠 Q)

include hR in
/-- The corner at the red order `σ(1, …, ℓ)` is Noetherian: it is isomorphic to `T^{λ ∘ σ}`,
which is finite-dimensional. -/
theorem isNoetherianRing_violOrderCorner_op (σ : Perm (Fin ℓ)) :
    IsNoetherianRing (C ((List.finRange ℓ).map σ))ᵐᵒᵖ := by
  have := isNoetherianRing_tensorProductAlgebra_op (Λ ∘ σ) hR ν
  exact isNoetherianRing_of_ringEquiv _
    ((rightCornerEquiv (Λ := Λ ∘ σ) (ν := ν) (FirstWeight.isReducedChoice_canChoice ν) hR.klrSymm).trans
      (cornerRelabelOp (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ (List.finRange ℓ)).symm)

include hR in
/-- **Loading standards have finite projective dimension** at every red order `σ(1, …, ℓ)`
(Webster, arXiv:1309.3796v2, Corollary 5.22, relabelled along `σ`). Route hypothesis:
`AllFiniteDeltaInjective`, as for Corollary 5.22. -/
theorem exists_hasProjectiveDimensionLT_violLoadingStandard
    (hall : ∀ (n : ℕ) (Λ' : Fin (n + 1) → I →₀ ℕ), AllFiniteDeltaInjective Q Λ' hR.klrSymm)
    (σ : Perm (Fin ℓ)) {s : Seq μ} (hs : redWord s = (List.finRange ℓ).map σ) :
    ∃ N : ℕ, HasProjectiveDimensionLT
      (ModuleCat.of (C ((List.finRange ℓ).map σ))ᵐᵒᵖ
        (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) s ((List.finRange ℓ).map σ))) N := by
  have hs' : redWord (Seq.redPerm σ⁻¹ s) = List.finRange ℓ := by
    rw [redWord_redPerm, hs, List.map_map]
    simp
  obtain ⟨N, hN⟩ := exists_hasProjectiveDimensionLT_loadingStandard (Λ := Λ ∘ σ) (ν := ν)
    (FirstWeight.isReducedChoice_canChoice ν) hR.klrSymm hR hall ((redWord_eq_finRange_iff _).1 hs')
  let L := loadingStandardRelabelEquiv (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ hs'
  let ε := cornerRelabelOp (k := k) (Q := Q) (Λ := Λ) (ν := ν) σ (List.finRange ℓ)
  let φ : ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (Seq.redPerm σ (Seq.redPerm σ⁻¹ s))
        ((List.finRange ℓ).map σ) ≃ₛₗ[(ε : (C ((List.finRange ℓ).map σ))ᵐᵒᵖ →+*
          (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ ∘ σ) (ν := ν) (List.finRange ℓ))ᵐᵒᵖ)]
      ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ ∘ σ) (Seq.redPerm σ⁻¹ s)
        (List.finRange ℓ) :=
    { toFun := fun x => L.symm x
      invFun := fun x => L x
      left_inv := L.apply_symm_apply
      right_inv := L.symm_apply_apply
      map_add' := L.symm.map_add
      map_smul' := fun r x => L.symm.map_smul r x }
  have h := hasProjectiveDimensionLT_of_semilinearEquiv _ φ N hN
  have key : ∀ t : Seq μ, t = s →
      HasProjectiveDimensionLT (ModuleCat.of (C ((List.finRange ℓ).map σ))ᵐᵒᵖ
        (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t ((List.finRange ℓ).map σ))) N →
      HasProjectiveDimensionLT (ModuleCat.of (C ((List.finRange ℓ).map σ))ᵐᵒᵖ
        (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) s ((List.finRange ℓ).map σ))) N := by
    rintro _ rfl h
    exact h
  exact ⟨N, key _ (by rw [Seq.redPerm_redPerm, mul_inv_cancel, Seq.redPerm_one]) h⟩

omit [Field k] in
/-- `B(κ, κ)`, in degree `0`, is compact: it is the corner at `κ`, free of rank one. -/
theorem isCompact_Q_braidingBimodule_self {k : Type} [Field k]
    {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {κ₂ κ₁ : List (Fin ℓ)}
    (h : κ₂ = κ₁)
    [HasDerivedCategory.{0, 0} (isIdempotentElem_violMk_redProj k Q Λ ν κ₁).Cornerᵐᵒᵖ] :
    IsCompact.{0} (DG.DerivedCategory.Q.obj (DGModuleCat.of
      (isIdempotentElem_violMk_redProj k Q Λ ν κ₁).Cornerᵐᵒᵖ
      (InDegreeZero (OpBimodule (isIdempotentElem_violMk_redProj k Q Λ ν κ₂).Corner
        (braidingBimodule k Q Λ ν κ₂ κ₁))))) := by
  subst h
  let he := isIdempotentElem_violMk_redProj k Q Λ ν κ₂
  let P := ModuleCat.of he.Cornerᵐᵒᵖ (OpBimodule he.Corner (braidingBimodule k Q Λ ν κ₂ κ₂))
  have : Module.Projective he.Cornerᵐᵒᵖ P := projective_cornerBimodule_self he
  have : Module.Finite he.Cornerᵐᵒᵖ P :=
    Module.Finite.equiv (cornerBimoduleSelfEquiv he).symm
  exact isCompact_Q_inDegreeZero_of_projective P

end BraidedStendhalAlgebra

namespace FirstWeight

open KLGamma Categorification.Graded QuantumGroup QuantumGroup.UDot
open LieLean LieLean.QuantumGroup LieLean.QuantumGroup.GrandLoop LusztigF BraidedStendhalAlgebra

variable {I : Type} {k : Type} {Y : Type*} [DecidableEq I] [Field k] [AddCommGroup Y] [Finite I]
    {Q : I → I → MvPolynomial (Fin 2) k} (C : CartanDatum I) (hQ : IsRouquierQ C Q)
    {R : C.toLusztig.RootDatum Y} (hR : R.IsXRegular) {ℓ : ℕ}
  [∀ (Ω : Fin ℓ → I →₀ ℕ) (ν : Multiset I), Module.Finite k (TensorProductAlgebra k Q Ω ν)]
  [∀ (Ω : Fin ℓ → I →₀ ℕ) (ν : Multiset I) (κ : List (Fin ℓ)),
    DG.HasDerivedCategory.{0, 0} (ViolOrderCorner (k := k) (Q := Q) (Λ := Ω) (ν := ν) κ)]
  [∀ (Ω : Fin ℓ → I →₀ ℕ) (ν : Multiset I) (κ : List (Fin ℓ)),
    DG.HasDerivedCategory.{0, 0} (ViolOrderCorner (k := k) (Q := Q) (Λ := Ω) (ν := ν) κ)ᵐᵒᵖ]
  [DG.HasDerivedCategory.{0, 0} ℤ]

include hR in
/-- **Webster, Lemma 6.13** (arXiv:1309.3796v3), ungraded reading: the derived braiding functor
`𝔅((1, …, ℓ), w)` sends compact objects (perfect complexes) to compact objects. Route
hypothesis: that of Corollary 6.10 (`RowFigureFiveHypotheses`), through Lemma 6.11. -/
theorem isCompact_braidingFunctor_obj
    (H : ∀ (n m : ℕ), n + 2 + m = ℓ → ∀ (Ω : Fin (n + 2 + m) → I →₀ ℕ)
      (u : Fin (n + 2 + m) → List I) (hu : u (rightPos n m) = []),
      RowFigureFiveHypotheses C hQ Ω u hu)
    (Λ : Fin ℓ → I →₀ ℕ) (wt : Fin ℓ → Dom R) (hwt : ∀ r i, (Λ r i : ℤ) = (wt r).1 (R.coroot i))
    (ν : Multiset I) (w : Perm (Fin ℓ))
    {X : DG.DerivedCategory.{0, 0}
      (isIdempotentElem_violMk_redProj k Q Λ ν (List.finRange ℓ)).Cornerᵐᵒᵖ}
    (hX : IsCompact.{0} X) :
    IsCompact.{0} ((braidingFunctor.{0} k Q Λ ν (List.finRange ℓ)
      ((List.finRange ℓ).map w)).obj X) := by
  have hall : ∀ (n : ℕ) (Λ' : Fin (n + 1) → I →₀ ℕ), AllFiniteDeltaInjective Q Λ' hQ.klrSymm :=
    fun _ _ => allFiniteDeltaInjective_of_isRouquierQ hQ hQ.klrSymm _
  refine isCompact_obj_of_isCompact_obj_self _ ?_ hX
  refine IsCompact.of_iso (derivedTensorRegularCoefficientIso _ _ _) ?_
  by_cases hw : w = 1
  · exact isCompact_Q_braidingBimodule_self (by simp [hw])
  have := isNoetherianRing_violOrderCorner_op (Λ := Λ) (ν := ν) hQ w
  obtain ⟨m, hm⟩ := exists_hasFiltration_braidingBimodule (k := k) (Q := Q) (Λ := Λ) (ν := ν)
    (List.finRange ℓ) ((List.finRange ℓ).map w) fun t ht =>
      exists_hasFiltration_violCorner_of_braidFunctor (isReducedChoice_canChoice ν) hQ.klrSymm
        hQ w t ((redWord_eq_finRange_iff t).1 ht)
        (hasCornerStandardFiltration_braidF.{0} C hQ hR H w hw Λ wt hwt t
          ((redWord_eq_finRange_iff t).1 ht))
  refine hm.isCompact_Q fun c _ => ?_
  have := module_finite_violLoadingStandard (k := k) (Q := Q) (Λ := Λ) c.2.1
  obtain ⟨N, hN⟩ := exists_hasProjectiveDimensionLT_violLoadingStandard (Λ := Λ) hQ hall w c.2.1
  exact isCompact_Q_inDegreeZero_of_hasProjectiveDimensionLT N _
    (hasProjectiveDimensionLT_of_ge _ N (N + 1) (Nat.le_succ N))

end FirstWeight

