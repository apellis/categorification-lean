import Categorification.WeightedKLR.RedStrands.EraseFirstRed
import Categorification.WeightedKLR.RedStrands.StendhalGrading
import Categorification.Algebra.Graded.HighDegreeIdeal
import Categorification.Algebra.Graded.IdempotentLift
import Categorification.KLR.GradedBasis

/-!
# Adding a red strand of large label is faithful in degree zero

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3,
proof of Proposition 4.39. The kernel of `prependRed` lies in the ideal generated by
`x₁^{⟨α_i^∨, λ₀⟩} e(s)` (`mem_firstDotIdeal_of_prependRed_eq_zero`). These generators
have degree `⟨α_i^∨, λ₀⟩ · deg x_i`. If the grading vanishes below `-c` and every such
degree exceeds `2c`, the ideal has no nonzero element of degree zero, so `prependRed` is
injective in degree zero.

Over a field with dots of positive degree, the graded pieces of `T̃^λ` are finite
dimensional and vanish in sufficiently negative degree (`hasGdim_stendhalGrade`), which
supplies such a `c`.

## Main results

* `hasGdim_allOrdersGrade`, `hasGdim_stendhalGrade` : graded dimensions of `T̃^λ`.
* `prependRed_eq_zero_of_mem_zero` : `prependRed` is injective in degree zero once the
  first label is large.
-/

open Categorification.Graded

namespace Categorification.Stendhal

open KLR

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

section Corner

variable {k A : Type*} [Field k] [Ring A] [Algebra k A] (𝒜 : ℤ → Submodule k A) {E : A}
  (he : IsIdempotentElem E)

/-- A corner of a graded algebra with graded dimension has graded dimension. -/
theorem hasGdim_cornerGrading [HasGdim 𝒜] : HasGdim (Graded.cornerGrading 𝒜 he) where
  finiteDimensional n := by
    let f : Graded.cornerGrading 𝒜 he n →ₗ[k] 𝒜 n :=
      { toFun := fun x => ⟨x.1.1, x.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun c x => Subtype.ext ((IsIdempotentElem.cornerVal (R := k) he).map_smul c x.1) }
    refine Module.Finite.of_injective f fun x y h => ?_
    have h' : x.1.1 = y.1.1 := congrArg (fun w : 𝒜 n => (w : A)) h
    exact Subtype.ext (Subtype.ext h')
  bddBelow := by
    obtain ⟨L, hL⟩ := HasGdim.bddBelow (ℳ := 𝒜)
    refine ⟨L, fun n hn => hL fun h => hn ?_⟩
    rw [eq_bot_iff]
    intro x hx
    have hx' : x.1 ∈ 𝒜 n := hx
    rw [h, Submodule.mem_bot] at hx'
    rw [Submodule.mem_bot]
    exact Subtype.ext hx'

end Corner

variable {I : Type*} [DecidableEq I] {ℓ : ℕ}

section Gdim

variable {k : Type*} [Field k] {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ}
  (G : KLR.GradingDatum (stendhalQ Q Λ)) (ν : Multiset I)
  (hsym : KLRSymm (stendhalQ Q Λ)) (hX : ∀ a, 0 < G.degX a)

include hsym hX in
/-- **Graded dimension of the algebra of all red orders**, over a field with dots of
positive degree. -/
theorem hasGdim_allOrdersGrade : HasGdim (allOrdersGrade G ν) := by
  have := G.hasGdim_grade' (ν := stendhalWeight ℓ ν) hsym hX
  exact hasGdim_of_surjective (G.grade (stendhalWeight ℓ ν)) (allOrdersGrade G ν)
    (StendhalAlgebraAllOrders.ofKLR k Q Λ ν)
    (fun _ _ hx => Graded.mem_map_of_mem _ _ hx) StendhalAlgebraAllOrders.ofKLR_surjective

include hsym hX in
/-- **Graded dimension of `T̃^λ`** (Webster, arXiv:1309.3796v3, Definitions 4.4–4.7), over
a field with dots of positive degree. -/
theorem hasGdim_stendhalGrade : HasGdim (stendhalGrade G ν) := by
  have := hasGdim_allOrdersGrade G ν hsym hX
  exact hasGdim_cornerGrading _ _

include hsym hX in
/-- The algebra of all red orders vanishes in sufficiently negative degree. -/
theorem exists_allOrdersGrade_eq_bot : ∃ c : ℤ, ∀ n < -c, allOrdersGrade G ν n = ⊥ := by
  have := hasGdim_allOrdersGrade G ν hsym hX
  obtain ⟨L, hL⟩ := HasGdim.bddBelow (ℳ := allOrdersGrade G ν)
  refine ⟨-L, fun n hn => ?_⟩
  by_contra h
  have := hL h
  omega

end Gdim

section DegreeZero

variable {k : Type*} [CommRing k] (Q : I → I → MvPolynomial (Fin 2) k)
  (Λ : Fin (ℓ + 1) → I →₀ ℕ) (ν : Multiset I)
  (G : KLR.GradingDatum (stendhalQ Q (Λ ∘ Fin.succ)))

local notation "μ" => stendhalWeight ℓ ν

omit [DecidableEq I] in
private theorem mem_of_lbl_eq_inl (s : Seq μ) (a : Fin (Multiset.card μ)) (i : I)
    (h : s.lbl a = .inl i) : i ∈ ν := by
  have hmem : s.1 a ∈ Finset.univ.val.map s.1 := Multiset.mem_map_of_mem _ (Finset.mem_univ_val a)
  rw [s.2] at hmem
  change s.lbl a ∈ μ at hmem
  rw [h] at hmem
  simpa [stendhalWeight] using hmem

private theorem x_pow_mul_e_mem_grade {Q' : I ⊕ Fin ℓ → I ⊕ Fin ℓ → MvPolynomial (Fin 2) k}
    (G' : KLR.GradingDatum Q') (s : Seq μ) (a : Fin (Multiset.card μ)) (n : ℕ) :
    (KLRAlgebra.x a ^ n * KLRAlgebra.e s : KLRAlgebra k Q' μ) ∈
      G'.grade μ (n * G'.degX (s.lbl a)) := by
  induction n with
  | zero => simpa using G'.e_mem_grade s
  | succ n ih =>
    have h : (KLRAlgebra.x a ^ (n + 1) * KLRAlgebra.e s : KLRAlgebra k Q' μ) =
        (KLRAlgebra.x a * KLRAlgebra.e s) * (KLRAlgebra.x a ^ n * KLRAlgebra.e s) := by
      have hc : Commute (KLRAlgebra.e s : KLRAlgebra k Q' μ) (KLRAlgebra.x a ^ n) :=
        (Commute.pow_right (show Commute (KLRAlgebra.e s : KLRAlgebra k Q' μ) (KLRAlgebra.x a)
          from (KLRAlgebra.x_mul_e a s).symm) n)
      rw [mul_assoc, ← mul_assoc (KLRAlgebra.e s), hc.eq, mul_assoc, KLRAlgebra.e_mul_e]
      simp [pow_succ', mul_assoc]
    rw [h, show ((n + 1 : ℕ) : ℤ) * G'.degX (s.lbl a) = G'.degX (s.lbl a) +
      n * G'.degX (s.lbl a) by push_cast; ring]
    exact SetLike.GradedMul.mul_mem (G'.x_mul_e_mem_grade a s) ih

/-- **Adding a red strand of large label is injective in degree zero** (Webster,
arXiv:1309.3796v3, proof of Proposition 4.39). If the grading of all red orders vanishes
below `-c` and `⟨α_i^∨, λ₀⟩ · deg x_i > 2c` for every black label `i` that occurs, an element
of degree zero of `T̃^λ` that dies in `T^{(λ₀, λ)}` is zero. -/
theorem prependRed_eq_zero_of_mem_zero {c : ℤ} (hc : ∀ n < -c, allOrdersGrade G ν n = ⊥)
    (hΛ : ∀ i ∈ ν, 2 * c < Λ 0 i * G.degX (.inl i)) {z : StendhalAlgebra k Q (Λ ∘ Fin.succ) ν}
    (hz0 : z ∈ stendhalGrade G ν 0) (hz : prependRed Q Λ ν z = 0) : z = 0 := by
  apply Subtype.ext
  refine eq_zero_of_mem_span_of_mem_zero (allOrdersGrade G ν) hc ?_
    (mem_firstDotIdeal_of_prependRed_eq_zero Q Λ ν z hz) hz0
  rintro _ ⟨s, i, h, hs, rfl⟩
  refine ⟨Λ 0 i * G.degX (.inl i), hΛ i (mem_of_lbl_eq_inl ν s _ i hs), ?_⟩
  have hmem := Graded.mem_map_of_mem (G.grade μ)
    (StendhalAlgebraAllOrders.ofKLR k Q (Λ ∘ Fin.succ) ν).toLinearMap
    (x_pow_mul_e_mem_grade ν G s ⟨0, h⟩ (Λ 0 i))
  rw [hs] at hmem
  simpa [allOrdersGrade, StendhalAlgebraAllOrders.x, StendhalAlgebraAllOrders.e, map_mul, map_pow]
    using hmem

end DegreeZero

end Categorification.Stendhal
