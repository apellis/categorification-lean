import Categorification.WeightedKLR.RedStrands.AdjacentBlockRoot
import Categorification.WeightedKLR.RedStrands.BraidedViolatedQuotient

/-!
# Sliding higher block loadings through the red crossing

Webster, arXiv:1309.3796v2, §6.1, proof of Lemma 6.8. In the bimodule for a single red
crossing, the subspace of diagrams factoring through a strictly higher block loading is the
same whether the higher loading has the top or the bottom red order. This concerns the
ordinary diagram relations, not the vanishing of higher homology.

We work in the quotient by violated diagrams. To slide a higher loading upwards, expand the
remaining diagram in crossing words adapted to the interval-supported factor. At the cut after
that factor, the red order has changed and the block root is still strictly higher. Reflection
in a horizontal line moves a higher loading downwards instead.
-/

noncomputable section

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR TypeA Equiv MvPolynomial

variable {I k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "R" => KLRAlgebra k (stendhalQ Q Λ) μ
local notation "V" => ViolQuotient k Q Λ ν
local notation "π" => AlgHom.comp (violMk k Q Λ ν) (ofKLR k Q Λ ν)
local notation "E" => KLRAlgebra.e (k := k) (Q := stendhalQ Q Λ) (ν := μ)

variable {L M : List (Fin ℓ)} {a b : Fin ℓ} {α : Fin ℓ → I → ℕ}

private theorem kill_higher_cut {D : Type*} [Ring D] [Algebra k D] (F : R →ₐ[k] D)
    (hs : ∀ t : Seq μ, redWord t = L ++ b :: a :: M → α < adjacentBlockRoot a b t →
      F (E t) = 0) {s : Seq μ} (hord : redWord s = L ++ a :: b :: M)
    (hlt : α < adjacentBlockRoot a b s) (w : R) :
    F (redIdem k Q Λ (L ++ b :: a :: M) * w * E s) = 0 := by
  classical
  let κ := L ++ b :: a :: M
  let v (τ : Perm (Fin m)) := if h : redWord (τ • s) = κ then
    (exists_adjacentBlock_frame hord h).choose else 1
  have hv (τ : Perm (Fin m)) : invSet m (v τ) ⊆ invSet m τ := by
    dsimp only [v]; split_ifs with h
    · exact (exists_adjacentBlock_frame hord h).choose_spec.1
    · exact invSet_one_subset _
  let ρ := canWord m
  have hρ : IsReducedChoice ρ := fun τ => ⟨isReduced_canWord _ _, wordProd_canWord _ _⟩
  let words := fun τ => ρ (τ * (v τ)⁻¹) ++ ρ (v τ)
  have hw : IsReducedChoice words := isReducedChoice_frame hρ _ hv
  rw [redIdem, Finset.sum_mul, Finset.sum_mul, map_sum]
  refine Finset.sum_eq_zero fun t ht => ?_
  have ht' : redWord t = κ := (Finset.mem_filter.1 ht).2
  have he : E t * (E t * w * E s) * E s = E t * w * E s := by
    simp only [← mul_assoc, KLRAlgebra.e_mul_self]
    rw [mul_assoc _ (E s), KLRAlgebra.e_mul_self]
  apply (show _ ≤ LinearMap.ker F.toLinearMap from Submodule.span_le.2 ?_)
    (KLRAlgebra.mem_span_corner' words hw s t he)
  rintro _ ⟨τ, u, hτ, rfl⟩
  change F (KLRAlgebra.ψw (words τ) * KLRAlgebra.pol (monomial u 1) * E s) = 0
  have hτ' : redWord (τ • s) = κ := hτ ▸ ht'
  have hspec := (exists_adjacentBlock_frame hord hτ').choose_spec
  have heq : v τ = (exists_adjacentBlock_frame hord hτ').choose := by simp [v, hτ']
  rw [← heq] at hspec
  have hkill := hs _ hspec.2.1 (hlt.trans_le hspec.2.2)
  have hcut := e_mul_std (Q := Q) (Λ := Λ) (ρ (v τ)) (monomial u 1) s
  rw [(hρ _).2] at hcut
  rw [show words τ = ρ (τ * (v τ)⁻¹) ++ ρ (v τ) from rfl, KLRAlgebra.ψw_append,
    mul_assoc (KLRAlgebra.ψw _), mul_assoc (KLRAlgebra.ψw _), ← hcut,
    map_mul, map_mul, hkill, zero_mul, mul_zero]

variable (k Q Λ ν) in
/-- The ideal generated by the higher loadings of the specified order. Cutting it on the
left by a fixed loading of root `α` and on the right by a red order selects the corresponding
space of partial standard relations, not a two-sided quotient of the module itself. -/
def blockUpperIdeal (a b : Fin ℓ) (α : Fin ℓ → I → ℕ) (κ : List (Fin ℓ)) : TwoSidedIdeal V :=
  TwoSidedIdeal.span {z | ∃ t : Seq μ, redWord t = κ ∧ α < adjacentBlockRoot a b t ∧ z = π (E t)}

local notation "J" => blockUpperIdeal k Q Λ ν a b α
local notation "P" => fun κ => violMk k Q Λ ν (redProj k Q Λ ν κ)

private theorem upperMk_eq_zero (κ : List (Fin ℓ)) (z : V) :
    (J κ).ringCon.mkₐ k z = 0 ↔ z ∈ J κ := by
  change (J κ).ringCon.mk' z = 0 ↔ _
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk']

private theorem upperMk_e (κ : List (Fin ℓ)) {s : Seq μ} (hs : redWord s = κ)
    (hlt : α < adjacentBlockRoot a b s) : (J κ).ringCon.mkₐ k (π (E s)) = 0 :=
  (upperMk_eq_zero _ _).2 (TwoSidedIdeal.subset_span ⟨s, hs, hlt, rfl⟩)

private theorem push_higher {s : Seq μ} (hs : redWord s = L ++ a :: b :: M)
    (hlt : α < adjacentBlockRoot a b s) (w : V) :
    (P (L ++ b :: a :: M)) * w * π (E s) ∈ J (L ++ b :: a :: M) := by
  obtain ⟨w, rfl⟩ := violMk_surjective w
  obtain ⟨w, rfl⟩ := ofKLR_surjective w
  apply (upperMk_eq_zero _ _).1
  let F := ((J (L ++ b :: a :: M)).ringCon.mkₐ k).comp π
  have h := kill_higher_cut F (fun _ ht hlt => upperMk_e _ ht hlt) hs hlt w
  simpa only [F, AlgHom.comp_apply, map_mul, redProj] using h

private theorem pull_higher {s : Seq μ} (hs : redWord s = L ++ b :: a :: M)
    (hlt : α < adjacentBlockRoot a b s) (w : V) :
    π (E s) * w * (P (L ++ a :: b :: M)) ∈ J (L ++ a :: b :: M) := by
  obtain ⟨w, rfl⟩ := violMk_surjective w
  obtain ⟨w, rfl⟩ := ofKLR_surjective w
  apply (upperMk_eq_zero _ _).1
  let F := ((J (L ++ a :: b :: M)).ringCon.mkₐ k).comp π
  let G := F.op.comp (KLRAlgebra.flipH k (stendhalQ Q Λ) μ).toAlgHom
  have hG (t : Seq μ) (ht : redWord t = L ++ a :: b :: M) (hu : α < adjacentBlockRoot b a t) :
      G (E t) = 0 := by
    apply MulOpposite.unop_injective
    change F (KLRAlgebra.hflip (E t)) = 0
    rw [KLRAlgebra.hflip_e]
    exact upperMk_e _ ht (adjacentBlockRoot_swap b a t ▸ hu)
  have h := congrArg MulOpposite.unop (kill_higher_cut G hG hs
    (adjacentBlockRoot_swap a b s ▸ hlt) (KLRAlgebra.hflip w))
  change F (KLRAlgebra.hflip (_ * _ * _)) = 0 at h
  simpa only [F, KLRAlgebra.hflip_mul, KLRAlgebra.hflip_e, KLRAlgebra.hflip_hflip,
    redIdem, KLRAlgebra.hflip_sum, AlgHom.comp_apply, map_mul, redProj, mul_assoc] using h

/-- **Moving a higher cut across the red crossing** (Webster, arXiv:1309.3796v2, Lemma 6.8,
ordinary comparison). In the crossing bimodule the diagrams factoring through a strictly
higher block loading of the bottom order are exactly those factoring through one of the top
order. The equalities on `z` are the two defining corner conditions. -/
theorem mem_blockUpperIdeal_iff {z : V} (ht : (P (L ++ b :: a :: M)) * z = z)
    (hb : z * (P (L ++ a :: b :: M)) = z) :
    z ∈ J (L ++ a :: b :: M) ↔ z ∈ J (L ++ b :: a :: M) := by
  constructor
  · intro hz
    rw [← ht]
    clear ht hb
    rw [blockUpperIdeal, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hz
    induction hz using AddSubgroup.closure_induction with
    | mem x hx =>
      obtain ⟨_, ⟨c, -, _, ⟨s, hs, hlt, rfl⟩, rfl⟩, d, -, rfl⟩ := hx
      rw [← mul_assoc, ← mul_assoc]
      exact TwoSidedIdeal.mul_mem_right _ _ _ (push_higher hs hlt c)
    | zero => rw [mul_zero]; exact zero_mem _
    | add _ _ _ _ hu hv => rw [mul_add]; exact add_mem hu hv
    | neg _ _ hu => rw [mul_neg]; exact neg_mem hu
  · intro hz
    rw [← hb]
    clear ht hb
    rw [blockUpperIdeal, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hz
    induction hz using AddSubgroup.closure_induction with
    | mem x hx =>
      obtain ⟨_, ⟨c, -, _, ⟨s, hs, hlt, rfl⟩, rfl⟩, d, -, rfl⟩ := hx
      change c * π (E s) * d * P (L ++ a :: b :: M) ∈ _
      simpa only [mul_assoc] using
        TwoSidedIdeal.mul_mem_left _ c _ (pull_higher hs hlt d)
    | zero => rw [zero_mul]; exact zero_mem _
    | add _ _ _ _ hu hv => rw [add_mul]; exact add_mem hu hv
    | neg _ _ hu => rw [neg_mul]; exact neg_mem hu

end Categorification.Stendhal.BraidedStendhalAlgebra
