import Categorification.WeightedKLR.RedStrands.CornerSimple

/-!
# Simple quotients generated on an idempotent

Webster, arXiv:1309.3796v2, Lemma 5.9 and proof of Theorem 5.8. A module
generated by a simple corner has a unique maximal submodule. For a
degree-zero idempotent its quotient inherits the grading and preserves the
entire corner.
-/

noncomputable section
namespace Categorification.Stendhal

open Categorification.Graded GProj DirectSum

variable {A : Type*} [Ring A] (e : A) (M : Type*) [AddCommGroup M] [Module A M]

/-- The largest submodule on which the idempotent acts by zero. -/
def cornerKernel : Submodule A M where
  carrier := {x | ∀ a : A, e • (a • x) = 0}
  zero_mem' := by simp
  add_mem' := fun hx hy a => by rw [smul_add, smul_add, hx, hy, add_zero]
  smul_mem' := fun a x hx b => by rw [← mul_smul b a]; exact hx _

variable {k B : Type*} [Field k] [Ring B] [Algebra k A] [Algebra k B]
    [Module k M] [IsScalarTower k A M] (φ : B →ₙₐ[k] A)

private theorem boundary_one_idem : IsIdempotentElem (φ 1) := by
  rw [IsIdempotentElem, ← map_mul, one_mul]

local notation "K" => cornerKernel (φ 1) M
local notation "F" => boundaryFixed φ M

/-- For a module generated on a simple corner, every proper submodule is
contained in the kernel of all the operators `e a` (Webster, Lemma 5.9). -/
theorem le_cornerKernel_of_ne_top [IsSimpleModule B F]
    (hgen : Submodule.span A {x : M | φ 1 • x = x} = ⊤)
    {N : Submodule A M} (hN : N ≠ ⊤) : N ≤ K := by
  intro x hx a
  by_contra hn
  let y : F := ⟨φ 1 • (a • x), by
    change φ 1 • (φ 1 • (a • x)) = _
    rw [← mul_smul, (boundary_one_idem φ).eq]⟩
  have hy : y ≠ 0 := fun h => hn (congrArg Subtype.val h)
  have hyN : y.1 ∈ N := N.smul_mem _ (N.smul_mem _ hx)
  apply hN
  rw [eq_top_iff, ← hgen, Submodule.span_le]
  intro z hz
  obtain ⟨b,hb⟩ := IsSimpleModule.toSpanSingleton_surjective B hy (⟨z,hz⟩ : F)
  have heq : φ b • y.1 = z := congrArg Subtype.val hb
  rw [← heq]
  exact N.smul_mem _ hyN

/-- Webster, arXiv:1309.3796v2, Lemma 5.9. The displayed kernel is the
unique maximal submodule, so its quotient is the unique simple quotient. -/
theorem eq_cornerKernel_iff_simpleQuotient [IsSimpleModule B F]
    (hgen : Submodule.span A {x : M | φ 1 • x = x} = ⊤) (N : Submodule A M) :
    N = K ↔ IsSimpleModule A (M ⧸ N) := by
  have hne : K ≠ ⊤ := by
    let := IsSimpleModule.nontrivial B F
    obtain ⟨z,hz⟩ := exists_ne (0 : F)
    intro ht
    have hm : z.1 ∈ K := ht ▸ Submodule.mem_top
    have hv := hm (1 : A)
    rw [one_smul, show φ 1 • z.1 = z.1 from z.2] at hv
    exact hz (Subtype.ext hv)
  have hle := fun (P : Submodule A M) (hP : P ≠ ⊤) => le_cornerKernel_of_ne_top M φ hgen hP
  rw [isSimpleModule_iff_isCoatom, isCoatom_iff_ge_of_le]
  constructor
  · rintro rfl
    exact ⟨hne,fun P hP _ => hle P hP⟩
  · rintro ⟨hN,hmax⟩
    exact le_antisymm (hle N hN) (hmax K hne (hle N hN))

/-- Quotient by the kernel induces an isomorphism on the whole boundary. -/
def cornerHeadFixedEquiv : F ≃ₗ[B] boundaryFixed φ (M ⧸ K) := by
  let f : F →ₗ[B] boundaryFixed φ (M ⧸ K) :=
    { toFun := fun x => ⟨(K).mkQ x.1, by
        change φ 1 • (K).mkQ x.1 = (K).mkQ x.1
        rw [← map_smul, show φ 1 • x.1 = x.1 from x.2]⟩
      map_add' := fun x y => Subtype.ext (map_add _ _ _)
      map_smul' := fun b x => Subtype.ext ((K).mkQ.map_smul (φ b) x.1) }
  apply LinearEquiv.ofBijective f
  constructor
  · apply (injective_iff_map_eq_zero f).2
    intro z hz
    have hm := (Submodule.Quotient.mk_eq_zero K).1 (congrArg Subtype.val hz)
    have hv := hm (1 : A)
    rw [one_smul, show φ 1 • z.1 = z.1 from z.2] at hv
    exact Subtype.ext hv
  · intro z
    obtain ⟨x,hx⟩ := (K).mkQ_surjective z.1
    refine ⟨⟨φ 1 • x, by
      change φ 1 • (φ 1 • x) = _
      rw [← mul_smul, (boundary_one_idem φ).eq]⟩, Subtype.ext ?_⟩
    change (K).mkQ (φ 1 • x) = z.1
    rw [map_smul, hx]
    exact z.2

variable (𝒜 : ℤ → Submodule k A) [GradedAlgebra 𝒜]
  (ℳ : ℤ → Submodule k M) [Decomposition ℳ] [SetLike.GradedSMul 𝒜 ℳ]

omit [IsScalarTower k A M] in
/-- The kernel defining the unique simple quotient is homogeneous at a
degree-zero boundary. -/
theorem cornerKernel_isHomogeneous (he : e ∈ 𝒜 0) : (cornerKernel e M).IsHomogeneous ℳ := by
  intro d x hx a
  induction a using Decomposition.inductionOn 𝒜 with
  | zero => simp
  | add a b ha hb => simp [add_smul, smul_add, ha, hb]
  | @homogeneous i a =>
    have h := congrArg (fun y : M => (decompose ℳ y (i+d) : M)) (hx (a : A))
    rw [decompose_smul_of_mem_left 𝒜 ℳ he, sub_zero, decompose_smul_of_mem_left 𝒜 ℳ a.2,
      add_sub_cancel_left] at h
    simpa using h

omit [GradedAlgebra 𝒜] [Decomposition ℳ] in
/-- The corner isomorphism with the head identifies each homogeneous
component, with the grading induced on both sides. -/
theorem cornerHeadFixedEquiv_mem_iff (he : φ 1 ∈ 𝒜 0) (d : ℤ) (x : F) :
    cornerHeadFixedEquiv M φ x ∈ boundaryGrading φ (M ⧸ K) (quotGradingA ℳ K) d ↔
      x ∈ boundaryGrading φ M ℳ d := by
  change (K).mkQ x.1 ∈ (ℳ d).map ((K).mkQ.restrictScalars k) ↔ x.1 ∈ ℳ d
  constructor
  · rintro ⟨y,hy,hyx⟩
    let z : F := ⟨φ 1 • y,by
      change φ 1 • (φ 1 • y) = _
      rw [← mul_smul,(boundary_one_idem φ).eq]⟩
    have heq : z=x := by
      apply (cornerHeadFixedEquiv M φ).injective
      apply Subtype.ext
      change (K).mkQ (φ 1 • y) = (K).mkQ x.1
      change (K).mkQ y = (K).mkQ x.1 at hyx
      rw [map_smul,hyx,← map_smul,show φ 1 • x.1 = x.1 from x.2]
    have hz := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := ℳ) he hy
    change z.1 ∈ ℳ (0+d) at hz
    simpa only [heq,zero_add] using hz
  · intro hx
    exact ⟨x.1,hx,rfl⟩

/-- The homogeneous simple quotient defines an indecomposable projective
shift class (Webster, Lemma 5.9, used in Theorem 5.8). -/
theorem exists_cornerHeadClass [HasGdim 𝒜] [IsSimpleModule B F]
    (he : φ 1 ∈ 𝒜 0) (hgen : Submodule.span A {x : M | φ 1 • x = x} = ⊤) :
    ∃ (s : IndecClass 𝒜) (d : ℤ),
      Nonempty (quotGradingA ℳ K ≃ᵍ[A] Graded.shift s.top.grading d) := by
  let := quotDecompositionA ℳ K (cornerKernel_isHomogeneous (φ 1) M 𝒜 ℳ he)
  let := (eq_cornerKernel_iff_simpleQuotient M φ hgen K).mp rfl
  exact IndecClass.exists_gradedEquiv_top_shift
    (show IsGradedSimple 𝒜 (quotGradingA ℳ K) from
      ⟨IsSimpleModule.nontrivial A _, fun P _ => IsSimpleOrder.eq_bot_or_eq_top P⟩)

end Categorification.Stendhal
