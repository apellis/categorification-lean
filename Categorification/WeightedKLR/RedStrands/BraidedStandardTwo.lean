import Categorification.WeightedKLR.RedStrands.BraidedViolatedPush
import Categorification.WeightedKLR.RedStrands.BraidedViolatedQuotient

set_option backward.isDefEq.respectTransparency false

/-!
# A red strand at the left edge followed by a black strand

Let `e(t')` be an idempotent whose leftmost strand is red, labelled `λ_r`, and whose second
strand is black, and let `e(s)` be an idempotent in which every black strand lies to the left of
the red strand `λ_r`. Then every element `e(s) w e(t')` of the braided Stendhal algebra lies in
the ideal generated by violated idempotents: in any diagram from `t'` to `s`, the black strand
at position `1` crosses the red strand `λ_r`, and the crossing can be performed first, producing
a violated idempotent at the bottom.

This is the well-definedness step of B. Webster, *Knot invariants and higher representation
theory*, arXiv:1309.3796v2, Proposition 6.9, for two red strands: multiplication by the braiding
diagram kills the generators of the submodule `U_t` that defines the standard module `S_t`.

## Main results

* `BraidedStendhalAlgebra.e_mul_mul_e_mem_violIdeal` : `e(s) w e(t')` lies in the violated
  ideal.
-/

namespace Categorification.Stendhal

open KLR TypeA Equiv MvPolynomial

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)

namespace BraidedStendhalAlgebra

open Classical in
/-- The frame performing the crossing of the strands at positions `0` and `1`, if `τ` inverts
them, and `1` otherwise. -/
noncomputable def edgeFrame (h1 : 1 < m) (τ : Perm (Fin m)) : Perm (Fin m) :=
  if ((⟨0, by omega⟩ : Fin m), (⟨1, h1⟩ : Fin m)) ∈ invSet m τ then sadj m 0 else 1

omit [DecidableEq I] in
theorem edgeFrame_le (h1 : 1 < m) (τ : Perm (Fin m)) :
    invSet m (edgeFrame h1 τ) ⊆ invSet m τ := by
  unfold edgeFrame
  split_ifs with h
  · have hs := invSet_sadj_mul_of_lt (k := 0) h1 (w := 1)
      (by simp [Fin.lt_def])
    rw [mul_one] at hs
    rw [hs]
    intro p hp
    rcases Finset.mem_insert.1 hp with rfl | hp
    · simpa using h
    · exact invSet_one_subset τ hp
  · exact invSet_one_subset τ

variable {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : IsReducedChoice ρ) (hQ : KLRSymm Q)

include hρ hQ in
/-- **A black strand crossing a red strand at the left edge.** If the leftmost strand of `t'` is
the red strand `λ_r`, its second strand is black, and every black strand of `s` lies left of
`λ_r`, then `e(s) w e(t')` lies in the ideal generated by violated idempotents. -/
theorem e_mul_mul_e_mem_violIdeal {s t' : Seq μ} {r : Fin ℓ} (h1 : 1 < m)
    (h0 : t'.lbl ⟨0, by omega⟩ = .inr r) (hb : (t'.lbl ⟨1, h1⟩).isLeft)
    (hs : ∀ a p, (s.lbl a).isLeft → s.lbl p = .inr r → a < p)
    (w : BraidedStendhalAlgebra k Q Λ ν) :
    ofKLR k Q Λ ν (KLRAlgebra.e s) * w * ofKLR k Q Λ ν (KLRAlgebra.e t') ∈
      violIdeal k Q Λ ν := by
  set ρ' := fun τ => ρ (τ * (edgeFrame h1 τ)⁻¹) ++ ρ (edgeFrame h1 τ)
  have hρ' : IsReducedChoice ρ' := isReducedChoice_frame hρ _ (edgeFrame_le h1)
  induction (basis hQ ρ' hρ').mem_span w using Submodule.span_induction with
  | zero => rw [mul_zero, zero_mul]; exact zero_mem _
  | add x y _ _ hx hy => rw [mul_add, add_mul]; exact add_mem hx hy
  | smul c x _ hx =>
    rw [mul_smul_comm, smul_mul_assoc, Algebra.smul_def]
    exact TwoSidedIdeal.mul_mem_left _ _ _ hx
  | mem x hx =>
    obtain ⟨⟨⟨j, τ, u⟩, hu⟩, rfl⟩ := hx
    rw [basis_apply, ← map_mul, ← map_mul]
    dsimp only
    rw [mul_assoc (KLRAlgebra.e s), mul_assoc (_ * _) (KLRAlgebra.e j), KLRAlgebra.e_mul_e]
    split_ifs with hj
    swap
    · rw [mul_zero, mul_zero, map_zero]; exact zero_mem _
    subst hj
    have hy := e_mul_std (Q := Q) (Λ := Λ) (ρ' τ) (monomial u 1) j
    rw [(hρ' τ).2] at hy
    rw [← hy, ← mul_assoc, KLRAlgebra.e_mul_e]
    split_ifs with hτ
    swap
    · rw [zero_mul, map_zero]; exact zero_mem _
    rw [map_mul]
    refine TwoSidedIdeal.mul_mem_left _ _ _ ?_
    have h0' : (⟨0, by omega⟩ : Fin m) < ⟨1, h1⟩ := by simp [Fin.lt_def]
    have hinv : ((⟨0, by omega⟩ : Fin m), (⟨1, h1⟩ : Fin m)) ∈ invSet m τ := by
      rw [mem_invSet_pair]
      refine ⟨h0', hs _ _ ?_ ?_⟩
      · rw [hτ, lbl_smul]; simpa using hb
      · rw [hτ, lbl_smul]; simpa using h0
    have hv : edgeFrame h1 τ = sadj m 0 := by simp [edgeFrame, hinv]
    have hviol : IsViolated (sadj m 0 • j) := by
      refine ⟨by omega, ?_⟩
      rw [lbl_smul, sadj_inv]
      convert hb using 3
      exact sadj_apply_left h1
    have hz := e_mul_std (Q := Q) (Λ := Λ) (ρ (sadj m 0)) (monomial u 1) j
    rw [(hρ (sadj m 0)).2] at hz
    have hρτ : ρ' τ = ρ (τ * (sadj m 0)⁻¹) ++ ρ (sadj m 0) := by simp only [ρ', hv]
    rw [hρτ, KLRAlgebra.ψw_append, mul_assoc (KLRAlgebra.ψw _), mul_assoc (KLRAlgebra.ψw _),
      ← hz, ← mul_assoc, map_mul, map_mul]
    exact TwoSidedIdeal.mul_mem_right _ _ _
      (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span ⟨_, hviol, rfl⟩))

end BraidedStendhalAlgebra

end Categorification.Stendhal
