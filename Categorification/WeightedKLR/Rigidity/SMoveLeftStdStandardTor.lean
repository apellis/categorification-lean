import Categorification.WeightedKLR.Rigidity.SMoveLeftStdUpperIdem
import Categorification.WeightedKLR.Rigidity.SMoveRouquierRoute

/-!
# No higher Tor of the S-move coefficient against the diagonal standard

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.3, proof
of Proposition 7.22, gap (c), step R5 (higher Tor of the diagonal pair). Let `s` be a loading of
the three red strands with every black strand left of the last red strand (on the diagonal,
`s = (red₁ red₂ 𝐮 red₃)`), and `W = 𝕊^{λ_1; λ_2, λ_3}(P_∅ ⊠ N)` (`SMove.leftStd`) for any
module `N` over `T^{λ_2, λ_3}(ν)`. Then `Tor_n(W^r, S_s) = 0` for `n ≠ 0`.

The standard `S_s` has a projective resolution whose terms in positive homological degree are
generated by loading projectives `T e(t)` with `t > s` (the ordered covers of the left
standards, Webster v3, Corollary 5.21, as in the proof of Lemma 6.12, step `f_n → s_n`:
`OrderedStandardCovers.projectiveResolution_loading_support`), and `W^r` is killed by every
`e(t)` with `t > s` (`SMove.op_seqIdem_smul_reflectOne_leftStd_eq_zero_of_stendhalLT`). So the
tensor of `W^r` with every positive term vanishes
(`isZero_derivedTensorHomology_of_projectiveResolution_loading_support`).

This holds for every `N`, with no finiteness hypothesis; in particular it discharges the route
hypothesis `hfree` of
`SMove.isZero_derivedTensorHomology_reflectOne_leftStd_stdLayer_of_free`, and makes that
dimension shift unnecessary.

Route hypothesis: a Rouquier choice of `Q` (for the ordered covers `rouquierStandardCovers`).
The three red labels are indexed by `Fin (1 + 1 + 1)` through `Λ ∘ Fin.cast (Nat.add_assoc 1 1 1)`,
the form of `SMove.exists_stdSum_isZero_derivedTensorHomology_reflect_leftStd_rightStd`.

## Main results

* `SMove.isZero_derivedTensorHomology_reflectOne_leftStd_leftStandard`.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal.SMove

open CategoryTheory CategoryTheory.Limits KLR Equiv MulOpposite BraidedStendhalAlgebra
open DG DG.DerivedCategory
open scoped DG.DegreeZero

universe w


variable {I k : Type} [DecidableEq I] [Field k] (Q : I → I → MvPolynomial (Fin 2) k)
  (hQ : KLRSymm Q) (Λ : Fin (1 + (1 + 1)) → I →₀ ℕ) {ν : Multiset I}
  {ρ : Perm (Fin (Multiset.card (stendhalWeight (1 + 1 + 1) ν))) → List ℕ}
  (hρ : TypeA.IsReducedChoice ρ)
  [HasDerivedCategory.{w, 0} (TensorProductAlgebra k Q (Λ ∘ Fin.cast (Nat.add_assoc 1 1 1)) ν)]
  [HasDerivedCategory.{w, 0} ℤ]

local notation "Λ₃" => (Λ ∘ Fin.cast (Nat.add_assoc 1 1 1) : Fin (1 + 1 + 1) → I →₀ ℕ)

include hρ in
/-- **No higher Tor of the S-move coefficient against the diagonal standard** (Webster,
arXiv:1309.3796v3, §7.3, proof of Proposition 7.22, gap (c), step R5): for every module `N`
over `T^{λ_2, λ_3}(ν)` and every loading `s` with all black strands left of the last red
strand, `Tor_n^ℤ((SMove.leftStd N)^r, S_s) = 0` for `n ≠ 0`.

Route hypothesis: a Rouquier choice of `Q` (ordered covers of the left standards). -/
theorem isZero_derivedTensorHomology_reflectOne_leftStd_leftStandard
    {C : QuantumGroup.CartanDatum I} (hR : IsRouquierQ C Q)
    (N : ModuleCat.{0} (TensorProductAlgebra k Q (Λ ∘ Fin.natAdd 1) ν))
    (s : Seq (stendhalWeight (1 + 1 + 1) ν)) (hs : IsRedOrdered s)
    (hlast : ∀ i, blackCount s (Fin.last 2) i = ν.count i) (m : ℤ) (hm : m ≠ 0) :
    IsZero ((homologyFunctor (A := ℤ) ℤ m).obj
      ((derivedTensor.{w} ℤ (TensorProductAlgebra k Q Λ₃ ν)
        ((reflectOne Q Λ₃ hQ hρ).obj ((leftStd Q hQ Λ ν).obj N))).obj
        (DG.DerivedCategory.Q.obj ((degreeZeroModuleFunctor _).obj
          (ModuleCat.of (TensorProductAlgebra k Q Λ₃ ν) (leftStandard Q Λ₃ s hs)))))) := by
  let D := rouquierStandardCovers hR hQ Λ₃ ν
  have htrans : ∀ a b c : {s : Seq (stendhalWeight (1 + 1 + 1) ν) // IsRedOrdered s},
      StendhalLT a.1 b.1 → StendhalLT b.1 c.1 → StendhalLT a.1 c.1 :=
    fun _ _ _ hab hbc => ⟨fun r i => (hab.1 r i).trans (hbc.1 r i), fun hca =>
      hab.2 (fun r i => (hbc.1 r i).trans (hca r i))⟩
  have he : ∀ d : {s : Seq (stendhalWeight (1 + 1 + 1) ν) // IsRedOrdered s},
      IsIdempotentElem (seqIdem Q Λ₃ d.1 d.2) := fun d => seqIdem_mul_self Q Λ₃ d.1 d.2
  have hsupp := fun n : ℕ => D.projectiveResolution_loading_support ⟨s, hs⟩ htrans n
  have hkill : ∀ d : {s : Seq (stendhalWeight (1 + 1 + 1) ν) // IsRedOrdered s},
      StendhalLT s d.1 → ∀ x : (reflectOne Q Λ₃ hQ hρ).obj ((leftStd Q hQ Λ ν).obj N),
        op (seqIdem Q Λ₃ d.1 d.2) • x = 0 := fun d hd x =>
    op_seqIdem_smul_reflectOne_leftStd_eq_zero_of_stendhalLT Q hQ Λ ν hρ N s hlast
      d.1 d.2 hd x
  have key := isZero_derivedTensorHomology_of_projectiveResolution_loading_support
    (A := ℤ) (B := TensorProductAlgebra k Q Λ₃ ν)
    (M := (reflectOne Q Λ₃ hQ hρ).obj ((leftStd Q hQ Λ ν).obj N))
    (ι := {s : Seq (stendhalWeight (1 + 1 + 1) ν) // IsRedOrdered s})
    (D.projectiveResolution ⟨s, hs⟩) (fun d => seqIdem Q Λ₃ d.1 d.2)
    (fun d => StendhalLT s d.1) he hsupp hkill m hm
  exact key

end Categorification.Stendhal.SMove
