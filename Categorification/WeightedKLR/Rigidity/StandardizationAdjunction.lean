import Categorification.WeightedKLR.RedStrands.LastRedStandardCut
import Categorification.WeightedKLR.RedStrands.ParabolicStandardUnitExt

/-!
# Standardization is left adjoint to restriction to a last-red layer

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §5,
Definition 5.4, used in §7.1, proof of Proposition 7.8. Fix a split `θ + β` of the black
strands: `θ` left and `β` right of the last red strand. Let `J` be the two-sided ideal of
`T^λ_{θ+β}` generated by the loadings with fewer black strands right of the last red strand.
A `T^λ`-module `Z` killed by `J` is a module over `T^λ / J`, and the fixed vectors of the
layer idempotent of the split form a module `R(Z)` over the factor algebra
`T^{λ'}_θ ⊗ R^{λ_ℓ}_β` (`levelRestriction`).

## Main results

* `levelDesc`: a map of factor modules `N → R(Z)` extends uniquely to a `T^λ`-linear map
  `S(N) → Z` from the standardization.
* `levelHomEquiv`: the adjunction `Hom_{T^λ}(S(N), Z) ≃ Hom(N, R(Z))`.
* `levelUnitEquiv`: the unit `N ≃ R(S(N))` is an isomorphism.
* `killedByLevel_parabolicStandardT`: standardizations are killed by `J`.
-/

noncomputable section
namespace Categorification.Stendhal

open KLR KLRAlgebra
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ) (θ β : Multiset I)

/-- The split of the black strands of `θ + β` with `θ` left of the last red strand. -/
abbrev levelSplit : LastRedWeightSplit (θ + β) := ⟨(θ, β), rfl⟩

local notation "T" => TensorProductAlgebra k Q Λ (θ + β)
local notation "D" => parabolicFactorAlgebra Q Λ θ β
local notation "P" => LastRedWeightSplit.position (θ + β) (levelSplit θ β) ℓ
local notation "HW" => LastRedWeightSplit.content (θ + β) (levelSplit θ β) ℓ
local notation "HL" => LastRedWeightSplit.length (θ + β) (levelSplit θ β) ℓ
local notation "Jl" => smallerSuffixIdeal Q Λ P
local notation "Cq" => RingCon.Quotient (TwoSidedIdeal.ringCon (smallerSuffixIdeal Q Λ P))
local notation "ψ" => lastRedLayerAction Q Λ P HW HL
local notation "S" => stendhalQ Q Λ
local notation "α" => Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ)
local notation "δ" => Multiset.map (Sum.map (id : I → I) (fun _ : Fin 1 => Fin.last ℓ))
  (stendhalWeight 1 β)

/-- The affine diagram of a parabolic diagram becomes the layer action of its factor
projection modulo `J`. -/
theorem mk_parabolicAffine_concat (t : TensorKLR S α δ) :
    (Jl).ringCon.mkₐ k (parabolicAffine Q Λ θ β (concat S α δ t)) =
      ψ (parabolicInputMap Q Λ θ β t) :=
  suffixConcat_eq_lastRedLayerAction Q Λ P HW HL (parabolicInputWeights_add (ℓ := ℓ) θ β) t

/-- Every element of the layer action is the class of a parabolic affine diagram projecting
to it. -/
theorem exists_parabolicAffine_layer (z : D) :
    ∃ t : TensorKLR S α δ, parabolicInputMap Q Λ θ β t = z ∧
      (Jl).ringCon.mkₐ k (parabolicAffine Q Λ θ β (concat S α δ t)) = ψ z := by
  obtain ⟨t, ht, _⟩ := lastRedLayerAction_exists_parabolicLift Q Λ P HW HL
    (parabolicInputWeights_add (ℓ := ℓ) θ β) z
  exact ⟨t, ht, (mk_parabolicAffine_concat Q Λ θ β t).trans (congrArg _ ht)⟩

section Module

variable (Z : Type) [AddCommGroup Z] [Module k Z] [Module (TensorProductAlgebra k Q Λ (θ + β)) Z]
  [IsScalarTower k (TensorProductAlgebra k Q Λ (θ + β)) Z]

/-- `Z` is killed by the ideal `J` of loadings with a shorter black suffix. -/
def KilledByLevel : Prop := ∀ x ∈ Jl, ∀ z : Z, x • z = 0

variable {Q Λ θ β Z} (hZ : KilledByLevel Q Λ θ β Z)

/-- The action of `T^λ / J` on a module killed by `J`. -/
def levelAction : Cq →ₐ[k] Module.End k Z := by
  apply (Jl).ringCon.liftₐ (Algebra.lsmul k k Z)
  apply (TwoSidedIdeal.ringCon_le_iff
    (J := TwoSidedIdeal.ker (Algebra.lsmul k k Z : T →ₐ[k] Module.End k Z).toRingHom)).mp
  intro x hx
  exact (TwoSidedIdeal.mem_ker _).mpr (LinearMap.ext fun z => hZ x hx z)

theorem levelAction_mk (x : T) (z : Z) : levelAction hZ ((Jl).ringCon.mkₐ k x) z = x • z := rfl

/-- `Z` as a module over `T^λ / J`. -/
@[nolint unusedArguments]
def LevelModule (_hZ : KilledByLevel Q Λ θ β Z) : Type := Z

instance : AddCommGroup (LevelModule hZ) := inferInstanceAs (AddCommGroup Z)
instance : Module k (LevelModule hZ) := inferInstanceAs (Module k Z)
instance : Module Cq (LevelModule hZ) := Module.compHom Z (levelAction hZ).toRingHom
instance : IsScalarTower k Cq (LevelModule hZ) where
  smul_assoc c a z := by
    change levelAction hZ (c • a) (show Z from z) = c • levelAction hZ a (show Z from z)
    rw [map_smul]
    rfl

/-- **The restriction `R(Z)`**: the fixed vectors of the layer idempotent, a module over the
factor algebra `T^{λ'}_θ ⊗ R^{λ_ℓ}_β`. -/
abbrev levelRestriction := boundaryFixed ψ (LevelModule hZ)

/-- The vector of `Z` underlying an element of `R(Z)`. -/
def levelVal (x : levelRestriction hZ) : Z := x.1

theorem levelVal_injective : Function.Injective (levelVal hZ) := fun _ _ h => Subtype.ext h

theorem levelVal_add (x y : levelRestriction hZ) :
    levelVal hZ (x + y) = levelVal hZ x + levelVal hZ y := rfl

theorem levelVal_fixed (x : levelRestriction hZ) :
    levelAction hZ (ψ 1) (levelVal hZ x) = levelVal hZ x := x.2

theorem levelRestriction_smul_val (z : D) (x : levelRestriction hZ) :
    levelVal hZ (z • x) = levelAction hZ (ψ z) (levelVal hZ x) := rfl

end Module

section Adjunction

variable (hQ : KLRSymm Q)
variable {N : Type} [AddCommGroup N] [Module k N] [Module (parabolicFactorAlgebra Q Λ θ β) N]
  [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N]
variable {Z : Type} [AddCommGroup Z] [Module k Z] [Module (TensorProductAlgebra k Q Λ (θ + β)) Z]
  [IsScalarTower k (TensorProductAlgebra k Q Λ (θ + β)) Z]
  (hZ : KilledByLevel Q Λ θ β Z)

/-- The parabolic action of an affine diagram on the unit vectors of the standardization. -/
theorem parabolicAffine_smul_unit (t : TensorKLR S α δ) (n : N) :
    parabolicAffine Q Λ θ β (concat S α δ t) • parabolicStandardTUnit Q Λ θ β hQ n =
      parabolicStandardTUnit Q Λ θ β hQ (parabolicInputMap Q Λ θ β t • n) :=
  parabolicStandardAction_concat_unit Q Λ θ β N hQ t n

/-- The input map of the extension: `n ↦ φ(n) ∈ Z`. -/
def levelDescInput (φ : N →ₗ[D] levelRestriction hZ) : ParabolicInput Q Λ θ β N →ₗ[k] Z where
  toFun n := levelVal hZ (φ n)
  map_add' x y := (congrArg (levelVal hZ) (map_add φ (x : N) (y : N))).trans
    (levelVal_add hZ _ _)
  map_smul' c x := congrArg (levelVal hZ) ((φ.restrictScalars k).map_smul c (x : N))

theorem levelDescInput_compat (φ : N →ₗ[D] levelRestriction hZ) (t : TensorKLR S α δ)
    (n : ParabolicInput Q Λ θ β N) :
    levelDescInput Q Λ θ β hZ φ (t • n) =
      (Algebra.lsmul k k Z : T →ₐ[k] Module.End k Z)
        (parabolicAffine Q Λ θ β (concat S α δ t)) (levelDescInput Q Λ θ β hZ φ n) := by
  change levelVal hZ (φ (parabolicInputMap Q Λ θ β t • (n : N))) = _
  refine (congrArg (levelVal hZ) (φ.map_smul _ (n : N))).trans ?_
  rw [levelRestriction_smul_val, ← mk_parabolicAffine_concat]
  rfl

/-- **The extension `S(N) → Z`** of a map `N → R(Z)` of factor modules. -/
def levelDesc (φ : N →ₗ[D] levelRestriction hZ) : ParabolicStandardT Q Λ θ β N hQ →ₗ[T] Z where
  toFun := parabolicDesc Q Λ θ β (Algebra.lsmul k k Z) (levelDescInput Q Λ θ β hZ φ)
    (levelDescInput_compat Q Λ θ β hZ φ)
  map_add' := map_add _
  map_smul' t m := parabolicDesc_smul Q Λ θ β hQ _ _ _ t m

theorem levelDesc_unit (φ : N →ₗ[D] levelRestriction hZ) (n : N) :
    levelDesc Q Λ θ β hQ hZ φ (parabolicStandardTUnit Q Λ θ β hQ n) = levelVal hZ (φ n) :=
  parabolicDesc_unit Q Λ θ β (Algebra.lsmul k k Z) _ _ n

/-- A `T^λ`-linear map sends the layer action on unit vectors to the layer action. -/
theorem layer_smul_map_unit (f : ParabolicStandardT Q Λ θ β N hQ →ₗ[T] Z) (z : D) (n : N) :
    levelAction hZ (ψ z) (f (parabolicStandardTUnit Q Λ θ β hQ n)) =
      f (parabolicStandardTUnit Q Λ θ β hQ (z • n)) := by
  obtain ⟨t, rfl, ht⟩ := exists_parabolicAffine_layer Q Λ θ β z
  rw [← ht, levelAction_mk, ← map_smul, parabolicAffine_smul_unit]

/-- The restriction of a map out of `S(N)` to the unit vectors, a map `N → R(Z)`. -/
def levelUnitRestrict (f : ParabolicStandardT Q Λ θ β N hQ →ₗ[T] Z) :
    N →ₗ[D] levelRestriction hZ where
  toFun n := ⟨f (parabolicStandardTUnit Q Λ θ β hQ n), by
    change levelAction hZ (ψ 1) _ = _
    rw [layer_smul_map_unit, one_smul]⟩
  map_add' x y := levelVal_injective hZ (by
    change f _ = f _ + f _
    rw [parabolicStandardTUnit_add, map_add])
  map_smul' z n := levelVal_injective hZ (layer_smul_map_unit Q Λ θ β hQ hZ f z n).symm

/-- **Standardization is left adjoint to restriction**:
`Hom_{T^λ}(S(N), Z) ≃ Hom(N, R(Z))` for `Z` killed by `J`. -/
def levelHomEquiv :
    (ParabolicStandardT Q Λ θ β N hQ →ₗ[T] Z) ≃ (N →ₗ[D] levelRestriction hZ) where
  toFun := levelUnitRestrict Q Λ θ β hQ hZ
  invFun := levelDesc Q Λ θ β hQ hZ
  left_inv _ := parabolicStandardT_ext Q Λ θ β hQ fun n => levelDesc_unit Q Λ θ β hQ hZ _ n
  right_inv φ := LinearMap.ext fun n => levelVal_injective hZ (levelDesc_unit Q Λ θ β hQ hZ φ n)

end Adjunction

section Unit

variable (hQ : KLRSymm Q)
variable (N : Type) [AddCommGroup N] [Module k N] [Module (parabolicFactorAlgebra Q Λ θ β) N]
  [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N]

instance : IsScalarTower k T (ParabolicStandardT Q Λ θ β N hQ) where
  smul_assoc c t m := by
    change parabolicStandardAction Q Λ θ β N hQ (c • t) m =
      c • parabolicStandardAction Q Λ θ β N hQ t m
    rw [map_smul]
    rfl

/-- **Standardizations are killed by `J`.** -/
theorem killedByLevel_parabolicStandardT :
    KilledByLevel Q Λ θ β (ParabolicStandardT Q Λ θ β N hQ) := by
  intro x hx m
  have hp : (P).val = (Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ)).card := by
    simp [LastRedWeightSplit.position, stendhalWeight]
  have h0 : (Jl).ringCon.mkₐ k x = 0 := by
    rw [← map_zero ((Jl).ringCon.mkₐ k)]
    exact (RingCon.eq _).mpr ((TwoSidedIdeal.mem_iff _ _).mp hx)
  have h := congrArg (fun a => parabolicStandardLayerAction Q Λ θ β N hQ P hp a m) h0
  change parabolicStandardAction Q Λ θ β N hQ x m = 0
  rw [← parabolicStandardLayerAction_comp Q Λ θ β N hQ P hp]
  exact h.trans (by rw [map_zero]; rfl)

/-- **The unit `N ≃ R(S(N))` is an isomorphism**: the unit vectors are exactly the fixed vectors
of the layer idempotent (Webster, arXiv:1309.3796v3, §5, the identity-shuffle embedding). -/

def levelUnitEquiv :
    N ≃ₗ[D] levelRestriction (killedByLevel_parabolicStandardT Q Λ θ β hQ N) := by
  refine LinearEquiv.ofBijective
    (levelUnitRestrict Q Λ θ β hQ (killedByLevel_parabolicStandardT Q Λ θ β hQ N) LinearMap.id)
    ⟨fun a b h => parabolicStandardUnit_injective Q Λ θ β N hQ
      (congrArg (levelVal (killedByLevel_parabolicStandardT Q Λ θ β hQ N)) h), ?_⟩
  intro z
  obtain ⟨t, ht1, ht⟩ := exists_parabolicAffine_layer Q Λ θ β (1 : D)
  let hK := killedByLevel_parabolicStandardT Q Λ θ β hQ N
  have hz : levelVal hK z = parabolicAffine Q Λ θ β (concat S α δ t) •
      (levelVal hK z : ParabolicStandardT Q Λ θ β N hQ) := by
    conv_lhs => rw [← levelVal_fixed hK z]
    rw [← ht, levelAction_mk]
  let w : ParabolicStandardT Q Λ θ β N hQ := levelVal hK z
  obtain ⟨n, hn⟩ := parabolicStandardAction_concat_mem_range Q Λ θ β N hQ t w
  exact ⟨n, levelVal_injective hK (hn.trans hz.symm)⟩

end Unit

end Categorification.Stendhal
