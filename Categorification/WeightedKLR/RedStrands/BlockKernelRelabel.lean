/-!
# Relabelling retained block kernels

Webster, arXiv:1309.3796v2, proof of Lemma 6.8 at (6.21).
Red relabelling preserves retained roots and the higher ideals, and it carries
the actual kernel and partial-standard modules across the induced corner
ring equivalence.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR Equiv

variable {I : Type*} [DecidableEq I] {ℓ : ℕ} {ν : Multiset I}
local notation "μ" => stendhalWeight ℓ ν
local notation "n" => Multiset.card μ

/-- Relabelling red strands leaves the position count at the relabelled block unchanged. -/
theorem blockBlackCount_redPerm (σ : Perm (Fin ℓ)) (s : Seq μ) (C : Finset (Fin ℓ)) (i : I) :
    blockBlackCount (Seq.redPerm σ s) (C.map σ.toEmbedding) i = blockBlackCount s C i := by
  unfold blockBlackCount
  congr 1
  ext x
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  have hb (x : Fin n) : (Seq.redPerm σ s).lbl x = .inl i ↔ s.lbl x = .inl i := by
    cases h : s.lbl x <;> simp [h]
  have hr (x : Fin n) (r : Fin ℓ) :
      (Seq.redPerm σ s).lbl x = .inr (σ r) ↔ s.lbl x = .inr r := by
    cases h : s.lbl x <;> simp [h, σ.injective.eq_iff]
  refine and_congr (hb x) ?_
  constructor
  · intro h y r hC hy
    exact h y (σ r) (Finset.mem_map.2 ⟨r, hC, rfl⟩) ((hr y r).2 hy)
  · intro h y r hrC hy
    obtain ⟨q, hq, rfl⟩ := Finset.mem_map.1 hrC
    exact h y q hq ((hr y q).1 hy)

/-- The retained root function is equivariant under an arbitrary red relabelling. -/
theorem adjacentBlockRoot_redPerm (σ : Perm (Fin ℓ)) (s : Seq μ) (a b r : Fin ℓ) (i : I) :
    adjacentBlockRoot (σ a) (σ b) (Seq.redPerm σ s) (σ r) i =
      adjacentBlockRoot a b s r i := by
  simp only [adjacentBlockRoot, σ.injective.eq_iff]
  split_ifs
  · simpa using blockBlackCount_redPerm σ s {a, b} i
  · simpa using blockBlackCount_redPerm σ s {r} i

/-- Relabelling red strands preserves strict retained-boundary order. -/
theorem adjacentBlockRoot_redPerm_lt_iff (σ : Perm (Fin ℓ)) (s t : Seq μ) (a b : Fin ℓ) :
    adjacentBlockRoot (σ a) (σ b) (Seq.redPerm σ s) <
        adjacentBlockRoot (σ a) (σ b) (Seq.redPerm σ t) ↔
      adjacentBlockRoot a b s < adjacentBlockRoot a b t := by
  have hle (s t : Seq μ) :
      adjacentBlockRoot (σ a) (σ b) (Seq.redPerm σ s) ≤
          adjacentBlockRoot (σ a) (σ b) (Seq.redPerm σ t) ↔
        adjacentBlockRoot a b s ≤ adjacentBlockRoot a b t := by
    constructor
    · intro h r i
      simpa only [adjacentBlockRoot_redPerm] using h (σ r) i
    · intro h r i
      obtain ⟨r, rfl⟩ := σ.surjective r
      simpa only [adjacentBlockRoot_redPerm] using h r i
  simp only [lt_iff_le_not_ge, hle]

end Categorification.Stendhal

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR Equiv

variable {I k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ} {ν : Multiset I}
variable (Q : I → I → MvPolynomial (Fin 2) k) {Λ Λ' : Fin ℓ → I →₀ ℕ}
variable (σ : Perm (Fin ℓ)) (h : ∀ r, Λ' r = Λ (σ r))
local notation "μ" => stendhalWeight ℓ ν

/-- Relabelling a red cut identifies the ideals generated by the strictly
higher loadings on the two sides. -/
theorem violRedPermEquiv_mem_blockUpperIdeal_iff
    (a b : Fin ℓ) (s : Seq μ) (κ : List (Fin ℓ)) (x : ViolQuotient k Q Λ' ν) :
    violRedPermEquiv σ h x ∈ blockUpperIdeal k Q Λ ν (σ a) (σ b)
        (adjacentBlockRoot (σ a) (σ b) (Seq.redPerm σ s)) (κ.map σ) ↔
      x ∈ blockUpperIdeal k Q Λ' ν a b (adjacentBlockRoot a b s) κ := by
  let f := violRedPermEquiv (k := k) (Q := Q) (ν := ν) σ h
  let J := blockUpperIdeal k Q Λ' ν a b (adjacentBlockRoot a b s) κ
  let J' := blockUpperIdeal k Q Λ ν (σ a) (σ b)
    (adjacentBlockRoot (σ a) (σ b) (Seq.redPerm σ s)) (κ.map σ)
  have he (t : Seq μ) :
      f (violMk k Q Λ' ν (ofKLR k Q Λ' ν (KLRAlgebra.e t))) =
        violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.e (Seq.redPerm σ t))) := by
    rw [violRedPermEquiv_violMk, redPermAlgEquiv_e]
  change f x ∈ J' ↔ x ∈ J
  constructor
  · intro hx
    have hmap : J' ≤ TwoSidedIdeal.comap f.symm J := by
      rw [show J' = blockUpperIdeal k Q Λ ν (σ a) (σ b)
        (adjacentBlockRoot (σ a) (σ b) (Seq.redPerm σ s)) (κ.map σ) from rfl,
        blockUpperIdeal, TwoSidedIdeal.span_le]
      rintro _ ⟨t, ht, hlt, rfl⟩
      obtain ⟨u, rfl⟩ := (Seq.redPermEquiv σ).surjective t
      change redWord (Seq.redPerm σ u) = κ.map σ at ht
      rw [redWord_redPerm, (List.map_injective_iff.2 σ.injective).eq_iff] at ht
      rw [SetLike.mem_coe, TwoSidedIdeal.mem_comap]
      change f.symm (violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.e (Seq.redPerm σ u)))) ∈ J
      rw [← he u, AlgEquiv.symm_apply_apply]
      exact TwoSidedIdeal.subset_span ⟨u, ht,
        (adjacentBlockRoot_redPerm_lt_iff σ s u a b).1 hlt, rfl⟩
    have hx' := hmap hx
    rwa [TwoSidedIdeal.mem_comap, AlgEquiv.symm_apply_apply] at hx'
  · intro hx
    have hmap : J ≤ TwoSidedIdeal.comap f J' := by
      rw [show J = blockUpperIdeal k Q Λ' ν a b (adjacentBlockRoot a b s) κ from rfl,
        blockUpperIdeal, TwoSidedIdeal.span_le]
      rintro _ ⟨t, ht, hlt, rfl⟩
      rw [SetLike.mem_coe, TwoSidedIdeal.mem_comap]
      change f (violMk k Q Λ' ν (ofKLR k Q Λ' ν (KLRAlgebra.e t))) ∈ J'
      rw [he]
      exact TwoSidedIdeal.subset_span ⟨Seq.redPerm σ t, (redWord_redPerm σ t).trans (congrArg (·.map σ) ht),
        (adjacentBlockRoot_redPerm_lt_iff σ s t a b).2 hlt, rfl⟩
    have hx' := hmap hx
    rwa [TwoSidedIdeal.mem_comap] at hx'

end Categorification.Stendhal.BraidedStendhalAlgebra

namespace Categorification

open MulOpposite
attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm
universe u u' v

variable {A : Type u} [Ring A] {B : Type u'} [Ring B]

/-- A ring equivalence carries its regular right module semilinearly. -/
def RingEquiv.rightSemilinear (e : A ≃+* B) :
    A ≃ₛₗ[(RingEquiv.op e : Aᵐᵒᵖ →+* Bᵐᵒᵖ)] B where
  toAddEquiv := e.toAddEquiv
  map_smul' a x := by
    change e (x * a.unop) = e x * e a.unop
    exact map_mul e _ _

/-- A ring equivalence carries the right ideal cut by a loading idempotent to
the right ideal cut by the relabelled idempotent. -/
def RingEquiv.rIdealSemilinear (e : A ≃+* B) {p : A} {q : B} (h : e p = q) :
    rIdeal p ≃ₛₗ[(RingEquiv.op e : Aᵐᵒᵖ →+* Bᵐᵒᵖ)] rIdeal q := by
  let f := RingEquiv.rightSemilinear e
  apply f.ofSubmodules
  ext y
  obtain ⟨x, rfl⟩ := e.surjective y
  constructor
  · rintro ⟨a, ha, he⟩
    have he' : a = x := e.injective he
    subst a
    have hp : p * x = x := mem_rIdeal.1 ha
    apply mem_rIdeal.2
    rw [← h, ← map_mul, hp]
  · intro hx
    refine ⟨x, mem_rIdeal.2 ?_, rfl⟩
    apply e.injective
    rw [map_mul, h, mem_rIdeal.1 hx]

theorem RingEquiv.rIdealSemilinear_val (e : A ≃+* B) {p : A} {q : B} (h : e p = q) (x : rIdeal p) :
    (RingEquiv.rIdealSemilinear e h x).1 = e x.1 := rfl

/-- A semilinear equivalence over a ring equivalence becomes linear after
restricting scalars along the inverse ring map. -/
def LinearEquiv.ofRestrictScalars {M : ModuleCat.{v} A} {N : ModuleCat.{v} B}
    (e : A ≃+* B) (f : M ≃ₛₗ[(e : A →+* B)] N) :
    ((ModuleCat.restrictScalars e.symm.toRingHom).obj M) ≃ₗ[B] N where
  toAddEquiv := f.toAddEquiv
  map_smul' a x := by
    let x' : M := x
    change f (e.symm a • x') = a • f x'
    calc
      _ = e (e.symm a) • f x' := f.map_smulₛₗ _ _
      _ = _ := by rw [e.apply_symm_apply]

end Categorification

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR Equiv MulOpposite
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification
attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

variable {I k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ} {ν : Multiset I}
variable (Q : I → I → MvPolynomial (Fin 2) k) {Λ Λ' : Fin ℓ → I →₀ ℕ}
variable (σ : Perm (Fin ℓ)) (h : ∀ r, Λ' r = Λ (σ r))
local notation "μ" => stendhalWeight ℓ ν

variable (s : KLR.Seq (stendhalWeight ℓ ν)) (κ : List (Fin ℓ)) (hs : redWord s = κ)
local notation "T₀" => IsIdempotentElem.Corner (isIdempotentElem_violMk_redProj k Q Λ' ν κ)
local notation "T₁" => IsIdempotentElem.Corner (isIdempotentElem_violMk_redProj k Q Λ ν (κ.map σ))
local notation "F" => violCornerRedPermEquiv (k := k) (Q := Q) (ν := ν) σ h κ
local notation "φ" => (RingEquiv.op F : T₀ᵐᵒᵖ →+* T₁ᵐᵒᵖ)

omit [DecidableEq I] in
include hs in
private theorem redWord_eq_map_of_relabel : redWord (Seq.redPerm σ s) = κ.map σ :=
  (redWord_redPerm σ s).trans (congrArg (List.map σ) hs)

local notation "s₁" => Seq.redPerm σ s
local notation "hs₁" => redWord_eq_map_of_relabel σ s κ hs
local notation "d₀" => orderedLoadingIdemAt Q Λ' κ s hs
local notation "d₁" => orderedLoadingIdemAt Q Λ (κ.map σ) s₁ hs₁

private theorem relabel_loading_idem : F d₀ = d₁ := by
  apply Subtype.ext
  change violRedPermEquiv σ h (violMk k Q Λ' ν (ofKLR k Q Λ' ν (KLRAlgebra.e s))) =
    violMk k Q Λ ν (ofKLR k Q Λ ν (KLRAlgebra.e s₁))
  rw [violRedPermEquiv_violMk, redPermAlgEquiv_e]

/-- The actual loading projective under red relabelling. -/
def retainedProjectiveRedPermEquiv : rIdeal d₀ ≃ₛₗ[φ] rIdeal d₁ :=
  RingEquiv.rIdealSemilinear F (relabel_loading_idem Q σ h s κ hs)

private theorem mem_blockLoadingKernelAt_iff (a b : Fin ℓ) (x : rIdeal d₀) :
    x ∈ blockLoadingKernelAt Q Λ' s a b κ hs ↔
      x.1.1 ∈ blockUpperIdeal k Q Λ' ν a b (adjacentBlockRoot a b s) κ := by
  subst κ
  rfl

variable (a b : Fin ℓ)
local notation "P" => retainedProjectiveRedPermEquiv Q σ h s κ hs
local notation "K₀" => blockLoadingKernelAt Q Λ' s a b κ hs
local notation "K₁" => blockLoadingKernelAt Q Λ s₁ (σ a) (σ b) (κ.map σ) hs₁

/-- The actual loading kernel is carried to the relabelled loading kernel. -/
theorem blockLoadingKernelAt_map_redPerm :
    (K₀).map (P).toLinearMap = K₁ := by
  have hm (x : rIdeal d₀) : P x ∈ K₁ ↔ x ∈ K₀ := by
    rw [mem_blockLoadingKernelAt_iff, mem_blockLoadingKernelAt_iff]
    have hval : (P x).1.1 = violRedPermEquiv σ h x.1.1 := by
      exact congrArg Subtype.val (RingEquiv.rIdealSemilinear_val F (relabel_loading_idem Q σ h s κ hs) x)
    rw [hval]
    exact violRedPermEquiv_mem_blockUpperIdeal_iff Q σ h a b s κ x.1.1
  ext z
  obtain ⟨x, rfl⟩ := (P).surjective z
  constructor
  · rintro ⟨y, hy, he⟩
    have hxy : y = x := (P).injective he
    subst y
    exact (hm x).2 hy
  · intro hx
    exact ⟨x, (hm x).1 hx, rfl⟩

/-- The higher kernel under relabelling, semilinear over the change of corner. -/
def fixedOrderKernelObj_redPermSemilinearEquiv :
    (fixedOrderKernelObj Q Λ' a b κ ⟨s, hs⟩) ≃ₛₗ[φ]
      fixedOrderKernelObj Q Λ (σ a) (σ b) (κ.map σ) ⟨s₁, hs₁⟩ :=
  (P).ofSubmodules K₀ K₁ (blockLoadingKernelAt_map_redPerm Q σ h s κ hs a b)

/-- The higher kernel under relabelling, over the relabelled corner. -/
def fixedOrderKernelObj_redPermLinearEquiv :
    ((ModuleCat.restrictScalars (RingEquiv.op F).symm.toRingHom).obj
      (fixedOrderKernelObj Q Λ' a b κ ⟨s, hs⟩)) ≃ₗ[T₁ᵐᵒᵖ]
      fixedOrderKernelObj Q Λ (σ a) (σ b) (κ.map σ) ⟨s₁, hs₁⟩ :=
  LinearEquiv.ofRestrictScalars (RingEquiv.op F)
    (fixedOrderKernelObj_redPermSemilinearEquiv Q σ h s κ hs a b)

/-- The actual partial-standard quotient under relabelling. -/
def blockPartialStandardAt_redPermLinearEquiv :
    ((ModuleCat.restrictScalars (RingEquiv.op F).symm.toRingHom).obj
      (blockPartialStandardAt Q Λ' s a b κ hs)) ≃ₗ[T₁ᵐᵒᵖ]
      blockPartialStandardAt Q Λ s₁ (σ a) (σ b) (κ.map σ) hs₁ :=
  by
    let : AddCommGroup (rIdeal d₀) := Submodule.addCommGroup (rIdeal d₀)
    let : AddCommGroup (rIdeal d₁) := Submodule.addCommGroup (rIdeal d₁)
    let : Module T₀ᵐᵒᵖ (rIdeal d₀) := Submodule.module (rIdeal d₀)
    let : Module T₁ᵐᵒᵖ (rIdeal d₁) := Submodule.module (rIdeal d₁)
    let f : rIdeal d₀ ≃ₛₗ[φ] rIdeal d₁ := P
    have hmap : (K₀).map f.toLinearMap = K₁ := blockLoadingKernelAt_map_redPerm Q σ h s κ hs a b
    let e : (↥(rIdeal d₀) ⧸ K₀) ≃ₛₗ[φ] (↥(rIdeal d₁) ⧸ K₁) :=
      Submodule.Quotient.equiv K₀ K₁ f hmap
    exact LinearEquiv.ofRestrictScalars (RingEquiv.op F) e

end Categorification.Stendhal.BraidedStendhalAlgebra

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR Equiv ModuleFiltration MulOpposite
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ} {ν : Multiset I}
variable (Q : I → I → MvPolynomial (Fin 2) k) {Λ Λ' : Fin ℓ → I →₀ ℕ}
variable (σ : Perm (Fin ℓ)) (h : ∀ r, Λ' r = Λ (σ r))
variable (κ : List (Fin ℓ))
local notation "μ" => stendhalWeight ℓ ν
local notation "C₀" => {s : Seq μ // redWord s = κ}
local notation "C₁" => {s : Seq μ // redWord s = κ.map σ}

/-- Relabel an ordered loading at a fixed red word. -/
def redPermOrderedLoading (s : C₀) : C₁ :=
  ⟨Seq.redPerm σ s.1, (redWord_redPerm σ s.1).trans (congrArg (List.map σ) s.2)⟩

include h in
/-- Relabelling transports the actual higher kernel filtration and every
partial-standard layer to the relabelled corner. -/
theorem blockLoadingKernel_hasFiltration_redPerm
    (a b : Fin ℓ) (s : C₀) (tail : List C₀)
    (H : HasFiltration (fun t : C₀ => blockPartialStandardAt Q Λ' t.1 a b κ t.2)
      tail (fixedOrderKernelObj Q Λ' a b κ s)) :
    HasFiltration (fun t : C₁ => blockPartialStandardAt Q Λ t.1 (σ a) (σ b) (κ.map σ) t.2)
      (tail.map (redPermOrderedLoading σ κ))
      (fixedOrderKernelObj Q Λ (σ a) (σ b) (κ.map σ) (redPermOrderedLoading σ κ s)) := by
  let F := RingEquiv.op (violCornerRedPermEquiv (k := k) (Q := Q) (ν := ν) σ h κ)
  have H' := HasFiltration.restrictScalars F.symm.toRingHom H
  let L : C₁ → _ := fun t => blockPartialStandardAt Q Λ t.1 (σ a) (σ b) (κ.map σ) t.2
  have iso (t : C₀) : Nonempty (((ModuleCat.restrictScalars F.symm.toRingHom).obj
      (blockPartialStandardAt Q Λ' t.1 a b κ t.2)) ≃ₗ[_] L (redPermOrderedLoading σ κ t)) :=
    ⟨blockPartialStandardAt_redPermLinearEquiv Q σ h t.1 κ t.2 a b⟩
  have HL := HasFiltration.mapLabels (redPermOrderedLoading σ κ) L iso H'
  exact HL.of_equiv (fixedOrderKernelObj_redPermLinearEquiv Q σ h s.1 κ s.2 a b)

end Categorification.Stendhal.BraidedStendhalAlgebra

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR Equiv

variable {I : Type*} [DecidableEq I] {ℓ : ℕ} {ν : Multiset I}
local notation "μ" => stendhalWeight ℓ ν

omit [DecidableEq I] in
/-- A loading predicate that is preserved by red relabelling can be verified
in the canonical red word. -/
theorem adjacentPairProperty_of_canonical
    (P : (Fin ℓ → I →₀ ℕ) → Fin ℓ → Fin ℓ → (κ : List (Fin ℓ)) →
      {s : Seq μ // redWord s = κ} → Prop)
    (relabel : ∀ (σ : Perm (Fin ℓ)) (Λ : Fin ℓ → I →₀ ℕ)
      (a b : Fin ℓ) (κ : List (Fin ℓ)) (s : {s : Seq μ // redWord s = κ}),
        P (Λ ∘ σ) a b κ s →
          P Λ (σ a) (σ b) (κ.map σ) (redPermOrderedLoading σ κ s))
    (canonical : ∀ (Λ : Fin ℓ → I →₀ ℕ) (a b : Fin ℓ) (L M : List (Fin ℓ)),
      List.finRange ℓ = L ++ a :: b :: M →
      ∀ s : {s : Seq μ // redWord s = List.finRange ℓ}, P Λ a b (List.finRange ℓ) s)
    (Λ : Fin ℓ → I →₀ ℕ) (a b : Fin ℓ) {κ L M : List (Fin ℓ)}
    (hword : κ = L ++ a :: b :: M) (s : {s : Seq μ // redWord s = κ}) :
    P Λ a b κ s := by
  have hp : κ.Perm (List.finRange ℓ) := by
    rw [← s.2]
    exact (List.perm_ext_iff_of_nodup (redWord_nodup _) (List.nodup_finRange _)).2
      fun r => by simp [mem_redWord]
  obtain ⟨σ, rfl⟩ := exists_perm_eq_map_finRange hp
  obtain ⟨a, rfl⟩ := σ.surjective a
  obtain ⟨b, rfl⟩ := σ.surjective b
  obtain ⟨raw, hraw⟩ := s
  obtain ⟨c, hc⟩ := (Seq.redPermEquiv σ).surjective raw
  change Seq.redPerm σ c = raw at hc
  subst raw
  have hinj := (List.map_injective_iff.2 σ.injective)
  have hc : redWord c = List.finRange ℓ :=
    hinj ((redWord_redPerm σ c).symm.trans hraw)
  let L₀ := L.map σ.symm
  let M₀ := M.map σ.symm
  have hcanon : List.finRange ℓ = L₀ ++ a :: b :: M₀ := by
    apply hinj
    rw [hword]
    simp [L₀, M₀, List.map_map, Function.comp_def]
  exact relabel σ Λ a b _ ⟨c, hc⟩ (canonical (Λ ∘ σ) a b L₀ M₀ hcanon ⟨c, hc⟩)

end Categorification.Stendhal.BraidedStendhalAlgebra

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR Equiv ModuleFiltration
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ} {ν : Multiset I}
local notation "μ" => stendhalWeight ℓ ν
local notation "C₀" => {s : Seq μ // redWord s = List.finRange ℓ}
variable (Q : I → I → MvPolynomial (Fin 2) k)

/-- The actual retained-kernel filtrations in canonical order at every red weight. -/
def CanonicalAdjacentPairKernelFiltrations (ν : Multiset I) (ℓ : ℕ) : Prop :=
  ∀ (Λ : Fin ℓ → I →₀ ℕ) (a b : Fin ℓ) (L M : List (Fin ℓ)),
    List.finRange ℓ = L ++ a :: b :: M →
    ∀ s : {s : Seq (stendhalWeight ℓ ν) // redWord s = List.finRange ℓ},
      ∃ tail : List {s : Seq (stendhalWeight ℓ ν) // redWord s = List.finRange ℓ},
        HasFiltration (fun t => blockPartialStandardAt Q Λ t.1 a b (List.finRange ℓ) t.2)
          tail (fixedOrderKernelObj Q Λ a b (List.finRange ℓ) s)

/-- Canonical-order filtrations imply filtrations in every red word, after
permuting the red weights and transporting the actual retained quotients. -/
theorem blockLoadingKernel_hasFiltration_of_canonical
    (canonical : CanonicalAdjacentPairKernelFiltrations Q ν ℓ)
    (Λ : Fin ℓ → I →₀ ℕ) (a b : Fin ℓ) {κ L M : List (Fin ℓ)}
    (hword : κ = L ++ a :: b :: M) (s : {s : Seq μ // redWord s = κ}) :
    ∃ tail : List {t : Seq μ // redWord t = κ},
      HasFiltration (fun t => blockPartialStandardAt Q Λ t.1 a b κ t.2)
        tail (fixedOrderKernelObj Q Λ a b κ s) := by
  refine adjacentPairProperty_of_canonical
    (fun W c d order t => ∃ layers : List {x : Seq μ // redWord x = order},
      HasFiltration (fun x => blockPartialStandardAt Q W x.1 c d order x.2)
        layers (fixedOrderKernelObj Q W c d order t)) ?_ canonical Λ a b hword s
  intro σ W c d order t filt
  obtain ⟨tail, hf⟩ := filt
  exact ⟨_, blockLoadingKernel_hasFiltration_redPerm Q σ (fun _ => rfl) order c d t tail hf⟩

end Categorification.Stendhal.BraidedStendhalAlgebra
