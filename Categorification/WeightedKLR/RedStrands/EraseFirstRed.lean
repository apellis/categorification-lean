import Categorification.WeightedKLR.RedStrands.PrependRed

/-!
# Erasing the first red strand

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3,
§4.7, proof of Proposition 4.39. Adding a red strand of label `λ₀` on the left of
`T̃^λ` and imposing the violating ideal loses only diagrams that are divisible by a
large power of the first dot, since this is what the first crossing squares to.

Erasure removes the first red strand. It sends the first dot and the first crossing
to zero, shifts the remaining positions down by one, and lands in the quotient of the
algebra of all red orders by the ideal generated by the powers `x₁^{⟨α_i^∨, λ₀⟩} e(s)`
for the loadings `s` beginning with a black strand of label `i`. Composed with the
addition of the red strand it is the quotient map. Since that ideal lives in high
degrees, the addition of a red strand is injective in degree zero once `λ₀` is large.

## Main definitions

* `firstDotIdeal` : the ideal generated by `x₁^{⟨α_i^∨, λ₀⟩} e(s)` with `s₁ = i`.
* `eraseFirstRed` : the erasure of the first red strand.

## Main results

* `eraseFirstRed_prependRedAllOrders` : erasing after adding is the quotient map.
* `mem_firstDotIdeal_of_prependRed_eq_zero` : the kernel of `prependRed` lies in the ideal.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra TypeA

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ) (ν : Multiset I)

local notation "Λ₀" => (Λ ∘ Fin.succ)
local notation "μ" => stendhalWeight ℓ ν
local notation "μ'" => stendhalWeight (ℓ + 1) ν
local notation "m" => Multiset.card μ
local notation "m'" => Multiset.card μ'
local notation "A₀" => StendhalAlgebraAllOrders k Q Λ₀ ν
local notation "B" => KLRAlgebra k (stendhalQ Q Λ₀) μ
local notation "Fr" => FreeAlgebra k (Gen μ')

omit [DecidableEq I] in
theorem prependRedColor_ne_first (c : I ⊕ Fin ℓ) : prependRedColor ℓ c ≠ .inr 0 := by
  cases c with
  | inl i => exact Sum.inl_ne_inr
  | inr r => exact fun h => Fin.succ_ne_zero r (Sum.inr.inj h)

omit [DecidableEq I] in
theorem first_ne_prependRedColor (c : I ⊕ Fin ℓ) : (.inr 0 : I ⊕ Fin (ℓ + 1)) ≠ prependRedColor ℓ c :=
  fun h => prependRedColor_ne_first c h.symm

omit [DecidableEq I] in
theorem stendhalQ_prependRedColor (a b : I ⊕ Fin ℓ) :
    stendhalQ Q Λ (prependRedColor ℓ a) (prependRedColor ℓ b) = stendhalQ Q Λ₀ a b := by
  cases a <;> cases b <;> rfl

omit [DecidableEq I] in
theorem prependRedColor_eq_iff (a b : I ⊕ Fin ℓ) :
    prependRedColor ℓ a = prependRedColor ℓ b ↔ a = b :=
  (prependRedColor_injective ℓ).eq_iff

/-- The ideal of diagrams divisible by `x₁^{⟨α_i^∨, λ₀⟩}` on a first black strand of label `i`.
Here `λ₀` is the label of the red strand that `prependRed` adds. -/
def firstDotIdeal : TwoSidedIdeal A₀ :=
  TwoSidedIdeal.span {y | ∃ (s : Seq μ) (i : I) (h : 0 < m), s.lbl ⟨0, h⟩ = .inl i ∧
    y = StendhalAlgebraAllOrders.x ⟨0, h⟩ ^ Λ 0 i * StendhalAlgebraAllOrders.e s}

local notation "C" => (firstDotIdeal Q Λ ν).ringCon.Quotient
local notation "π₀" => ((firstDotIdeal Q Λ ν).ringCon.mkₐ k).comp (StendhalAlgebraAllOrders.ofKLR k Q Λ₀ ν)

omit [DecidableEq I] in
private theorem card_succ : m' = m + 1 := by simp [stendhalWeight]; omega

omit [DecidableEq I] in
private theorem pos_succ (j : ℕ) (h : j + 1 < m') :
    (⟨j + 1, h⟩ : Fin m') = prependRedPosition ⟨j, by have := card_succ (ℓ := ℓ) ν; omega⟩ :=
  Fin.ext (by simp)

omit [DecidableEq I] in
private theorem loading_lbl_succ (s : Seq μ) (j : ℕ) (h : j + 1 < m') :
    (prependRedLoading s).lbl ⟨j + 1, h⟩ =
      prependRedColor ℓ (s.lbl ⟨j, by have := card_succ (ℓ := ℓ) ν; omega⟩) := by
  rw [pos_succ, prependRedLoading_lbl]

omit [DecidableEq I] in
private theorem loading_lbl_zero (s : Seq μ) (h : 0 < m') :
    (prependRedLoading s).lbl ⟨0, h⟩ = .inr 0 :=
  prependRedLoading_head s

omit [DecidableEq I] in
private theorem loading_swap (j : ℕ) (s : Seq μ) :
    sadj m' (j + 1) • prependRedLoading s = prependRedLoading (sadj m j • s) := by
  have hm := card_succ (ℓ := ℓ) ν
  apply Subtype.ext
  funext a
  rcases eq_firstPosition_or a with rfl | ⟨b, rfl⟩
  · rw [sadj_smul_apply, sadj_apply_of_ne _ (by simp [firstPosition]) (by simp [firstPosition])]
    exact (prependRedLoading_head s).trans (prependRedLoading_head _).symm
  · rw [sadj_smul_apply]
    have hb : sadj m' (j + 1) (prependRedPosition b) = prependRedPosition (sadj m j b) := by
      by_cases hj : j + 1 < m
      · have hm' : j + 1 + 1 < m' := by omega
        apply Fin.ext
        rw [sadj_apply_val hm', prependRedPosition_val, prependRedPosition_val, sadj_apply_val hj]
        split_ifs <;> omega
      · have h : ¬ j + 1 + 1 < m' := by omega
        simp [sadj, hj, h]
    rw [hb]
    change (prependRedLoading s).lbl _ = (prependRedLoading _).lbl _
    rw [prependRedLoading_lbl, prependRedLoading_lbl]
    exact congrArg (prependRedColor ℓ) (sadj_smul_apply j s _).symm

/-- A loading beginning with the new red strand maps to the old idempotent. Every other
loading maps to zero. -/
private def erasedE (t : Seq μ') : B :=
  ∑ s : Seq μ, if prependRedLoading s = t then KLRAlgebra.e s else 0

private theorem erasedE_word (s : Seq μ) : erasedE Q Λ ν (prependRedLoading s) = KLRAlgebra.e s := by
  classical
  simp [erasedE, prependRedLoading_injective.eq_iff]

private theorem erasedE_zero {t : Seq μ'} (ht : t ∉ Set.range prependRedLoading) :
    erasedE Q Λ ν t = 0 := by
  have hn (s : Seq μ) : prependRedLoading s ≠ t := fun h => ht ⟨s, h⟩
  simp [erasedE, hn]

private theorem erasedE_sum : ∑ t : Seq μ', erasedE Q Λ ν t = 1 := by
  classical
  simp only [erasedE]
  rw [Finset.sum_comm]
  simp [KLRAlgebra.sum_e]

private def erasedX (a : Fin m') : B :=
  if h : a.val = 0 then 0 else KLRAlgebra.x ⟨a.val - 1, by
    have := a.isLt; have := card_succ (ℓ := ℓ) ν; omega⟩

private def erasedCross : ℕ → B
  | 0 => 0
  | j + 1 => KLRAlgebra.ψ j

private def eraseGen : Gen μ' → B
  | .idem s => erasedE Q Λ ν s
  | .dot a => erasedX Q Λ ν a
  | .cross j => erasedCross Q Λ ν j

private def eraseFree : Fr →ₐ[k] B := FreeAlgebra.lift k (eraseGen Q Λ ν)

private theorem erase_fe (s : Seq μ') : eraseFree Q Λ ν (fe k μ' s) = erasedE Q Λ ν s :=
  FreeAlgebra.lift_ι_apply _ _

private theorem erase_fx (a : Fin m') : eraseFree Q Λ ν (fx k μ' a) = erasedX Q Λ ν a :=
  FreeAlgebra.lift_ι_apply _ _

private theorem erase_fψ (j : ℕ) : eraseFree Q Λ ν (fψ k μ' j) = erasedCross Q Λ ν j :=
  FreeAlgebra.lift_ι_apply _ _

private theorem erasedX_zero (h : 0 < m') : erasedX Q Λ ν ⟨0, h⟩ = 0 := by simp [erasedX]

private theorem erasedX_succ (j : ℕ) (h : j + 1 < m') :
    erasedX Q Λ ν ⟨j + 1, h⟩ = KLRAlgebra.x ⟨j, by rw [card_succ] at h; omega⟩ := by
  simp [erasedX]

private theorem erasedX_position (a : Fin m) :
    erasedX Q Λ ν (prependRedPosition a) = KLRAlgebra.x a := by
  rw [show prependRedPosition a = ⟨a.val + 1, (prependRedPosition a).isLt⟩ from Fin.ext (by simp),
    erasedX_succ]

private theorem erase_eval {d : ℕ} (v : Fin d → Fr) (p : MvPolynomial (Fin d) k) :
    eraseFree Q Λ ν (ncEval v p) = ncEval (fun a => eraseFree Q Λ ν (v a)) p := by
  simp only [ncEval, Finsupp.sum, map_sum, map_mul, AlgHom.commutes, map_list_prod,
    List.map_ofFn, Function.comp_def, map_pow]

private theorem erasedE_mul (s t : Seq μ') :
    erasedE Q Λ ν s * erasedE Q Λ ν t = if s = t then erasedE Q Λ ν s else 0 := by
  by_cases he : s = t
  · subst t
    by_cases hs : s ∈ Set.range prependRedLoading
    · obtain ⟨i, rfl⟩ := hs
      simp [erasedE_word, e_mul_self]
    · simp [erasedE_zero Q Λ ν hs]
  · rw [ite_eq_right_iff.mpr (fun h => (he h).elim)]
    by_cases hs : s ∈ Set.range prependRedLoading
    · obtain ⟨i, rfl⟩ := hs
      by_cases ht : t ∈ Set.range prependRedLoading
      · obtain ⟨j, rfl⟩ := ht
        have hij : i ≠ j := fun h => he (congrArg prependRedLoading h)
        simp [erasedE_word, e_mul_e, hij]
      · simp [erasedE_zero Q Λ ν ht]
    · simp [erasedE_zero Q Λ ν hs]

private theorem erasedX_mul_e (a : Fin m') (s : Seq μ') :
    erasedX Q Λ ν a * erasedE Q Λ ν s = erasedE Q Λ ν s * erasedX Q Λ ν a := by
  by_cases hs : s ∈ Set.range prependRedLoading
  · obtain ⟨i, rfl⟩ := hs
    rw [erasedE_word]
    unfold erasedX
    split <;> simp [x_mul_e]
  · simp [erasedE_zero Q Λ ν hs]

private theorem erasedCross_mul_e (j : ℕ) (s : Seq μ') :
    erasedCross Q Λ ν j * erasedE Q Λ ν s =
      erasedE Q Λ ν (sadj m' j • s) * erasedCross Q Λ ν j := by
  cases j with
  | zero => simp [erasedCross]
  | succ j =>
    by_cases hs : s ∈ Set.range prependRedLoading
    · obtain ⟨i, rfl⟩ := hs
      simp [loading_swap, erasedCross, erasedE_word, ψ_mul_e]
    · have hn : sadj m' (j + 1) • s ∉ Set.range prependRedLoading := by
        rintro ⟨i, h⟩
        exact hs ⟨_, by rw [← loading_swap, h, sadj_smul_smul]⟩
      simp [erasedE_zero Q Λ ν hs, erasedE_zero Q Λ ν hn]

private theorem erasedX_comm (a b : Fin m') :
    erasedX Q Λ ν a * erasedX Q Λ ν b = erasedX Q Λ ν b * erasedX Q Λ ν a := by
  unfold erasedX
  split_ifs <;> simp [x_mul_x]

private theorem erasedX_cross (a : Fin m') (j : ℕ) (h₁ : a.val ≠ j) (h₂ : a.val ≠ j + 1) :
    erasedX Q Λ ν a * erasedCross Q Λ ν j = erasedCross Q Λ ν j * erasedX Q Λ ν a := by
  cases j with
  | zero => simp [erasedCross]
  | succ j =>
    unfold erasedX
    split
    · simp
    · exact x_mul_ψ _ j (by simp; omega) (by simp; omega)

private theorem erase_nceval_two (j : ℕ) (h : j + 1 < m') (p : MvPolynomial (Fin 2) k) :
    eraseFree Q Λ ν (ncEval ![fx k μ' ⟨j, by omega⟩, fx k μ' ⟨j + 1, h⟩] p) =
      ncEval ![erasedX Q Λ ν ⟨j, by omega⟩, erasedX Q Λ ν ⟨j + 1, h⟩] p := by
  rw [erase_eval]
  congr 1
  funext a
  fin_cases a <;> apply erase_fx

private theorem erase_nceval_three (j : ℕ) (h : j + 2 < m') (p : MvPolynomial (Fin 3) k) :
    eraseFree Q Λ ν (ncEval ![fx k μ' ⟨j, by omega⟩, fx k μ' ⟨j + 1, by omega⟩,
      fx k μ' ⟨j + 2, h⟩] p) =
      ncEval ![erasedX Q Λ ν ⟨j, by omega⟩, erasedX Q Λ ν ⟨j + 1, by omega⟩,
        erasedX Q Λ ν ⟨j + 2, h⟩] p := by
  rw [erase_eval]
  congr 1
  funext a
  fin_cases a <;> apply erase_fx

private theorem eval_X_one_pow (z : B) (b : ℕ) :
    ncEval ![(0 : B), z] (MvPolynomial.X 1 ^ b : MvPolynomial (Fin 2) k) = z ^ b := by
  rw [MvPolynomial.X_pow_eq_monomial]
  change (Finsupp.single _ (1 : k)).sum _ = _
  rw [Finsupp.sum_single_index (by simp)]
  simp [List.ofFn_succ, Finsupp.single_apply]

private theorem π₀_first_dot (s : Seq μ) (h : 0 < m) (i : I) (hs : s.lbl ⟨0, h⟩ = .inl i) :
    π₀ (KLRAlgebra.x ⟨0, h⟩ ^ Λ 0 i * KLRAlgebra.e s) = 0 := by
  change (firstDotIdeal Q Λ ν).ringCon.mk' (StendhalAlgebraAllOrders.ofKLR k Q Λ₀ ν _) = 0
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk', map_mul, map_pow]
  exact TwoSidedIdeal.subset_span ⟨s, i, h, hs, rfl⟩

private theorem erase_rel {a b : Fr} (h : KLR.Rel k (stendhalQ Q Λ) μ' a b) :
    π₀ (eraseFree Q Λ ν a) = π₀ (eraseFree Q Λ ν b) := by
  classical
  have hm := card_succ (ℓ := ℓ) ν
  cases h with
  | idem_mul s t =>
    apply congrArg π₀
    by_cases h : s = t <;> simp [erase_fe, h, erasedE_mul]
  | idem_sum =>
    apply congrArg π₀
    simp [erase_fe, erasedE_sum]
  | dot_idem a s =>
    apply congrArg π₀
    simp [erase_fx, erase_fe, erasedX_mul_e]
  | cross_idem j s =>
    apply congrArg π₀
    simp [erase_fψ, erase_fe, erasedCross_mul_e]
  | cross_zero j h =>
    apply congrArg π₀
    cases j with
    | zero => simp [erase_fψ, erasedCross]
    | succ j => simp [erase_fψ, erasedCross, ψ_eq_zero j (by omega : m ≤ j + 1)]
  | dot_dot a b =>
    apply congrArg π₀
    simp only [map_mul, erase_fx]
    exact erasedX_comm Q Λ ν a b
  | cross_cross j l h =>
    apply congrArg π₀
    simp only [map_mul, erase_fψ]
    cases j with
    | zero => simp [erasedCross]
    | succ j =>
      cases l with
      | zero => omega
      | succ l => exact ψ_mul_ψ j l (by omega)
  | dot_cross a j h1 h2 =>
    apply congrArg π₀
    simp only [map_mul, erase_fx, erase_fψ]
    exact erasedX_cross Q Λ ν a j h1 h2
  | dot_cross_left j h s | dot_cross_right j h s =>
    apply congrArg π₀
    by_cases hs : s ∈ Set.range prependRedLoading
    · obtain ⟨t, rfl⟩ := hs
      cases j with
      | zero =>
        simp [erase_fe, erase_fx, erase_fψ, erasedCross, loading_lbl_zero, loading_lbl_succ,
          first_ne_prependRedColor]
      | succ j =>
        simp only [map_mul, map_sub, apply_ite (eraseFree Q Λ ν), map_zero, erase_fx, erase_fe,
          erase_fψ, erasedCross, erasedX_succ, erasedE_word, loading_lbl_succ, prependRedColor_eq_iff]
        first | exact dot_cross_left j (by omega) t | exact dot_cross_right j (by omega) t
    · simp [apply_ite, erase_fe, erasedE_zero Q Λ ν hs]
  | cross_sq j h s =>
    by_cases hs : s ∈ Set.range prependRedLoading
    · obtain ⟨t, rfl⟩ := hs
      cases j with
      | zero =>
        have h0 : 0 < m := by omega
        rw [if_neg (by rw [loading_lbl_zero, loading_lbl_succ]; exact first_ne_prependRedColor _)]
        simp only [map_mul, erase_fψ, erase_fe, erasedCross, mul_zero, zero_mul, map_zero,
          erasedE_word, erase_nceval_two, erasedX_zero]
        rw [loading_lbl_zero, loading_lbl_succ]
        cases hc : t.lbl ⟨0, h0⟩ with
        | inl i =>
          change 0 = π₀ (ncEval ![0, erasedX Q Λ ν ⟨0 + 1, h⟩]
            (MvPolynomial.X 1 ^ Λ 0 i) * KLRAlgebra.e t)
          rw [eval_X_one_pow, erasedX_succ]
          exact (π₀_first_dot Q Λ ν t h0 i hc).symm
        | inr r =>
          change 0 = π₀ (ncEval ![0, erasedX Q Λ ν ⟨0 + 1, h⟩] 0 * KLRAlgebra.e t)
          simp [ncEval]
      | succ j =>
        apply congrArg π₀
        simp only [map_mul, apply_ite (eraseFree Q Λ ν), erase_fψ, erase_fe, erasedCross,
          erasedE_word, loading_lbl_succ, prependRedColor_eq_iff, map_zero, erase_nceval_two,
          erasedX_succ, stendhalQ_prependRedColor]
        exact ψ_sq j (by omega) t
    · simp [apply_ite, erase_fe, erasedE_zero Q Λ ν hs]
  | braid j h s =>
    apply congrArg π₀
    by_cases hs : s ∈ Set.range prependRedLoading
    · obtain ⟨t, rfl⟩ := hs
      cases j with
      | zero =>
        simp [erase_fψ, erase_fe, erasedCross, loading_lbl_zero, loading_lbl_succ,
          first_ne_prependRedColor]
      | succ j =>
        simp only [map_mul, map_sub, apply_ite (eraseFree Q Λ ν), erase_fψ, erase_fe, erasedCross,
          erasedE_word, loading_lbl_succ, ne_eq, prependRedColor_eq_iff, map_zero,
          erase_nceval_three, erasedX_succ, stendhalQ_prependRedColor]
        exact braid j (by omega) t
    · simp [apply_ite, erase_fe, erasedE_zero Q Λ ν hs]

/-- **Erasing the first red strand**, from all red orders with the new red strand to the
old ones modulo `firstDotIdeal`. -/
def eraseFirstRed : StendhalAlgebraAllOrders k Q Λ ν →ₐ[k] C :=
  RingQuot.liftAlgHom k ⟨π₀.comp (eraseFree Q Λ ν), fun _ _ h => by
    rcases h with h | ⟨a, s, hs⟩ | ⟨j, h, s, h₁, h₂⟩
    · exact erase_rel Q Λ ν h
    · change π₀ (eraseFree Q Λ ν (fx k μ' a * fe k μ' s)) = π₀ (eraseFree Q Λ ν 0)
      by_cases hi : s ∈ Set.range prependRedLoading
      · obtain ⟨t, rfl⟩ := hi
        rw [map_mul, erase_fx, erase_fe, erasedE_word, map_zero]
        rcases eq_firstPosition_or a with rfl | ⟨b, rfl⟩
        · simp [firstPosition, erasedX_zero]
        · rw [erasedX_position, map_mul]
          rw [prependRedLoading_lbl, prependRedColor_isRight] at hs
          change (firstDotIdeal Q Λ ν).ringCon.mk' (StendhalAlgebraAllOrders.x b *
            StendhalAlgebraAllOrders.e t) = 0
          rw [StendhalAlgebraAllOrders.x_mul_e_of_red b t hs, map_zero]
      · simp [erase_fe, erasedE_zero Q Λ ν hi]
    · change π₀ (eraseFree Q Λ ν (fψ k μ' j * fe k μ' s)) = π₀ (eraseFree Q Λ ν 0)
      by_cases hi : s ∈ Set.range prependRedLoading
      · obtain ⟨t, rfl⟩ := hi
        rw [map_mul, erase_fψ, erase_fe, erasedE_word, map_zero]
        cases j with
        | zero => simp [erasedCross]
        | succ j =>
          have hj : j + 1 < m := by omega
          rw [loading_lbl_succ, prependRedColor_isRight] at h₁
          rw [loading_lbl_succ, prependRedColor_isRight] at h₂
          change (firstDotIdeal Q Λ ν).ringCon.mk' (StendhalAlgebraAllOrders.ψ j *
            StendhalAlgebraAllOrders.e t) = 0
          rw [StendhalAlgebraAllOrders.ψ_mul_e_of_red j hj t h₁ h₂, map_zero]
      · simp [erase_fe, erasedE_zero Q Λ ν hi]⟩

private theorem eraseFirstRed_gen (g : Gen μ') :
    eraseFirstRed Q Λ ν (RingQuot.mkAlgHom k (Stendhal.Rel k Q Λ ν) (FreeAlgebra.ι k g)) =
      π₀ (eraseGen Q Λ ν g) := by
  trans (π₀.comp (eraseFree Q Λ ν)) (FreeAlgebra.ι k g)
  · exact RingQuot.liftAlgHom_mkAlgHom_apply _ _ _ _
  · rw [AlgHom.comp_apply, eraseFree, FreeAlgebra.lift_ι_apply]

theorem eraseFirstRed_e_loading (s : Seq μ) :
    eraseFirstRed Q Λ ν (StendhalAlgebraAllOrders.e (prependRedLoading s)) =
      π₀ (KLRAlgebra.e s) := by
  rw [StendhalAlgebraAllOrders.e, KLRAlgebra.e, StendhalAlgebraAllOrders.ofKLR_mk,
    eraseFirstRed_gen]
  exact congrArg π₀ (erasedE_word Q Λ ν s)

theorem eraseFirstRed_e_eq_zero (t : Seq μ') (ht : ∀ s, prependRedLoading s ≠ t) :
    eraseFirstRed Q Λ ν (StendhalAlgebraAllOrders.e t) = 0 := by
  rw [StendhalAlgebraAllOrders.e, KLRAlgebra.e, StendhalAlgebraAllOrders.ofKLR_mk,
    eraseFirstRed_gen]
  change π₀ (erasedE Q Λ ν t) = 0
  rw [erasedE_zero Q Λ ν (fun ⟨s, hs⟩ => ht s hs), map_zero]

theorem eraseFirstRed_x_position (a : Fin m) :
    eraseFirstRed Q Λ ν (StendhalAlgebraAllOrders.x (prependRedPosition a)) =
      π₀ (KLRAlgebra.x a) := by
  rw [StendhalAlgebraAllOrders.x, KLRAlgebra.x, StendhalAlgebraAllOrders.ofKLR_mk,
    eraseFirstRed_gen]
  exact congrArg π₀ (erasedX_position Q Λ ν a)

theorem eraseFirstRed_ψ_succ (j : ℕ) :
    eraseFirstRed Q Λ ν (StendhalAlgebraAllOrders.ψ (j + 1)) = π₀ (KLRAlgebra.ψ j) := by
  rw [StendhalAlgebraAllOrders.ψ, KLRAlgebra.ψ, StendhalAlgebraAllOrders.ofKLR_mk,
    eraseFirstRed_gen]
  rfl

theorem eraseFirstRed_firstRedIdem : eraseFirstRed Q Λ ν (firstRedIdem Q Λ ν) = 1 := by
  rw [← (prependRedAllOrders_one Q Λ ν)]
  sorry

end Categorification.Stendhal
