import Categorification.WeightedKLR.RedStrands.BlockCrossingGrading
import Categorification.WeightedKLR.RedStrands.StandardPartialKernel

/-!
# The grading of a loading standard module

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2, §5.1,
Definition 5.1. The standard module `S_t = e(t) T / U_t` at a loading `t` of the red order `κ`
carries the auxiliary grading of the braided diagrams (`RedBlock.loadingStandardGrade`). It is a
grading: `U_t` is cut out by the two-sided ideal generated by the degree-zero idempotents of the
higher loadings (`mem_violStandardUpper_iff`), so it is homogeneous
(`loadingStandardDecomposition`).
-/

noncomputable section

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR MulOpposite Categorification.Graded DirectSum RedBlock

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ} {ν : Multiset I}
  (G : KLR.GradingDatum (stendhalQ Q Λ))

local notation "μ" => stendhalWeight ℓ ν
local notation "V" => ViolQuotient k Q Λ ν
local notation "Agrade" => violAuxiliaryGrade (ν := ν) G

instance loadingStandardModuleK (t : Seq μ) (κ : List (Fin ℓ)) :
    Module k (ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) t κ) :=
  Submodule.Quotient.module' (violStandardUpper t κ)

/-- **The loading standard is graded** (Webster, arXiv:1309.3796v2, Definition 5.1): for a
loading `t` of the red order `κ`, the auxiliary grading of `e(t) T / U_t` is a decomposition. -/
@[instance_reducible] def loadingStandardDecomposition (t : Seq μ) (κ : List (Fin ℓ))
    (ht : redWord t = κ) : Decomposition (loadingStandardGrade G t κ) := by
  subst ht
  exact Graded.mapDecomposition (π := loadingMkK t (redWord t)) (𝒳 := violCornerGrade G t _)
    (Submodule.mkQ_surjective (violStandardUpper (k := k) (Q := Q) (Λ := Λ) t _))
    fun x hx n => by
      have hx' : x.1 ∈ stendhalUpperIdeal k Q Λ ν t (redWord t) :=
        (mem_violStandardUpper_iff x).1
          ((Submodule.Quotient.mk_eq_zero (violStandardUpper t (redWord t))).1 hx)
      apply (Submodule.Quotient.mk_eq_zero (violStandardUpper t (redWord t))).2
      apply (mem_violStandardUpper_iff _).2
      rw [decompose_violCornerGrade_val]
      apply Graded.decompose_mem_twoSidedSpan Agrade _ hx' n
      rintro _ ⟨u, -, -, rfl⟩
      exact ⟨0, violIdem_mem_violAuxiliaryGrade G u⟩

end Categorification.Stendhal.BraidedStendhalAlgebra
