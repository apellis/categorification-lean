import Categorification.WeightedKLR.Induction.ModuleMonoidal
import Categorification.Algebra.ProjK0

/-!
# Induction on Grothendieck groups of weighted KLR algebras

B. Webster, *Weighted Khovanov–Lauda–Rouquier algebras*, arXiv:1209.2463v4, §2.4, Theorem 2.19:
induction makes `⊕_ν K₀(W^ϑ_ν)` an algebra. This file proves the part of that statement which
holds over every commutative ring `k`, for the ungraded Grothendieck groups `ProjK0` of finitely
generated projective modules: induction `Ind (P ⊠ Q)` of finitely generated projective modules
is finitely generated projective, and the product `[P] · [Q] = [Ind (P ⊠ Q)]` is well defined,
biadditive, associative and unital. Associativity and the units come from the module
isomorphisms of Webster's Proposition 2.18 (`ModuleMonoidal.lean`), transported along `castW`
by the single lemma `ProjK0.map_of_semilinear`.

## Main definitions and results

* `InductionAlong.Corner` is a finitely generated projective `B`-module, so `Ind N φ` is
  finitely generated projective when `N` is (`InductionAlong.Ind.projective`,
  `InductionAlong.Ind.finite`).
* `Juxtapose.indProj P Q`: `Ind (P ⊠ Q)` as a finitely generated projective `W_{ν'+ν''}`-module.
* `Juxtapose.indK0 : K₀(W_{ν'}) × K₀(W_{ν''}) → K₀(W_{ν'+ν''})`, biadditive, with
  `indK0_of : indK0 [P] [Q] = [Ind (P ⊠ Q)]`.
* `Juxtapose.indK0_assoc`, `Juxtapose.indK0_one_left`, `Juxtapose.indK0_one_right`:
  associativity and the unit `[W_0]`, up to the identifications `castW` of the index algebras.
-/

namespace Categorification

open MulOpposite
open scoped TensorProduct

noncomputable section

namespace InductionAlong

universe u w

variable {A : Type u} [Ring A] {B : Type u} [Ring B] (φ : A →ₙ+* B)

/-- The projection `B → B φ(1)`, `b ↦ b φ(1)`. -/
def cornerProj : B →ₗ[B] Corner φ where
  toFun b := ⟨b * φ 1, by rw [mem_lIdeal, mul_assoc, unit_mul_unit]⟩
  map_add' x y := Subtype.ext (add_mul _ _ _)
  map_smul' c x := Subtype.ext (mul_assoc _ _ _)

theorem cornerProj_comp_subtype :
    (cornerProj φ).comp (lIdeal (φ 1)).subtype = LinearMap.id :=
  LinearMap.ext fun z => Subtype.ext z.2

/-- The corner `B φ(1)` is a direct summand of `B`, hence projective. -/
instance corner_projective : Module.Projective B (Corner φ) :=
  Module.Projective.of_split (lIdeal (φ 1)).subtype (cornerProj φ) (cornerProj_comp_subtype φ)

/-- The corner `B φ(1)` is generated by `φ(1)`. -/
instance corner_finite : Module.Finite B (Corner φ) :=
  Module.Finite.of_surjective (cornerProj φ) fun z => ⟨z.1, Subtype.ext z.2⟩

variable (N : Type w) [AddCommGroup N] [Module A N]

/-- Induction of a projective module is projective. -/
theorem Ind.projective [Module.Projective A N] : Module.Projective B (Ind N φ) :=
  BalancedTensor.projective (k := ℤ)

/-- Induction of a finitely generated module is finitely generated. -/
theorem Ind.finite [Module.Finite A N] : Module.Finite B (Ind N φ) :=
  BalancedTensor.finite (k := ℤ)

variable (k : Type*) [CommRing k] [Algebra k B]

/-- `IndK k N φ ≅ IndK k N' φ` for `N ≅ N'`. -/
def IndK.congr {N' : Type w} [AddCommGroup N'] [Module A N'] (e : N ≃ₗ[A] N') :
    IndK k N φ ≃ₗ[B] IndK k N' φ :=
  BalancedTensor.congrRight (k := ℤ) e

/-- `IndK k (N × N') φ ≅ IndK k N φ × IndK k N' φ`. -/
def IndK.prodEquiv (N' : Type w) [AddCommGroup N'] [Module A N'] :
    IndK k (N × N') φ ≃ₗ[B] IndK k N φ × IndK k N' φ :=
  BalancedTensor.prodRight ℤ B A (Corner φ) N N'

/-- `IndK k N φ ≅ IndK k X φ × IndK k Y φ` for `N ≅ X × Y`. -/
def IndK.congrProd {X Y : Type w} [AddCommGroup X] [Module A X] [AddCommGroup Y] [Module A Y]
    (g : N ≃ₗ[A] X × Y) : IndK k N φ ≃ₗ[B] IndK k X φ × IndK k Y φ :=
  (IndK.congr φ N k g).trans (IndK.prodEquiv φ X k Y)

end InductionAlong

namespace WeightedKLR

namespace Juxtapose

open InductionAlong GalleryAlgebra FGProj

variable {I : Type*} [DecidableEq I] {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜]
  [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k] {Γ : WeightedGraph I 𝕜 k}

section Product

variable {ν' ν'' : I →₀ ℕ}

instance ind_projective (P : FGProj k (WeightedKLRAlgebra k Γ ν'))
    (Q : FGProj k (WeightedKLRAlgebra k Γ ν'')) :
    Module.Projective (WeightedKLRAlgebra k Γ (ν' + ν'')) (ind k Γ ν' ν'' P.carrier Q.carrier) :=
  haveI : Module.Projective (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')
      (ExtTensor k P.carrier Q.carrier) := ExtTensor.projective
  Ind.projective _ _

instance ind_finite (P : FGProj k (WeightedKLRAlgebra k Γ ν'))
    (Q : FGProj k (WeightedKLRAlgebra k Γ ν'')) :
    Module.Finite (WeightedKLRAlgebra k Γ (ν' + ν'')) (ind k Γ ν' ν'' P.carrier Q.carrier) :=
  haveI : Module.Finite (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')
      (ExtTensor k P.carrier Q.carrier) := ExtTensor.finite
  Ind.finite _ _

/-- `Ind (P ⊠ Q)` for finitely generated projective modules `P` over `W_{ν'}` and `Q` over
`W_{ν''}`, as a finitely generated projective `W_{ν'+ν''}`-module (Webster,
arXiv:1209.2463v4, §2.4). -/
def indProj (P : FGProj k (WeightedKLRAlgebra k Γ ν'))
    (Q : FGProj k (WeightedKLRAlgebra k Γ ν'')) : FGProj k (WeightedKLRAlgebra k Γ (ν' + ν'')) :=
  FGProj.of (ind k Γ ν' ν'' P.carrier Q.carrier)

section Modules

universe w

variable {M M' : Type w} [AddCommGroup M] [Module k M]
  [Module (WeightedKLRAlgebra k Γ ν') M] [IsScalarTower k (WeightedKLRAlgebra k Γ ν') M]
  [AddCommGroup M'] [Module k M'] [Module (WeightedKLRAlgebra k Γ ν') M']
  [IsScalarTower k (WeightedKLRAlgebra k Γ ν') M']
  {N N' : Type w} [AddCommGroup N] [Module k N]
  [Module (WeightedKLRAlgebra k Γ ν'') N] [IsScalarTower k (WeightedKLRAlgebra k Γ ν'') N]
  [AddCommGroup N'] [Module k N'] [Module (WeightedKLRAlgebra k Γ ν'') N']
  [IsScalarTower k (WeightedKLRAlgebra k Γ ν'') N']

variable (k Γ ν' ν'') in
/-- `Ind` applied to an isomorphism of `W_{ν'} ⊗ W_{ν''}`-modules. -/
def indMapEquiv (g : ExtTensor k M N ≃ₗ[WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'']
      ExtTensor k M' N') :
    ind k Γ ν' ν'' M N ≃ₗ[WeightedKLRAlgebra k Γ (ν' + ν'')] ind k Γ ν' ν'' M' N' :=
  (IndK.congr (A := WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')
    (B := WeightedKLRAlgebra k Γ (ν' + ν'')) (inductionRingHom k Γ ν' ν'') _ k g :)

variable (k Γ ν' ν'') in
/-- `Ind (M ⊠ N) ≅ Ind (M' ⊠ N')` for `M ≅ M'`, `N ≅ N'`. -/
def indCongr (e : M ≃ₗ[WeightedKLRAlgebra k Γ ν'] M') (f : N ≃ₗ[WeightedKLRAlgebra k Γ ν''] N') :
    ind k Γ ν' ν'' M N ≃ₗ[WeightedKLRAlgebra k Γ (ν' + ν'')] ind k Γ ν' ν'' M' N' :=
  indMapEquiv k Γ ν' ν'' (ExtTensor.congr e f)

variable (k Γ ν' ν'' M M' N) in
/-- `Ind ((M × M') ⊠ N) ≅ Ind (M ⊠ N) × Ind (M' ⊠ N)`. -/
def indProdLeft :
    ind k Γ ν' ν'' (M × M') N ≃ₗ[WeightedKLRAlgebra k Γ (ν' + ν'')]
      ind k Γ ν' ν'' M N × ind k Γ ν' ν'' M' N :=
  (IndK.congrProd (A := WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')
    (B := WeightedKLRAlgebra k Γ (ν' + ν'')) (inductionRingHom k Γ ν' ν'') _ k
    (ExtTensor.prodLeft (k := k) (P := M) (P' := M') (Q := N)
      (A := WeightedKLRAlgebra k Γ ν') (B := WeightedKLRAlgebra k Γ ν'')) :)

variable (k Γ ν' ν'' M N N') in
/-- `Ind (M ⊠ (N × N')) ≅ Ind (M ⊠ N) × Ind (M ⊠ N')`. -/
def indProdRight :
    ind k Γ ν' ν'' M (N × N') ≃ₗ[WeightedKLRAlgebra k Γ (ν' + ν'')]
      ind k Γ ν' ν'' M N × ind k Γ ν' ν'' M N' :=
  (IndK.congrProd (A := WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'')
    (B := WeightedKLRAlgebra k Γ (ν' + ν'')) (inductionRingHom k Γ ν' ν'') _ k
    (ExtTensor.prodRight (k := k) (P := M) (Q := N) (Q' := N')
      (A := WeightedKLRAlgebra k Γ ν') (B := WeightedKLRAlgebra k Γ ν'')) :)

end Modules

/-- `Ind (P ⊠ Q) ≅ Ind (P' ⊠ Q')` for `P ≅ P'`, `Q ≅ Q'`. -/
def indProjCongr {P P' : FGProj k (WeightedKLRAlgebra k Γ ν')}
    {Q Q' : FGProj k (WeightedKLRAlgebra k Γ ν'')} (e : P.Iso P') (f : Q.Iso Q') :
    (indProj P Q).Iso (indProj P' Q') :=
  indCongr k Γ ν' ν'' e f

/-- `Ind ((P × P') ⊠ Q) ≅ Ind (P ⊠ Q) × Ind (P' ⊠ Q)`. -/
def indProjProdLeft (P P' : FGProj k (WeightedKLRAlgebra k Γ ν'))
    (Q : FGProj k (WeightedKLRAlgebra k Γ ν'')) :
    (indProj (P.prod P') Q).Iso ((indProj P Q).prod (indProj P' Q)) :=
  indProdLeft k Γ ν' ν'' _ _ _

/-- `Ind (P ⊠ (Q × Q')) ≅ Ind (P ⊠ Q) × Ind (P ⊠ Q')`. -/
def indProjProdRight (P : FGProj k (WeightedKLRAlgebra k Γ ν'))
    (Q Q' : FGProj k (WeightedKLRAlgebra k Γ ν'')) :
    (indProj P (Q.prod Q')).Iso ((indProj P Q).prod (indProj P Q')) :=
  indProdRight k Γ ν' ν'' _ _ _

variable (ν' ν'') in
/-- **The product of Webster's Theorem 2.19 on Grothendieck groups**
(arXiv:1209.2463v4, §2.4): `K₀(W_{ν'}) × K₀(W_{ν''}) → K₀(W_{ν'+ν''})`,
`[P] · [Q] = [Ind (P ⊠ Q)]`, biadditive, over any commutative ring `k`. -/
def indK0 : ProjK0 k (WeightedKLRAlgebra k Γ ν') →+ ProjK0 k (WeightedKLRAlgebra k Γ ν'') →+
    ProjK0 k (WeightedKLRAlgebra k Γ (ν' + ν'')) :=
  ProjK0.lift₂ (fun P Q => ProjK0.of (indProj P Q))
    (fun _ _ Q e => ProjK0.of_eq_of_iso (indProjCongr e (LinearEquiv.refl _ Q.carrier)))
    (fun P _ _ f => ProjK0.of_eq_of_iso (indProjCongr (LinearEquiv.refl _ P.carrier) f))
    (fun P P' Q => by rw [ProjK0.of_eq_of_iso (indProjProdLeft P P' Q), ProjK0.of_prod])
    (fun P Q Q' => by rw [ProjK0.of_eq_of_iso (indProjProdRight P Q Q'), ProjK0.of_prod])

@[simp] theorem indK0_of (P : FGProj k (WeightedKLRAlgebra k Γ ν'))
    (Q : FGProj k (WeightedKLRAlgebra k Γ ν'')) :
    indK0 ν' ν'' (ProjK0.of P) (ProjK0.of Q) = ProjK0.of (indProj P Q) :=
  ProjK0.lift₂_of _ _ _ _ _ P Q

end Product

/-! ### Associativity and units -/

section Assoc

variable (ν₁ ν₂ ν₃ : I →₀ ℕ)

/-- **Associativity of the product** (Webster, arXiv:1209.2463v4, Theorem 2.19, from
Proposition 2.18): `([P] [Q]) [R] = [P] ([Q] [R])`, where the left side is transported from
`K₀(W_{(ν₁+ν₂)+ν₃})` to `K₀(W_{ν₁+(ν₂+ν₃)})` along `castW`. -/
theorem indK0_assoc (x : ProjK0 k (WeightedKLRAlgebra k Γ ν₁))
    (y : ProjK0 k (WeightedKLRAlgebra k Γ ν₂)) (z : ProjK0 k (WeightedKLRAlgebra k Γ ν₃)) :
    ProjK0.map (castW k Γ (add_assoc ν₁ ν₂ ν₃)) (indK0 (ν₁ + ν₂) ν₃ (indK0 ν₁ ν₂ x y) z) =
      indK0 ν₁ (ν₂ + ν₃) x (indK0 ν₂ ν₃ y z) := by
  induction x using ProjK0.induction_on generalizing y z with
  | zero => simp
  | add x x' hx hx' => simp only [map_add, AddMonoidHom.add_apply, hx, hx']
  | neg x hx => simp only [map_neg, AddMonoidHom.neg_apply, hx]
  | of P =>
    induction y using ProjK0.induction_on generalizing z with
    | zero => simp
    | add y y' hy hy' => simp only [map_add, AddMonoidHom.add_apply, hy, hy']
    | neg y hy => simp only [map_neg, AddMonoidHom.neg_apply, hy]
    | of Q =>
      induction z using ProjK0.induction_on with
      | zero => simp
      | add z z' hz hz' => simp only [map_add, hz, hz']
      | neg z hz => simp only [map_neg, hz]
      | of R =>
        rw [indK0_of, indK0_of, indK0_of, indK0_of]
        exact ProjK0.map_of_semilinear _ _ _
          (indAssocEquiv k Γ ν₁ ν₂ ν₃ P.carrier Q.carrier R.carrier).toAddEquiv
          (indAssocEquiv_smul ν₁ ν₂ ν₃ P.carrier Q.carrier R.carrier)

end Assoc

section Unit

variable (ν : I →₀ ℕ)

variable (k Γ) in
/-- The unit `[W_0] ∈ K₀(W_0)`. -/
def unitK0 : ProjK0 k (WeightedKLRAlgebra k Γ 0) :=
  ProjK0.of (FGProj.regular k (WeightedKLRAlgebra k Γ 0))

/-- **Left unit** (Webster, arXiv:1209.2463v4, Theorem 2.19, from Proposition 2.18):
`[W_0] x = x`, transported along `castW (zero_add ν)`. -/
theorem indK0_one_left (x : ProjK0 k (WeightedKLRAlgebra k Γ ν)) :
    ProjK0.map (castW k Γ (zero_add ν)) (indK0 0 ν (unitK0 k Γ) x) = x := by
  induction x using ProjK0.induction_on with
  | zero => simp
  | add x x' hx hx' => simp only [map_add, hx, hx']
  | neg x hx => simp only [map_neg, hx]
  | of P =>
    rw [unitK0, indK0_of]
    exact ProjK0.map_of_semilinear _ _ _ (indUnitLeftEquiv k Γ ν P.carrier).toAddEquiv
      (indUnitLeftEquiv_smul ν P.carrier)

/-- **Right unit** (Webster, arXiv:1209.2463v4, Theorem 2.19, from Proposition 2.18):
`x [W_0] = x`, transported along `castW (add_zero ν)`. -/
theorem indK0_one_right (x : ProjK0 k (WeightedKLRAlgebra k Γ ν)) :
    ProjK0.map (castW k Γ (add_zero ν)) (indK0 ν 0 x (unitK0 k Γ)) = x := by
  induction x using ProjK0.induction_on with
  | zero => simp
  | add x x' hx hx' => simp only [map_add, AddMonoidHom.add_apply, hx, hx']
  | neg x hx => simp only [map_neg, AddMonoidHom.neg_apply, hx]
  | of P =>
    rw [unitK0, indK0_of]
    exact ProjK0.map_of_semilinear _ _ _ (indUnitRightEquiv k Γ ν P.carrier).toAddEquiv
      (indUnitRightEquiv_smul ν P.carrier)

end Unit

end Juxtapose

end WeightedKLR

end

