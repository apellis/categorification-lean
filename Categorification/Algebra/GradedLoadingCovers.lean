import Categorification.Algebra.IdempotentEquiv
import Categorification.Algebra.LoadingSchanuel
import DG.Algebra.AddEquiv
import DG.Bigraded.Basic
import DG.Module.DirectSum
import DG.Module.Shift
import Mathlib.Algebra.Module.Projective
import Mathlib.Algebra.Exact.Basic

/-! # Homogeneous covers by shifted loading projectives -/

open DirectSum BigOperators

noncomputable section

namespace Categorification.ModuleFiltration

universe u v w
variable {R : Type u} [Ring R]
variable {X : Type v} {Y : Type w} [AddCommGroup X] [Module R X]
  [AddCommGroup Y] [Module R Y]
variable (G : ℤ → AddSubgroup X) (H : ℤ → AddSubgroup Y)
variable [DirectSum.Decomposition G] [DirectSum.Decomposition H]

/-- A degree-preserving map commutes with extraction of any one homogeneous component. -/
theorem decompose_linearMap_component (f : X →ₗ[R] Y)
    (hf : ∀ ⦃j : ℤ⦄ ⦃x : X⦄, x ∈ G j → f x ∈ H j) (x : X) (j : ℤ) :
    (DirectSum.decompose H (f x) j : Y) = f (DirectSum.decompose G x j : X) := by
  induction x using DirectSum.Decomposition.inductionOn G with
  | zero => simp
  | @homogeneous i x =>
    by_cases h : i = j
    · subst j
      rw [DirectSum.decompose_of_mem_same H (hf x.property),
        DirectSum.decompose_of_mem_same G x.property]
    · rw [DirectSum.decompose_of_mem_ne H (hf x.property) h,
        DirectSum.decompose_of_mem_ne G x.property h]
      simp
  | add x y hx hy =>
    simp only [map_add, DirectSum.decompose_add, DirectSum.add_apply, AddSubgroup.coe_add, hx, hy]

/-- Surjectivity of a degree-preserving map supplies a lift in the very same weight. -/
theorem exists_homogeneous_preimage (f : X →ₗ[R] Y) (hs : Function.Surjective f)
    (hf : ∀ ⦃j : ℤ⦄ ⦃x : X⦄, x ∈ G j → f x ∈ H j)
    {j : ℤ} {y : Y} (hy : y ∈ H j) : ∃ x ∈ G j, f x = y := by
  obtain ⟨x, rfl⟩ := hs y
  refine ⟨_, (DirectSum.decompose G x j).property, ?_⟩
  rw [← decompose_linearMap_component G H f hf x j, DirectSum.decompose_of_mem_same H hy]

/-- Exactness of a sequence of degree-preserving maps restricts to each weight. -/
theorem exists_homogeneous_preimage_of_exact
    {Z : Type*} [AddCommGroup Z] [Module R Z]
    (f : X →ₗ[R] Y) (g : Y →ₗ[R] Z) (hex : Function.Exact f g)
    (hf : ∀ ⦃j : ℤ⦄ ⦃x : X⦄, x ∈ G j → f x ∈ H j)
    {j : ℤ} {y : Y} (hy : y ∈ H j) (hgy : g y = 0) : ∃ x ∈ G j, f x = y := by
  obtain ⟨x, rfl⟩ := (hex y).mp hgy
  refine ⟨_, (DirectSum.decompose G x j).property, ?_⟩
  rw [← decompose_linearMap_component G H f hf x j, DirectSum.decompose_of_mem_same H hy]

/-- Degree-zero kernels use the grading induced by the source. -/
def kernelGrading (f : X →ₗ[R] Y) (j : ℤ) : AddSubgroup (LinearMap.ker f) :=
  (G j).comap (LinearMap.ker f).subtype.toAddMonoidHom

/-- A homogeneous differential admits a literal decomposition of its kernel. -/
@[instance_reducible]
def kernelGrading_decomposition (f : X →ₗ[R] Y)
    (hf : ∀ ⦃j : ℤ⦄ ⦃x : X⦄, x ∈ G j → f x ∈ H j) :
    DirectSum.Decomposition (kernelGrading G f) := by
  let F := (LinearMap.ker f).subtype.toAddMonoidHom
  apply DirectSum.IsInternal.chooseDecomposition
  apply DG.isInternal_comap G F (Submodule.injective_subtype _)
  intro j x
  have hfx : f x.val = 0 := x.property
  have hzero : f (DirectSum.decompose G x.val j : X) = 0 := by
    rw [← decompose_linearMap_component G H f hf, hfx, DirectSum.decompose_zero]
    rfl
  exact ⟨⟨_, hzero⟩, rfl⟩

variable {e : R}

/-- Each homogeneous component of a fixed point of a weight-zero loading projector
is again fixed by that projector. -/
theorem projector_fixes_decompose
    (he : ∀ ⦃j : ℤ⦄ ⦃x : X⦄, x ∈ G j → e • x ∈ G j)
    {x : X} (hx : e • x = x) (j : ℤ) :
    e • (DirectSum.decompose G x j : X) = (DirectSum.decompose G x j : X) := by
  let _ : DG.DGAddCommGroup X := {
    grading := G
    d := 0
    d_mem' := fun _ => zero_mem _
    d_d' := fun _ => rfl }
  let f : X →+ X := { toFun := (e • ·), map_zero' := smul_zero _, map_add' := smul_add _ }
  exact (DG.coe_decompose_map_of_map_mem f (fun h => he h) x j).symm.trans
    (congrArg (fun z : X => (DirectSum.decompose G z j : X)) hx)

/-- The linear map from a loading projective generated by a fixed point. -/
def loadingGeneratorMap (x : X) : lIdeal e →ₗ[R] X where
  toFun a := a.val • x
  map_add' a b := add_smul a.val b.val x
  map_smul' a b := mul_smul a b.val x

omit [DirectSum.Decomposition G] in
/-- A generator of weight j produces a degree-preserving map after placing the
loading idempotent in weight j. -/
theorem loadingGeneratorMap_mem_grade (A : ℤ → AddSubgroup R)
    (hact : ∀ ⦃i j : ℤ⦄ ⦃a : R⦄ ⦃x : X⦄, a ∈ A i → x ∈ G j → a • x ∈ G (i + j))
    {j n : ℤ} {x : X} (hx : x ∈ G j) (a : lIdeal e) (ha : a.val ∈ A (n - j)) :
    loadingGeneratorMap x a ∈ G n := by
  exact (sub_add_cancel n j) ▸ hact ha hx

section HomogeneousCover

variable {ι : Type*} (e : ι → R)

/-- The available loading label, the generator weight, and its vector. -/
abbrev HomogeneousLoadingGenerators :=
  Σ i : ι, Σ j : ℤ, {x : G j // e i • x.val = x.val}

local notation "Gen" => HomogeneousLoadingGenerators G e
set_option quotPrecheck false in
local notation "L" => fun t : Gen => lIdeal (e t.1)

/-- The direct sum of loading projectives on fixed homogeneous generators. -/
def homogeneousLoadingCover :
    (⨁ t : Gen, L t) →ₗ[R] X := by
  classical
  exact DirectSum.toModule R Gen X (fun t => loadingGeneratorMap t.2.2.val.val)

omit [DirectSum.Decomposition G] in
theorem homogeneousLoadingCover_projective (hprojective : ∀ i, Module.Projective R (lIdeal (e i))) :
    Module.Projective R (⨁ t : Gen, L t) := by
  classical
  let _ : ∀ t : Gen, Module.Projective R (L t) := fun t => hprojective t.1
  infer_instance

/-- An ordinary fixed-vector spanning family suffices to make the shifted cover onto. -/
theorem homogeneousLoadingCover_surjective_of_fixed (he : ∀ i, IsIdempotentElem (e i))
    (heG : ∀ i ⦃j : ℤ⦄ ⦃x : X⦄, x ∈ G j → e i • x ∈ G j)
    (hs : FixedLoadingSpan e X) : Function.Surjective (homogeneousLoadingCover G e) := by
  classical
  let C := LinearMap.range (homogeneousLoadingCover G e)
  apply LinearMap.range_eq_top.mp
  apply top_unique
  intro x _
  apply (Submodule.span_le.mpr ?_ : Submodule.span R {y | ∃ i, e i • y = y} ≤ C) (hs x)
  rintro y ⟨i, hy⟩
  rw [← DirectSum.sum_support_decompose G y]
  apply C.sum_mem
  intro j _
  let t : Gen := ⟨i, j, DirectSum.decompose G y j, projector_fixes_decompose G (heG i) hy j⟩
  let idm : L t := ⟨e i, (he i).eq⟩
  refine ⟨DirectSum.lof R Gen L t idm, ?_⟩
  unfold homogeneousLoadingCover
  rw [DirectSum.toModule_lof]
  exact t.2.2.property

omit [DirectSum.Decomposition G] in
/-- The underlying sum of shifted loading projectives is spanned by its
loading generators, regardless of their internal weights. -/
theorem homogeneousLoadingCover_fixedSpan (he : ∀ i, IsIdempotentElem (e i)) :
    FixedLoadingSpan e (⨁ t : Gen, L t) := by
  classical
  let P := Submodule.span R {x : ⨁ t : Gen, L t | ∃ i, e i • x = x}
  intro x
  induction x using DirectSum.induction_on with
  | zero => exact P.zero_mem
  | add a b ha hb => exact P.add_mem ha hb
  | of t a =>
    let idm : L t := ⟨e t.1, (he t.1).eq⟩
    have hfix : e t.1 • DirectSum.lof R Gen L t idm = DirectSum.lof R Gen L t idm := by
      rw [← map_smul]
      exact congrArg (DirectSum.lof R Gen L t) (Subtype.ext (he t.1).eq)
    rw [← DirectSum.lof_eq_of R, ← show a.val • idm = a from Subtype.ext a.property, map_smul]
    exact P.smul_mem _ (Submodule.subset_span ⟨t.1, hfix⟩)

variable (A : ℤ → AddSubgroup R) [DirectSum.Decomposition A]
variable (hact : ∀ ⦃i j : ℤ⦄ ⦃a : R⦄ ⦃x : X⦄, a ∈ A i → x ∈ G j → a • x ∈ G (i + j))

include hact in
private theorem homogeneous_scalar_projection {j : ℤ} {x : X} (hx : x ∈ G j)
    (a : R) (n : ℤ) :
    (DirectSum.decompose G (a • x) n : X) =
      (DirectSum.decompose A a (n-j) : R) • x := by
  induction a using DirectSum.Decomposition.inductionOn A with
  | zero => simp
  | @homogeneous i a =>
    by_cases h : i = n - j
    · have eq : i + j = n := by omega
      rw [DirectSum.decompose_of_mem_same G (eq ▸ hact a.property hx),
        DirectSum.decompose_of_mem_same A (h ▸ a.property)]
    · rw [DirectSum.decompose_of_mem_ne G (hact a.property hx) (by omega),
        DirectSum.decompose_of_mem_ne A a.property h, zero_smul]
  | add a b ha hb =>
    simp only [add_smul, DirectSum.decompose_add, DirectSum.add_apply, AddSubgroup.coe_add, ha, hb]

variable (hmul : ∀ ⦃i j : ℤ⦄ ⦃a b : R⦄, a ∈ A i → b ∈ A j → a * b ∈ A (i + j))

/-- A loading left ideal inherits the scalar grading. -/
def loadingIdealGrading (a : R) (n : ℤ) : AddSubgroup (lIdeal a) :=
  (A n).comap (lIdeal a).subtype.toAddMonoidHom

/-- The weight components of a vector fixed on the right by a weight-zero
idempotent remain fixed by that idempotent. -/
@[instance_reducible]
def loadingIdealGrading_decomposition (a : R) (ha : a ∈ A 0) :
    DirectSum.Decomposition (loadingIdealGrading A a) := by
  let F := (lIdeal a).subtype.toAddMonoidHom
  apply DirectSum.IsInternal.chooseDecomposition
  apply DG.isInternal_comap A F (Submodule.injective_subtype _)
  intro j x
  have hx : x.val * a = x.val := x.property
  have hfix : (DirectSum.decompose A x.val j : R) ∈ lIdeal a := by
    rw [mem_lIdeal]
    have h := homogeneous_scalar_projection A A (fun {_ _ _ _} h₁ h₂ => hmul h₁ h₂) ha x.val j
    change (DirectSum.decompose A (x.val * a) j : R) = (DirectSum.decompose A x.val (j-0) : R) * a at h
    rw [hx, sub_zero] at h
    exact h.symm
  exact ⟨⟨_, hfix⟩, rfl⟩

/-- A loading summand generated in weight j has its n-th piece in scalar
weight n-j. The auxiliary differential is zero. -/
@[instance_reducible]
def shiftedLoadingGradedGroup (a : R) (ha : a ∈ A 0) (j : ℤ) : DG.DGAddCommGroup (lIdeal a) := by
  let : DirectSum.Decomposition (loadingIdealGrading A a) := loadingIdealGrading_decomposition A hmul a ha
  exact {
    grading := fun n => loadingIdealGrading A a (n - j)
    decomposition := DirectSum.Decomposition.reindex (loadingIdealGrading A a) (Equiv.subRight j)
    d := 0
    d_mem' := fun _ => zero_mem _
    d_d' := fun _ => rfl }

/-- The projective cover inherits the direct sum of the shifted loading gradings. -/
def homogeneousLoadingCoverGrade (n : ℤ) : AddSubgroup (⨁ t : Gen, L t) where
  carrier := {x | ∀ t, (x t).val ∈ A (n-t.2.1)}
  zero_mem' t := by rw [DirectSum.zero_apply]; exact zero_mem _
  add_mem' hx hy t := by rw [DirectSum.add_apply]; exact add_mem (hx t) (hy t)
  neg_mem' hx t := by
    rw [neg_eq_zero_sub, DirectSum.sub_apply, DirectSum.zero_apply, zero_sub]
    exact neg_mem (hx t)

@[instance_reducible]
def homogeneousLoadingCoverGrade_decomposition (he₀ : ∀ i, e i ∈ A 0) :
    DirectSum.Decomposition (homogeneousLoadingCoverGrade G e A) := by
  classical
  let : ∀ t : Gen, DG.DGAddCommGroup (L t) := fun t =>
    shiftedLoadingGradedGroup A hmul (e t.1) (he₀ t.1) t.2.1
  exact (DG.DirectSum.isInternal_grading L).chooseDecomposition

omit [DirectSum.Decomposition G] [DirectSum.Decomposition A] in
include hmul in
theorem homogeneousLoadingCoverGrade_smul
    {i j : ℤ} {a : R} {x : ⨁ t : Gen, L t} (ha : a ∈ A i)
    (hx : x ∈ homogeneousLoadingCoverGrade G e A j) :
    a • x ∈ homogeneousLoadingCoverGrade G e A (i+j) := by
  change ∀ t, ((a • x) t).val ∈ A (i+j-t.2.1)
  intro t
  rw [DirectSum.smul_apply]
  change (a * (x t).val) ∈ A (i+j-t.2.1)
  rw [add_sub_assoc]
  exact hmul ha (hx t)

include hact in
omit [DirectSum.Decomposition G] [DirectSum.Decomposition A] in
theorem homogeneousLoadingCover_preserves_grade
    {n : ℤ} {x : ⨁ t : Gen, L t}
    (hx : x ∈ homogeneousLoadingCoverGrade G e A n) :
    homogeneousLoadingCover G e x ∈ G n := by
  classical
  have hsum : x = ∑ t ∈ x.support, DirectSum.of L t (x t) :=
    (DirectSum.sum_support_of x).symm
  conv in homogeneousLoadingCover G e x => rw [hsum]
  rw [map_sum]
  apply AddSubgroup.sum_mem
  intro t _
  rw [← DirectSum.lof_eq_of R]
  unfold homogeneousLoadingCover
  rw [DirectSum.toModule_lof]
  exact loadingGeneratorMap_mem_grade G A hact t.2.2.val.property (x t) (hx t)


end HomogeneousCover

end Categorification.ModuleFiltration
