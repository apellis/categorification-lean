import Categorification.WeightedKLR.RedStrands.TensorFormOrdered
import Categorification.WeightedKLR.RedStrands.TensorGenerators
import Categorification.WeightedKLR.RedStrands.TensorFactorSeparation

/-!
# Uniqueness of the form on ordered tensor products

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3,
Proposition 4.33, uniqueness. A system of sesquilinear forms on the ordered tensor products
`V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ}` which is `τ`-Hermitian and isometric along
`V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ₋₁} ⊗ {v_{λₙ}} ↪ V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ}` is the form `orderedForm`.

The proof follows Webster's induction on the number of factors. The subspace
`M' = V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ₋₁} ⊗ v_{λₙ}` is stable under `ρ̄(F_i)`, which is a multiple of
`K E_i`, and the vectors `g m` with `g` a product of divided powers of the `F_i` and
`m ∈ M'` span the tensor product.

Webster's three conditions do not fix the form on the tensor product with no factors, which is
the scalar field; the theorem `orderedForm_unique` takes the standard form `x̄ y` there as an
explicit normalization.
-/

noncomputable section
namespace Categorification.Stendhal.TensorPairing

open LieLean LieLean.QuantumGroup LieLean.QuantumGroup.GrandLoop LusztigF TensorProduct FirstWeight
open scoped TensorProduct

local notation "𝕂" => RatFunc ℚ
local notation "q" => (RatFunc.X : 𝕂)
local instance : NeZero q := ⟨RatFunc.X_ne_zero⟩
variable {I Y : Type*} [DecidableEq I] [AddCommGroup Y] {D : LusztigCartanDatum I}
  {R : D.RootDatum Y} {m : ℕ}
local notation "𝕌" => QuantumGroup R q
local notation "τ" => fun (u : 𝕌) => barHom R (rho R q u)

section Stable

variable (wt : Fin (m + 1) → Dom R)

/-- Tensoring with the highest-weight vector of the last factor. -/
private def appendHighest :
    TensorSpace (fun j => wt (Fin.castSucc j)) →ₗ[𝕂] TensorSpace wt :=
  (tensorSplitLast wt).symm.toLinearMap ∘ₗ
    (TensorProduct.mk 𝕂 _ _).flip (IrreducibleModule.hwv R q (wt (Fin.last m)).1)

private theorem appendHighest_apply (x : TensorSpace (fun j => wt (Fin.castSucc j))) :
    appendHighest wt x = appendTensor wt x (IrreducibleModule.hwv R q (wt (Fin.last m)).1) := rfl

/-- The elements of `U` preserving `M' = V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ₋₁} ⊗ v_{λₙ}`. -/
private def appendStabilizer : Subalgebra 𝕂 𝕌 where
  carrier := {u | ∀ x, ∃ x', tensorRepresentation wt u (appendHighest wt x) = appendHighest wt x'}
  mul_mem' {u u'} hu hu' x := by
    obtain ⟨x₁, h₁⟩ := hu' x
    obtain ⟨x₂, h₂⟩ := hu x₁
    exact ⟨x₂, by rw [map_mul, Module.End.mul_apply, h₁, h₂]⟩
  add_mem' {u u'} hu hu' x := by
    obtain ⟨x₁, h₁⟩ := hu x
    obtain ⟨x₂, h₂⟩ := hu' x
    exact ⟨x₁ + x₂, by rw [map_add, LinearMap.add_apply, h₁, h₂, map_add]⟩
  algebraMap_mem' c x := ⟨c • x, by rw [AlgHom.commutes, Module.algebraMap_end_apply, map_smul]⟩

private theorem E_mem_appendStabilizer (i : I) : E R q i ∈ appendStabilizer wt := fun x =>
  ⟨tensorRepresentation _ (E R q i) x, by
    rw [appendHighest_apply, tensorRepresentation_E_append, IrreducibleModule.E_smul_hwv]
    simp [appendTensor, appendHighest_apply]⟩

private theorem K_mem_appendStabilizer (μ : Y) : K R q μ ∈ appendStabilizer wt := fun x =>
  ⟨q ^ (wt (Fin.last m)).1 μ • tensorRepresentation _ (K R q μ) x, by
    rw [appendHighest_apply, tensorRepresentation_K_append,
      show K R q μ • IrreducibleModule.hwv R q (wt (Fin.last m)).1 =
        q ^ (wt (Fin.last m)).1 μ • IrreducibleModule.hwv R q (wt (Fin.last m)).1 from
        IrreducibleModule.hwv_mem_weightSpace μ]
    simp only [appendTensor, appendHighest_apply, TensorProduct.tmul_smul]
    rw [← TensorProduct.smul_tmul', map_smul]⟩

/-- `ρ̄(g)` preserves `M'` for every `g` in the subalgebra generated by the `F_i`. -/
private theorem rho_barHom_mem_appendStabilizer {g : 𝕌}
    (hg : g ∈ Algebra.adjoin 𝕂 (Set.range (F R q))) :
    rho R q (barHom R g) ∈ appendStabilizer wt := by
  induction hg using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    rw [barHom_F, rho_F, rhoF]
    exact Subalgebra.smul_mem _
      (Subalgebra.mul_mem _ (K_mem_appendStabilizer wt _) (E_mem_appendStabilizer wt i)) _
  | algebraMap c =>
    rw [barHom_algebraMap, rho_algebraMap]
    exact Subalgebra.algebraMap_mem _ _
  | add x y _ _ hx hy => rw [map_add, map_add]; exact Subalgebra.add_mem _ hx hy
  | mul x y _ _ hx hy => rw [map_mul, rho_mul]; exact Subalgebra.mul_mem _ hy hx

private theorem tau_rho_barHom (g : 𝕌) : τ (rho R q (barHom R g)) = g := by
  simp only [rho_rho, barHom_barHom]

end Stable

local notation "divF" => fun (i : I) (n : ℕ) => qDivPow (q ^ D.d i) n (F R q i)

private theorem divF_mem_adjoin (i : I) (a : ℕ) :
    divF i a ∈ Algebra.adjoin 𝕂 (Set.range (F R q)) :=
  Subalgebra.smul_mem _ (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_range_self i)) _) _

/-- Every word vector with at least one red strand is `g m` with `g` generated by the `F_i` and
`m ∈ M'`. -/
private theorem tensorWordVector_eq_smul_appendHighest : ∀ {m : ℕ} (w : TensorWord I (m + 1))
    (wt : Fin (m + 1) → Dom R), ∃ g ∈ Algebra.adjoin 𝕂 (Set.range (F R q)), ∃ x,
      tensorWordVector w wt = tensorRepresentation wt g (appendHighest wt x)
  | _, .red w, wt => by
    exact ⟨1, Subalgebra.one_mem _, tensorWordVector w _, by
      rw [map_one, Module.End.one_apply, appendHighest_apply]; rfl⟩
  | _, .black w i a, wt => by
    obtain ⟨g, hg, x, hx⟩ := tensorWordVector_eq_smul_appendHighest w wt
    refine ⟨divF i a * g, Subalgebra.mul_mem _ (divF_mem_adjoin i a) hg, x, ?_⟩
    rw [map_mul, Module.End.mul_apply, ← hx]
    rfl

private theorem span_tensorWordVector_rational [Finite I] (hR : R.IsXRegular) {n : ℕ} (wt : Fin n → Dom R) :
    Submodule.span 𝕂 (Set.range (fun w : TensorWord I n => tensorWordVector w wt)) = ⊤ := by
  apply top_unique
  rw [← rationalSpan_integralTensor hR wt, Submodule.span_le, ← span_tensorWordVector wt]
  intro x hx
  induction hx using Submodule.span_induction with
  | mem y hy => exact Submodule.subset_span hy
  | zero => exact zero_mem _
  | add _ _ _ _ h₁ h₂ => exact add_mem h₁ h₂
  | smul a y _ h => rw [tensor_laurent_smul]; exact Submodule.smul_mem _ _ h

/-- Two `τ`-Hermitian forms on `V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ}` which agree on `M' × M'` agree. -/
theorem eq_of_adjoint_of_append [Finite I] (hR : R.IsXRegular) (wt : Fin (m + 1) → Dom R)
    (B B' : TensorSpace wt →ₛₗ[barRingHom] TensorSpace wt →ₗ[𝕂] 𝕂)
    (hB : ∀ u x y, B (tensorRepresentation wt u x) y = B x (tensorRepresentation wt (τ u) y))
    (hB' : ∀ u x y, B' (tensorRepresentation wt u x) y = B' x (tensorRepresentation wt (τ u) y))
    (happ : ∀ x y, B (appendTensor wt x (IrreducibleModule.hwv R q (wt (Fin.last m)).1))
        (appendTensor wt y (IrreducibleModule.hwv R q (wt (Fin.last m)).1)) =
      B' (appendTensor wt x (IrreducibleModule.hwv R q (wt (Fin.last m)).1))
        (appendTensor wt y (IrreducibleModule.hwv R q (wt (Fin.last m)).1))) :
    B = B' := by
  have hspan := span_tensorWordVector_rational hR wt
  -- Stage 1: the forms agree on `M' × V`.
  have h₁ : ∀ x, B (appendHighest wt x) = B' (appendHighest wt x) := by
    intro x
    refine LinearMap.ext_on_range hspan fun w => ?_
    obtain ⟨g, hg, z, hz⟩ := tensorWordVector_eq_smul_appendHighest w wt
    rw [hz, ← tau_rho_barHom g, ← hB, ← hB']
    obtain ⟨x', hx'⟩ := rho_barHom_mem_appendStabilizer wt hg x
    rw [hx']
    exact happ x' z
  -- Stage 2: the forms agree everywhere.
  refine LinearMap.ext_on_range hspan fun w => ?_
  obtain ⟨g, -, z, hz⟩ := tensorWordVector_eq_smul_appendHighest w wt
  refine LinearMap.ext fun y => ?_
  rw [hz, hB, hB', h₁]

/-- **Webster, arXiv:1309.3796v3, Proposition 4.33, uniqueness.** A system of sesquilinear
forms on the ordered tensor products of the `V_λ` which is `τ`-Hermitian, isometric along
`V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ₋₁} ⊗ {v_{λₙ}} ↪ V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ}`, and normalized on the empty tensor
product (Webster's conditions leave this scalar form free) is the form `orderedForm`. -/
theorem orderedForm_unique [Finite I] (hR : R.IsXRegular)
    (B : ∀ {n : ℕ} (wt : Fin n → Dom R), TensorSpace wt →ₛₗ[barRingHom] TensorSpace wt →ₗ[𝕂] 𝕂)
    (hempty : ∀ (wt : Fin 0 → Dom R) (x y : TensorSpace wt),
      B wt x y = RatFunc.bar (PiTensorProduct.isEmptyEquiv (R := 𝕂)
        (s := fun j => IrreducibleModule R q (wt j).1) _ x) *
        PiTensorProduct.isEmptyEquiv (R := 𝕂) (s := fun j => IrreducibleModule R q (wt j).1) _ y)
    (hadj : ∀ {n : ℕ} (wt : Fin n → Dom R) u x y,
      B wt (tensorRepresentation wt u x) y = B wt x (tensorRepresentation wt (τ u) y))
    (happ : ∀ {n : ℕ} (wt : Fin (n + 1) → Dom R) x y,
      B wt (appendTensor wt x (IrreducibleModule.hwv R q (wt (Fin.last n)).1))
        (appendTensor wt y (IrreducibleModule.hwv R q (wt (Fin.last n)).1)) =
      B (fun j => wt (Fin.castSucc j)) x y) :
    ∀ {n : ℕ} (wt : Fin n → Dom R), B wt = orderedForm hR wt
  | 0, wt => by
    refine LinearMap.ext fun x => LinearMap.ext fun y => ?_
    rw [hempty, orderedForm_empty]
  | n + 1, wt => by
    have ih := orderedForm_unique hR B hempty hadj happ (fun j => wt (Fin.castSucc j))
    refine eq_of_adjoint_of_append hR wt _ _ (hadj wt) (orderedForm_adjoint hR wt) fun x y => ?_
    rw [happ, ih, orderedForm_append_highest]

section Nondegenerate

/-- A sesquilinear form on `V ≅ M ⊗ N` that is the product of two left-separating forms on pure
tensors is left-separating. -/
private theorem separatingLeft_of_tmul {M N V : Type*} [AddCommGroup M] [AddCommGroup N]
    [AddCommGroup V] [Module 𝕂 M] [Module 𝕂 N] [Module 𝕂 V] (e : V ≃ₗ[𝕂] M ⊗[𝕂] N)
    (P : V →ₛₗ[barRingHom] V →ₗ[𝕂] 𝕂) (A : M →ₛₗ[barRingHom] M →ₗ[𝕂] 𝕂)
    (C : N →ₛₗ[barRingHom] N →ₗ[𝕂] 𝕂)
    (hP : ∀ x x' y y', P (e.symm (x ⊗ₜ y)) (e.symm (x' ⊗ₜ y')) = A x x' * C y y')
    (hA : ∀ x, (∀ x', A x x' = 0) → x = 0) (hC : ∀ y, (∀ y', C y y' = 0) → y = 0)
    (z : V) (hz : ∀ z', P z z' = 0) : z = 0 := by
  classical
  let b := Module.Free.chooseBasis 𝕂 N
  let f := TensorProduct.equivFinsuppOfBasisRight b (e z)
  have hzf : z = e.symm (f.sum fun j a => a ⊗ₜ b j) := by
    rw [← TensorProduct.equivFinsuppOfBasisRight_symm_apply, LinearEquiv.symm_apply_apply,
      LinearEquiv.symm_apply_apply]
  have key : ∀ m' n', ∑ j ∈ f.support, A (f j) m' * C (b j) n' = 0 := by
    intro m' n'
    have h := hz (e.symm (m' ⊗ₜ n'))
    rw [hzf, Finsupp.sum, map_sum, map_sum, LinearMap.sum_apply] at h
    simpa only [hP] using h
  have hf : f = 0 := by
    ext j
    by_cases hj : j ∈ f.support
    · refine hA _ fun m' => ?_
      let s := ∑ k ∈ f.support, RatFunc.bar (A (f k) m') • b k
      have hs : s = 0 := hC _ fun n' => by
        simp only [s, map_sum, LinearMap.sum_apply, LinearMap.map_smulₛₗ₂, smul_eq_mul]
        simpa [barRingHom] using key m' n'
      have h := congrArg (fun s => b.repr s j) hs
      simp [s, Finsupp.single_apply, hj] at h
      simpa using h
    · simpa using hj
  apply e.injective
  rw [map_zero]
  exact (TensorProduct.equivFinsuppOfBasisRight b).injective (by rw [map_zero]; exact hf)

/-- A sesquilinear form on `V ≅ M ⊗ N` that is the product of two right-separating forms on pure
tensors is right-separating. -/
private theorem separatingRight_of_tmul {M N V : Type*} [AddCommGroup M] [AddCommGroup N]
    [AddCommGroup V] [Module 𝕂 M] [Module 𝕂 N] [Module 𝕂 V] (e : V ≃ₗ[𝕂] M ⊗[𝕂] N)
    (P : V →ₛₗ[barRingHom] V →ₗ[𝕂] 𝕂) (A : M →ₛₗ[barRingHom] M →ₗ[𝕂] 𝕂)
    (C : N →ₛₗ[barRingHom] N →ₗ[𝕂] 𝕂)
    (hP : ∀ x x' y y', P (e.symm (x ⊗ₜ y)) (e.symm (x' ⊗ₜ y')) = A x x' * C y y')
    (hA : ∀ x', (∀ x, A x x' = 0) → x' = 0) (hC : ∀ y', (∀ y, C y y' = 0) → y' = 0)
    (z : V) (hz : ∀ z', P z' z = 0) : z = 0 := by
  classical
  let b := Module.Free.chooseBasis 𝕂 N
  let f := TensorProduct.equivFinsuppOfBasisRight b (e z)
  have hzf : z = e.symm (f.sum fun j a => a ⊗ₜ b j) := by
    rw [← TensorProduct.equivFinsuppOfBasisRight_symm_apply, LinearEquiv.symm_apply_apply,
      LinearEquiv.symm_apply_apply]
  have key : ∀ m' n', ∑ j ∈ f.support, A m' (f j) * C n' (b j) = 0 := by
    intro m' n'
    have h := hz (e.symm (m' ⊗ₜ n'))
    rw [hzf, Finsupp.sum, map_sum, map_sum] at h
    simpa only [hP] using h
  have hf : f = 0 := by
    ext j
    by_cases hj : j ∈ f.support
    · refine hA _ fun m' => ?_
      let s := ∑ k ∈ f.support, A m' (f k) • b k
      have hs : s = 0 := hC _ fun n' => by
        simpa [s, map_sum, mul_comm] using key m' n'
      have h := congrArg (fun s => b.repr s j) hs
      simp [s, Finsupp.single_apply, hj] at h
      simpa using h
    · simpa using hj
  apply e.injective
  rw [map_zero]
  exact (TensorProduct.equivFinsuppOfBasisRight b).injective (by rw [map_zero]; exact hf)

variable [Finite I] (hR : R.IsXRegular)

/-- Webster's one-factor form as a sesquilinear map. -/
private def webForm (w : Dom R) :
    IrreducibleModule R q w.1 →ₛₗ[barRingHom] IrreducibleModule R q w.1 →ₗ[𝕂] 𝕂 :=
  LinearMap.mk₂'ₛₗ _ _ (SingleBlack.websterForm w hR)
    (fun _ _ _ => by simp [SingleBlack.websterForm])
    (SingleBlack.websterForm_smul_left w hR)
    (fun _ _ _ => by simp [SingleBlack.websterForm])
    (SingleBlack.websterForm_smul_right w hR)

private theorem websterForm_separatingLeft (w : Dom R) (x : IrreducibleModule R q w.1)
    (h : ∀ y, SingleBlack.websterForm w hR x y = 0) : x = 0 := by
  refine IrreducibleModule.eq_zero_of_form_eq_zero (hR := hR) (hv' := hvn_ratFunc) fun y => ?_
  have := h (hwBar hR w y)
  simpa [SingleBlack.websterForm] using this

private theorem websterForm_separatingRight (w : Dom R) (y : IrreducibleModule R q w.1)
    (h : ∀ x, SingleBlack.websterForm w hR x y = 0) : y = 0 := by
  rw [← hwBar_hwBar hR w y]
  have : hwBar hR w y = 0 := by
    refine IrreducibleModule.eq_zero_of_form_eq_zero (hR := hR) (hv' := hvn_ratFunc) fun x => ?_
    rw [IrreducibleModule.form_comm]
    simpa [SingleBlack.websterForm] using h x
  rw [this, map_zero]

private theorem orderedFactorwise_separating : ∀ {n : ℕ} (wt : Fin n → Dom R),
    (∀ x, (∀ y, orderedFactorwise hR wt x y = 0) → x = 0) ∧
      (∀ y, (∀ x, orderedFactorwise hR wt x y = 0) → y = 0)
  | 0, wt => by
    let e := PiTensorProduct.isEmptyEquiv (R := 𝕂)
      (s := fun j => IrreducibleModule R q (wt j).1) (Fin 0)
    have hf : ∀ x y, orderedFactorwise hR wt x y = RatFunc.bar (e x) * e y := fun _ _ => rfl
    refine ⟨fun x h => e.injective ?_, fun y h => e.injective ?_⟩
    · have := h (e.symm 1)
      rw [hf, LinearEquiv.apply_symm_apply, mul_one] at this
      rw [show e x = 0 by simpa using this, map_zero]
    · have := h (e.symm 1)
      rw [hf, LinearEquiv.apply_symm_apply, map_one, one_mul] at this
      rw [this, map_zero]
  | _ + 1, wt => by
    have ih := orderedFactorwise_separating (fun j => wt (Fin.castSucc j))
    have hP : ∀ x x' y y', orderedFactorwise hR wt ((tensorSplitLast wt).symm (x ⊗ₜ y))
        ((tensorSplitLast wt).symm (x' ⊗ₜ y')) =
          orderedFactorwise hR _ x x' * webForm hR (wt (Fin.last _)) y y' :=
      fun x x' y y' => orderedFactorwise_append hR wt x x' y y'
    exact ⟨separatingLeft_of_tmul (tensorSplitLast wt) _ _ _ hP ih.1
        (websterForm_separatingLeft hR _),
      separatingRight_of_tmul (tensorSplitLast wt) _ _ _ hP ih.2
        (websterForm_separatingRight hR _)⟩

/-- **Webster, arXiv:1309.3796v3, Proposition 4.33, nondegeneracy.** The form `orderedForm`
on `V_{λ₁} ⊗ ⋯ ⊗ V_{λₙ}` is nondegenerate in both arguments. -/
theorem orderedForm_nondegenerate {n : ℕ} (wt : Fin n → Dom R) :
    (∀ x, (∀ y, orderedForm hR wt x y = 0) → x = 0) ∧
      (∀ y, (∀ x, orderedForm hR wt x y = 0) → y = 0) := by
  have hf : ∀ x y, orderedForm hR wt x y =
      orderedFactorwise hR wt x ((tensorCoproductEquiv hR wt).symm y) := fun _ _ => rfl
  refine ⟨fun x h => (orderedFactorwise_separating hR wt).1 x fun y => ?_,
    fun y h => ?_⟩
  · simpa [hf] using h (tensorCoproductEquiv hR wt y)
  · have := (orderedFactorwise_separating hR wt).2 _ fun x => by rw [← hf]; exact h x
    simpa using this

end Nondegenerate

end Categorification.Stendhal.TensorPairing
