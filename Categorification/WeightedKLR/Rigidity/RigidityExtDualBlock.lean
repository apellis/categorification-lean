import Categorification.WeightedKLR.Rigidity.RigidityExtCoevaluationTop
import Categorification.WeightedKLR.Rigidity.CoevaluationDualWord

/-!
# The cyclotomic block of the dual weight is semisimple

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §7.1, proof of
Proposition 7.8: the last term of the resolution of `L_λ` "is in the subcategory generated by
`M_λ`". Let `d` be the divided coevaluation word of `λ` along a reduced expression `w` of the
longest element, `ν = d̂` its black weight. The second red label `λ*` of the coevaluation standard
module is `-w₀λ`, and `d̄ = d.reverse` is the divided coevaluation word of `λ*` along the reversed
expression (`Stendhal.coevaluationDividedWord_reverse`). By Proposition 7.2 and Lemma 7.3 for `λ*`,
the cyclotomic quotient `R^{λ*}(ν)` has split Grothendieck group of rank one and the projective
`R^{λ*} 1_{d̄}` is simple of norm one, so every finite-dimensional module over `R^{λ*}(ν)` is a sum
of copies of `R^{λ*} 1_{d̄}` (`exists_linearEquiv_pi_cycDivProj_coevaluation`).
-/

noncomputable section

namespace Categorification.KLR.CycKLR

open KLRAlgebra Categorification.Graded QuantumGroup QuantumGroup.UDot _root_.Module KL2

attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} {k : Type} [Fintype I] [DecidableEq I] [Field k] {C : CartanDatum I}
    {Q : I → I → MvPolynomial (Fin 2) k} (hP : IsRouquierQ C Q)
    {X Y : Type*} [AddCommGroup X] [AddCommGroup Y] (RD : WeightDatum C X Y)

local notation "G" => hP.gradingDatum

omit [Fintype I] in
/-- The roots of the projective root datum sum to the pairing with the sum of the `iₓ`. -/
theorem rootSum_projectiveRootDatum (β : Multiset I) :
    (projectiveRootDatum RD).rootSum β.toFinsupp = RD.pair.flip (β.map RD.iX).sum := by
  induction β using Multiset.induction_on with
  | empty => simp
  | cons i β ih =>
    rw [← Multiset.singleton_add, Multiset.toFinsupp_add, (projectiveRootDatum RD).rootSum_add,
      Multiset.toFinsupp_singleton, (projectiveRootDatum RD).rootSum_single, one_smul,
      Multiset.map_add, Multiset.sum_add, map_add, ih, Multiset.map_singleton,
      Multiset.sum_singleton]
    rfl

omit [Fintype I] in
private theorem hasGdim_block (Λ : I → ℕ) (ν : Multiset I) : HasGdim (grade G Λ ν) := by
  let := module_finite (Q := Q) (ν := ν) (fun i j hij => by
    obtain ⟨c, hc, h⟩ := hP.polyInY_leading i j hij
    rw [h]
    exact hc.map Polynomial.C) (fun i => Polynomial.monic_X_pow (R := k) (Λ i))
  exact HasGdim.of_finiteDimensional _

omit [Fintype I] in
/-- A rank-one block whose divided projective `R^Λ 1_{d₁}` is simple of norm one: every finitely
generated module is a finite sum of copies of `R^Λ 1_{d₁}`, over any black weight `μ` equal to
that of `d₁` (stated along an equality `d₁ = d₂` of divided words). -/
theorem exists_linearEquiv_pi_lIdeal_of_rank_one (Λ : I → ℕ) (d₁ : List (I × ℕ))
    (hrank : finrank (LaurentPolynomial ℤ) (K0 (grade G Λ (expandDiv d₁ : Multiset I))) = 1)
    (hn : letI := hasGdim_block hP Λ (expandDiv d₁ : Multiset I)
      GProj.homGdim (dividedProjective G (fun i j => congrArg Neg.neg (C.symm i j)) C Λ
          (expandDiv d₁ : Multiset I) d₁ rfl)
        (dividedProjective G (fun i j => congrArg Neg.neg (C.symm i j)) C Λ
          (expandDiv d₁ : Multiset I) d₁ rfl) = 1)
    (hs : IsSimpleModule (CycKLR k Q (fun i => (Polynomial.X : Polynomial k) ^ Λ i)
        (expandDiv d₁ : Multiset I))
      (dividedProjective G (fun i j => congrArg Neg.neg (C.symm i j)) C Λ
          (expandDiv d₁ : Multiset I) d₁ rfl).carrier)
    {d₂ : List (I × ℕ)} (hd : d₁ = d₂) {μ : Multiset I} (h : (expandDiv d₂ : Multiset I) = μ)
    (M : Type*) [AddCommGroup M] [Module (CycKLR k Q (fun i => (Polynomial.X : Polynomial k) ^ Λ i) μ) M]
    [Module.Finite (CycKLR k Q (fun i => (Polynomial.X : Polynomial k) ^ Λ i) μ) M] :
    ∃ n : ℕ, Nonempty (M ≃ₗ[CycKLR k Q (fun i => (Polynomial.X : Polynomial k) ^ Λ i) μ]
      (Fin n → lIdeal (mk k Q (fun i => (Polynomial.X : Polynomial k) ^ Λ i) μ
        (hflip (divIdem (KLRAlgebra.Seq.ofList (expandDiv d₂) h) (blocksDiv d₂ 0)))))) := by
  subst hd h
  let := hasGdim_block hP Λ (expandDiv d₁ : Multiset I)
  obtain ⟨n, ⟨e⟩⟩ := GProj.exists_linearEquiv_pi_of_rank_one _ hrank hn M
  exact ⟨n, ⟨e.trans (LinearEquiv.piCongrRight fun _ =>
    LinearEquiv.ofEq _ _ (Submodule.ext fun _ => Iff.rfl))⟩⟩


variable (Λ : I → ℕ) (highest : X) (hΛ : ∀ i, (Λ i : ℤ) = RD.pair (RD.iY i) highest)
    (hR : (projectiveRootDatum RD).IsXRegular)
    {K H : Type*} [Field K] [ConditionallyCompleteLinearOrder K] [IsStrictOrderedRing K]
    [AddCommGroup H] [Module K H] (P : Matrix.Realization C.toLusztig.cartanMatrix K H)

local notation "Dc" => P.cartanDatum C.toLusztig.isGeneralizedCartan_cartanMatrix
local notation "cs" => P.coxeterSystem C.toLusztig.isGeneralizedCartan_cartanMatrix

/-- The pairings of the second red label: `⟨α_i^∨, λ*⟩ = -⟨α_i^∨, w₀λ⟩` with `w₀λ` the endpoint
of the reflection path, for the dual highest weight `(Σ ν) - λ`. -/
theorem pair_dualHighest_coevaluation (weight : P.integralWeights)
    (hweight : P.IsDominantIntegral (weight : Module.Dual K H))
    (match_weight : ∀ i, (weight : Module.Dual K H) (P.coroot i) =
      (RD.pair.flip highest ((projectiveRootDatum RD).coroot i) : K))
    (w : List I) (hw : (cs).IsReduced w.reverse) (i : I) :
    RD.pair (RD.iY i) (((expandDiv (Stendhal.coevaluationDividedWord Dc weight w) :
        Multiset I).map RD.iX).sum - highest) =
      -((Dc).coroot i (w.foldl (fun μ j => (Dc).reflection j μ) weight)) := by
  have h := Stendhal.coevaluation_endpoint_pairing (projectiveRootDatum RD) P
    (RD.pair.flip highest) weight match_weight w
    (Stendhal.nonnegativeReflectionPath_of_reduced P _ weight hweight w hw) i
  rw [rootSum_projectiveRootDatum, Stendhal.expand_coevaluationDividedWord] at *
  rw [← h, AddMonoidHom.sub_apply, map_sub]
  simp only [AddMonoidHom.flip_apply]
  change _ = -(RD.pair (RD.iY i) highest - RD.pair (RD.iY i) _)
  abel


include hP hR in
/-- **The cyclotomic block of the dual weight is semisimple** (Webster, arXiv:1309.3796v3, §7.1,
proof of Proposition 7.8). Let `w` be a reduced expression of the longest element (every simple
reflection a left descent), `d` the divided coevaluation word of `λ` along `w`. Every finitely
generated module over the cyclotomic quotient `R^{λ*}(ν)` of the second red label is a finite
sum of copies of `R^{λ*} 1_{d̄}`, by Proposition 7.2 and Lemma 7.3 for `λ* = -w₀λ`. -/
theorem exists_linearEquiv_pi_cycDivProj_coevaluation [FiniteDimensional K H]
    (weight : P.integralWeights)
    (hweight : P.IsDominantIntegral (weight : Module.Dual K H))
    (match_weight : ∀ i, (weight : Module.Dual K H) (P.coroot i) =
      (RD.pair.flip highest ((projectiveRootDatum RD).coroot i) : K))
    (w : List I) (hw : (cs).IsReduced w.reverse)
    (hlong : ∀ i, (cs).IsLeftDescent ((cs).wordProd w.reverse) i)
    (M : Type*) [AddCommGroup M]
    [Module (CycKLR k Q (fun j => (Polynomial.X : Polynomial k) ^ coevaluationLabels Λ RD highest
      (expandDiv (Stendhal.coevaluationDividedWord Dc weight w)) (Fin.last 1) j)
      (Stendhal.wordWt (expandDiv (Stendhal.coevaluationDividedWord Dc weight w)) 0)) M]
    [Module.Finite (CycKLR k Q (fun j => (Polynomial.X : Polynomial k) ^ coevaluationLabels Λ RD
      highest (expandDiv (Stendhal.coevaluationDividedWord Dc weight w)) (Fin.last 1) j)
      (Stendhal.wordWt (expandDiv (Stendhal.coevaluationDividedWord Dc weight w)) 0)) M] :
    ∃ n : ℕ, Nonempty (M ≃ₗ[CycKLR k Q (fun j => (Polynomial.X : Polynomial k) ^
        coevaluationLabels Λ RD highest
        (expandDiv (Stendhal.coevaluationDividedWord Dc weight w)) (Fin.last 1) j)
      (Stendhal.wordWt (expandDiv (Stendhal.coevaluationDividedWord Dc weight w)) 0)]
      (Fin n → Stendhal.cycDivProj Q (coevaluationLabels Λ RD highest
        (expandDiv (Stendhal.coevaluationDividedWord Dc weight w)))
        (Stendhal.coevaluationDividedWord Dc weight w))) := by
  let d := Stendhal.coevaluationDividedWord Dc weight w
  let highest' : X := ((expandDiv d : Multiset I).map RD.iX).sum - highest
  let weight' : P.integralWeights := -(w.foldl (fun μ j => (Dc).reflection j μ) weight)
  let Λ' : I → ℕ := fun j => coevaluationLabels Λ RD highest (expandDiv d) (Fin.last 1) j
  have hpair := pair_dualHighest_coevaluation RD highest P weight hweight match_weight w hw
  have hweight' : P.IsDominantIntegral (weight' : Module.Dual K H) :=
    Stendhal.isDominantIntegral_neg_foldl P _ weight w hweight hlong
  have match_weight' : ∀ i, (weight' : Module.Dual K H) (P.coroot i) =
      (RD.pair.flip highest' ((projectiveRootDatum RD).coroot i) : K) := by
    intro i
    change _ = ((RD.pair (RD.iY i) highest' : ℤ) : K)
    rw [hpair, ← P.coroot_cartanDatum_cast, map_neg]
  have hΛ' : ∀ i, (Λ' i : ℤ) = RD.pair (RD.iY i) highest' := by
    intro i
    obtain ⟨n, hn⟩ := hweight' i
    have h0 : (0 : ℤ) ≤ RD.pair (RD.iY i) highest' := by
      have := (match_weight' i).symm.trans hn
      have : ((RD.pair (RD.iY i) highest' : ℤ) : K) = ((n : ℤ) : K) := by
        rw [Int.cast_natCast]; exact this
      have := Int.cast_injective this
      omega
    change ((-(RD.pair (RD.iY i) (highest - _))).toNat : ℤ) = _
    rw [show -(RD.pair (RD.iY i) (highest - ((expandDiv d : Multiset I).map RD.iX).sum)) =
      RD.pair (RD.iY i) highest' by simp only [highest', map_sub]; abel]
    exact Int.toNat_of_nonneg h0
  have hw' : (cs).IsReduced w.reverse.reverse := by
    rw [List.reverse_reverse]; exact ((cs).isReduced_reverse_iff w).mp hw
  have hd : Stendhal.coevaluationDividedWord Dc weight' w.reverse = d.reverse :=
    Stendhal.coevaluationDividedWord_reverse Dc weight w
  have hrank := finrank_coevaluation_projectiveBlock hP Λ' RD highest' hΛ' hR P weight' hweight'
    match_weight' w.reverse hw'
  rw [← Stendhal.expand_coevaluationDividedWord] at hrank
  have hn := homGdim_dividedWord_of_websterNorm hP Λ' RD highest' hΛ' hR _
    (Stendhal.websterForm_coevaluationDividedWord P (dominantWeight Λ' RD highest' hΛ') hR
      weight' hweight' match_weight' w.reverse hw')
  have hs := isSimple_coevaluationProjective hP Λ' RD highest' hΛ' hR P weight' hweight'
    match_weight' w.reverse hw'
  exact exists_linearEquiv_pi_lIdeal_of_rank_one hP Λ' _ hrank hn hs hd
    (Stendhal.coe_expandDiv_reverse d) M

end Categorification.KLR.CycKLR
