import Categorification.KLR.IndFirstSlideQuad

/-!
# The image of `S(₁F_i N)` in `F_i(S N)` is the kernel `O`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, proof of
Proposition 5.5, `F`-part. The map `δ₁ : S(₁F_i N) → F_i(S N)` has image exactly the submodule
`O` generated by the ideal of diagrams whose last red strand ends strictly right of its position
in `θ + (i + β)`.

## Main results

* `firstIndGen_mem_range`: the generators `G [1 ⊗ (1 ⊗ n)]` lie in the image of `δ₁`.
-/

noncomputable section

namespace Categorification.TypeA
open Equiv
variable {n n' m : ℕ} (h : n + n' = m)

/-- If every position of the second block comes after the `q`-th position of the first block
under `u⁻¹`, then that position is at most `q`. -/
theorem shuffle_inl_le_of_inr_gt (u : Shuffle h) (q : Fin n)
    (hr : ∀ y : Fin n', u.1⁻¹ (blockEquiv h (Sum.inl q)) < u.1⁻¹ (blockEquiv h (Sum.inr y))) :
    (u.1⁻¹ (blockEquiv h (Sum.inl q))).val ≤ q.val := by
  set f := u.1⁻¹ (blockEquiv h (Sum.inl q))
  let φ : Fin m → Fin n ⊕ Fin n' := fun x => (blockEquiv h).symm (u.1 x)
  have hφ : Function.Injective φ := fun x y hxy =>
    u.1.injective ((blockEquiv h).symm.injective hxy)
  have hsub : (Finset.univ.filter (fun x : Fin m => x < f)).image φ ⊆
      (Finset.univ.filter (fun q' : Fin n => q' < q)).map Function.Embedding.inl := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 hz
    have hx : x < f := (Finset.mem_filter.1 hx).2
    rcases hφx : φ x with q' | y
    · refine Finset.mem_map.2 ⟨q', ?_, rfl⟩
      have hxq : x = u.1⁻¹ (blockEquiv h (Sum.inl q')) := by
        rw [← hφx]; simp [φ, Perm.inv_def]
      rw [hxq] at hx
      exact Finset.mem_filter.2 ⟨Finset.mem_univ _, u.2.1.lt_iff_lt.1 hx⟩
    · have hxy : x = u.1⁻¹ (blockEquiv h (Sum.inr y)) := by
        rw [← hφx]; simp [φ, Perm.inv_def]
      exact absurd (hxy ▸ hx) (not_lt.2 (hr y).le)
  have h1 := Finset.card_le_card hsub
  rw [Finset.card_image_of_injective _ hφ, Finset.card_map] at h1
  have h3 : (Finset.univ.filter (fun x : Fin m => x < f)).card = f.val := by
    rw [Finset.filter_gt_eq_Iio]; exact Fin.card_Iio f
  have h4 : (Finset.univ.filter (fun q' : Fin n => q' < q)).card = q.val := by
    rw [Finset.filter_gt_eq_Iio]; exact Fin.card_Iio q
  omega

end Categorification.TypeA

namespace Categorification.KLR.KLRAlgebra

open scoped TensorProduct

variable {I : Type*} [DecidableEq I] {k : Type*} [CommRing k]
  {Q : I → I → MvPolynomial (Fin 2) k}

local notation "Si" i:max => (Singleton.singleton i : Multiset I)

variable {ν₀ ν' : Multiset I} {i : I}

theorem quadTop_firstQuad_tmul (t : TensorKLR Q ν₀ ν') (c : KLRAlgebra k Q (Si i)) :
    quadTop (firstQuad ν₀ ν' i) (t ⊗ₜ (c ⊗ₜ 1)) = concat Q ν₀ ν' t ⊗ₜ c := by
  change TensorProduct.map _ _ _ = _
  rw [TensorProduct.map_tmul]
  change castAlg Q (rfl : ν₀ + ν' = ν₀ + ν') (concat Q ν₀ ν' t) ⊗ₜ castAlg Q (add_zero (Si i))
    (concat Q (Si i) 0 (c ⊗ₜ (1 : KLRAlgebra k Q 0))) = _
  rw [castAlg_eq_castKLR, castAlg_eq_castKLR, castKLR_rfl, concat_one_right]

/-- The idempotent `1_{ν₀ + i, ν'}` is absorbed by `ψ_d^* ι(1_{ν₀,ν'} ⊗ 1_i)`. -/
theorem botOne_mul_hflip_firstψ_appendR :
    botOne Q (firstQuad_h ν₀ ν' i) * (hflip (firstψ Q ν₀ ν' i) *
      appendR Q (ν₀ + ν') i (oneConcat Q ν₀ ν')) =
    hflip (firstψ Q ν₀ ν' i) * appendR Q _ i (oneConcat Q ν₀ ν') := by
  have h := congrArg hflip (appendR_oneConcat_mul_firstψ (Q := Q) (ν₀ := ν₀) (ν' := ν') (i := i))
  rw [hflip_mul, hflip_mul, hflip_appendR, hflip_oneConcat, hflip_botConcat] at h
  rw [h, ← mul_assoc, botOne_mul_botConcat]

/-- `ψ_d^* 1_{ν₀ + ν', i} ι(1 ⊗ d) ι(1_{ν₀,ν'} ⊗ 1_i) = G ι(ι_T(1 ⊗ (d ⊗ 1)))`. -/
theorem hflip_firstψ_mul_concat_appendR (d : KLRAlgebra k Q (Si i)) :
    hflip (firstψ Q ν₀ ν' i) * oneConcat Q (ν₀ + ν') (Si i) *
        concat Q (ν₀ + ν') (Si i) (1 ⊗ₜ d) * appendR Q _ i (oneConcat Q ν₀ ν') =
      firstG Q ν₀ ν' i * concat Q (ν₀ + ν') (Si i)
        (quadTop (firstQuad ν₀ ν' i) (1 ⊗ₜ (d ⊗ₜ 1))) := by
  have e1 : concat Q (ν₀ + ν') (Si i) (oneConcat Q ν₀ ν' ⊗ₜ d) =
      appendR Q _ i (oneConcat Q ν₀ ν') * concat Q (ν₀ + ν') (Si i) (1 ⊗ₜ d) := by
    rw [appendR_apply, ← concat_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  have e2 : concat Q (ν₀ + ν') (Si i) (1 ⊗ₜ d) * appendR Q _ i (oneConcat Q ν₀ ν') =
      concat Q (ν₀ + ν') (Si i) (oneConcat Q ν₀ ν' ⊗ₜ d) := by
    rw [appendR_apply, ← concat_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  rw [quadTop_firstQuad_tmul, concat_one, firstG, mul_assoc _ (oneConcat Q _ _),
    oneConcat_mul_concat, mul_assoc, e2, mul_assoc, oneConcat_mul_concat, e1, ← mul_assoc,
    ← mul_assoc, mul_assoc (botOne Q _), botOne_mul_hflip_firstψ_appendR]

end Categorification.KLR.KLRAlgebra

namespace Categorification.Stendhal

open KLR KLRAlgebra InductionAlong MulOpposite
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} {k : Type*} [DecidableEq I] [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ) (i : I) (θ β : Multiset I)

local notation "Si" j => (Singleton.singleton j : Multiset I)
local notation "Aₚ" => Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ)
local notation "S" => stendhalQ Q Λ
local notation "Aₗ" => Multiset.map (Sum.map (id : I → I) (fun _ : Fin 1 => Fin.last ℓ))
  (stendhalWeight 1 β)
local notation "affT" => firstIndAffine Q Λ i θ β
local notation "Aₚ₁" => Multiset.map (addRedColor ℓ) (stendhalWeight ℓ ((Si i) + θ))

variable (N : Type*) [AddCommGroup N] [Module k N] [Module (parabolicFactorAlgebra Q Λ θ β) N]
  [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N] (hQ : KLRSymm Q)

local notation "PI₁" => ParabolicInput Q Λ ((Si i) + θ) β (FirstIndLeft Q Λ i θ β N)
local notation "Rg" => LinearMap.range (firstIndDeltaT Q Λ i θ β N hQ)

/-- The generators `G [1 ⊗ (1 ⊗ n)]` lie in the image of `δ₁`. -/
theorem firstIndGen_mem_range (n : N) :
    firstIndGen Q Λ i θ β N hQ n ∈ Rg := by
  refine ⟨firstIndMk Q Λ i θ β N hQ (BalancedTensor.tmul (oneBimod S Aₚ₁ Aₗ)
    (show PI₁ from Ind.tmul (unitGen (leftAppendHom Q Λ i θ β)) n)), ?_⟩
  change firstIndShuffle Q Λ i θ β N hQ (BalancedTensor.tmul _ _) = _
  rw [firstIndShuffle_tmul, coe_oneBimod, ← concat_one, ← firstIndLeftMapK_smul, one_smul]
  change firstIndLeftMap Q Λ i θ β N hQ (Ind.tmul _ n) = _
  rw [firstIndLeftMap_tmul, show (unitGen (leftAppendHom Q Λ i θ β)).1 =
    parabolicAppendLeft Q Λ i θ β (parabolicInputMap Q Λ θ β 1) from
      (rfl : _ = parabolicAppendLeft Q Λ i θ β 1).trans
        (congrArg _ (map_one (parabolicInputMap Q Λ θ β)).symm),
    firstIndLayerAction_appendLeft, map_one, one_smul]

/-- The unit generators are fixed by `ι(1_{α,β'} ⊗ 1_i)`. -/
theorem firstIndUnitGen_eq (n : N) :
    firstIndUnitGen Q Λ i θ β N hQ n =
      affT (appendR S (Aₚ + Aₗ) (Sum.inl i) (oneConcat S Aₚ Aₗ)) •
        firstIndUnitGen Q Λ i θ β N hQ n := by
  have hm : oneConcat S Aₚ Aₗ • (BalancedTensor.tmul (oneBimod S Aₚ Aₗ)
      (show ParabolicInput Q Λ θ β N from n) : ParabolicShuffle Q Λ θ β N) =
      BalancedTensor.tmul (oneBimod S Aₚ Aₗ) (show ParabolicInput Q Λ θ β N from n) := by
    refine (congrArg (fun a => a • (BalancedTensor.tmul (oneBimod S Aₚ Aₗ)
      (show ParabolicInput Q Λ θ β N from n) : ParabolicShuffle Q Λ θ β N))
        (concat_one (Q := S) (ν := Aₚ) (ν' := Aₗ)).symm).trans ?_
    rw [concat_smul_tmul_oneBimod, one_smul]
  refine Eq.trans ?_ (firstIndUnit_smul Q Λ i θ β N hQ _ _)
  rw [hm]

/-- **The core step**: `x ψ_d^* 1_{α + β', i} ι(1 ⊗ d) [1 ⊗ (1 ⊗ n)]` lies in the image of `δ₁`. -/
theorem firstIndCore_mem (x : KLRAlgebra k S (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}))
    (d : KLRAlgebra k S {(Sum.inl i : I ⊕ Fin (ℓ + 1))}) (n : N) :
    affT (x * hflip (firstψ S Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1))) *
        oneConcat S (Aₚ + Aₗ) {(Sum.inl i : I ⊕ Fin (ℓ + 1))} *
        concat S (Aₚ + Aₗ) {(Sum.inl i : I ⊕ Fin (ℓ + 1))} (1 ⊗ₜ d)) •
      firstIndUnitGen Q Λ i θ β N hQ n ∈ Rg := by
  have h : affT (firstG S Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1)) *
        concat S (Aₚ + Aₗ) {(Sum.inl i : I ⊕ Fin (ℓ + 1))}
          (quadTop (firstQuad Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1))) (1 ⊗ₜ (d ⊗ₜ 1)))) •
        firstIndUnitGen Q Λ i θ β N hQ n =
      affT (botConcat S (firstQuad_h Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1)))
          (quadBot (firstQuad Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1))) (1 ⊗ₜ (d ⊗ₜ 1))) *
        firstG S Aₚ Aₗ (Sum.inl i : I ⊕ Fin (ℓ + 1))) •
        firstIndUnitGen Q Λ i θ β N hQ n := by
    let _ : Module (KLRAlgebra k S (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}))
        (FirstIndF Q Λ i θ β N hQ) := Module.compHom _ (firstIndAffine Q Λ i θ β).toRingHom
    have _ : IsScalarTower k (KLRAlgebra k S (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}))
        (FirstIndF Q Λ i θ β N hQ) := ⟨fun c a x => by
      change affT (c • a) • x = c • (affT a • x)
      rw [map_smul, smul_assoc]⟩
    exact KLRAlgebra.firstG_mul_concat_quadTop_smul
      (u := firstIndUnitGen Q Λ i θ β N hQ n)
      (fun s hs hs' T => firstIndAffine_e_concat_smul Q Λ i θ β N hQ s hs hs' T _) _
  have e : ∀ a b c d e : KLRAlgebra k S (Aₚ + Aₗ + {(Sum.inl i : I ⊕ Fin (ℓ + 1))}),
      a * b * c * d * e = a * (b * c * d * e) := fun _ _ _ _ _ => by simp only [mul_assoc]
  rw [firstIndUnitGen_eq, ← mul_smul, ← map_mul, e, hflip_firstψ_mul_concat_appendR, map_mul,
    mul_smul, h, map_mul, mul_smul]
  exact Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (firstIndGen_mem_range Q Λ i θ β N hQ n))

end Categorification.Stendhal
