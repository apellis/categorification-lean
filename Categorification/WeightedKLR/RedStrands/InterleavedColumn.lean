import Categorification.WeightedKLR.RedStrands.BlockKernelExits
import Categorification.KLR.ReturnCrossing

/-!
# The two generators at an interleaved bottom

Webster, arXiv:1309.3796v2, §6.1, Proposition 6.4 and the cut following (6.21).
At `b i a`, every PBW permutation into the source order has a reduced expression
through `i a b` or `a b i`. Using dots on top leaves both exit diagrams undotted.
This generation argument allows arbitrary strands outside the three positions.
-/
noncomputable section
namespace Categorification.Stendhal.BraidedStendhalAlgebra
open KLR KLRAlgebra TypeA Equiv MvPolynomial
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

private theorem append_descent {m j : ℕ} (hj : j+1 < m) {w : Perm (Fin m)}
    (h : w ⟨j+1,hj⟩ < w ⟨j,by omega⟩) {l : List ℕ} (hl : IsReduced m l)
    (hp : wordProd m l = w * sadj m j) :
    IsReduced m (l ++ [j]) ∧ wordProd m (l ++ [j]) = w := by
  have he : wordProd m (l ++ [j]) = w := by rw [wordProd_append,hp,wordProd_singleton,mul_assoc,TypeA.sadj_mul_self,mul_one]
  exact ⟨⟨validWord_append.2 ⟨hl.1,by simp [ValidWord]; omega⟩,by
    rw [he,List.length_append,List.length_singleton,hl.2,hp,length_mul_sadj_of_gt hj h]⟩,he⟩

private theorem two_descents {m p q : ℕ} (hp : p+1 < m) (hq : q+1 < m) (w : Perm (Fin m))
    (h : w ⟨p+1,hp⟩ < w ⟨p,by omega⟩)
    (h' : (w*sadj m p) ⟨q+1,hq⟩ < (w*sadj m p) ⟨q,by omega⟩) :
    ∃ l, IsReduced m (l ++ [q,p]) ∧ wordProd m (l ++ [q,p]) = w := by
  let u := w*sadj m p*sadj m q
  obtain ⟨l,hl,he⟩ := exists_reduced m u
  obtain ⟨hr,hw⟩ := append_descent hq h' hl he
  simpa only [List.append_assoc,List.singleton_append] using
    (show ∃ l, IsReduced m ((l ++ [q]) ++ [p]) ∧ wordProd m ((l ++ [q]) ++ [p]) = w from
      ⟨l,append_descent hp h hr hw⟩)

private theorem exit_expression {m j : ℕ} (hj : j+2 < m) (w : Perm (Fin m))
    (h : w ⟨j+2,hj⟩ < w ⟨j,by omega⟩) : ∃ l, (IsReduced m l ∧ wordProd m l = w) ∧
    (∃ u, l = u ++ [j+1,j]) ∨ (IsReduced m l ∧ wordProd m l = w) ∧ ∃ u, l = u ++ [j,j+1] := by
  have h₁ : j+1 < m := by omega
  by_cases hd : w ⟨j+1,h₁⟩ < w ⟨j,by omega⟩
  · obtain ⟨l,hl⟩ := two_descents h₁ hj w hd (by
      simpa only [Perm.mul_apply,sadj_apply_right h₁,sadj_apply_of_ne (k := j) (⟨j+2,hj⟩ : Fin m) (by simp) (by simp)] using h)
    exact ⟨_,Or.inl ⟨hl,l,rfl⟩⟩
  · have hd' := h.trans_le (le_of_not_gt hd)
    obtain ⟨l,hl⟩ := two_descents hj h₁ w hd' (by
      simpa only [Perm.mul_apply,sadj_apply_left hj,sadj_apply_of_ne (k := j+1) (⟨j,by omega⟩ : Fin m) (by dsimp; omega) (by dsimp; omega)] using h)
    exact ⟨_,Or.inr ⟨hl,l,rfl⟩⟩

variable {I : Type} [DecidableEq I] {k : Type*} [CommRing k] {ℓ : ℕ} {ν : Multiset I}
    (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)
local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card μ
local notation "R" => KLRAlgebra k (stendhalQ Q Λ) μ
local notation "raw" => ofKLR k Q Λ ν
variable (s : KLR.Seq (stendhalWeight ℓ ν)) (j : ℕ) (hj : j+2 < (stendhalWeight ℓ ν).card)
local notation "leg" => fun l : List ℕ => (ψw l * e s : R)

/-- The affine loading column is generated by the two undotted exits, even with
spectator blacks. Projecting the coefficients to their endpoint corners does not
change the products. Source: Webster v2, Prop. 6.4, used after (6.21). -/
theorem exists_interleavedColumn_exits (hQ : KLRSymm Q) {a b : Fin ℓ} {L M : List (Fin ℓ)}
    (hb : s.lbl ⟨j,by omega⟩ = .inr b) (ha : s.lbl ⟨j+2,hj⟩ = .inr a)
    (t : KLR.Seq μ) (ht : redWord t = L ++ a :: b :: M) (z : BraidedStendhalAlgebra k Q Λ ν) :
    ∃ x y, raw (e t) * z * raw (e s) = x * raw (leg [j+1,j]) + y * raw (leg [j,j+1]) := by
  let good := fun w : Perm (Fin m) => w ⟨j+2,hj⟩ < w ⟨j,by omega⟩
  let ρ := fun w => if hw : good w then (exit_expression hj w hw).choose else canWord m w
  have choice : IsReducedChoice ρ := by
    intro w; dsimp only [ρ]; split_ifs with hw
    · exact (exit_expression hj w hw).choose_spec.elim And.left And.left
    · exact ⟨isReduced_canWord _ w,wordProd_canWord _ w⟩
  obtain ⟨z,rfl⟩ := ofKLR_surjective z
  let B := lbasis («μ» := μ) (stendhalQ_symm Q Λ hQ) ρ choice
  let X := LinearMap.mulRight k (leg [j+1,j]); let Y := LinearMap.mulRight k (leg [j,j+1])
  have hh : e t * z * e s ∈ LinearMap.range X ⊔ LinearMap.range Y := by
    induction B.mem_span z using Submodule.span_induction with
    | zero => simp
    | add _ _ _ _ hx hy => rw [mul_add,add_mul]; exact add_mem hx hy
    | smul c _ _ hx => rw [mul_smul_comm,smul_mul_assoc]; exact Submodule.smul_mem _ _ hx
    | mem _ h =>
      obtain ⟨⟨s',w,d⟩,rfl⟩ := h
      rw [show B (s',w,d) = _ from lbasis_apply ..,mul_assoc,mul_assoc _ (e s'),e_mul_e]
      split_ifs with h
      swap
      · rw [mul_zero,mul_zero]; exact zero_mem _
      subst s'
      by_cases hw : w • s = t
      · have hg : good w := lt_of_redWord_eq_append ht
          (q := w ⟨j+2,hj⟩) (p := w ⟨j,by omega⟩)
          (by simpa [← hw,lbl_smul] using ha) (by simpa [← hw,lbl_smul] using hb)
        rcases (exit_expression hj w hg).choose_spec with ⟨_,u,hu⟩ | ⟨_,u,hu⟩
        · apply le_sup_left (a := LinearMap.range X) (b := LinearMap.range Y)
          exact ⟨e t * pol (monomial d 1) * ψw u,by simp only [X,LinearMap.mulRight_apply,ρ,dite_eq_left hg,hu,ψw_append,mul_assoc]⟩
        · apply le_sup_right (a := LinearMap.range X) (b := LinearMap.range Y)
          exact ⟨e t * pol (monomial d 1) * ψw u,by simp only [Y,LinearMap.mulRight_apply,ρ,dite_eq_left hg,hu,ψw_append,mul_assoc]⟩
      · have cut := e_mul_pol_ψw_e (Q := stendhalQ Q Λ) (monomial d (1 : k)) (ρ w) s
        rw [(choice w).2] at cut
        rw [← cut,← mul_assoc,e_mul_e,ite_eq_right (Ne.symm hw),zero_mul]; exact zero_mem _
  obtain ⟨_,⟨x,rfl⟩,_,⟨y,rfl⟩,he⟩ := Submodule.mem_sup.1 hh
  exact ⟨raw x,raw y,by simpa only [LinearMap.mulRight_apply,X,Y,map_mul,map_add] using (congrArg raw he.symm)⟩

variable (t : KLR.Seq (stendhalWeight ℓ ν)) (a b : Fin ℓ)
local notation "π" => AlgHom.comp (violMk k Q Λ ν) raw
local notation "V" => ViolQuotient k Q Λ ν
local notation "E" => (violMk k Q Λ ν) (redProj k Q Λ ν (redWord t))
local notation "p" => π (e s)
local notation "T" => IsIdempotentElem.Corner (isIdempotentElem_violMk_redProj k Q Λ ν (redWord t))
local notation "C" => RedBlock.crossingSpace (k := k) E p
local notation "K" => blockLoadingKernel Q Λ t a b
local notation "endAt" => fun w : List ℕ => wordProd m w • s

/-- The undotted leg with bottom `s`, in the globally violated loading column. -/
def interleavedLeg (w : List ℕ) (ho : redWord (endAt w) = redWord t) : C :=
  ⟨π (leg w),by
    change π (redIdem k Q Λ (redWord t)) * π (ψw w * e s) = π (ψw w * e s)
    rw [← map_mul π,ψw_mul_e,← mul_assoc,redIdem_mul_e,ite_eq_left ho],by
    change π _ * π _ = _; rw [← map_mul π,mul_assoc,e_mul_self]⟩

private theorem two_generators (hQ : KLRSymm Q) {L M : List (Fin ℓ)} (ht : redWord t = L ++ a :: b :: M)
    (hb : s.lbl ⟨j,by omega⟩ = .inr b) (ha : s.lbl ⟨j+2,hj⟩ = .inr a)
    (hl : redWord (endAt [j+1,j]) = redWord t) (hr : redWord (endAt [j,j+1]) = redWord t) (y : C) :
    ∃ d f : T, y = d • interleavedLeg Q Λ s t _ hl + f • interleavedLeg Q Λ s t _ hr := by
  classical
  obtain ⟨v,hv⟩ := violMk_surjective y.1
  let S := Finset.univ.filter (fun u : KLR.Seq μ => redWord u = redWord t)
  have ex (u : KLR.Seq μ) (hu : u ∈ S) := exists_interleavedColumn_exits Q Λ s j hj hQ hb ha u
    (((Finset.mem_filter.1 hu).2).trans ht) v
  choose x z hx using ex
  let mk := violMk k Q Λ ν
  let corner : V → T := fun d => ⟨E*d*E,d,rfl⟩
  let Lg : C := interleavedLeg Q Λ s t _ hl
  let Rg : C := interleavedLeg Q Λ s t _ hr
  have cut (d : V) (l : C) : (corner d).1 * l.1 = E*(d*l.1) := by
    change E*d*E*l.1 = _; rw [mul_assoc _ E,l.2.1,mul_assoc]
  have he : E*y.1*p = ∑ u ∈ S.attach, mk (raw (e u.1) * v * raw (e s)) := by
    change mk _ * y.1 * mk _ = _
    rw [← hv,← map_mul mk,← map_mul mk,redProj,redIdem,map_sum,Finset.sum_mul,Finset.sum_mul,map_sum]
    exact (Finset.sum_attach ..).symm
  refine ⟨∑ u ∈ S.attach, corner (mk (x u.1 u.2)),∑ u ∈ S.attach, corner (mk (z u.1 u.2)),?_⟩
  apply Subtype.ext
  have piece (u : {u // u ∈ S}) : E * mk (raw (e u.1)*v*raw (e s)) =
      ((corner (mk (x u.1 u.2)) • Lg : C) + corner (mk (z u.1 u.2)) • Rg).1 := by
    simp only [hx u.1 u.2,map_add,mul_add,map_mul mk]
    change E*(_*Lg.1) + E*(_*Rg.1) = (corner _).1*Lg.1 + (corner _).1*Rg.1
    rw [cut,cut]
  rw [y.2.1,y.2.2] at he
  calc y.1 = E * (∑ u ∈ S.attach, mk (raw (e u.1)*v*raw (e s))) := by rw [← he,y.2.1]
       _ = _ := by simp only [Finset.mul_sum,piece,Submodule.coe_add,Finset.sum_add_distrib,Finset.sum_smul,Submodule.coe_sum,Lg,Rg]

private theorem gather_two {S M N : Type*} [Ring S] [AddCommGroup M] [Module k M] [Module Sᵐᵒᵖ M]
    [AddCommGroup N] [Module k N] [Module S N] (l r : N) (gen : ∀ y, ∃ d f : S, y = d • l + f • r)
    (z : BalancedTensor k k S M N) : ∃ x y : M, z = BalancedTensor.tmul x l + BalancedTensor.tmul y r := by
  induction z using BalancedTensor.induction_on with
  | zero => exact ⟨0,0,by rw [BalancedTensor.zero_tmul,BalancedTensor.zero_tmul,add_zero]⟩
  | tmul x y => obtain ⟨d,f,rfl⟩ := gen y; exact ⟨MulOpposite.op d • x,MulOpposite.op f • x,by
      rw [BalancedTensor.tmul_add,BalancedTensor.op_smul_tmul,BalancedTensor.op_smul_tmul]⟩
  | add _ _ hx hy =>
    obtain ⟨x,y,rfl⟩ := hx; obtain ⟨u,v,rfl⟩ := hy
    exact ⟨x+u,y+v,by rw [BalancedTensor.add_tmul,BalancedTensor.add_tmul]; abel⟩

/-- Every marked class in the loading column at `b i a` is the sum of a left and
a right exit with coefficients in the actual higher submodule. This is a generating
pair, not a claim of independence or of saturation for arbitrary spectators. -/
theorem exists_interleavedKernelColumn_exits (hQ : KLRSymm Q) {L M : List (Fin ℓ)}
    (ht : redWord t = L ++ a :: b :: M) (hb : s.lbl ⟨j,by omega⟩ = .inr b) (ha : s.lbl ⟨j+2,hj⟩ = .inr a)
    (hl : redWord (endAt [j+1,j]) = redWord t) (hr : redWord (endAt [j,j+1]) = redWord t)
    (z : BalancedTensor k k T K C) : ∃ x y : K,
    z = BalancedTensor.tmul x (interleavedLeg Q Λ s t _ hl) + BalancedTensor.tmul y (interleavedLeg Q Λ s t _ hr) :=
  gather_two (S := T) _ _ (two_generators Q Λ s j hj t a b hQ ht hb ha hl hr) z

section ViolatedRelations
local notation "A" => BraidedStendhalAlgebra k Q Λ ν
local notation "mk" => violMk k Q Λ ν
local notation "pAt" => fun v : KLR.Seq μ => raw (e v)
local notation "L₀" => raw (leg [j+1,j])
local notation "R₀" => raw (leg [j,j+1])
local notation "l₀" => endAt [j+1,j]
local notation "r₀" => endAt [j,j+1]

private theorem leg_support (w : List ℕ) : pAt (endAt w) * raw (leg w) = raw (leg w) ∧
    raw (leg w) * pAt s = raw (leg w) := by
  constructor
  · rw [← map_mul, ← mul_assoc, e_mul_ψw, inv_smul_smul, mul_assoc, e_mul_self]
  · rw [← map_mul, mul_assoc, e_mul_self]

/-- In the interleaved column every globally violated stack is a sum of the two
exits with *both coefficients globally violated*. The violation can be supplied by
an exterior black: neither exit is required to be a descent to every violated loading.
Webster v2, §6.1, Prop. 6.4 and the cut following (6.21) in Lemma 6.8. -/
theorem exists_violated_interleaved_exits (hQ : KLRSymm Q) {L M : List (Fin ℓ)}
    (ht : redWord t = L ++ a :: b :: M) (hb : s.lbl ⟨j,by omega⟩ = .inr b)
    (ha : s.lbl ⟨j+2,hj⟩ = .inr a) (z : A) (hz : mk z = 0) :
    ∃ x y : A, mk x = 0 ∧ mk y = 0 ∧ pAt t * z * pAt s = x * L₀ + y * R₀ := by
  let words : IsReducedChoice (canWord m) := fun w => ⟨isReduced_canWord _ w,wordProd_canWord _ w⟩
  have hv := redProj_mul_mem_violSpan words hQ (redWord t) ((violMk_eq_zero_iff z).1 hz)
  suffices H : ∀ v ∈ violSpan k Q Λ ν (redWord t),
      ∃ x y : A, mk x = 0 ∧ mk y = 0 ∧ pAt t * v * pAt s = x * L₀ + y * R₀ by
    have cut : pAt t * redProj k Q Λ ν (redWord t) = pAt t :=
      (e_mul_redProj _ _).trans (ite_eq_left rfl)
    simpa only [← mul_assoc,cut] using H _ hv
  intro v hv
  induction hv using Submodule.span_induction with
  | zero => exact ⟨0,0,map_zero _,map_zero _,by simp⟩
  | add v w _ _ hv hw =>
    obtain ⟨x,y,hx,hy,he⟩ := hv; obtain ⟨c,d,hc,hd,hf⟩ := hw
    exact ⟨x+c,y+d,by rw [map_add,hx,hc,zero_add],by rw [map_add,hy,hd,zero_add],by
      rw [mul_add,add_mul,he,hf,add_mul,add_mul]; abel⟩
  | smul c v _ hv =>
    obtain ⟨x,y,hx,hy,he⟩ := hv
    exact ⟨c • x,c • y,by rw [map_smul,hx,smul_zero],by rw [map_smul,hy,smul_zero],by
      rw [mul_smul_comm,smul_mul_assoc,he,smul_add,smul_mul_assoc,smul_mul_assoc]⟩
  | mem v hv =>
    obtain ⟨u,i,d,hi,ho,rfl⟩ := hv
    obtain ⟨x,y,he⟩ := exists_interleavedColumn_exits Q Λ s j hj hQ hb ha i (ho.trans ht) d
    let g := pAt t * u * pAt i
    have hg : mk g = 0 := by simp only [g,map_mul,violMk_e hi,mul_zero]
    have hc : g * (pAt i * d * pAt s) = pAt t * (u * pAt i * d) * pAt s := by
      simp only [g,mul_assoc,← mul_assoc (pAt i) (pAt i),← map_mul raw,e_mul_self]
    exact ⟨g*x,g*y,by rw [map_mul,hg,zero_mul],by rw [map_mul,hg,zero_mul],by
      rw [← hc,he,mul_add,← mul_assoc,← mul_assoc]⟩

/-- Every two-exit relation in the globally violated column lifts to an affine
relation with the *prescribed* quotient coefficients and both cut projectors. This
includes a quotient relation at just one exit; its other affine coefficient need
only lift zero. Membership of the prescribed coefficients in the higher ideal is
therefore preserved. This does not lift a higher mark to the joint.
Source: Webster v2, §6.1, proof of Lemma 6.8 after (6.21). -/
theorem exists_interleavedRelation_affine_lift (hQ : KLRSymm Q) {L M : List (Fin ℓ)}
    (ht : redWord t = L ++ a :: b :: M) (hb : s.lbl ⟨j,by omega⟩ = .inr b)
    (ha : s.lbl ⟨j+2,hj⟩ = .inr a) (x y : V)
    (hx : mk (pAt t) * x * mk (pAt l₀) = x) (hy : mk (pAt t) * y * mk (pAt r₀) = y)
    (hxy : x * mk L₀ + y * mk R₀ = 0) :
    ∃ c d : A, mk (pAt t * c * pAt l₀) = x ∧ mk (pAt t * d * pAt r₀) = y ∧
      (pAt t * c * pAt l₀) * L₀ + (pAt t * d * pAt r₀) * R₀ = 0 := by
  obtain ⟨c,rfl⟩ := violMk_surjective x; obtain ⟨d,rfl⟩ := violMk_surjective y
  have hl := leg_support Q Λ s [j+1,j]; have hr := leg_support Q Λ s [j,j+1]
  obtain ⟨u,v,hu,hv,he⟩ := exists_violated_interleaved_exits Q Λ s j hj t a b hQ ht hb ha
    (c*L₀+d*R₀) (by simpa only [map_add,map_mul] using hxy)
  have h : pAt t * (c*L₀+d*R₀) = u*L₀+v*R₀ := by
    simpa only [mul_assoc,add_mul,hl.2,hr.2] using he
  have idem : pAt t * pAt t = pAt t := by rw [← map_mul,e_mul_self]
  refine ⟨c-u,d-v,by simpa only [map_mul,map_sub,hu,sub_zero] using hx,
    by simpa only [map_mul,map_sub,hv,sub_zero] using hy,?_⟩
  simp only [mul_assoc,hl.1,hr.1]
  rw [← mul_add,sub_mul,sub_mul,sub_add_sub_comm,← h,mul_sub,← mul_assoc,idem,sub_self]

end ViolatedRelations
end Categorification.Stendhal.BraidedStendhalAlgebra
