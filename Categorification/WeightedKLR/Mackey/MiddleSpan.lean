import Categorification.WeightedKLR.Mackey.JuxtaposedCorner
import Categorification.WeightedKLR.Mackey.ParabolicBasis

/-!
# Coset generators of the balanced tensor product of the middle parabolic

A step of the proof of B. Webster, *Weighted Khovanov–Lauda–Rouquier algebras*,
arXiv:1209.2463v4, Theorem 2.19 (injectivity half, after Khovanov–Lauda, arXiv:0803.4121v2,
Proposition 2.18). For `ν = ν' + ν''`, the right ideal `W_ν ι(1)` of `W_ν` is generated, as a
right `W_{ν'} ⊗ W_{ν''}`-module, by the coset elements `r u (u⁻¹ • D) c_u` of the
representatives `u` (`GalleryAlgebra.cosetElt`, `GalleryAlgebra.ParabolicRep`), for `D`
rank-ordered. Hence the balanced tensor product `MiddleTensor` of the middle parabolic is spanned
by the elements `(c_{u₁} ⊗ c_{u₂}) ⊗ y` (`Juxtapose.span_tmul_middleGen_eq_top`), the analogue of
the spanning set of Khovanov–Lauda used in the proof of Proposition 2.18.

## Main definitions

* `GalleryAlgebra.cosetW`: a coset element of a representative, as an element of `W_ν`.
* `GalleryAlgebra.RowGen`: the index set of the coset generators: a rank-ordered chamber and a
  representative for it.

## Main results

* `GalleryAlgebra.mul_inductionMap_one_mem_span`: `x ι(1)` is a combination of the products
  `c_u ι(y)`.
* `Juxtapose.span_tmul_middleGen_eq_top`: the balanced tensor product of the middle parabolic is
  spanned by the tensors `(c_{u₁} ⊗ c_{u₂}) ⊗ y`.
-/

namespace Categorification.WeightedKLR

open FullChamber GalleryAlgebra Juxtapose MulOpposite

open scoped TensorProduct

variable {I : Type*} [DecidableEq I] {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜]
  [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k] {Γ : WeightedGraph I 𝕜 k}

namespace GalleryAlgebra

variable {ν' ν'' : I →₀ ℕ}

/-- A coset element of a representative of a rank-ordered chamber lies in Webster's algebra. -/
theorem cosetElt_mem_corner (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops)
    {D : FullChamber Γ (ν' + ν'')} (hD' : D.IsRankOrdered) (u : ParabolicRep ν' D) :
    cosetElt k hD hZ ν' u.1 D ∈ Subsemigroup.corner (rankIdem k Γ (ν' + ν'')) := by
  rw [Subsemigroup.mem_corner_iff isIdempotentElem_rankIdem]
  have hl : e D * cosetElt k hD hZ ν' u.1 D = cosetElt k hD hZ ν' u.1 D := by
    rw [cosetElt, ← mul_assoc, e_mul_r,
      ite_eq_left_iff.2 fun h => (h (smul_inv_smul u.1 D).symm).elim]
  refine ⟨?_, ?_⟩
  · rw [← hl, ← mul_assoc, rankIdem_mul_e, ite_eq_left_iff.2 fun h => (h hD').elim]
  · rw [← cosetElt_mul_e hD hZ u.1 D, mul_assoc, e_mul_rankIdem,
      ite_eq_left_iff.2 fun h => (h u.2).elim]

variable (k) in
/-- The coset element `r u (u⁻¹ • D) c_u` of a representative `u` of a rank-ordered chamber `D`,
as an element of Webster's algebra `W_{ν' + ν''}`. -/
noncomputable def cosetW (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops) {D : FullChamber Γ (ν' + ν'')}
    (hD' : D.IsRankOrdered) (u : ParabolicRep ν' D) : WeightedKLRAlgebra k Γ (ν' + ν'') :=
  ⟨cosetElt k hD hZ ν' u.1 D, cosetElt_mem_corner hD hZ hD' u⟩

variable (Γ ν' ν'') in
/-- The index set of the coset generators of `W_{ν' + ν''} ι(1)`: a rank-ordered chamber `D` and
a representative `u` for it. -/
abbrev RowGen : Type _ :=
  Σ D : {D : FullChamber Γ (ν' + ν'') // D.IsRankOrdered}, ParabolicRep ν' D.1

variable (k) in
/-- The coset generator `r u (u⁻¹ • D) c_u ∈ W_{ν' + ν''}` of an index `(D, u)`. -/
noncomputable def rowGen (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops) (p : RowGen Γ ν' ν'') :
    WeightedKLRAlgebra k Γ (ν' + ν'') :=
  cosetW k hD hZ p.1.2 p.2

/-- `c_u ι(1) = c_u`. -/
theorem rowGen_mul_inductionMap_one (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops)
    (p : RowGen Γ ν' ν'') :
    rowGen k hD hZ p * inductionMap k Γ ν' ν'' 1 = rowGen k hD hZ p := by
  refine Subtype.ext ?_
  show cosetElt k hD hZ ν' p.2.1 p.1.1 * (inductionMap k Γ ν' ν'' 1).1 = _
  have h := e_mul_castGallery_splitIdem (k := k) (rfl : ν' + ν'' = ν' + ν'') p.2.2
    (isSeparated_sep _ _ _)
  rw [castGallery_rfl] at h
  rw [inductionMap_one, ← cosetElt_mul_e hD hZ p.2.1 p.1.1, mul_assoc, h, cosetElt_mul_e]
  rfl

section Span

variable {P : FullChamber Γ (ν' + ν'') → FullChamber Γ (ν' + ν'') →
    (Strand (ν' + ν'') → 𝕜) × (Strand (ν' + ν'') → 𝕜)}
  (hP : ∀ C E, IsChamberSegment C E (P C E)) (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops)
  (hΓ : Γ.PSymm) (hW : ∀ w : Wall Γ (ν' + ν''), IsRegular (w.factor (k := k)))
  (hL : ∀ (Q : MvPolynomial (Fin 2) k) (a b : Strand (ν' + ν'')), Γ.loop a.1 = some Q →
    a ≠ b → a.1 = b.1 → IsRegular (loopFactor Q a b))

include hP hΓ hW hL in
/-- **The right ideal `W_ν ι(1)` is generated by the coset elements** (the freeness step in the
proof of Webster, arXiv:1209.2463v4, Theorem 2.19, spanning half): for `x ∈ W_{ν' + ν''}`, `x ι(1)`
is a combination of the products `c_u ι(y)`, `c_u` the coset generators of the rank-ordered
chambers and `y ∈ W_{ν'} ⊗ W_{ν''}`. -/
theorem mul_inductionMap_one_mem_span (x : WeightedKLRAlgebra k Γ (ν' + ν'')) :
    x * inductionMap k Γ ν' ν'' 1 ∈ Submodule.span k (Set.range fun p :
      RowGen Γ ν' ν'' × (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'') =>
        rowGen k hD hZ p.1 * inductionMap k Γ ν' ν'' p.2) := by
  set T := Submodule.span k (Set.range fun p :
      RowGen Γ ν' ν'' × (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'') =>
        rowGen k hD hZ p.1 * inductionMap k Γ ν' ν'' p.2)
  set V := T.map (IsIdempotentElem.cornerVal (R := k) isIdempotentElem_rankIdem)
  suffices h : (x * inductionMap k Γ ν' ν'' 1).1 ∈ V by
    obtain ⟨y, hy, hxy⟩ := h
    rwa [show x * inductionMap k Γ ν' ν'' 1 = y from Subtype.ext hxy.symm]
  have hV : V = Submodule.span k (Set.range fun p :
      RowGen Γ ν' ν'' × (WeightedKLRAlgebra k Γ ν' ⊗[k] WeightedKLRAlgebra k Γ ν'') =>
        cosetElt k hD hZ ν' p.1.2.1 p.1.1.1 * (inductionMap k Γ ν' ν'' p.2).1) := by
    simp only [V, T, Submodule.map_span, ← Set.range_comp]
    rfl
  have hx : x.1 = rankIdem k Γ (ν' + ν'') * x.1 :=
    ((Subsemigroup.mem_corner_iff isIdempotentElem_rankIdem).1 x.2).1.symm
  have hx' : x.1 * rankIdem k Γ (ν' + ν'') = x.1 :=
    ((Subsemigroup.mem_corner_iff isIdempotentElem_rankIdem).1 x.2).2
  show x.1 * (inductionMap k Γ ν' ν'' 1).1 ∈ V
  rw [inductionMap_one, hx]
  unfold rankIdem splitIdem
  rw [Finset.sum_mul, Finset.sum_mul]
  refine Submodule.sum_mem _ fun D hD' => ?_
  rw [Finset.mul_sum]
  refine Submodule.sum_mem _ fun C' _ => ?_
  rw [Finset.mul_sum]
  refine Submodule.sum_mem _ fun C'' _ => ?_
  have hD'' := (Finset.mem_filter.1 hD').2
  by_cases hC : (chamber C' C'').IsRankOrdered
  · have hmem : e D * x.1 * e (chamber C' C'') ∈ cornerSpace k D (chamber C' C'') :=
      ⟨x.1, sandwich_apply _ _ _⟩
    have h := cornerSpace_le_span_cosetElt hP hD hZ hΓ hW hL (rfl : ν' + ν'' = ν' + ν'') hC hD''
      (isSeparated_chamber C' C'') hmem
    rw [hV]
    refine Submodule.span_mono ?_ h
    rintro _ ⟨⟨u, y⟩, rfl⟩
    exact ⟨(⟨⟨D, hD''⟩, u⟩, y), rfl⟩
  · have h0 : x.1 * e (chamber C' C'') = 0 := by
      rw [← hx', mul_assoc, rankIdem_mul_e, ite_eq_right_iff.2 fun h => (hC h).elim, mul_zero]
    rw [mul_assoc, h0, mul_zero]
    exact V.zero_mem

end Span

end GalleryAlgebra

namespace Juxtapose

variable {a b c d : I →₀ ℕ}

/-- `middleTop` on the reordered tensors: `(y_a ⊗ y_b) ⊗ (y_c ⊗ y_d) ↦ ι(y_a y_c) ⊗ ι(y_b y_d)`,
read from `(W_a ⊗ W_c) ⊗ (W_b ⊗ W_d)`. -/
theorem middleTop_symm_tmul (y : WeightedKLRAlgebra k Γ a ⊗[k] WeightedKLRAlgebra k Γ c)
    (z : WeightedKLRAlgebra k Γ b ⊗[k] WeightedKLRAlgebra k Γ d) :
    middleTop k Γ a b c d ((Algebra.TensorProduct.tensorTensorTensorComm k k k k
      (WeightedKLRAlgebra k Γ a) (WeightedKLRAlgebra k Γ b) (WeightedKLRAlgebra k Γ c)
      (WeightedKLRAlgebra k Γ d)).symm (y ⊗ₜ z)) =
      inductionMap k Γ a c y ⊗ₜ inductionMap k Γ b d z := by
  simp only [middleTop, LinearMap.coe_comp, Function.comp_apply, AlgEquiv.toLinearMap_apply,
    AlgEquiv.apply_symm_apply, TensorProduct.map_tmul, inductionLin_apply]

variable (Γ a b c d) in
/-- The index set of the coset generators of `MiddleTop`: pairs of coset generators for `a + c`
and for `b + d`. -/
abbrev MiddleGen : Type _ := RowGen Γ a c × RowGen Γ b d

variable (k) in
/-- The coset generator `c_{u₁} ⊗ c_{u₂}` of `MiddleTop`. -/
noncomputable def middleGen (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops) (p : MiddleGen Γ a b c d) :
    MiddleTop k Γ a b c d :=
  ⟨rowGen k hD hZ p.1 ⊗ₜ rowGen k hD hZ p.2, by
    rw [mem_middleTopSub, middleTop_one, Algebra.TensorProduct.tmul_mul_tmul,
      rowGen_mul_inductionMap_one, rowGen_mul_inductionMap_one]⟩

theorem coe_middleGen (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops) (p : MiddleGen Γ a b c d) :
    (middleGen k hD hZ p : WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d)) =
      rowGen k hD hZ p.1 ⊗ₜ rowGen k hD hZ p.2 := rfl

variable {P₁ : FullChamber Γ (a + c) → FullChamber Γ (a + c) →
    (Strand (a + c) → 𝕜) × (Strand (a + c) → 𝕜)}
  (hP₁ : ∀ C E, IsChamberSegment C E (P₁ C E))
  {P₂ : FullChamber Γ (b + d) → FullChamber Γ (b + d) →
    (Strand (b + d) → 𝕜) × (Strand (b + d) → 𝕜)}
  (hP₂ : ∀ C E, IsChamberSegment C E (P₂ C E)) (hD : Γ.Dagger) (hZ : Γ.NoZeroLoops)
  (hΓ : Γ.PSymm) (hW₁ : ∀ w : Wall Γ (a + c), IsRegular (w.factor (k := k)))
  (hW₂ : ∀ w : Wall Γ (b + d), IsRegular (w.factor (k := k)))
  (hL₁ : ∀ (Q : MvPolynomial (Fin 2) k) (s t : Strand (a + c)), Γ.loop s.1 = some Q →
    s ≠ t → s.1 = t.1 → IsRegular (loopFactor Q s t))
  (hL₂ : ∀ (Q : MvPolynomial (Fin 2) k) (s t : Strand (b + d)), Γ.loop s.1 = some Q →
    s ≠ t → s.1 = t.1 → IsRegular (loopFactor Q s t))

include hP₁ hP₂ hΓ hW₁ hW₂ hL₁ hL₂ in
/-- **Coset generators of the balanced tensor product of the middle parabolic** (Webster,
arXiv:1209.2463v4, Theorem 2.19, injectivity half; after Khovanov–Lauda, arXiv:0803.4121v2,
proof of Proposition 2.18). `MiddleTensor` is spanned over `k` by the tensors
`(c_{u₁} ⊗ c_{u₂}) ⊗ y`, `c_{u₁}`, `c_{u₂}` coset generators for `a + c` and `b + d` and
`y ∈ MiddleBot`: the right `W_a ⊗ W_b ⊗ W_c ⊗ W_d`-module `MiddleTop` is generated by the
`c_{u₁} ⊗ c_{u₂}` (`GalleryAlgebra.mul_inductionMap_one_mem_span`). -/
theorem span_tmul_middleGen_eq_top :
    Submodule.span k (Set.range fun p : MiddleGen Γ a b c d × MiddleBot k Γ a b c d =>
      (BalancedTensor.tmul (middleGen k hD hZ p.1) p.2 : MiddleTensor k Γ a b c d)) = ⊤ := by
  set G := Submodule.span k (Set.range fun p : MiddleGen Γ a b c d × MiddleBot k Γ a b c d =>
      (BalancedTensor.tmul (middleGen k hD hZ p.1) p.2 : MiddleTensor k Γ a b c d))
  rw [eq_top_iff, ← BalancedTensor.span_tmul_eq_top, Submodule.span_le]
  rintro _ ⟨t, y, rfl⟩
  let f : (WeightedKLRAlgebra k Γ (a + c) ⊗[k] WeightedKLRAlgebra k Γ (b + d)) →ₗ[k]
      MiddleTensor k Γ a b c d :=
    { toFun := fun z => BalancedTensor.tmul
        (⟨z * middleTop k Γ a b c d 1, mul_middleTop_mem z 1⟩ : MiddleTop k Γ a b c d) y
      map_add' := fun z z' => by
        rw [← BalancedTensor.add_tmul]
        congr 1
        exact Subtype.ext (add_mul _ _ _)
      map_smul' := fun r z => by
        rw [RingHom.id_apply, ← BalancedTensor.smul_tmul]
        congr 1
        exact Subtype.ext (smul_mul_assoc _ _ _) }
  have hf : ∀ z, f z = BalancedTensor.tmul
      (⟨z * middleTop k Γ a b c d 1, mul_middleTop_mem z 1⟩ : MiddleTop k Γ a b c d) y :=
    fun _ => rfl
  have ht : BalancedTensor.tmul t y = f t.1 := by
    rw [hf]
    congr 1
    exact Subtype.ext t.2.symm
  rw [ht]
  set B := (TensorProduct.mk k (WeightedKLRAlgebra k Γ (a + c))
    (WeightedKLRAlgebra k Γ (b + d))).compr₂ f
  have hgen : ∀ (p₁ : RowGen Γ a c) (p₂ : RowGen Γ b d)
      (y₁ : WeightedKLRAlgebra k Γ a ⊗[k] WeightedKLRAlgebra k Γ c)
      (y₂ : WeightedKLRAlgebra k Γ b ⊗[k] WeightedKLRAlgebra k Γ d),
      B (rowGen k hD hZ p₁ * inductionMap k Γ a c y₁)
        (rowGen k hD hZ p₂ * inductionMap k Γ b d y₂) ∈ G := by
    intro p₁ p₂ y₁ y₂
    set w := (Algebra.TensorProduct.tensorTensorTensorComm k k k k
      (WeightedKLRAlgebra k Γ a) (WeightedKLRAlgebra k Γ b) (WeightedKLRAlgebra k Γ c)
      (WeightedKLRAlgebra k Γ d)).symm (y₁ ⊗ₜ y₂)
    have hw : (⟨(rowGen k hD hZ p₁ * inductionMap k Γ a c y₁) ⊗ₜ
        (rowGen k hD hZ p₂ * inductionMap k Γ b d y₂) * middleTop k Γ a b c d 1,
        mul_middleTop_mem _ 1⟩ : MiddleTop k Γ a b c d) = op w • middleGen k hD hZ (p₁, p₂) := by
      refine Subtype.ext ?_
      rw [coe_op_smul_middleTop, unop_op, coe_middleGen]
      show (rowGen k hD hZ p₁ * inductionMap k Γ a c y₁) ⊗ₜ
          (rowGen k hD hZ p₂ * inductionMap k Γ b d y₂) * middleTop k Γ a b c d 1 = _
      rw [← Algebra.TensorProduct.tmul_mul_tmul, ← middleTop_symm_tmul, mul_assoc,
        ← middleTop_mul, mul_one]
    show BalancedTensor.tmul (⟨(rowGen k hD hZ p₁ * inductionMap k Γ a c y₁) ⊗ₜ
        (rowGen k hD hZ p₂ * inductionMap k Γ b d y₂) * middleTop k Γ a b c d 1,
        mul_middleTop_mem _ 1⟩ : MiddleTop k Γ a b c d) y ∈ G
    rw [hw, BalancedTensor.op_smul_tmul]
    exact Submodule.subset_span ⟨((p₁, p₂), w • y), rfl⟩
  suffices hall : ∀ z, f z ∈ G from hall t.1
  intro z
  induction z using TensorProduct.inductionOn with
  | add z z' hz hz' => rw [map_add]; exact G.add_mem hz hz'
  | tmul x₁ x₂ =>
    have hidem : ∀ {μ μ' : I →₀ ℕ},
        (inductionMap k Γ μ μ' 1 * inductionMap k Γ μ μ' 1 : WeightedKLRAlgebra k Γ (μ + μ')) =
          inductionMap k Γ μ μ' 1 := fun {μ μ'} => by rw [← map_mul, mul_one]
    have hB : f (x₁ ⊗ₜ x₂) = B (x₁ * inductionMap k Γ a c 1) (x₂ * inductionMap k Γ b d 1) := by
      show f _ = f _
      rw [hf, hf]
      congr 1
      refine Subtype.ext ?_
      simp only [middleTop_one, TensorProduct.mk_apply, Algebra.TensorProduct.tmul_mul_tmul,
        mul_assoc, hidem]
    rw [hB]
    have h₁ := mul_inductionMap_one_mem_span hP₁ hD hZ hΓ hW₁ hL₁ x₁
    have h₂ := mul_inductionMap_one_mem_span hP₂ hD hZ hΓ hW₂ hL₂ x₂
    have hmem := Submodule.apply_mem_map₂ B h₁ h₂
    rw [Submodule.map₂_span_span] at hmem
    refine Submodule.span_le.2 ?_ hmem
    rintro _ ⟨_, ⟨⟨p₁, y₁⟩, rfl⟩, _, ⟨⟨p₂, y₂⟩, rfl⟩, rfl⟩
    exact hgen p₁ p₂ y₁ y₂

end Juxtapose

end Categorification.WeightedKLR
