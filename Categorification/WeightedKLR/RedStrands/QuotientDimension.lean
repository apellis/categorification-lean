import Categorification.WeightedKLR.RedStrands.QuotientBasis

/-!
# The dimensions of the violating quotient from cut diagrams

B. Webster, arXiv:1309.3796v2, Definition 4.6 and Proposition 4.16.
In each degree the kernel of the projection from the red-ordered algebra is
spanned by products of two standard terms meeting at a violated sequence,
whose degrees add to that degree. Rank-nullity computes the dimension in the
quotient from the rank of these products in the red-ordered algebra.
-/

namespace Categorification.Stendhal

open Equiv KLR TypeA StendhalAlgebraAllOrders
open Categorification.Graded

variable {I : Type} [DecidableEq I] {k : Type*} [Field k] {ℓ : ℕ} {ν : Multiset I}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ}
  {ρ : Perm (Fin (Multiset.card (stendhalWeight ℓ ν))) → List ℕ}
  (hρ : ∀ w, IsReduced (Multiset.card (stendhalWeight ℓ ν)) (ρ w) ∧
    wordProd (Multiset.card (stendhalWeight ℓ ν)) (ρ w) = w)

local notation "Term" => {b // IsStendhalTerm (ℓ := ℓ) (ν := ν) ρ b}
local notation "v" => stendhalTerm Q Λ (fun w => And.right (hρ w))
local notation "A" => StendhalAlgebra k Q Λ ν

variable (G : KLR.GradingDatum (stendhalQ Q Λ))

/-- The pair of standard diagrams admits a cut at a common violated sequence. -/
def hasViolatedCut (p : Term × Term) : Prop :=
  IsViolated p.1.1.1 ∧ p.1.1.1 = p.2.1.2.1 • p.2.1.1

/-- The products through violated sequences in total degree `d`, in the red-ordered algebra. -/
noncomputable def violatedProducts (d : ℤ) : Set A :=
  (fun p : Term × Term => v p.1 * v p.2) '' {p | hasViolatedCut p ∧
    G.stdDeg ρ p.1.1 + G.stdDeg ρ p.2.1 = d}

/-- A red-ordered standard diagram before projection is homogeneous in its diagram degree. -/
theorem stendhalTerm_mem_grade (b : Term) : v b ∈ stendhalGrade G ν (G.stdDeg ρ b.1) :=
  Graded.mem_map_of_mem _ _ (G.stdElt_mem_grade ρ b.1)

private theorem ker_mk_eq_span :
    LinearMap.ker (TensorProductAlgebra.mk Q Λ ν).toLinearMap =
      Submodule.span k ((fun p : Term × Term => v p.1 * v p.2) '' {p | hasViolatedCut p}) := by
  ext x
  rw [LinearMap.mem_ker]
  change (StendhalAlgebra.violatedIdeal k Q Λ ν).ringCon.mk' x = 0 ↔ _
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk', mem_violatedIdeal_iff hρ]
  suffices hs : {y | ∃ b b' : Term, IsViolated b.1.1 ∧ b.1.1 = b'.1.2.1 • b'.1.1 ∧
      y = v b * v b'} = (fun p : Term × Term => v p.1 * v p.2) '' {p | hasViolatedCut p} by
    rw [hs]
  ext y
  constructor
  · rintro ⟨b, b', hb, hbb', rfl⟩
    exact ⟨(b, b'), ⟨hb, hbb'⟩, rfl⟩
  · rintro ⟨⟨b, b'⟩, ⟨hb, hbb'⟩, rfl⟩
    exact ⟨b, b', hb, hbb', rfl⟩

/-- The degree-`d` relations for the violating quotient are generated by products
of homogeneous diagrams cut at a violated slice, in total degree `d`. -/
theorem grade_inf_ker_mk (d : ℤ) :
    stendhalGrade G ν d ⊓ LinearMap.ker (TensorProductAlgebra.mk Q Λ ν).toLinearMap =
      Submodule.span k (violatedProducts hρ G d) := by
  rw [ker_mk_eq_span hρ]
  exact inf_span_eq (stendhalGrade G ν) (fun p : Term × Term => G.stdDeg ρ p.1.1 + G.stdDeg ρ p.2.1)
    (fun p => SetLike.GradedMul.mul_mem (stendhalTerm_mem_grade hρ G p.1)
      (stendhalTerm_mem_grade hρ G p.2)) _ d

/-- There are only finitely many products to rank in a fixed degree: each factor's degree
is bounded below, and only finitely many terms occur in any degree. -/
theorem finite_violatedProducts (hX : ∀ a, 0 < G.degX a) (d : ℤ) :
    (violatedProducts hρ G d).Finite := by
  let D := fun b : Term => G.stdDeg ρ b.1
  have hf (n : ℤ) : {b : Term | D b = n}.Finite :=
    (G.finite_stdDeg_eq ρ hX n).preimage Subtype.val_injective.injOn
  obtain ⟨L, hL⟩ := G.bddBelow_stdDeg ρ (fun a => (hX a).le) Set.univ
  have hmin (b : Term) : L ≤ D b := hL ⟨b.1, Set.mem_univ _, rfl⟩
  refine Set.Finite.image _ (((Set.finite_Icc L (d-L)).biUnion
    (fun n _ => (hf n).prod (hf (d-n)))).subset ?_)
  rintro ⟨b, c⟩ ⟨_, hc⟩
  change D b + D c = d at hc
  simp only [Set.mem_iUnion, Set.mem_Icc, Set.mem_prod, Set.mem_ofPred_eq, exists_prop]
  exact ⟨D b, ⟨hmin b, by linarith [hmin c]⟩, rfl, by omega⟩

include hρ in
private theorem finite_stendhalGrade (hX : ∀ a, 0 < G.degX a) (d : ℤ) :
    FiniteDimensional k (stendhalGrade G ν d) := by
  have hspan := inf_span_eq (stendhalGrade G ν) (fun b : Term => G.stdDeg ρ b.1)
    (stendhalTerm_mem_grade hρ G) Set.univ d
  rw [Set.image_univ, top_unique (span_stendhalTerm (Q := Q) (Λ := Λ) hρ), inf_top_eq] at hspan
  have hf : {b : Term | b ∈ Set.univ ∧ G.stdDeg ρ b.1 = d}.Finite := by
    simpa using (G.finite_stdDeg_eq ρ hX d).preimage (Subtype.val_injective (p := IsStendhalTerm ρ)).injOn
  rw [hspan]
  exact FiniteDimensional.span_of_finite k (hf.image _)

/-- Rank-nullity for the finite diagram relations in degree `d`. The two terms on the
left are the quotient dimension and the rank of the products through violated slices. -/
theorem finrank_tensorProductGrade_add_finrank_violatedProducts (hX : ∀ a, 0 < G.degX a) (d : ℤ) :
    Module.finrank k (tensorProductGrade G ν d) +
      Module.finrank k (Submodule.span k (violatedProducts hρ G d)) =
      Module.finrank k (stendhalGrade G ν d) := by
  let := finite_stendhalGrade (ρ := ρ) hρ G hX d
  rw [← grade_inf_ker_mk hρ G]
  exact finrank_map_add_finrank_inf_ker _ _


section WeightedBasis

open WeightedKLR

variable {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  {Γ : WeightedGraph I 𝕜 k}
  (G : KLR.GradingDatum (stendhalQ Γ.klrQ Λ))

/-- In the setting of the Stendhal basis obtained through Webster's weighted algebra
(arXiv:1209.2463v4, Theorem 3.5), the degree-`d` quotient dimension is the number
of standard terms in that degree minus the rank of the finite family of cut products.
The graph hypotheses are those of `stendhalBasis`, used for independence in the
red-ordered algebra. -/
theorem finrank_tensorProductGrade_eq_card_sub_rank
    (hD : Γ.Dagger) (hE : ∀ e, Γ.head e ≠ Γ.tail e) (hl : ∀ c, Γ.loop c = none)
    (hw0 : ∀ e, Γ.weight e = 0) (hS : Γ.Standing) (hX : ∀ a, 0 < G.degX a) (d : ℤ) :
    Module.finrank k (tensorProductGrade G ν d) =
      Nat.card {b : Term | G.stdDeg ρ b.1 = d} -
        Module.finrank k (Submodule.span k (violatedProducts hρ G d)) := by
  have hf : {b : Term | G.stdDeg ρ b.1 = d}.Finite :=
    (G.finite_stdDeg_eq ρ hX d).preimage Subtype.val_injective.injOn
  have hnum := finrank_inf_span (stendhalGrade G ν) (fun b : Term => G.stdDeg ρ b.1)
    (linearIndependent_stendhalTerm (Λ := Λ) hD hE hl hw0 hS hρ)
    (stendhalTerm_mem_grade hρ G) Set.univ d (by simpa using hf)
  rw [Set.image_univ, top_unique (span_stendhalTerm (Q := Γ.klrQ) (Λ := Λ) hρ), inf_top_eq] at hnum
  simp only [Set.mem_univ, true_and] at hnum
  have h := finrank_tensorProductGrade_add_finrank_violatedProducts hρ G hX d
  omega

end WeightedBasis

end Categorification.Stendhal
