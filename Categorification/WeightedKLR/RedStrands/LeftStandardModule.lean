import Categorification.WeightedKLR.RedStrands.Projectives
import Categorification.WeightedKLR.RedStrands.StandardAction
import Categorification.Algebra.IdempotentEquiv

/-!
# Standard modules as left modules over `T^λ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2,
Definition 5.1, in the left-module form used by the filtrations of Proposition 5.20. For a
red-ordered loading `s`, the projective `T^λ e(s)` is the left ideal `lIdeal (e s)`; its
submodule `U_s` is the left ideal spanned by the elements `e(t) a e(s)` with `t` strictly above
`s` (`StendhalLT s t`, dominance of black counts), the images of the maps
`T^λ e(t) → T^λ e(s)`. The standard module is `S_s = T^λ e(s) / U_s`. The library's
`StendhalAlgebra.standardModule` is the right-module form over `T̃^λ`; Webster states
Definition 5.1 for right modules, and the two forms are exchanged by the anti-automorphism
reflecting diagrams.

## Main definitions

* `leftUpper`: the left ideal `U_s`.
* `leftStandard`: the left standard module `T^λ e(s) / U_s`.

## Main results

* `leftUpper_le_lIdeal`: `U_s ⊆ T^λ e(s)`.
* `leftStandardLift`: the universal property: a vector `z` with `e(s) z = z` and
  `e(t) a z = 0` for all `t` above `s` gives the map `S_s → Z` sending `[e(s)]` to `z`.
* `leftStandardLift_unit`, `leftStandard_hom_ext`: the lift sends the generator to `z` and is
  determined by it.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ} {ν : Multiset I}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)

local notation "A" => TensorProductAlgebra k Q Λ ν
local notation "μ" => stendhalWeight ℓ ν

/-- The idempotent `e(s)` of a red-ordered loading in `T^λ_ν`. -/
abbrev seqIdem (s : Seq μ) (hs : IsRedOrdered s) : A :=
  TensorProductAlgebra.mk Q Λ ν (StendhalAlgebra.e s hs)

theorem seqIdem_mul_self (s : Seq μ) (hs : IsRedOrdered s) :
    seqIdem Q Λ s hs * seqIdem Q Λ s hs = seqIdem Q Λ s hs :=
  isIdempotentElem_mk_e s hs

/-- **The submodule `U_s`** of Webster's Definition 5.1, left form: the left ideal of `T^λ`
spanned by the elements `e(t) a e(s)` with `t` strictly above `s`. -/
def leftUpper (s : Seq μ) (hs : IsRedOrdered s) : Submodule A A :=
  Submodule.span A
    {z | ∃ (t : Seq μ) (ht : IsRedOrdered t) (a : A),
      StendhalLT s t ∧ z = seqIdem Q Λ t ht * a * seqIdem Q Λ s hs}

theorem leftUpper_le_lIdeal (s : Seq μ) (hs : IsRedOrdered s) :
    leftUpper Q Λ s hs ≤ lIdeal (seqIdem Q Λ s hs) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨t, ht, a, -, rfl⟩
  change _ * _ = _
  rw [mul_assoc, seqIdem_mul_self]

/-- **The left standard module** `S_s = T^λ e(s) / U_s` (Webster, arXiv:1309.3796v2,
Definition 5.1, as a left `T^λ`-module). -/
abbrev leftStandard (s : Seq μ) (hs : IsRedOrdered s) : Type :=
  lIdeal (seqIdem Q Λ s hs) ⧸
    (leftUpper Q Λ s hs).comap (lIdeal (seqIdem Q Λ s hs)).subtype

/-- The generator `[e(s)]` of the standard module. -/
def leftStandardUnit (s : Seq μ) (hs : IsRedOrdered s) : leftStandard Q Λ s hs :=
  Submodule.Quotient.mk ⟨seqIdem Q Λ s hs, seqIdem_mul_self Q Λ s hs⟩

variable {Q Λ}

theorem leftStandard_mk_eq_smul_unit (s : Seq μ) (hs : IsRedOrdered s)
    (y : lIdeal (seqIdem Q Λ s hs)) :
    (Submodule.Quotient.mk y : leftStandard Q Λ s hs) =
      (y : A) • leftStandardUnit Q Λ s hs := by
  rw [leftStandardUnit, ← Submodule.Quotient.mk_smul]
  congr 1
  exact Subtype.ext y.2.symm

/-- The standard module is generated by `[e(s)]`. -/
theorem leftStandard_exists_smul_unit (s : Seq μ) (hs : IsRedOrdered s)
    (v : leftStandard Q Λ s hs) : ∃ a : A, v = a • leftStandardUnit Q Λ s hs := by
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  exact ⟨y, leftStandard_mk_eq_smul_unit s hs y⟩

variable (Q Λ) in
/-- `e(t)` kills the standard module `S_s` when `t` is strictly above `s`. -/
theorem seqIdem_smul_leftStandard_eq_zero {s t : Seq (stendhalWeight ℓ ν)} (hs : IsRedOrdered s)
    (ht : IsRedOrdered t) (hst : StendhalLT s t) (v : leftStandard Q Λ s hs) :
    seqIdem Q Λ t ht • v = 0 := by
  obtain ⟨a, rfl⟩ := leftStandard_exists_smul_unit s hs v
  rw [smul_smul, leftStandardUnit, ← Submodule.Quotient.mk_smul,
    Submodule.Quotient.mk_eq_zero]
  exact Submodule.subset_span ⟨t, ht, a, hst, rfl⟩

variable {Z : Type*} [AddCommGroup Z] [Module (TensorProductAlgebra k Q Λ ν) Z]

/-- The map `T^λ e(s) → Z`, `y ↦ y z`. -/
def lIdealEval (s : Seq μ) (hs : IsRedOrdered s) (z : Z) :
    lIdeal (seqIdem Q Λ s hs) →ₗ[A] Z where
  toFun y := (y : A) • z
  map_add' _ _ := add_smul _ _ _
  map_smul' _ _ := mul_smul _ _ _

theorem leftUpper_smul_eq_zero (s : Seq μ) (hs : IsRedOrdered s) (z : Z)
    (hz : ∀ (t : Seq μ) (ht : IsRedOrdered t) (a : A), StendhalLT s t →
      (seqIdem Q Λ t ht * a) • z = 0) {w : A} (hw : w ∈ leftUpper Q Λ s hs) :
    w • z = 0 := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨t, ht, a, hst, rfl⟩ := hw
    rw [mul_assoc]
    exact hz t ht _ hst
  | zero => exact zero_smul _ _
  | add _ _ _ _ h₁ h₂ => rw [add_smul, h₁, h₂, add_zero]
  | smul b _ _ h => rw [smul_eq_mul, mul_smul, h, smul_zero]

/-- **The universal property of the standard module**: if `e(t) a z = 0` whenever `t` lies
strictly above `s`, then `y ↦ y z` descends to `S_s → Z`. -/
def leftStandardLift (s : Seq μ) (hs : IsRedOrdered s) (z : Z)
    (hz : ∀ (t : Seq μ) (ht : IsRedOrdered t) (a : A), StendhalLT s t →
      (seqIdem Q Λ t ht * a) • z = 0) :
    leftStandard Q Λ s hs →ₗ[A] Z :=
  ((leftUpper Q Λ s hs).comap (lIdeal (seqIdem Q Λ s hs)).subtype).liftQ
    (lIdealEval s hs z) fun _ hy => leftUpper_smul_eq_zero s hs z hz hy

theorem leftStandardLift_unit (s : Seq μ) (hs : IsRedOrdered s) (z : Z)
    (hez : seqIdem Q Λ s hs • z = z)
    (hz : ∀ (t : Seq μ) (ht : IsRedOrdered t) (a : A), StendhalLT s t →
      (seqIdem Q Λ t ht * a) • z = 0) :
    leftStandardLift s hs z hz (leftStandardUnit Q Λ s hs) = z := hez

/-- Maps out of the standard module are determined by the image of `[e(s)]`. -/
theorem leftStandard_hom_ext (s : Seq μ) (hs : IsRedOrdered s)
    {f g : leftStandard Q Λ s hs →ₗ[A] Z}
    (h : f (leftStandardUnit Q Λ s hs) = g (leftStandardUnit Q Λ s hs)) : f = g := by
  refine LinearMap.ext fun v => ?_
  obtain ⟨a, rfl⟩ := leftStandard_exists_smul_unit s hs v
  rw [map_smul, map_smul, h]

end Categorification.Stendhal
