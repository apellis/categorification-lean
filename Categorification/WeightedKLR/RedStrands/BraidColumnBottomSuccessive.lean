import Categorification.Algebra.ModuleFiltration
import Categorification.WeightedKLR.RedStrands.BraidColumnBottomBruhat
import Categorification.WeightedKLR.RedStrands.BraidColumnBottomHigherTrace
import Categorification.WeightedKLR.RedStrands.BraidedStandardModule

/-!
# Successive quotients of a fixed-top braid column

Work in progress on Webster, arXiv:1309.3796v3, Lemma 6.12, p. 66.
The prefix stages are generated by the eligible bottom-block diagrams.
Multiplication by the newly added diagram is intended to descend from
its loading standard to the corresponding successive quotient. The
dimension comparison on p. 67 is a separate input.
-/

namespace Categorification.Stendhal
open KLR KLRAlgebra TypeA Equiv BraidedStendhalAlgebra MulOpposite
open scoped BigOperators
open MvPolynomial

variable {I k : Type} [DecidableEq I] [CommRing k] {ℓ : ℕ} {ν : Multiset I}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ}
local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card μ
local notation "R" => KLRAlgebra k (stendhalQ Q Λ) μ
local notation "V" => ViolQuotient k Q Λ ν
local notation "F" => AlgHom.comp (violMk k Q Λ ν) (ofKLR k Q Λ ν)
local notation "κ(" σ ")" => List.map σ (List.finRange ℓ)
local notation "E(" σ ")" => violMk k Q Λ ν (redProj k Q Λ ν κ(σ))
local notation "C(" σ ")" => (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ(σ))ᵐᵒᵖ
local notation "B(" s "," σ ")" => violCorner k Q Λ ν s κ(σ)

noncomputable def braidColumnBottomStage (s : Seq μ) (σ : Perm (Fin ℓ))
    (ρ : Perm (Fin m) → List ℕ) (P : Perm (Fin m) → Prop) :
    Submodule C(σ) B(s,σ) where
  carrier := {x | x.val ∈ Submodule.span k
    (braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ P)}
  zero_mem' := by
    change (0 : V) ∈ Submodule.span k (braidColumnBottomProductsAt s σ ρ P)
    exact zero_mem _
  add_mem' ha hb := add_mem ha hb
  smul_mem' a x hx := by
    change (a • x).val ∈ Submodule.span k
      (braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ P)
    rw [violCorner_smul_val]
    apply braidColumnBottomProductsAt_mul_mem_span s σ ρ P hx
    exact ((Subsemigroup.mem_corner_iff
      ((isIdempotentElem_redProj κ(σ)).map (violMk k Q Λ ν))).1 a.unop.2).2

theorem braidColumnBottomStage_mono (s : Seq μ) (σ : Perm (Fin ℓ))
    (ρ : Perm (Fin m) → List ℕ) {P P' : Perm (Fin m) → Prop}
    (h : ∀ u, P u → P' u) :
    braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ P ≤
      braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ P' := by
  intro x hx
  change x.val ∈ Submodule.span k (braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ P) at hx
  change x.val ∈ Submodule.span k (braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ P')
  refine (Submodule.span_mono ?_) hx
  intro y hy
  change y ∈ braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ P at hy
  change y ∈ braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ P'
  obtain ⟨n,hn,φ,hφ,hr,hp,z,hz,he⟩ := hy
  exact ⟨n,hn,φ,hφ,hr,h _ hp,z,hz,he⟩

noncomputable def braidColumnBottomStepKernel (s : Seq μ) (σ : Perm (Fin ℓ))
    (ρ : Perm (Fin m) → List ℕ) (P : Perm (Fin m) → Prop) (w : Perm (Fin m)) :
    Submodule C(σ) (braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ (fun u => P u ∨ u = w)) :=
  (braidColumnBottomStage s σ ρ P).comap
    (braidColumnBottomStage s σ ρ (fun u => P u ∨ u = w)).subtype

private theorem braidColumnBottomGenerator_support
    (s : Seq μ) (ρ : Perm (Fin m) → List ℕ) (hρ : IsReducedChoice ρ)
    (w : Perm (Fin m)) :
    F (e s : R) * F (ψw (ρ w) * e (w⁻¹ • s)) = F (ψw (ρ w) * e (w⁻¹ • s)) ∧
      F (ψw (ρ w) * e (w⁻¹ • s)) * F (e (w⁻¹ • s) : R) = F (ψw (ρ w) * e (w⁻¹ • s)) := by
  constructor
  · rw [← map_mul F,← mul_assoc,e_mul_ψw,(hρ w).2,mul_assoc,e_mul_self]
  · rw [← map_mul F,mul_assoc,e_mul_self]

noncomputable def braidColumnBottomStepMultiply
    (s : Seq μ) (σ : Perm (Fin ℓ)) (ρ : Perm (Fin m) → List ℕ) (hρ : IsReducedChoice ρ)
    (P : Perm (Fin m) → Prop)
    (n : Fin ℓ → ℕ) (hn : (∑ r, (n r + 1)) = m) (φ : Perm (Fin m))
    (hφ : ProjectiveBlockIndex s φ)
    (hr : ∀ r : Fin ℓ, (φ⁻¹ • s).lbl (braidBlockPositions n hn ⟨r,0⟩) = .inr r) :
    let w := braidColumnBottomBlockIndex n hn σ φ
    B(w⁻¹ • s,σ) →ₗ[C(σ)] braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ (fun u => P u ∨ u = w) := by
  let w := braidColumnBottomBlockIndex n hn σ φ
  let g := F (ψw (ρ w) * e (w⁻¹ • s))
  refine
    { toFun := fun x => ⟨⟨g * x.val, mem_violCorner_iff.2
        ⟨by
          change F (e s : R) * (g * x.val) = _
          rw [← mul_assoc,show F (e s : R) * g = g from (braidColumnBottomGenerator_support s ρ hρ w).1],
          by rw [mul_assoc,(mem_violCorner_iff.1 x.2).2]⟩⟩, ?_⟩
      map_add' := ?_
      map_smul' := ?_ }
  · change g * x.val ∈ Submodule.span k (braidColumnBottomProductsAt (Q := Q) (Λ := Λ)
      s σ ρ (fun u => P u ∨ u = w))
    exact Submodule.subset_span ⟨n,hn,φ,hφ,hr,Or.inr rfl,x.val,(mem_violCorner_iff.1 x.2).2,rfl⟩
  · intro x y
    exact Subtype.ext (Subtype.ext (mul_add _ _ _))
  · intro a x
    exact Subtype.ext (Subtype.ext (mul_assoc _ _ _).symm)

/-- The actual standard relation in Webster v3, Lemma 6.12, p. 66. The earlier
prefix is required to contain every strictly dominating eligible bottom. -/
noncomputable def braidColumnBottomStepMap
    (s : Seq μ) (hs : IsRedOrdered s) (σ : Perm (Fin ℓ)) (ρ : Perm (Fin m) → List ℕ)
    (hρ : IsReducedChoice ρ) (P : Perm (Fin m) → Prop)
    (n : Fin ℓ → ℕ) (hn : (∑ r, (n r + 1)) = m) (φ : Perm (Fin m))
    (hφ : ProjectiveBlockIndex s φ)
    (hr : ∀ r : Fin ℓ, (φ⁻¹ • s).lbl (braidBlockPositions n hn ⟨r,0⟩) = .inr r)
    (higher : ∀ u, StendhalLT ((braidColumnBottomBlockIndex n hn σ φ)⁻¹ • s) (u⁻¹ • s) → P u) :
    let w := braidColumnBottomBlockIndex n hn σ φ
    ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (w⁻¹ • s) κ(σ) →ₗ[C(σ)]
      ↥(braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ (fun u => P u ∨ u = w)) ⧸
        braidColumnBottomStepKernel (Q := Q) (Λ := Λ) s σ ρ P w := by
  let w := braidColumnBottomBlockIndex n hn σ φ
  let D := braidColumnBottomStepKernel (Q := Q) (Λ := Λ) s σ ρ P w
  refine (violStandardUpper (Q := Q) (Λ := Λ) (w⁻¹ • s) κ(σ)).liftQ
    (D.mkQ.comp (braidColumnBottomStepMultiply s σ ρ hρ P n hn φ hφ hr)) ?_
  intro z hz
  change D.mkQ _ = 0
  apply (Submodule.Quotient.mk_eq_zero D).2
  change _ ∈ Submodule.span k (braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ P)
  apply Submodule.span_mono (fun y hy => ?_)
    (braidColumnBottomBlock_mul_violStandardUpper_mem_higher_span s (w⁻¹ • s) hs σ ρ hρ
      _ (braidColumnBottomGenerator_support s ρ hρ w).1 z hz)
  obtain ⟨a,ha,v,hv,ht,hp,b,hb,he⟩ := hy
  exact ⟨a,ha,v,hv,ht,higher _ hp,b,hb,he⟩


theorem braidColumnBottomStepMap_surjective
    (s : Seq μ) (hs : IsRedOrdered s) (σ : Perm (Fin ℓ)) (ρ : Perm (Fin m) → List ℕ)
    (hρ : IsReducedChoice ρ) (P : Perm (Fin m) → Prop)
    (n : Fin ℓ → ℕ) (hn : (∑ r, (n r + 1)) = m) (φ : Perm (Fin m))
    (hφ : ProjectiveBlockIndex s φ)
    (hr : ∀ r : Fin ℓ, (φ⁻¹ • s).lbl (braidBlockPositions n hn ⟨r,0⟩) = .inr r)
    (higher : ∀ u, StendhalLT ((braidColumnBottomBlockIndex n hn σ φ)⁻¹ • s) (u⁻¹ • s) → P u) :
    Function.Surjective (braidColumnBottomStepMap (Q := Q) (Λ := Λ)
      s hs σ ρ hρ P n hn φ hφ hr higher) := by
  let w := braidColumnBottomBlockIndex n hn σ φ
  let b := w⁻¹ • s
  let g := F (ψw (ρ w) * e b)
  let D := braidColumnBottomStepKernel (Q := Q) (Λ := Λ) s σ ρ P w
  let S := Submodule.span k (braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ P)
  intro y
  obtain ⟨y,rfl⟩ := D.mkQ_surjective y
  have hh : y.val.val ∈ Submodule.span k
      (braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ (fun u => P u ∨ u = w)) := y.2
  have hgen (v : V) (hv : v ∈ Submodule.span k
      (braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ (fun u => P u ∨ u = w))) :
      ∃ x : B(b,σ), v - g * x.val ∈ S := by
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨n',hn',φ',hφ',hr',hp,z,hz,rfl⟩ := hv
      rcases hp with hP | he
      · refine ⟨0, ?_⟩
        change _ - g * (0 : V) ∈ S
        rw [mul_zero,sub_zero]
        exact Submodule.subset_span ⟨n',hn',φ',hφ',hr',hP,z,hz,rfl⟩
      · change braidColumnBottomBlockIndex n' hn' σ φ' = w at he
        rw [he]
        have hb : IsIdempotentElem (F (e b : R)) :=
          (show IsIdempotentElem (e b : R) from e_mul_self).map F
        refine ⟨⟨F (e b) * z, mem_violCorner_iff.2
          ⟨by rw [← mul_assoc,hb.eq],by rw [mul_assoc,hz]⟩⟩, ?_⟩
        change g * z - g * (F (e b) * z) ∈ S
        rw [← mul_assoc,(braidColumnBottomGenerator_support s ρ hρ w).2,sub_self]
        exact zero_mem _
    | zero => exact ⟨0, by change 0 - g * (0 : V) ∈ S; simp⟩
    | add v v' _ _ hv hv' =>
      obtain ⟨x,hx⟩ := hv
      obtain ⟨x',hx'⟩ := hv'
      refine ⟨x+x',?_⟩
      change v + v' - g * (x.val + x'.val) ∈ S
      rw [mul_add,add_sub_add_comm]
      exact add_mem hx hx'
    | smul c v _ hv =>
      obtain ⟨x,hx⟩ := hv
      refine ⟨c • x,?_⟩
      change c • v - g * (c • x.val) ∈ S
      rw [mul_smul_comm,← smul_sub]
      exact S.smul_mem c hx
  obtain ⟨x,hx⟩ := hgen y.val.val hh
  refine ⟨(violStandardUpper (Q := Q) (Λ := Λ) b κ(σ)).mkQ x,?_⟩
  change D.mkQ (braidColumnBottomStepMultiply s σ ρ hρ P n hn φ hφ hr x) = D.mkQ y
  rw [← sub_eq_zero,← map_sub]
  apply (Submodule.Quotient.mk_eq_zero D).2
  change g * x.val - y.val.val ∈ S
  rw [← neg_sub]
  exact S.neg_mem hx

end Categorification.Stendhal

namespace Categorification.Stendhal
open KLR KLRAlgebra TypeA Equiv BraidedStendhalAlgebra
open scoped BigOperators

variable {I : Type} [DecidableEq I] {ℓ : ℕ} {ν : Multiset I}
local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card μ

/-- The actual set of eligible compositions in the fixed-top column. -/
def IsBraidColumnBottomIndex (s : Seq μ) (σ : Perm (Fin ℓ)) (w : Perm (Fin m)) : Prop :=
  ∃ (n : Fin ℓ → ℕ) (hn : (∑ r, (n r + 1)) = m) (φ : Perm (Fin m)),
    ProjectiveBlockIndex s φ ∧
    (∀ r : Fin ℓ, (φ⁻¹ • s).lbl (braidBlockPositions n hn ⟨r,0⟩) = .inr r) ∧
    braidColumnBottomBlockIndex n hn σ φ = w

/-- Choices outside the set of eligible diagrams do not affect the stage. -/
def braidColumnBottomPrefix (s : Seq μ) (σ : Perm (Fin ℓ))
    (l : List (Perm (Fin m))) (w : Perm (Fin m)) : Prop :=
  w ∈ l ∨ ¬ IsBraidColumnBottomIndex s σ w

omit [DecidableEq I] in
private theorem braidColumnBottomPrefix_cons (s : Seq μ) (σ : Perm (Fin ℓ))
    (l : List (Perm (Fin m))) (w : Perm (Fin m)) :
    braidColumnBottomPrefix s σ (w :: l) = fun u => braidColumnBottomPrefix s σ l u ∨ u = w := by
  funext u
  apply propext
  simp only [braidColumnBottomPrefix,List.mem_cons]
  tauto

/-- The eligible wirings admit an exhaustive enumeration with each earlier
comparison occurring closer to the empty prefix. -/
theorem exists_braidColumnBottomEnumeration (s : Seq μ) (σ : Perm (Fin ℓ)) :
    ∃ (L : List (Perm (Fin m))),
      L.Nodup ∧ (∀ u, u ∈ L ↔ IsBraidColumnBottomIndex s σ u) ∧
      L.Pairwise (fun w u => ¬ braidColumnIndexEarlier s w u) := by
  classical
  obtain ⟨R,hR,hExt⟩ := exists_braidColumnIndexLinearRefinement s
  let : IsLinearOrder (Perm (Fin m)) (fun u w => R w u) :=
    { refl := fun u => hR.refl u
      trans := fun u v w huv hvw => hR.trans w v u hvw huv
      antisymm := fun u w huw hwu => hR.antisymm u w hwu huw
      total := fun u w => hR.total w u }
  let S := Finset.univ.filter (IsBraidColumnBottomIndex s σ)
  let L := S.sort (fun u w => R w u)
  refine ⟨L,S.sort_nodup _,?_,(S.pairwise_sort _).imp ?_⟩
  · intro u
    simp [L,S]
  · intro u w huw he
    exact (hExt u w he).2 huw

/-- Every strictly dominating eligible index of a given element lies in its
tail in a decreasing refinement. -/
private theorem braidColumnBottomPrefix_contains_higher (s : Seq μ) (σ : Perm (Fin ℓ))
    (L : List (Perm (Fin m)))
    (hL : ∀ u, u ∈ L ↔ IsBraidColumnBottomIndex s σ u)
    (hord : L.Pairwise fun w u => ¬ braidColumnIndexEarlier s w u)
    (l r : List (Perm (Fin m))) (w : Perm (Fin m)) (he : L = l ++ w :: r) :
    ∀ u, StendhalLT (w⁻¹ • s) (u⁻¹ • s) → braidColumnBottomPrefix s σ r u := by
  intro u hu
  by_cases h : IsBraidColumnBottomIndex s σ u
  · left
    have hmem := (hL u).2 h
    rw [he,List.mem_append] at hmem
    rcases hmem with hl | hr
    · rw [he,List.pairwise_append] at hord
      exact (hord.2.2 u hl w (List.mem_cons_self ..) (Or.inl hu)).elim
    · rcases List.mem_cons.1 hr with rfl | hr
      · exact (braidColumnIndexEarlier_irrefl s _ (Or.inl hu)).elim
      · exact hr
  · exact Or.inr h

end Categorification.Stendhal

namespace Categorification.Stendhal
open KLR KLRAlgebra TypeA Equiv BraidedStendhalAlgebra MulOpposite
open scoped BigOperators
open MvPolynomial

variable {I k : Type} [DecidableEq I] [CommRing k] {ℓ : ℕ} {ν : Multiset I}
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin ℓ → I →₀ ℕ}
local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card μ
local notation "W" => Perm (Fin m)
local notation "κ(" σ ")" => List.map σ (List.finRange ℓ)
local notation "C(" σ ")" => (ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ(σ))ᵐᵒᵖ
local notation "B(" s "," σ ")" => violCorner k Q Λ ν s κ(σ)

private theorem braidColumnBottomStage_empty (s : Seq μ) (σ : Perm (Fin ℓ))
    (ρ : W → List ℕ) :
    braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ (braidColumnBottomPrefix s σ []) = ⊥ := by
  have hempty : braidColumnBottomProductsAt (Q := Q) (Λ := Λ) s σ ρ
      (braidColumnBottomPrefix s σ []) = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.2
    rintro y ⟨n,hn,φ,hφ,hr,hP,_⟩
    exact hP.resolve_left List.not_mem_nil ⟨n,hn,φ,hφ,hr,rfl⟩
  ext x
  change x.val ∈ Submodule.span k _ ↔ x = 0
  rw [hempty,Submodule.span_empty,Submodule.mem_bot]
  exact ⟨Subtype.ext,fun h => congrArg Subtype.val h⟩

private theorem braidColumnBottomStage_full (s : Seq μ) (hs : IsRedOrdered s)
    (σ : Perm (Fin ℓ)) (ρ : W → List ℕ) (hρ : IsReducedChoice ρ) (L : List W)
    (hL : ∀ w, w ∈ L ↔ IsBraidColumnBottomIndex s σ w) :
    braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ (braidColumnBottomPrefix s σ L) = ⊤ := by
  apply top_unique
  intro x _
  change x.val ∈ Submodule.span k _
  have hx := x.2
  rw [← span_braidColumnBottomProducts s hs σ ρ hρ] at hx
  apply Submodule.span_mono (fun y hy => ?_) hx
  obtain ⟨n,hn,φ,hφ,hr,_,z,hz,he⟩ := hy
  exact ⟨n,hn,φ,hφ,hr,Or.inl ((hL _).2 ⟨n,hn,φ,hφ,hr,rfl⟩),z,hz,he⟩

/-- A stage is recorded by the newly added wiring and the list preceding it. -/
def braidColumnBottomSteps : List W → List (W × List W)
  | [] => []
  | w :: l => (w,l) :: braidColumnBottomSteps l

omit [DecidableEq I] in
private theorem braidColumnBottomSteps_mem {l : List W} {a : W × List W}
    (ha : a ∈ braidColumnBottomSteps l) : ∃ p, l = p ++ a.1 :: a.2 := by
  induction l with
  | nil => simp [braidColumnBottomSteps] at ha
  | cons w l ih =>
    rcases List.mem_cons.1 ha with rfl | ha
    · exact ⟨[],rfl⟩
    · obtain ⟨p,hp⟩ := ih ha
      exact ⟨w :: p,congrArg (List.cons w) hp⟩

noncomputable abbrev braidColumnBottomFactor (s : Seq μ) (σ : Perm (Fin ℓ))
    (ρ : W → List ℕ) (a : W × List W) :=
  ↥(braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ
    (fun u => braidColumnBottomPrefix s σ a.2 u ∨ u = a.1)) ⧸
  braidColumnBottomStepKernel s σ ρ (braidColumnBottomPrefix s σ a.2) a.1

/-- The successive quotients of the geometric prefix chain form a filtration
of the actual fixed-top column. This part uses generation and exactness of
submodule quotients, independent of the dimension identity. -/
theorem braidColumnBottom_hasFiltration_factors
    (s : Seq μ) (hs : IsRedOrdered s) (σ : Perm (Fin ℓ))
    (ρ : W → List ℕ) (hρ : IsReducedChoice ρ) (L : List W)
    (hL : ∀ w, w ∈ L ↔ IsBraidColumnBottomIndex s σ w) :
    ModuleFiltration.HasFiltration
      (fun a => ModuleCat.of C(σ) (braidColumnBottomFactor (Q := Q) (Λ := Λ) s σ ρ a))
      (braidColumnBottomSteps L) (ModuleCat.of C(σ) B(s,σ)) := by
  let X := fun l => braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ (braidColumnBottomPrefix s σ l)
  have h (l : List W) :
      ModuleFiltration.HasFiltration
        (fun a => ModuleCat.of C(σ) (braidColumnBottomFactor (Q := Q) (Λ := Λ) s σ ρ a))
        (braidColumnBottomSteps l) (ModuleCat.of C(σ) (X l)) := by
    induction l with
    | nil =>
      apply ModuleFiltration.HasFiltration.zero
      change Subsingleton (X [])
      have hb : X [] = ⊥ := braidColumnBottomStage_empty s σ ρ
      rw [hb]
      infer_instance
    | cons w l ih =>
      change ModuleFiltration.HasFiltration _ ((w,l) :: braidColumnBottomSteps l)
        (ModuleCat.of C(σ) (braidColumnBottomStage s σ ρ (braidColumnBottomPrefix s σ (w :: l))))
      rw [braidColumnBottomPrefix_cons]
      let Y := braidColumnBottomStage (Q := Q) (Λ := Λ) s σ ρ
        (fun u => braidColumnBottomPrefix s σ l u ∨ u = w)
      let D := braidColumnBottomStepKernel (Q := Q) (Λ := Λ) s σ ρ (braidColumnBottomPrefix s σ l) w
      let i : X l →ₗ[C(σ)] Y :=
        Submodule.inclusion (braidColumnBottomStage_mono s σ ρ (fun _ => Or.inl))
      refine .cons i D.mkQ _ _ (Submodule.inclusion_injective _) ?_ D.mkQ_surjective ih ⟨LinearEquiv.refl _ _⟩
      intro y
      change D.mkQ y = 0 ↔ y ∈ Set.range i
      rw [Submodule.Quotient.mk_eq_zero]
      constructor
      · intro hy
        exact ⟨⟨y.val,hy⟩,Subtype.ext rfl⟩
      · rintro ⟨x,rfl⟩
        exact x.2
  refine (h L).of_equiv (LinearEquiv.ofBijective (X L).subtype ⟨Subtype.val_injective,?_⟩)
  intro x
  exact ⟨⟨x,by rw [show X L = ⊤ from braidColumnBottomStage_full s hs σ ρ hρ L hL]; trivial⟩,rfl⟩

/-- Each actual successive quotient is a surjective image of its loading standard. -/
theorem braidColumnBottom_factor_surjection
    (s : Seq μ) (hs : IsRedOrdered s) (σ : Perm (Fin ℓ))
    (ρ : W → List ℕ) (hρ : IsReducedChoice ρ) (L : List W)
    (hL : ∀ w, w ∈ L ↔ IsBraidColumnBottomIndex s σ w)
    (hord : L.Pairwise fun w u => ¬ braidColumnIndexEarlier s w u)
    (a : W × List W) (ha : a ∈ braidColumnBottomSteps L) :
    ∃ d : ViolLoadingStandard (k := k) (Q := Q) (Λ := Λ) (a.1⁻¹ • s) κ(σ) →ₗ[C(σ)]
      braidColumnBottomFactor (Q := Q) (Λ := Λ) s σ ρ a, Function.Surjective d := by
  obtain ⟨w,l⟩ := a
  obtain ⟨p,hp⟩ := braidColumnBottomSteps_mem ha
  have hw : w ∈ L := by rw [hp]; simp
  obtain ⟨n,hn,φ,hφ,hr,he⟩ := (hL w).1 hw
  subst w
  have higher := braidColumnBottomPrefix_contains_higher s σ L hL hord p l _ hp
  exact ⟨braidColumnBottomStepMap s hs σ ρ hρ _ n hn φ hφ hr higher,
    braidColumnBottomStepMap_surjective s hs σ ρ hρ _ n hn φ hφ hr higher⟩

end Categorification.Stendhal
