import Categorification.KLR.CyclotomicAction.VacuumIdealBubbles
import Categorification.Diagrams.CL.SpanningDefs

/-!
# Bubbles at the vacuum modulo the ideal `I`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v2, proof of
Proposition 3.25. At the region `λ` of `P_∅` the pairing `⟨i, λ⟩ = -λ^i` is nonpositive, and the
clockwise bubbles with nonnegative labels lie in the ideal `I` (`cwReal_mem_vacIdeal`). The
infinite Grassmannian relation then expresses every counterclockwise bubble at `λ`, modulo `I`,
as a polynomial in the fake clockwise bubbles (those with negative labels). Hence every element of
the bubble algebra at `λ` (`CL.IsBubC`) is congruent modulo `I` to an element of the subalgebra
generated by the fake clockwise bubbles (`mem_vacReduced_of_isBubC`); this is the step of
Webster's proof that sends the bubble algebra onto the algebra of symmetric functions in the
cyclotomic quotient.

* `vacIdealEnd`: the ideal `I` inside `End(1_λ)`;
* `vacFakeAlg`: the subalgebra of `End(1_λ)` generated by the fake clockwise bubbles;
* `vacReduced`: the subalgebra of the `x` with `x - a ∈ I` for some `a ∈ vacFakeAlg`;
* `mem_vacReduced_of_isBubC`: every element of the bubble algebra at `λ` lies in `vacReduced`.

The infinite Grassmannian relation in all degrees is a hypothesis of the last statement
(`VacGrassmannian`); it is a relation of the Cautis–Lauda 2-category and holds for every choice
of scalars.
-/

namespace Categorification.KLR.CyclotomicAction

open CategoryTheory TwoRep QuantumGroup StringDiagrams
open KL3.Diagram

universe u v w u₁

noncomputable section

variable {I : Type u} [DecidableEq I] {k : Type v} [CommRing k] [Nontrivial k] {lam : I → ℕ}
  {C : CartanDatum I} {Q : I → I → MvPolynomial (Fin 2) k} (hQ : IsRouquierQ C Q)
  {X Y : Type u₁} [AddCommGroup X] [AddCommGroup Y] (RD : UDot.WeightDatum C X Y) (Λ : X)
  (hΛ : ∀ i, (lam i : ℤ) = RD.pair (RD.iY i) Λ)

omit [DecidableEq I] in
include hΛ in
/-- The pairing of the region of `P_∅` with `i` is `-λ^i`. -/
theorem ip_vacWt (i : I) : ip RD i (vacWt RD Λ) = -(lam i : ℤ) := by
  show RD.pair (RD.iY i) (blockWeight RD Λ 0) = _
  rw [blockWeight, Multiset.map_zero, Multiset.sum_zero, zero_sub, map_neg, hΛ]

/-- **The ideal `I` inside `End(1_λ)`**, `λ` the region of `P_∅`. -/
abbrev vacIdealEnd :
    Submodule k (End ((CL.presCL RD k (univScalars hQ RD)).obj (ob RD (vacWt RD Λ) []))) :=
  vacIdeal hQ RD Λ (vacHom (k := k) hQ RD Λ [] rfl) (vacHom hQ RD Λ [] rfl)

/-- The subalgebra of `End(1_λ)` generated by the clockwise bubbles with negative labels (the
fake bubbles). -/
def vacFakeAlg :
    Subalgebra k (End ((CL.presCL RD k (univScalars hQ RD)).obj (ob RD (vacWt RD Λ) []))) :=
  Algebra.adjoin k {x | ∃ (i : I) (m : ℤ), m < 0 ∧
    x = (CL.presCL RD k (univScalars hQ RD)).lin (cwL RD k (vacWt RD Λ) i m)}

/-- **Endomorphisms of `1_λ` congruent modulo `I` to a polynomial in fake bubbles**: a subalgebra,
since `I` is a two-sided ideal for composition. -/
def vacReduced :
    Subalgebra k (End ((CL.presCL RD k (univScalars hQ RD)).obj (ob RD (vacWt RD Λ) []))) where
  carrier := {x | ∃ a ∈ vacFakeAlg hQ RD Λ, x - a ∈ vacIdealEnd hQ RD Λ}
  mul_mem' := by
    rintro x y ⟨a, ha, hxa⟩ ⟨b, hb, hyb⟩
    refine ⟨a * b, mul_mem ha hb, ?_⟩
    have e : x * y - a * b = (x - a) * y + a * (y - b) := by noncomm_ring
    rw [e]
    refine add_mem ?_ ?_
    · exact comp_mem_factorIdeal (k := k)
        (show vacHom (k := k) hQ RD Λ [] rfl ⟶ vacHom hQ RD Λ [] rfl from y) hxa
    · exact mem_factorIdeal_comp (k := k) hyb
        (show vacHom (k := k) hQ RD Λ [] rfl ⟶ vacHom hQ RD Λ [] rfl from a)
  add_mem' := by
    rintro x y ⟨a, ha, hxa⟩ ⟨b, hb, hyb⟩
    refine ⟨a + b, add_mem ha hb, ?_⟩
    rw [add_sub_add_comm]
    exact add_mem hxa hyb
  algebraMap_mem' r := ⟨algebraMap k _ r, Subalgebra.algebraMap_mem _ r, by
    rw [sub_self]; exact zero_mem _⟩

theorem mem_vacReduced_of_mem_vacIdealEnd {x} (hx : x ∈ vacIdealEnd hQ RD Λ) :
    x ∈ vacReduced hQ RD Λ :=
  ⟨0, zero_mem _, by rwa [sub_zero]⟩

theorem mem_vacReduced_of_mem_vacFakeAlg {x} (hx : x ∈ vacFakeAlg hQ RD Λ) :
    x ∈ vacReduced hQ RD Λ :=
  ⟨x, hx, by rw [sub_self]; exact zero_mem _⟩

/-- **Clockwise bubbles at the vacuum reduce**: a real one lies in `I`, a fake one is a
generator of `vacFakeAlg`. -/
theorem cwL_mem_vacReduced (i : I) (m : ℤ) :
    (CL.presCL RD k (univScalars hQ RD)).lin (cwL RD k (vacWt RD Λ) i m) ∈
      vacReduced hQ RD Λ := by
  by_cases hm : 0 ≤ m
  · refine mem_vacReduced_of_mem_vacIdealEnd hQ RD Λ ?_
    rw [cwL, ite_eq_left hm, Presentation.lin_of]
    exact cwReal_mem_vacIdeal hQ RD Λ i m.toNat
  · exact mem_vacReduced_of_mem_vacFakeAlg hQ RD Λ
      (Algebra.subset_adjoin ⟨i, m, lt_of_not_ge hm, rfl⟩)

include hΛ in
/-- The fake clockwise bubble of degree zero at the vacuum is the identity. -/
theorem cwL_vacWt_ip_sub_one (i : I) :
    (CL.presCL RD k (univScalars hQ RD)).lin
      (cwL RD k (vacWt RD Λ) i (ip RD i (vacWt RD Λ) - 1)) = 𝟙 _ := by
  have h := ip_vacWt RD Λ hΛ i
  rw [cwL, ite_eq_right (by omega : ¬ _),
    ite_eq_left (by omega : _),
    show ip RD i (vacWt RD Λ) - 1 + 1 - ip RD i (vacWt RD Λ) = 0 by ring, Int.toNat_zero,
    KL3.Diagram.grassInv_zero, End.one_def, Presentation.lin_id]

/-- **The infinite Grassmannian relation in all degrees at the region of `P_∅`**
(Cautis–Lauda, arXiv:1111.1431v3, §2). -/
def VacGrassmannian : Prop :=
  ∀ (i : I) (d : ℕ), ∑ j ∈ Finset.range (d + 1),
    (CL.presCL RD k (univScalars hQ RD)).lin
        (ccwL RD k (vacWt RD Λ) i (-ip RD i (vacWt RD Λ) - 1 + j)) ≫
      (CL.presCL RD k (univScalars hQ RD)).lin
        (cwL RD k (vacWt RD Λ) i (ip RD i (vacWt RD Λ) - 1 + ((d : ℤ) - j))) =
    if d = 0 then 𝟙 _ else 0

include hΛ in
/-- **Counterclockwise bubbles at the vacuum reduce**: by the infinite Grassmannian relation,
modulo `I` every counterclockwise bubble is a polynomial in the fake clockwise bubbles. -/
theorem ccwL_mem_vacReduced (hG : VacGrassmannian hQ RD Λ) (i : I) (d : ℕ) :
    (CL.presCL RD k (univScalars hQ RD)).lin
        (ccwL RD k (vacWt RD Λ) i (-ip RD i (vacWt RD Λ) - 1 + d)) ∈
      vacReduced hQ RD Λ := by
  induction d using Nat.strong_induction_on with
  | _ d ih =>
    have h := hG i d
    rw [Finset.sum_range_succ, sub_self, add_zero, cwL_vacWt_ip_sub_one hQ RD Λ hΛ,
      Category.comp_id, ← eq_sub_iff_add_eq'] at h
    rw [h]
    refine sub_mem ?_ (sum_mem fun j hj => ?_)
    · split_ifs
      · exact (vacReduced hQ RD Λ).one_mem
      · exact (vacReduced hQ RD Λ).zero_mem
    · exact mul_mem (cwL_mem_vacReduced hQ RD Λ i _) (ih j (Finset.mem_range.1 hj))

include hΛ in
/-- **The bubble algebra at the vacuum, modulo `I`** (Webster, arXiv:1309.3796v2, proof of
Proposition 3.25): every element of the bubble algebra at the region of `P_∅` is congruent
modulo `I` to a polynomial in the fake clockwise bubbles. -/
theorem mem_vacReduced_of_isBubC (hG : VacGrassmannian hQ RD Λ)
    {x : End ((CL.presCL RD k (univScalars hQ RD)).obj (ob RD (vacWt RD Λ) []))}
    (hx : CL.IsBubC (CL.presCL RD k (univScalars hQ RD)) (vacWt RD Λ) x) :
    x ∈ vacReduced hQ RD Λ := by
  refine Algebra.adjoin_le (S := vacReduced hQ RD Λ) ?_ hx
  rintro _ ⟨⟨i, n⟩, rfl⟩
  have hi := ip_vacWt RD Λ hΛ i
  show CL.bubGenC _ _ i n ∈ _
  rw [CL.bubGenC]
  split_ifs with h0
  · refine mem_vacReduced_of_mem_vacIdealEnd hQ RD Λ ?_
    rw [CL.dgC_of (sChain_cwLs i _)]
    exact cwReal_mem_vacIdeal hQ RD Λ i _
  · have e : -ip RD i (vacWt RD Λ) - 1 + ((n + 1 : ℕ) : ℤ) =
        (((-ip RD i (vacWt RD Λ)).toNat + n : ℕ) : ℤ) := by omega
    have := ccwL_mem_vacReduced hQ RD Λ hΛ hG i (n + 1)
    rw [e, ccwL, ite_eq_left (Int.natCast_nonneg _), Int.toNat_natCast,
      Presentation.lin_of] at this
    rw [CL.dgC_of (sChain_ccwLs i _)]
    exact this

end

end Categorification.KLR.CyclotomicAction
