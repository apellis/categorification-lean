import Mathlib.CategoryTheory.Idempotents.Karoubi
import Mathlib.CategoryTheory.Preadditive.Mat
import Mathlib.CategoryTheory.Retract

/-!
# Objects generated by one object

In a preadditive category an object `X` is generated by `O` when its identity factors through
finitely many copies of `O`: `𝟙 X = ∑ⱼ πⱼ ≫ ιⱼ` with `πⱼ : X ⟶ O` and `ιⱼ : O ⟶ X`, that is,
`X` is a retract of a finite direct sum of copies of `O`. This is the hypothesis of
`HomTensor.equiv`, the form of the Eilenberg–Watts theorem used to pass from a categorical
action on a category generated by one object to bimodules over its endomorphism ring
(Webster, arXiv:1309.3796v3, §5, where categories of projective modules over `T^λ` are
identified with the categories on which the categorical action of Theorem 4.31 is defined).

## Main results

* `IsGeneratedBy`: the property, with closure under retracts, composition, additive functors
  and finite biproducts.
* `IsGeneratedBy.mat`: in the additive envelope `Mat_ C`, a matrix object is generated by `O`
  when each of its entries is.
* `IsGeneratedBy.karoubi`: in the idempotent completion, an object is generated by `O` when its
  underlying object is.
-/

namespace Categorification

open CategoryTheory Limits

variable {C : Type*} [Category C] [Preadditive C]

/-- `X` is generated by `O`: its identity factors through finitely many copies of `O`. -/
def IsGeneratedBy (O X : C) : Prop :=
  ∃ (n : ℕ) (π : Fin n → (X ⟶ O)) (ι : Fin n → (O ⟶ X)), ∑ j, π j ≫ ι j = 𝟙 X

namespace IsGeneratedBy

/-- A factorization of the identity indexed by any finite type gives generation. -/
theorem of_fintype {O X : C} {J : Type*} [Fintype J] (π : J → (X ⟶ O)) (ι : J → (O ⟶ X))
    (h : ∑ j, π j ≫ ι j = 𝟙 X) : IsGeneratedBy O X := by
  let e := Fintype.equivFin J
  refine ⟨Fintype.card J, fun j => π (e.symm j), fun j => ι (e.symm j), ?_⟩
  rw [← h]
  exact Equiv.sum_comp e.symm (fun j => π j ≫ ι j)

theorem refl (O : C) : IsGeneratedBy O O :=
  ⟨1, fun _ => 𝟙 O, fun _ => 𝟙 O, by simp⟩

/-- A retract of an object generated by `O` is generated by `O`. -/
theorem of_retract {O X Y : C} (r : Retract X Y) (h : IsGeneratedBy O Y) :
    IsGeneratedBy O X := by
  obtain ⟨n, π, ι, hs⟩ := h
  refine ⟨n, fun j => r.i ≫ π j, fun j => ι j ≫ r.r, ?_⟩
  calc ∑ j, (r.i ≫ π j) ≫ ι j ≫ r.r = r.i ≫ (∑ j, π j ≫ ι j) ≫ r.r := by
        simp only [Preadditive.comp_sum, Preadditive.sum_comp, Category.assoc]
    _ = 𝟙 X := by rw [hs, Category.id_comp, r.retract]

theorem of_iso {O X Y : C} (e : X ≅ Y) (h : IsGeneratedBy O Y) : IsGeneratedBy O X :=
  of_retract ⟨e.hom, e.inv, e.hom_inv_id⟩ h

theorem trans {O O' X : C} (h : IsGeneratedBy O' X) (h' : IsGeneratedBy O O') :
    IsGeneratedBy O X := by
  obtain ⟨n, π, ι, hs⟩ := h
  obtain ⟨m, π', ι', hs'⟩ := h'
  refine of_fintype (J := Fin n × Fin m) (fun p => π p.1 ≫ π' p.2) (fun p => ι' p.2 ≫ ι p.1) ?_
  rw [← hs, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun j _ => ?_
  calc ∑ y, (π j ≫ π' y) ≫ ι' y ≫ ι j = π j ≫ (∑ y, π' y ≫ ι' y) ≫ ι j := by
        simp only [Preadditive.comp_sum, Preadditive.sum_comp, Category.assoc]
    _ = π j ≫ ι j := by rw [hs', Category.id_comp]

/-- An additive functor preserves generation. -/
theorem map {D : Type*} [Category D] [Preadditive D] (F : C ⥤ D) [F.Additive] {O X : C}
    (h : IsGeneratedBy O X) : IsGeneratedBy (F.obj O) (F.obj X) := by
  obtain ⟨n, π, ι, hs⟩ := h
  refine ⟨n, fun j => F.map (π j), fun j => F.map (ι j), ?_⟩
  simp only [← F.map_comp, ← F.map_sum, hs, F.map_id]

/-- A finite biproduct of objects generated by `O` is generated by `O`. -/
theorem biproduct {O : C} {ι : Type} [Fintype ι] {X : ι → C}
    [HasBiproduct X] (h : ∀ i, IsGeneratedBy O (X i)) : IsGeneratedBy O (⨁ X) := by
  choose n π ι' hs using h
  refine of_fintype (J := Σ i, Fin (n i)) (fun p => biproduct.π X p.1 ≫ π p.1 p.2)
    (fun p => ι' p.1 p.2 ≫ biproduct.ι X p.1) ?_
  refine Eq.trans ?_ biproduct.total
  rw [Fintype.sum_sigma]
  refine Finset.sum_congr rfl fun i _ => ?_
  calc ∑ j, (biproduct.π X i ≫ π i j) ≫ ι' i j ≫ biproduct.ι X i
      = biproduct.π X i ≫ (∑ j, π i j ≫ ι' i j) ≫ biproduct.ι X i := by
        simp only [Preadditive.comp_sum, Preadditive.sum_comp, Category.assoc]
    _ = biproduct.π X i ≫ biproduct.ι X i := by rw [hs, Category.id_comp]

/-- In the additive envelope, a matrix object is generated by `O` when each entry is. -/
theorem mat {O : Mat_ C} {M : Mat_ C}
    (h : ∀ i, IsGeneratedBy O ((Mat_.embedding C).obj (M.X i))) :
    IsGeneratedBy O M := by
  classical
  exact of_iso (Mat_.isoBiproductEmbedding M) (biproduct h)

/-- In the idempotent completion, an object is generated by `toKaroubi O` when its underlying
object is generated by `O`. -/
theorem karoubi {O : C} {P : Idempotents.Karoubi C} (h : IsGeneratedBy O P.X) :
    IsGeneratedBy ((Idempotents.toKaroubi C).obj O) P :=
  of_retract ⟨P.decompId_i, P.decompId_p, P.decompId.symm⟩ (map _ h)

end IsGeneratedBy

end Categorification
