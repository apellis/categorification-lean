import Categorification.WeightedKLR.RedStrands.TwoPieceStandardization

/-!
# `M ⊗_B S^L_α ≅ S(X_M)`: the standardization of `ℓ + 1` red strands through that of the first `ℓ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, §5.1,
Definition 5.4 and proof of Proposition 5.5. For a right module `M` over the block algebra `B`
of `ℓ + 1` red strands, the standardization `M ⊗_B S^L_α` is the two-piece standardization of
`X_M = M ⊗_{B'} S^L_{α'}`, regarded as a module over the factor algebra
`T^{λ'} ⊗ R^{λ_{ℓ+1}}(β)`. The map `S(X_M) → M ⊗_B S^L_α` extends
`m ⊗ l ↦ m ⊗ Φ([l ⊠ 1])`, where `Φ : S(S^L_{α'} ⊠ R^{λ_{ℓ+1}}(β)) ≅ S^L_α` is the two-piece
isomorphism (`twoPieceRootStandardEquiv`). The inverse sends `m ⊗ v` to `S(j_m)(Φ⁻¹ v)`, with
`j_m : l ⊠ z ↦ m · flip(z) ⊗ l`; it is balanced because the block algebra is generated by the
block algebra of the first `ℓ` red strands and the last factor, on which `Φ` intertwines the
actions (`twoPieceRootStandardEquiv_initBlockAlg`, `twoPieceRootStandardEquiv_lastBlockAlg`).

## Main definitions

* `splitStandardEquiv`: `M ⊗_B S^L_α ≅ S(X_M)` as left `T^λ`-modules.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra MulOpposite
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

namespace StendhalAlgebra

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ) (hQ : KLRSymm Q)
  (b : Fin (ℓ + 2) → Multiset I)

local notation "𝔹" => BlockAlgebra k Q Λ b
local notation "B'" => BlockAlgebra k Q (Λ ∘ Fin.castSucc) (initBlocks b)
local notation "Cyc" => CycKLR k Q (fun i : I => (Polynomial.X : Polynomial k) ^ Λ (Fin.last ℓ) i)
  (lastBlock b)
local notation "fl" => CycKLR.flip (fun i : I => (Polynomial.X : Polynomial k) ^ Λ (Fin.last ℓ) i)
  (lastBlock b)
local notation "Told" => TensorProductAlgebra k Q (Λ ∘ Fin.castSucc) (initWeight b)
local notation "Tν" => TensorProductAlgebra k Q Λ (initWeight b + lastBlock b)
local notation "D" => parabolicFactorAlgebra Q Λ (initWeight b) (lastBlock b)
set_option quotPrecheck false in
local notation "N₀" => (rootSplitInput Q Λ b).carrier
local notation "KL'" => KMod (k := k) (ModuleCat.of Told
  (LeftRootStandard Q (Λ ∘ Fin.castSucc) (ν := initWeight b) (blockRoot (initBlocks b))))
local notation "KC" => KMod (k := k) (ModuleCat.of Cyc Cyc)

/-- The scalar tower `k → T(θ + β) → S N`. -/
local instance parabolicStandardT_isScalarTower_twoPieceStd {θ β : Multiset I} (N : Type*)
    [AddCommGroup N] [Module k N] [Module (parabolicFactorAlgebra Q Λ θ β) N]
    [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N] :
    IsScalarTower k (TensorProductAlgebra k Q Λ (θ + β)) (ParabolicStandardT Q Λ θ β N hQ) :=
  ⟨fun c t y => DFunLike.congr_fun (map_smul (parabolicStandardAction Q Λ θ β N hQ) c t) y⟩

theorem parabolicStandardMap_smul_of {θ β : Multiset I} {N N' : Type*}
    [AddCommGroup N] [Module k N] [Module (parabolicFactorAlgebra Q Λ θ β) N]
    [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N]
    [AddCommGroup N'] [Module k N'] [Module (parabolicFactorAlgebra Q Λ θ β) N']
    [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N']
    {g g' : N →ₗ[parabolicFactorAlgebra Q Λ θ β] N'} (c : k) (h : ∀ n, g n = c • g' n) :
    parabolicStandardMap Q Λ θ β g = c • parabolicStandardMap Q Λ θ β g' :=
  parabolicStandard_linearMap_ext Q Λ θ β fun r n => by
    rw [LinearMap.smul_apply, parabolicStandardMap_mk, parabolicStandardMap_mk,
      ← Submodule.Quotient.mk_smul]
    congr 1
    exact (congrArg (BalancedTensor.tmul (N := ParabolicInput Q Λ θ β N') r) (h n)).trans
      (BalancedTensor.tmul_smul (N := ParabolicInput Q Λ θ β N') c r (g' n))

variable (hα' : RootNonViolated (ν := initWeight b) (blockRoot (initBlocks b)))
  (hα : RootNonViolated (ν := initWeight b + lastBlock b) (blockRoot b))

local notation "L'" => BlockLeftStandard Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
local notation "L" => BlockLeftStandard Q Λ b (blockPrefix_last b) hα
set_option quotPrecheck false in
local notation "Φ" => twoPieceRootStandardEquiv Q Λ hQ b
set_option quotPrecheck false in
local notation "F'" => leftBlockActionOf Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
set_option quotPrecheck false in
local notation "F" => leftBlockActionOf Q Λ b (blockPrefix_last b) hα

/-- `ExtTensor.tmul l y` with `l` in `S^L_{α'}`. -/
abbrev splitTmul (l : L') (y : Cyc) : N₀ :=
  ExtTensor.tmul (k := k) (P := KL') (Q := KC) l y

theorem splitTmul_smul (c : k) (l : L') (y : Cyc) :
    splitTmul Q Λ b hα' (c • l) y = c • splitTmul Q Λ b hα' l y := by
  rw [splitTmul, splitTmul, ExtTensor.smul_tmul']
  exact congrArg (fun v : KL' => ExtTensor.tmul (k := k) (P := KL') (Q := KC) v y)
    (algebraMap_smul Told c l).symm

/-- `l ↦ Φ([l ⊠ 1])`, from `S^L_{α'}` to `S^L_α`. -/
def splitUnitMap : L' →ₗ[k] L where
  toFun l := Φ (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ
    (splitTmul Q Λ b hα' l 1))
  map_add' l l' := by
    rw [splitTmul, ExtTensor.add_tmul, parabolicStandardTUnit_add, map_add]
  map_smul' c l := by
    rw [RingHom.id_apply, splitTmul_smul]
    have h1 : parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ
        (c • splitTmul Q Λ b hα' l 1) =
        c • parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ (splitTmul Q Λ b hα' l 1) :=
      map_smul (parabolicStandardUnit Q Λ (initWeight b) (lastBlock b) N₀) c _
    rw [h1, ← algebraMap_smul Tν c, map_smul]
    exact algebraMap_smul Tν c _

theorem splitUnitMap_apply (l : L') :
    splitUnitMap Q Λ hQ b hα' hα l =
      Φ (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ
        (splitTmul Q Λ b hα' l 1)) := rfl

/-- `Φ([F'(x) l ⊠ 1]) = F(x) Φ([l ⊠ 1])` for `x ∈ B'`. -/
theorem splitUnitMap_initBlock (x : B') (l : L') :
    splitUnitMap Q Λ hQ b hα' hα (F' x l) =
      F (initBlockAlgHom Q Λ b x) (splitUnitMap Q Λ hQ b hα' hα l) :=
  LinearMap.congr_fun (twoPieceRootStandardEquiv_initBlockAlg Q Λ hQ b hα' hα x)
    (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ (splitTmul Q Λ b hα' l 1))

/-- `F(ι₂(flip z)) Φ([l ⊠ 1]) = Φ([l ⊠ z])` for `z` in the last factor. -/
theorem splitUnitMap_lastBlock (z : Cyc) (l : L') :
    F (lastBlockAlgHom Q Λ b (fl z)) (splitUnitMap Q Λ hQ b hα' hα l) =
      Φ (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ (splitTmul Q Λ b hα' l z)) := by
  have h := LinearMap.congr_fun (twoPieceRootStandardEquiv_lastBlockAlg Q Λ hQ b hα (fl z))
    (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ (splitTmul Q Λ b hα' l 1))
  rw [LinearMap.comp_apply, LinearMap.comp_apply, CycKLR.flip_flip,
    parabolicStandardMapT_unit] at h
  rw [splitUnitMap_apply]
  refine h.symm.trans ?_
  change Φ (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ
    (splitTmul Q Λ b hα' l ((1 : Cyc) • z))) = _
  rw [one_smul]

section Module

variable (M : Type*) [AddCommGroup M] [Module k M] [Module (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]
  [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M]

local notation "Y" => LeftStandardization Q Λ b (blockPrefix_last b) hα M
local notation "XL" => LeftStandardization Q (Λ ∘ Fin.castSucc) (initBlocks b) rfl hα'
  (InitRestrict Q Λ b M)
local notation "X" => TwoPieceInput Q Λ b M hα'
local notation "ofR" => initRestrictOf Q Λ b (M := M)
local notation "ofX" => twoPieceInputOf Q Λ b M hα'

/-- `(l, m) ↦ Φ([l ⊠ 1]) ⊗ m`. -/
def splitInputBil : L' →ₗ[k] InitRestrict Q Λ b M →ₗ[k] Y :=
  (BalancedTensor.mkBil k Tν (BlockAlgebra k Q Λ b)ᵐᵒᵖ L M).compl₁₂
    (splitUnitMap Q Λ hQ b hα' hα) (ofR).symm.toLinearMap

omit [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M] in
theorem splitInputBil_apply (l : L') (m : InitRestrict Q Λ b M) :
    splitInputBil Q Λ hQ b hα' hα M l m =
      BalancedTensor.tmul (splitUnitMap Q Λ hQ b hα' hα l) ((ofR).symm m) := rfl

omit [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M] in
theorem splitInputBil_balanced (l : L') (a : B'ᵐᵒᵖ) (m : InitRestrict Q Λ b M) :
    splitInputBil Q Λ hQ b hα' hα M (op a • l) m = splitInputBil Q Λ hQ b hα' hα M l (a • m) := by
  obtain ⟨x, rfl⟩ := MulOpposite.op_surjective a
  rw [splitInputBil_apply, splitInputBil_apply]
  change BalancedTensor.tmul (splitUnitMap Q Λ hQ b hα' hα (F' x l)) _ = _
  rw [splitUnitMap_initBlock]
  exact BalancedTensor.op_smul_tmul (B := Tν) (splitUnitMap Q Λ hQ b hα' hα l)
    (op (initBlockAlgHom Q Λ b x)) ((ofR).symm m)

/-- **The map `X_M → M ⊗_B S^L_α`**, `m ⊗ l ↦ m ⊗ Φ([l ⊠ 1])`. -/
def splitInputMap : X →ₗ[k] Y :=
  (BalancedTensor.lift (splitInputBil Q Λ hQ b hα' hα M)
    (splitInputBil_balanced Q Λ hQ b hα' hα M)).comp (ofX).symm.toLinearMap

omit [IsScalarTower k (BlockAlgebra k Q Λ b)ᵐᵒᵖ M] in
theorem splitInputMap_of (l : L') (m : InitRestrict Q Λ b M) :
    splitInputMap Q Λ hQ b hα' hα M (ofX (BalancedTensor.tmul l m)) =
      BalancedTensor.tmul (splitUnitMap Q Λ hQ b hα' hα l) ((ofR).symm m) := rfl

theorem splitInputMap_tmul_smul (t : Told) (c : Cyc) (l : L') (m : InitRestrict Q Λ b M) :
    splitInputMap Q Λ hQ b hα' hα M ((t ⊗ₜ c : D) • ofX (BalancedTensor.tmul l m)) =
      BalancedTensor.tmul (M := L) (Φ (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ
        ((t ⊗ₜ c : D) • splitTmul Q Λ b hα' l 1))) ((ofR).symm m) := by
  rw [tmul_smul_twoPieceInputOf, splitInputMap_of]
  obtain ⟨m, rfl⟩ := (ofR).surjective m
  rw [lastFactorEnd_of, LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply,
    ← BalancedTensor.op_smul_tmul (B := Tν) (M := L), op_op_smul_blockLeftStandard]
  change BalancedTensor.tmul (M := L) (F (lastBlockAlgHom Q Λ b (fl c))
    (splitUnitMap Q Λ hQ b hα' hα (t • l))) m = _
  rw [splitUnitMap_lastBlock, splitTmul, ExtTensor.smul_tmul, smul_eq_mul, mul_one]

theorem splitInputMap_smul_of (d : D) (l : L') (m : InitRestrict Q Λ b M) :
    splitInputMap Q Λ hQ b hα' hα M (d • ofX (BalancedTensor.tmul l m)) =
      BalancedTensor.tmul (M := L) (Φ (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ
        (d • splitTmul Q Λ b hα' l 1))) ((ofR).symm m) := by
  induction d using TensorProduct.inductionOn with
  | tmul t c => exact splitInputMap_tmul_smul Q Λ hQ b hα' hα M t c l m
  | add d d' hd hd' =>
    rw [add_smul, map_add, hd, hd', add_smul, parabolicStandardTUnit_add, map_add,
      BalancedTensor.add_tmul]

theorem splitInputMap_parabolic (w : TensorKLR (stendhalQ Q Λ)
      (Multiset.map (addRedColor ℓ) (stendhalWeight ℓ (initWeight b)))
      (Multiset.map (Sum.map (id : I → I) (fun _ : Fin 1 => Fin.last ℓ))
        (stendhalWeight 1 (lastBlock b)))) (x : XL) :
    splitInputMap Q Λ hQ b hα' hα M
        (parabolicInputMap Q Λ (initWeight b) (lastBlock b) w • ofX x) =
      parabolicAffine Q Λ (initWeight b) (lastBlock b) (concat (stendhalQ Q Λ) _ _ w) •
        splitInputMap Q Λ hQ b hα' hα M (ofX x) := by
  induction x using BalancedTensor.induction_on with
  | zero => rw [map_zero, smul_zero, map_zero, smul_zero]
  | tmul l m =>
    rw [splitInputMap_smul_of, parabolicStandardTUnit_smul, map_smul, splitInputMap_of,
      BalancedTensor.smul_tmul']
    rfl
  | add x y hx hy => rw [map_add, smul_add, map_add, hx, hy, map_add, smul_add]

/-- **The map `S(X_M) → M ⊗_B S^L_α`**, extending `m ⊗ l ↦ m ⊗ Φ([l ⊠ 1])`. -/
def splitStandardTo :
    ParabolicStandardT Q Λ (initWeight b) (lastBlock b) X hQ →ₗ[Tν] Y where
  toFun := parabolicDesc Q Λ (initWeight b) (lastBlock b) (N := X) (Algebra.lsmul k k Y)
    (splitInputMap Q Λ hQ b hα' hα M) (fun w n =>
      splitInputMap_parabolic Q Λ hQ b hα' hα M w ((ofX).symm n))
  map_add' := map_add _
  map_smul' a z := parabolicDesc_smul Q Λ (initWeight b) (lastBlock b) (N := X) hQ
    (Algebra.lsmul k k Y)
    (splitInputMap Q Λ hQ b hα' hα M) (fun w n =>
      splitInputMap_parabolic Q Λ hQ b hα' hα M w ((ofX).symm n)) a z

theorem splitStandardTo_unit (n : X) :
    splitStandardTo Q Λ hQ b hα' hα M
        (parabolicStandardTUnit Q Λ (initWeight b) (lastBlock b) hQ n) =
      splitInputMap Q Λ hQ b hα' hα M n :=
  parabolicDesc_unit Q Λ (initWeight b) (lastBlock b) (N := X) _ _ _ n

/-- The identity `S^L_{α'} → S^L_{α'}` from the `KMod` wrapper. -/
def kmodLeft : KL' →ₗ[k] L' where
  toFun l := l
  map_add' _ _ := rfl
  map_smul' c l := algebraMap_smul Told c (show L' from l)

/-- The identity of the last factor from the `KMod` wrapper. -/
def kmodCyc : KC →ₗ[k] Cyc where
  toFun z := z
  map_add' _ _ := rfl
  map_smul' c z := algebraMap_smul Cyc c (show Cyc from z)

theorem lastFactorAction_smul (c : Cyc) (t : Told) (x : XL) :
    lastFactorAction Q Λ b M hα' c (t • x) = t • lastFactorAction Q Λ b M hα' c x :=
  (BalancedTensor.mapRight (k := k) (B := Told) (M := L') (lastFactorEnd Q Λ b c)).map_smul t x

/-- `l ⊠ z ↦ m · flip(z) ⊗ l`, the bilinear form of `j_m`. -/
def splitVecBil (m : InitRestrict Q Λ b M) : KL' →ₗ[k] KC →ₗ[k] X :=
  (((lastFactorAction Q Λ b M hα').toLinearMap.flip ∘ₗ
      (BalancedTensor.mkBil k Told B'ᵐᵒᵖ L' (InitRestrict Q Λ b M)).flip m).compr₂
    (ofX).toLinearMap).compl₁₂
    (kmodLeft Q Λ b hα') (kmodCyc Q Λ b)

theorem splitVecBil_apply (m : InitRestrict Q Λ b M) (l : L') (z : Cyc) :
    splitVecBil Q Λ b hα' M m l z =
      ofX (lastFactorAction Q Λ b M hα' z (BalancedTensor.tmul l m)) := rfl

/-- **`j_m : S^L_{α'} ⊠ R^{λ_{ℓ+1}}(β) → X_M`**, `l ⊠ z ↦ m · flip(z) ⊗ l`, a map of modules
over the factor algebra. -/
def splitVec (m : InitRestrict Q Λ b M) : N₀ →ₗ[D] X where
  toFun := ExtTensor.lift (splitVecBil Q Λ b hα' M m)
  map_add' := map_add _
  map_smul' d x := ExtTensor.smul_eq_induction (map_add _) (map_zero _)
    (fun t c l z => by
      rw [ExtTensor.smul_tmul]
      change ofX (lastFactorAction Q Λ b M hα' (c * show Cyc from z)
          (BalancedTensor.tmul (t • show L' from l) m)) =
        (t ⊗ₜ c : D) • ofX (lastFactorAction Q Λ b M hα' z
          (BalancedTensor.tmul (show L' from l) m))
      change _ = ofX (twoPieceInputAction Q Λ b M hα' (t ⊗ₜ c) _)
      rw [twoPieceInputAction, Algebra.TensorProduct.lift_tmul, Module.End.mul_apply, map_mul,
        Module.End.mul_apply, ← BalancedTensor.smul_tmul', lastFactorAction_smul,
        lastFactorAction_smul]
      rfl) d x

theorem splitVec_tmul (m : InitRestrict Q Λ b M) (l : L') (z : Cyc) :
    splitVec Q Λ b hα' M m (splitTmul Q Λ b hα' l z) =
      ofX (BalancedTensor.tmul l (lastFactorEnd Q Λ b z m)) := rfl

theorem splitVec_add (m m' : InitRestrict Q Λ b M) :
    splitVec Q Λ b hα' M (m + m') = splitVec Q Λ b hα' M m + splitVec Q Λ b hα' M m' := by
  refine LinearMap.ext fun x => ?_
  induction x using ExtTensor.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul l z =>
    change ofX (lastFactorAction Q Λ b M hα' z (BalancedTensor.tmul (show L' from l) (m + m'))) =
      ofX (lastFactorAction Q Λ b M hα' z (BalancedTensor.tmul (show L' from l) m)) +
        ofX (lastFactorAction Q Λ b M hα' z (BalancedTensor.tmul (show L' from l) m'))
    rw [BalancedTensor.tmul_add, map_add, map_add]
  | add x y hx hy => rw [map_add, hx, hy, map_add, LinearMap.add_apply, LinearMap.add_apply,
      add_add_add_comm]

theorem splitVec_smul_apply (c : k) (m : InitRestrict Q Λ b M) (x : N₀) :
    splitVec Q Λ b hα' M (c • m) x = c • splitVec Q Λ b hα' M m x := by
  induction x using ExtTensor.induction_on with
  | zero => rw [map_zero, map_zero, smul_zero]
  | tmul l z =>
    change ofX (lastFactorAction Q Λ b M hα' z (BalancedTensor.tmul (show L' from l) (c • m))) =
      c • ofX (lastFactorAction Q Λ b M hα' z (BalancedTensor.tmul (show L' from l) m))
    rw [BalancedTensor.tmul_smul, map_smul, map_smul]
  | add x y hx hy => rw [map_add, hx, hy, map_add, smul_add]

set_option quotPrecheck false in
local notation "SX" => ParabolicStandardT Q Λ (initWeight b) (lastBlock b) X hQ

/-- `(v, m) ↦ S(j_m)(Φ⁻¹ v)`. -/
def splitStdFun (v : L) (m : M) : SX :=
  parabolicStandardMapT Q Λ hQ (splitVec Q Λ b hα' M (ofR m)) ((Φ).symm v)

theorem symm_apply_of_intertwine {R V W : Type*} [Semiring R] [AddCommMonoid V] [Module R V]
    [AddCommMonoid W] [Module R W] (e : V ≃ₗ[R] W) {g : Module.End R V} {f : Module.End R W}
    (h : e.toLinearMap ∘ₗ g = f ∘ₗ e.toLinearMap) (w : W) : e.symm (f w) = g (e.symm w) := by
  have := LinearMap.congr_fun h (e.symm w)
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply] at this
  rw [← this, LinearEquiv.symm_apply_apply]

theorem splitVec_comp_initBlock (y : B') (m : M) :
    splitVec Q Λ b hα' M (ofR m) ∘ₗ rootSplitLeftMap Q Λ b (F' y) =
      splitVec Q Λ b hα' M (ofR ((op (initBlockAlgHom Q Λ b y) : 𝔹ᵐᵒᵖ) • m)) := by
  refine LinearMap.ext fun x => ?_
  induction x using ExtTensor.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul l z =>
    change ofX (BalancedTensor.tmul (show L' from F' y l) (lastFactorEnd Q Λ b z (ofR m))) =
      ofX (BalancedTensor.tmul (show L' from l) (lastFactorEnd Q Λ b z (op y • ofR m)))
    rw [map_smul]
    exact congrArg ofX (BalancedTensor.op_smul_tmul (B := Told) (show L' from l) (op y)
      (lastFactorEnd Q Λ b z (ofR m)))
  | add x y hx hy => rw [map_add, hx, hy, map_add]

theorem splitVec_comp_lastBlock (c : Cyc) (m : M) :
    splitVec Q Λ b hα' M (ofR m) ∘ₗ rootSplitRightMap Q Λ b (fl c) =
      splitVec Q Λ b hα' M (ofR ((op (lastBlockAlgHom Q Λ b c) : 𝔹ᵐᵒᵖ) • m)) := by
  refine LinearMap.ext fun x => ?_
  induction x using ExtTensor.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul l z =>
    change ofX (BalancedTensor.tmul (show L' from l)
        (lastFactorEnd Q Λ b ((show Cyc from z) * fl c) (ofR m))) =
      ofX (BalancedTensor.tmul (show L' from l)
        (lastFactorEnd Q Λ b (show Cyc from z) (ofR ((op (lastBlockAlgHom Q Λ b c) : 𝔹ᵐᵒᵖ) • m))))
    rw [lastFactorEnd_mul, LinearMap.comp_apply, lastFactorEnd_of, CycKLR.flip_flip]
  | add x y hx hy => rw [map_add, hx, hy, map_add]

/-- `S(j_m)(Φ⁻¹(F(x) v)) = S(j_{m x})(Φ⁻¹ v)`. -/
def SplitBalanced (x : 𝔹) : Prop :=
  ∀ (v : L) (m : M), splitStdFun Q Λ hQ b hα' hα M (F x v) m =
    splitStdFun Q Λ hQ b hα' hα M v ((op x : 𝔹ᵐᵒᵖ) • m)

theorem splitBalanced_init (y : B') :
    SplitBalanced Q Λ hQ b hα' hα M (initBlockAlgHom Q Λ b y) := by
  intro v m
  rw [splitStdFun, splitStdFun, symm_apply_of_intertwine Φ
    (twoPieceRootStandardEquiv_initBlockAlg Q Λ hQ b hα' hα y), ← LinearMap.comp_apply,
    ← parabolicStandardMapT_comp, splitVec_comp_initBlock]

theorem splitBalanced_last (c : Cyc) :
    SplitBalanced Q Λ hQ b hα' hα M (lastBlockAlgHom Q Λ b c) := by
  intro v m
  rw [splitStdFun, splitStdFun, symm_apply_of_intertwine Φ
    (twoPieceRootStandardEquiv_lastBlockAlg Q Λ hQ b hα c), ← LinearMap.comp_apply,
    ← parabolicStandardMapT_comp, splitVec_comp_lastBlock]

theorem splitBalanced_mul {x y : 𝔹} (hx : SplitBalanced Q Λ hQ b hα' hα M x)
    (hy : SplitBalanced Q Λ hQ b hα' hα M y) : SplitBalanced Q Λ hQ b hα' hα M (x * y) := by
  intro v m
  have h : @Eq L (F (x * y) v) (F x (F y v)) := by
    rw [map_mul]
    rfl
  refine (congrArg (fun w : L => splitStdFun Q Λ hQ b hα' hα M w m) h).trans ?_
  rw [hx, hy, op_mul, mul_smul]

theorem splitStdFun_add_left (v v' : L) (m : M) :
    splitStdFun Q Λ hQ b hα' hα M (v + v') m =
      splitStdFun Q Λ hQ b hα' hα M v m + splitStdFun Q Λ hQ b hα' hα M v' m := by
  rw [splitStdFun, splitStdFun, splitStdFun, map_add, map_add]

theorem splitStdFun_add_right (v : L) (m m' : M) :
    splitStdFun Q Λ hQ b hα' hα M v (m + m') =
      splitStdFun Q Λ hQ b hα' hα M v m + splitStdFun Q Λ hQ b hα' hα M v m' := by
  rw [splitStdFun, splitStdFun, splitStdFun, map_add, splitVec_add]
  change parabolicStandardMap Q Λ _ _ (_ + _) _ = _
  rw [parabolicStandardMap_add]
  rfl

theorem splitBalanced_add {x y : 𝔹} (hx : SplitBalanced Q Λ hQ b hα' hα M x)
    (hy : SplitBalanced Q Λ hQ b hα' hα M y) : SplitBalanced Q Λ hQ b hα' hα M (x + y) := by
  intro v m
  have h : @Eq L (F (x + y) v) (F x v + F y v) :=
    LinearMap.congr_fun ((F).toRingHom.map_add x y) v
  refine (congrArg (fun w : L => splitStdFun Q Λ hQ b hα' hα M w m) h).trans ?_
  rw [splitStdFun_add_left, hx, hy, op_add, add_smul, splitStdFun_add_right]

/-- The elements of the block algebra at which `(v, m) ↦ S(j_m)(Φ⁻¹ v)` is balanced. -/
def splitBalancedSubalgebra : Subalgebra k 𝔹 where
  carrier := {x | SplitBalanced Q Λ hQ b hα' hα M x}
  mul_mem' := splitBalanced_mul Q Λ hQ b hα' hα M
  add_mem' := splitBalanced_add Q Λ hQ b hα' hα M
  algebraMap_mem' c := by
    rw [← (initBlockAlgHom Q Λ b).commutes c]
    exact splitBalanced_init Q Λ hQ b hα' hα M _

theorem splitBalanced (x : 𝔹) : SplitBalanced Q Λ hQ b hα' hα M x := by
  have h := blockAlgebra_subalgebra_eq_top Q Λ b (splitBalancedSubalgebra Q Λ hQ b hα' hα M)
    (splitBalanced_init Q Λ hQ b hα' hα M) (splitBalanced_last Q Λ hQ b hα' hα M)
  exact (h ▸ Algebra.mem_top : x ∈ splitBalancedSubalgebra Q Λ hQ b hα' hα M)

theorem splitStdFun_smul_left (c : k) (v : L) (m : M) :
    splitStdFun Q Λ hQ b hα' hα M (c • v) m = c • splitStdFun Q Λ hQ b hα' hα M v m := by
  rw [splitStdFun, splitStdFun, ← algebraMap_smul Tν c v, map_smul, map_smul, algebraMap_smul]

theorem splitStdFun_smul_right (c : k) (v : L) (m : M) :
    splitStdFun Q Λ hQ b hα' hα M v (c • m) = c • splitStdFun Q Λ hQ b hα' hα M v m := by
  rw [splitStdFun, splitStdFun, map_smul]
  change parabolicStandardMap Q Λ _ _ _ _ = _
  rw [parabolicStandardMap_smul_of Q Λ c (splitVec_smul_apply Q Λ b hα' M c (ofR m))]
  rfl

/-- `(v, m) ↦ S(j_m)(Φ⁻¹ v)`, bilinear. -/
def splitStdBil : L →ₗ[k] M →ₗ[k] SX :=
  LinearMap.mk₂ k (splitStdFun Q Λ hQ b hα' hα M) (splitStdFun_add_left Q Λ hQ b hα' hα M)
    (splitStdFun_smul_left Q Λ hQ b hα' hα M) (splitStdFun_add_right Q Λ hQ b hα' hα M)
    (splitStdFun_smul_right Q Λ hQ b hα' hα M)

/-- **The map `M ⊗_B S^L_α → S(X_M)`**, `m ⊗ v ↦ S(j_m)(Φ⁻¹ v)`. -/
def splitStandardFrom : Y →ₗ[Tν] SX :=
  BalancedTensor.liftB (splitStdBil Q Λ hQ b hα' hα M)
    (fun v a m => by
      obtain ⟨x, rfl⟩ := MulOpposite.op_surjective a
      exact splitBalanced Q Λ hQ b hα' hα M x v m)
    (fun t v m => by
      change splitStdFun Q Λ hQ b hα' hα M (t • v) m = t • splitStdFun Q Λ hQ b hα' hα M v m
      rw [splitStdFun, splitStdFun, map_smul, map_smul])

theorem splitStandardFrom_tmul (v : L) (m : M) :
    splitStandardFrom Q Λ hQ b hα' hα M (BalancedTensor.tmul v m) =
      splitStdFun Q Λ hQ b hα' hα M v m := rfl

theorem splitStandardFrom_to :
    (splitStandardFrom Q Λ hQ b hα' hα M).comp (splitStandardTo Q Λ hQ b hα' hα M) =
      LinearMap.id := by
  refine parabolicStandardT_ext Q Λ (initWeight b) (lastBlock b) hQ fun n => ?_
  rw [LinearMap.comp_apply, splitStandardTo_unit, LinearMap.id_apply]
  obtain ⟨x, rfl⟩ := (ofX).surjective n
  induction x using BalancedTensor.induction_on with
  | zero => rw [map_zero, map_zero, map_zero, parabolicStandardTUnit_zero]
  | tmul l m =>
    obtain ⟨m, rfl⟩ := (ofR).surjective m
    rw [splitInputMap_of, LinearEquiv.symm_apply_apply, splitStandardFrom_tmul, splitStdFun,
      splitUnitMap_apply, LinearEquiv.symm_apply_apply, parabolicStandardMapT_unit, splitVec_tmul,
      lastFactorEnd_one]
    rfl
  | add x y hx hy =>
    rw [map_add, map_add, map_add, hx, hy, parabolicStandardTUnit_add]

/-- `v ↦ m ⊗ v`. -/
def splitTmulRight (m : M) : L →ₗ[Tν] Y where
  toFun v := BalancedTensor.tmul v m
  map_add' v v' := BalancedTensor.add_tmul v v' m
  map_smul' t v := (BalancedTensor.smul_tmul' t v m).symm

theorem splitStandardTo_map (m : M) :
    (splitStandardTo Q Λ hQ b hα' hα M).comp
        (parabolicStandardMapT Q Λ hQ (splitVec Q Λ b hα' M (ofR m))) =
      (splitTmulRight Q Λ b hα M m).comp (Φ).toLinearMap := by
  refine parabolicStandardT_ext Q Λ (initWeight b) (lastBlock b) hQ fun n => ?_
  rw [LinearMap.comp_apply, parabolicStandardMapT_unit, splitStandardTo_unit, LinearMap.comp_apply]
  induction n using ExtTensor.induction_on with
  | zero => rw [map_zero, map_zero, parabolicStandardTUnit_zero, map_zero, map_zero]
  | tmul l z =>
    change splitInputMap Q Λ hQ b hα' hα M (ofX (BalancedTensor.tmul (show L' from l)
      (lastFactorEnd Q Λ b (show Cyc from z) (ofR m)))) = _
    rw [splitInputMap_of, lastFactorEnd_of, LinearEquiv.symm_apply_apply,
      ← BalancedTensor.op_smul_tmul (B := Tν) (M := L), op_op_smul_blockLeftStandard]
    change BalancedTensor.tmul (M := L) (F (lastBlockAlgHom Q Λ b (fl z))
      (splitUnitMap Q Λ hQ b hα' hα (show L' from l))) m = _
    rw [splitUnitMap_lastBlock]
    rfl
  | add x y hx hy =>
    rw [map_add, map_add, hx, hy, parabolicStandardTUnit_add, map_add, map_add]

theorem splitStandardTo_from :
    (splitStandardTo Q Λ hQ b hα' hα M).comp (splitStandardFrom Q Λ hQ b hα' hα M) =
      LinearMap.id := by
  refine BalancedTensor.extB fun v m => ?_
  rw [LinearMap.comp_apply, splitStandardFrom_tmul, splitStdFun, ← LinearMap.comp_apply,
    splitStandardTo_map, LinearMap.comp_apply]
  exact congrArg (fun w : L => BalancedTensor.tmul (M := L) w m) ((Φ).apply_symm_apply v)

/-- **`M ⊗_B S^L_α ≅ S(X_M)`** (arXiv:1309.3796v3, proof of Proposition 5.5): the
standardization of `ℓ + 1` red strands is the two-piece standardization of
`X_M = M ⊗_{B'} S^L_{α'}`. -/
def splitStandardEquiv : Y ≃ₗ[Tν] SX :=
  LinearEquiv.ofLinearMap (splitStandardFrom Q Λ hQ b hα' hα M) (splitStandardTo Q Λ hQ b hα' hα M)
    (splitStandardFrom_to Q Λ hQ b hα' hα M) (splitStandardTo_from Q Λ hQ b hα' hα M)

end Module

end StendhalAlgebra

end Categorification.Stendhal
