import Categorification.TwoRep.StronglyEquivariant
import Categorification.TwoRep.DenseFamily

/-!
# Strongly equivariant functors out of a module category generated by one object

Let `ℵ₁, ℵ₂` be 2-representations of a `k`-linear bicategory `B`, and `P₀ ∈ ℵ₁(a)`. Suppose that
every morphism between images `ℵ₁(f) P₀` is the evaluation at `P₀` of a 2-morphism (`Full`),
that the images of `P₀` are dense in every `ℵ₁(c)` (every object is a retract of a finite
direct sum of them), and that `C₀ ∈ ℵ₂(a)` is killed by every 2-morphism killing `P₀`
(`KerLe`). Then:

* `strongTrans`: there is a strongly equivariant functor `ℵ₁ ⟶ ℵ₂` sending `P₀` to `C₀`
  (`strongTransAppIso`), provided the categories `ℵ₂(c)` have finite biproducts and are
  idempotent complete;
* `strongTransIso`: any two strongly equivariant functors `β, β'` with `β(P₀) ≅ β'(P₀)` are
  isomorphic, by an isomorphism extending the given one (`strongTransIso_hom_app`);
* `modification_ext`: morphisms between strongly equivariant functors are determined by their
  component at `P₀`.

This is the formal core of B. Webster, *Knot invariants and higher representation theory*,
arXiv:1309.3796v2, Corollary 3.27 (1), where `ℵ₁` is the category of projective modules over the
cyclotomic quotient and `P₀` is its vacuum module. The construction follows Webster's proof:
the functor is first defined on the images of `P₀`, through the 2-morphisms that realize
the morphisms between them, and then extended along retracts of direct sums
(`IsDenseFamily.extendFunctor`).
-/

namespace Categorification.TwoRep.Generated

open CategoryTheory Bicategory Limits

universe w v u w₁ v₁ u₁ v₂ u₂ v₃ u₃

variable {k : Type w} [CommRing k] {B : Type u₁} [Bicategory.{w₁, v₁} B]
  [∀ a b : B, Preadditive (a ⟶ b)] [∀ a b : B, Linear k (a ⟶ b)]

/-- Additivity and `k`-linearity of a pseudofunctor on 2-morphisms. -/
structure Map₂Linear (ℵ : Pseudofunctor B (LinearCat.{w, v₃, u₃} k)) : Prop where
  add : ∀ {b c : B} {f g : b ⟶ c} (φ ψ : f ⟶ g) (X : ℵ.obj b),
    (ℵ.map₂ (φ + ψ)).hom.app X = (ℵ.map₂ φ).hom.app X + (ℵ.map₂ ψ).hom.app X
  smul : ∀ {b c : B} {f g : b ⟶ c} (r : k) (φ : f ⟶ g) (X : ℵ.obj b),
    (ℵ.map₂ (r • φ)).hom.app X = r • (ℵ.map₂ φ).hom.app X

variable (ℵ₁ : Pseudofunctor B (LinearCat.{w, v, u} k))
  (ℵ₂ : Pseudofunctor B (LinearCat.{w, v₂, u₂} k))
  {a : B} (P₀ : ℵ₁.obj a) (C₀ : ℵ₂.obj a)

/-- Fullness: every morphism between images of `P₀` is the evaluation of a 2-morphism. -/
def Full : Prop :=
  ∀ ⦃c : B⦄ (f g : a ⟶ c) (x : (ℵ₁.map f).obj.obj P₀ ⟶ (ℵ₁.map g).obj.obj P₀),
    ∃ φ : f ⟶ g, (ℵ₁.map₂ φ).hom.app P₀ = x

/-- The kernel condition: a 2-morphism acting by zero on `P₀` acts by zero on `C₀`. -/
def KerLe : Prop :=
  ∀ ⦃c : B⦄ ⦃f g : a ⟶ c⦄ (φ : f ⟶ g),
    (ℵ₁.map₂ φ).hom.app P₀ = 0 → (ℵ₂.map₂ φ).hom.app C₀ = 0

section Transfer

variable {ℵ₁ P₀} (hF : Full ℵ₁ P₀)

/-- A 2-morphism with prescribed evaluation at `P₀`. -/
noncomputable def lift {c : B} {f g : a ⟶ c}
    (x : (ℵ₁.map f).obj.obj P₀ ⟶ (ℵ₁.map g).obj.obj P₀) : f ⟶ g :=
  (hF f g x).choose

omit [∀ a b : B, Preadditive (a ⟶ b)] [∀ a b : B, Linear k (a ⟶ b)] in
theorem map₂_lift {c : B} {f g : a ⟶ c}
    (x : (ℵ₁.map f).obj.obj P₀ ⟶ (ℵ₁.map g).obj.obj P₀) :
    (ℵ₁.map₂ (lift hF x)).hom.app P₀ = x :=
  (hF f g x).choose_spec

/-- Transport of a morphism between images of `P₀` to the images of `C₀`. -/
noncomputable def transfer {c : B} {f g : a ⟶ c}
    (x : (ℵ₁.map f).obj.obj P₀ ⟶ (ℵ₁.map g).obj.obj P₀) :
    (ℵ₂.map f).obj.obj C₀ ⟶ (ℵ₂.map g).obj.obj C₀ :=
  (ℵ₂.map₂ (lift hF x)).hom.app C₀

variable {ℵ₂ C₀} (h₁ : Map₂Linear ℵ₁) (h₂ : Map₂Linear ℵ₂) (hK : KerLe ℵ₁ ℵ₂ P₀ C₀)
include h₁ h₂ hK

theorem transfer_map₂ {c : B} {f g : a ⟶ c} (φ : f ⟶ g) :
    transfer ℵ₂ C₀ hF ((ℵ₁.map₂ φ).hom.app P₀) = (ℵ₂.map₂ φ).hom.app C₀ := by
  set ψ := lift hF ((ℵ₁.map₂ φ).hom.app P₀)
  have h0 : (ℵ₂.map₂ (ψ - φ)).hom.app C₀ = 0 := by
    apply hK
    have h := h₁.add (ψ - φ) φ P₀
    rw [sub_add_cancel, map₂_lift] at h
    exact add_eq_right.mp h.symm
  have h1 := h₂.add (ψ - φ) φ C₀
  rw [sub_add_cancel, h0, zero_add] at h1
  exact h1

theorem transfer_id {c : B} (f : a ⟶ c) :
    transfer ℵ₂ C₀ hF (𝟙 ((ℵ₁.map f).obj.obj P₀)) = 𝟙 _ := by
  have h : (ℵ₁.map₂ (𝟙 f)).hom.app P₀ = 𝟙 _ := by simp only [PrelaxFunctor.map₂_id]; rfl
  rw [← h, transfer_map₂ hF h₁ h₂ hK, PrelaxFunctor.map₂_id]; rfl

theorem transfer_comp {c : B} {f g h : a ⟶ c}
    (x : (ℵ₁.map f).obj.obj P₀ ⟶ (ℵ₁.map g).obj.obj P₀)
    (y : (ℵ₁.map g).obj.obj P₀ ⟶ (ℵ₁.map h).obj.obj P₀) :
    transfer ℵ₂ C₀ hF (x ≫ y) = transfer ℵ₂ C₀ hF x ≫ transfer ℵ₂ C₀ hF y := by
  have e : x ≫ y = (ℵ₁.map₂ (lift hF x ≫ lift hF y)).hom.app P₀ := by
    simp only [PrelaxFunctor.map₂_comp]
    exact (congrArg₂ (· ≫ ·) (map₂_lift hF x) (map₂_lift hF y)).symm
  rw [e, transfer_map₂ hF h₁ h₂ hK, PrelaxFunctor.map₂_comp]; rfl

theorem transfer_add {c : B} {f g : a ⟶ c}
    (x y : (ℵ₁.map f).obj.obj P₀ ⟶ (ℵ₁.map g).obj.obj P₀) :
    transfer ℵ₂ C₀ hF (x + y) = transfer ℵ₂ C₀ hF x + transfer ℵ₂ C₀ hF y := by
  have e : x + y = (ℵ₁.map₂ (lift hF x + lift hF y)).hom.app P₀ := by
    rw [h₁.add]
    exact (congrArg₂ (· + ·) (map₂_lift hF x) (map₂_lift hF y)).symm
  rw [e, transfer_map₂ hF h₁ h₂ hK, h₂.add]; rfl

theorem transfer_smul {c : B} {f g : a ⟶ c} (r : k)
    (x : (ℵ₁.map f).obj.obj P₀ ⟶ (ℵ₁.map g).obj.obj P₀) :
    transfer ℵ₂ C₀ hF (r • x) = r • transfer ℵ₂ C₀ hF x := by
  have e : r • x = (ℵ₁.map₂ (r • lift hF x)).hom.app P₀ := by
    rw [h₁.smul]
    exact (congrArg (r • ·) (map₂_lift hF x)).symm
  rw [e, transfer_map₂ hF h₁ h₂ hK, h₂.smul]; rfl

end Transfer

section Construction

variable {ℵ₁ : Pseudofunctor B (LinearCat.{w, v, u} k)}
  {ℵ₂ : Pseudofunctor B (LinearCat.{w, v, u} k)} {P₀ : ℵ₁.obj a} {C₀ : ℵ₂.obj a}

/-- The images of `P₀` at `c`. -/
abbrev family (P₀ : ℵ₁.obj a) (c : B) : (a ⟶ c) → ℵ₁.obj c := fun f => (ℵ₁.map f).obj.obj P₀

/-- Components of an invertible 2-morphism of `LinearCat`. -/
abbrev isoApp {C D : LinearCat.{w, v, u} k} {F G : C ⟶ D} (e : F ≅ G) (X : C) :
    F.obj.obj X ≅ G.obj.obj X :=
  ((ObjectProperty.ι _).mapIso e).app X

/-- `isoApp (ℵ.mapComp f h) X`, with its target written as `ℵ(h) (ℵ(f) X)`. -/
noncomputable def compIso (ℵ : Pseudofunctor B (LinearCat.{w, v, u} k)) {b c d : B}
    (f : b ⟶ c) (h : c ⟶ d) (X : ℵ.obj b) :
    (ℵ.map (f ≫ h)).obj.obj X ≅ (ℵ.map h).obj.obj ((ℵ.map f).obj.obj X) :=
  isoApp (ℵ.mapComp f h) X

omit [∀ a b : B, Preadditive (a ⟶ b)] [∀ a b : B, Linear k (a ⟶ b)] in
theorem map_map₂_app (ℵ : Pseudofunctor B (LinearCat.{w, v, u} k)) {b c d : B}
    {f f' : b ⟶ c} (φ : f ⟶ f') (h : c ⟶ d) (X : ℵ.obj b) :
    (ℵ.map h).obj.map ((ℵ.map₂ φ).hom.app X) = (compIso ℵ f h X).inv ≫
      (ℵ.map₂ (φ ▷ h)).hom.app X ≫ (compIso ℵ f' h X).hom := by
  rw [Pseudofunctor.map₂_whisker_right]
  change _ = (compIso ℵ f h X).inv ≫ ((compIso ℵ f h X).hom ≫
    (ℵ.map h).obj.map ((ℵ.map₂ φ).hom.app X) ≫ (compIso ℵ f' h X).inv) ≫ (compIso ℵ f' h X).hom
  simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]

variable (hF : Full ℵ₁ P₀) (h₁ : Map₂Linear ℵ₁) (h₂ : Map₂Linear ℵ₂) (hK : KerLe ℵ₁ ℵ₂ P₀ C₀)

/-- The functor on the images of `P₀` sending `ℵ₁(f) P₀` to `ℵ₂(f) C₀`. -/
noncomputable def familyFunctor (c : B) : InducedCategory (ℵ₁.obj c) (family P₀ c) ⥤ ℵ₂.obj c where
  obj f := (ℵ₂.map f).obj.obj C₀
  map x := transfer ℵ₂ C₀ hF x.hom
  map_id f := transfer_id hF h₁ h₂ hK f
  map_comp x y := transfer_comp hF h₁ h₂ hK x.hom y.hom

instance (c : B) : (familyFunctor hF h₁ h₂ hK c).Additive where
  map_add {_ _ x y} := transfer_add hF h₁ h₂ hK x.hom y.hom

instance (c : B) : (familyFunctor hF h₁ h₂ hK c).Linear k where
  map_smul x r := transfer_smul hF h₁ h₂ hK r x.hom

variable (hD : ∀ c : B, IsDenseFamily (family P₀ c)) [∀ c : B, HasFiniteBiproducts (ℵ₂.obj c).carrier]
  [∀ c : B, IsIdempotentComplete (ℵ₂.obj c).carrier]

/-- The extension of `familyFunctor` to `ℵ₁(c)`. -/
noncomputable def extension (c : B) : ℵ₁.obj c ⥤ ℵ₂.obj c :=
  IsDenseFamily.extendFunctor (familyFunctor hF h₁ h₂ hK c) (hD c)

instance (c : B) : (extension hF h₁ h₂ hK hD c).Additive :=
  inferInstanceAs (IsDenseFamily.extendFunctor (familyFunctor hF h₁ h₂ hK c) (hD c)).Additive

instance (c : B) : (extension hF h₁ h₂ hK hD c).Linear k :=
  inferInstanceAs ((IsDenseFamily.extendFunctor (familyFunctor hF h₁ h₂ hK c) (hD c)).Linear k)

/-- The extension at `ℵ₁(f) P₀` is `ℵ₂(f) C₀`. -/
noncomputable def extIso {c : B} (f : a ⟶ c) :
    (extension hF h₁ h₂ hK hD c).obj (family P₀ c f) ≅ (ℵ₂.map f).obj.obj C₀ :=
  IsDenseFamily.extendFunctorObjIso (familyFunctor hF h₁ h₂ hK c) (hD c) f

@[reassoc]
theorem extension_map_extIso_hom {c : B} {f g : a ⟶ c} (x : family P₀ c f ⟶ family P₀ c g) :
    (extension hF h₁ h₂ hK hD c).map x ≫ (extIso hF h₁ h₂ hK hD g).hom =
      (extIso hF h₁ h₂ hK hD f).hom ≫ transfer ℵ₂ C₀ hF x :=
  IsDenseFamily.extendFunctor_map_objIso_hom _ (hD c) x

/-- The component `β(c)`. -/
noncomputable def app (c : B) : ℵ₁.obj c ⟶ ℵ₂.obj c := LinearCat.LinFun.of (extension hF h₁ h₂ hK hD c)

/-- The component at `ℵ₁(f) P₀` of the naturality isomorphism at `h`. -/
noncomputable def natComponent {c d : B} (h : c ⟶ d) (f : a ⟶ c) :
    (extension hF h₁ h₂ hK hD d).obj ((ℵ₁.map h).obj.obj (family P₀ c f)) ≅
      (ℵ₂.map h).obj.obj ((extension hF h₁ h₂ hK hD c).obj (family P₀ c f)) :=
  (extension hF h₁ h₂ hK hD d).mapIso (isoApp (ℵ₁.mapComp f h) P₀).symm ≪≫
    extIso hF h₁ h₂ hK hD (f ≫ h) ≪≫ isoApp (ℵ₂.mapComp f h) C₀ ≪≫
    (ℵ₂.map h).obj.mapIso (extIso hF h₁ h₂ hK hD f).symm

theorem natComponent_natural {c d : B} (h : c ⟶ d) {f f' : a ⟶ c}
    (g : family P₀ c f ⟶ family P₀ c f') :
    (extension hF h₁ h₂ hK hD d).map ((ℵ₁.map h).obj.map g) ≫ (natComponent hF h₁ h₂ hK hD h f').hom =
      (natComponent hF h₁ h₂ hK hD h f).hom ≫
        (ℵ₂.map h).obj.map ((extension hF h₁ h₂ hK hD c).map g) := by
  obtain ⟨φ, rfl⟩ := hF f f' g
  have hN : ∀ f₀ : a ⟶ c, natComponent hF h₁ h₂ hK hD h f₀ =
      (extension hF h₁ h₂ hK hD d).mapIso (compIso ℵ₁ f₀ h P₀).symm ≪≫
        extIso hF h₁ h₂ hK hD (f₀ ≫ h) ≪≫ compIso ℵ₂ f₀ h C₀ ≪≫
          (ℵ₂.map h).obj.mapIso (extIso hF h₁ h₂ hK hD f₀).symm := fun _ => rfl
  have hE₁ := extension_map_extIso_hom hF h₁ h₂ hK hD (f := f ≫ h) (g := f' ≫ h)
    ((ℵ₁.map₂ (φ ▷ h)).hom.app P₀)
  rw [transfer_map₂ hF h₁ h₂ hK] at hE₁
  have hE₂ := extension_map_extIso_hom hF h₁ h₂ hK hD (f := f) (g := f')
    ((ℵ₁.map₂ φ).hom.app P₀)
  rw [transfer_map₂ hF h₁ h₂ hK] at hE₂
  have hW₂ : (ℵ₂.map₂ (φ ▷ h)).hom.app C₀ ≫ (compIso ℵ₂ f' h C₀).hom =
      (compIso ℵ₂ f h C₀).hom ≫ (ℵ₂.map h).obj.map ((ℵ₂.map₂ φ).hom.app C₀) := by
    rw [map_map₂_app, Iso.hom_inv_id_assoc]
  have hE₂' : (extIso hF h₁ h₂ hK hD f).inv ≫ (extension hF h₁ h₂ hK hD c).map
      ((ℵ₁.map₂ φ).hom.app P₀) = (ℵ₂.map₂ φ).hom.app C₀ ≫ (extIso hF h₁ h₂ hK hD f').inv := by
    rw [Iso.inv_comp_eq, ← reassoc_of% hE₂, Iso.hom_inv_id, Category.comp_id]
  rw [hN, hN]
  simp only [Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom]
  rw [map_map₂_app, Functor.map_comp, Functor.map_comp, Category.assoc, Category.assoc,
    ← Functor.map_comp_assoc (extension hF h₁ h₂ hK hD d) (compIso ℵ₁ f' h P₀).hom,
    Iso.hom_inv_id, CategoryTheory.Functor.map_id, Category.id_comp]
  simp only [Category.assoc]
  rw [reassoc_of% hE₁, reassoc_of% hW₂, ← Functor.map_comp, ← Functor.map_comp, hE₂']

/-- The naturality isomorphism `ℵ₁(h) ⋙ β(d) ≅ β(c) ⋙ ℵ₂(h)`. -/
noncomputable def naturality {c d : B} (h : c ⟶ d) :
    ℵ₁.map h ≫ app hF h₁ h₂ hK hD d ≅ app hF h₁ h₂ hK hD c ≫ ℵ₂.map h :=
  ObjectProperty.isoMk _
    ((hD c).extendNatIso (F := (ℵ₁.map h).obj ⋙ extension hF h₁ h₂ hK hD d)
      (G := extension hF h₁ h₂ hK hD c ⋙ (ℵ₂.map h).obj)
      (fun f => natComponent hF h₁ h₂ hK hD h f) (fun g => natComponent_natural hF h₁ h₂ hK hD h g))

theorem naturality_hom_app {c d : B} (h : c ⟶ d) (f : a ⟶ c) :
    (naturality hF h₁ h₂ hK hD h).hom.hom.app (family P₀ c f) =
      (natComponent hF h₁ h₂ hK hD h f).hom :=
  IsDenseFamily.extendNatIso_hom_app (hD c) _ (fun g => natComponent_natural hF h₁ h₂ hK hD h g) f

/-- The component of `mapComp`, with the unfolded target. -/
abbrev mapCompApp (ℵ : Pseudofunctor B (LinearCat.{w, v₃, u₃} k)) {b c d : B} (f : b ⟶ c)
    (g : c ⟶ d) (X : ℵ.obj b) :
    (ℵ.map (f ≫ g)).obj.obj X ≅ (ℵ.map g).obj.obj ((ℵ.map f).obj.obj X) :=
  isoApp (ℵ.mapComp f g) X

omit [∀ a b : B, Preadditive (a ⟶ b)] [∀ a b : B, Linear k (a ⟶ b)] in
@[reassoc]
theorem map₂_whiskerLeft_app (ℵ : Pseudofunctor B (LinearCat.{w, v₃, u₃} k))
    {b c d : B} (f : b ⟶ c) {h h' : c ⟶ d} (θ : h ⟶ h') (X : ℵ.obj b) :
    (ℵ.map₂ (f ◁ θ)).hom.app X ≫ (mapCompApp ℵ f h' X).hom =
      (mapCompApp ℵ f h X).hom ≫ (ℵ.map₂ θ).hom.app ((ℵ.map f).obj.obj X) := by
  have e : ℵ.map₂ (f ◁ θ) ≫ (ℵ.mapComp f h').hom =
      (ℵ.mapComp f h).hom ≫ ℵ.map f ◁ ℵ.map₂ θ := by
    simp [ℵ.map₂_whisker_left]
  exact congrArg (fun t => t.hom.app X) e

theorem naturality_naturality' {c d : B} {h h' : c ⟶ d} (θ : h ⟶ h') :
    ℵ₁.map₂ θ ▷ app hF h₁ h₂ hK hD d ≫ (naturality hF h₁ h₂ hK hD h').hom =
      (naturality hF h₁ h₂ hK hD h).hom ≫ app hF h₁ h₂ hK hD c ◁ ℵ₂.map₂ θ := by
  apply ObjectProperty.hom_ext
  refine IsDenseFamily.natTrans_ext (hD c) fun f => ?_
  change (extension hF h₁ h₂ hK hD d).map ((ℵ₁.map₂ θ).hom.app (family P₀ c f)) ≫
      (naturality hF h₁ h₂ hK hD h').hom.hom.app (family P₀ c f) =
    (naturality hF h₁ h₂ hK hD h).hom.hom.app (family P₀ c f) ≫
      (ℵ₂.map₂ θ).hom.app ((extension hF h₁ h₂ hK hD c).obj (family P₀ c f))
  rw [naturality_hom_app, naturality_hom_app]
  set E := extension hF h₁ h₂ hK hD d
  change E.map ((ℵ₁.map₂ θ).hom.app (family P₀ c f)) ≫
      E.map (mapCompApp ℵ₁ f h' P₀).inv ≫ (extIso hF h₁ h₂ hK hD (f ≫ h')).hom ≫
        (mapCompApp ℵ₂ f h' C₀).hom ≫ (ℵ₂.map h').obj.map (extIso hF h₁ h₂ hK hD f).inv =
    (E.map (mapCompApp ℵ₁ f h P₀).inv ≫ (extIso hF h₁ h₂ hK hD (f ≫ h)).hom ≫
        (mapCompApp ℵ₂ f h C₀).hom ≫ (ℵ₂.map h).obj.map (extIso hF h₁ h₂ hK hD f).inv) ≫
      (ℵ₂.map₂ θ).hom.app ((extension hF h₁ h₂ hK hD c).obj (family P₀ c f))
  have s1 : (ℵ₁.map₂ θ).hom.app (family P₀ c f) ≫ (mapCompApp ℵ₁ f h' P₀).inv =
      (mapCompApp ℵ₁ f h P₀).inv ≫ (ℵ₁.map₂ (f ◁ θ)).hom.app P₀ := by
    rw [Iso.comp_inv_eq, Category.assoc, map₂_whiskerLeft_app, Iso.inv_hom_id_assoc]
  have s4 := extension_map_extIso_hom hF h₁ h₂ hK hD ((ℵ₁.map₂ (f ◁ θ)).hom.app P₀)
  rw [transfer_map₂ hF h₁ h₂ hK] at s4
  have s3 := (ℵ₂.map₂ θ).hom.naturality (extIso hF h₁ h₂ hK hD f).inv
  rw [← E.map_comp_assoc, s1, E.map_comp_assoc]
  erw [reassoc_of% s4]
  rw [map₂_whiskerLeft_app_assoc]
  simp only [Category.assoc]
  erw [s3]

omit [∀ a b : B, Preadditive (a ⟶ b)] [∀ a b : B, Linear k (a ⟶ b)] in
/-- The categorical bookkeeping behind `naturality_id'`. -/
theorem naturality_id_aux {C D : Type*} [Category C] [Category D] (E : C ⥤ D) {X Y Z : C}
    (m : X ≅ Y) (u₁ : Y ⟶ Z) (r₁ : X ⟶ Z) {W' W V V' : D} (ι' : E.obj X ≅ W')
    (ι : E.obj Z ≅ W) (n : W' ⟶ V) (u₂ : V ⟶ W) (r₂ : W' ⟶ W) (g : V ⟶ V')
    (uE : V' ⟶ E.obj Z) (e₁ : r₁ = m.hom ≫ u₁ ≫ 𝟙 Z) (e₂ : r₂ = n ≫ u₂ ≫ 𝟙 W)
    (e₃ : E.map r₁ ≫ ι.hom = ι'.hom ≫ r₂) (e₄ : g ≫ uE = u₂ ≫ ι.inv) :
    (E.map m.inv ≫ ι'.hom ≫ n ≫ g) ≫ uE = E.map u₁ ≫ 𝟙 (E.obj Z) ≫ 𝟙 (E.obj Z) := by
  simp only [Category.comp_id] at e₁ e₂
  subst e₁ e₂
  have e₃' : ι'.hom ≫ n ≫ u₂ ≫ ι.inv = E.map m.hom ≫ E.map u₁ := by
    rw [← Functor.map_comp, ← (Iso.comp_inv_eq ι).mpr e₃.symm]
    simp only [Category.assoc]
  rw [Category.assoc, Category.assoc, Category.assoc, e₄, e₃', ← Category.assoc,
    ← Functor.map_comp, Iso.inv_hom_id, CategoryTheory.Functor.map_id, Category.id_comp,
    Category.comp_id, Category.comp_id]

theorem naturality_id' (c : B) :
    (naturality hF h₁ h₂ hK hD (𝟙 c)).hom ≫ app hF h₁ h₂ hK hD c ◁ (ℵ₂.mapId c).hom =
      (ℵ₁.mapId c).hom ▷ app hF h₁ h₂ hK hD c ≫ (λ_ (app hF h₁ h₂ hK hD c)).hom ≫
        (ρ_ (app hF h₁ h₂ hK hD c)).inv := by
  apply ObjectProperty.hom_ext
  refine IsDenseFamily.natTrans_ext (hD c) (fun f => ?_)
  have e₁ := congrArg (fun θ => θ.hom.app P₀) (ℵ₁.map₂_right_unitor f)
  have e₂ := congrArg (fun θ => θ.hom.app C₀) (ℵ₂.map₂_right_unitor f)
  have e₃ := extension_map_extIso_hom hF h₁ h₂ hK hD ((ℵ₁.map₂ (ρ_ f).hom).hom.app P₀)
  rw [transfer_map₂ hF h₁ h₂ hK] at e₃
  have e₄ := (ℵ₂.mapId c).hom.hom.naturality (extIso hF h₁ h₂ hK hD f).inv
  change (naturality hF h₁ h₂ hK hD (𝟙 c)).hom.hom.app (family P₀ c f) ≫
    (ℵ₂.mapId c).hom.hom.app _ =
      (extension hF h₁ h₂ hK hD c).map ((ℵ₁.mapId c).hom.hom.app (family P₀ c f)) ≫ 𝟙 _ ≫ 𝟙 _
  rw [naturality_hom_app]
  exact naturality_id_aux (extension hF h₁ h₂ hK hD c) (isoApp (ℵ₁.mapComp f (𝟙 c)) P₀) _ _
    (extIso hF h₁ h₂ hK hD (f ≫ 𝟙 c)) (extIso hF h₁ h₂ hK hD f) _ _ _ _ _ e₁ e₂ e₃ e₄


omit [∀ a b : B, Preadditive (a ⟶ b)] [∀ a b : B, Linear k (a ⟶ b)] in
theorem map₂_associator_app (F : Pseudofunctor B (LinearCat.{w, v, u} k)) {a b c d : B}
    (f : a ⟶ b) (g : b ⟶ c) (h : c ⟶ d) (X : F.obj a) :
    (F.map₂ (α_ f g h).hom).hom.app X =
      (F.mapComp (f ≫ g) h).hom.hom.app X ≫
        (F.map h).obj.map ((F.mapComp f g).hom.hom.app X) ≫
          (F.mapComp g h).inv.hom.app ((F.map f).obj.obj X) ≫
            (F.mapComp f (g ≫ h)).inv.hom.app X := by
  rw [F.map₂_associator]
  change (F.mapComp (f ≫ g) h).hom.hom.app X ≫
        (F.map h).obj.map ((F.mapComp f g).hom.hom.app X) ≫ 𝟙 _ ≫
          (F.mapComp g h).inv.hom.app ((F.map f).obj.obj X) ≫
            (F.mapComp f (g ≫ h)).inv.hom.app X = _
  rw [Category.id_comp]

theorem natTrans_app_of_iso {C D : Type*} [Category C] [Category D] {F G : C ⥤ D} (N : F ⟶ G)
    {Y Y' : C} (φ : Y' ≅ Y) : N.app Y = F.map φ.inv ≫ N.app Y' ≫ G.map φ.hom := by
  rw [← N.naturality, ← F.map_comp_assoc, φ.inv_hom_id, F.map_id, Category.id_comp]

section MapComp

variable (F : Pseudofunctor B (LinearCat.{w, v, u} k))

omit [∀ a b : B, Preadditive (a ⟶ b)] [∀ a b : B, Linear k (a ⟶ b)]

/-- Component of `F.mapComp f g` with unfolded types. -/
def mcHom {b c d : B} (f : b ⟶ c) (g : c ⟶ d) (X : F.obj b) :
    (F.map (f ≫ g)).obj.obj X ⟶ (F.map g).obj.obj ((F.map f).obj.obj X) :=
  (F.mapComp f g).hom.hom.app X

/-- Component of `(F.mapComp f g).inv` with unfolded types. -/
def mcInv {b c d : B} (f : b ⟶ c) (g : c ⟶ d) (X : F.obj b) :
    (F.map g).obj.obj ((F.map f).obj.obj X) ⟶ (F.map (f ≫ g)).obj.obj X :=
  (F.mapComp f g).inv.hom.app X

@[reassoc]
theorem mcHom_mcInv {b c d : B} (f : b ⟶ c) (g : c ⟶ d) (X : F.obj b) :
    mcHom F f g X ≫ mcInv F f g X = 𝟙 _ := (isoApp (F.mapComp f g) X).hom_inv_id

@[reassoc]
theorem mcInv_mcHom {b c d : B} (f : b ⟶ c) (g : c ⟶ d) (X : F.obj b) :
    mcInv F f g X ≫ mcHom F f g X = 𝟙 _ := (isoApp (F.mapComp f g) X).inv_hom_id

@[reassoc]
theorem mcHom_naturality {b c d : B} (f : b ⟶ c) (g : c ⟶ d) {X Y : F.obj b} (x : X ⟶ Y) :
    (F.map (f ≫ g)).obj.map x ≫ mcHom F f g Y =
      mcHom F f g X ≫ (F.map g).obj.map ((F.map f).obj.map x) :=
  (F.mapComp f g).hom.hom.naturality x

theorem map₂_associator_mc {b c d e : B} (f : b ⟶ c) (g : c ⟶ d) (h : d ⟶ e) (X : F.obj b) :
    (F.map₂ (α_ f g h).hom).hom.app X =
      mcHom F (f ≫ g) h X ≫ (F.map h).obj.map (mcHom F f g X) ≫
        mcInv F g h ((F.map f).obj.obj X) ≫ mcInv F f (g ≫ h) X :=
  map₂_associator_app F f g h X

theorem mcInv_eq_assoc {b c d e : B} (f : b ⟶ c) (g : c ⟶ d) (h : d ⟶ e) (X : F.obj b) :
    mcInv F f (g ≫ h) X = mcHom F g h ((F.map f).obj.obj X) ≫
      (F.map h).obj.map (mcInv F f g X) ≫ mcInv F (f ≫ g) h X ≫
        (F.map₂ (α_ f g h).hom).hom.app X := by
  rw [map₂_associator_mc, mcInv_mcHom_assoc, ← Functor.map_comp_assoc, mcInv_mcHom,
    CategoryTheory.Functor.map_id, Category.id_comp, mcHom_mcInv_assoc]

@[reassoc]
theorem map₂_associator_mc_comp {b c d e : B} (f : b ⟶ c) (g : c ⟶ d) (h : d ⟶ e) (X : F.obj b) :
    (F.map₂ (α_ f g h).hom).hom.app X ≫ mcHom F f (g ≫ h) X ≫ mcHom F g h ((F.map f).obj.obj X) =
      mcHom F (f ≫ g) h X ≫ (F.map h).obj.map (mcHom F f g X) := by
  rw [map₂_associator_mc]
  simp only [Category.assoc]
  rw [mcInv_mcHom_assoc, mcInv_mcHom, Category.comp_id]

end MapComp

theorem natComponent_hom {c d : B} (h : c ⟶ d) (f : a ⟶ c) :
    (natComponent hF h₁ h₂ hK hD h f).hom =
      (extension hF h₁ h₂ hK hD d).map (mcInv ℵ₁ f h P₀) ≫ (extIso hF h₁ h₂ hK hD (f ≫ h)).hom ≫
        mcHom ℵ₂ f h C₀ ≫ (ℵ₂.map h).obj.map (extIso hF h₁ h₂ hK hD f).inv :=
  rfl

theorem naturality_comp_core {c d e : B} (h : c ⟶ d) (h' : d ⟶ e) (f : a ⟶ c) :
    (natComponent hF h₁ h₂ hK hD (h ≫ h') f).hom ≫
        mcHom ℵ₂ h h' ((extension hF h₁ h₂ hK hD c).obj ((ℵ₁.map f).obj.obj P₀)) =
      (extension hF h₁ h₂ hK hD e).map (mcHom ℵ₁ h h' ((ℵ₁.map f).obj.obj P₀)) ≫
        (extension hF h₁ h₂ hK hD e).map ((ℵ₁.map h').obj.map (mcInv ℵ₁ f h P₀)) ≫
          (natComponent hF h₁ h₂ hK hD h' (f ≫ h)).hom ≫
            (ℵ₂.map h').obj.map ((extension hF h₁ h₂ hK hD d).map (mcHom ℵ₁ f h P₀)) ≫
              (ℵ₂.map h').obj.map (natComponent hF h₁ h₂ hK hD h f).hom := by
  set E := extension hF h₁ h₂ hK hD
  have L2 : (E d).map (mcHom ℵ₁ f h P₀) ≫ (natComponent hF h₁ h₂ hK hD h f).hom =
      (extIso hF h₁ h₂ hK hD (f ≫ h)).hom ≫ mcHom ℵ₂ f h C₀ ≫
        (ℵ₂.map h).obj.map (extIso hF h₁ h₂ hK hD f).inv := by
    rw [natComponent_hom, ← Functor.map_comp_assoc, mcHom_mcInv, CategoryTheory.Functor.map_id,
      Category.id_comp]
  rw [← Functor.map_comp (ℵ₂.map h').obj, L2, natComponent_hom, natComponent_hom]
  simp only [Category.assoc, Functor.map_comp, Iso.map_inv_hom_id_assoc]
  rw [mcHom_naturality, mcInv_eq_assoc ℵ₁ f h h' P₀]
  simp only [Functor.map_comp, Category.assoc]
  rw [extension_map_extIso_hom_assoc, transfer_map₂ hF h₁ h₂ hK, map₂_associator_mc_comp_assoc]

/-- Composition of the naturality isomorphisms. -/
theorem naturality_comp' {c d e : B} (h : c ⟶ d) (h' : d ⟶ e) :
    (naturality hF h₁ h₂ hK hD (h ≫ h')).hom ≫ app hF h₁ h₂ hK hD c ◁ (ℵ₂.mapComp h h').hom =
    (ℵ₁.mapComp h h').hom ▷ app hF h₁ h₂ hK hD e ≫
        (α_ (ℵ₁.map h) (ℵ₁.map h') (app hF h₁ h₂ hK hD e)).hom ≫
          ℵ₁.map h ◁ (naturality hF h₁ h₂ hK hD h').hom ≫
            (α_ (ℵ₁.map h) (app hF h₁ h₂ hK hD d) (ℵ₂.map h')).inv ≫
              (naturality hF h₁ h₂ hK hD h).hom ▷ ℵ₂.map h' ≫
                (α_ (app hF h₁ h₂ hK hD c) (ℵ₂.map h) (ℵ₂.map h')).hom := by
  apply ObjectProperty.hom_ext
  apply IsDenseFamily.natTrans_ext (hD c)
  intro f
  change (naturality hF h₁ h₂ hK hD (h ≫ h')).hom.hom.app (family P₀ c f) ≫
      mcHom ℵ₂ h h' ((extension hF h₁ h₂ hK hD c).obj (family P₀ c f)) =
    (extension hF h₁ h₂ hK hD e).map (mcHom ℵ₁ h h' (family P₀ c f)) ≫ 𝟙 _ ≫
      (naturality hF h₁ h₂ hK hD h').hom.hom.app ((ℵ₁.map h).obj.obj (family P₀ c f)) ≫ 𝟙 _ ≫
      (ℵ₂.map h').obj.map ((naturality hF h₁ h₂ hK hD h).hom.hom.app (family P₀ c f)) ≫ 𝟙 _
  erw [natTrans_app_of_iso _ (isoApp (ℵ₁.mapComp f h) P₀), naturality_hom_app,
    naturality_hom_app, naturality_hom_app]
  have hc := naturality_comp_core hF h₁ h₂ hK hD h h' f
  show _ = (extension hF h₁ h₂ hK hD e).map (mcHom ℵ₁ h h' ((ℵ₁.map f).obj.obj P₀)) ≫ 𝟙 _ ≫
      ((extension hF h₁ h₂ hK hD e).map ((ℵ₁.map h').obj.map (mcInv ℵ₁ f h P₀)) ≫
        (natComponent hF h₁ h₂ hK hD h' (f ≫ h)).hom ≫
          (ℵ₂.map h').obj.map ((extension hF h₁ h₂ hK hD d).map (mcHom ℵ₁ f h P₀))) ≫ 𝟙 _ ≫
      (ℵ₂.map h').obj.map (natComponent hF h₁ h₂ hK hD h f).hom ≫ 𝟙 _
  simp only [Category.id_comp, Category.comp_id, Category.assoc]
  exact hc

/-- **The strongly equivariant functor determined by `C₀`.** -/
noncomputable def strongTrans : StronglyEquivariant ℵ₁ ℵ₂ where
  app := app hF h₁ h₂ hK hD
  naturality h := naturality hF h₁ h₂ hK hD h
  naturality_naturality θ := naturality_naturality' hF h₁ h₂ hK hD θ
  naturality_id c := naturality_id' hF h₁ h₂ hK hD c
  naturality_comp h h' := naturality_comp' hF h₁ h₂ hK hD h h'

/-- `isoApp (ℵ.mapId b) X`, with its target written as `X`. -/
abbrev idApp (ℵ : Pseudofunctor B (LinearCat.{w, v, u} k)) (b : B) (X : ℵ.obj b) :
    (ℵ.map (𝟙 b)).obj.obj X ≅ X :=
  isoApp (ℵ.mapId b) X

/-- The strongly equivariant functor `strongTrans` sends `P₀` to `C₀`. -/
noncomputable def strongTransAppIso :
    ((strongTrans hF h₁ h₂ hK hD).app a).obj.obj P₀ ≅ C₀ :=
  (extension hF h₁ h₂ hK hD a).mapIso (idApp ℵ₁ a P₀).symm ≪≫
    extIso hF h₁ h₂ hK hD (𝟙 a) ≪≫ idApp ℵ₂ a C₀

end Construction

section Uniqueness

omit [∀ a b : B, Preadditive (a ⟶ b)] [∀ a b : B, Linear k (a ⟶ b)]

variable {ℵ₁ ℵ₂ : Pseudofunctor B (LinearCat.{w, v, u} k)} {P₀ : ℵ₁.obj a}

open Pseudofunctor.StrongTrans

/-- The component of a modification at an image of `P₀` is determined by its component at
`P₀`. -/
theorem modification_app_family {β β' : StronglyEquivariant ℵ₁ ℵ₂} (Γ : Modification β β')
    {c : B} (f : a ⟶ c) :
    (Γ.app c).hom.app (family P₀ c f) =
      (β.naturality f).hom.hom.app P₀ ≫ (ℵ₂.map f).obj.map ((Γ.app a).hom.app P₀) ≫
        (β'.naturality f).inv.hom.app P₀ := by
  have h := congrArg (fun θ => θ.hom.app P₀) (Γ.naturality f)
  have h' : (Γ.app c).hom.app (family P₀ c f) ≫ (β'.naturality f).hom.hom.app P₀ =
      (β.naturality f).hom.hom.app P₀ ≫ (ℵ₂.map f).obj.map ((Γ.app a).hom.app P₀) := h
  have hinv : (β'.naturality f).hom.hom.app P₀ ≫ (β'.naturality f).inv.hom.app P₀ = 𝟙 _ :=
    congrArg (fun θ => θ.hom.app P₀) (β'.naturality f).hom_inv_id
  erw [← Category.assoc, ← h', Category.assoc, hinv, Category.comp_id]

/-- **Uniqueness of morphisms of strongly equivariant functors**: when the images of `P₀` are
dense, two modifications agreeing at `P₀` are equal. -/
theorem modification_ext (hD : ∀ c : B, IsDenseFamily (family P₀ c))
    {β β' : StronglyEquivariant ℵ₁ ℵ₂} {Γ Γ' : Modification β β'}
    (h : (Γ.app a).hom.app P₀ = (Γ'.app a).hom.app P₀) : Γ = Γ' := by
  have : ∀ c, Γ.app c = Γ'.app c := fun c => by
    apply ObjectProperty.hom_ext
    apply (hD c).natTrans_ext
    intro f
    rw [modification_app_family, modification_app_family, h]
  cases Γ; cases Γ'; congr; funext c; exact this c

/-- Components of the naturality isomorphism of a strong transformation, with source and target
written as composites of functors. -/
abbrev natApp (β : ℵ₁ ⟶ ℵ₂) {b c : B} (f : b ⟶ c) (X : ℵ₁.obj b) :
    (β.app c).obj.obj ((ℵ₁.map f).obj.obj X) ≅ (ℵ₂.map f).obj.obj ((β.app b).obj.obj X) :=
  isoApp (β.naturality f) X

section Isomorphism

variable (hF : Full ℵ₁ P₀) (hD : ∀ c : B, IsDenseFamily (family P₀ c))
  {β β' : ℵ₁ ⟶ ℵ₂} (e₀ : (β.app a).obj.obj P₀ ≅ (β'.app a).obj.obj P₀)

/-- The component at `ℵ₁(f) P₀` of the isomorphism `β ≅ β'`. -/
def isoComponent {c : B} (f : a ⟶ c) :
    (β.app c).obj.obj (family P₀ c f) ≅ (β'.app c).obj.obj (family P₀ c f) :=
  natApp β f P₀ ≪≫ (ℵ₂.map f).obj.mapIso e₀ ≪≫ (natApp β' f P₀).symm

include hF in
theorem isoComponent_natural {c : B} {f f' : a ⟶ c} (g : family P₀ c f ⟶ family P₀ c f') :
    (β.app c).obj.map g ≫ (isoComponent e₀ f').hom =
      (isoComponent e₀ f).hom ≫ (β'.app c).obj.map g := by
  obtain ⟨φ, rfl⟩ := hF f f' g
  have w : (β.app c).obj.map ((ℵ₁.map₂ φ).hom.app P₀) ≫ (natApp β f' P₀).hom =
      (natApp β f P₀).hom ≫ (ℵ₂.map₂ φ).hom.app ((β.app a).obj.obj P₀) :=
    congrArg (fun θ => θ.hom.app P₀) (β.naturality_naturality φ)
  have w' : (β'.app c).obj.map ((ℵ₁.map₂ φ).hom.app P₀) ≫ (natApp β' f' P₀).hom =
      (natApp β' f P₀).hom ≫ (ℵ₂.map₂ φ).hom.app ((β'.app a).obj.obj P₀) :=
    congrArg (fun θ => θ.hom.app P₀) (β'.naturality_naturality φ)
  have m := (ℵ₂.map₂ φ).hom.naturality e₀.hom
  have w'' : (natApp β' f P₀).inv ≫ (β'.app c).obj.map ((ℵ₁.map₂ φ).hom.app P₀) =
      (ℵ₂.map₂ φ).hom.app ((β'.app a).obj.obj P₀) ≫ (natApp β' f' P₀).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← w', Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  simp only [isoComponent, Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom]
  rw [← Category.assoc, w, Category.assoc, Category.assoc, Category.assoc, w'']
  congr 1
  rw [← Category.assoc, ← Category.assoc]
  congr 1
  exact m.symm

/-- The components of the isomorphism `β ≅ β'` at `c`. -/
noncomputable def isoAt (c : B) : β.app c ≅ β'.app c :=
  ObjectProperty.isoMk _ ((hD c).extendNatIso (F := (β.app c).obj) (G := (β'.app c).obj)
    (fun f => isoComponent e₀ f) (fun g => isoComponent_natural hF e₀ g))

theorem isoAt_hom_app {c : B} (f : a ⟶ c) :
    (isoAt hF hD e₀ c).hom.hom.app (family P₀ c f) = (isoComponent e₀ f).hom :=
  IsDenseFamily.extendNatIso_hom_app (hD c) _ (fun g => isoComponent_natural hF e₀ g) f

/-- The categorical bookkeeping behind `isoAt_naturality`. -/
theorem isoAt_naturality_aux {C D E : Type*} [Category C] [Category D] [Category E]
    (Bd B'd : C ⥤ D) (H : E ⥤ D) {Z X : C} (m : Z ≅ X) (tX : Bd.obj X ⟶ B'd.obj X)
    (tZ : Bd.obj Z ⟶ B'd.obj Z) (nat : Bd.map m.hom ≫ tX = tZ ≫ B'd.map m.hom)
    {P P' : D} {U U' : E} (p : Bd.obj Z ≅ P) (q : P ⟶ P') (p' : B'd.obj Z ≅ P')
    (htZ : tZ = p.hom ≫ q ≫ p'.inv)
    (cc : P ≅ H.obj U) (cc' : P' ≅ H.obj U') (r : U ⟶ U')
    (hq : q ≫ cc'.hom = cc.hom ≫ H.map r)
    {W W' : E} (nh : Bd.obj X ≅ H.obj W) (nf : W ≅ U) (nh' : B'd.obj X ≅ H.obj W')
    (nf' : W' ≅ U')
    (Nβ : p.hom ≫ cc.hom = Bd.map m.hom ≫ 𝟙 _ ≫ nh.hom ≫ 𝟙 _ ≫ H.map nf.hom ≫ 𝟙 _)
    (Nβ' : p'.hom ≫ cc'.hom = B'd.map m.hom ≫ 𝟙 _ ≫ nh'.hom ≫ 𝟙 _ ≫ H.map nf'.hom ≫ 𝟙 _) :
    tX ≫ nh'.hom = nh.hom ≫ H.map (nf.hom ≫ r ≫ nf'.inv) := by
  simp only [Category.id_comp, Category.comp_id] at Nβ Nβ'
  have hX : tX = Bd.map m.inv ≫ tZ ≫ B'd.map m.hom := by
    rw [← nat, ← Category.assoc, ← Functor.map_comp, Iso.inv_hom_id,
      CategoryTheory.Functor.map_id, Category.id_comp]
  have h1 : p'.inv ≫ B'd.map m.hom ≫ nh'.hom = cc'.hom ≫ H.map nf'.inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, Nβ', Category.assoc, Category.assoc, ← H.map_comp,
      Iso.hom_inv_id, CategoryTheory.Functor.map_id, Category.comp_id]
  have h2 : p.hom ≫ cc.hom = Bd.map m.hom ≫ nh.hom ≫ H.map nf.hom := Nβ
  rw [hX, htZ]
  simp only [Category.assoc]
  rw [h1, reassoc_of% hq, reassoc_of% h2, ← Category.assoc (Bd.map m.inv),
    ← Functor.map_comp, Iso.inv_hom_id, CategoryTheory.Functor.map_id, Category.id_comp]
  simp only [Functor.map_comp]

theorem isoAt_naturality {c d : B} (h : c ⟶ d) :
    ℵ₁.map h ◁ (isoAt hF hD e₀ d).hom ≫ (β'.naturality h).hom =
      (β.naturality h).hom ≫ (isoAt hF hD e₀ c).hom ▷ ℵ₂.map h := by
  apply ObjectProperty.hom_ext
  refine IsDenseFamily.natTrans_ext (hD c) (fun f => ?_)
  have nat := (isoAt hF hD e₀ d).hom.hom.naturality (mapCompApp ℵ₁ f h P₀).hom
