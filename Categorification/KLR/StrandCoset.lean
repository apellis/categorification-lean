import Categorification.KLR.Filtration
import Categorification.KLR.Symmetries

/-!
# Diagrams on the first strands: isolating the last strand

For a KLR algebra `R(ν)` and `n ≤ |ν|`, let `R_{<n}` (`KLRAlgebra.leftSub n`) be the subalgebra
generated by all idempotents `e(i)`, the dots `x_a` with `a < n` and the crossings `ψ_p` with
`p + 1 < n`: the diagrams which leave the strands `n, n + 1, …` untouched (up to their labels).

The main result is the coset decomposition of `R_{<n+1}` along the strand ending at the bottom
position `n` (the factorization `S_{n+1} = ⨆_q c_q (S_n × S_1)` by the minimal length coset
representatives `c_q = s_q s_{q+1} ⋯ s_{n-1}`, read on diagrams):

`R_{<n+1} ⊆ ∑_{q ≤ n} c_q · R_{<n} · k[x_n]`, `c_q = ψ_q ψ_{q+1} ⋯ ψ_{n-1}`
(`KLRAlgebra.mem_cosetSpan`).

Here a product `a b` is `a` stacked on top of `b`, so `c_q` takes the strand at the top position
`q` to the bottom position `n`. This is the spanning half of the left version of
Khovanov–Lauda I (arXiv:0803.4121v2), Proposition 2.16, for the decomposition `ν = ν' + i` with
the strand of colour `i` last, in a form that does not split the weight: it is used to trace a
strand reaching the right edge of a block of strands (Webster, arXiv:1309.3796v3, proof of
Lemma 7.17). It holds over every commutative ring for all data `Q`.

## Main definitions

* `KLRAlgebra.leftSub n`: the subalgebra `R_{<n}`.
* `KLRAlgebra.toRight q n`: the crossings `ψ_q ψ_{q+1} ⋯ ψ_{n-1}`.
* `KLRAlgebra.cosetSpan hn c`: the span of the `c_q y x_n^d` with `c ≤ q ≤ n`, `y ∈ R_{<n}`.

## Main results

* `KLRAlgebra.exists_mul_ψ_eq`: `z ψ_p = ψ_p z'` with `z' ∈ R_{<n}` for `z ∈ R_{<n}`, `p ≥ n`.
* `KLRAlgebra.commute_x_of_le`: `R_{<n}` commutes with `x_a` for `a ≥ n`.
* `KLRAlgebra.mem_cosetSpan`: the coset decomposition.
-/

namespace Categorification.KLR

open Equiv MvPolynomial TypeA

variable {I : Type*} {k : Type*} [CommRing k] [DecidableEq I]

namespace KLRAlgebra

variable {Q : I → I → MvPolynomial (Fin 2) k} {ν : Multiset I}

local notation "m" => Multiset.card ν
local notation "R" => KLRAlgebra k Q ν

/-! ### Generic closure lemmas -/

section Closure

variable {A : Type*} [Ring A] [Algebra k A]

/-- Left multiplication by an element of `adjoin s` preserves a submodule preserved by
left multiplication by `s`. -/
theorem adjoin_mul_mem {s : Set A} {S : Submodule k A} (h : ∀ g ∈ s, ∀ w ∈ S, g * w ∈ S)
    {z : A} (hz : z ∈ Algebra.adjoin k s) {w : A} (hw : w ∈ S) : z * w ∈ S := by
  induction hz using Algebra.adjoin_induction generalizing w with
  | mem g hg => exact h g hg w hw
  | algebraMap r => rw [← Algebra.smul_def]; exact S.smul_mem r hw
  | add a b _ _ ha hb => rw [add_mul]; exact S.add_mem (ha hw) (hb hw)
  | mul a b _ _ ha hb => rw [mul_assoc]; exact ha (hb hw)

/-- Left multiplication by `g` preserves `S` if it maps the generators of a span into `S`. -/
theorem mul_span_mem {t : Set A} {S : Submodule k A} {g : A} (h : ∀ w ∈ t, g * w ∈ S)
    {w : A} (hw : w ∈ Submodule.span k t) : g * w ∈ S := by
  induction hw using Submodule.span_induction with
  | mem w hw => exact h w hw
  | zero => rw [mul_zero]; exact S.zero_mem
  | add a b _ _ ha hb => rw [mul_add]; exact S.add_mem ha hb
  | smul c a _ ha => rw [mul_smul_comm]; exact S.smul_mem c ha

theorem ncEval_mem {S : Subalgebra k A} {r : ℕ} {y : Fin r → A} (hy : ∀ a, y a ∈ S)
    (p : MvPolynomial (Fin r) k) : ncEval y p ∈ S := by
  unfold ncEval
  refine Subalgebra.sum_mem _ fun s _ => S.mul_mem (S.algebraMap_mem _) ?_
  refine Subalgebra.list_prod_mem _ fun z hz => ?_
  obtain ⟨a, rfl⟩ := List.mem_ofFn.1 hz
  exact S.pow_mem (hy a) _

end Closure

/-! ### Commuting past words of crossings -/

theorem ψ_mul_ψw_of_lt (p : ℕ) (ρ : List ℕ) (h : ∀ r ∈ ρ, p + 1 < r) :
    (ψ p * ψw ρ : R) = ψw ρ * ψ p := by
  induction ρ with
  | nil => simp
  | cons r ρ ih =>
    rw [ψw_cons, ← mul_assoc, ψ_mul_ψ p r (h r (by simp)), mul_assoc,
      ih fun r' hr' => h r' (by simp [hr']), mul_assoc]

theorem x_mul_ψw_of_ne (a : Fin m) (ρ : List ℕ) (h : ∀ r ∈ ρ, a.val ≠ r ∧ a.val ≠ r + 1) :
    (x a * ψw ρ : R) = ψw ρ * x a := by
  induction ρ with
  | nil => simp
  | cons r ρ ih =>
    rw [ψw_cons, ← mul_assoc, x_mul_ψ a r (h r (by simp)).1 (h r (by simp)).2, mul_assoc,
      ih fun r' hr' => h r' (by simp [hr']), mul_assoc]

/-! ### The subalgebra of diagrams on the first strands -/

variable (Q ν) in
/-- The generators of `R_{<n}`. -/
def leftGens (n : ℕ) : Set R :=
  Set.range (e : Seq ν → R) ∪ {y | ∃ a : Fin m, a.val < n ∧ y = x a} ∪
    {y | ∃ p : ℕ, p + 1 < n ∧ y = ψ p}

variable (Q ν) in
/-- **The diagrams on the first `n` strands**: the subalgebra generated by all idempotents,
the dots on the strands `0, …, n - 1` and the crossings among them. -/
noncomputable def leftSub (n : ℕ) : Subalgebra k R := Algebra.adjoin k (leftGens Q ν n)

theorem e_mem_leftSub (n : ℕ) (i : Seq ν) : (e i : R) ∈ leftSub Q ν n :=
  Algebra.subset_adjoin (Or.inl (Or.inl ⟨i, rfl⟩))

theorem x_mem_leftSub {n : ℕ} (a : Fin m) (ha : a.val < n) : (x a : R) ∈ leftSub Q ν n :=
  Algebra.subset_adjoin (Or.inl (Or.inr ⟨a, ha, rfl⟩))

theorem ψ_mem_leftSub {n p : ℕ} (hp : p + 1 < n) : (ψ p : R) ∈ leftSub Q ν n :=
  Algebra.subset_adjoin (Or.inr ⟨p, hp, rfl⟩)

theorem ψw_mem_leftSub {n : ℕ} {ρ : List ℕ} (h : ∀ p ∈ ρ, p + 1 < n) :
    (ψw ρ : R) ∈ leftSub Q ν n := by
  induction ρ with
  | nil => simp
  | cons p ρ ih =>
    rw [ψw_cons]
    exact mul_mem (ψ_mem_leftSub (h p (by simp))) (ih fun q hq => h q (by simp [hq]))

theorem leftSub_mono {n n' : ℕ} (h : n ≤ n') : leftSub Q ν n ≤ leftSub Q ν n' := by
  refine Algebra.adjoin_le ?_
  rintro y ((⟨i, rfl⟩ | ⟨a, ha, rfl⟩) | ⟨p, hp, rfl⟩)
  · exact e_mem_leftSub n' i
  · exact x_mem_leftSub a (by omega)
  · exact ψ_mem_leftSub (by omega)

/-- `R_{<n}` commutes with the dots on the strands `a ≥ n`. -/
theorem commute_x_of_le {n : ℕ} {z : R} (hz : z ∈ leftSub Q ν n) (a : Fin m) (ha : n ≤ a.val) :
    Commute z (x a) := by
  have : leftSub Q ν n ≤ Subalgebra.centralizer k {(x a : R)} := by
    refine Algebra.adjoin_le ?_
    rintro y ((⟨i, rfl⟩ | ⟨b, hb, rfl⟩) | ⟨p, hp, rfl⟩) <;>
      simp only [SetLike.mem_coe, Subalgebra.mem_centralizer_iff, Set.mem_singleton_iff,
        forall_eq]
    · exact x_mul_e a i
    · exact x_mul_x a b
    · exact x_mul_ψ a p (by omega) (by omega)
  exact ((Subalgebra.mem_centralizer_iff k).1 (this hz) (x a) rfl).symm

/-- A crossing `ψ_p` with `p ≥ n` passes through `R_{<n}`, relabelling the idempotents. -/
theorem exists_mul_ψ_eq {n : ℕ} {z : R} (hz : z ∈ leftSub Q ν n) (p : ℕ) (hp : n ≤ p) :
    ∃ z' ∈ leftSub Q ν n, z * ψ p = ψ p * z' := by
  induction hz using Algebra.adjoin_induction with
  | mem y hy =>
    rcases hy with (⟨i, rfl⟩ | ⟨a, ha, rfl⟩) | ⟨q, hq, rfl⟩
    · refine ⟨e (sadj m p • i), e_mem_leftSub n _, ?_⟩
      rw [ψ_mul_e, KLRAlgebra.sadj_smul_smul]
    · exact ⟨x a, x_mem_leftSub a ha, x_mul_ψ a p (by omega) (by omega)⟩
    · exact ⟨ψ q, ψ_mem_leftSub hq, ψ_mul_ψ q p (by omega)⟩
  | algebraMap r => exact ⟨algebraMap k R r, Subalgebra.algebraMap_mem _ r,
      Algebra.commutes r _⟩
  | add a b _ _ ha hb =>
    obtain ⟨a', ha', ea⟩ := ha
    obtain ⟨b', hb', eb⟩ := hb
    exact ⟨a' + b', add_mem ha' hb', by rw [add_mul, ea, eb, mul_add]⟩
  | mul a b _ _ ha hb =>
    obtain ⟨a', ha', ea⟩ := ha
    obtain ⟨b', hb', eb⟩ := hb
    exact ⟨a' * b', mul_mem ha' hb', by rw [mul_assoc, eb, ← mul_assoc, ea, mul_assoc]⟩

/-! ### The dots and idempotents -/

variable (Q ν) in
/-- The subalgebra generated by the idempotents and the dots on the strands `0, …, n`. -/
noncomputable def dotIdemSub (n : ℕ) : Subalgebra k R :=
  Algebra.adjoin k (Set.range (e : Seq ν → R) ∪ {y | ∃ a : Fin m, a.val ≤ n ∧ y = x a})

theorem e_mem_dotIdemSub (n : ℕ) (i : Seq ν) : (e i : R) ∈ dotIdemSub Q ν n :=
  Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)

theorem x_mem_dotIdemSub {n : ℕ} (a : Fin m) (ha : a.val ≤ n) : (x a : R) ∈ dotIdemSub Q ν n :=
  Algebra.subset_adjoin (Or.inr ⟨a, ha, rfl⟩)

theorem sum_e_mem_dotIdemSub (n : ℕ) (T : Finset (Seq ν)) :
    (∑ i ∈ T, e i : R) ∈ dotIdemSub Q ν n :=
  Subalgebra.sum_mem _ fun i _ => e_mem_dotIdemSub n i

/-- `x_j ψ_j - ψ_j x_{j+1}` is the sum of the idempotents with equal colours at `j`, `j + 1`. -/
theorem dot_cross_left_eq (j : ℕ) (h : j + 1 < m) :
    (x ⟨j, by omega⟩ * ψ j - ψ j * x ⟨j + 1, h⟩ : R) =
      ∑ i ∈ Finset.univ.filter (fun i : Seq ν => i.lbl ⟨j, by omega⟩ = i.lbl ⟨j + 1, h⟩), e i := by
  rw [← mul_one (x ⟨j, by omega⟩ * ψ j - ψ j * x ⟨j + 1, h⟩ : R), ← sum_e, Finset.mul_sum,
    Finset.sum_filter]
  exact Finset.sum_congr rfl fun i _ => dot_cross_left j h i

/-- `ψ_j x_j - x_{j+1} ψ_j` is the sum of the idempotents with equal colours at `j`, `j + 1`. -/
theorem dot_cross_right_eq (j : ℕ) (h : j + 1 < m) :
    (ψ j * x ⟨j, by omega⟩ - x ⟨j + 1, h⟩ * ψ j : R) =
      ∑ i ∈ Finset.univ.filter (fun i : Seq ν => i.lbl ⟨j, by omega⟩ = i.lbl ⟨j + 1, h⟩), e i := by
  rw [← mul_one (ψ j * x ⟨j, by omega⟩ - x ⟨j + 1, h⟩ * ψ j : R), ← sum_e, Finset.mul_sum,
    Finset.sum_filter]
  exact Finset.sum_congr rfl fun i _ => dot_cross_right j h i

theorem ψ_mul_ψ_mem_dotIdemSub (j : ℕ) (h : j + 1 < m) :
    (ψ j * ψ j : R) ∈ dotIdemSub Q ν (j + 1) := by
  rw [← mul_one (ψ j * ψ j : R), ← sum_e, Finset.mul_sum]
  refine Subalgebra.sum_mem _ fun i _ => ?_
  rw [ψ_sq j h i]
  split_ifs
  · exact Subalgebra.zero_mem _
  · refine mul_mem (ncEval_mem (fun a => ?_) _) (e_mem_dotIdemSub _ i)
    fin_cases a
    · exact x_mem_dotIdemSub _ (by simp)
    · exact x_mem_dotIdemSub _ (by simp)

theorem braid_mem_dotIdemSub (j : ℕ) (h : j + 2 < m) :
    (ψ j * ψ (j + 1) * ψ j - ψ (j + 1) * ψ j * ψ (j + 1) : R) ∈ dotIdemSub Q ν (j + 2) := by
  rw [← mul_one (ψ j * ψ (j + 1) * ψ j - ψ (j + 1) * ψ j * ψ (j + 1) : R), ← sum_e,
    Finset.mul_sum]
  refine Subalgebra.sum_mem _ fun i _ => ?_
  rw [braid j h i]
  split_ifs
  · refine mul_mem (ncEval_mem (fun a => ?_) _) (e_mem_dotIdemSub _ i)
    fin_cases a
    · exact x_mem_dotIdemSub _ (by simp)
    · exact x_mem_dotIdemSub _ (by simp)
    · exact x_mem_dotIdemSub _ (by simp)
  · exact Subalgebra.zero_mem _

theorem dotIdemSub_mono {n n' : ℕ} (h : n ≤ n') : dotIdemSub Q ν n ≤ dotIdemSub Q ν n' := by
  refine Algebra.adjoin_le ?_
  rintro y (⟨i, rfl⟩ | ⟨a, ha, rfl⟩)
  · exact e_mem_dotIdemSub n' i
  · exact x_mem_dotIdemSub a (by omega)

/-! ### The coset decomposition -/

/-- The crossings `ψ_q ψ_{q+1} ⋯ ψ_{n-1}`, taking the strand at the top position `q` to the
bottom position `n`. -/
noncomputable def toRight (q n : ℕ) : R := ψw (List.range' q (n - q))

@[simp] theorem toRight_self (n : ℕ) : (toRight n n : R) = 1 := by simp [toRight]

theorem toRight_eq_cons {q n : ℕ} (h : q < n) : (toRight q n : R) = ψ q * toRight (q + 1) n := by
  rw [toRight, toRight, show n - q = (n - (q + 1)) + 1 by omega, List.range'_succ, ψw_cons]

theorem mem_range'_toRight {q n r : ℕ} (hr : r ∈ List.range' q (n - q)) : q ≤ r ∧ r < n := by
  rw [List.mem_range'_1] at hr; omega

theorem ψ_mul_toRight_of_lt {p q n : ℕ} (h : p + 1 < q) :
    (ψ p * toRight q n : R) = toRight q n * ψ p :=
  ψ_mul_ψw_of_lt p _ fun r hr => by have := mem_range'_toRight hr; omega

theorem x_mul_toRight_of_lt (a : Fin m) {q n : ℕ} (h : a.val < q) :
    (x a * toRight q n : R) = toRight q n * x a :=
  x_mul_ψw_of_ne a _ fun r hr => by have := mem_range'_toRight hr; omega

theorem e_mul_toRight (i : Seq ν) (q n : ℕ) :
    ∃ i' : Seq ν, (e i * toRight q n : R) = toRight q n * e i' :=
  ⟨_, e_mul_ψw _ i⟩

variable {n : ℕ}

variable (Q ν) in
/-- **The coset span**: the `k`-span of the elements `ψ_q ⋯ ψ_{n-1} · y · x_n^d` with
`c ≤ q ≤ n` and `y ∈ R_{<n}`. -/
noncomputable def cosetSpan (hn : n < m) (c : ℕ) : Submodule k R :=
  Submodule.span k {w : R | ∃ q, c ≤ q ∧ q ≤ n ∧ ∃ y ∈ leftSub Q ν n, ∃ d : ℕ,
    w = toRight q n * y * (x ⟨n, hn⟩ : R) ^ d}

theorem cosetSpan_anti (hn : n < m) {c c' : ℕ} (h : c ≤ c') :
    cosetSpan Q ν hn c' ≤ cosetSpan Q ν hn c := by
  refine Submodule.span_mono ?_
  rintro w ⟨q, hq, hqn, y, hy, d, rfl⟩
  exact ⟨q, by omega, hqn, y, hy, d, rfl⟩

theorem gen_mem_cosetSpan (hn : n < m) {c q : ℕ} (hq : c ≤ q) (hqn : q ≤ n) {y : R}
    (hy : y ∈ leftSub Q ν n)
    (d : ℕ) : toRight q n * y * (x ⟨n, hn⟩ : R) ^ d ∈ cosetSpan Q ν hn c :=
  Submodule.subset_span ⟨q, hq, hqn, y, hy, d, rfl⟩

theorem e_mul_cosetSpan (hn : n < m) (c : ℕ) (i : Seq ν) {w : R} (hw : w ∈ cosetSpan Q ν hn c) :
    e i * w ∈ cosetSpan Q ν hn c := by
  refine mul_span_mem ?_ hw
  rintro w ⟨q, hq, hqn, y, hy, d, rfl⟩
  obtain ⟨i', hi'⟩ := e_mul_toRight (Q := Q) i q n
  rw [← mul_assoc, ← mul_assoc, hi', mul_assoc (toRight q n)]
  exact gen_mem_cosetSpan hn hq hqn (mul_mem (e_mem_leftSub n i') hy) d

/-- `ψ_q` maps the coset span from `q + 1` into the coset span from `q`. -/
theorem ψ_mul_cosetSpan (hn : n < m) {q : ℕ} (hq : q < n) {w : R}
    (hw : w ∈ cosetSpan Q ν hn (q + 1)) :
    ψ q * w ∈ cosetSpan Q ν hn q := by
  refine mul_span_mem ?_ hw
  rintro w ⟨q', hq', hqn, y, hy, d, rfl⟩
  rcases Nat.lt_or_ge (q + 1) q' with h | h
  · rw [← mul_assoc, ← mul_assoc, ψ_mul_toRight_of_lt h, mul_assoc (toRight q' n)]
    exact gen_mem_cosetSpan hn (by omega) hqn
      (mul_mem (ψ_mem_leftSub (by omega)) hy) d
  · obtain rfl : q' = q + 1 := by omega
    rw [← mul_assoc, ← mul_assoc, ← toRight_eq_cons hq]
    exact gen_mem_cosetSpan hn le_rfl (by omega) hy d

/-- Dots on the strands `0, …, n` preserve the coset span from `c`. -/
theorem x_mul_cosetSpan (hn : n < m) (c : ℕ) (a : Fin m) (ha : a.val ≤ n) {w : R}
    (hw : w ∈ cosetSpan Q ν hn c) : x a * w ∈ cosetSpan Q ν hn c := by
  refine mul_span_mem ?_ hw
  rintro w ⟨q, hq, hqn, y, hy, d, rfl⟩
  refine cosetSpan_anti hn hq ?_
  clear hq
  induction hqn using Nat.decreasingInduction generalizing a with
  | self =>
    rcases Nat.lt_or_ge a.val n with h | h
    · have := gen_mem_cosetSpan hn le_rfl le_rfl (mul_mem (x_mem_leftSub a h) hy) d
      rw [toRight_self, one_mul, mul_assoc] at this
      rwa [toRight_self, one_mul]
    · obtain rfl : a = ⟨n, hn⟩ := Fin.ext (show a.val = n by omega)
      have := gen_mem_cosetSpan hn le_rfl le_rfl hy (d + 1)
      rw [toRight_self, one_mul, pow_succ', ← mul_assoc, (commute_x_of_le hy _ le_rfl).eq,
        mul_assoc] at this
      rwa [toRight_self, one_mul]
  | of_succ q hqn' ih =>
    have hG : (toRight q n * y * (x ⟨n, hn⟩ : R) ^ d) =
        ψ q * (toRight (q + 1) n * y * (x ⟨n, hn⟩ : R) ^ d) := by
      rw [toRight_eq_cons hqn']; simp only [mul_assoc]
    rw [hG]
    have hq1 := cosetSpan_anti (Q := Q) (ν := ν) hn (Nat.le_succ q)
    have hD : ∀ T : Finset (Seq ν),
        (∑ i ∈ T, (e i : R)) * (toRight (q + 1) n * y * (x ⟨n, hn⟩ : R) ^ d) ∈
          cosetSpan Q ν hn q := by
      intro T
      refine hq1 ?_
      rw [Finset.sum_mul]
      exact Submodule.sum_mem _ fun i _ => e_mul_cosetSpan hn _ i
        (gen_mem_cosetSpan hn le_rfl hqn' hy d)
    by_cases h1 : a.val = q
    · -- `x_q ψ_q = ψ_q x_{q+1} + (idempotents)`
      rw [show a = ⟨q, hqn'.trans hn⟩ from Fin.ext h1]
      have key := sub_eq_iff_eq_add.1 (dot_cross_left_eq (Q := Q) (ν := ν) q (by omega))
      rw [← mul_assoc, key, add_mul, mul_assoc (ψ q)]
      exact add_mem (hD _)
        (ψ_mul_cosetSpan hn hqn' (ih ⟨q + 1, by omega⟩ (by simp; omega)))
    by_cases h2 : a.val = q + 1
    · -- `x_{q+1} ψ_q = ψ_q x_q - (idempotents)`
      rw [show a = ⟨q + 1, (Nat.succ_le_of_lt hqn').trans_lt hn⟩ from Fin.ext h2]
      have key := dot_cross_right_eq (Q := Q) (ν := ν) q (by omega)
      have key' : (x ⟨q + 1, by omega⟩ * ψ q : R) = ψ q * x ⟨q, by omega⟩ -
          ∑ i ∈ Finset.univ.filter (fun i : Seq ν => i.lbl ⟨q, by omega⟩ =
            i.lbl ⟨q + 1, by omega⟩), e i := by
        rw [← key]; abel
      rw [← mul_assoc, key', sub_mul, mul_assoc (ψ q)]
      refine sub_mem (ψ_mul_cosetSpan hn hqn' ?_) (hD _)
      rw [← mul_assoc, ← mul_assoc, x_mul_toRight_of_lt _ (by simp), mul_assoc (toRight _ _)]
      exact gen_mem_cosetSpan hn le_rfl hqn' (mul_mem (x_mem_leftSub _ (by simp; omega)) hy) d
    · rw [← mul_assoc, x_mul_ψ a q h1 h2, mul_assoc (ψ q)]
      exact ψ_mul_cosetSpan hn hqn' (ih a ha)

/-- The subalgebra of idempotents and dots on the strands `0, …, n` preserves the coset span. -/
theorem dotIdemSub_mul_cosetSpan (hn : n < m) (c : ℕ) {z : R} (hz : z ∈ dotIdemSub Q ν n) {w : R}
    (hw : w ∈ cosetSpan Q ν hn c) : z * w ∈ cosetSpan Q ν hn c := by
  refine adjoin_mul_mem ?_ hz hw
  rintro g (⟨i, rfl⟩ | ⟨a, ha, rfl⟩) w hw
  · exact e_mul_cosetSpan hn c i hw
  · exact x_mul_cosetSpan hn c a ha hw

/-- `ψ_p` with `q < p < n` maps the coset generators at `q` into the coset span from `q`. -/
theorem ψ_mul_gen_of_lt (hn : n < m) {p q : ℕ} (hpq : q < p) (hp : p < n) {y : R}
    (hy : y ∈ leftSub Q ν n)
    (d : ℕ) : ψ p * (toRight q n * y * (x ⟨n, hn⟩ : R) ^ d) ∈ cosetSpan Q ν hn q := by
  have hqn : q ≤ n := by omega
  induction hqn using Nat.decreasingInduction with
  | self => omega
  | of_succ q hqn ih =>
    rw [toRight_eq_cons (by omega)]
    rcases Nat.lt_or_ge (q + 1) p with h | h
    · have e1 : (ψ p * (ψ q * toRight (q + 1) n * y * (x ⟨n, hn⟩ : R) ^ d)) =
          ψ q * (ψ p * (toRight (q + 1) n * y * (x ⟨n, hn⟩ : R) ^ d)) := by
        simp only [← mul_assoc]; rw [ψ_mul_ψ q p (by omega)]
      rw [e1]
      exact ψ_mul_cosetSpan hn (by omega) (ih h)
    · obtain rfl : p = q + 1 := by omega
      -- braid: `ψ_{q+1} ψ_q ψ_{q+1} = ψ_q ψ_{q+1} ψ_q - (dots and idempotents)`
      have key := braid_mem_dotIdemSub (Q := Q) (ν := ν) q (by omega)
      rw [toRight_eq_cons (show q + 1 < n by omega)]
      have e1 : (ψ (q + 1) * (ψ q * (ψ (q + 1) * toRight (q + 1 + 1) n) * y *
          (x ⟨n, hn⟩ : R) ^ d) : R) =
          ψ q * ψ (q + 1) * ψ q * toRight (q + 2) n * y * (x ⟨n, hn⟩ : R) ^ d -
            (ψ q * ψ (q + 1) * ψ q - ψ (q + 1) * ψ q * ψ (q + 1)) * (toRight (q + 2) n * y *
              (x ⟨n, hn⟩ : R) ^ d) := by
        noncomm_ring
      rw [e1]
      refine sub_mem ?_ ?_
      · rw [mul_assoc (ψ q * ψ (q + 1)) (ψ q), ψ_mul_toRight_of_lt (by omega), ← mul_assoc,
          mul_assoc (ψ q), ← toRight_eq_cons (by omega), ← toRight_eq_cons (by omega),
          mul_assoc (toRight q n)]
        exact gen_mem_cosetSpan hn le_rfl (by omega) (mul_mem (ψ_mem_leftSub (by omega)) hy) d
      · exact cosetSpan_anti hn (by omega) (dotIdemSub_mul_cosetSpan hn _
          (dotIdemSub_mono (by omega) key) (gen_mem_cosetSpan hn le_rfl (by omega) hy d))

/-- The crossings `ψ_p` with `p < n` preserve the coset span from `0`. -/
theorem ψ_mul_cosetSpan_zero (hn : n < m) {p : ℕ} (hp : p < n) {w : R}
    (hw : w ∈ cosetSpan Q ν hn 0) :
    ψ p * w ∈ cosetSpan Q ν hn 0 := by
  refine mul_span_mem ?_ hw
  rintro w ⟨q, -, hqn, y, hy, d, rfl⟩
  rcases Nat.lt_or_ge (p + 1) q with h | h
  · rw [← mul_assoc, ← mul_assoc, ψ_mul_toRight_of_lt h, mul_assoc (toRight q n)]
    exact gen_mem_cosetSpan hn (Nat.zero_le _) hqn (mul_mem (ψ_mem_leftSub (by omega)) hy) d
  rcases Nat.lt_or_ge q p with h' | h'
  · exact cosetSpan_anti hn (Nat.zero_le _) (ψ_mul_gen_of_lt hn h' hp hy d)
  rcases Nat.lt_or_ge p q with h'' | h''
  · obtain rfl : q = p + 1 := by omega
    rw [← mul_assoc, ← mul_assoc, ← toRight_eq_cons (by omega)]
    exact gen_mem_cosetSpan hn (Nat.zero_le _) (by omega) hy d
  · obtain rfl : q = p := by omega
    rw [toRight_eq_cons hp, show ψ q * (ψ q * toRight (q + 1) n * y * (x ⟨n, hn⟩ : R) ^ d) =
      ψ q * ψ q * (toRight (q + 1) n * y * (x ⟨n, hn⟩ : R) ^ d) by simp only [mul_assoc]]
    exact cosetSpan_anti hn (Nat.zero_le _) (dotIdemSub_mul_cosetSpan hn _
      (dotIdemSub_mono (by omega) (ψ_mul_ψ_mem_dotIdemSub q (by omega)))
      (gen_mem_cosetSpan hn le_rfl (by omega) hy d))

/-- **The coset decomposition along the last strand.** Every diagram on the first `n + 1`
strands is a combination of the `ψ_q ψ_{q+1} ⋯ ψ_{n-1} · y · x_n^d` with `q ≤ n` and `y` a
diagram on the first `n` strands. -/
theorem mem_cosetSpan (hn : n < m) {z : R} (hz : z ∈ leftSub Q ν (n + 1)) :
    z ∈ cosetSpan Q ν hn 0 := by
  have h1 : (1 : R) ∈ cosetSpan Q ν hn 0 := by
    have := gen_mem_cosetSpan hn (Nat.zero_le n) le_rfl (Subalgebra.one_mem (leftSub Q ν n)) 0
    simpa using this
  rw [← mul_one z]
  refine adjoin_mul_mem ?_ hz h1
  rintro g ((⟨i, rfl⟩ | ⟨a, ha, rfl⟩) | ⟨p, hp, rfl⟩) w hw
  · exact e_mul_cosetSpan hn 0 i hw
  · exact x_mul_cosetSpan hn 0 a (by omega) hw
  · exact ψ_mul_cosetSpan_zero hn (by omega) hw

end KLRAlgebra

