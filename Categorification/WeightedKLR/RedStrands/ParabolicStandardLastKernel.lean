import Categorification.WeightedKLR.RedStrands.ParabolicStandardLastIndMap
import Categorification.WeightedKLR.RedStrands.LastRedParabolicLift
import Categorification.WeightedKLR.RedStrands.ParabolicShuffleLayer
import Categorification.WeightedKLR.RedStrands.LastRedRank

/-!
# The kernel of `F_i(S N) → S(₂F_i N)`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, proof of
Proposition 5.5, `F`-part. The surjection `q : F_i(S N) → S(₂F_i N)` of `lastIndQuotientMap`
kills the submodule `O` generated by the action of the ideal of diagrams whose last red strand
ends strictly to the right of its position in `θ + (i + β)`: on `S(₂F_i N)` this ideal acts by
zero (`parabolicStandardLayerAction`). This file shows that `O` is exactly the kernel of `q`,
by constructing the inverse map `S(₂F_i N) → F_i(S N) / O`.

## Main definitions

* `lastIndKernel`: the submodule `O` of `F_i(S N)`.
* `LastIndQuot`: the quotient `F_i(S N) / O`.

## Main results

* `ker_lastIndQuotientMap`: the kernel of `F_i(S N) → S(₂F_i N)` is `O`.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR KLRAlgebra InductionAlong MulOpposite
open scoped TensorProduct
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {I : Type} {k : Type*} [DecidableEq I] [CommRing k] {ℓ : ℕ}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin (ℓ + 1) → I →₀ ℕ) (i : I) (θ β : Multiset I)

local notation "Si" j => (Singleton.singleton j : Multiset I)
local notation "T′" => TensorProductAlgebra k Q Λ ((Si i) + (θ + β))
local notation "T₂" => TensorProductAlgebra k Q Λ (θ + ((Si i) + β))
local notation "cst" => castTensorProductAlgebra Q Λ (lastInd_blackWeight i θ β)

/-- The split of `θ + (i + β)` into the prefix `θ` and the black suffix `i + β`. -/
abbrev lastIndSplit : LastRedWeightSplit (θ + ((Si i) + β)) := ⟨(θ, (Si i) + β), rfl⟩

local notation "p′" => LastRedWeightSplit.position (θ + ((Si i) + β)) (lastIndSplit i θ β) ℓ
local notation "I′" => smallerSuffixIdeal Q Λ p′

variable (N : Type*) [AddCommGroup N] [Module k N] [Module (parabolicFactorAlgebra Q Λ θ β) N]
  [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N] (hQ : KLRSymm Q)

/-- **The submodule `O` of `F_i(S N)`** generated by the ideal of smaller suffixes. -/
def lastIndKernel : Submodule T′ (LastIndF Q Λ i θ β N hQ) :=
  Submodule.span T′ {x | ∃ a ∈ I′, ∃ y : LastIndF Q Λ i θ β N hQ, x = (cst).symm a • y}

/-- **The quotient `F_i(S N) / O`.** -/
def LastIndQuot : Type _ := LastIndF Q Λ i θ β N hQ ⧸ lastIndKernel Q Λ i θ β N hQ

instance : AddCommGroup (LastIndQuot Q Λ i θ β N hQ) :=
  inferInstanceAs (AddCommGroup (LastIndF Q Λ i θ β N hQ ⧸ lastIndKernel Q Λ i θ β N hQ))
instance : Module T′ (LastIndQuot Q Λ i θ β N hQ) :=
  inferInstanceAs (Module T′ (LastIndF Q Λ i θ β N hQ ⧸ lastIndKernel Q Λ i θ β N hQ))
instance : Module k (LastIndQuot Q Λ i θ β N hQ) := Module.compHom _ (algebraMap k T′)
instance : IsScalarTower k T′ (LastIndQuot Q Λ i θ β N hQ) where
  smul_assoc c t x := by
    change (c • t) • x = algebraMap k T′ c • (t • x)
    rw [Algebra.smul_def, mul_smul]
instance : SMulCommClass T′ k (LastIndQuot Q Λ i θ β N hQ) where
  smul_comm t c x := by
    change t • (algebraMap k T′ c • x) = algebraMap k T′ c • (t • x)
    rw [← mul_smul, ← mul_smul, Algebra.commutes]

/-- The quotient map `F_i(S N) → F_i(S N) / O`. -/
abbrev lastIndQuotMk : LastIndF Q Λ i θ β N hQ →ₗ[T′] LastIndQuot Q Λ i θ β N hQ :=
  (lastIndKernel Q Λ i θ β N hQ).mkQ

/-- `T(θ + (i + β))` acting on `F_i(S N) / O` through the cast. -/
def lastIndQuotAction : T₂ →ₐ[k] Module.End k (LastIndQuot Q Λ i θ β N hQ) :=
  (Algebra.lsmul k k (LastIndQuot Q Λ i θ β N hQ)).comp (cst).symm.toAlgHom

theorem lastIndQuotAction_mk (a : T₂) (y : LastIndF Q Λ i θ β N hQ) :
    lastIndQuotAction Q Λ i θ β N hQ a (lastIndQuotMk Q Λ i θ β N hQ y) =
      lastIndQuotMk Q Λ i θ β N hQ ((cst).symm a • y) :=
  ((lastIndQuotMk Q Λ i θ β N hQ).map_smul _ y).symm

/-- **The ideal of smaller suffixes acts by zero on `F_i(S N) / O`**, so the action factors
through the last-red layer quotient. -/
def lastIndQuotLayerAction :
    (I′).ringCon.Quotient →ₐ[k] Module.End k (LastIndQuot Q Λ i θ β N hQ) := by
  apply (I′).ringCon.liftₐ (lastIndQuotAction Q Λ i θ β N hQ)
  apply (TwoSidedIdeal.ringCon_le_iff
    (J := TwoSidedIdeal.ker (lastIndQuotAction Q Λ i θ β N hQ).toRingHom)).mp
  intro a ha
  apply (TwoSidedIdeal.mem_ker _).mpr
  apply LinearMap.ext
  intro x
  obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective _ x
  change lastIndQuotAction Q Λ i θ β N hQ a (lastIndQuotMk Q Λ i θ β N hQ y) = 0
  rw [lastIndQuotAction_mk]
  exact (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.subset_span ⟨a, ha, y, rfl⟩)

theorem lastIndQuotLayerAction_mk (a : T₂) :
    lastIndQuotLayerAction Q Λ i θ β N hQ ((I′).ringCon.mk' a) =
      lastIndQuotAction Q Λ i θ β N hQ a := rfl

local notation "S" => stendhalQ Q Λ
local notation "Aₚ" => Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ)
local notation "Aₗ" => Multiset.map (Sum.map (id : I → I) (fun _ : Fin 1 => Fin.last ℓ))
  (stendhalWeight 1 β)

/-- The element of `T(θ + β)` represented by a diagram on the parabolic weight. -/
abbrev parabolicAffine (θ β : Multiset I) (a : KLRAlgebra k (stendhalQ Q Λ)
    (Multiset.map (addRedColor ℓ) (stendhalWeight ℓ θ) +
      Multiset.map (Sum.map (id : I → I) (fun _ : Fin 1 => Fin.last ℓ)) (stendhalWeight 1 β))) :
    TensorProductAlgebra k Q Λ (θ + β) :=
  TensorProductAlgebra.mk Q Λ (θ + β) (orderProjection Q Λ (θ + β)
    (StendhalAlgebraAllOrders.ofKLR k Q Λ (θ + β)
      (castKLR (stendhalQ Q Λ) (parabolicInputWeights_add (ℓ := ℓ) θ β) a)))

/-- The map `y ↦ [1 ⊗ y]` from the shuffle module of `N` to `F_i(S N) / O`. -/
def lastIndQuotUnit (y : ParabolicShuffle Q Λ θ β N) : LastIndQuot Q Λ i θ β N hQ :=
  lastIndQuotMk Q Λ i θ β N hQ (Ind.tmul (unitGen (appendBlackHom Q Λ i θ β))
    (show ParabolicStandardT Q Λ θ β N hQ from Submodule.mkQ _ y))

omit [Module k N] [IsScalarTower k (parabolicFactorAlgebra Q Λ θ β) N] in
theorem op_smul_unitGen_appendBlack (t : TensorProductAlgebra k Q Λ (θ + β)) :
    (op t • unitGen (appendBlackHom Q Λ i θ β)) =
      appendBlack Q Λ i (θ + β) t • unitGen (appendBlackHom Q Λ i θ β) :=
  Subtype.ext (by
    change appendBlack Q Λ i (θ + β) 1 * appendBlack Q Λ i (θ + β) t =
      appendBlack Q Λ i (θ + β) t * appendBlack Q Λ i (θ + β) 1
    rw [← map_mul, ← map_mul, one_mul, mul_one])

/-- `[1 ⊗ a y] = ι(a ⊗ 1_i) [1 ⊗ y]` in `F_i(S N) / O`. -/
theorem lastIndQuotUnit_smul (a : KLRAlgebra k S (Aₚ + Aₗ)) (y : ParabolicShuffle Q Λ θ β N) :
    lastIndQuotUnit Q Λ i θ β N hQ (a • y) =
      (cst).symm (parabolicAffine Q Λ θ ((Si i) + β)
        (castKLR S (lastInd_weight i θ β) (appendR S (Aₚ + Aₗ) (Sum.inl i) a))) •
        lastIndQuotUnit Q Λ i θ β N hQ y := by
  rw [show parabolicAffine Q Λ θ ((Si i) + β)
      (castKLR S (lastInd_weight i θ β) (appendR S (Aₚ + Aₗ) (Sum.inl i) a)) =
      cst (appendBlack Q Λ i (θ + β) (parabolicAffine Q Λ θ β a)) from
    (castTensorProductAlgebra_appendBlack_affine Q Λ i θ β a).symm, AlgEquiv.symm_apply_apply]
  unfold lastIndQuotUnit
  rw [← LinearMap.map_smul, Ind.smul_tmul, ← op_smul_unitGen_appendBlack, Ind.op_smul_tmul]
  congr 2
  change _ = parabolicStandardAction Q Λ θ β N hQ (parabolicAffine Q Λ θ β a)
    (Submodule.mkQ _ y)
  rw [parabolicStandardAction_affine]
  rfl

end Categorification.Stendhal
