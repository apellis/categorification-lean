import Categorification.WeightedKLR.RedStrands.PrependRedInjective

/-!
# Adding a red strand of large label is faithful in a fixed degree

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3,
proof of Proposition 4.39 and of Corollary 5.23. The kernel of `prependRed` lies in the
ideal generated by `x₁^{⟨α_i^∨, λ₀⟩} e(s)`, of degree `⟨α_i^∨, λ₀⟩ · deg x_i`. If the grading
vanishes below `-c` and every such degree exceeds `n + 2c`, the ideal has no nonzero element
of degree `n`, so `prependRed` is injective in degree `n`. This extends
`prependRed_eq_zero_of_mem_zero` (degree zero) to every degree.

## Main results

* `Graded.eq_zero_of_mem_span_of_mem_degree` : an ideal generated in degrees above `n + 2c`
  meets degree `n` trivially.
* `prependRed_eq_zero_of_mem_degree` : `prependRed` is injective in degree `n` once the first
  label is large.
-/

namespace Categorification.Graded

open DirectSum

variable {k A : Type*} [CommRing k] [Ring A] [Algebra k A] (𝒜 : ℤ → Submodule k A)
  [GradedAlgebra 𝒜]

/-- A two-sided ideal generated by homogeneous elements of degree above `n + 2c` meets
degree `n` trivially when the grading vanishes below `-c`. -/
theorem eq_zero_of_mem_span_of_mem_degree {c n : ℤ} (hc : ∀ m < -c, 𝒜 m = ⊥) {S : Set A}
    (hS : ∀ s ∈ S, ∃ d, n + 2 * c < d ∧ s ∈ 𝒜 d) {x : A} (hx : x ∈ TwoSidedIdeal.span S)
    (hn : x ∈ 𝒜 n) : x = 0 := by
  classical
  let P : A →+ A := GradedRing.proj 𝒜 n
  let K : TwoSidedIdeal A := TwoSidedIdeal.mk' {y | ∀ a b : A, P (a * y * b) = 0}
    (fun a b => by simp)
    (fun {y z} hy hz a b => by simp only [mul_add, add_mul, map_add, hy a b, hz a b, add_zero])
    (fun {y} hy a b => by simp only [mul_neg, neg_mul, map_neg, hy a b, neg_zero])
    (fun {y z} hz a b => by simpa only [mul_assoc] using hz (a * y) b)
    (fun {y z} hy a b => by simpa only [mul_assoc] using hy a (z * b))
  have hle : TwoSidedIdeal.span S ≤ K := by
    apply TwoSidedIdeal.span_le.mpr
    intro s hs a b
    obtain ⟨d, hd, hsd⟩ := hS s hs
    change P (a * (s - 0) * b) = 0
    rw [sub_zero, ← sum_support_decompose 𝒜 a, ← sum_support_decompose 𝒜 b, Finset.sum_mul,
      Finset.sum_mul, map_sum]
    refine Finset.sum_eq_zero fun p _ => ?_
    rw [Finset.mul_sum, map_sum]
    refine Finset.sum_eq_zero fun q _ => ?_
    have hmem : (decompose 𝒜 a p : A) * s * (decompose 𝒜 b q : A) ∈ 𝒜 (p + d + q) :=
      SetLike.GradedMul.mul_mem (SetLike.GradedMul.mul_mem (decompose 𝒜 a p).2 hsd)
        (decompose 𝒜 b q).2
    change (decompose 𝒜 _ n : A) = 0
    have hvan (r : A) (m : ℤ) (hm : m < -c) : (decompose 𝒜 r m : A) = 0 := by
      have h := (decompose 𝒜 r m).2
      simp only [hc m hm, Submodule.mem_bot] at h
      exact h
    by_cases hpq : p + d + q = n
    · by_cases hp : p < -c
      · rw [hvan a p hp]
        simp
      · rw [hvan b q (by omega)]
        simp
    · exact decompose_of_mem_ne 𝒜 hmem hpq
  have hK := hle hx
  have h := hK 1 1
  rw [one_mul, mul_one, sub_zero] at h
  change (decompose 𝒜 x n : A) = 0 at h
  rwa [decompose_of_mem_same 𝒜 hn] at h

end Categorification.Graded

open Categorification.Graded

namespace Categorification.Stendhal

open KLR

variable {I : Type*} [DecidableEq I] {ℓ : ℕ}

variable {k : Type*} [CommRing k] (Q : I → I → MvPolynomial (Fin 2) k)
  (Λ : Fin (ℓ + 1) → I →₀ ℕ) (ν : Multiset I)
  (G : KLR.GradingDatum (stendhalQ Q (Λ ∘ Fin.succ)))

local notation "μ" => stendhalWeight ℓ ν

omit [DecidableEq I] in
private theorem mem_of_lbl_eq_inl' (s : Seq μ) (a : Fin (Multiset.card μ)) (i : I)
    (h : s.lbl a = .inl i) : i ∈ ν := by
  have hmem : s.1 a ∈ Finset.univ.val.map s.1 := Multiset.mem_map_of_mem _ (Finset.mem_univ_val a)
  rw [s.2] at hmem
  change s.lbl a ∈ μ at hmem
  rw [h] at hmem
  simpa [stendhalWeight] using hmem

private theorem x_pow_mul_e_mem_grade' {Q' : I ⊕ Fin ℓ → I ⊕ Fin ℓ → MvPolynomial (Fin 2) k}
    (G' : KLR.GradingDatum Q') (s : Seq μ) (a : Fin (Multiset.card μ)) (n : ℕ) :
    (KLRAlgebra.x a ^ n * KLRAlgebra.e s : KLRAlgebra k Q' μ) ∈
      G'.grade μ (n * G'.degX (s.lbl a)) := by
  induction n with
  | zero => simpa using G'.e_mem_grade s
  | succ n ih =>
    have h : (KLRAlgebra.x a ^ (n + 1) * KLRAlgebra.e s : KLRAlgebra k Q' μ) =
        (KLRAlgebra.x a * KLRAlgebra.e s) * (KLRAlgebra.x a ^ n * KLRAlgebra.e s) := by
      have hc : Commute (KLRAlgebra.e s : KLRAlgebra k Q' μ) (KLRAlgebra.x a ^ n) :=
        (Commute.pow_right (show Commute (KLRAlgebra.e s : KLRAlgebra k Q' μ) (KLRAlgebra.x a)
          from (KLRAlgebra.x_mul_e a s).symm) n)
      rw [mul_assoc, ← mul_assoc (KLRAlgebra.e s), hc.eq, mul_assoc, KLRAlgebra.e_mul_e]
      simp [pow_succ', mul_assoc]
    rw [h, show ((n + 1 : ℕ) : ℤ) * G'.degX (s.lbl a) = G'.degX (s.lbl a) +
      n * G'.degX (s.lbl a) by push_cast; ring]
    exact SetLike.GradedMul.mul_mem (G'.x_mul_e_mem_grade a s) ih

/-- **Adding a red strand of large label is injective in a fixed degree** (Webster,
arXiv:1309.3796v3, proofs of Proposition 4.39 and Corollary 5.23). If the grading of all
red orders vanishes below `-c` and `⟨α_i^∨, λ₀⟩ · deg x_i > n + 2c` for every black label `i`
that occurs, an element of degree `n` of `T̃^λ` that dies in `T^{(λ₀, λ)}` is zero. -/
theorem prependRed_eq_zero_of_mem_degree {c n : ℤ} (hc : ∀ m < -c, allOrdersGrade G ν m = ⊥)
    (hΛ : ∀ i ∈ ν, n + 2 * c < Λ 0 i * G.degX (.inl i))
    {z : StendhalAlgebra k Q (Λ ∘ Fin.succ) ν}
    (hzn : z ∈ stendhalGrade G ν n) (hz : prependRed Q Λ ν z = 0) : z = 0 := by
  apply Subtype.ext
  refine eq_zero_of_mem_span_of_mem_degree (allOrdersGrade G ν) hc ?_
    (mem_firstDotIdeal_of_prependRed_eq_zero Q Λ ν z hz) hzn
  rintro _ ⟨s, i, h, hs, rfl⟩
  refine ⟨Λ 0 i * G.degX (.inl i), hΛ i (mem_of_lbl_eq_inl' ν s _ i hs), ?_⟩
  have hmem := Graded.mem_map_of_mem (G.grade μ)
    (StendhalAlgebraAllOrders.ofKLR k Q (Λ ∘ Fin.succ) ν).toLinearMap
    (x_pow_mul_e_mem_grade' ν G s ⟨0, h⟩ (Λ 0 i))
  rw [hs] at hmem
  simpa [allOrdersGrade, StendhalAlgebraAllOrders.x, StendhalAlgebraAllOrders.e, map_mul, map_pow]
    using hmem

/-- `prependRed` is injective on the degree-`n` piece of `T̃^λ` once the first label is
large (Webster, arXiv:1309.3796v3, proof of Corollary 5.23). -/
theorem prependRed_injOn_degree {c n : ℤ} (hc : ∀ m < -c, allOrdersGrade G ν m = ⊥)
    (hΛ : ∀ i ∈ ν, n + 2 * c < Λ 0 i * G.degX (.inl i)) :
    Set.InjOn (prependRed Q Λ ν) (stendhalGrade G ν n) := by
  intro y hy z hz h
  rw [← sub_eq_zero]
  refine prependRed_eq_zero_of_mem_degree Q Λ ν G hc hΛ (Submodule.sub_mem _ hy hz) ?_
  rw [map_sub, h, sub_self]

end Categorification.Stendhal
