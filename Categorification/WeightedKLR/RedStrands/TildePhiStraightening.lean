import Categorification.WeightedKLR.RedStrands.PhiDiagrams

/-!
# Straightening in `T̃^λ`

B. Webster, *Knot invariants and higher representation theory*, arXiv:1309.3796v3, proof of
Proposition 5.21, run in `T̃^λ` as in the proof of Corollary 5.23. For a red-ordered loading
`s` and a choice `ρ` of reduced words, the diagram `x̃_φ = ψ_{ρ φ} e(s)` of `T̃^λ`
(`tildePhiElt`) lies in `e(φ • s) T̃^λ e(s)`, and every element of `e(t) T̃^λ e(s)` lies in the
left ideal generated by the `x̃_φ` whose bottom `φ • s` is at least `t`
(`phiCut_mem_tildePhiSpan`). The proof is that of `seqIdem_mul_mul_seqIdem_mem_span_phiElt`,
without passing to the quotient `T^λ`.

## Main definitions

* `tildePhiElt`, `tildePhiSpan`.

## Main results

* `phiCut_mem_tildePhiSpan`.
-/

noncomputable section

namespace Categorification.Stendhal

open KLR TypeA Equiv MvPolynomial

variable {I : Type} [DecidableEq I] {k : Type} [Field k] {ℓ : ℕ} {ν : Multiset I}
  (Q : I → I → MvPolynomial (Fin 2) k) (Λ : Fin ℓ → I →₀ ℕ)

local notation "μ" => stendhalWeight ℓ ν
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "B" => StendhalAlgebra k Q Λ ν
local notation "R" => KLRAlgebra k (stendhalQ Q Λ) (stendhalWeight ℓ ν)
local notation "E" => StendhalAlgebraAllOrders.e (k := k) (Q := Q) (Λ := Λ) (ν := ν)

/-- **The diagram `x̃_φ = ψ_{ρ φ} e(s)` of `T̃^λ`**, in `e(φ • s) T̃^λ e(s)`. -/
def tildePhiElt (ρ : Perm (Fin m) → List ℕ) {s : Seq μ} (hs : IsRedOrdered s) {g : Fin m → ℕ}
    (hg : g ∈ assignments s.lbl) : B :=
  phiCut Q Λ (phiBottom s g) s (isRedOrdered_phiBottom hs hg) hs
    (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (phiPerm s g))))

/-- The left ideal of `T̃^λ` generated by the `x̃_φ` with bottom at least `t`. -/
def tildePhiSpan (ρ : Perm (Fin m) → List ℕ) {s : Seq μ} (hs : IsRedOrdered s) (t : Seq μ) :
    Submodule B B :=
  Submodule.span B {z | ∃ (g : Fin m → ℕ) (hg : g ∈ assignments s.lbl),
    StendhalLE t (phiBottom s g) ∧ z = tildePhiElt Q Λ ρ hs hg}

omit [DecidableEq I] in
private theorem reduced_frame' {ρ : Perm (Fin m) → List ℕ}
    (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w)
    (v : Perm (Fin m) → Perm (Fin m)) (hv : ∀ τ, invSet m (v τ) ⊆ invSet m τ) (τ : Perm (Fin m)) :
    IsReduced m (ρ (τ * (v τ)⁻¹) ++ ρ (v τ)) ∧ wordProd m (ρ (τ * (v τ)⁻¹) ++ ρ (v τ)) = τ := by
  have hl := length_add_of_invSet_subset (hv τ)
  refine ⟨⟨validWord_append.2 ⟨(hρ _).1.1, (hρ _).1.1⟩, ?_⟩, ?_⟩
  · rw [List.length_append, wordProd_append, (hρ _).2, (hρ _).2, inv_mul_cancel_right,
      (hρ _).1.2, (hρ _).1.2, (hρ _).2, (hρ _).2, hl]
  · rw [wordProd_append, (hρ _).2, (hρ _).2, inv_mul_cancel_right]

variable {Q Λ}

/-- **Straightening in `T̃^λ`** (Webster, arXiv:1309.3796v3, proof of Proposition 5.21, for
`T̃^λ` as in Corollary 5.23): for any choice `ρ` of reduced words, every element of
`e(t) T̃^λ e(s)` lies in the left ideal generated by the `x̃_φ`, `φ ∈ Φ̃`, whose bottom `φ • s`
is at least `t`. -/
theorem phiCut_mem_tildePhiSpan (ρ : Perm (Fin m) → List ℕ)
    (hρ : ∀ w, IsReduced m (ρ w) ∧ wordProd m (ρ w) = w) {s t : Seq μ} (hs : IsRedOrdered s)
    (ht : IsRedOrdered t) (y : StendhalAlgebraAllOrders k Q Λ ν) :
    phiCut Q Λ t s ht hs y ∈ tildePhiSpan Q Λ ρ hs t := by
  classical
  obtain ⟨z, rfl⟩ := StendhalAlgebraAllOrders.ofKLR_surjective (k := k) (Q := Q) (Λ := Λ)
    (ν := ν) y
  set r : R := KLRAlgebra.e t * z * KLRAlgebra.e s with hr_def
  have hcut : phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν z) =
      phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν r) := by
    apply Subtype.ext
    change E t * _ * E s = E t * _ * E s
    have htt : E t * E t = E t := by simp [StendhalAlgebraAllOrders.e_mul_e]
    have hss : E s * E s = E s := by simp [StendhalAlgebraAllOrders.e_mul_e]
    rw [hr_def, map_mul, map_mul]
    change _ = E t * (E t * _ * E s) * E s
    calc E t * StendhalAlgebraAllOrders.ofKLR k Q Λ ν z * E s
        = (E t * E t) * StendhalAlgebraAllOrders.ofKLR k Q Λ ν z * (E s * E s) := by
          rw [htt, hss]
      _ = _ := by simp only [mul_assoc]
  rw [hcut]
  have hr : KLRAlgebra.e t * r * KLRAlgebra.e s = r := by
    rw [hr_def, ← mul_assoc, ← mul_assoc, KLRAlgebra.e_mul_self, mul_assoc,
      KLRAlgebra.e_mul_self]
  let v : Perm (Fin m) → Perm (Fin m) := fun τ =>
    if τ • s = t then phiPerm s (diagAssign s τ) else 1
  have hv : ∀ τ, invSet m (v τ) ⊆ invSet m τ := fun τ => by
    dsimp only [v]
    split_ifs with h
    · exact invSet_phiPerm_diagAssign hs (h ▸ ht)
    · intro x hx
      rw [mem_invSet, Perm.one_apply, Perm.one_apply] at hx
      exact absurd hx.2 (lt_asymm hx.1)
  let ρ' : Perm (Fin m) → List ℕ := fun τ => ρ (τ * (v τ)⁻¹) ++ ρ (v τ)
  have hρ' := reduced_frame' hρ v hv
  have hmem := KLRAlgebra.mem_span_corner_dotsTop ρ' hρ' s t hr
  let F : R → B := fun x => phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν x)
  change F r ∈ _
  suffices key : ∀ x ∈ Submodule.span k {b : R | ∃ (w : Perm (Fin m)) (u : Fin m →₀ ℕ),
      w • s = t ∧ KLRAlgebra.pol (monomial u 1) * KLRAlgebra.ψw (ρ' w) * KLRAlgebra.e s = b},
      F x ∈ tildePhiSpan Q Λ ρ hs t from key r hmem
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨τ, u, hτ, rfl⟩ := hx
    have hvτ : v τ = phiPerm s (diagAssign s τ) := by simp [v, hτ]
    have hg := diagAssign_mem s τ
    have hb := isRedOrdered_phiBottom hs hg
    have hle : StendhalLE t (phiBottom s (diagAssign s τ)) :=
      hτ ▸ stendhalLE_phiBottom_diagAssign hs (hτ ▸ ht)
    have hfac : F (KLRAlgebra.pol (monomial u 1) * KLRAlgebra.ψw (ρ' τ) * KLRAlgebra.e s) =
        phiCut Q Λ t (phiBottom s (diagAssign s τ)) ht hb
          (StendhalAlgebraAllOrders.ofKLR k Q Λ ν
            (KLRAlgebra.pol (monomial u 1) *
              KLRAlgebra.ψw (ρ (τ * (phiPerm s (diagAssign s τ))⁻¹)))) *
        tildePhiElt Q Λ ρ hs hg := by
      have hb' : E (phiBottom s (diagAssign s τ)) *
          StendhalAlgebraAllOrders.ofKLR k Q Λ ν (KLRAlgebra.ψw (ρ (phiPerm s (diagAssign s τ)))) =
          StendhalAlgebraAllOrders.ofKLR k Q Λ ν
            (KLRAlgebra.ψw (ρ (phiPerm s (diagAssign s τ))) * KLRAlgebra.e s) := by
        change StendhalAlgebraAllOrders.ofKLR k Q Λ ν
          (KLRAlgebra.e (phiPerm s (diagAssign s τ) • s)) * _ = _
        rw [← map_mul, KLRAlgebra.e_mul_ψw, (hρ _).2, inv_smul_smul]
      rw [tildePhiElt, phiCut_mul_phiCut]
      simp only [F]
      congr 1
      rw [mul_assoc (StendhalAlgebraAllOrders.ofKLR k Q Λ ν _), hb', ← map_mul]
      congr 1
      rw [show ρ' τ = ρ (τ * (phiPerm s (diagAssign s τ))⁻¹) ++ ρ (phiPerm s (diagAssign s τ)) by
        simp only [ρ', hvτ], KLRAlgebra.ψw_append]
      simp only [mul_assoc]
    rw [hfac]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, hg, hle, rfl⟩)
  | zero =>
    change phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν 0) ∈ _
    rw [map_zero, phiCut_zero]
    exact zero_mem _
  | add x y _ _ hx hy =>
    change phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (x + y)) ∈ _
    rw [map_add, phiCut_add]
    exact add_mem hx hy
  | smul c x _ hx =>
    have hsm : phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (c • x)) =
        phiCut Q Λ t t ht ht (algebraMap k _ c) *
          phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν x) := by
      rw [phiCut_mul_phiCut]
      apply Subtype.ext
      change E t * _ * E s = E t * _ * E s
      have htt : E t * E t = E t := by simp [StendhalAlgebraAllOrders.e_mul_e]
      rw [map_smul, ← Algebra.smul_def]
      simp only [smul_mul_assoc, mul_smul_comm]
      congr 1
      rw [← mul_assoc (E t) (E t), htt]
    change phiCut Q Λ t s ht hs (StendhalAlgebraAllOrders.ofKLR k Q Λ ν (c • x)) ∈ _
    rw [hsm]
    exact Submodule.smul_mem _ _ hx

end Categorification.Stendhal
