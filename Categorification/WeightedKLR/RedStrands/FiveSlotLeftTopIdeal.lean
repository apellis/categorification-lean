import Categorification.WeightedKLR.RedStrands.FiveSlotMarkedExitJoints
import Categorification.WeightedKLR.RedStrands.BlockKernelColumn

/-!
# Higher ideals at the remaining five-slot tops

Webster, arXiv:1309.3796v2, §6.1, proof of Lemma 6.8 after (6.21).
With one earlier red spectator and two equal black strands, the number of
blacks before the merged pair determines the relative higher ideal among
nonviolated loadings in the exchanged red order. At the maximum it is zero.
With one black before the pair it is generated by the left-extreme idempotent.
-/

namespace Categorification.Stendhal.BraidedStendhalAlgebra
open KLR KLR.KLRAlgebra TypeA Equiv
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable {k : Type} [CommRing k]
  (Q : Unit → Unit → MvPolynomial (Fin 2) k) (Λ : Fin 3 → Unit →₀ ℕ)

local notation "ν₀" => ({()} + {()} : Multiset Unit)
local notation "μ₀" => stendhalWeight 3 ν₀
local notation "n₀" => Multiset.card μ₀
local notation "v₀" => fixedTopFourExitCut 0
local notation "v₁" => fixedTopFourExitCut 1
local notation "v₂" => fixedTopFourExitCut 2
local notation "jA" => sadj n₀ 2 • v₀
local notation "π" => AlgHom.comp (violMk k Q Λ ν₀) (ofKLR k Q Λ ν₀)
local notation "J[" v "]" => blockUpperIdeal k Q Λ ν₀ 1 2 (adjacentBlockRoot 1 2 v) (redWord v)

/-- The six nonviolated loadings with exchanged red order are the three
right tops and the three loadings with a black before the first exchanged red. -/
theorem fiveSlot_nonviolated_tops (v : Seq μ₀) (order : redWord v=redWord v₀)
    (hv : ¬ IsViolated v) : FiveSlotRightTop v ∨ v=v₀ ∨ v=v₁ ∨ v=jA := by
  have first : (v.lbl ⟨0,by decide⟩).isRight := by
    cases h : v.lbl ⟨0,by decide⟩ with
    | inr r => rfl
    | inl i => exact (hv ⟨by decide,congrArg Sum.isLeft h⟩).elim
  obtain ⟨w,rfl⟩ := Seq.exists_smul_eq v₀ v
  have classify : ∀ u : Perm (Fin n₀), redWord (u • v₀)=redWord v₀ →
      ((u • v₀).lbl ⟨0,by decide⟩).isRight →
      (u • v₀=v₂ ∨ u • v₀=sadj n₀ 2 • v₂ ∨ u • v₀=sadj n₀ 3 • (sadj n₀ 2 • v₂)) ∨
      u • v₀=v₀ ∨ u • v₀=v₁ ∨ u • v₀=jA := by decide +kernel
  exact classify w order first

private theorem pairCounts {v t : Seq μ₀}
    (h : ∀ (r : Fin 3), adjacentBlockRoot 1 2 v r () ≤ adjacentBlockRoot 1 2 t r ()) :
    adjacentBlockRoot 1 2 v ≤ adjacentBlockRoot 1 2 t := fun r i => by cases i; exact h r

private theorem middleCounts : adjacentBlockRoot 1 2 v₁=adjacentBlockRoot 1 2 jA := by
  ext r i
  fin_cases r <;> cases i <;> decide

private theorem right_le_middle : adjacentBlockRoot 1 2 v₂ ≤ adjacentBlockRoot 1 2 v₁ := by
  apply pairCounts
  decide

private theorem middle_lt_extreme : adjacentBlockRoot 1 2 v₁ < adjacentBlockRoot 1 2 v₀ := by
  apply lt_of_le_not_ge
  · apply pairCounts
    decide
  · intro le
    exact (by decide : ¬ adjacentBlockRoot 1 2 v₀ 1 () ≤ adjacentBlockRoot 1 2 v₁ 1 ()) (le 1 ())

/-- At the left-extreme top all strictly higher loadings of the same red
order are violated, so the higher ideal in the violated quotient vanishes. -/
theorem fiveSlotLeftExtreme_blockUpperIdeal_eq_bot : J[v₀]=⊥ := by
  apply le_antisymm _ bot_le
  apply TwoSidedIdeal.span_le.mpr
  rintro z ⟨v,order,lt,rfl⟩
  apply (TwoSidedIdeal.mem_bot _).2
  apply violMk_e
  by_contra hv
  rcases fiveSlot_nonviolated_tops v order hv with right | rfl | rfl | rfl
  · rw [fiveSlotRightTop_blockRoot v right] at lt
    exact lt.not_ge (right_le_middle.trans middle_lt_extreme.le)
  · exact lt.false
  · exact lt.not_ge middle_lt_extreme.le
  · rw [← middleCounts] at lt
    exact lt.not_ge middle_lt_extreme.le

/-- At either loading with a single black before the merged pair, the
only nonviolated strictly higher generator is the left-extreme cut. -/
theorem fiveSlot_oneBlackBeforePair_blockUpperIdeal (upper : Seq μ₀) (h : upper=v₁ ∨ upper=jA) :
    J[upper]=TwoSidedIdeal.span {π (e v₀)} := by
  have equal : adjacentBlockRoot 1 2 upper=adjacentBlockRoot 1 2 v₁ := by
    rcases h with rfl|rfl
    · rfl
    · exact middleCounts.symm
  have ord : redWord upper=redWord v₀ := by rcases h with rfl|rfl <;> decide
  apply le_antisymm
  · apply TwoSidedIdeal.span_le.mpr
    rintro z ⟨v,order,lt,rfl⟩
    rw [equal] at lt
    by_cases hv : IsViolated v
    · have vanish : π (e v)=0 := violMk_e hv
      rw [vanish]; exact TwoSidedIdeal.zero_mem _
    rcases fiveSlot_nonviolated_tops v (order.trans ord) hv with right | rfl | rfl | rfl
    · rw [fiveSlotRightTop_blockRoot v right] at lt
      exact (lt.not_ge right_le_middle).elim
    · exact TwoSidedIdeal.subset_span (Set.mem_singleton _)
    · exact lt.false.elim
    · rw [← middleCounts] at lt
      exact lt.false.elim
  · apply TwoSidedIdeal.span_le.mpr
    rintro z (rfl : z=π (e v₀))
    exact TwoSidedIdeal.subset_span ⟨v₀,ord.symm,equal ▸ middle_lt_extreme,rfl⟩

private theorem injective_of_zero_tensor_factor {S T X M N Y : Type*}
    [CommRing S] [Ring T] [Algebra S T] [Ring X] [AddCommGroup M] [Module S M]
    [Module T M] [IsScalarTower S T M] [Module Xᵐᵒᵖ M] [AddCommGroup N] [Module S N] [Module X N]
    (f : BalancedTensor S T X M N → Y) (vanish : ∀ m : M, m=0) : Function.Injective f := by
  have zero (z : BalancedTensor S T X M N) : z=0 :=
    BalancedTensor.induction_on z rfl (fun m _ => by rw [vanish m,BalancedTensor.zero_tmul])
      (fun _ _ h₁ h₂ => by rw [h₁,h₂,add_zero])
  exact fun x y _ => (zero x).trans (zero y).symm

/-- When the retained higher ideal vanishes, its balanced kernel-column
inclusion is injective for every bottom loading. -/
theorem fiveSlot_blockKernelColumnInclusion_injective_of_upperIdeal_eq_bot (t s : Seq μ₀)
    (empty : J[t]=⊥) :
    Function.Injective (blockKernelColumnInclusion Q Λ t 1 2 s) := by
  have vanish (x : blockLoadingKernel Q Λ t 1 2) : x=0 := by
    have mem : x.1.1.1 ∈ J[t] := x.2
    rw [empty] at mem
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    exact (TwoSidedIdeal.mem_bot _).1 mem
  exact injective_of_zero_tensor_factor (blockKernelColumnInclusion Q Λ t 1 2 s) vanish

/-- At the maximal retained cut, the source kernel of the standard
presentation vanishes. Its tensor inclusion is injective at every bottom
loading, independently of the red and black parameters. -/
theorem fiveSlotLeftExtreme_blockKernelColumnInclusion_injective (s : Seq μ₀) :
    Function.Injective (blockKernelColumnInclusion Q Λ v₀ 1 2 s) := by
  exact fiveSlot_blockKernelColumnInclusion_injective_of_upperIdeal_eq_bot Q Λ v₀ s
    (fiveSlotLeftExtreme_blockUpperIdeal_eq_bot Q Λ)

end Categorification.Stendhal.BraidedStendhalAlgebra
