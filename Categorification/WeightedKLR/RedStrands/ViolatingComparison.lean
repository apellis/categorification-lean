import Categorification.WeightedKLR.RedStrands.StendhalViolating

/-!
# The violating ideal on all chambers

B. Webster, *Weighted Khovanov–Lauda–Rouquier algebras*, arXiv:1209.2463v4, Theorem 3.6 and its
proof. Theorem 3.6 is stated for the reduced weighted KLR algebra of the Crawley-Boevey graph
cut down to the Stendhal chambers (`stViolatingIdeal`, `stTensorEquiv`). This file compares that
ideal with the ideal of the weighted KLR algebra on *all* chambers of `ν̃` generated by the dot on
the `0`-strand and the idempotents of all violating chambers.

"The leftmost strand is black" is a property of a point, not of a chamber: two points of one
chamber may order a black strand and a red ghost differently when no hyperplane separates them.
`IsViolatingChamber` therefore asks for one generic point of the chamber at which a strand other
than the `0`-strand lies left of every ghost `p(s₀) + ϖ_r`.

## Main results

* `exists_act_rankOrdered`: every generic point can be relabelled colour by colour into rank
  order.
* `exists_stFull_eq`: every rank-ordered chamber is the chamber `stFull j` of a red-ordered
  Stendhal sequence `j` (old weights `0`).
* `isViolatingChamber_iff`: a chamber is violating exactly when a relabelling of it is
  `stFull j` for a sequence `j` whose leftmost strand is black.
* `violatingIdeal_eq_span`: the violating ideal on all chambers is generated by the dot and the
  idempotents of the violated Stendhal chambers.
* `mkₐ_mem_stViolatingIdeal_iff`: an element of the Stendhal chamber algebra lies in
  `stViolatingIdeal` modulo the dot exactly when all its entries lie in the violating ideal on
  all chambers. So the quotient of `stTensorEquiv` is the Stendhal corner of the quotient of the
  weighted KLR algebra on all chambers by its violating ideal.

## Hypotheses

The old edges of the Crawley-Boevey graph carry weight `0` (`hw0`) and the weights `ϖ` of the
new edges are strictly increasing (`hϖ`), as in `stFull` and Theorems 3.5–3.6. Without `hw0`
the Stendhal chambers `stFull` are not defined, and the comparison is not made.
-/

namespace Categorification.WeightedKLR

open Equiv FullChamber GalleryAlgebra

section Relabel

variable {J : Type*} [DecidableEq J] {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜]
  [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k] {Δ : WeightedGraph J 𝕜 k} {ν : J →₀ ℕ}

/-- The idempotent of a chamber factors through the idempotent of any relabelling of it. -/
theorem e_eq_r_mul_e_mul_r (g : ColPerm ν) (C : FullChamber Δ ν) :
    (e C : GalleryAlgebra k Δ ν) = r g⁻¹ (g • C) * e (g • C) * r g C := by
  rw [r_mul_e, r_mul_r, inv_mul_cancel, r_one]

/-- A chamber and its relabellings generate the same two-sided ideal. -/
theorem e_mem_span_e_smul (g : ColPerm ν) (C : FullChamber Δ ν) :
    (e C : GalleryAlgebra k Δ ν) ∈ TwoSidedIdeal.span {e (g • C)} := by
  rw [e_eq_r_mul_e_mul_r g C]
  exact TwoSidedIdeal.mul_mem_right _ _ _
    (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span rfl))

omit [DecidableEq J] in
/-- Every generic point can be relabelled, colour by colour, so that the strands of each colour
are in rank order: sort the points of the strands of each colour. -/
theorem exists_act_rankOrdered {p : Strand ν → 𝕜} (hp : IsGeneric Δ p) :
    ∃ g : ColPerm ν, ∀ d : Diag ν, 0 < d.val (act g p) := by
  let τ : Perm (Strand ν) :=
    Equiv.sigmaCongrRight fun c => Tuple.sort fun n : Fin (ν c) => p ⟨c, n⟩
  have hτ : τ ∈ ColPerm ν := fun _ => rfl
  refine ⟨(⟨τ, hτ⟩ : ColPerm ν)⁻¹, fun d => ?_⟩
  obtain ⟨⟨⟨c, n⟩, ⟨c', n'⟩⟩, hc, hn⟩ := d
  simp only at hc hn
  subst hc
  have hinj : Function.Injective fun n : Fin (ν c) => p ⟨c, n⟩ := by
    intro a b hab
    by_contra hne
    rcases lt_or_gt_of_ne hne with h | h
    · exact hp (.inr (⟨(⟨c, a⟩, ⟨c, b⟩), rfl, h⟩ : Diag ν)) (sub_eq_zero.2 hab.symm)
    · exact hp (.inr (⟨(⟨c, b⟩, ⟨c, a⟩), rfl, h⟩ : Diag ν)) (sub_eq_zero.2 hab)
  have hmono : StrictMono ((fun n : Fin (ν c) => p ⟨c, n⟩) ∘ Tuple.sort fun n => p ⟨c, n⟩) :=
    (Tuple.monotone_sort _).strictMono_of_injective (hinj.comp (Tuple.sort _).injective)
  have := hmono (show n < n' from hn)
  simp only [Diag.val, Diag.fst, Diag.snd, act, sub_pos]
  simpa [τ] using this

end Relabel

end Categorification.WeightedKLR

namespace Categorification.Stendhal

open Categorification.WeightedKLR Equiv FullChamber GalleryAlgebra

section Chambers

variable {I : Type} [DecidableEq I] {ℓ : ℕ} {ν : Multiset I}
  {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k]
  {Γ : WeightedGraph I 𝕜 k} {Λ : Fin ℓ → I →₀ ℕ} {ϖ : Fin ℓ → 𝕜}

local notation "μ" => Multiset.toFinsupp (stendhalWeight ℓ ν)
local notation "ν̃" => WeightedGraph.redWeight (Multiset.toFinsupp ν)
local notation "Γλ" => WeightedGraph.crawleyBoeveyIn Γ Λ ϖ
local notation "m" => Multiset.card (stendhalWeight ℓ ν)
local notation "s₀" => GalleryAlgebra.zeroStrand (Multiset.toFinsupp ν)

variable (ϖ) in
/-- The point of a strand of a Stendhal sequence read off a configuration `p` of the strands of
`ν̃`: `p(s)` for a black strand `s`, and the ghost `p(s₀) + ϖ_r` of the `0`-strand for the red
strand `λ_r`. -/
def stKey (p : Strand ν̃ → 𝕜) (s : Strand μ) : 𝕜 := p (toTilde s) + redWt ϖ s

omit [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] in
theorem stKey_of_isLeft (p : Strand ν̃ → 𝕜) {s : Strand μ} (hs : s.1.1.isLeft) :
    stKey ϖ p s = p (toTilde s) := by
  rw [stKey, redWt_of_isLeft hs, add_zero]

omit [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] in
theorem stKey_redStrand (p : Strand ν̃ → 𝕜) (r : Fin ℓ) :
    stKey ϖ p (redStrand ν r) = p s₀ + ϖ r := rfl

omit [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] in
/-- With old weights `0`, the value of a hyperplane of the Crawley-Boevey arrangement at any
configuration is the difference of the points of the two Stendhal strands it compares. -/
theorem val_eq_stKey_sub (hw0 : ∀ e, Γ.weight e = 0) {h : Hyp Γλ ν̃} {a b : Strand μ}
    (hl : Lifts ν h a b) (p : Strand ν̃ → 𝕜) : h.val p = stKey ϖ p b - stKey ϖ p a := by
  rcases h with w | d
  · obtain ⟨ha | ⟨c, hc, rfl⟩, hb⟩ := hl
    · rcases he : w.edge with e | c
      · have hw : Γλ.weight w.edge = 0 := by rw [he]; exact hw0 e
        rw [Hyp.val_inl, Wall.val, hw, stKey_of_isLeft p (isLeft_of_ofTilde ha),
          stKey_of_isLeft p (isLeft_of_ofTilde hb), toTilde_of_ofTilde ha, toTilde_of_ofTilde hb,
          sub_zero]
      · exact absurd ha (ofTilde_src_ne_of_edge_inr w he)
    · have hw : Γλ.weight w.edge = ϖ c.1 := by rw [hc]; rfl
      rw [Hyp.val_inl, Wall.val, hw, stKey_of_isLeft p (isLeft_of_ofTilde hb),
        toTilde_of_ofTilde hb, stKey_redStrand, ← src_eq_zeroStrand w hc]
      ring
  · rw [Hyp.val_inr, Diag.val, stKey_of_isLeft p (isLeft_of_ofTilde hl.1),
      stKey_of_isLeft p (isLeft_of_ofTilde hl.2), toTilde_of_ofTilde hl.1,
      toTilde_of_ofTilde hl.2]

/-- **Every rank-ordered chamber of the Crawley-Boevey arrangement is a Stendhal chamber**
(old weights `0`): list the strands of a Stendhal sequence by the points `stKey ϖ p`, breaking
ties (which only occur between strands compared by no hyperplane) by a fixed enumeration. The
strands at earlier positions have smaller or equal points. -/
theorem exists_stFull_eq (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    {p : Strand ν̃ → 𝕜} (hp : IsGeneric Γλ p) (hd : ∀ d : Diag ν̃, 0 < d.val p) :
    ∃ j : OrdSeq ℓ ν, stFull Λ hϖ hw0 j = ofPoint p hp ∧
      ∀ s t : Strand μ, posVal j.1 s < posVal j.1 t → stKey ϖ p s ≤ stKey ϖ p t := by
  classical
  let i₀ : KLR.Seq (stendhalWeight ℓ ν) := ⟨fun a => (stendhalWeight ℓ ν).toList.get
      (Fin.cast (Multiset.length_toList _).symm a), by
    rw [Fin.univ_val_map]
    conv_rhs => rw [← Multiset.coe_toList (stendhalWeight ℓ ν)]
    congr 1
    apply List.ext_get
    · simp
    · intro n h1 h2; simp⟩
  let eS := Fintype.equivFin (Strand μ)
  let key : Strand μ → 𝕜 ×ₗ ℕ := fun s => toLex (stKey ϖ p s, (eS s : ℕ))
  have hkey : Function.Injective key := fun s t h => by
    have := congrArg (fun x => (ofLex x).2) h
    exact eS.injective (Fin.ext this)
  have hlt : ∀ s t, stKey ϖ p s < stKey ϖ p t → key s < key t := fun s t h =>
    Prod.Lex.toLex_lt_toLex.2 (Or.inl h)
  have hle : ∀ s t, key s < key t → stKey ϖ p s ≤ stKey ϖ p t := fun s t h => by
    rcases Prod.Lex.toLex_lt_toLex.1 h with h | ⟨h, -⟩
    · exact h.le
    · exact h.le
  let q : Fin m → 𝕜 ×ₗ ℕ := fun a => key (i₀.strandAt a)
  have hq : Function.Injective q := hkey.comp i₀.strandAt_injective
  let σ : Perm (Fin m) := (Tuple.sort q).symm
  have hσq : ∀ a b, σ a < σ b ↔ q a < q b := by
    have hmono : StrictMono (q ∘ Tuple.sort q) :=
      (Tuple.monotone_sort q).strictMono_of_injective (hq.comp (Tuple.sort q).injective)
    intro a b
    have := hmono.lt_iff_lt (a := σ a) (b := σ b)
    simpa [σ, Function.comp] using this.symm
  have hsame : ∀ a b, i₀.1 a = i₀.1 b → a < b → q a < q b := by
    intro a b hc hab
    have hr := i₀.rank_lt_rank hab hc
    rcases hx : i₀.1 a with x | r
    · have hs : (i₀.strandAt a).1.1.isLeft := by
        show (i₀.1 a).isLeft; rw [hx]; rfl
      have ht : (i₀.strandAt b).1.1.isLeft := by
        show (i₀.1 b).isLeft; rw [← hc, hx]; rfl
      have h1 : (i₀.strandAt a).1 = (i₀.strandAt b).1 := Subtype.ext hc
      let d : Diag ν̃ := ⟨(toTilde (i₀.strandAt a), toTilde (i₀.strandAt b)), toTilde_fst_eq h1,
        by rw [toTilde_snd hs, toTilde_snd ht]; exact hr⟩
      have := hd d
      simp only [Diag.val, Diag.fst, Diag.snd, d, sub_pos] at this
      apply hlt
      rw [stKey_of_isLeft p hs, stKey_of_isLeft p ht]
      exact this
    · have h1 := i₀.rank_lt_count b
      have h2 : (stendhalWeight ℓ ν).count (i₀.1 b) = 1 := by
        rw [← hc, hx, ← Multiset.toFinsupp_apply]; exact stendhalWeight_inr r
      omega
  have hσ : ∀ a b, i₀.1 a = i₀.1 b → (σ a < σ b ↔ a < b) := by
    intro a b hc
    rw [hσq]
    refine ⟨fun h => ?_, hsame a b hc⟩
    rcases lt_trichotomy a b with hab | rfl | hab
    · exact hab
    · exact absurd h (lt_irrefl _)
    · exact absurd (hsame b a hc.symm hab) (not_lt.2 h.le)
  have hpos : ∀ s t, posVal (σ • i₀) s < posVal (σ • i₀) t ↔ key s < key t := by
    intro s t
    simp only [posVal, KLR.Seq.posOf_smul i₀ σ hσ, Fin.val_fin_lt, hσq, q,
      KLR.Seq.strandAt_posOf]
  have hred : IsRedOrdered (σ • i₀) := by
    intro a b r r' hab hra hrb
    have hsa : (σ • i₀).strandAt a = redStrand ν r := eq_redStrand hra
    have hsb : (σ • i₀).strandAt b = redStrand ν r' := eq_redStrand hrb
    have h1 : key (redStrand ν r) < key (redStrand ν r') := by
      rw [← hpos, ← hsa, ← hsb, posVal_strandAt, posVal_strandAt]
      exact hab
    rcases lt_trichotomy r r' with h | rfl | h
    · exact h
    · exact absurd h1 (lt_irrefl _)
    · have := hlt _ _ (show stKey ϖ p (redStrand ν r') < stKey ϖ p (redStrand ν r) by
        rw [stKey_redStrand, stKey_redStrand]; exact add_lt_add_right (hϖ h) _)
      exact absurd (h1.trans this) (lt_irrefl _)
  refine ⟨⟨σ • i₀, hred⟩, Subtype.ext (funext fun h => ?_), fun s t h => hle s t ((hpos s t).1 h)⟩
  obtain ⟨a, b, hl⟩ := exists_lifts h
  have hne : stKey ϖ p a ≠ stKey ϖ p b := fun e =>
    hp h (by rw [val_eq_stKey_sub hw0 hl, e, sub_self])
  rw [Bool.eq_iff_iff, stFull_eq_true_iff hϖ hw0 _ hl]
  show _ ↔ decide (0 < h.val p) = true
  rw [decide_eq_true_iff, val_eq_stKey_sub hw0 hl, sub_pos, hpos]
  refine ⟨fun h' => ?_, hlt a b⟩
  exact lt_of_le_of_ne (hle a b h') hne

variable (ϖ) in
/-- **A violating chamber** of the Crawley-Boevey arrangement on all of `ν̃` (arXiv:1209.2463v4,
proof of Theorem 3.6): a chamber containing a generic point `p` at which some strand `t` other
than the `0`-strand lies left of every ghost `p(s₀) + ϖ_r` of the `0`-strand, i.e. left of all
red strands. Whether "the leftmost strand is black" depends on the point, not only on the
chamber, so the definition asks for one such point. -/
def IsViolatingChamber (C : FullChamber Γλ ν̃) : Prop :=
  ∃ (p : Strand ν̃ → 𝕜) (hp : IsGeneric Γλ p), ofPoint p hp = C ∧
    ∃ t, t ≠ s₀ ∧ ∀ r, p t < p s₀ + ϖ r

omit [IsStrictOrderedRing 𝕜] in
/-- A relabelling transports a point witnessing a violating chamber. -/
theorem act_lt_ghost {p : Strand ν̃ → 𝕜} {t : Strand ν̃} (hlt : ∀ r, p t < p s₀ + ϖ r)
    (g : ColPerm ν̃) (r : Fin ℓ) : act g p (g.1 t) < act g p s₀ + ϖ r := by
  have hg : g.1.symm s₀ = s₀ := (Equiv.symm_apply_eq _).2 (colPerm_zeroStrand g).symm
  simp only [act, hg, Perm.inv_def, Equiv.symm_apply_apply]
  exact hlt r

theorem colPerm_apply_ne_zeroStrand {t : Strand ν̃} (ht : t ≠ s₀) (g : ColPerm ν̃) :
    g.1 t ≠ s₀ := fun h => ht (g.1.injective (h.trans (colPerm_zeroStrand g).symm))

/-- The violating chambers are stable under relabelling. -/
theorem IsViolatingChamber.smul {C : FullChamber Γλ ν̃} (hC : IsViolatingChamber ϖ C)
    (g : ColPerm ν̃) : IsViolatingChamber ϖ (g • C) := by
  obtain ⟨p, hp, rfl, t, ht, hlt⟩ := hC
  exact ⟨act g p, hp.act g, (smul_ofPoint g hp).symm, g.1 t, colPerm_apply_ne_zeroStrand ht g,
    act_lt_ghost hlt g⟩

/-- A rank-ordered point witnessing a violating chamber lies in the chamber of a Stendhal
sequence whose leftmost strand is black (old weights `0`). -/
theorem exists_isViolated_of_lt_ghost (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    {p : Strand ν̃ → 𝕜} (hp : IsGeneric Γλ p) (hd : ∀ d : Diag ν̃, 0 < d.val p)
    {t : Strand ν̃} (ht : t ≠ s₀) (hlt : ∀ r, p t < p s₀ + ϖ r) :
    ∃ j : OrdSeq ℓ ν, IsViolated j.1 ∧ stFull Λ hϖ hw0 j = ofPoint p hp := by
  obtain ⟨j, hj, hle⟩ := exists_stFull_eq (Λ := Λ) hϖ hw0 hp hd
  obtain ⟨s, hs⟩ := exists_ofTilde_of_ne ht
  have hm : 0 < m := Fin.pos (j.1.posOf s)
  refine ⟨j, ⟨hm, ?_⟩, hj⟩
  rcases hx : j.1.lbl ⟨0, hm⟩ with x | r
  · rfl
  · exfalso
    have hu : j.1.strandAt ⟨0, hm⟩ = redStrand ν r := eq_redStrand hx
    have hsu : s ≠ redStrand ν r := fun h =>
      not_isLeft_redStrand (ν := ν) r (h ▸ isLeft_of_ofTilde hs)
    have hpos : posVal j.1 (redStrand ν r) < posVal j.1 s := by
      rw [← hu, posVal_strandAt]
      refine Nat.pos_of_ne_zero fun h0 => hsu ?_
      have h1 : j.1.posOf s = ⟨0, hm⟩ := Fin.ext h0
      rw [← hu, ← h1, KLR.Seq.strandAt_posOf]
    have := hle _ _ hpos
    rw [stKey_redStrand, stKey_of_isLeft p (isLeft_of_ofTilde hs), toTilde_of_ofTilde hs] at this
    exact absurd (hlt r) (not_lt.2 this)

/-- **The violating chambers are the relabellings of the violated Stendhal chambers** (old
weights `0`): a chamber is violating exactly when a relabelling of it is the chamber
`stFull j` of a Stendhal sequence `j` whose leftmost strand is black. -/
theorem isViolatingChamber_iff (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (C : FullChamber Γλ ν̃) :
    IsViolatingChamber ϖ C ↔
      ∃ (g : ColPerm ν̃) (j : OrdSeq ℓ ν), IsViolated j.1 ∧ g • C = stFull Λ hϖ hw0 j := by
  constructor
  · rintro ⟨p, hp, rfl, t, ht, hlt⟩
    obtain ⟨g, hg⟩ := exists_act_rankOrdered hp
    obtain ⟨j, hj, hjC⟩ := exists_isViolated_of_lt_ghost (Λ := Λ) hϖ hw0 (hp.act g) hg
      (colPerm_apply_ne_zeroStrand ht g) (act_lt_ghost hlt g)
    exact ⟨g, j, hj, by rw [smul_ofPoint, hjC]⟩
  · rintro ⟨g, j, ⟨hm, hj⟩, hgj⟩
    have hadm := isAdm_posVal j.2
    have hC : IsViolatingChamber ϖ (stFull Λ hϖ hw0 j) := by
      refine ⟨stCfg ϖ m (posVal j.1), isGeneric_stCfg hϖ hw0 hadm, rfl,
        toTilde (j.1.strandAt ⟨0, hm⟩), toTilde_ne_zeroStrand hj, fun r => ?_⟩
      have h0 : stCfg ϖ m (posVal j.1) s₀ = 0 := rfl
      rw [stCfg_some (ofTilde_toTilde_inl hj), h0, zero_add, posVal_strandAt]
      refine stPt_lt_ghost hϖ hadm.red hm (Nat.pos_of_ne_zero fun h => ?_)
      have := hadm.ne_red (s := j.1.strandAt ⟨0, hm⟩) hj r
      rw [posVal_strandAt] at this
      exact this h
    have := hC.smul g⁻¹
    rwa [← hgj, inv_smul_smul] at this

end Chambers

section Ideals

open MvPolynomial

variable {I : Type} [DecidableEq I] {ℓ : ℕ} {ν : Multiset I}
  {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] {k : Type*} [CommRing k]
  {Γ : WeightedGraph I 𝕜 k} {Λ : Fin ℓ → I →₀ ℕ} {ϖ : Fin ℓ → 𝕜}

local notation "ν̃" => WeightedGraph.redWeight (Multiset.toFinsupp ν)
local notation "Γλ" => WeightedGraph.crawleyBoeveyIn Γ Λ ϖ
local notation "s₀" => GalleryAlgebra.zeroStrand (Multiset.toFinsupp ν)

variable (ν k Γ Λ ϖ) in
/-- **The violating ideal of the reduced weighted KLR algebra on all chambers**
(arXiv:1209.2463v4, Theorem 3.6 and its proof): the two-sided ideal of the gallery algebra of
the Crawley-Boevey graph on `ν̃` generated by the dot on the `0`-strand (the reduced algebra is
the quotient by it) and the idempotents of all violating chambers. -/
noncomputable def violatingIdeal : TwoSidedIdeal (GalleryAlgebra k Γλ ν̃) :=
  TwoSidedIdeal.span (insert (poly (X s₀)) {y | ∃ C, IsViolatingChamber ϖ C ∧ y = e C})

/-- **The violating ideal is generated by the violated Stendhal chambers** (old weights `0`):
the idempotent of a violating chamber factors through the idempotent of a relabelling of it,
which is the chamber of a Stendhal sequence whose leftmost strand is black. -/
theorem violatingIdeal_eq_span (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) :
    violatingIdeal ν k Γ Λ ϖ = TwoSidedIdeal.span (insert (poly (X s₀))
      {y | ∃ j : OrdSeq ℓ ν, IsViolated j.1 ∧ y = e (stFull Λ hϖ hw0 j)}) := by
  refine le_antisymm (TwoSidedIdeal.span_le.2 ?_) (TwoSidedIdeal.span_le.2 ?_)
  · rintro _ (rfl | ⟨C, hC, rfl⟩)
    · exact TwoSidedIdeal.subset_span (Set.mem_insert _ _)
    · obtain ⟨g, j, hj, hgj⟩ := (isViolatingChamber_iff hϖ hw0 C).1 hC
      have := e_mem_span_e_smul (k := k) g C
      rw [hgj] at this
      refine TwoSidedIdeal.span_mono (Set.singleton_subset_iff.2 (Set.mem_insert_of_mem _ ?_)) this
      exact ⟨j, hj, rfl⟩
  · rintro _ (rfl | ⟨j, hj, rfl⟩)
    · exact TwoSidedIdeal.subset_span (Set.mem_insert _ _)
    · refine TwoSidedIdeal.subset_span (Set.mem_insert_of_mem _ ?_)
      exact ⟨_, (isViolatingChamber_iff hϖ hw0 _).2 ⟨1, j, hj, one_smul _ _⟩, rfl⟩

theorem mkₐ_eq_zero_of_mem (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    {z : ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0)} (hz : z ∈ stZeroDotIdeal ν k Λ hϖ hw0) :
    (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k z = 0 := by
  rw [← map_zero ((stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k)]
  exact RingCon.eq _ |>.2 ((TwoSidedIdeal.rel_iff _ _ _).2 (by rwa [sub_zero]))

/-- The dot on the `0`-strand in one copy lies in the ideal generated by the dot. -/
theorem chamberLin_zeroDot_mem (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) (j : OrdSeq ℓ ν) :
    chamberLin (stFull Λ hϖ hw0) j j (poly (X s₀) : GalleryAlgebra k Γλ ν̃) ∈
      stZeroDotIdeal ν k Λ hϖ hw0 := by
  have h : chamberLin (stFull Λ hϖ hw0) j j (poly (X s₀) : GalleryAlgebra k Γλ ν̃) =
      chamberLin (stFull Λ hϖ hw0) j j (e (stFull Λ hϖ hw0 j)) * stZeroDot ν k Λ hϖ hw0 *
        chamberLin (stFull Λ hϖ hw0) j j (e (stFull Λ hϖ hw0 j)) := by
    rw [chamberLin_e_mul_mul, stZeroDot, chamberElt_val_apply, Matrix.diagonal_apply_eq]
    refine chamberLin_eq_iff ?_
    have he := e_mul_e_self' (k := k) (stFull Λ hϖ hw0 j)
    calc _ = e (stFull Λ hϖ hw0 j) * poly (X s₀) * e (stFull Λ hϖ hw0 j) := rfl
      _ = (e (stFull Λ hϖ hw0 j) * e (stFull Λ hϖ hw0 j)) * poly (X s₀) *
          (e (stFull Λ hϖ hw0 j) * e (stFull Λ hϖ hw0 j)) := by rw [he]
      _ = _ := by noncomm_ring
  rw [h]
  exact TwoSidedIdeal.mul_mem_right _ _ _
    (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span rfl))

/-- An element of the violating ideal on all chambers, placed in one entry of the Stendhal
chamber algebra, lies in `stViolatingIdeal` modulo the dot. -/
theorem mkₐ_chamberLin_mem (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    {y : GalleryAlgebra k Γλ ν̃} (hy : y ∈ violatingIdeal ν k Γ Λ ϖ) (j' j : OrdSeq ℓ ν) :
    (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k (chamberLin (stFull Λ hϖ hw0) j' j y) ∈
      stViolatingIdeal ν k Λ hϖ hw0 := by
  set F := stFull (ν := ν) Λ hϖ hw0
  set π := (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k
  rw [violatingIdeal_eq_span hϖ hw0, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hy
  induction hy using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨_, ⟨a, -, g, hg, rfl⟩, b, -, rfl⟩ := hz
    rcases hg with rfl | ⟨j₀, hj₀, rfl⟩
    · have hp := commute_poly_X (k := k) (Γ := Γλ)
        (GalleryAlgebra.redWeight_zeroStrand (Multiset.toFinsupp ν))
      have h1 : a * poly (X s₀) * b = poly (X s₀) * (a * b) := by rw [← (hp a).eq, mul_assoc]
      have hc : chamberLin F j' j (a * poly (X s₀) * b) =
          chamberLin F j' j' (poly (X s₀)) * chamberLin F j' j (a * b) := by
        rw [chamberLin_mul_chamberLin]
        refine chamberLin_eq_iff ?_
        simp only [h1, (hp (e (F j'))).eq, ← mul_assoc, e_mul_e_self']
      rw [hc, map_mul, mkₐ_eq_zero_of_mem hϖ hw0 (chamberLin_zeroDot_mem hϖ hw0 j'), zero_mul]
      exact zero_mem _
    · have hc : chamberLin F j' j (a * e (F j₀) * b) =
          chamberLin F j' j₀ a * chamberLin F j₀ j₀ (e (F j₀)) * chamberLin F j₀ j b := by
        rw [chamberLin_mul_chamberLin, chamberLin_mul_chamberLin]
        congr 1
        simp only [mul_assoc, e_mul_e_self']
      rw [hc, map_mul, map_mul]
      exact TwoSidedIdeal.mul_mem_right _ _ _ (TwoSidedIdeal.mul_mem_left _ _ _
        (TwoSidedIdeal.subset_span ⟨j₀, hj₀, rfl⟩))
  | zero => rw [map_zero, map_zero]; exact zero_mem _
  | add z w _ _ hz hw => rw [map_add, map_add]; exact add_mem hz hw
  | neg z _ hz =>
    rw [LinearMap.map_neg, map_neg π]
    exact TwoSidedIdeal.neg_mem _ hz
variable (ν k Γ Λ) in
/-- The elements of the Stendhal chamber algebra all of whose entries lie in the violating ideal
on all chambers. -/
noncomputable def entryIdeal (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) :
    TwoSidedIdeal (ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0)) :=
  TwoSidedIdeal.mk' {x | ∀ j' j, x.1 j' j ∈ violatingIdeal ν k Γ Λ ϖ}
    (fun _ _ => zero_mem _)
    (fun hx hy j' j => add_mem (hx j' j) (hy j' j))
    (fun hx j' j => TwoSidedIdeal.neg_mem _ (hx j' j))
    (fun {x y} hy j' j => by
      rw [IsIdempotentElem.corner_val_mul, Matrix.mul_apply]
      exact sum_mem fun l _ => TwoSidedIdeal.mul_mem_left _ _ _ (hy l j))
    (fun {x y} hx j' j => by
      rw [IsIdempotentElem.corner_val_mul, Matrix.mul_apply]
      exact sum_mem fun l _ => TwoSidedIdeal.mul_mem_right _ _ _ (hx j' l))

theorem mem_entryIdeal (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (x : ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0)) :
    x ∈ entryIdeal ν k Γ Λ hϖ hw0 ↔ ∀ j' j, x.1 j' j ∈ violatingIdeal ν k Γ Λ ϖ :=
  TwoSidedIdeal.mem_mk' _ _ _ _ _ _ x

theorem stZeroDotIdeal_le_entryIdeal (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0) :
    stZeroDotIdeal ν k Λ hϖ hw0 ≤ entryIdeal ν k Γ Λ hϖ hw0 := by
  refine TwoSidedIdeal.span_le.2 ?_
  rintro _ rfl
  rw [SetLike.mem_coe, mem_entryIdeal]
  intro j' j
  rw [stZeroDot, chamberElt_val_apply, Matrix.diagonal_apply]
  split_ifs
  · exact TwoSidedIdeal.mul_mem_right _ _ _ (TwoSidedIdeal.mul_mem_left _ _ _
      (TwoSidedIdeal.subset_span (Set.mem_insert _ _)))
  · rw [mul_zero, zero_mul]; exact zero_mem _

/-- **The Stendhal corner of the violating ideal on all chambers is `stViolatingIdeal`**
(arXiv:1209.2463v4, Theorem 3.6 and its proof; old weights `0`): an element `x` of the Stendhal
chamber algebra lies in `stViolatingIdeal` modulo the dot on the `0`-strand exactly when every
entry `x j' j ∈ e(stFull j') W e(stFull j)` lies in the two-sided ideal of the weighted KLR
algebra `W` of the Crawley-Boevey graph on all chambers generated by the dot on the `0`-strand
and the idempotents of all violating chambers. -/
theorem mkₐ_mem_stViolatingIdeal_iff (hϖ : StrictMono ϖ) (hw0 : ∀ e, Γ.weight e = 0)
    (x : ChamberAlgebra k (stFull (ν := ν) Λ hϖ hw0)) :
    (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k x ∈ stViolatingIdeal ν k Λ hϖ hw0 ↔
      ∀ j' j, x.1 j' j ∈ violatingIdeal ν k Γ Λ ϖ := by
  set π := (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.mkₐ k
  set K := entryIdeal ν k Γ Λ hϖ hw0
  constructor
  · intro hx
    let K' : TwoSidedIdeal (stZeroDotIdeal ν k Λ hϖ hw0).ringCon.Quotient :=
      TwoSidedIdeal.mk' {q | ∃ y ∈ K, π y = q}
        ⟨0, zero_mem _, map_zero π⟩
        (fun ⟨y, hy, hyq⟩ ⟨z, hz, hzq⟩ => ⟨y + z, add_mem hy hz, by rw [map_add, hyq, hzq]⟩)
        (fun ⟨y, hy, hyq⟩ => ⟨-y, TwoSidedIdeal.neg_mem _ hy, by rw [map_neg π, hyq]⟩)
        (fun {a _} ⟨y, hy, hyq⟩ => by
          obtain ⟨a, rfl⟩ := RingCon.mkₐ_surjective (α := k) _ a
          exact ⟨a * y, TwoSidedIdeal.mul_mem_left _ _ _ hy, by rw [map_mul, hyq]⟩)
        (fun {_ b} ⟨y, hy, hyq⟩ => by
          obtain ⟨b, rfl⟩ := RingCon.mkₐ_surjective (α := k) _ b
          exact ⟨y * b, TwoSidedIdeal.mul_mem_right _ _ _ hy, by rw [map_mul, hyq]⟩)
    have hle : stViolatingIdeal ν k Λ hϖ hw0 ≤ K' := by
      refine TwoSidedIdeal.span_le.2 ?_
      rintro _ ⟨j, hj, rfl⟩
      refine (TwoSidedIdeal.mem_mk' _ _ _ _ _ _ _).2 ⟨_, ?_, rfl⟩
      rw [mem_entryIdeal]
      intro j' j''
      rw [chamberLin_val, Matrix.single_apply]
      split_ifs with h
      · obtain ⟨rfl, rfl⟩ := h
        rw [violatingIdeal_eq_span hϖ hw0]
        exact TwoSidedIdeal.mul_mem_right _ _ _ (TwoSidedIdeal.mul_mem_left _ _ _
          (TwoSidedIdeal.subset_span (Set.mem_insert_of_mem _ ⟨_, hj, rfl⟩)))
      · exact zero_mem _
    obtain ⟨y, hy, hyx⟩ := (TwoSidedIdeal.mem_mk' _ _ _ _ _ _ _).1 (hle hx)
    have hd : y - x ∈ stZeroDotIdeal ν k Λ hϖ hw0 :=
      (TwoSidedIdeal.rel_iff _ _ _).1 ((RingCon.eq _).1 hyx)
    have := TwoSidedIdeal.sub_mem _ hy (stZeroDotIdeal_le_entryIdeal hϖ hw0 hd)
    rw [sub_sub_cancel] at this
    exact (mem_entryIdeal hϖ hw0 x).1 this
  · intro hx
    rw [eq_sum_chamberLin x, map_sum]
    refine sum_mem fun j' _ => ?_
    rw [map_sum]
    exact sum_mem fun j _ => mkₐ_chamberLin_mem hϖ hw0 (hx j' j) j' j

end Ideals

end Categorification.Stendhal
