import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# Ideals generated in high degree

For a `ℤ`-graded algebra whose pieces vanish below degree `-c`, a two-sided ideal generated
by homogeneous elements of degree greater than `2c` contains no nonzero element of degree
zero. This is the degree bound in B. Webster, *Knot invariants and higher representation
theory*, arXiv:1309.3796v3, proof of Proposition 4.39: adding a red strand of large label is
faithful in a fixed degree.
-/

namespace Categorification.Graded

open DirectSum

variable {k A : Type*} [CommRing k] [Ring A] [Algebra k A] (𝒜 : ℤ → Submodule k A)
  [GradedAlgebra 𝒜]

/-- A two-sided ideal generated by homogeneous elements of degree above `2c` meets degree
zero trivially when the grading vanishes below `-c`. -/
theorem eq_zero_of_mem_span_of_mem_zero {c : ℤ} (hc : ∀ n < -c, 𝒜 n = ⊥) {S : Set A}
    (hS : ∀ s ∈ S, ∃ d, 2 * c < d ∧ s ∈ 𝒜 d) {x : A} (hx : x ∈ TwoSidedIdeal.span S)
    (h0 : x ∈ 𝒜 0) : x = 0 := by
  classical
  let P : A →+ A := GradedRing.proj 𝒜 0
  let K : TwoSidedIdeal A := TwoSidedIdeal.mk' {y | ∀ a b : A, P (a * y * b) = 0}
    (fun a b => by simp)
    (fun {y z} hy hz a b => by simp only [mul_add, add_mul, map_add, hy a b, hz a b, add_zero])
    (fun {y} hy a b => by simp only [mul_neg, neg_mul, map_neg, hy a b, neg_zero])
    (fun {y z} hz a b => by simpa only [mul_assoc] using hz (a * y) b)
    (fun {y z} hy a b => by simpa only [mul_assoc] using hy a (z * b))
  have hle : TwoSidedIdeal.span S ≤ K := by
    apply TwoSidedIdeal.span_le.mpr
    intro s hs a b
    obtain ⟨d, hd, hsd⟩ := hS s hs
    change P (a * (s - 0) * b) = 0
    rw [sub_zero, ← sum_support_decompose 𝒜 a, ← sum_support_decompose 𝒜 b, Finset.sum_mul,
      Finset.sum_mul, map_sum]
    refine Finset.sum_eq_zero fun p _ => ?_
    rw [Finset.mul_sum, map_sum]
    refine Finset.sum_eq_zero fun q _ => ?_
    have hmem : (decompose 𝒜 a p : A) * s * (decompose 𝒜 b q : A) ∈ 𝒜 (p + d + q) :=
      SetLike.GradedMul.mul_mem (SetLike.GradedMul.mul_mem (decompose 𝒜 a p).2 hsd)
        (decompose 𝒜 b q).2
    change (decompose 𝒜 _ 0 : A) = 0
    have hvan (r : A) (n : ℤ) (hn : n < -c) : (decompose 𝒜 r n : A) = 0 := by
      have h := (decompose 𝒜 r n).2
      simp only [hc n hn, Submodule.mem_bot] at h
      exact h
    by_cases hpq : p + d + q = 0
    · by_cases hp : p < -c
      · rw [hvan a p hp]
        simp
      · rw [hvan b q (by omega)]
        simp
    · exact decompose_of_mem_ne 𝒜 hmem hpq
  have hK := hle hx
  have h := hK 1 1
  rw [one_mul, mul_one, sub_zero] at h
  change (decompose 𝒜 x 0 : A) = 0 at h
  rwa [decompose_of_mem_same 𝒜 h0] at h

end Categorification.Graded
