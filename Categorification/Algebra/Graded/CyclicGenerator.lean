import Categorification.Algebra.Graded.Tensor

/-!
# Graded isomorphisms of cyclic modules

Let `M` be a graded `A`-module generated by a vector `m₀` in the image grading: every
element of degree `d` is `a • m₀` with `a` of degree `d`. Then any `A`-linear map to a graded
module sending `m₀` into degree zero preserves degrees (`preservesGrading_of_generator`), and an
`A`-linear isomorphism doing so is a graded isomorphism (`GradedEquiv.ofGenerator`).
-/

namespace Categorification.Graded

open DirectSum

variable {k A M N : Type*} [CommRing k] [Semiring A] [Algebra k A] [AddCommGroup M]
  [Module k M] [Module A M] [AddCommGroup N] [Module k N] [Module A N]
  {𝒜 : ℤ → Submodule k A} {ℳ : ℤ → Submodule k M} {𝒩 : ℤ → Submodule k N}

/-- A map out of a module generated in the image grading by `m₀` preserves degrees as soon as
it sends `m₀` into degree zero. -/
theorem preservesGrading_of_generator [SetLike.GradedSMul 𝒜 𝒩] (m₀ : M)
    (hgen : ∀ ⦃d : ℤ⦄ ⦃x : M⦄, x ∈ ℳ d → ∃ a ∈ 𝒜 d, a • m₀ = x)
    (f : M →ₗ[A] N) (h0 : f m₀ ∈ 𝒩 0) : PreservesGrading ℳ 𝒩 f := by
  intro d x hx
  obtain ⟨a, ha, rfl⟩ := hgen hx
  rw [f.map_smul]
  simpa using SetLike.GradedSMul.smul_mem ha h0

/-- An isomorphism out of a module generated in the image grading by `m₀`, sending `m₀` into
degree zero, is a graded isomorphism. -/
def GradedEquiv.ofGenerator [Decomposition ℳ] [Decomposition 𝒩] [SetLike.GradedSMul 𝒜 𝒩]
    (m₀ : M) (hgen : ∀ ⦃d : ℤ⦄ ⦃x : M⦄, x ∈ ℳ d → ∃ a ∈ 𝒜 d, a • m₀ = x)
    (e : M ≃ₗ[A] N) (h0 : e m₀ ∈ 𝒩 0) : ℳ ≃ᵍ[A] 𝒩 :=
  GradedEquiv.ofPreserves e (preservesGrading_of_generator m₀ hgen e.toLinearMap h0)

@[simp] theorem GradedEquiv.ofGenerator_apply [Decomposition ℳ] [Decomposition 𝒩]
    [SetLike.GradedSMul 𝒜 𝒩] (m₀ : M) (hgen : ∀ ⦃d : ℤ⦄ ⦃x : M⦄, x ∈ ℳ d → ∃ a ∈ 𝒜 d, a • m₀ = x)
    (e : M ≃ₗ[A] N) (h0 : e m₀ ∈ 𝒩 0) (x : M) :
    GradedEquiv.ofGenerator m₀ hgen e h0 x = e x := rfl

end Categorification.Graded
