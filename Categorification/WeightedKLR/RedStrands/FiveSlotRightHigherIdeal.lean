import Categorification.WeightedKLR.RedStrands.FiveSlotLeftTopIdeal
import Categorification.WeightedKLR.RedStrands.BlockKernelFiltration

/-!
# The higher ideal at the right five-slot tops

Webster, arXiv:1309.3796v2, Lemma 6.8 at (6.21). For any of the three
right five-slot tops, the relevant higher ideal and its trace on the loading
projective have three surviving idempotent generators.
-/

noncomputable section

namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR KLRAlgebra TypeA

variable {k : Type} [CommRing k]
  (Q : Unit → Unit → MvPolynomial (Fin 2) k) (Λ : Fin 3 → Unit →₀ ℕ)

local notation "ν₀" => ({()} + {()} : Multiset Unit)
local notation "μ₀" => stendhalWeight 3 ν₀
local notation "n₀" => Multiset.card μ₀
local notation "v₀" => fixedTopFourExitCut 0
local notation "v₁" => fixedTopFourExitCut 1
local notation "v₂" => fixedTopFourExitCut 2
local notation "jA" => sadj n₀ 2 • v₀
local notation "π" => AlgHom.comp (violMk k Q Λ ν₀) (ofKLR k Q Λ ν₀)
local notation "J[" t "]" => blockUpperIdeal k Q Λ ν₀ 1 2 (adjacentBlockRoot 1 2 t) (redWord t)

private theorem v2_lt (v : Seq μ₀) (hv : v = v₀ ∨ v = v₁ ∨ v = jA) :
    adjacentBlockRoot 1 2 v₂ < adjacentBlockRoot 1 2 v := by
  apply lt_of_le_not_ge
  · intro r i
    rcases hv with rfl | rfl | rfl <;> fin_cases r <;> cases i <;> decide
  · intro h
    have h' := h (1 : Fin 3) ()
    rcases hv with rfl | rfl | rfl <;> exact (by decide : ¬ _ ≤ _) h'

/-- The higher ideal at any right top is generated by precisely the three
surviving loadings above its common retained boundary. -/
theorem fiveSlotRightTop_blockUpperIdeal (t : Seq μ₀) (ht : FiveSlotRightTop t) :
    J[t] = TwoSidedIdeal.span {π (e v₀), π (e v₁), π (e jA)} := by
  have hroot : adjacentBlockRoot 1 2 t = adjacentBlockRoot 1 2 v₂ :=
    (fiveSlotRightTop_blockRoot t ht).trans (fiveSlotRightTop_blockRoot v₂ (Or.inl rfl)).symm
  have horder : redWord t = redWord v₀ := by
    rcases ht with rfl | rfl | rfl <;> decide
  apply le_antisymm
  · apply TwoSidedIdeal.span_le.mpr
    rintro z ⟨v, hv, hh, rfl⟩
    by_cases hbad : IsViolated v
    · rw [show π (e v) = 0 from violMk_e hbad]
      exact TwoSidedIdeal.zero_mem _
    rcases fiveSlot_nonviolated_tops v (hv.trans horder) hbad with hr | rfl | rfl | rfl
    · have hrv : adjacentBlockRoot 1 2 v = adjacentBlockRoot 1 2 v₂ :=
        (fiveSlotRightTop_blockRoot v hr).trans
          (fiveSlotRightTop_blockRoot v₂ (Or.inl rfl)).symm
      rw [hroot, hrv] at hh
      exact (lt_irrefl _ hh).elim
    · exact TwoSidedIdeal.subset_span (Or.inl rfl)
    · exact TwoSidedIdeal.subset_span (Or.inr (Or.inl rfl))
    · exact TwoSidedIdeal.subset_span (Or.inr (Or.inr rfl))
  · apply TwoSidedIdeal.span_le.mpr
    intro z hz
    have hgen (v : Seq μ₀) (hv : v = v₀ ∨ v = v₁ ∨ v = jA) : π (e v) ∈ J[t] := by
      have ho : redWord v = redWord v₀ := by
        rcases hv with rfl | rfl | rfl <;> decide
      exact TwoSidedIdeal.subset_span ⟨v, ho.trans horder.symm, hroot ▸ v2_lt v hv, rfl⟩
    rcases hz with rfl | rfl | rfl
    · exact hgen v₀ (Or.inl rfl)
    · exact hgen v₁ (Or.inr (Or.inl rfl))
    · exact hgen jA (Or.inr (Or.inr rfl))


/-- A prescribed one-black descent need not hold for all permutations with the
same endpoints when the two black labels agree. -/
theorem fiveSlotRightTop_firstBlack_descent_not_forced :
    ∃ w : Equiv.Perm (Fin n₀), w • v₂ = v₁ ∧
      ¬ w (3 : Fin 5) < w (2 : Fin 5) := by
  decide +kernel


section Trace

open MulOpposite ModuleFiltration
attribute [local instance 1100] IsIdempotentElem.instAlgebraCorner_categorification

variable (t : Seq μ₀) (ht : FiveSlotRightTop t)

local notation "T" => IsIdempotentElem.Corner (isIdempotentElem_violMk_redProj k Q Λ ν₀ (redWord t))
local notation "P" => rIdeal (orderedLoadingIdem Q Λ t)

include ht in
private theorem rightHigherOrder (u : Seq μ₀) (hu : u = v₀ ∨ u = v₁ ∨ u = jA) :
    redWord u = redWord t := by
  have h₁ : redWord t = redWord v₀ := by rcases ht with rfl | rfl | rfl <;> decide
  have h₂ : redWord u = redWord v₀ := by rcases hu with rfl | rfl | rfl <;> decide
  exact h₂.trans h₁.symm

/-- The three surviving retained generators, in the actual source corner. -/
def fiveSlotRightHigherIdempotents : Set Tᵐᵒᵖ :=
  {op (orderedLoadingIdemAt Q Λ (redWord t) v₀ (rightHigherOrder t ht v₀ (Or.inl rfl))),
    op (orderedLoadingIdemAt Q Λ (redWord t) v₁ (rightHigherOrder t ht v₁ (Or.inr (Or.inl rfl)))),
    op (orderedLoadingIdemAt Q Λ (redWord t) jA (rightHigherOrder t ht jA (Or.inr (Or.inr rfl))))}

private theorem trace_le_of_subset_or_zero {B : Type} [Ring B] {S U : Set B}
    (X : ModuleCat B) (h : ∀ z ∈ S, z ∈ U ∨ z = 0) :
    idempotentTrace S X ≤ idempotentTrace U X := by
  rw [idempotentTrace, idempotentTrace]
  apply Submodule.span_le.mpr
  rintro _ ⟨z, hz, x, rfl⟩
  rcases h z hz with hz | rfl
  · exact Submodule.subset_span ⟨z, hz, x, rfl⟩
  · rw [zero_smul]
    exact Submodule.zero_mem _

include ht in
private theorem rightHigher_mem_or_zero (z : Tᵐᵒᵖ)
    (hz : z ∈ higherBlockLoadingIdempotents Q Λ t 1 2) :
    z ∈ fiveSlotRightHigherIdempotents Q Λ t ht ∨ z = 0 := by
  obtain ⟨u, hu, hlt, rfl⟩ := hz
  by_cases hbad : IsViolated u
  · have hz : orderedLoadingIdemAt Q Λ (redWord t) u hu = 0 := by
      apply Subtype.ext
      exact show π (e u) = 0 from violMk_e hbad
    exact Or.inr (by rw [hz, op_zero])
  have horder := rightHigherOrder t ht v₀ (Or.inl rfl)
  rcases fiveSlot_nonviolated_tops u (hu.trans horder.symm) hbad with hr | rfl | rfl | rfl
  · rw [fiveSlotRightTop_blockRoot t ht, fiveSlotRightTop_blockRoot u hr] at hlt
    exact (lt_irrefl _ hlt).elim
  · exact Or.inl (Or.inl rfl)
  · exact Or.inl (Or.inr (Or.inl rfl))
  · exact Or.inl (Or.inr (Or.inr rfl))

include ht in
private theorem rightHigher_subset :
    fiveSlotRightHigherIdempotents Q Λ t ht ⊆ higherBlockLoadingIdempotents Q Λ t 1 2 := by
  intro z hz
  have hroot : adjacentBlockRoot 1 2 t = adjacentBlockRoot 1 2 v₂ :=
    (fiveSlotRightTop_blockRoot t ht).trans (fiveSlotRightTop_blockRoot v₂ (Or.inl rfl)).symm
  have hlt (u) (hu : u = v₀ ∨ u = v₁ ∨ u = jA) :
      adjacentBlockRoot 1 2 t < adjacentBlockRoot 1 2 u := hroot ▸ v2_lt u hu
  rcases hz with rfl | rfl | rfl
  · exact ⟨v₀, _, hlt v₀ (Or.inl rfl), rfl⟩
  · exact ⟨v₁, _, hlt v₁ (Or.inr (Or.inl rfl)), rfl⟩
  · exact ⟨jA, _, hlt jA (Or.inr (Or.inr rfl)), rfl⟩

/-- Only the three surviving idempotents contribute to the trace of the right-top kernel. -/
theorem fiveSlotRightTop_blockLoadingKernel_eq_trace :
    blockLoadingKernel Q Λ t 1 2 =
      idempotentTrace (fiveSlotRightHigherIdempotents Q Λ t ht) (ModuleCat.of Tᵐᵒᵖ P) := by
  rw [blockLoadingKernel_eq_idempotentTrace]
  exact le_antisymm
    (trace_le_of_subset_or_zero _ (rightHigher_mem_or_zero Q Λ t ht))
    (trace_le_of_subset_or_zero _ (fun _ hz => Or.inl (rightHigher_subset Q Λ t ht hz)))

end Trace

end Categorification.Stendhal.BraidedStendhalAlgebra
