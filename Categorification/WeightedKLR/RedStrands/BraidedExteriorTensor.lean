import Categorification.WeightedKLR.RedStrands.BraidedExteriorGrading

/-!
# The graded balanced tensor in Webster's Figure 5

Webster, arXiv:1309.3796v2, §6.1, Definitions 6.2 and 6.6 and the proof of Proposition 6.9.
The ordinary balanced tensor of the lower exterior standardization with the two-red braid
bimodule is graded by the sum of the internal degrees of its factors. Multiplication identifies
it with the loading cut, hence with the shifted upper exterior standardization. The internal
index is `ℂ`, independent of the cochain grading; this is not a construction on derived categories.
-/

noncomputable section
namespace Categorification.Stendhal.BraidedStendhalAlgebra

open KLR DG Equiv QuantumGroup Categorification.Graded DirectSum MulOpposite CornerEndomorphism
open scoped DG.DegreeZero TensorProduct

section TensorGrading
variable {ι A M N : Type*} [AddCommMonoid ι] [Ring A] [AddCommGroup M] [Module Aᵐᵒᵖ M]
  [AddCommGroup N] [Module A N]
  (L : ι → Submodule ℤ M) (R : ι → Submodule ℤ N)

/-- The grading on the ordinary tensor quotient used in the degree-zero DG tensor API. -/
private def tensorOverGrade : ι → Submodule ℤ (TensorProductOver A M N) :=
  Graded.map (tensorGrading L R) (TensorProductOver.mk A M N).toIntLinearMap

private theorem tmul_mem_tensorOverGrade {i j : ι} {m : M} {n : N}
    (hm : m ∈ L i) (hn : n ∈ R j) :
    TensorProductOver.tmul A m n ∈ tensorOverGrade L R (i + j) :=
  Graded.mem_map_of_mem _ _ (tmul_mem_tensorGrading hm hn)

private theorem tensorOverGrade_map_mem {Y : Type*} [AddCommGroup Y]
    (T : ι → Submodule ℤ Y) (f : TensorProductOver A M N →+ Y)
    (hf : ∀ ⦃i j : ι⦄ ⦃m : M⦄ ⦃n : N⦄, m ∈ L i → n ∈ R j →
      f (TensorProductOver.tmul A m n) ∈ T (i + j))
    {i : ι} {x : TensorProductOver A M N} (hx : x ∈ tensorOverGrade L R i) : f x ∈ T i := by
  obtain ⟨t, ht, rfl⟩ := Submodule.mem_map.1 hx
  exact tensorGrading_map_mem L R T
    (f.toIntLinearMap.comp (TensorProductOver.mk A M N).toIntLinearMap)
    (fun _ _ _ _ hm hn => hf hm hn) ht

variable [DecidableEq ι] (S : ι → Submodule ℤ A) [Decomposition L] [Decomposition R]
  [Decomposition S]

-- The balancing subgroup is generated by internally homogeneous relations. This argument
-- constructs the direct sum before and independently of the projective multiplication map.
@[instance_reducible] private def tensorOverDecomposition
    (hL : ∀ ⦃i j : ι⦄ ⦃m : M⦄ ⦃a : A⦄, m ∈ L i → a ∈ S j → op a • m ∈ L (i + j))
    (hR : ∀ ⦃i j : ι⦄ ⦃a : A⦄ ⦃n : N⦄, a ∈ S i → n ∈ R j → a • n ∈ R (i + j)) :
    Decomposition (tensorOverGrade («A» := A) L R) := by
  let π := (TensorProductOver.mk A M N).toIntLinearMap
  have hr : (DG.balancedRel A M N).toIntSubmodule = Submodule.span ℤ (relHom L R S) := by
    unfold DG.balancedRel
    rw [AddSubgroup.toIntSubmodule_closure]
    apply le_antisymm
    · apply Submodule.span_le.2
      rintro t ⟨a, m, n, rfl⟩
      exact relSet_subset_span_relHom (ℳ := L) (𝒩 := R) S ⟨m, a, n, rfl⟩
    · apply Submodule.span_le.2
      rintro t ⟨_, _, _, m, a, n, _, _, _, rfl⟩
      exact Submodule.subset_span ⟨a, m, n, rfl⟩
  let hT : Decomposition (tensorGrading L R) := Graded.tensorDecomposition L R
  refine @Graded.mapDecomposition _ _ _ _ _ _ _ _ _ (tensorGrading L R) π _ hT
    (TensorProductOver.mk_surjective («A» := A) (M := M) (N := N)) ?_
  intro x hx i
  have hx' : x ∈ (DG.balancedRel A M N).toIntSubmodule := TensorProductOver.mk_eq_zero_iff.1 hx
  rw [hr] at hx'
  have hhom : ∀ t ∈ relHom L R S, ∃ d, t ∈ tensorGrading L R d := by
    rintro t ⟨i, j, l, m, a, n, hm, ha, hn, rfl⟩
    refine ⟨i + j + l, sub_mem (tmul_mem_tensorGrading (hL hm ha) hn) ?_⟩
    rw [add_assoc]
    exact tmul_mem_tensorGrading hm (hR ha hn)
  have hh := @decompose_mem_span_of_homogeneous _ _ _ _ _ _ _ (tensorGrading L R) hT _ hhom x hx' i
  have hsub : Submodule.span ℤ (relHom L R S) ≤ (DG.balancedRel A M N).toIntSubmodule := hr.ge
  exact TensorProductOver.mk_eq_zero_iff.2 (hsub hh)

end TensorGrading

section Reindex
variable {M N Y : Type*} [AddCommGroup M] [AddCommGroup N] [AddCommGroup Y]

private def complexGrade (L : ℤ → Submodule ℤ M) (c : ℂ) : ℂ → Submodule ℤ M :=
  Function.extend (fun n : ℤ => (n : ℂ) + c) L ⊥

private theorem cast_add_injective (c : ℂ) : Function.Injective (fun n : ℤ => (n : ℂ) + c) :=
  fun _ _ h => Int.cast_injective (add_right_cancel h)

private theorem complexGrade_apply (L : ℤ → Submodule ℤ M) (c : ℂ) (i : ℤ) :
    complexGrade L c ((i : ℂ) + c) = L i := (cast_add_injective c).extend_apply _ _ _

private theorem isInternal_complexGrade (L : ℤ → Submodule ℤ M) [Decomposition L] (c : ℂ) :
    IsInternal (complexGrade L c) := by
  classical
  let f : ℤ → ℂ := fun n => (n : ℂ) + c
  let E := complexGrade L c
  have hL := Decomposition.isInternal L
  have he (n : ℤ) : E (f n) = L n := complexGrade_apply L c n
  have hb (z : ℂ) (hz : ¬ ∃ n, f n = z) : E z = ⊥ := Function.extend_apply' (f := f) L ⊥ z hz
  refine isInternal_submodule_of_iSupIndep_of_iSup_eq_top ?_ ?_
  · intro z
    change Disjoint (E z) (⨆ j, ⨆ (_ : j ≠ z), E j)
    by_cases hz : ∃ n, f n = z
    · obtain ⟨n, rfl⟩ := hz
      rw [he]
      apply (hL.submodule_iSupIndep n).mono_right
      refine iSup₂_le fun w hw => ?_
      by_cases h : ∃ m, f m = w
      · obtain ⟨m, rfl⟩ := h
        rw [he]
        exact le_iSup₂_of_le m (fun h => hw (congrArg f h)) le_rfl
      · rw [hb _ h]
        exact bot_le
    · rw [hb _ hz]
      exact disjoint_bot_left
  · unfold complexGrade
    rw [iSup_extend_bot (cast_add_injective c)]
    exact hL.submodule_iSup_eq_top

private theorem complexGrade_pair (L : ℤ → Submodule ℤ M) (R : ℤ → Submodule ℤ N)
    (T : ℤ → Submodule ℤ Y) (c d : ℂ) (f : M →+ N →+ Y)
    (hf : ∀ ⦃i j : ℤ⦄ ⦃x : M⦄ ⦃y : N⦄, x ∈ L i → y ∈ R j → f x y ∈ T (i + j))
    {z w : ℂ} {x : M} {y : N} (hx : x ∈ complexGrade L c z) (hy : y ∈ complexGrade R d w) :
    f x y ∈ complexGrade T (c + d) (z + w) := by
  by_cases hz : ∃ i : ℤ, (i : ℂ) + c = z
  · obtain ⟨i, rfl⟩ := hz
    by_cases hw : ∃ j : ℤ, (j : ℂ) + d = w
    · obtain ⟨j, rfl⟩ := hw
      rw [complexGrade_apply] at hx hy
      rw [show (i : ℂ) + c + ((j : ℂ) + d) = ((i + j : ℤ) : ℂ) + (c + d) by push_cast; abel,
        complexGrade_apply]
      exact hf hx hy
    · have h₀ : y = 0 := by
        rw [complexGrade, Function.extend_apply' _ _ _ hw] at hy
        exact (Submodule.mem_bot ℤ).1 hy
      rw [h₀, map_zero]
      exact zero_mem _
  · have h₀ : x = 0 := by
      rw [complexGrade, Function.extend_apply' _ _ _ hz] at hx
      exact (Submodule.mem_bot ℤ).1 hx
    rw [h₀, map_zero]
    exact zero_mem _

end Reindex

-- The additive decomposition uses the same subtypes and inclusions after restricting scalars.
@[instance_reducible] private def restrictIntDecomposition {k M : Type*} [CommRing k]
    [AddCommGroup M] [Module k M] (P : ℤ → Submodule k M) [h : Decomposition P] :
    Decomposition (fun n => (P n).restrictScalars ℤ) where
  decompose' := h.decompose'
  left_inv := h.left_inv
  right_inv := h.right_inv

section DiagramGrades
variable {I k : Type} [DecidableEq I] [Field k]
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin 2 → I →₀ ℕ} {ν : Multiset I}
  (C : CartanDatum I) (hR : IsRouquierQ C Q)

local notation "V" => ViolQuotient k Q Λ ν
local notation "T" κ:arg => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ
local notation "q" => violMk k Q Λ ν
local notation "E" κ:arg => q (redProj k Q Λ ν κ)
local notation "e" s:arg => q (ofKLR k Q Λ ν (KLRAlgebra.e s))
local notation "E₀" => E [0, 1]
local notation "E₁" => E [1, 0]
local notation "Braid" => braidingBimodule k Q Λ ν [0, 1] [1, 0]
local notation "M" => InDegreeZero (OpBimodule (T [0, 1]) Braid)
local notation "A" => (T [0, 1])ᵐᵒᵖ
local notation "D" => (T [1, 0])ᵐᵒᵖ

private local instance lowerCornerRing : Ring A :=
  inferInstanceAs (Ring (isIdempotentElem_violMk_redProj k Q Λ ν [0, 1]).Cornerᵐᵒᵖ)

private local instance upperCornerRing : Ring D :=
  inferInstanceAs (Ring (isIdempotentElem_violMk_redProj k Q Λ ν [1, 0]).Cornerᵐᵒᵖ)

private local instance lowerCornerAddGroup : AddCommGroup A := (lowerCornerRing (Λ := Λ) (ν := ν)).toAddCommGroup

private local instance upperCornerAddGroup : AddCommGroup D := (upperCornerRing (Λ := Λ) (ν := ν)).toAddCommGroup

private abbrev diagramDatum (Ω : Fin 2 → I →₀ ℕ) : GradingDatum (stendhalQ Q Ω) :=
  stendhalGradingDatum Ω hR.gradingDatum (UDot.di C)
    (fun i => (hR.gradingDatum_degX i).trans (UDot.two_mul_di C i).symm)

local notation "G" Ω:arg => diagramDatum C hR Ω
local notation "𝒱" => violAuxiliaryGrade (ν := ν) (G Λ)

private theorem loading_mem_zero (s : Seq (stendhalWeight 2 ν)) : e s ∈ 𝒱 0 :=
  Graded.mem_map_of_mem _ (q).toLinearMap
    (Graded.mem_map_of_mem _ (ofKLR k Q Λ ν).toLinearMap ((G Λ).e_mem_grade s))

private theorem projector_mem_zero (κ : List (Fin 2)) : E κ ∈ 𝒱 0 := by
  rw [redProj, redIdem, map_sum, map_sum]
  exact Submodule.sum_mem _ fun s _ => loading_mem_zero C hR s

private def lowerOrderVal : A →+ V where
  toFun a := a.unop.val
  map_zero' := rfl
  map_add' _ _ := rfl

private def upperOrderVal : D →+ V where
  toFun a := a.unop.val
  map_zero' := rfl
  map_add' _ _ := rfl

private def braidVal : M →+ V where
  toFun b := b.val
  map_zero' := rfl
  map_add' _ _ := rfl

-- These are the two same-order algebras, with no red/red correction (Definition 4.4).
private def lowerOrderAux : ℤ → Submodule ℤ A :=
  Graded.comap (fun n => (𝒱 n).restrictScalars ℤ) lowerOrderVal.toIntLinearMap

private def upperOrderAux : ℤ → Submodule ℤ D :=
  Graded.comap (fun n => (𝒱 n).restrictScalars ℤ) upperOrderVal.toIntLinearMap

private def braidAux : ℤ → Submodule ℤ M :=
  Graded.comap (fun n => (𝒱 n).restrictScalars ℤ) braidVal.toIntLinearMap

private theorem isInternal_diagramGrade {X : Type*} [AddCommGroup X] (val : X →+ V)
    (hinj : Function.Injective val) {l r : V} (hl : l ∈ 𝒱 0) (hr : r ∈ 𝒱 0)
    (hmem : ∀ x, l * val x = val x ∧ val x * r = val x)
    (lift : ∀ y, l * y = y → y * r = y → ∃ x, val x = y) :
    IsInternal (Graded.comap (fun n => (𝒱 n).restrictScalars ℤ) val.toIntLinearMap) := by
  let : Decomposition (fun n => (𝒱 n).restrictScalars ℤ) := restrictIntDecomposition (𝒱)
  apply Graded.isInternal_comap _ _ hinj
  intro x n
  change (decompose 𝒱 (val x) n : V) ∈ LinearMap.range val.toIntLinearMap
  refine lift _ ?_ ?_
  · rw [← coe_decompose_mul_of_left_mem_zero 𝒱 hl, (hmem x).1]
  · rw [← coe_decompose_mul_of_right_mem_zero 𝒱 hr, (hmem x).2]

private instance lowerOrderAuxDecomposition : Decomposition (lowerOrderAux (Λ := Λ) (ν := ν) C hR) :=
  (isInternal_diagramGrade C hR (lowerOrderVal (Λ := Λ) (ν := ν))
    (fun _ _ h => unop_injective (Subtype.ext h)) (projector_mem_zero C hR [0, 1])
    (projector_mem_zero C hR [0, 1])
    (fun a => (Subsemigroup.mem_corner_iff (isIdempotentElem_violMk_redProj k Q Λ ν [0, 1])).1 a.unop.2)
    (fun _ hl hr => ⟨op ⟨_, (Subsemigroup.mem_corner_iff
      (isIdempotentElem_violMk_redProj k Q Λ ν [0, 1])).2 ⟨hl, hr⟩⟩, rfl⟩)).chooseDecomposition

private instance braidAuxDecomposition : Decomposition (braidAux (Λ := Λ) (ν := ν) C hR) :=
  (isInternal_diagramGrade C hR (braidVal (Λ := Λ) (ν := ν)) Subtype.val_injective
    (projector_mem_zero C hR [0, 1]) (projector_mem_zero C hR [1, 0])
    (fun b => mem_cornerBimodule.1 b.2)
    (fun _ hl hr => ⟨⟨_, mem_cornerBimodule.2 ⟨hl, hr⟩⟩, rfl⟩)).chooseDecomposition

variable {H : Type*} [AddCommGroup H] [Module ℂ H]
  (B : LinearMap.BilinForm ℂ (Module.Dual ℂ H)) (η : Fin 2 → Module.Dual ℂ H)

local notation "c" => (2 - B (η 1) (η 0))

/-- The lower ordered algebra of Figure 5 with its diagram grading, zero off the integers. -/
def figureFiveLowerOrderGrade : ℂ → Submodule ℤ A := complexGrade (lowerOrderAux C hR) 0

/-- The upper ordered algebra of Figure 5 with its diagram grading, zero off the integers. -/
def figureFiveUpperOrderGrade : ℂ → Submodule ℤ D := complexGrade (upperOrderAux C hR) 0

/-- The intrinsic internal grading on `B([0,1],[1,0])` for Webster, arXiv:1309.3796v2, §6.1,
Definitions 6.2–6.3. The pieces are the actual two-order corner's auxiliary diagram pieces,
with the one red/red crossing corrected by `2 - ⟨λ₁, λ₀⟩` (the cut uses the same correction).
`Submodule ℤ` views the pieces as additive subgroups in the integral balanced-tensor presentation;
`ℂ` is the internal degree index, not the scalar ring. -/
def figureFiveBraidGrade : ℂ → Submodule ℤ M := complexGrade (braidAux C hR) c

instance figureFiveBraidDecomposition :
    Decomposition (figureFiveBraidGrade (Λ := Λ) (ν := ν) C hR B η) :=
  (isInternal_complexGrade (braidAux C hR) c).chooseDecomposition

private instance lowerOrderDecomposition :
    Decomposition (figureFiveLowerOrderGrade (Λ := Λ) (ν := ν) C hR) :=
  (isInternal_complexGrade (lowerOrderAux C hR) 0).chooseDecomposition

/-- Left concatenation by the lower ordered algebra adds the internal degrees. -/
theorem figureFiveBraid_left_mem_grade {i j : ℂ} {a : A} {b : M}
    (ha : a ∈ figureFiveLowerOrderGrade C hR i) (hb : b ∈ figureFiveBraidGrade C hR B η j) :
    op a • b ∈ figureFiveBraidGrade C hR B η (i + j) := by
  let f : A →+ M →+ M :=
    { toFun a := DistribSMul.toAddMonoidHom M (op a)
      map_zero' := AddMonoidHom.ext fun b => Subtype.ext (zero_mul b.val)
      map_add' a a' := AddMonoidHom.ext fun b => Subtype.ext (add_mul a.unop.val a'.unop.val b.val) }
  have h := complexGrade_pair (lowerOrderAux C hR) (braidAux C hR) (braidAux C hR) 0 c f
    (fun i j a b ha hb => (SetLike.GradedMul.mul_mem («A» := (𝒱))
      (show a.unop.val ∈ 𝒱 i from ha) (show b.val ∈ 𝒱 j from hb))) ha hb
  rwa [zero_add] at h

/-- Right concatenation by the upper ordered algebra adds the internal degrees. -/
theorem figureFiveBraid_right_mem_grade {i j : ℂ} {a : D} {b : M}
    (ha : a ∈ figureFiveUpperOrderGrade C hR i) (hb : b ∈ figureFiveBraidGrade C hR B η j) :
    a • b ∈ figureFiveBraidGrade C hR B η (j + i) := by
  let f : M →+ D →+ M :=
    { toFun b := {toFun := (· • b), map_zero' := zero_smul _ _, map_add' := fun _ _ => add_smul _ _ _}
      map_zero' := AddMonoidHom.ext fun _ => smul_zero _
      map_add' _ _ := AddMonoidHom.ext fun _ => smul_add _ _ _ }
  have h := complexGrade_pair (braidAux C hR) (upperOrderAux C hR) (braidAux C hR) c 0 f
    (fun j i b a hb ha => SetLike.GradedMul.mul_mem («A» := (𝒱))
      (show b.val ∈ 𝒱 j from hb) (show a.unop.val ∈ 𝒱 i from ha)) hb ha
  rwa [add_zero] at h

end DiagramGrades

section TensorCongr
variable {A D M N N' : Type*} [Ring A] [Ring D] [AddCommGroup M] [AddCommGroup N] [AddCommGroup N']
  [Module Aᵐᵒᵖ M] [Module D M] [SMulCommClass D Aᵐᵒᵖ M] [Module A N] [Module A N']

private def tensorOverMapRight (g : N →ₗ[A] N') : TensorProductOver A M N →ₗ[D] TensorProductOver A M N' where
  toFun := TensorProductOver.map LinearMap.id g
  map_add' := map_add _
  map_smul' d x := by
    have h : (TensorProductOver.map (LinearMap.id : M →ₗ[Aᵐᵒᵖ] M) g).comp
        (DistribSMul.toAddMonoidHom (TensorProductOver A M N) d) =
        (DistribSMul.toAddMonoidHom (TensorProductOver A M N') d).comp
          (TensorProductOver.map LinearMap.id g) :=
      TensorProductOver.addHom_ext fun _ _ => rfl
    exact DFunLike.congr_fun h x

private def tensorOverCongrRight (g : N ≃ₗ[A] N') : TensorProductOver A M N ≃ₗ[D] TensorProductOver A M N' :=
  LinearEquiv.ofLinearMap (tensorOverMapRight g.toLinearMap) (tensorOverMapRight g.symm.toLinearMap)
    (by
      apply LinearMap.toAddMonoidHom_injective
      exact TensorProductOver.addHom_ext fun m n =>
        congrArg (TensorProductOver.tmul A m) (g.apply_symm_apply n))
    (by
      apply LinearMap.toAddMonoidHom_injective
      exact TensorProductOver.addHom_ext fun m n =>
        congrArg (TensorProductOver.tmul A m) (g.symm_apply_apply n))

end TensorCongr

section ExteriorEvaluation
variable {I k : Type} [DecidableEq I] [Field k]
  {Q : I → I → MvPolynomial (Fin 2) k} {Λ : Fin 2 → I →₀ ℕ} {ν : Multiset I}
  {ρ : Perm (Fin (Multiset.card (stendhalWeight 2 ν))) → List ℕ}
  (C : CartanDatum I) (hR : IsRouquierQ C Q) (hρ : TypeA.IsReducedChoice ρ)

local notation "T" κ:arg => ViolOrderCorner (k := k) (Q := Q) (Λ := Λ) (ν := ν) κ
local notation "V" => ViolQuotient k Q Λ ν
local notation "A" => (T [0, 1])ᵐᵒᵖ
local notation "D" => (T [1, 0])ᵐᵒᵖ
local notation "M" => InDegreeZero (OpBimodule (T [0, 1]) (braidingBimodule k Q Λ ν [0, 1] [1, 0]))
local notation "Y" u:arg => violCorner k Q Λ ν (figureFiveLower u) [1, 0]
local notation "G" Ω:arg => diagramDatum C hR Ω
local notation "𝒱" => violAuxiliaryGrade (ν := ν) (G Λ)

attribute [local instance] lowerCornerRing upperCornerRing lowerCornerAddGroup upperCornerAddGroup

private def lastVacuum : Seq (0 : Multiset I) := KLRAlgebra.Seq.ofList [] (by simp)

omit [DecidableEq I] in
private theorem figureFiveLowerRedWord (u : Seq ν) : redWord (figureFiveLower u) = [0, 1] := by
  unfold figureFiveLower
  rw [Seq.redPerm_one]
  exact (redWord_eq_finRange_iff _).2 (isRedOrdered_seqCast _
    (isRedOrdered_twoPieceLoading (SingleRed.ordered ν _) lastVacuum))

omit [DecidableEq I] in
private theorem tensorRouquierSymm (C : CartanDatum I) (h : IsRouquierQ C Q) : KLRSymm Q :=
  fun i j hij => (h.symm i j hij).symm

local notation "hS" => tensorRouquierSymm C hR
local notation "idem" u:arg => violLoadingIdem (Λ := Λ) (Q := Q) (figureFiveLowerRedWord u)
private abbrev lowerLoading (u : Seq ν) := InDegreeZero ↥(rIdeal (idem u))
local notation "L" u:arg => lowerLoading (Λ := Λ) (Q := Q) u

/-- The lower standardization `S(P_u ⊠ P_∅)` in the Figure 5 right-module convention. -/
abbrev figureFiveLowerExterior (u : Seq ν) : ModuleCat.{0} A :=
  exteriorStandardizationRight (Λ₂ := Λ) (σ₂ := 1) hS hρ
    (add_zero ν) (SingleRed.insertWord ν u) lastVacuum

local notation "N" u:arg => InDegreeZero (figureFiveLowerExterior (Λ := Λ) C hR hρ u)

/-- The last-factor-vacuum standardization read as the right ideal of the lower loading. -/
def figureFiveLowerLoadingEquiv (u : Seq ν) : L u ≃ₗ[A] N u :=
  loadingProjectiveEquivExteriorStandardization (Λ₂ := Λ) (σ₂ := 1) hS hρ
    (add_zero ν) (SingleRed.insertWord ν u) lastVacuum

/-- The lower exterior standardization in Proposition 6.9, Figure 5, is projective: the last
factor is vacuum and the loading right ideal is a summand of the lower ordered algebra. -/
theorem figureFiveLowerExterior_projective (u : Seq ν) : Module.Projective A (N u) := by
  let : Module.Projective A (L u) := rIdeal_projective (isIdempotentElem_violLoadingIdem _)
  exact Module.Projective.of_equiv (figureFiveLowerLoadingEquiv C hR hρ u)

private def lowerExteriorAux (u : Seq ν) : ℤ → Submodule ℤ (N u) := fun n =>
  (exteriorStandardGrade (Λ ∘ (1 : Perm (Fin 2))) hR (G (Λ ∘ (1 : Perm (Fin 2)))) hS
    (SingleRed.insertWord ν u) lastVacuum (add_zero ν) n).restrictScalars ℤ

private instance lowerExteriorAuxDecomposition (u : Seq ν) :
    Decomposition (lowerExteriorAux (Λ := Λ) C hR hρ u) :=
  restrictIntDecomposition (exteriorStandardGrade (Λ ∘ (1 : Perm (Fin 2))) hR
    (G (Λ ∘ (1 : Perm (Fin 2)))) hS (SingleRed.insertWord ν u) lastVacuum (add_zero ν))

private theorem lowerExteriorAux_iff (u : Seq ν) (n : ℤ) (x : N u) :
    x ∈ lowerExteriorAux (Λ := Λ) C hR hρ u n ↔
      ((figureFiveLowerLoadingEquiv C hR hρ u).symm x).val.val ∈ 𝒱 n := by
  let e := figureFiveLowerLoadingEquiv (Λ := Λ) C hR hρ u
  have h := figureFiveLowerProjective_mem_grade_iff (Λ := Λ) C hR hρ u n (e.symm x)
  change e (e.symm x) ∈ lowerExteriorAux (Λ := Λ) C hR hρ u n ↔ _ at h
  rwa [LinearEquiv.apply_symm_apply] at h

/-- The internal grading of the lower exterior standardization: its intrinsic ordered
quotient grading from Definition 5.4, extended by zero off the integers. -/
def figureFiveLowerExteriorGrade (u : Seq ν) : ℂ → Submodule ℤ (N u) :=
  complexGrade (lowerExteriorAux (Λ := Λ) C hR hρ u) 0

instance figureFiveLowerExteriorDecomposition (u : Seq ν) :
    Decomposition (figureFiveLowerExteriorGrade (Λ := Λ) C hR hρ u) :=
  (isInternal_complexGrade (lowerExteriorAux (Λ := Λ) C hR hρ u) 0).chooseDecomposition

private theorem lowerExterior_smul_mem (u : Seq ν) {i j : ℂ} {a : A} {x : N u}
    (ha : a ∈ figureFiveLowerOrderGrade C hR i) (hx : x ∈ figureFiveLowerExteriorGrade (Λ := Λ) C hR hρ u j) :
    a • x ∈ figureFiveLowerExteriorGrade (Λ := Λ) C hR hρ u (i + j) := by
  let f : A →+ (N u) →+ N u :=
    { toFun a := DistribSMul.toAddMonoidHom (N u) a
      map_zero' := AddMonoidHom.ext fun _ => zero_smul _ _
      map_add' a a' := AddMonoidHom.ext fun _ => add_smul a a' _ }
  have h := complexGrade_pair (lowerOrderAux C hR) (lowerExteriorAux (Λ := Λ) C hR hρ u)
    (lowerExteriorAux (Λ := Λ) C hR hρ u) 0 0 f (fun i j a x ha hx => by
      apply (lowerExteriorAux_iff C hR hρ u _ _).2
      change ((figureFiveLowerLoadingEquiv C hR hρ u).symm (a • x)).val.val ∈ 𝒱 (i + j)
      rw [map_smul, add_comm]
      exact SetLike.GradedMul.mul_mem («A» := (𝒱)) ((lowerExteriorAux_iff C hR hρ u j x).1 hx)
        (show a.unop.val ∈ 𝒱 i from ha)) ha hx
  rwa [zero_add] at h

/-- The ordinary balanced tensor `S(P_u ⊠ P_∅) ⊗ B` on the actual exterior standardization.
As in the degree-zero tensor API, right modules are read as left modules over the opposite
corner, which puts the braid first in Lean's tensor notation. -/
abbrev FigureFiveExteriorTensor (u : Seq ν) := TensorProductOver A M (N u)

variable {H : Type*} [AddCommGroup H] [Module ℂ H]
  (B : LinearMap.BilinForm ℂ (Module.Dual ℂ H)) (η : Fin 2 → Module.Dual ℂ H)

local notation "X" u:arg => FigureFiveExteriorTensor (Λ := Λ) C hR hρ u
local notation "c" => (2 - B (η 1) (η 0))

/-- Both factors are in cochain degree zero. This statement uses the cochain index `ℤ`,
not the internal index `ℂ` of the tensor grading below. -/
theorem figureFiveExteriorTensor_mem_cochain_zero (u : Seq ν) (x : X u) :
    x ∈ DG.grading (0 : ℤ) :=
  TensorProductOver.mem_grading_zero_inDegreeZero x

/-- The grading of the actual balanced quotient: the image of the convolution of the two
factor gradings, not a grading transported from the cut. -/
def figureFiveExteriorTensorGrade (u : Seq ν) : ℂ → Submodule ℤ (X u) :=
  tensorOverGrade («A» := A) (figureFiveBraidGrade C hR B η) (figureFiveLowerExteriorGrade (Λ := Λ) C hR hρ u)

/-- The balancing relations are homogeneous, so the pieces form a direct sum on the quotient. -/
instance figureFiveExteriorTensorDecomposition (u : Seq ν) :
    Decomposition (figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u) := by
  classical
  exact tensorOverDecomposition _ _ (figureFiveLowerOrderGrade C hR)
    (fun i j b a hb ha => add_comm j i ▸ figureFiveBraid_left_mem_grade C hR B η ha hb)
    (fun _ _ _ _ ha hx => lowerExterior_smul_mem C hR hρ u ha hx)

/-- Degrees of pure tensors add in `ℂ`, independently of the cochain degree. -/
theorem tmul_mem_figureFiveExteriorTensorGrade (u : Seq ν) {i j : ℂ} {b : M} {x : N u}
    (hb : b ∈ figureFiveBraidGrade C hR B η i) (hx : x ∈ figureFiveLowerExteriorGrade (Λ := Λ) C hR hρ u j) :
    TensorProductOver.tmul A b x ∈ figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u (i + j) :=
  tmul_mem_tensorOverGrade _ _ hb hx

private local instance figureFiveBraidComm : SMulCommClass D Aᵐᵒᵖ M where
  smul_comm d a b := Subtype.ext (mul_assoc a.unop.unop.val b.val d.unop.val)

private local instance figureFiveTensorRightModule (u : Seq ν) : Module D (X u) :=
  TensorProductOver.instModule (B := D)

/-- The upper corner acts on the braid factor of the tensor, adding its internal degree. -/
theorem figureFiveExteriorTensor_smul_mem_grade (u : Seq ν) {i j : ℂ} {a : D} {x : X u}
    (ha : a ∈ figureFiveUpperOrderGrade C hR i)
    (hx : x ∈ figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u j) :
    a • x ∈ figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u (j + i) := by
  let S := figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u
  exact tensorOverGrade_map_mem (figureFiveBraidGrade C hR B η)
    (figureFiveLowerExteriorGrade (Λ := Λ) C hR hρ u) (fun z => S (z + i))
    (DistribSMul.toAddMonoidHom (X u) a) (fun l r b p hb hp => by
      change a • TensorProductOver.tmul A b p ∈ S (l + r + i)
      rw [TensorProductOver.smul_tmul, add_right_comm l r i]
      exact tmul_mem_figureFiveExteriorTensorGrade C hR hρ B η u
        (figureFiveBraid_right_mem_grade C hR B η ha hb) hp) hx

/-- Webster, arXiv:1309.3796v2, §6.1, the projective tensor step of Proposition 6.9. Apply the
lower endpoint comparison in the tensor and then the loading-projective multiplication map. -/
def figureFiveExteriorTensorEquivCut (u : Seq ν) : X u ≃ₗ[D] Y u := by
  let j : X u ≃ₗ[D] TensorProductOver A M (L u) :=
    tensorOverCongrRight (figureFiveLowerLoadingEquiv C hR hρ u).symm
  let m : TensorProductOver A M (L u) ≃ₗ[D] Y u :=
    loadingProjectiveTensorEquiv (figureFiveLowerRedWord u)
  exact j.trans m

/-- The evaluation is the prescribed multiplication on pure tensors, not an abstract
isomorphism between the resulting right modules. -/
theorem figureFiveExteriorTensorEquivCut_tmul (u : Seq ν) (b : M) (x : N u) :
    (figureFiveExteriorTensorEquivCut (Λ := Λ) C hR hρ u (TensorProductOver.tmul A b x)).val =
      ((figureFiveLowerLoadingEquiv C hR hρ u).symm x).val.val * b.val := rfl

private def cutAux (u : Seq ν) : ℤ → Submodule ℤ (Y u) := fun n =>
  (violCornerAuxiliaryGrade C hR (figureFiveLower u) [1, 0] n).restrictScalars ℤ

private theorem cutPiece_eq (u : Seq ν) (z : ℂ) :
    complexGrade (cutAux (Λ := Λ) C hR u) c z =
      (figureFiveCutGrade (Λ := Λ) C hR B η (figureFiveLower u) 1 0 z).restrictScalars ℤ := by
  let f : ℤ → ℂ := fun n => (n : ℂ) + c
  by_cases h : ∃ n, f n = z
  · obtain ⟨n, rfl⟩ := h
    change complexGrade (cutAux (Λ := Λ) C hR u) c ((n : ℂ) + c) = _
    rw [complexGrade_apply, figureFiveCutGrade, (cast_add_injective c).extend_apply]
    rfl
  · unfold complexGrade figureFiveCutGrade
    rw [Function.extend_apply' _ _ _ h, Function.extend_apply' _ _ _ h]
    exact (Submodule.restrictScalars_bot _ _ _).symm

/-- Multiplication identifies every internal degree of the ordinary tensor with the previously
constructed diagram grading of the cut. Both directions are on the same map as in the
ungraded evaluation; the tensor already has an independent direct-sum decomposition. -/
theorem figureFiveExteriorTensorEquivCut_mem_grade_iff (u : Seq ν) (z : ℂ) (x : X u) :
    figureFiveExteriorTensorEquivCut (Λ := Λ) C hR hρ u x ∈
        figureFiveCutGrade (Λ := Λ) C hR B η (figureFiveLower u) 1 0 z ↔
      x ∈ figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u z := by
  let S := figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u
  let T₁ := complexGrade (cutAux (Λ := Λ) C hR u) c
  let e := figureFiveExteriorTensorEquivCut (Λ := Λ) C hR hρ u
  let : Decomposition (cutAux (Λ := Λ) C hR u) :=
    restrictIntDecomposition (violCornerAuxiliaryGrade (Λ := Λ) C hR (figureFiveLower u) [1, 0])
  let : Decomposition T₁ := (isInternal_complexGrade (cutAux (Λ := Λ) C hR u) c).chooseDecomposition
  have he : PreservesGrading S T₁ e.toLinearMap := by
    intro d x hx
    refine tensorOverGrade_map_mem _ _ T₁ e.toLinearMap.toAddMonoidHom ?_ hx
    intro i j b p hb hp
    let f : M →+ (N u) →+ Y u :=
      (AddMonoidHom.compHom e.toLinearMap.toAddMonoidHom).comp (TensorProductOver.tmulAddHom A M (N u))
    have hh := complexGrade_pair (braidAux C hR) (lowerExteriorAux (Λ := Λ) C hR hρ u) (cutAux (Λ := Λ) C hR u) c 0 f
      (fun i j b p hb hp => by
        change (e (TensorProductOver.tmul A b p)).val ∈ 𝒱 (i + j)
        rw [figureFiveExteriorTensorEquivCut_tmul, add_comm]
        exact SetLike.GradedMul.mul_mem («A» := (𝒱)) ((lowerExteriorAux_iff C hR hρ u j p).1 hp)
          (show b.val ∈ 𝒱 i from hb)) hb hp
    rwa [add_zero] at hh
  let ge := GradedEquiv.ofPreserves e he
  change e x ∈ (figureFiveCutGrade (Λ := Λ) C hR B η (figureFiveLower u) 1 0 z).restrictScalars ℤ ↔ x ∈ S z
  rw [← cutPiece_eq]
  refine ⟨fun hx => ?_, fun hx => ge.map_mem' hx⟩
  have h : e.symm (e x) ∈ S z := ge.symm_map_mem' hx
  rwa [LinearEquiv.symm_apply_apply] at h

variable [Fintype I] (P : Matrix.Realization (UDot.A C) ℂ H)
  (hB : ∀ i x, B (P.root i) x = (UDot.di C i : ℂ) * x (P.coroot i))
  (hΛ : ∀ j i, η j (P.coroot i) = (Λ j i : ℂ)) (hSym : B.IsSymm)

/-- Webster, arXiv:1309.3796v2, §6.1, Proposition 6.9, Figure 5, on the ordinary tensor of the
lower two-red exterior standardization with the braid. The isomorphism is multiplication
followed by the inverse of the Figure 5 comparison. The target piece at internal degree `z`
is the intrinsic upper exterior piece at `z + ⟨λ₀ − α, λ₁⟩` in Webster's convention. This is an
isomorphism of internally graded right modules, not a derived functor isomorphism. -/
def figureFiveExteriorTensorEquiv (u : Seq ν) :
    figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u ≃ᵍ[D]
      (fun z => (figureFiveUpperExteriorGrade (Λ := Λ) C hR hρ u
        (z + B (η 0 - (ν.map P.root).sum) (η 1))).restrictScalars ℤ) := by
  let e := figureFiveExteriorTensorEquivCut (Λ := Λ) C hR hρ u
  let g := figureFiveExteriorToCut C hR hρ P B η hB hΛ hSym u
  let e' := e.trans g.symm
  have h (z : ℂ) (x : X u) : e' x ∈ figureFiveUpperExteriorGrade (Λ := Λ) C hR hρ u
      (z + B (η 0 - (ν.map P.root).sum) (η 1)) ↔ x ∈ figureFiveExteriorTensorGrade (Λ := Λ) C hR hρ B η u z := by
    have hg := figureFiveExteriorToCut_mem_grade_iff C hR hρ P B η hB hΛ hSym u z (g.symm (e x))
    change g (g.symm (e x)) ∈ _ ↔ _ at hg
    rw [LinearEquiv.apply_symm_apply] at hg
    exact hg.symm.trans (figureFiveExteriorTensorEquivCut_mem_grade_iff C hR hρ B η u z x)
  exact { toLinearEquiv := e'
          map_mem' z x hx := (h z x).2 hx
          symm_map_mem' z y hy := (h z (e'.symm y)).1 (by
            rw [LinearEquiv.apply_symm_apply]; exact hy) }

end ExteriorEvaluation

end Categorification.Stendhal.BraidedStendhalAlgebra
