import Categorification.Algebra.FinrankCounting
import Mathlib.Algebra.DirectSum.Decomposition
import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.LinearAlgebra.Dimension.Finite
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Degreewise dimension counts for filtrations by homogeneous subspaces

The graded form of the dimension argument of B. Webster, *Knot invariants and higher
representation theory*, arXiv:1309.3796v3, proof of Proposition 5.21. Let `V` be a
finite-dimensional graded vector space and `N φ` homogeneous subspaces indexed by a finite
set with a strict order, spanning `V`. If the ungraded layers `P_{≥φ}/P_{>φ}` have total
dimension `dim V`, then in every degree `n` the layers in degree `n` have total dimension
`dim V_n` (`finrank_grade_eq_sum`). A layer generated by a homogeneous map of degree `d` from a
homogeneous subspace `X`, with kernel modulo `P_{>φ}` a homogeneous `U ⊆ X`, has dimension
`dim X_{n-d} - dim U_{n-d}` in degree `n` (`layerRank_grade_of_generator`).

## Main results

* `IsHomogeneousSubspace`: closure under taking homogeneous components.
* `finrank_eq_sum_inf_grade`: a homogeneous subspace is the sum of its graded pieces.
* `layerRank_grade_sum`: the layers in each degree add up to the ungraded layer.
* `finrank_grade_eq_sum`: the degreewise count.
* `layerRank_grade_of_generator`: a layer in a fixed degree.
-/

namespace Categorification.Graded

open DirectSum Module

variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V] (ℳ : ℤ → Submodule k V)
  [Decomposition ℳ]

/-- A subspace is homogeneous if it contains the homogeneous components of its elements. -/
def IsHomogeneousSubspace (W : Submodule k V) : Prop :=
  ∀ n, ∀ x ∈ W, (decompose ℳ x n : V) ∈ W

variable {ℳ}

theorem inf_grade_le_of_decompose_mem {W P : Submodule k V} {n : ℤ}
    (h : ∀ y ∈ W, (decompose ℳ y n : V) ∈ P) : W ⊓ ℳ n ≤ P := fun x hx => by
  have := h x hx.1
  rwa [decompose_of_mem_same ℳ hx.2] at this

theorem IsHomogeneousSubspace.sup {W W' : Submodule k V} (hW : IsHomogeneousSubspace ℳ W)
    (hW' : IsHomogeneousSubspace ℳ W') : IsHomogeneousSubspace ℳ (W ⊔ W') := by
  intro n x hx
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.1 hx
  rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
  exact Submodule.add_mem_sup (hW n y hy) (hW' n z hz)

theorem IsHomogeneousSubspace.iSup {ι : Sort*} {N : ι → Submodule k V}
    (h : ∀ i, IsHomogeneousSubspace ℳ (N i)) : IsHomogeneousSubspace ℳ (⨆ i, N i) := by
  intro n x hx
  refine Submodule.iSup_induction N (motive := fun y => (decompose ℳ y n : V) ∈ ⨆ i, N i)
    hx ?_ ?_ ?_
  · intro i y hy
    exact Submodule.mem_iSup_of_mem i (h i n y hy)
  · simp
  · intro y z hy hz
    rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact add_mem hy hz

theorem isHomogeneousSubspace_top : IsHomogeneousSubspace ℳ ⊤ := fun _ _ _ => trivial

theorem sup_inf_grade {W W' : Submodule k V} (hW : IsHomogeneousSubspace ℳ W)
    (hW' : IsHomogeneousSubspace ℳ W') (n : ℤ) :
    (W ⊔ W') ⊓ ℳ n = W ⊓ ℳ n ⊔ W' ⊓ ℳ n := by
  apply le_antisymm
  · apply inf_grade_le_of_decompose_mem
    intro y hy
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hy
    rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact Submodule.add_mem_sup ⟨hW n a ha, (decompose ℳ a n).2⟩
      ⟨hW' n b hb, (decompose ℳ b n).2⟩
  · exact sup_le (inf_le_inf_right _ le_sup_left) (inf_le_inf_right _ le_sup_right)

theorem iSup_inf_grade {ι : Sort*} {N : ι → Submodule k V}
    (h : ∀ i, IsHomogeneousSubspace ℳ (N i)) (n : ℤ) :
    (⨆ i, N i) ⊓ ℳ n = ⨆ i, (N i ⊓ ℳ n) := by
  apply le_antisymm
  · apply inf_grade_le_of_decompose_mem
    intro y hy
    refine Submodule.iSup_induction N
      (motive := fun y => (decompose ℳ y n : V) ∈ ⨆ i, (N i ⊓ ℳ n)) hy ?_ ?_ ?_
    · intro i x hx
      exact Submodule.mem_iSup_of_mem i ⟨h i n x hx, (decompose ℳ x n).2⟩
    · simp
    · intro x y hx hy
      rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
      exact add_mem hx hy
  · exact iSup_le fun i => inf_le_inf_right _ (le_iSup N i)

theorem iSup₂_inf_grade {ι : Sort*} {p : ι → Prop} {N : ι → Submodule k V}
    (h : ∀ i, IsHomogeneousSubspace ℳ (N i)) (n : ℤ) :
    (⨆ (i) (_ : p i), N i) ⊓ ℳ n = ⨆ (i) (_ : p i), (N i ⊓ ℳ n) := by
  rw [iSup_inf_grade (fun i => IsHomogeneousSubspace.iSup fun _ => h i)]
  exact iSup_congr fun i => iSup_inf_grade (fun _ => h i) n

/-- The degree-`n` component of a degree-`d` map is the map applied to the
degree-`(n - d)` component. -/
theorem decompose_map_of_shift {μ : V →ₗ[k] V} {d : ℤ} (hμ : ∀ m, ∀ x ∈ ℳ m, μ x ∈ ℳ (m + d))
    (x : V) (n : ℤ) : (decompose ℳ (μ x) n : V) = μ (decompose ℳ x (n - d)) := by
  induction x using Decomposition.inductionOn ℳ with
  | zero => simp
  | add x y hx hy => simp [decompose_add, hx, hy]
  | @homogeneous j x =>
    by_cases h : j + d = n
    · subst h
      rw [decompose_of_mem_same _ (hμ j x x.2), add_sub_cancel_right,
        decompose_of_mem_same ℳ x.2]
    · rw [decompose_of_mem_ne _ (hμ j x x.2) h, decompose_of_mem_ne _ x.2 (by omega),
        map_zero]

section Finite

variable [FiniteDimensional k V]

private theorem finrank_biSup_inf_grade (W : Submodule k V) (F : Finset ℤ) :
    finrank k (⨆ n ∈ F, (W ⊓ ℳ n) : Submodule k V) = ∑ n ∈ F, finrank k (W ⊓ ℳ n :) := by
  classical
  induction F using Finset.induction_on with
  | empty => simp
  | insert a F ha ih =>
    rw [Finset.iSup_insert, Finset.sum_insert ha, ← ih]
    have hdisj : (W ⊓ ℳ a) ⊓ (⨆ n ∈ F, (W ⊓ ℳ n)) = ⊥ := by
      have hd := (Decomposition.isInternal ℳ).submodule_iSupIndep.disjoint_biSup
        (y := (F : Set ℤ)) (x := a) (by simpa using ha)
      rw [eq_bot_iff]
      refine le_trans (inf_le_inf inf_le_right (iSup₂_mono fun n _ => inf_le_right)) ?_
      simpa using hd.le_bot
    have := Submodule.finrank_sup_add_finrank_inf_eq (W ⊓ ℳ a) (⨆ n ∈ F, (W ⊓ ℳ n))
    rw [hdisj, finrank_bot, add_zero] at this
    exact this

/-- A finite set of degrees outside which the grading vanishes. -/
theorem exists_finset_grade_eq_bot : ∃ F : Finset ℤ, ∀ n ∉ F, ℳ n = ⊥ := by
  have hfin : {n | ℳ n ≠ ⊥}.Finite :=
    Submodule.finite_ne_bot_of_iSupIndep (Decomposition.isInternal ℳ).submodule_iSupIndep
  refine ⟨hfin.toFinset, fun n hn => ?_⟩
  by_contra h
  exact hn (hfin.mem_toFinset.2 h)

/-- A homogeneous subspace has dimension the sum of the dimensions of its graded pieces. -/
theorem finrank_eq_sum_inf_grade {F : Finset ℤ} (hF : ∀ n ∉ F, ℳ n = ⊥)
    {W : Submodule k V} (hW : IsHomogeneousSubspace ℳ W) :
    finrank k W = ∑ n ∈ F, finrank k (W ⊓ ℳ n :) := by
  classical
  have hWeq : W = ⨆ n ∈ F, (W ⊓ ℳ n) := by
    apply le_antisymm
    · intro x hx
      rw [← sum_support_decompose ℳ x]
      refine Submodule.sum_mem _ fun i _ => ?_
      by_cases hi : i ∈ F
      · exact Submodule.mem_iSup_of_mem i (Submodule.mem_iSup_of_mem hi
          ⟨hW i x hx, (decompose ℳ x i).2⟩)
      · have h := (decompose ℳ x i).2
        simp only [hF i hi, Submodule.mem_bot] at h
        rw [h]
        exact zero_mem _
    · exact iSup₂_le fun n _ => (inf_le_left : W ⊓ ℳ n ≤ W)
  have := finrank_biSup_inf_grade (ℳ := ℳ) W F
  rw [← hWeq] at this
  exact this

variable {ι : Type*} [Fintype ι] [DecidableEq ι] (rel : ι → ι → Prop)

omit [FiniteDimensional k V] in
private theorem finrankK_self (X : Submodule k V) : Submodule.finrankK k X = finrank k X := by
  rw [Submodule.finrankK, Submodule.restrictScalars_self]

omit [FiniteDimensional k V] [Fintype ι] [DecidableEq ι] in
/-- The degree-`n` layer of a filtration by homogeneous subspaces. -/
theorem layerRank_grade_eq {N : ι → Submodule k V} (hN : ∀ g, IsHomogeneousSubspace ℳ (N g))
    (g : ι) (n : ℤ) :
    Submodule.layerRank (k := k) rel (fun g => N g ⊓ ℳ n) g =
      finrank k ((N g ⊔ Submodule.above rel N g) ⊓ ℳ n :) -
        finrank k (Submodule.above rel N g ⊓ ℳ n :) := by
  have habove : Submodule.above rel (fun g => N g ⊓ ℳ n) g = Submodule.above rel N g ⊓ ℳ n :=
    (iSup₂_inf_grade hN n).symm
  have hP : IsHomogeneousSubspace ℳ (Submodule.above rel N g) :=
    IsHomogeneousSubspace.iSup fun _ => IsHomogeneousSubspace.iSup fun _ => hN _
  rw [Submodule.layerRank, habove, ← sup_inf_grade (hN g) hP, finrankK_self, finrankK_self]

omit [Fintype ι] [DecidableEq ι] in
/-- The layers in the various degrees add up to the ungraded layer. -/
theorem layerRank_grade_sum {F : Finset ℤ} (hF : ∀ n ∉ F, ℳ n = ⊥) {N : ι → Submodule k V}
    (hN : ∀ g, IsHomogeneousSubspace ℳ (N g)) (g : ι) :
    ∑ n ∈ F, Submodule.layerRank (k := k) rel (fun g => N g ⊓ ℳ n) g =
      Submodule.layerRank (k := k) rel N g := by
  have hP : IsHomogeneousSubspace ℳ (Submodule.above rel N g) :=
    IsHomogeneousSubspace.iSup fun _ => IsHomogeneousSubspace.iSup fun _ => hN _
  have hle : ∀ n, finrank k (Submodule.above rel N g ⊓ ℳ n :) ≤
      finrank k ((N g ⊔ Submodule.above rel N g) ⊓ ℳ n :) := fun n =>
    Submodule.finrank_mono (inf_le_inf_right _ le_sup_right)
  have h1 := finrank_eq_sum_inf_grade hF ((hN g).sup hP)
  have h2 := finrank_eq_sum_inf_grade hF hP
  have h3 : ∑ n ∈ F, Submodule.layerRank (k := k) rel (fun g => N g ⊓ ℳ n) g +
      ∑ n ∈ F, finrank k (Submodule.above rel N g ⊓ ℳ n :) =
      ∑ n ∈ F, finrank k ((N g ⊔ Submodule.above rel N g) ⊓ ℳ n :) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [layerRank_grade_eq rel hN g n, Nat.sub_add_cancel (hle n)]
  rw [Submodule.layerRank, finrankK_self, finrankK_self, h1, h2, ← h3, Nat.add_sub_cancel]

/-- **Degreewise dimension count** (graded form of Webster, arXiv:1309.3796v3, proof of
Proposition 5.21). If homogeneous subspaces `N φ` span a subspace `W` and the ungraded layers
have total dimension `dim W`, then in each degree `n` the layers have total dimension
`dim W_n`. -/
theorem finrank_grade_eq_sum (hirr : ∀ φ, ¬ rel φ φ)
    (htr : ∀ a b c, rel a b → rel b c → rel a c) {N : ι → Submodule k V}
    (hN : ∀ g, IsHomogeneousSubspace ℳ (N g)) {W : Submodule k V} (hspan : (⨆ g, N g) = W)
    (hsum : ∑ g, Submodule.layerRank (k := k) rel N g = finrank k W) (n : ℤ) :
    finrank k (W ⊓ ℳ n :) = ∑ g, Submodule.layerRank (k := k) rel (fun g => N g ⊓ ℳ n) g := by
  classical
  obtain ⟨F, hF⟩ := exists_finset_grade_eq_bot (ℳ := ℳ)
  have hle : ∀ n, finrank k (W ⊓ ℳ n :) ≤
      ∑ g, Submodule.layerRank (k := k) rel (fun g => N g ⊓ ℳ n) g := by
    intro n
    have h := Submodule.finrankK_iSup_le (k := k) rel (fun g => N g ⊓ ℳ n) hirr htr
      Finset.univ (by simp)
    simp only [Finset.mem_univ, iSup_pos] at h
    rw [← iSup_inf_grade hN, hspan, finrankK_self] at h
    exact h
  by_cases hn : n ∈ F
  · have hW : IsHomogeneousSubspace ℳ W := hspan ▸ IsHomogeneousSubspace.iSup hN
    have htop := finrank_eq_sum_inf_grade hF hW
    have hsum' : ∑ m ∈ F, ∑ g, Submodule.layerRank (k := k) rel (fun g => N g ⊓ ℳ m) g =
        ∑ m ∈ F, finrank k (W ⊓ ℳ m :) := by
      rw [Finset.sum_comm, ← htop, ← hsum]
      exact Finset.sum_congr rfl fun g _ => layerRank_grade_sum rel hF hN g
    exact (Finset.sum_eq_sum_iff_of_le fun m _ => hle m).1 hsum'.symm n hn
  · have h0 : ∀ g, Submodule.layerRank (k := k) rel (fun g => N g ⊓ ℳ n) g = 0 := by
      intro g
      rw [layerRank_grade_eq rel hN g n, hF n hn, inf_bot_eq, inf_bot_eq, finrank_bot]
    rw [Finset.sum_eq_zero fun g _ => h0 g, hF n hn, inf_bot_eq, finrank_bot]

omit [Fintype ι] [DecidableEq ι] in
/-- **A layer in a fixed degree** (graded form of Webster, arXiv:1309.3796v3, proof of
Proposition 5.21). Suppose `P_{≥φ} = μ(X) + P_{>φ}` for a homogeneous subspace `X` and a map `μ`
of degree `d`, and an element `x ∈ X` has `μ x ∈ P_{>φ}` exactly when `x` lies in a homogeneous
`U`. Then the layer has dimension `dim X_{n-d} - dim U_{n-d}` in degree `n`. -/
theorem layerRank_grade_of_generator {N : ι → Submodule k V}
    (hN : ∀ g, IsHomogeneousSubspace ℳ (N g)) (g : ι) {μ : V →ₗ[k] V} {d : ℤ}
    (hμ : ∀ m, ∀ x ∈ ℳ m, μ x ∈ ℳ (m + d)) {X U : Submodule k V}
    (hX : IsHomogeneousSubspace ℳ X) (hUX : U ≤ X)
    (hgen : N g ⊔ Submodule.above rel N g = X.map μ ⊔ Submodule.above rel N g)
    (hker : ∀ x ∈ X, μ x ∈ Submodule.above rel N g ↔ x ∈ U) (n : ℤ) :
    Submodule.layerRank (k := k) rel (fun g => N g ⊓ ℳ n) g =
      finrank k (X ⊓ ℳ (n - d) :) - finrank k (U ⊓ ℳ (n - d) :) := by
  classical
  set P := Submodule.above rel N g
  have hP : IsHomogeneousSubspace ℳ P :=
    IsHomogeneousSubspace.iSup fun _ => IsHomogeneousSubspace.iSup fun _ => hN _
  rw [layerRank_grade_eq rel hN g n]
  set Z := (N g ⊔ P) ⊓ ℳ n
  set Zb := P ⊓ ℳ n
  set Y := X ⊓ ℳ (n - d)
  set U' := U ⊓ ℳ (n - d)
  have hZb : Zb ≤ Z := inf_le_inf_right _ le_sup_right
  have hU' : U' ≤ Y := inf_le_inf_right _ hUX
  have hμY : ∀ y : Y, μ y ∈ Z := by
    intro y
    refine ⟨?_, ?_⟩
    · rw [hgen]
      exact Submodule.mem_sup_left ⟨y, y.2.1, rfl⟩
    · have := hμ _ _ y.2.2
      rwa [sub_add_cancel] at this
  let W := Zb.comap Z.subtype
  let f : Y →ₗ[k] Z ⧸ W := W.mkQ ∘ₗ (μ.domRestrict Y).codRestrict Z hμY
  have hf_apply (y : Y) : f y = W.mkQ ⟨μ y, hμY y⟩ := rfl
  have hsurj : Function.Surjective f := by
    intro z
    obtain ⟨z, rfl⟩ := W.mkQ_surjective z
    have hz : (z : V) ∈ X.map μ ⊔ P := hgen ▸ z.2.1
    obtain ⟨a, ⟨x, hx, rfl⟩, p, hp, hap⟩ := Submodule.mem_sup.1 hz
    let y : Y := ⟨decompose ℳ x (n - d), hX _ x hx, (decompose ℳ x (n - d)).2⟩
    refine ⟨y, ?_⟩
    rw [hf_apply, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
    change (μ y - z : V) ∈ Zb
    have hzn : (z : V) = decompose ℳ (z : V) n := (decompose_of_mem_same ℳ z.2.2).symm
    have hcomp : (μ y - z : V) = -(decompose ℳ p n : V) := by
      rw [hzn, ← hap, decompose_add, DirectSum.add_apply, Submodule.coe_add,
        decompose_map_of_shift hμ]
      abel
    rw [hcomp]
    exact neg_mem ⟨hP n p hp, (decompose ℳ p n).2⟩
  have hker' : LinearMap.ker f = U'.comap Y.subtype := by
    ext y
    rw [LinearMap.mem_ker, hf_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
      Submodule.mem_comap, Submodule.mem_comap]
    change μ y ∈ Zb ↔ (y : V) ∈ U'
    constructor
    · intro h
      exact ⟨(hker y y.2.1).1 h.1, y.2.2⟩
    · intro h
      exact ⟨(hker y y.2.1).2 h.1, (hμY y).2⟩
  have h1 := LinearMap.finrank_range_add_finrank_ker f
  rw [LinearMap.range_eq_top.2 hsurj, finrank_top, hker',
    (Submodule.comapSubtypeEquivOfLe hU').finrank_eq] at h1
  have h2 := Submodule.finrank_quotient_add_finrank W
  rw [show finrank k W = finrank k Zb from (Submodule.comapSubtypeEquivOfLe hZb).finrank_eq] at h2
  omega

end Finite

section Algebra

variable {A : Type*} [Ring A] [Algebra k A] (𝒜 : ℤ → Submodule k A) [GradedAlgebra 𝒜]

/-- A left ideal generated by elements whose homogeneous components lie in it is homogeneous. -/
theorem isHomogeneousSubspace_span {S : Set A}
    (hS : ∀ z ∈ S, ∀ n, (decompose 𝒜 z n : A) ∈ Submodule.span A S) :
    IsHomogeneousSubspace 𝒜 ((Submodule.span A S).restrictScalars k) := by
  classical
  suffices h : ∀ x ∈ Submodule.span A S, ∀ n, (decompose 𝒜 x n : A) ∈ Submodule.span A S from
    fun n x hx => h x hx n
  intro x hx
  induction hx using Submodule.span_induction with
  | mem z hz => exact hS z hz
  | zero => intro n; simp
  | add x y _ _ hx hy =>
    intro n
    rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact add_mem (hx n) (hy n)
  | smul b x _ hx =>
    intro n
    rw [smul_eq_mul, ← sum_support_decompose 𝒜 b, Finset.sum_mul, decompose_sum,
      DFinsupp.finsetSum_apply, Submodule.coe_sum]
    refine Submodule.sum_mem _ fun j _ => ?_
    have hμ : ∀ m, ∀ y ∈ 𝒜 m, LinearMap.mulLeft k (decompose 𝒜 b j : A) y ∈ 𝒜 (m + j) :=
      fun m y hy => by
        rw [add_comm]
        exact SetLike.GradedMul.mul_mem (decompose 𝒜 b j).2 hy
    have h := decompose_map_of_shift hμ x n
    rw [LinearMap.mulLeft_apply, LinearMap.mulLeft_apply] at h
    rw [h]
    exact Submodule.smul_mem _ _ (hx (n - j))

end Algebra

end Categorification.Graded
